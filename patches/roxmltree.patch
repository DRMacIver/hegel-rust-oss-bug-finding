+//! Property-based tests for roxmltree using hegel (`hegeltest`).
+//!
+//! These are integration tests exercising `Document::parse` and the resulting
+//! tree API. The highest-value properties here are oracle-INDEPENDENT: the
+//! parser must never panic, node ranges must be valid byte offsets into the
+//! input, the tree must be structurally consistent (parent/child agreement,
+//! unique document element), and well-formedness rules (duplicate attributes)
+//! must be enforced.
+//!
+//! roxmltree's README states: "This library must not panic. Any panic should
+//! be considered a critical bug and reported." So any panic / abort found here
+//! is a genuine contract violation.
+
+#![allow(clippy::bool_assert_comparison)]
+
+use hegel::generators::{self, Generator};
+use roxmltree::*;
+
+// ---------------------------------------------------------------------------
+// A small, well-formed XML model used to build valid documents by construction.
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum Xml {
+    Elem {
+        name: String,
+        // attribute name -> value (names unique within the element)
+        attrs: Vec<(String, String)>,
+        children: Vec<Xml>,
+    },
+    Text(String),
+}
+
+/// Generator for a valid XML element name (no colon, so no namespace prefix).
+fn name_gen() -> generators::BoxedGenerator<'static, String> {
+    generators::from_regex(r"[a-zA-Z_][a-zA-Z0-9_.-]{0,7}")
+        .fullmatch(true)
+        .boxed()
+}
+
+/// Text-node content that survives parsing unchanged.
+///
+/// roxmltree does not normalize whitespace in text nodes, but it does
+/// normalize `\r\n`/`\r` to `\n`. It also forbids the literal sequence `]]>`
+/// in character data, and `<`/`&` start markup. We exclude `\r`, `<`, `&`, and
+/// `]` (the last purely to make `]]>` impossible), so the text round-trips
+/// verbatim.
+fn text_gen() -> generators::BoxedGenerator<'static, String> {
+    generators::from_regex(r"[a-zA-Z0-9 \t\n.,:;!?/*()@#$%^+=_'\x22-]{0,12}")
+        .fullmatch(true)
+        .boxed()
+}
+
+/// Attribute-value content that survives parsing unchanged. Attribute values
+/// undergo whitespace normalization (tab/newline -> space), so we exclude all
+/// whitespace as well as the quote characters, `<`, and `&`.
+fn attr_value_gen() -> generators::BoxedGenerator<'static, String> {
+    generators::from_regex(r"[a-zA-Z0-9.,:;!?/*()@#$%^+=_-]{0,12}")
+        .fullmatch(true)
+        .boxed()
+}
+
+/// Recursively build an XML element. Depth-bounded well below the (buggy,
+/// unenforced) stack-overflow threshold so these properties stay safe; the
+/// overflow itself is pinned by `deep_nesting_stack_overflow` below.
+fn elem_gen(depth: u32) -> generators::BoxedGenerator<'static, Xml> {
+    hegel::compose!(|tc| {
+        let name = tc.draw(name_gen());
+
+        // Unique attribute names within this element.
+        let n_attrs = tc.draw(generators::integers::<usize>().max_value(3));
+        let mut attrs: Vec<(String, String)> = Vec::new();
+        for _ in 0..n_attrs {
+            let an = tc.draw(name_gen());
+            if attrs.iter().any(|(k, _)| *k == an) {
+                continue; // keep names unique
+            }
+            let av = tc.draw(attr_value_gen());
+            attrs.push((an, av));
+        }
+
+        let mut children: Vec<Xml> = Vec::new();
+        if depth > 0 {
+            let n_children = tc.draw(generators::integers::<usize>().max_value(4));
+            for _ in 0..n_children {
+                // Mix of text and child elements.
+                if tc.draw(generators::booleans()) {
+                    children.push(Xml::Text(tc.draw(text_gen())));
+                } else {
+                    children.push(tc.draw(elem_gen(depth - 1)));
+                }
+            }
+        }
+
+        Xml::Elem {
+            name,
+            attrs,
+            children,
+        }
+    })
+    .boxed()
+}
+
+/// Serialize the model to an XML string.
+fn serialize(x: &Xml, out: &mut String) {
+    match x {
+        Xml::Text(t) => out.push_str(t),
+        Xml::Elem {
+            name,
+            attrs,
+            children,
+        } => {
+            out.push('<');
+            out.push_str(name);
+            for (k, v) in attrs {
+                out.push(' ');
+                out.push_str(k);
+                out.push_str("=\"");
+                out.push_str(v);
+                out.push('"');
+            }
+            if children.is_empty() {
+                out.push_str("/>");
+            } else {
+                out.push('>');
+                for c in children {
+                    serialize(c, out);
+                }
+                out.push_str("</");
+                out.push_str(name);
+                out.push('>');
+            }
+        }
+    }
+}
+
+/// Concatenation of all text content in document order.
+fn collect_text(x: &Xml, out: &mut String) {
+    match x {
+        Xml::Text(t) => out.push_str(t),
+        Xml::Elem { children, .. } => {
+            for c in children {
+                collect_text(c, out);
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: parse never panics on arbitrary text.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn parse_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+    let s = tc.draw(generators::text());
+    // Must return Ok or Err, never panic.
+    let _ = Document::parse(&s);
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: parse never panics on arbitrary bytes (lossy-decoded to str).
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn parse_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+    let bytes = tc.draw(generators::binary().max_size(256));
+    let s = String::from_utf8_lossy(&bytes);
+    let _ = Document::parse(&s);
+}
+
+// ---------------------------------------------------------------------------
+// Property 3: parse never panics on XML-shaped input (valid docs, and lightly
+// corrupted near-miss docs). This reaches deeper into the parser than random
+// bytes, which almost always fail at the first character.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn parse_never_panics_on_xml_shaped_input(tc: hegel::TestCase) {
+    let model = tc.draw(elem_gen(4));
+    let mut xml = String::new();
+    serialize(&model, &mut xml);
+
+    // Optionally corrupt the well-formed document to exercise error paths
+    // without panicking.
+    if tc.draw(generators::booleans()) && !xml.is_empty() {
+        let mut bytes = xml.into_bytes();
+        let n_edits = tc.draw(generators::integers::<usize>().max_value(4));
+        for _ in 0..n_edits {
+            if bytes.is_empty() {
+                break;
+            }
+            let idx = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+            let op = tc.draw(generators::integers::<u8>().max_value(2));
+            match op {
+                0 => {
+                    bytes[idx] = tc.draw(generators::integers::<u8>());
+                }
+                1 => {
+                    bytes.remove(idx);
+                }
+                _ => {
+                    bytes.insert(idx, tc.draw(generators::integers::<u8>()));
+                }
+            }
+        }
+        let s = String::from_utf8_lossy(&bytes);
+        let _ = Document::parse(&s);
+    } else {
+        let _ = Document::parse(&xml);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Property 4 (oracle-independent, high value): every node's range() is a valid
+// byte range into the input, well-ordered, and contained within its parent.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn node_ranges_are_valid(tc: hegel::TestCase) {
+    let model = tc.draw(elem_gen(4));
+    let mut xml = String::new();
+    serialize(&model, &mut xml);
+
+    let doc = match Document::parse(&xml) {
+        Ok(d) => d,
+        Err(_) => return, // only well-formed docs reach here in practice
+    };
+    let len = xml.len();
+
+    for node in doc.root().descendants() {
+        let r = node.range();
+        assert!(r.start <= r.end, "range start>end: {:?} in {:?}", r, xml);
+        assert!(r.end <= len, "range end past input: {:?} len={}", r, len);
+        assert!(
+            xml.is_char_boundary(r.start),
+            "range start not on char boundary: {:?}",
+            r
+        );
+        assert!(
+            xml.is_char_boundary(r.end),
+            "range end not on char boundary: {:?}",
+            r
+        );
+
+        // A child's range must be contained within its parent's range.
+        if let Some(parent) = node.parent() {
+            let pr = parent.range();
+            assert!(
+                r.start >= pr.start && r.end <= pr.end,
+                "child range {:?} not contained in parent range {:?}",
+                r,
+                pr
+            );
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Property 5 (oracle-independent, high value): tree structure invariants.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn tree_structure_is_consistent(tc: hegel::TestCase) {
+    let model = tc.draw(elem_gen(4));
+    let mut xml = String::new();
+    serialize(&model, &mut xml);
+
+    let doc = match Document::parse(&xml) {
+        Ok(d) => d,
+        Err(_) => return,
+    };
+
+    // Exactly one document (root) element.
+    let root_elem = doc.root_element();
+    assert!(root_elem.is_element());
+
+    // The root's element children are exactly one (the document element).
+    let elem_children: Vec<_> = doc.root().children().filter(|n| n.is_element()).collect();
+    assert_eq!(elem_children.len(), 1);
+    assert_eq!(elem_children[0].id(), root_elem.id());
+
+    // Every node's children must report it as their parent.
+    for node in doc.root().descendants() {
+        for child in node.children() {
+            let p = child.parent().expect("child must have a parent");
+            assert_eq!(
+                p.id(),
+                node.id(),
+                "child's parent disagrees with the node iterated from"
+            );
+        }
+
+        // first_child/last_child consistency.
+        match (node.first_child(), node.last_child()) {
+            (Some(_), Some(_)) => assert!(node.has_children()),
+            (None, None) => assert!(!node.has_children()),
+            _ => panic!("first_child/last_child disagree on {:?}", node.id()),
+        }
+    }
+
+    // descendants() is a valid preorder: it yields the node then all of its
+    // subtree before any sibling. We check that the total descendant count
+    // equals the recursive child count.
+    fn count(n: Node) -> usize {
+        1 + n.children().map(count).sum::<usize>()
+    }
+    let via_descendants = doc.root().descendants().count();
+    let via_recursion = count(doc.root());
+    assert_eq!(via_descendants, via_recursion);
+}
+
+// ---------------------------------------------------------------------------
+// Property 6: text content is preserved. Concatenated text of the parsed tree
+// equals the concatenation of the model's text (we constructed text to avoid
+// entity/whitespace normalization).
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn text_content_is_preserved(tc: hegel::TestCase) {
+    let model = tc.draw(elem_gen(4));
+    let mut xml = String::new();
+    serialize(&model, &mut xml);
+
+    let mut expected = String::new();
+    collect_text(&model, &mut expected);
+
+    let doc = Document::parse(&xml).expect("well-formed doc must parse");
+
+    let mut got = String::new();
+    for node in doc.root().descendants() {
+        if let Some(t) = node.text() {
+            // `text()` also returns text for the containing element in some
+            // APIs; roxmltree's `Node::text` returns Some only for text nodes
+            // and the first-child text of elements. To avoid double counting,
+            // only take actual text nodes.
+            if node.is_text() {
+                got.push_str(t);
+            }
+        }
+    }
+
+    assert_eq!(got, expected, "text not preserved for input {:?}", xml);
+}
+
+// ---------------------------------------------------------------------------
+// Property 7: element names and attribute values round-trip.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn names_and_attributes_roundtrip(tc: hegel::TestCase) {
+    let model = tc.draw(elem_gen(3));
+    let mut xml = String::new();
+    serialize(&model, &mut xml);
+
+    let doc = Document::parse(&xml).expect("well-formed doc must parse");
+
+    // Walk model and parsed tree in lockstep over elements.
+    fn check(model: &Xml, node: Node) {
+        if let Xml::Elem {
+            name,
+            attrs,
+            children,
+        } = model
+        {
+            assert_eq!(node.tag_name().name(), name.as_str());
+            assert_eq!(node.tag_name().namespace(), None);
+
+            for (k, v) in attrs {
+                assert_eq!(
+                    node.attribute(k.as_str()),
+                    Some(v.as_str()),
+                    "attribute {:?} mismatch",
+                    k
+                );
+            }
+
+            // Match element children positionally.
+            let model_elems: Vec<&Xml> = children
+                .iter()
+                .filter(|c| matches!(c, Xml::Elem { .. }))
+                .collect();
+            let parsed_elems: Vec<Node> = node.children().filter(|n| n.is_element()).collect();
+            assert_eq!(model_elems.len(), parsed_elems.len());
+            for (m, p) in model_elems.iter().zip(parsed_elems.iter()) {
+                check(m, *p);
+            }
+        }
+    }
+
+    check(&model, doc.root_element());
+}
+
+// ---------------------------------------------------------------------------
+// Property 8: duplicate attributes are rejected (XML well-formedness).
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn duplicate_attributes_are_rejected(tc: hegel::TestCase) {
+    let elem = tc.draw(name_gen());
+    let attr = tc.draw(name_gen());
+    let v1 = tc.draw(attr_value_gen());
+    let v2 = tc.draw(attr_value_gen());
+
+    let xml = format!(
+        "<{e} {a}=\"{v1}\" {a}=\"{v2}\"/>",
+        e = elem,
+        a = attr,
+        v1 = v1,
+        v2 = v2
+    );
+
+    let res = Document::parse(&xml);
+    assert!(
+        matches!(res, Err(Error::DuplicatedAttribute(_, _))),
+        "expected DuplicatedAttribute for {:?}, got {:?}",
+        xml,
+        res
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Property 9: namespace resolution is consistent. A prefixed element with a
+// matching xmlns declaration resolves to the declared URI.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn namespace_resolution_is_consistent(tc: hegel::TestCase) {
+    let prefix = tc.draw(name_gen());
+    let local = tc.draw(name_gen());
+    // A URI value that survives attribute normalization verbatim.
+    let uri = tc.draw(attr_value_gen().filter(|s: &String| !s.is_empty()));
+
+    let xml = format!(
+        "<{p}:{l} xmlns:{p}=\"{u}\"/>",
+        p = prefix,
+        l = local,
+        u = uri
+    );
+
+    let doc = match Document::parse(&xml) {
+        Ok(d) => d,
+        Err(_) => return, // e.g. reserved prefixes like xmlns/xml
+    };
+    let root = doc.root_element();
+    assert_eq!(root.tag_name().name(), local.as_str());
+    assert_eq!(root.tag_name().namespace(), Some(uri.as_str()));
+    // lookup_namespace_uri agrees with the resolved tag namespace.
+    assert_eq!(
+        root.lookup_namespace_uri(Some(prefix.as_str())),
+        Some(uri.as_str())
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Property 10: entity-expansion bombs are bounded (no OOM / hang). roxmltree
+// documents an entity depth limit of 10 and a per-reference count limit of
+// 255, which defends against "billion laughs". We build such a bomb and assert
+// parsing returns quickly with an error rather than blowing up.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn entity_expansion_is_bounded(tc: hegel::TestCase) {
+    // Number of nested entity levels and fan-out per level. Even modest values
+    // would expand exponentially if unbounded (fanout^levels expansions).
+    let levels = tc.draw(generators::integers::<usize>().min_value(3).max_value(12));
+    let fanout = tc.draw(generators::integers::<usize>().min_value(2).max_value(10));
+
+    let mut dtd = String::from("<!ENTITY e0 \"boom\">");
+    for i in 1..=levels {
+        let mut val = String::new();
+        for _ in 0..fanout {
+            val.push_str(&format!("&e{};", i - 1));
+        }
+        dtd.push_str(&format!("<!ENTITY e{} \"{}\">", i, val));
+    }
+    let xml = format!(
+        "<!DOCTYPE d [{dtd}]><d>&e{lvl};</d>",
+        dtd = dtd,
+        lvl = levels
+    );
+
+    // The bomb must be rejected (the loop detector trips) rather than causing
+    // exponential expansion. Parsing must complete; if it OOMed or hung this
+    // test would abort/hang instead of asserting.
+    let res = Document::parse(&xml);
+    assert!(
+        res.is_err(),
+        "expected the entity bomb to be rejected, got Ok for levels={} fanout={}",
+        levels,
+        fanout
+    );
+}
+
+// ---------------------------------------------------------------------------
+// KNOWN FAILURE (process-aborting): deeply nested elements overflow the stack.
+//
+// roxmltree parses element content with a recursive descent
+// (parse_element -> parse_content -> parse_element) and enforces NO limit on
+// element nesting depth (only entity-reference depth is limited, to 10). A
+// document nested only a few hundred elements deep overflows the stack and
+// ABORTS the process. The README states the library "must not panic" and calls
+// any panic "a critical bug"; a stack-overflow abort is strictly worse.
+//
+// Empirically the overflow occurs around depth ~500 on an 8 MiB main-thread
+// stack; Rust test threads use a smaller (2 MiB) stack, so it aborts even
+// sooner under `cargo test`. Because a stack overflow aborts the whole test
+// process (it cannot be caught, and no hegel counterexample is recorded), this
+// reproducer is #[ignore]d so it cannot take down the rest of the suite. Run it
+// explicitly with `cargo test -- --ignored deep_nesting_stack_overflow`.
+// ---------------------------------------------------------------------------
+
+#[test]
+#[ignore = "process-aborting stack overflow: roxmltree has no element nesting depth limit"]
+fn deep_nesting_stack_overflow() {
+    let depth = 100_000usize;
+    let mut s = String::with_capacity(depth * 7);
+    for _ in 0..depth {
+        s.push_str("<a>");
+    }
+    for _ in 0..depth {
+        s.push_str("</a>");
+    }
+    // With the bug present this aborts with "stack overflow" before returning.
+    // If roxmltree ever gains a nesting limit, this should return Err instead.
+    let res = Document::parse(&s);
+    assert!(
+        res.is_err(),
+        "expected deeply nested input to be rejected with an error, not accepted or aborted"
+    );
+}
