+#[cfg(test)]
+mod tests {
+    use std::string::ToString;
+    use std::vec::Vec;
+
+    use hegel::generators;
+    use hegel::TestCase;
+
+    use super::*;
+
+    /// Model-based test: `Params` must agree with a simple `Vec<Vec<u16>>`
+    /// model under every sequence of `push`/`extend`/`clear` operations the
+    /// parser can perform (guarded by `is_full`, as all call sites are).
+    struct ParamsMachine {
+        subject: Params,
+        /// Completed parameters.
+        completed: Vec<Vec<u16>>,
+        /// Subparameters of the parameter currently being built via `extend`.
+        current: Vec<u16>,
+    }
+
+    #[hegel::state_machine]
+    impl ParamsMachine {
+        #[rule]
+        fn push(&mut self, tc: TestCase) {
+            tc.assume(!self.subject.is_full());
+            let item = tc.draw(generators::integers::<u16>());
+            self.subject.push(item);
+
+            let mut param = core::mem::take(&mut self.current);
+            param.push(item);
+            self.completed.push(param);
+        }
+
+        #[rule]
+        fn extend(&mut self, tc: TestCase) {
+            tc.assume(!self.subject.is_full());
+            let item = tc.draw(generators::integers::<u16>());
+            self.subject.extend(item);
+            self.current.push(item);
+        }
+
+        #[rule]
+        fn clear(&mut self, _tc: TestCase) {
+            self.subject.clear();
+            self.completed.clear();
+            self.current.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: TestCase) {
+            let mut expected = self.completed.clone();
+            if !self.current.is_empty() {
+                expected.push(self.current.clone());
+            }
+
+            let actual: Vec<Vec<u16>> = self.subject.iter().map(|param| param.to_vec()).collect();
+            assert_eq!(actual, expected);
+
+            let total = self.completed.iter().map(Vec::len).sum::<usize>() + self.current.len();
+            assert_eq!(self.subject.len(), total);
+            assert_eq!(self.subject.is_empty(), total == 0);
+        }
+    }
+
+    #[hegel::test]
+    fn params_agree_with_model(tc: TestCase) {
+        let machine = ParamsMachine {
+            subject: Params::default(),
+            completed: Vec::new(),
+            current: Vec::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    /// Property: `ParamsIter::size_hint` must satisfy the `Iterator` contract:
+    /// lower bound <= actual number of items <= upper bound.
+    #[hegel::test]
+    fn params_iter_size_hint_is_consistent(tc: TestCase) {
+        let mut params = Params::default();
+        let num_ops = tc.draw(generators::integers::<usize>().max_value(MAX_PARAMS));
+        for _ in 0..num_ops {
+            let item = tc.draw(generators::integers::<u16>());
+            if tc.draw(generators::booleans()) {
+                params.push(item);
+            } else {
+                params.extend(item);
+            }
+        }
+
+        let (lower, upper) = params.iter().size_hint();
+        let count = params.iter().count();
+        assert!(lower <= count, "size_hint lower bound {} exceeds item count {}", lower, count);
+        if let Some(upper) = upper {
+            assert!(count <= upper, "item count {} exceeds size_hint upper bound {}", count, upper);
+        }
+    }
+}
