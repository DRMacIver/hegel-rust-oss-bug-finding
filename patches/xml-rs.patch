+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+
+#[path = "util/pbt.rs"]
+mod pbt;
+
+mod pbt_writer {
+    use super::pbt;
+    use xml::reader::{EventReader, ParserConfig, XmlEvent};
+    use xml::writer::{EmitterConfig, XmlEvent as WriterEvent};
+
+    /// Property (the crown round-trip): a document built from arbitrary
+    /// well-formed elements, attributes, text (PCDATA and CDATA), and
+    /// comments, written with `EventWriter`, reads back with `EventReader`
+    /// as exactly the same canonical structure — element names, attribute
+    /// names/values (in order), and text content all survive, which requires
+    /// the writer to escape every character the reader would otherwise
+    /// mis-parse.
+    #[hegel::test]
+    fn document_write_read_roundtrip(tc: hegel::TestCase) {
+        let root = tc.draw(pbt::elements(3));
+        let bytes = pbt::write_document(&root);
+        let parsed = pbt::parse_stream(&bytes, ParserConfig::new()).unwrap_or_else(|e| {
+            panic!("written document failed to parse: {e}\ndocument: {}", String::from_utf8_lossy(&bytes))
+        });
+        assert_eq!(parsed, pbt::expected_stream(&root), "document: {}", String::from_utf8_lossy(&bytes));
+    }
+
+    /// Property: arbitrary text (generated at the PCDATA encode-set boundary:
+    /// `<`, `>`, `&`, quotes, `]]>`, entity-reference look-alikes) written as
+    /// `Characters` is recovered exactly by the reader. `\r` is excluded —
+    /// its loss is pinned by `known_bug_pcdata_carriage_return_lost_in_roundtrip`.
+    #[hegel::test]
+    fn pcdata_text_write_read_roundtrip(tc: hegel::TestCase) {
+        let text = tc.draw(pbt::xml_texts());
+        let root = pbt::Element {
+            name: "root".to_string(),
+            attrs: vec![],
+            children: vec![pbt::Node::Text { content: text, cdata: false }],
+        };
+        let bytes = pbt::write_document(&root);
+        let parsed = pbt::parse_stream(&bytes, ParserConfig::new()).unwrap_or_else(|e| {
+            panic!("written document failed to parse: {e}\ndocument: {}", String::from_utf8_lossy(&bytes))
+        });
+        assert_eq!(parsed, pbt::expected_stream(&root), "document: {}", String::from_utf8_lossy(&bytes));
+    }
+
+    /// Property: arbitrary attribute names and values — including quotes,
+    /// `<`, `&`, and `\r`/`\n` (which the writer must escape as character
+    /// references to survive attribute-value normalization) — round-trip
+    /// exactly through write→read. `\t` is excluded from the generator; its
+    /// loss is pinned by `known_bug_attribute_tab_lost_in_roundtrip`.
+    #[hegel::test]
+    fn attribute_write_read_roundtrip(tc: hegel::TestCase) {
+        let name = tc.draw(pbt::xml_names());
+        let attr_name = tc.draw(pbt::xml_names());
+        let value = tc.draw(pbt::attr_values());
+        let root = pbt::Element {
+            name,
+            attrs: vec![(attr_name, value)],
+            children: vec![],
+        };
+        let bytes = pbt::write_document(&root);
+        let parsed = pbt::parse_stream(&bytes, ParserConfig::new()).unwrap_or_else(|e| {
+            panic!("written document failed to parse: {e}\ndocument: {}", String::from_utf8_lossy(&bytes))
+        });
+        assert_eq!(parsed, pbt::expected_stream(&root), "document: {}", String::from_utf8_lossy(&bytes));
+    }
+
+    /// KNOWN BUG (kept failing deliberately): `EventWriter` does not escape
+    /// `\r` in character data — `PcDataEscapes` (src/escape.rs) covers only
+    /// `<`, `>`, `&` — so a literal CR is written raw, and the reader's
+    /// XML-mandated end-of-line normalization then turns it into `\n`.
+    /// Write→read of `Characters` is therefore lossy for `\r`. The writer
+    /// already escapes `\r` as `&#xD;` in *attribute* values, which round-trip
+    /// correctly; PCDATA (and CDATA sections) should get the same treatment.
+    /// This test asserts the lossless round-trip a correct writer would
+    /// provide and FAILS until the writer escapes `\r` in PCDATA.
+    #[test]
+    fn known_bug_pcdata_carriage_return_lost_in_roundtrip() {
+        let mut buf = Vec::new();
+        {
+            let mut w = EmitterConfig::new().create_writer(&mut buf);
+            w.write(WriterEvent::start_element("root")).unwrap();
+            w.write(WriterEvent::characters("a\rb")).unwrap();
+            w.write(WriterEvent::end_element()).unwrap();
+        }
+        let mut reader = EventReader::new(&buf[..]);
+        let mut text = String::new();
+        loop {
+            match reader.next().unwrap() {
+                XmlEvent::Characters(s) | XmlEvent::Whitespace(s) => text.push_str(&s),
+                XmlEvent::EndDocument => break,
+                _ => {},
+            }
+        }
+        assert_eq!(text, "a\rb", "CR in character data must survive a write→read round-trip");
+    }
+
+    /// KNOWN BUG (kept failing deliberately): `EventWriter` does not escape a
+    /// literal tab in attribute values — `AttributeEscapes` (src/escape.rs)
+    /// covers `<`, `>`, `"`, `'`, `&`, `\n`, `\r` but not `\t` — and XML's
+    /// mandatory attribute-value normalization (XML 1.0 §3.3.3, implemented by
+    /// the reader and pinned by `test_attribute_normalization` in
+    /// tests/event_reader.rs) turns a literal tab into a space on re-parse.
+    /// Write→read of an attribute value containing `\t` therefore yields `" "`.
+    /// The writer should emit `&#x9;` like it already does for `\n`/`\r`.
+    /// This test asserts the lossless round-trip a correct writer would
+    /// provide and FAILS until the writer escapes `\t` in attribute values.
+    /// Found by hegel (shrunk counterexample: attribute value "\t").
+    #[test]
+    fn known_bug_attribute_tab_lost_in_roundtrip() {
+        let mut buf = Vec::new();
+        {
+            let mut w = EmitterConfig::new().create_writer(&mut buf);
+            w.write(WriterEvent::start_element("root").attr("a", "x\ty")).unwrap();
+            w.write(WriterEvent::end_element()).unwrap();
+        }
+        let mut reader = EventReader::new(&buf[..]);
+        let mut value = None;
+        loop {
+            match reader.next().unwrap() {
+                XmlEvent::StartElement { attributes, .. } => value = Some(attributes[0].value.clone()),
+                XmlEvent::EndDocument => break,
+                _ => {},
+            }
+        }
+        assert_eq!(value.as_deref(), Some("x\ty"), "tab in an attribute value must survive a write→read round-trip");
+    }
+}
