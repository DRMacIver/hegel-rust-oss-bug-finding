+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+
+#[path = "util/pbt.rs"]
+mod pbt;
+
+mod pbt_reader {
+    use super::pbt;
+    use hegel::generators::{self, Generator};
+    use xml::reader::{EventReader, ParserConfig, XmlEvent};
+
+    /// Drives a reader to its terminal event (EndDocument or Err), with a cap
+    /// on the number of events as a termination guard. Returns the terminal
+    /// event and the number of non-terminal events seen.
+    fn drive(mut reader: EventReader<&[u8]>, max_events: usize) -> (xml::reader::Result<XmlEvent>, usize) {
+        let mut n = 0;
+        loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => return (Ok(XmlEvent::EndDocument), n),
+                Err(e) => return (Err(e), n),
+                Ok(_) => {
+                    n += 1;
+                    assert!(n <= max_events, "parser produced more than {max_events} events; possible non-termination");
+                },
+            }
+        }
+    }
+
+    /// Property: fully driving `EventReader` never panics and always
+    /// terminates with `EndDocument` or an error, on arbitrary bytes, text,
+    /// and XML-shaped soup, under arbitrary parser configurations. The
+    /// documented terminal-event contract also holds: after `Err` or
+    /// `EndDocument`, `next()` returns the same event again.
+    #[hegel::test]
+    fn parser_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+        let input: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::binary().max_size(2048).boxed(),
+            pbt::xml_soups().boxed(),
+            generators::text().max_size(512).map(String::into_bytes).boxed(),
+        ));
+        let config = ParserConfig::new()
+            .trim_whitespace(tc.draw(generators::booleans()))
+            .whitespace_to_characters(tc.draw(generators::booleans()))
+            .cdata_to_characters(tc.draw(generators::booleans()))
+            .ignore_comments(tc.draw(generators::booleans()))
+            .coalesce_characters(tc.draw(generators::booleans()))
+            .replace_unknown_entity_references(tc.draw(generators::booleans()))
+            .ignore_root_level_whitespace(tc.draw(generators::booleans()))
+            .allow_multiple_root_elements(tc.draw(generators::booleans()))
+            .ignore_invalid_encoding_declarations(tc.draw(generators::booleans()));
+
+        let mut reader = EventReader::new_with_config(&input[..], config);
+        let terminal = loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => break Ok(XmlEvent::EndDocument),
+                Err(e) => break Err(e),
+                Ok(_) => {},
+            }
+        };
+        // documented on EventReader::next(): "If this returns Err or
+        // XmlEvent::EndDocument then further calls to this method will return
+        // this event again."
+        match (terminal, reader.next()) {
+            (Ok(XmlEvent::EndDocument), Ok(XmlEvent::EndDocument)) => {},
+            (Err(first), Err(again)) => assert_eq!(first, again),
+            other => panic!("terminal event was not repeated: {other:?}"),
+        }
+    }
+
+    /// Property: the event stream is always well-nested — every `EndElement`
+    /// matches the most recent unclosed `StartElement` (same name, LIFO), and
+    /// `EndDocument` is only reached with no elements left open. This must
+    /// hold for every prefix of events the parser produces, even when it
+    /// later errors out.
+    #[hegel::test]
+    fn event_stream_is_well_nested(tc: hegel::TestCase) {
+        let input: Vec<u8> = if tc.draw(generators::booleans()) {
+            pbt::write_document(&tc.draw(pbt::elements(3)))
+        } else {
+            tc.draw(pbt::xml_soups())
+        };
+        let mut reader = EventReader::new(&input[..]);
+        let mut stack: Vec<(Option<String>, String)> = Vec::new();
+        loop {
+            match reader.next() {
+                Ok(XmlEvent::StartElement { name, .. }) => {
+                    stack.push((name.prefix, name.local_name));
+                },
+                Ok(XmlEvent::EndElement { name }) => {
+                    let top = stack.pop().expect("EndElement without a matching StartElement");
+                    assert_eq!(top, (name.prefix, name.local_name), "EndElement does not match the innermost open StartElement");
+                },
+                Ok(XmlEvent::EndDocument) => {
+                    assert!(stack.is_empty(), "EndDocument emitted with unclosed elements: {stack:?}");
+                    break;
+                },
+                Ok(_) => {},
+                Err(_) => break,
+            }
+        }
+    }
+
+    /// Property: deeply nested documents (`<a><a>…</a></a>`) never crash the
+    /// process — the parser keeps its element stack on the heap. A properly
+    /// closed document of depth N produces exactly N starts and N ends; a
+    /// truncated one ends in an error, not a panic.
+    ///
+    /// The depth is capped at 1200 to keep the test's runtime sane: parsing
+    /// is O(depth^2) (see `known_issue_deep_nesting_quadratic_time` below).
+    /// The cap protects the test's runtime, not any library contract.
+    #[hegel::test]
+    fn deeply_nested_documents_never_crash(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(1200));
+        let closed = tc.draw(generators::booleans());
+        let name = tc.draw(pbt::xml_names());
+
+        let mut doc = String::with_capacity(depth * (name.len() + 3) * 2);
+        for _ in 0..depth {
+            doc.push('<');
+            doc.push_str(&name);
+            doc.push('>');
+        }
+        if closed {
+            for _ in 0..depth {
+                doc.push_str("</");
+                doc.push_str(&name);
+                doc.push('>');
+            }
+        }
+
+        let mut reader = EventReader::from_str(&doc);
+        let mut starts = 0usize;
+        let mut ends = 0usize;
+        let terminal_ok = loop {
+            match reader.next() {
+                Ok(XmlEvent::StartElement { .. }) => starts += 1,
+                Ok(XmlEvent::EndElement { .. }) => ends += 1,
+                Ok(XmlEvent::EndDocument) => break true,
+                Ok(_) => {},
+                Err(_) => break false,
+            }
+        };
+        if closed {
+            assert!(terminal_ok, "well-formed deeply nested document was rejected");
+            assert_eq!((starts, ends), (depth, depth));
+        } else {
+            assert!(!terminal_ok, "truncated document must end in an error");
+        }
+    }
+
+    // KNOWN ISSUE (performance, documented in HEGEL_REPORT.md): parse time
+    // grows quadratically with element nesting depth, because every
+    // StartElement event calls `NamespaceStack::squash()`
+    // (src/reader/parser.rs:714), which rebuilds the full flattened namespace
+    // mapping by walking the entire namespace stack — O(depth) work per
+    // element, O(depth^2) per document. Measured (debug build):
+    //   depth  1_000 ≈  27 ms
+    //   depth 10_000 ≈ 2.5 s
+    //   depth 50_000 ≈  61 s
+    // A ~300 KB hostile document therefore costs a minute of CPU, and the
+    // input-size cap recommended in the README (`Read::take`) does not defend
+    // against it. #[ignore]d so the suite stays fast.
+    #[test]
+    #[ignore = "reproducer for quadratic parse time on deep nesting (takes ~10s in debug)"]
+    fn known_issue_deep_nesting_quadratic_time() {
+        fn time_depth(depth: usize) -> std::time::Duration {
+            let mut doc = String::with_capacity(depth * 8);
+            for _ in 0..depth { doc.push_str("<a>"); }
+            for _ in 0..depth { doc.push_str("</a>"); }
+            let start = std::time::Instant::now();
+            let mut reader = EventReader::from_str(&doc);
+            loop {
+                match reader.next() {
+                    Ok(XmlEvent::EndDocument) => break,
+                    Ok(_) => {},
+                    Err(e) => panic!("unexpected parse error: {e}"),
+                }
+            }
+            start.elapsed()
+        }
+        let t4k = time_depth(4_000);
+        let t8k = time_depth(8_000);
+        eprintln!("depth 4000: {t4k:?}, depth 8000: {t8k:?} (linear would be ~2x, quadratic ~4x)");
+    }
+
+    /// Property: "billion laughs" entity-expansion bombs are rejected with an
+    /// error (`EntityTooBig`), never a hang, OOM, or panic. Whenever the full
+    /// expansion would exceed the default `max_entity_expansion_length`, the
+    /// parser must return `Err`; whatever the outcome, it must not deliver
+    /// unbounded output. Small, benign expansions must still expand correctly.
+    #[hegel::test]
+    fn entity_expansion_bombs_are_rejected(tc: hegel::TestCase) {
+        let fanout = tc.draw(generators::integers::<u32>().min_value(2).max_value(10));
+        let levels = tc.draw(generators::integers::<u32>().min_value(1).max_value(12));
+
+        let mut doc = String::from("<?xml version=\"1.0\"?>\n<!DOCTYPE lolz [\n<!ENTITY lol0 \"lol\">\n");
+        for level in 1..=levels {
+            let reference = format!("&lol{};", level - 1);
+            doc.push_str(&format!("<!ENTITY lol{level} \"{}\">\n", reference.repeat(fanout as usize)));
+        }
+        doc.push_str(&format!("]>\n<lolz>&lol{levels};</lolz>"));
+
+        // full expansion size in chars: 3 * fanout^levels
+        let expansion = 3u128.saturating_mul((fanout as u128).saturating_pow(levels));
+        let default_limit = 1_000_000u128; // ParserConfig default max_entity_expansion_length
+
+        let mut reader = EventReader::from_str(&doc);
+        let mut text = String::new();
+        let result = loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => break Ok(()),
+                Ok(XmlEvent::Characters(s)) => {
+                    text.push_str(&s);
+                    // termination/robustness guard: the parser must never
+                    // deliver more than a small multiple of its expansion limit
+                    assert!(text.len() as u128 <= 4 * default_limit, "parser delivered unbounded entity expansion");
+                },
+                Ok(_) => {},
+                Err(e) => break Err(e),
+            }
+        };
+
+        if expansion > default_limit {
+            assert!(result.is_err(), "expansion of {expansion} chars exceeds the {default_limit} limit but was not rejected");
+        }
+        if result.is_ok() {
+            // accepted expansions must be exact
+            assert_eq!(text, "lol".repeat((expansion / 3) as usize));
+        }
+    }
+
+    /// Property: ill-formed documents — mismatched tags, duplicate
+    /// attributes, invalid names, truncation, stray end tags, invalid
+    /// characters — are rejected with `Err`, never a panic and never a
+    /// successful parse.
+    #[hegel::test]
+    fn malformed_documents_are_rejected(tc: hegel::TestCase) {
+        let names: Vec<String> = tc.draw(generators::vecs(pbt::xml_names()).min_size(2).max_size(2).unique(true));
+        let (n1, n2) = (&names[0], &names[1]);
+        let attr = tc.draw(pbt::xml_names());
+        let case = tc.draw(generators::integers::<u8>().max_value(6));
+        let doc = match case {
+            // mismatched close tag
+            0 => format!("<{n1}></{n2}>"),
+            // duplicate attribute
+            1 => format!("<{n1} {attr}=\"1\" {attr}=\"2\"/>"),
+            // name starting with a NameChar that is not a NameStartChar
+            2 => {
+                let bad = tc.draw(generators::sampled_from(vec!['-', '.', '0', '5', '9', '\u{B7}']));
+                format!("<{bad}{n1}/>")
+            },
+            // truncated document (unclosed root)
+            3 => format!("<{n1}><{n2}></{n2}>"),
+            // stray end tag with no open element
+            4 => format!("</{n1}>"),
+            // control character forbidden by XML 1.0
+            5 => format!("<{n1}>\u{1}</{n1}>"),
+            // attribute without a value
+            _ => format!("<{n1} {attr}></{n1}>"),
+        };
+
+        let (terminal, _) = drive(EventReader::from_str(&doc), 1_000);
+        assert!(terminal.is_err(), "ill-formed document was accepted (case {case}): {doc:?}");
+    }
+
+    /// Property: parser configuration options that only re-shape the event
+    /// stream (CDATA→characters, whitespace→characters, comment reporting,
+    /// coalescing) never change the canonical document content: element
+    /// structure, attributes, and merged text are identical under every such
+    /// configuration. (`trim_whitespace` is excluded — it deliberately
+    /// changes text content.)
+    #[hegel::test]
+    fn config_variations_agree_on_canonical_stream(tc: hegel::TestCase) {
+        let root = tc.draw(pbt::elements(3));
+        let bytes = pbt::write_document(&root);
+
+        let base = pbt::parse_stream(&bytes, ParserConfig::new())
+            .expect("writer output must be well-formed");
+
+        let config = ParserConfig::new()
+            .cdata_to_characters(tc.draw(generators::booleans()))
+            .whitespace_to_characters(tc.draw(generators::booleans()))
+            .ignore_comments(tc.draw(generators::booleans()))
+            .coalesce_characters(tc.draw(generators::booleans()))
+            .replace_unknown_entity_references(tc.draw(generators::booleans()))
+            .ignore_root_level_whitespace(tc.draw(generators::booleans()))
+            .allow_multiple_root_elements(tc.draw(generators::booleans()));
+        let other = pbt::parse_stream(&bytes, config)
+            .expect("event-shaping config options must not make a well-formed document unparseable");
+
+        assert_eq!(base, other);
+    }
+}
