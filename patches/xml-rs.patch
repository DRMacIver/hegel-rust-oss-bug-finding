+//! Shared generators and helpers for the hegel property-based tests in
+//! `tests/event_reader.rs` and `tests/event_writer.rs`.
+#![allow(dead_code)]
+
+use hegel::generators::{self, BoxedGenerator, Generator};
+use xml::reader::{EventReader, ParserConfig, XmlEvent};
+use xml::writer::{EmitterConfig, EventWriter, XmlEvent as WriterEvent};
+use xml::common::{is_name_char, is_name_start_char};
+
+/// A generator over characters valid in XML 1.0 content (no `\r`; the reader
+/// normalizes `\r`/`\r\n` to `\n` per the spec, and the writer does not escape
+/// `\r` in PCDATA — see `known_bug_pcdata_carriage_return_lost_in_roundtrip`
+/// in `tests/event_writer.rs`).
+pub fn xml10_content_chars() -> BoxedGenerator<'static, char> {
+    hegel::one_of!(
+        // characters at the writer's escape-set boundary and other syntax chars
+        generators::sampled_from(
+            "\t\n<>&\"';[]=- ".chars().map(|c| c as u32).collect::<Vec<u32>>(),
+        ),
+        generators::integers::<u32>().min_value(0x20).max_value(0x7E),
+        generators::integers::<u32>().min_value(0x20).max_value(0xD7FF),
+        generators::integers::<u32>().min_value(0xE000).max_value(0xFFFD),
+        generators::integers::<u32>().min_value(0x10000).max_value(0x10FFFF),
+    )
+    .map(|n| char::from_u32(n).expect("all generated ranges are valid scalar values"))
+    .boxed()
+}
+
+fn name_start_chars() -> BoxedGenerator<'static, char> {
+    // Subranges of NameStartChar (XML 1.1 §2.3), excluding ':' so generated
+    // names never look namespace-qualified.
+    hegel::one_of!(
+        generators::integers::<u32>().min_value('a' as u32).max_value('z' as u32),
+        generators::integers::<u32>().min_value('A' as u32).max_value('Z' as u32),
+        generators::just('_' as u32),
+        generators::integers::<u32>().min_value(0xC0).max_value(0xD6),
+        generators::integers::<u32>().min_value(0x370).max_value(0x37D),
+        generators::integers::<u32>().min_value(0x2070).max_value(0x218F),
+        generators::integers::<u32>().min_value(0x3001).max_value(0xD7FF),
+        generators::integers::<u32>().min_value(0x10000).max_value(0xEFFFF),
+    )
+    .map(|n| char::from_u32(n).expect("all generated ranges are valid scalar values"))
+    .boxed()
+}
+
+fn name_rest_chars() -> BoxedGenerator<'static, char> {
+    hegel::one_of!(
+        name_start_chars(),
+        generators::sampled_from(vec!['-', '.', '\u{B7}']),
+        generators::integers::<u32>()
+            .min_value('0' as u32)
+            .max_value('9' as u32)
+            .map(|n| char::from_u32(n).unwrap())
+            .boxed(),
+        generators::integers::<u32>()
+            .min_value(0x300)
+            .max_value(0x36F)
+            .map(|n| char::from_u32(n).unwrap())
+            .boxed(),
+    )
+    .boxed()
+}
+
+/// A valid XML name without a namespace prefix (no `:`), never the reserved
+/// namespace-declaration name `xmlns`.
+#[hegel::composite]
+pub fn xml_names(tc: hegel::TestCase) -> String {
+    let first = tc.draw(name_start_chars());
+    let rest: Vec<char> = tc.draw(generators::vecs(name_rest_chars()).max_size(8));
+    let mut name: String = std::iter::once(first).chain(rest).collect();
+    if name == "xmlns" {
+        // `xmlns` attributes are namespace declarations, not ordinary attributes
+        name.push('_');
+    }
+    debug_assert!(name.chars().enumerate().all(|(i, c)| if i == 0 { is_name_start_char(c) } else { is_name_char(c) }));
+    name
+}
+
+/// Text content generated at the writer's PCDATA encode-set boundary
+/// (`<`, `>`, `&`) plus strings that look like markup or entity references.
+/// Excludes `\r` (see `xml10_content_chars`).
+#[hegel::composite]
+pub fn xml_texts(tc: hegel::TestCase) -> String {
+    let pieces: Vec<String> = tc.draw(generators::vecs(hegel::one_of!(
+        generators::sampled_from(vec![
+            "<", ">", "&", "\"", "'", ";", "]]>", "]]", "&amp;", "&lt;", "&#60;",
+            "&#x3C;", "&#", "<!--", "-->", "<![CDATA[", " ", "\n", "\t",
+        ])
+        .map(str::to_string)
+        .boxed(),
+        xml10_content_chars().map(|c| c.to_string()).boxed(),
+    ))
+    .max_size(24));
+    pieces.concat()
+}
+
+/// Attribute values: like `xml_texts` but additionally includes `\r`, which the
+/// writer escapes as `&#xD;` in attribute values (unlike in PCDATA), so it must
+/// round-trip.
+///
+/// `\t` is excluded: the writer does not escape a literal tab in attribute
+/// values, and the reader's XML-mandated attribute-value normalization then
+/// turns it into a space, so it cannot round-trip. This is a real bug, pinned
+/// by `known_bug_attribute_tab_lost_in_roundtrip` in `tests/event_writer.rs`.
+#[hegel::composite]
+pub fn attr_values(tc: hegel::TestCase) -> String {
+    let pieces: Vec<String> = tc.draw(generators::vecs(hegel::one_of!(
+        generators::sampled_from(vec![
+            "<", ">", "&", "\"", "'", ";", "\r", "\n", "\r\n", "&#xD;", "&#x9;",
+            "&amp;", "]]>", " ",
+        ])
+        .map(str::to_string)
+        .boxed(),
+        xml10_content_chars().map(|c| c.to_string()).boxed(),
+    ))
+    .max_size(16));
+    pieces.concat().replace('\t', " ")
+}
+
+/// Comment content. `-` is excluded entirely: `--` cannot appear inside an XML
+/// comment and the writer rewrites it, so it cannot round-trip by design.
+#[hegel::composite]
+pub fn comment_texts(tc: hegel::TestCase) -> String {
+    let cs: Vec<char> = tc.draw(generators::vecs(xml10_content_chars()).max_size(12));
+    cs.into_iter().filter(|&c| c != '-').collect()
+}
+
+/// A model XML document tree.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Node {
+    Element(Element),
+    /// Text content; `cdata` selects whether it is written as a CDATA section
+    /// or as escaped PCDATA (both must read back as the same text).
+    Text { content: String, cdata: bool },
+    Comment(String),
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Element {
+    pub name: String,
+    pub attrs: Vec<(String, String)>,
+    pub children: Vec<Node>,
+}
+
+/// Recursive generator for well-formed XML document trees.
+pub fn elements(depth: u32) -> BoxedGenerator<'static, Element> {
+    hegel::compose!(|tc| {
+        let name = tc.draw(xml_names());
+        let attr_names: Vec<String> =
+            tc.draw(generators::vecs(xml_names()).max_size(3).unique(true));
+        let mut attrs = Vec::with_capacity(attr_names.len());
+        for attr_name in attr_names {
+            let value = tc.draw(attr_values());
+            attrs.push((attr_name, value));
+        }
+        let n_children = if depth == 0 {
+            0
+        } else {
+            tc.draw(generators::integers::<usize>().max_value(4))
+        };
+        let mut children = Vec::with_capacity(n_children);
+        for _ in 0..n_children {
+            let choice = tc.draw(generators::integers::<u8>().max_value(4));
+            children.push(match choice {
+                0 | 1 => Node::Element(tc.draw(elements(depth - 1))),
+                2 => Node::Text { content: tc.draw(xml_texts()), cdata: false },
+                3 => Node::Text { content: tc.draw(xml_texts()), cdata: true },
+                _ => Node::Comment(tc.draw(comment_texts())),
+            });
+        }
+        Element { name, attrs, children }
+    })
+    .boxed()
+}
+
+fn write_element<W: std::io::Write>(w: &mut EventWriter<W>, e: &Element) {
+    let mut start = WriterEvent::start_element(e.name.as_str());
+    for (name, value) in &e.attrs {
+        start = start.attr(name.as_str(), value.as_str());
+    }
+    w.write(start).expect("writing start element");
+    for child in &e.children {
+        match child {
+            Node::Element(el) => write_element(w, el),
+            Node::Text { content, cdata } => {
+                if *cdata {
+                    w.write(WriterEvent::cdata(content)).expect("writing cdata");
+                } else {
+                    w.write(WriterEvent::characters(content)).expect("writing characters");
+                }
+            },
+            Node::Comment(content) => {
+                w.write(WriterEvent::comment(content)).expect("writing comment");
+            },
+        }
+    }
+    w.write(WriterEvent::end_element()).expect("writing end element");
+}
+
+/// Serializes a document tree with `EventWriter` under the default config.
+pub fn write_document(root: &Element) -> Vec<u8> {
+    let mut buf = Vec::new();
+    let mut w = EmitterConfig::new().create_writer(&mut buf);
+    write_element(&mut w, root);
+    drop(w);
+    buf
+}
+
+/// One canonical item of a parsed event stream: element structure plus merged
+/// text content, with comments, PIs, and document events dropped.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Item {
+    Start(String, Vec<(String, String)>),
+    End(String),
+    Text(String),
+}
+
+/// Parses a document into its canonical stream: `Characters`, `CData`, and
+/// `Whitespace` all count as text, adjacent text is merged, comments/PIs/
+/// doctype/document events are dropped.
+pub fn parse_stream(bytes: &[u8], config: ParserConfig) -> Result<Vec<Item>, xml::reader::Error> {
+    let mut reader = EventReader::new_with_config(bytes, config);
+    let mut out = Vec::new();
+    loop {
+        match reader.next()? {
+            XmlEvent::StartDocument { .. }
+            | XmlEvent::ProcessingInstruction { .. }
+            | XmlEvent::Doctype { .. }
+            | XmlEvent::Comment(_) => {},
+            XmlEvent::EndDocument => return Ok(out),
+            XmlEvent::StartElement { name, attributes, .. } => out.push(Item::Start(
+                name.local_name,
+                attributes.into_iter().map(|a| (a.name.local_name, a.value)).collect(),
+            )),
+            XmlEvent::EndElement { name } => out.push(Item::End(name.local_name)),
+            XmlEvent::Characters(s) | XmlEvent::CData(s) | XmlEvent::Whitespace(s) => {
+                if !s.is_empty() {
+                    if let Some(Item::Text(t)) = out.last_mut() {
+                        t.push_str(&s);
+                    } else {
+                        out.push(Item::Text(s));
+                    }
+                }
+            },
+        }
+    }
+}
+
+/// The canonical stream a correct write→read round-trip of `root` must yield.
+pub fn expected_stream(root: &Element) -> Vec<Item> {
+    fn walk(e: &Element, out: &mut Vec<Item>) {
+        out.push(Item::Start(e.name.clone(), e.attrs.clone()));
+        let mut text = String::new();
+        for child in &e.children {
+            match child {
+                Node::Text { content, .. } => text.push_str(content),
+                // comments are dropped from the canonical stream, and the
+                // reader coalesces character data across ignored comments
+                Node::Comment(_) => {},
+                Node::Element(el) => {
+                    if !text.is_empty() {
+                        out.push(Item::Text(std::mem::take(&mut text)));
+                    }
+                    walk(el, out);
+                },
+            }
+        }
+        if !text.is_empty() {
+            out.push(Item::Text(text));
+        }
+        out.push(Item::End(e.name.clone()));
+    }
+    let mut out = Vec::new();
+    walk(root, &mut out);
+    out
+}
+
+/// XML-shaped "soup": random concatenations of markup fragments, entity
+/// references, quotes, and arbitrary text. Most such inputs are ill-formed;
+/// the parser must reject them with `Err`, never panic.
+#[hegel::composite]
+pub fn xml_soups(tc: hegel::TestCase) -> Vec<u8> {
+    let pieces: Vec<String> = tc.draw(generators::vecs(hegel::one_of!(
+        generators::sampled_from(vec![
+            "<a>", "</a>", "<b x=\"1\">", "</b>", "<a/>", "<?xml version=\"1.0\"?>",
+            "<?xml encoding=\"bogus\"?>", "<?pi data?>", "<!--", "-->", "<!--c-->",
+            "<![CDATA[", "]]>", "<![CDATA[x]]>", "<!DOCTYPE a [", "]>",
+            "<!ENTITY x \"y\">", "<!ENTITY y \"&x;&x;\">", "&x;", "&y;", "&amp;",
+            "&#65;", "&#x41;", "&#xD800;", "&#0;", "\"", "'", "<", ">", "&", ";",
+            "=", " ", "\n", "\t", "<a:b>", "</a:b>", "<a xmlns=\"u\">",
+            "<a xmlns:p=\"u\">", "xmlns", "text", "\u{FFFD}", "/>", "<!",
+        ])
+        .map(str::to_string)
+        .boxed(),
+        generators::text().max_size(8).boxed(),
+    ))
+    .max_size(40));
+    pieces.concat().into_bytes()
+}
