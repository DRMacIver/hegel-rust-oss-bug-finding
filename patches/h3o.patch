+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+
+use super::pbt::draw_cell;
+use hegel::generators;
+
+// A cell's directed edges (6, or 5 for pentagons) all start at the cell,
+// end at a distinct neighbor, are recoverable through `edge()`, and
+// `reverse()` is an involution swapping origin and destination.
+#[hegel::test]
+fn pbt_edges_origin_destination_reverse(tc: hegel::TestCase) {
+    let cell = draw_cell(&tc);
+    let edges = cell.edges().collect::<Vec<_>>();
+    assert_eq!(edges.len(), if cell.is_pentagon() { 5 } else { 6 });
+
+    for &edge in &edges {
+        assert_eq!(edge.origin(), cell, "edge origin");
+        let destination = edge.destination();
+        assert_ne!(destination, cell, "self-loop edge");
+        assert_eq!(
+            cell.is_neighbor_with(destination),
+            Ok(true),
+            "edge destination must be a neighbor"
+        );
+        assert_eq!(cell.edge(destination), Some(edge), "edge recovery");
+
+        let reversed = edge.reverse();
+        assert_eq!(reversed.origin(), destination, "reverse origin");
+        assert_eq!(reversed.destination(), cell, "reverse destination");
+        assert_eq!(reversed.reverse(), edge, "reverse is an involution");
+
+        assert!(edge.length_rads() > 0.0, "degenerate edge");
+    }
+
+    let destinations = edges
+        .iter()
+        .map(|edge| edge.destination())
+        .collect::<std::collections::HashSet<_>>();
+    assert_eq!(destinations.len(), edges.len(), "duplicate destinations");
+}
+
+// Display/FromStr and u64 roundtrips for directed edge indexes.
+#[hegel::test]
+fn pbt_edge_roundtrips(tc: hegel::TestCase) {
+    let cell = draw_cell(&tc);
+    let edges = cell.edges().collect::<Vec<_>>();
+    let edge = edges
+        [tc.draw(generators::integers::<usize>().max_value(edges.len() - 1))];
+    assert_eq!(edge.to_string().parse::<DirectedEdgeIndex>(), Ok(edge));
+    assert_eq!(DirectedEdgeIndex::try_from(u64::from(edge)), Ok(edge));
+}
