index 040a909..2c44a86 100644
--- a/tests/test_round_trip.rs
+++ b/tests/test_round_trip.rs
@@ -117,3 +117,310 @@ fn test_multiline_leading_newline() {
     let y = Yaml::Array(vec![Yaml::String("\na".to_owned())]);
     roundtrip_multiline(&y);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, BoxedGenerator, Generator};
+use yaml_rust2::yaml::Hash;
+
+/// Characters that sit on the emitter's quoting/escaping boundaries: YAML
+/// indicators, whitespace, and the Unicode separators/specials the scanner
+/// treats specially.
+const TRICKY_CHARS: &[char] = &[
+    ':', '-', '?', '#', ',', '[', ']', '{', '}', '&', '*', '!', '|', '>', '\'', '"', '%', '@',
+    '`', '\\', '~', '.', '+', '=', '<', ' ', '\t', '\n', '\r', 'a', '0', '\u{7f}', '\u{85}',
+    '\u{a0}', '\u{2028}', '\u{2029}', '\u{feff}',
+];
+
+/// Fixed strings that stress the scalar disambiguation rules: things that
+/// look like booleans, null, numbers in various bases, dates, and YAML
+/// syntax.
+const TRICKY_STRINGS: &[&str] = &[
+    "true", "True", "TRUE", "false", "False", "FALSE", "y", "Y", "n", "N", "yes", "no", "on",
+    "off", "On", "Off", "ON", "OFF", "null", "Null", "NULL", "~", "", " ", "  ", "---", "...",
+    "-", "- ", "?", "? ", ":", ": ", "a: b", "- a", "#c", "a #c", "!t", "&a", "*a", "|", ">",
+    "0x1F", "0o17", "0b101", "+12", "-3", "+0x3", "+0o7", "1_000", "01", "09", "0", "1e5",
+    "9e999", ".inf", "+.inf", "-.inf", ".nan", ".NaN", "+.5", "-.5", "1.0", "2024-12-31",
+    "12:34:56", "\u{85}", "\u{2028}", "\u{2029}", "\u{feff}", "\u{7f}", "\u{a0}",
+];
+
+/// Strings that stress the emitter's decision of whether/how to quote.
+fn tricky_strings() -> BoxedGenerator<'static, String> {
+    hegel::one_of!(
+        generators::text(),
+        generators::sampled_from(TRICKY_STRINGS.iter().map(|s| (*s).to_string()).collect::<Vec<_>>()),
+        // Integer-looking strings, up to and beyond i64 range.
+        generators::from_regex(r"[+-]?[0-9]{1,19}").fullmatch(true),
+        // Float-looking strings.
+        generators::from_regex(r"[+-]?[0-9]{0,3}\.[0-9]{0,3}([eE][+-]?[0-9]{1,3})?")
+            .fullmatch(true),
+        // Radix-prefixed strings (hex/octal/binary, either case).
+        generators::from_regex(r"0[xXoObB][0-9a-fA-F]{1,6}").fullmatch(true),
+        // Short strings assembled from boundary characters.
+        generators::vecs(generators::sampled_from(TRICKY_CHARS.to_vec()))
+            .max_size(8)
+            .map(|v| v.into_iter().collect::<String>()),
+    )
+    .boxed()
+}
+
+/// Whether `s` is hit by a known emitter quoting bug. Each class is pinned by
+/// a canonical, deterministically-failing test below; sibling properties
+/// exclude these inputs so they stay green and keep testing everything else.
+fn hits_known_quoting_bug(s: &str) -> bool {
+    // `need_quotes` quotes `0x`-prefixed strings but not `0o`-prefixed ones,
+    // which the loader parses as octal integers.
+    // Canonical test: `known_bug_octal_like_string_changes_type`.
+    if let Some(rest) = s.strip_prefix("0o") {
+        if i64::from_str_radix(rest, 8).is_ok() {
+            return true;
+        }
+    }
+    // `+.inf` is parsed as a float by the loader but not quoted by the
+    // emitter. Canonical test: `known_bug_plus_dot_inf_string_changes_type`.
+    matches!(s, "+.inf" | "+.Inf" | "+.INF")
+}
+
+/// Whether `s` is hit by a known bug of literal block scalar emission
+/// (`multiline_strings(true)`). Slightly conservative on purpose. Canonical
+/// tests: `known_bug_multiline_leading_space_line` and
+/// `known_bug_multiline_trailing_newlines_lost`.
+fn hits_known_multiline_bug(s: &str) -> bool {
+    s.contains('\n')
+        && (s.split('\n').any(|line| line.starts_with(' ')) || s.ends_with("\n\n"))
+}
+
+/// Recursively check a document for strings hit by known quoting bugs.
+fn doc_hits_known_quoting_bug(doc: &Yaml) -> bool {
+    match doc {
+        Yaml::String(s) => hits_known_quoting_bug(s),
+        Yaml::Array(v) => v.iter().any(doc_hits_known_quoting_bug),
+        Yaml::Hash(h) => h
+            .iter()
+            .any(|(k, v)| doc_hits_known_quoting_bug(k) || doc_hits_known_quoting_bug(v)),
+        _ => false,
+    }
+}
+
+/// Recursively check a document for values hit by known multiline-emission
+/// bugs (includes the quoting bugs, which apply in multiline mode too).
+fn ml_doc_hits_known_bug(doc: &Yaml) -> bool {
+    match doc {
+        Yaml::String(s) => hits_known_quoting_bug(s) || hits_known_multiline_bug(s),
+        Yaml::Array(v) => v.iter().any(ml_doc_hits_known_bug),
+        Yaml::Hash(h) => h.iter().any(|(k, v)| {
+            // A multiline string used as a mapping key is emitted as a block
+            // scalar in key position and changes the document. Canonical
+            // test: `known_bug_multiline_string_as_hash_key`.
+            matches!(k, Yaml::String(s) if s.contains('\n'))
+                || ml_doc_hits_known_bug(k)
+                || ml_doc_hits_known_bug(v)
+        }),
+        _ => false,
+    }
+}
+
+/// Strings that the loader would itself classify as `Yaml::Real`, so that
+/// `Yaml::Real(s)` is a value an emit/load roundtrip could possibly preserve.
+fn real_strings() -> BoxedGenerator<'static, String> {
+    hegel::one_of!(
+        generators::floats::<f64>()
+            .allow_nan(false)
+            .allow_infinity(false)
+            .map(|f| format!("{f:?}")),
+        generators::sampled_from(
+            [".inf", "-.inf", ".nan", ".NaN", "+.inf", "6.02e23", "-0.0"]
+                .iter()
+                .map(|s| (*s).to_string())
+                .collect::<Vec<_>>()
+        ),
+    )
+    .boxed()
+}
+
+/// Scalar `Yaml` values as the loader could produce them (no `BadValue`, no
+/// `Alias`, only canonical `Real` strings).
+fn scalar_values() -> BoxedGenerator<'static, Yaml> {
+    hegel::one_of!(
+        tricky_strings().map(Yaml::String),
+        generators::integers::<i64>().map(Yaml::Integer),
+        generators::booleans().map(Yaml::Boolean),
+        generators::just(Yaml::Null),
+        real_strings().map(Yaml::Real),
+    )
+    .boxed()
+}
+
+/// Arbitrary `Yaml` documents: scalars, arrays and hashes nested up to
+/// `depth`. Hash keys draw from the full value space, so scalar and complex
+/// (`? `) keys are both exercised.
+fn yaml_values(depth: u32) -> BoxedGenerator<'static, Yaml> {
+    hegel::compose!(|tc| {
+        // Bias towards scalars so documents stay a manageable size while
+        // still nesting several levels.
+        if depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) > 0 {
+            tc.draw(scalar_values())
+        } else if tc.draw(generators::booleans()) {
+            Yaml::Array(tc.draw(generators::vecs(yaml_values(depth - 1)).max_size(4)))
+        } else {
+            let entries = tc.draw(generators::integers::<usize>().max_value(4));
+            let mut hash = Hash::new();
+            for _ in 0..entries {
+                let key = tc.draw(yaml_values(depth - 1));
+                let value = tc.draw(yaml_values(depth - 1));
+                hash.insert(key, value);
+            }
+            Yaml::Hash(hash)
+        }
+    })
+    .boxed()
+}
+
+/// Any document built from scalars, arrays and hashes survives an emit/load
+/// roundtrip unchanged.
+#[hegel::test]
+fn pbt_roundtrip_generated_document(tc: hegel::TestCase) {
+    let doc = tc.draw(yaml_values(3));
+    tc.assume(!doc_hits_known_quoting_bug(&doc));
+    roundtrip(&doc);
+}
+
+/// Same roundtrip with the multiline-strings (literal block) emitter mode.
+#[hegel::test]
+fn pbt_roundtrip_generated_document_multiline(tc: hegel::TestCase) {
+    let doc = tc.draw(yaml_values(3));
+    tc.assume(!ml_doc_hits_known_bug(&doc));
+    roundtrip_multiline(&doc);
+}
+
+/// A string scalar comes back as `Yaml::String` with identical content, no
+/// matter how much it looks like a number/boolean/null or contains YAML
+/// syntax.
+#[hegel::test]
+fn pbt_string_scalar_type_and_content_preserved(tc: hegel::TestCase) {
+    let s = tc.draw(tricky_strings());
+    tc.assume(!hits_known_quoting_bug(&s));
+    roundtrip(&Yaml::String(s));
+}
+
+/// Number scalars roundtrip unchanged, including `i64` extremes and exotic
+/// float shapes.
+#[hegel::test]
+fn pbt_number_scalar_roundtrip(tc: hegel::TestCase) {
+    let doc = tc.draw(hegel::one_of!(
+        generators::integers::<i64>().map(Yaml::Integer),
+        real_strings().map(Yaml::Real),
+    ));
+    roundtrip(&doc);
+}
+
+/// A stream of several documents, each emitted with its own `---` header,
+/// loads back as the same sequence of documents.
+#[hegel::test]
+fn pbt_multi_document_stream_roundtrip(tc: hegel::TestCase) {
+    let docs: Vec<Yaml> = tc.draw(generators::vecs(yaml_values(2)).min_size(1).max_size(4));
+    tc.assume(!docs.iter().any(doc_hits_known_quoting_bug));
+    let mut out = String::new();
+    for (i, doc) in docs.iter().enumerate() {
+        if i > 0 {
+            out.push('\n');
+        }
+        YamlEmitter::new(&mut out).dump(doc).unwrap();
+    }
+    let reloaded = YamlLoader::load_from_str(&out).unwrap();
+    assert_eq!(reloaded, docs);
+}
+
+/// Port of the quickcheck property `test_check_weird_keys` (formerly in
+/// `tests/quickcheck.rs`): an array of arbitrary strings survives an
+/// emit/load roundtrip.
+#[hegel::test]
+fn pbt_array_of_weird_strings_roundtrip(tc: hegel::TestCase) {
+    let strings: Vec<String> = tc.draw(generators::vecs(generators::text()));
+    // Emitter quoting bugs are pinned by the canonical `known_bug_*` tests
+    // below; `text()` reaching e.g. `0o7` is unlikely but not impossible.
+    tc.assume(strings.iter().all(|s| !hits_known_quoting_bug(s)));
+    let doc = Yaml::Array(strings.into_iter().map(Yaml::String).collect());
+    roundtrip(&doc);
+}
