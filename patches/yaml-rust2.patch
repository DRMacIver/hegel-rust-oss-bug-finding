+// ---------------------------------------------------------------------------
+// KNOWN FAILURES: each test below pins a real bug found by the properties
+// above. Every generated case hits the bug, so they fail deterministically,
+// and they are expected to keep failing until the bug is fixed. The sibling
+// properties exclude exactly these input classes (see
+// `hits_known_quoting_bug`, `hits_known_multiline_bug`,
+// `ml_doc_hits_known_bug`).
+// ---------------------------------------------------------------------------
+
+/// KNOWN FAILURE: `need_quotes` (src/emitter.rs) quotes strings starting with
+/// `0x` but not `0o`, while the loader (`Yaml::from_str`) parses `0o…` as an
+/// octal integer. `String("0o7")` is emitted as bare `0o7` and reloads as
+/// `Integer(7)`.
+#[hegel::test]
+fn known_bug_octal_like_string_changes_type(tc: hegel::TestCase) {
+    let s = tc.draw(generators::from_regex(r"0o[0-7]{1,10}").fullmatch(true));
+    roundtrip(&Yaml::String(s));
+}
+
+/// KNOWN FAILURE: `+.inf` is parsed as a float by the loader (`parse_f64`)
+/// but not quoted by `need_quotes`. `String("+.inf")` is emitted bare and
+/// reloads as `Real("+.inf")`.
+#[hegel::test]
+fn known_bug_plus_dot_inf_string_changes_type(tc: hegel::TestCase) {
+    let s: String = tc.draw(generators::sampled_from(
+        ["+.inf", "+.Inf", "+.INF"]
+            .iter()
+            .map(|s| (*s).to_string())
+            .collect::<Vec<_>>(),
+    ));
+    roundtrip(&Yaml::String(s));
+}
+
+/// KNOWN FAILURE: `Yaml::Real` nodes are emitted verbatim without checking
+/// that the text still reads back as a float. `!!float 5` loads as
+/// `Real("5")`, which is emitted as bare `5` and reloads as `Integer(5)`.
+#[hegel::test]
+fn known_bug_integer_looking_real_changes_type(tc: hegel::TestCase) {
+    let n = tc.draw(generators::integers::<i64>());
+    let src = format!("!!float {n}");
+    let doc = YamlLoader::load_from_str(&src).unwrap().pop().unwrap();
+    assert_eq!(doc, Yaml::Real(n.to_string()));
+    roundtrip(&doc);
+}
+
+/// KNOWN FAILURE (multiline mode): a literal block scalar line starting with
+/// a space breaks block indentation detection. The emitted document either
+/// fails to parse (`" a\nb"`) or silently drops the space (`"\n a"`).
+#[hegel::test]
+fn known_bug_multiline_leading_space_line(tc: hegel::TestCase) {
+    let first = tc.draw(generators::from_regex(r"[a-z]{0,5}").fullmatch(true));
+    let second = tc.draw(generators::from_regex(r"[a-z]{1,5}").fullmatch(true));
+    let doc = Yaml::Array(vec![Yaml::String(format!(" {first}\n{second}"))]);
+    roundtrip_multiline(&doc);
+}
+
+/// KNOWN FAILURE (multiline mode): literal blocks are emitted with clip
+/// chomping (`|`), so trailing empty lines are lost: `"a\n\n\n"` reloads as
+/// `"a\n\n"` and `"\n\n"` reloads as `"\n"`.
+#[hegel::test]
+fn known_bug_multiline_trailing_newlines_lost(tc: hegel::TestCase) {
+    let stem = tc.draw(generators::from_regex(r"[a-z]{0,5}").fullmatch(true));
+    let doc = Yaml::Array(vec![Yaml::String(format!("{stem}\n\n\n"))]);
+    roundtrip_multiline(&doc);
+}
+
+/// KNOWN FAILURE (multiline mode): a multiline string used as a mapping key
+/// is emitted as a block scalar in key position, which changes the meaning of
+/// the document: `{"a\nb": ~}` is emitted as `|-\n  a\n  b: ~`, which reloads
+/// as the single string `"a\nb: ~"`.
+#[hegel::test]
+fn known_bug_multiline_string_as_hash_key(tc: hegel::TestCase) {
+    let a = tc.draw(generators::from_regex(r"[a-z]{1,5}").fullmatch(true));
+    let b = tc.draw(generators::from_regex(r"[a-z]{1,5}").fullmatch(true));
+    let mut hash = Hash::new();
+    hash.insert(Yaml::String(format!("{a}\n{b}")), Yaml::Null);
+    roundtrip_multiline(&Yaml::Hash(hash));
+}
