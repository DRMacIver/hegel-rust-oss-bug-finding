+    #[hegel::test]
+    fn hegel_prefix_netmask_roundtrip(tc: hegel::TestCase) {
+        // v4: build the mask independently of the library, then convert back.
+        let p = tc.draw(generators::integers::<u8>().max_value(32));
+        let mask = if p == 0 { 0u32 } else { u32::MAX << (32 - p as u32) };
+        let mask = Ipv4Addr::from(mask);
+        assert_eq!(ipv4_mask_to_prefix(mask), Ok(p));
+        let addr = Ipv4Addr::from(tc.draw(generators::integers::<u32>()));
+        assert_eq!(Ipv4Net::with_netmask(addr, mask), Ipv4Net::new(addr, p));
+
+        // v6
+        let p = tc.draw(generators::integers::<u8>().max_value(128));
+        let mask = if p == 0 { 0u128 } else { u128::MAX << (128 - p as u32) };
+        let mask = Ipv6Addr::from(mask);
+        assert_eq!(ipv6_mask_to_prefix(mask), Ok(p));
+        let addr = Ipv6Addr::from(tc.draw(generators::integers::<u128>()));
+        assert_eq!(Ipv6Net::with_netmask(addr, mask), Ipv6Net::new(addr, p));
