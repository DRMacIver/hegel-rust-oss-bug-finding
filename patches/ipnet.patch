+                IpNet::V4(n) => IpAddr::V4(Ipv4Addr::from(
+                    u32::from(n.network()) | (tc.draw(ipv4_addr_bits()) & u32::from(n.hostmask())),
+                )),
+                IpNet::V6(n) => IpAddr::V6(Ipv6Addr::from(
+                    u128::from(n.network()) | (tc.draw(ipv6_addr_bits()) & u128::from(n.hostmask())),
+                )),
+            }
+        } else if tc.draw(generators::booleans()) {
+            IpAddr::V4(Ipv4Addr::from(tc.draw(ipv4_addr_bits())))
+        } else {
+            IpAddr::V6(Ipv6Addr::from(tc.draw(ipv6_addr_bits())))
+        };
+        let expected = match (net, addr) {
+            (IpNet::V4(n), IpAddr::V4(a)) => v4_net_has_addr(&n, a),
+            (IpNet::V6(n), IpAddr::V6(a)) => v6_net_has_addr(&n, a),
+            _ => false, // documented: cross-family contains is false
+        };
+        assert_eq!(net.contains(&addr), expected, "net {} addr {}", net, addr);
+    }
