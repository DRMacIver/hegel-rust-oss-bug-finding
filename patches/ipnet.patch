+    #[hegel::test]
+    fn hegel_supernet_is_unique_immediate_parent(tc: hegel::TestCase) {
+        let net = tc.draw(ip_nets());
+        match net.supernet() {
+            None => assert_eq!(net.prefix_len(), 0, "only /0 has no supernet"),
+            Some(sup) => {
+                // A truncated net with prefix_len - 1 that contains `net` is
+                // unique, so these assertions pin supernet() completely.
+                assert!(net.prefix_len() > 0, "supernet of /0 must be None");
+                assert_eq!(sup.prefix_len(), net.prefix_len() - 1);
+                assert_eq!(sup.addr(), sup.network(), "supernet must be truncated");
+                assert!(sup.contains(&net), "supernet {} must contain {}", sup, net);
+            }
+        }
+    }
