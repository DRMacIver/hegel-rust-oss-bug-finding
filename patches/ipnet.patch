+    #[hegel::test]
+    fn hegel_mask_to_prefix_accepts_exactly_contiguous_masks(tc: hegel::TestCase) {
+        // A valid netmask is exactly a (possibly empty) run of ones followed
+        // by zeros. Independent contiguity check: leading ones plus trailing
+        // zeros span the whole word.
+        let m = tc.draw(generators::integers::<u32>());
+        let contiguous = m.leading_ones() + m.trailing_zeros() == 32;
+        match ip_mask_to_prefix(IpAddr::V4(Ipv4Addr::from(m))) {
+            Ok(p) => {
+                assert!(contiguous, "accepted non-contiguous mask {:#010x}", m);
+                assert_eq!(p as u32, m.leading_ones());
+            }
+            Err(_) => assert!(!contiguous, "rejected valid mask {:#010x}", m),
+        }
+
+        let m = tc.draw(generators::integers::<u128>());
+        let contiguous = m.leading_ones() + m.trailing_zeros() == 128;
+        match ip_mask_to_prefix(IpAddr::V6(Ipv6Addr::from(m))) {
+            Ok(p) => {
+                assert!(contiguous, "accepted non-contiguous mask {:#034x}", m);
+                assert_eq!(p as u32, m.leading_ones());
+            }
+            Err(_) => assert!(!contiguous, "rejected valid mask {:#034x}", m),
+        }
