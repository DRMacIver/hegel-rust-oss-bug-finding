+            (
+                tc.draw(ipv6_addr_bits()),
+                tc.draw(hegel::one_of!(
+                    generators::just(0u8),
+                    generators::integers::<u8>().max_value(6),
+                )),
+            )
+        } else {
+            (
+                start.saturating_add(tc.draw(generators::integers::<u128>().max_value(4096))),
+                tc.draw(generators::integers::<u8>().max_value(128)),
+            )
+        };
+        let subnets: Vec<Ipv6Net> =
+            Ipv6Subnets::new(start.into(), end.into(), min_prefix_len).collect();
+        if start > end {
+            assert!(subnets.is_empty());
+            return;
+        }
+        let mut cursor = Some(start);
+        for s in &subnets {
+            assert!(
+                s.prefix_len() >= min_prefix_len,
+                "documented: prefix length not less than min_prefix_len ({} < {})",
+                s.prefix_len(),
+                min_prefix_len,
+            );
+            assert_eq!(
+                Some(u128::from(s.network())),
+                cursor,
+                "subnets must tile the range [{}, {}] contiguously, got {}",
+                Ipv6Addr::from(start),
+                Ipv6Addr::from(end),
+                s,
+            );
+            cursor = u128::from(s.broadcast()).checked_add(1);
+        }
+        assert_eq!(
+            cursor,
+            end.checked_add(1),
+            "subnets must cover the range [{}, {}] exactly through end",
+            Ipv6Addr::from(start),
+            Ipv6Addr::from(end),
+        );
+    }
+
+    // KNOWN BUG (kept failing deliberately, see HEGEL_REPORT.md): aggregate()
+    // grows the address set for inputs whose broadcast is one below the top of
+    // the address space, e.g. aggregate([255.255.255.254/32]) ==
+    // [255.255.255.254/31], which adds 255.255.255.255. The half-open interval
+    // representation saturates at MAX, and `if end != MAX { end -= 1 }` then
+    // treats "ends at MAX - 1" as "ends at MAX". The elevated case count makes
+    // the failure reproduce reliably in a default run.
+    #[hegel::test(test_cases = 1000)]
+    fn hegel_aggregate_preserves_address_membership(tc: hegel::TestCase) {
+        let nets: Vec<IpNet> = tc.draw(generators::vecs(ip_nets()).max_size(8));
+        let aggs = IpNet::aggregate(&nets);
+        for a in &aggs {
+            assert_eq!(a.addr(), a.network(), "aggregate returned non-truncated net {}", a);
+        }
+        // Membership must be preserved exactly. Probe a few arbitrary
+        // addresses plus the boundaries (and one-past-boundaries) of every
+        // input net, where off-by-one bugs live.
+        let mut candidates: Vec<IpAddr> = Vec::new();
+        for _ in 0..4 {
+            candidates.push(if tc.draw(generators::booleans()) {
+                IpAddr::V4(Ipv4Addr::from(tc.draw(ipv4_addr_bits())))
+            } else {
+                IpAddr::V6(Ipv6Addr::from(tc.draw(ipv6_addr_bits())))
+            });
+        }
+        for n in &nets {
+            match n {
+                IpNet::V4(n) => {
+                    let lo = u32::from(n.network());
+                    let hi = u32::from(n.broadcast());
+                    for bits in [lo.wrapping_sub(1), lo, hi, hi.wrapping_add(1)] {
+                        candidates.push(IpAddr::V4(Ipv4Addr::from(bits)));
+                    }
+                }
+                IpNet::V6(n) => {
+                    let lo = u128::from(n.network());
+                    let hi = u128::from(n.broadcast());
+                    for bits in [lo.wrapping_sub(1), lo, hi, hi.wrapping_add(1)] {
+                        candidates.push(IpAddr::V6(Ipv6Addr::from(bits)));
+                    }
+                }
+            }
+        }
+        for addr in candidates {
+            let in_inputs = nets.iter().any(|n| n.contains(&addr));
+            let in_aggs = aggs.iter().any(|n| n.contains(&addr));
+            assert_eq!(
+                in_inputs, in_aggs,
+                "aggregate changed membership of {} (inputs {:?} -> aggregated {:?})",
+                addr, nets, aggs,
+            );
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_ord_consistent_with_contains(tc: hegel::TestCase) {
+        // For truncated networks, a strict superset must sort strictly before
+        // its subsets (Ord is derived on (addr, prefix_len)).
+        let a = tc.draw(ip_nets());
+        let b = if tc.draw(generators::booleans()) {
+            tc.draw(ip_nets())
+        } else {
+            // Boost the contained case, otherwise contains() is nearly always false.
+            match a {
+                IpNet::V4(n) => IpNet::V4(draw_v4_net_inside(&tc, &n)),
+                IpNet::V6(n) => IpNet::V6(draw_v6_net_inside(&tc, &n)),
+            }
+        };
+        let (a, b) = (a.trunc(), b.trunc());
+        if a != b {
+            if a.contains(&b) {
+                assert!(a < b, "{} contains {} but does not sort before it", a, b);
+            }
+            if b.contains(&a) {
+                assert!(b < a, "{} contains {} but does not sort before it", b, a);
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_trunc_preserves_range_and_is_idempotent(tc: hegel::TestCase) {
+        let net = tc.draw(ip_nets());
+        let t = net.trunc();
+        assert_eq!(t.prefix_len(), net.prefix_len());
+        assert_eq!(t.addr(), net.network());
+        assert_eq!(t.network(), net.network());
+        assert_eq!(t.broadcast(), net.broadcast());
+        assert_eq!(t.trunc(), t, "trunc must be idempotent");
+    }
 }
