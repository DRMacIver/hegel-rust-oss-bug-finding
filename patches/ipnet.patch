+    #[hegel::test]
+    fn hegel_subnets_partition_their_network(tc: hegel::TestCase) {
+        // v4
+        let net = tc.draw(ipv4_nets());
+        let p = net.prefix_len();
+        // Keep at most 2^8 subnets per case. This bounds the test's memory and
+        // time, it is not a limit of the library.
+        let d = tc.draw(generators::integers::<u8>().max_value(8));
+        let np = min(p + d, 32);
+        let subs: Vec<Ipv4Net> = net.subnets(np).unwrap().collect();
+        assert_eq!(subs.len() as u64, 1u64 << (np - p));
+        let mut cursor = Some(u32::from(net.network()));
+        for s in &subs {
+            assert_eq!(s.prefix_len(), np);
+            assert_eq!(Some(u32::from(s.network())), cursor, "subnets must tile contiguously");
+            cursor = u32::from(s.broadcast()).checked_add(1);
+        }
+        assert_eq!(cursor, u32::from(net.broadcast()).checked_add(1));
+        if p > 0 {
+            assert_eq!(net.subnets(p - 1), Err(PrefixLenError));
+        }
+        assert_eq!(net.subnets(33), Err(PrefixLenError));
+
+        // v6
+        let net = tc.draw(ipv6_nets());
+        let p = net.prefix_len();
+        let d = tc.draw(generators::integers::<u8>().max_value(8));
+        let np = min(p + d, 128);
+        let subs: Vec<Ipv6Net> = net.subnets(np).unwrap().collect();
+        assert_eq!(subs.len() as u64, 1u64 << (np - p));
+        let mut cursor = Some(u128::from(net.network()));
+        for s in &subs {
+            assert_eq!(s.prefix_len(), np);
+            assert_eq!(Some(u128::from(s.network())), cursor, "subnets must tile contiguously");
+            cursor = u128::from(s.broadcast()).checked_add(1);
+        }
+        assert_eq!(cursor, u128::from(net.broadcast()).checked_add(1));
+        if p > 0 {
+            assert_eq!(net.subnets(p - 1), Err(PrefixLenError));
+        }
+        assert_eq!(net.subnets(129), Err(PrefixLenError));
+    }
+
+    // KNOWN BUG (kept failing deliberately, see HEGEL_REPORT.md): for ranges
+    // exactly one address short of the full space (e.g. [0.0.0.0,
+    // 255.255.255.254]) with min_prefix_len 0, next_ipv4_subnet's saturated
+    // `range` computation cannot distinguish 2^32 - 1 from 2^32 and emits
+    // `start/0`, covering addresses outside the requested range. The elevated
+    // case count makes the failure reproduce reliably in a default run.
+    #[hegel::test(test_cases = 1000)]
+    fn hegel_ipv4_subnets_iterator_covers_exact_range(tc: hegel::TestCase) {
+        let start = tc.draw(ipv4_addr_bits());
+        // Two scenarios so the number of generated subnets stays bounded
+        // (protects test time, not a library limit): an arbitrary range with a
+        // small min_prefix_len, or a small range with any min_prefix_len.
+        let (end, min_prefix_len) = if tc.draw(generators::booleans()) {
+            (
+                tc.draw(ipv4_addr_bits()),
+                // Boost min_prefix_len == 0: next_ipv4_subnet special-cases it
+                // together with a saturating range computation.
+                tc.draw(hegel::one_of!(
+                    generators::just(0u8),
+                    generators::integers::<u8>().max_value(6),
+                )),
+            )
+        } else {
+            (
+                start.saturating_add(tc.draw(generators::integers::<u32>().max_value(4096))),
+                tc.draw(generators::integers::<u8>().max_value(32)),
+            )
+        };
+        let subnets: Vec<Ipv4Net> =
+            Ipv4Subnets::new(start.into(), end.into(), min_prefix_len).collect();
+        if start > end {
+            assert!(subnets.is_empty());
+            return;
+        }
+        let mut cursor = Some(start);
+        for s in &subnets {
+            assert!(
+                s.prefix_len() >= min_prefix_len,
+                "documented: prefix length not less than min_prefix_len ({} < {})",
+                s.prefix_len(),
+                min_prefix_len,
+            );
+            assert_eq!(
+                Some(u32::from(s.network())),
+                cursor,
+                "subnets must tile the range [{}, {}] contiguously, got {}",
+                Ipv4Addr::from(start),
+                Ipv4Addr::from(end),
+                s,
+            );
+            cursor = u32::from(s.broadcast()).checked_add(1);
+        }
+        assert_eq!(
+            cursor,
+            end.checked_add(1),
+            "subnets must cover the range [{}, {}] exactly through end",
+            Ipv4Addr::from(start),
+            Ipv4Addr::from(end),
+        );
+    }
+
+    // KNOWN BUG (kept failing deliberately, see HEGEL_REPORT.md): IPv6 analog
+    // of hegel_ipv4_subnets_iterator_covers_exact_range — next_ipv6_subnet has
+    // the same saturated-range special case.
+    #[hegel::test(test_cases = 1000)]
+    fn hegel_ipv6_subnets_iterator_covers_exact_range(tc: hegel::TestCase) {
+        let start = tc.draw(ipv6_addr_bits());
