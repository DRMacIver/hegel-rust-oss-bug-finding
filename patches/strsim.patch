+
+/// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use std::collections::HashMap;
+    use strsim::{
+        damerau_levenshtein, generic_damerau_levenshtein, hamming, jaro, jaro_winkler,
+        levenshtein, normalized_damerau_levenshtein, normalized_levenshtein, osa_distance,
+        sorensen_dice, StrSimError,
+    };
+
+    fn char_count(s: &str) -> usize {
+        s.chars().count()
+    }
+
+    /// Arbitrary Unicode scalar value, weighted across ASCII / BMP / supplementary
+    /// planes (all these metrics operate on `char`s, so multi-byte chars matter).
+    #[hegel::composite]
+    fn unicode_char(tc: hegel::TestCase) -> char {
+        tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().max_value(0x7F),
+                generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+                generators::integers::<u32>()
+                    .min_value(0x1_0000)
+                    .max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        )
+    }
+
+    /// Small alphabet with 1-, 2-, 3- and 4-byte UTF-8 encodings plus whitespace
+    /// (incl. multi-byte whitespace). Repeated/overlapping characters are where
+    /// the interesting edit-distance behaviour (matches, transpositions) lives.
+    fn small_alphabet() -> Vec<char> {
+        vec!['a', 'b', 'c', ' ', '\u{0}', '\u{3000}', 'à', 'ß', '香', '𝄞']
+    }
+
+    /// Strings drawn either from the small overlapping alphabet or as arbitrary text.
+    #[hegel::composite]
+    fn metric_string(tc: hegel::TestCase) -> String {
+        if tc.draw(generators::booleans()) {
+            tc.draw(generators::vecs(generators::sampled_from(small_alphabet())))
+                .into_iter()
+                .collect()
+        } else {
+            tc.draw(generators::text())
+        }
+    }
+
+    /// A pair of strings, boosted towards equal pairs so that "distance zero"
+    /// branches are actually exercised.
+    #[hegel::composite]
+    fn string_pair(tc: hegel::TestCase) -> (String, String) {
+        let a = tc.draw(metric_string());
+        let b = if tc.draw(generators::booleans()) {
+            a.clone()
+        } else {
+            tc.draw(metric_string())
+        };
+        (a, b)
+    }
+
+    /// Identity axiom: every distance is 0 (and every similarity is exactly 1.0)
+    /// when comparing a string with itself.
+    #[hegel::test]
+    fn hegel_identity_all_metrics(tc: hegel::TestCase) {
+        let s = tc.draw(metric_string());
+        assert_eq!(0, levenshtein(&s, &s));
+        assert_eq!(0, osa_distance(&s, &s));
+        assert_eq!(0, damerau_levenshtein(&s, &s));
+        assert_eq!(Ok(0), hamming(&s, &s));
+        assert_eq!(1.0, jaro(&s, &s));
+        assert_eq!(1.0, jaro_winkler(&s, &s));
+        assert_eq!(1.0, normalized_levenshtein(&s, &s));
+        assert_eq!(1.0, normalized_damerau_levenshtein(&s, &s));
+        assert_eq!(1.0, sorensen_dice(&s, &s));
+    }
+
+    /// Symmetry axiom: d(a, b) == d(b, a) for every metric in the crate.
+    /// (Exact float equality is intended: swapping the arguments only swaps
+    /// commutative float additions.)
+    #[hegel::test]
+    fn hegel_symmetry_all_metrics(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(string_pair());
+        assert_eq!(levenshtein(&a, &b), levenshtein(&b, &a));
+        assert_eq!(osa_distance(&a, &b), osa_distance(&b, &a));
+        assert_eq!(damerau_levenshtein(&a, &b), damerau_levenshtein(&b, &a));
+        assert_eq!(hamming(&a, &b), hamming(&b, &a));
+        assert_eq!(jaro(&a, &b), jaro(&b, &a));
+        assert_eq!(jaro_winkler(&a, &b), jaro_winkler(&b, &a));
+        assert_eq!(normalized_levenshtein(&a, &b), normalized_levenshtein(&b, &a));
+        assert_eq!(
+            normalized_damerau_levenshtein(&a, &b),
+            normalized_damerau_levenshtein(&b, &a)
+        );
+        assert_eq!(sorensen_dice(&a, &b), sorensen_dice(&b, &a));
+    }
+
+    /// The edit distances form a chain: damerau <= osa <= levenshtein (each allows
+    /// strictly more/cheaper operations than the next), all are bounded below by
+    /// the length difference and above by max(len). For equal-length strings,
+    /// levenshtein <= hamming (substituting every differing position is one way
+    /// to edit one string into the other).
+    #[hegel::test]
+    fn hegel_edit_distance_chain_and_bounds(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(string_pair());
+        let (la, lb) = (char_count(&a), char_count(&b));
+        let lev = levenshtein(&a, &b);
+        let osa = osa_distance(&a, &b);
+        let dl = damerau_levenshtein(&a, &b);
+        assert!(dl <= osa, "damerau {} > osa {}", dl, osa);
+        assert!(osa <= lev, "osa {} > levenshtein {}", osa, lev);
+        assert!(la.abs_diff(lb) <= dl, "damerau {} < length diff", dl);
+        assert!(lev <= la.max(lb), "levenshtein {} > max len", lev);
+        if la == lb {
+            let ham = hamming(&a, &b).expect("equal char counts");
+            assert!(lev <= ham, "levenshtein {} > hamming {}", lev, ham);
+        }
+    }
+
+    /// Identity of indiscernibles: distance is zero if and only if the strings
+    /// are equal (for the true edit distances).
+    #[hegel::test]
+    fn hegel_distance_zero_iff_equal(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(string_pair());
+        let equal = a == b;
+        assert_eq!(equal, levenshtein(&a, &b) == 0);
+        assert_eq!(equal, osa_distance(&a, &b) == 0);
+        assert_eq!(equal, damerau_levenshtein(&a, &b) == 0);
+    }
+
+    /// Triangle inequality for the two true metrics. levenshtein is a metric;
+    /// damerau_levenshtein's docs explicitly state "the triangle inequality
+    /// holds". (OSA is deliberately excluded — it does not satisfy it.)
+    #[hegel::test]
+    fn hegel_triangle_inequality_true_metrics(tc: hegel::TestCase) {
+        let a = tc.draw(metric_string());
+        let b = tc.draw(metric_string());
+        let c = tc.draw(metric_string());
+        assert!(
+            levenshtein(&a, &c) <= levenshtein(&a, &b) + levenshtein(&b, &c),
+            "levenshtein violates triangle inequality"
+        );
+        assert!(
+            damerau_levenshtein(&a, &c)
+                <= damerau_levenshtein(&a, &b) + damerau_levenshtein(&b, &c),
+            "damerau_levenshtein violates triangle inequality"
+        );
+    }
+
+    /// A single insertion, deletion, or substitution (with a different char)
+    /// yields distance exactly 1 for levenshtein, OSA, and Damerau-Levenshtein.
+    #[hegel::test]
+    fn hegel_single_edit_gives_distance_one(tc: hegel::TestCase) {
+        let mut chars: Vec<char> = tc.draw(metric_string()).chars().collect();
+        let a: String = chars.iter().collect();
+        let op = if chars.is_empty() {
+            0 // only insertion is possible on an empty string
+        } else {
+            tc.draw(generators::integers::<u8>().max_value(2))
+        };
+        match op {
+            0 => {
+                let pos = tc.draw(generators::integers::<usize>().max_value(chars.len()));
+                let ch = tc.draw(unicode_char());
+                chars.insert(pos, ch);
+            }
+            1 => {
+                let pos = tc.draw(generators::integers::<usize>().max_value(chars.len() - 1));
+                chars.remove(pos);
+            }
+            _ => {
+                let pos = tc.draw(generators::integers::<usize>().max_value(chars.len() - 1));
+                let ch = tc.draw(unicode_char());
+                tc.assume(ch != chars[pos]);
+                chars[pos] = ch;
+            }
+        }
+        let b: String = chars.iter().collect();
+        assert_eq!(1, levenshtein(&a, &b));
+        assert_eq!(1, osa_distance(&a, &b));
+        assert_eq!(1, damerau_levenshtein(&a, &b));
+    }
+
+    /// Swapping two adjacent distinct chars is one transposition: OSA and
+    /// Damerau-Levenshtein give exactly 1, plain levenshtein gives exactly 2
+    /// (equal-length strings differing in exactly two positions can't be one
+    /// edit apart), and hamming sees exactly the two swapped positions.
+    #[hegel::test]
+    fn hegel_adjacent_transposition(tc: hegel::TestCase) {
+        let mut chars: Vec<char> = tc.draw(
+            generators::vecs(generators::sampled_from(small_alphabet())).min_size(2),
+        );
+        let i = tc.draw(generators::integers::<usize>().max_value(chars.len() - 2));
+        tc.assume(chars[i] != chars[i + 1]);
+        let a: String = chars.iter().collect();
+        chars.swap(i, i + 1);
+        let b: String = chars.iter().collect();
+        assert_eq!(1, osa_distance(&a, &b));
+        assert_eq!(1, damerau_levenshtein(&a, &b));
+        assert_eq!(2, levenshtein(&a, &b));
+        assert_eq!(Ok(2), hamming(&a, &b));
+    }
+
+    /// hamming's documented contract: Err(DifferentLengthArgs) iff the char
+    /// counts differ, and otherwise Ok(number of positions whose chars differ)
+    /// — never a panic.
+    #[hegel::test]
+    fn hegel_hamming_contract(tc: hegel::TestCase) {
+        let a_chars: Vec<char> = tc.draw(generators::vecs(unicode_char()));
+        // Boost equal-length pairs: purely independent draws would almost
+        // always take the Err branch.
+        let b_chars: Vec<char> = if tc.draw(generators::booleans()) {
+            tc.draw(
+                generators::vecs(unicode_char())
+                    .min_size(a_chars.len())
+                    .max_size(a_chars.len()),
+            )
+        } else {
+            tc.draw(generators::vecs(unicode_char()))
+        };
+        let a: String = a_chars.iter().collect();
+        let b: String = b_chars.iter().collect();
+        let result = hamming(&a, &b);
+        if a_chars.len() == b_chars.len() {
+            let expected = a_chars.iter().zip(&b_chars).filter(|(x, y)| x != y).count();
+            assert_eq!(Ok(expected), result);
+        } else {
+            assert_eq!(Err(StrSimError::DifferentLengthArgs), result);
+        }
+    }
+
+    /// jaro and jaro_winkler stay in [0, 1]; the Winkler prefix bonus can only
+    /// raise the score (jaro_winkler >= jaro), and it does not apply at all when
+    /// jaro <= 0.7 or when there is no common first char.
+    #[hegel::test]
+    fn hegel_jaro_winkler_bounds_and_prefix_bonus(tc: hegel::TestCase) {
+        let (mut a, mut b) = tc.draw(string_pair());
+        // Boost shared prefixes so the bonus branch (jaro > 0.7, common prefix)
+        // is actually exercised.
+        if tc.draw(generators::booleans()) {
+            let prefix = tc.draw(metric_string());
+            a = format!("{}{}", prefix, a);
+            b = format!("{}{}", prefix, b);
+        }
+        let j = jaro(&a, &b);
+        let jw = jaro_winkler(&a, &b);
+        assert!((0.0..=1.0).contains(&j), "jaro {} out of [0, 1]", j);
+        assert!((0.0..=1.0).contains(&jw), "jaro_winkler {} out of [0, 1]", jw);
+        assert!(jw >= j, "jaro_winkler {} < jaro {}", jw, j);
+        if j <= 0.7 || a.chars().next() != b.chars().next() {
+            assert_eq!(j, jw, "prefix bonus applied when it shouldn't be");
+        }
+    }
+
+    /// The normalized scores stay in [0, 1] and hit exactly 1.0 iff the strings
+    /// are equal ("1.0 means the strings are the same" per the docs).
+    #[hegel::test]
+    fn hegel_normalized_scores_bounds(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(string_pair());
+        let nl = normalized_levenshtein(&a, &b);
+        let ndl = normalized_damerau_levenshtein(&a, &b);
+        let sd = sorensen_dice(&a, &b);
+        assert!((0.0..=1.0).contains(&nl), "normalized_levenshtein {}", nl);
+        assert!((0.0..=1.0).contains(&ndl), "normalized_damerau_levenshtein {}", ndl);
+        assert!((0.0..=1.0).contains(&sd), "sorensen_dice {}", sd);
+        assert_eq!(a == b, nl == 1.0);
+        assert_eq!(a == b, ndl == 1.0);
+    }
+
+    /// The crate ships two independent Damerau-Levenshtein implementations:
+    /// `damerau_levenshtein` (Zhao-Sahni linear-space algorithm) and
+    /// `generic_damerau_levenshtein` (classic Lowrance-Wagner with a HashMap).
+    /// They must agree on every input.
+    #[hegel::test]
+    fn hegel_damerau_implementations_agree(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(string_pair());
+        let a_chars: Vec<char> = a.chars().collect();
+        let b_chars: Vec<char> = b.chars().collect();
+        assert_eq!(
+            generic_damerau_levenshtein(&a_chars, &b_chars),
+            damerau_levenshtein(&a, &b)
+        );
+    }
+
+    /// Straightforward reference implementation of the documented
+    /// Sørensen-Dice coefficient (https://en.wikipedia.org/wiki/S%C3%B8rensen%E2%80%93Dice_coefficient):
+    /// 2 * |intersection of bigram multisets| / (#bigrams(a) + #bigrams(b)),
+    /// on the whitespace-stripped strings, mirroring the special cases of the
+    /// implementation under test (equal -> 1.0, fewer than 2 chars -> 0.0).
+    fn sorensen_dice_reference(a: &str, b: &str) -> f64 {
+        let a: Vec<char> = a.chars().filter(|c| !c.is_whitespace()).collect();
+        let b: Vec<char> = b.chars().filter(|c| !c.is_whitespace()).collect();
+        if a == b {
+            return 1.0;
+        }
+        if a.len() < 2 || b.len() < 2 {
+            return 0.0;
+        }
+        let mut a_bigrams: HashMap<(char, char), usize> = HashMap::new();
+        for w in a.windows(2) {
+            *a_bigrams.entry((w[0], w[1])).or_insert(0) += 1;
+        }
+        let mut intersection = 0_usize;
+        for w in b.windows(2) {
+            if let Some(count) = a_bigrams.get_mut(&(w[0], w[1])) {
+                if *count > 0 {
+                    *count -= 1;
+                    intersection += 1;
+                }
+            }
+        }
+        (2 * intersection) as f64 / ((a.len() - 1) + (b.len() - 1)) as f64
+    }
+
+    /// sorensen_dice must match the documented bigram-based Dice coefficient.
+    ///
+    /// KNOWN FAILURE: sorensen_dice divides by *byte* lengths
+    /// (`a.len() + b.len() - 2` on the whitespace-stripped `String`s) while the
+    /// numerator counts *char* bigrams, so any non-ASCII character inflates the
+    /// denominator and deflates the score. Minimal counterexample (found and
+    /// shrunk by hegel): sorensen_dice("\u{80}aa", "aa") = 0.5, but the
+    /// documented Dice coefficient is 2*1/(2+1) = 2/3. The `one_of!` branch
+    /// below pins that counterexample so this test fails deterministically on
+    /// every run until the bug is fixed.
+    #[hegel::test]
+    fn hegel_sorensen_dice_matches_reference(tc: hegel::TestCase) {
+        let (a, b) = tc.draw(hegel::one_of!(
+            string_pair(),
+            generators::just(("\u{80}aa".to_string(), "aa".to_string())),
+        ));
+        let expected = sorensen_dice_reference(&a, &b);
+        let actual = sorensen_dice(&a, &b);
+        assert!(
+            (expected - actual).abs() < 1e-9,
+            "sorensen_dice({:?}, {:?}) = {}, reference says {}",
+            a,
+            b,
+            actual,
+            expected
+        );
+    }
+}
