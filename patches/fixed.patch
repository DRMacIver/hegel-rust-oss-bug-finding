+            U0F8, u8, generators::integers::<u8>();
+            U8F0, u8, generators::integers::<u8>();
+            U16F16, u32, generators::integers::<u32>();
+            U0F32, u32, generators::integers::<u32>();
+            U32F0, u32, generators::integers::<u32>();
+            U0F64, u64, generators::integers::<u64>();
+            U64F0, u64, generators::integers::<u64>();
+            I16F16, i32, generators::integers::<i32>().min_value(0);
+            I32F0, i32, generators::integers::<i32>().min_value(0);
+            I1F31, i32, generators::integers::<i32>().min_value(0);
+        );
+    }
+
+    // Property: for signed types with zero integer bits, sqrt is documented
+    // to overflow exactly for inputs >= 0.25; checked_sqrt returns None for
+    // those and satisfies the rounded-down contract for smaller inputs.
+    #[hegel::test]
+    fn hegel_sqrt_all_frac_signed_overflows_at_quarter(tc: hegel::TestCase) {
+        let bits: i32 = tc.draw(generators::integers::<i32>().min_value(0));
+        let x = I0F32::from_bits(bits);
+        let quarter = 1i32 << 30;
