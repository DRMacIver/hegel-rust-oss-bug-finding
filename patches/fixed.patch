@@ -837,7 +837,265 @@ pub mod i128 {
 
 #[cfg(test)]
 mod tests {
+    use crate::types::*;
     use crate::*;
+    use hegel::generators;
+    use std::format;
+    #[cfg(not(feature = "std"))]
+    use std::string::ToString;
+
+    // Property: checked/wrapping/saturating/overflowing addition all agree
+    // with an exact wide-integer oracle. In bit representation, the exact
+    // sum of a and b is simply a_bits + b_bits computed in i128;
+    //   * overflow happens iff that exact value does not fit the bits type,
+    //   * wrapping returns the exact value truncated to the bits type,
+    //   * overflowing returns (wrapped, overflow-flag),
+    //   * checked returns None exactly on overflow,
+    //   * saturating clamps exactly to MAX/MIN depending on the sign of the
+    //     exact result.
+    macro_rules! check_addsub_oracle {
+        ($tc:expr, $op:ident; $($T:ty, $Bits:ty);* $(;)?) => {
+            $({
+                let a_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let b_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let a = <$T>::from_bits(a_bits);
+                let b = <$T>::from_bits(b_bits);
+                let exact = addsub_exact!($op, a_bits, b_bits);
+                let in_range =
+                    <$Bits>::MIN as i128 <= exact && exact <= <$Bits>::MAX as i128;
+                let wrapped = <$T>::from_bits(exact as $Bits);
+                paste_ops!($op, a, b, exact, in_range, wrapped, $T, a_bits, b_bits);
+            })*
+        };
+    }
+
+    macro_rules! addsub_exact {
+        (add, $a:expr, $b:expr) => {
+            $a as i128 + $b as i128
+        };
+        (sub, $a:expr, $b:expr) => {
+            $a as i128 - $b as i128
+        };
+    }
+
+    macro_rules! paste_ops {
+        (add, $a:expr, $b:expr, $exact:expr, $in_range:expr, $wrapped:expr, $T:ty, $ab:expr, $bb:expr) => {
+            assert_op_family!(
+                $T, $ab, $bb, $exact, $in_range, $wrapped,
+                $a.checked_add($b), $a.wrapping_add($b), $a.overflowing_add($b),
+                $a.saturating_add($b)
+            );
+        };
+        (sub, $a:expr, $b:expr, $exact:expr, $in_range:expr, $wrapped:expr, $T:ty, $ab:expr, $bb:expr) => {
+            assert_op_family!(
+                $T, $ab, $bb, $exact, $in_range, $wrapped,
+                $a.checked_sub($b), $a.wrapping_sub($b), $a.overflowing_sub($b),
+                $a.saturating_sub($b)
+            );
+        };
+    }
+
+    macro_rules! assert_op_family {
+        ($T:ty, $ab:expr, $bb:expr, $exact:expr, $in_range:expr, $wrapped:expr,
+         $checked:expr, $wrapping:expr, $overflowing:expr, $saturating:expr) => {{
+            let ctx = || {
+                format!(
+                    "{} a_bits {:#x} b_bits {:#x}",
+                    stringify!($T),
+                    $ab,
+                    $bb
+                )
+            };
+            assert_eq!($wrapping, $wrapped, "wrapping: {}", ctx());
+            assert_eq!($overflowing, ($wrapped, !$in_range), "overflowing: {}", ctx());
+            assert_eq!(
+                $checked,
+                if $in_range { Some($wrapped) } else { None },
+                "checked: {}",
+                ctx()
+            );
+            let expected_sat = if $in_range {
+                $wrapped
+            } else if $exact > 0 {
+                <$T>::MAX
+            } else {
+                <$T>::MIN
+            };
+            assert_eq!($saturating, expected_sat, "saturating: {}", ctx());
+        }};
+    }
+
+    #[hegel::test]
+    fn hegel_add_agrees_with_wide_integer_oracle(tc: hegel::TestCase) {
+        check_addsub_oracle!(tc, add;
+            I0F8, i8; U0F8, u8;
+            I16F16, i32; U16F16, u32;
+            I32F0, i32; U32F0, u32;
+            I32F32, i64; U0F64, u64;
+        );
+    }
+
+    #[hegel::test]
+    fn hegel_sub_agrees_with_wide_integer_oracle(tc: hegel::TestCase) {
+        check_addsub_oracle!(tc, sub;
+            I0F8, i8; U0F8, u8;
+            I16F16, i32; U16F16, u32;
+            I32F0, i32; U32F0, u32;
+            I32F32, i64; U0F64, u64;
+        );
+    }
+
+    // Property: multiplication agrees with an exact wide-integer oracle.
+    // The mathematical product of a and b in bit representation is
+    // (a_bits * b_bits) >> frac_nbits, rounding down (arithmetic shift),
+    // which the implementation documents through its double-width algorithm
+    // in arith.rs. checked/wrapping/overflowing/saturating must all be
+    // consistent with that exact floored product.
+    macro_rules! check_mul_oracle {
+        ($tc:expr; $($T:ty, $Bits:ty, $Wide:ty);* $(;)?) => {
+            $({
+                let a_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let b_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let a = <$T>::from_bits(a_bits);
+                let b = <$T>::from_bits(b_bits);
+                let exact: $Wide =
+                    ((a_bits as $Wide) * (b_bits as $Wide)) >> <$T>::FRAC_NBITS;
+                let in_range =
+                    <$Bits>::MIN as $Wide <= exact && exact <= <$Bits>::MAX as $Wide;
+                let wrapped = <$T>::from_bits(exact as $Bits);
+                assert_op_family!(
+                    $T, a_bits, b_bits, exact, in_range, wrapped,
+                    a.checked_mul(b), a.wrapping_mul(b), a.overflowing_mul(b),
+                    a.saturating_mul(b)
+                );
+            })*
+        };
+    }
+
+    #[hegel::test]
+    fn hegel_mul_agrees_with_floored_wide_oracle(tc: hegel::TestCase) {
+        check_mul_oracle!(tc;
+            I4F4, i8, i128; I0F8, i8, i128; U0F8, u8, u128;
+            I16F16, i32, i128; U16F16, u32, u128;
+            I32F0, i32, i128; U0F32, u32, u128;
+            I32F32, i64, i128; U0F64, u64, u128;
+        );
+    }
+
+    // Property: division agrees with an exact wide-integer oracle. The
+    // mathematical quotient in bit representation is
+    // (a_bits << frac_nbits) / b_bits truncated toward zero. The divisor
+    // must be nonzero; checked_div returns None for a zero divisor or on
+    // overflow, and the other variants must be consistent with the exact
+    // truncated quotient.
+    macro_rules! check_div_oracle {
+        ($tc:expr; $($T:ty, $Bits:ty, $Wide:ty);* $(;)?) => {
+            $({
+                let a_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let b_bits: $Bits = $tc.draw(generators::integers::<$Bits>());
+                let a = <$T>::from_bits(a_bits);
+                let b = <$T>::from_bits(b_bits);
+                if b_bits == 0 {
+                    assert_eq!(a.checked_div(b), None);
+                } else {
+                    let lhs_wide = (a_bits as $Wide) << <$T>::FRAC_NBITS;
+                    match lhs_wide.checked_div(b_bits as $Wide) {
+                        Some(exact) => {
+                            let in_range = <$Bits>::MIN as $Wide <= exact
+                                && exact <= <$Bits>::MAX as $Wide;
+                            let wrapped = <$T>::from_bits(exact as $Bits);
+                            assert_op_family!(
+                                $T, a_bits, b_bits, exact, in_range, wrapped,
+                                a.checked_div(b), a.wrapping_div(b),
+                                a.overflowing_div(b), a.saturating_div(b)
+                            );
+                        }
+                        None => {
+                            // Only i128::MIN / -1, which overflows even the
+                            // wide type; the implementation documents this
+                            // as an overflow.
+                            assert!(a.overflowing_div(b).1, "expected overflow");
+                            assert_eq!(a.checked_div(b), None);
+                        }
+                    }
+                }
+            })*
+        };
+    }
+
+    #[hegel::test]
+    fn hegel_div_agrees_with_truncated_wide_oracle(tc: hegel::TestCase) {
+        check_div_oracle!(tc;
+            I4F4, i8, i128; I0F8, i8, i128; U0F8, u8, u128;
+            I16F16, i32, i128; U16F16, u32, u128;
+            I32F0, i32, i128; U0F32, u32, u128;
+            I32F32, i64, i128; I0F64, i64, i128; U0F64, u64, u128;
+        );
+    }
+
+    // Property: negation overflows exactly at the boundary — for signed
+    // types only at MIN, for unsigned types for every nonzero value — and
+    // the checked/wrapping/overflowing/saturating variants agree with the
+    // wrapped bit-level negation.
+    #[hegel::test]
+    fn hegel_neg_overflows_exactly_at_boundary(tc: hegel::TestCase) {
+        macro_rules! check_neg {
+            ($($T:ty, $Bits:ty, $overflows:expr, $sat_of_overflowing:expr);* $(;)?) => {
+                $({
+                    let bits: $Bits = tc.draw(generators::integers::<$Bits>());
+                    let x = <$T>::from_bits(bits);
+                    let overflows: bool = $overflows(bits);
+                    let wrapped = <$T>::from_bits(bits.wrapping_neg());
+                    assert_eq!(x.wrapping_neg(), wrapped);
+                    assert_eq!(x.overflowing_neg(), (wrapped, overflows));
+                    assert_eq!(
+                        x.checked_neg(),
+                        if overflows { None } else { Some(wrapped) }
+                    );
+                    let expected_sat = if overflows { $sat_of_overflowing } else { wrapped };
+                    assert_eq!(x.saturating_neg(), expected_sat);
