+            .insert(key.as_slice(), value.as_slice())
+            .expect("insert should work");
+        models[i].insert(key, value);
+    }
+
+    // Freeze: snapshot + copy of the model at this instant.
+    let snapshot = db.snapshot();
+    let frozen = models.clone();
+
+    // Phase 2: mutate the live database.
+    let op_count = tc.draw(generators::integers::<usize>().max_value(20));
+    for _ in 0..op_count {
+        let i = tc.draw(generators::integers::<usize>().max_value(keyspace_count - 1));
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 | 1 => {
