 use fjall::Database;
+use hegel::generators;
+
+// Property: any keyspace name accepted by `Database::keyspace` (per
+// `is_valid_keyspace_name`: non-empty, at most 255 bytes — the implementation
+// does not restrict the character set) survives closing and reopening the
+// database, together with its data.
+#[hegel::test]
+fn accepted_keyspace_names_survive_reopen(tc: hegel::TestCase) {
+    use fjall::KeyspaceCreateOptions;
+
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+
+    // Up to 63 chars of at most 4 UTF-8 bytes each = at most 252 bytes,
+    // within the implementation's 255-byte limit.
+    let names: Vec<String> = tc.draw(
+        generators::vecs(generators::text().min_size(1).max_size(63))
+            .min_size(1)
+            .max_size(4)
+            .unique(true),
+    );
+
+    {
+        let db = Database::builder(&folder).open().expect("db should open");
+        for (i, name) in names.iter().enumerate() {
+            let keyspace = db
+                .keyspace(name, KeyspaceCreateOptions::default)
+                .expect("keyspace creation should work");
+            keyspace
+                .insert("k", i.to_be_bytes())
+                .expect("insert should work");
+        }
+    }
+
+    let db = Database::builder(&folder).open().expect("db should reopen");
+    for (i, name) in names.iter().enumerate() {
+        assert!(
+            db.keyspace_exists(name),
+            "keyspace {name:?} vanished on reopen",
+        );
+        let keyspace = db
+            .keyspace(name, KeyspaceCreateOptions::default)
+            .expect("keyspace should reopen");
+        assert_eq!(
+            Some(i.to_be_bytes().as_slice()),
+            keyspace.get("k").expect("get should work").as_deref(),
+            "keyspace {name:?} lost its data on reopen",
+        );
+    }
+}
 
