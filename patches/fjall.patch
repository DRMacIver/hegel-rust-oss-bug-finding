 use fjall::{Database, KeyspaceCreateOptions, KvSeparationOptions};
+use hegel::generators;
 use lsm_tree::AbstractTree;
+use std::collections::BTreeMap;
 use test_log::test;
 
+// Property: with generated kv-separation options (separation threshold, blob
+// file target size), a keyspace returns every inserted value byte-for-byte —
+// through the memtable, after flushing to blob files, and after major
+// compaction. Values straddle the separation threshold so both the inline and
+// the separated code paths are exercised.
+#[hegel::test]
+fn blob_roundtrip_matches_model(tc: hegel::TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+
+    let separation_threshold = tc.draw(generators::integers::<u32>().min_value(1).max_value(2048));
+    let file_target_size = tc.draw(generators::integers::<u64>().min_value(1).max_value(100_000));
+
+    let keyspace = db
+        .keyspace("default", || {
+            KeyspaceCreateOptions::default().with_kv_separation(Some(
+                KvSeparationOptions::default()
+                    .separation_threshold(separation_threshold)
+                    .file_target_size(file_target_size),
+            ))
+        })
+        .expect("keyspace creation should work");
+
+    let mut model: BTreeMap<Vec<u8>, Vec<u8>> = BTreeMap::new();
+
+    let op_count = tc.draw(generators::integers::<usize>().max_value(20));
+    for _ in 0..op_count {
+        let key: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(4));
+        // Sizes span the separation threshold range (0..=4096 vs threshold <= 2048).
+        let size = tc.draw(generators::integers::<usize>().max_value(4096));
+        let value: Vec<u8> = tc.draw(generators::binary().min_size(size).max_size(size));
+        keyspace
+            .insert(key.as_slice(), value.as_slice())
+            .expect("insert should work");
+        model.insert(key, value);
+    }
+
+    if tc.draw(generators::booleans()) {
+        keyspace
+            .rotate_memtable_and_wait()
+            .expect("rotation should work");
+
+        if tc.draw(generators::booleans()) {
+            keyspace.major_compact().expect("compaction should work");
+        }
+    }
+
+    for (key, value) in &model {
+        let got = keyspace.get(key.as_slice()).expect("get should work");
+        assert_eq!(Some(value.as_slice()), got.as_deref());
+    }
+
+    let got: Vec<(Vec<u8>, Vec<u8>)> = keyspace
+        .iter()
+        .map(|guard| {
+            let (k, v) = guard.into_inner().expect("read kv");
+            (k.to_vec(), v.to_vec())
+        })
+        .collect();
+    let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+        .iter()
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect();
+    assert_eq!(got, expected);
+}
