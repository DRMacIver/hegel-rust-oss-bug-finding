@@ -0,0 +1,324 @@
+// Stateful model test: runs random operation sequences (including cross-keyspace
+// batches, clears, memtable rotations and major compaction) against a Database
+// and diffs the observable state against a BTreeMap-per-keyspace model after
+// every step.
+//
+// Evidence for the property: fjall documents "A thread-safe BTreeMap-like API"
+// (src/lib.rs), and the Keyspace/WriteBatch docs promise ordinary map semantics
+// (insert overwrites, remove deletes, clear empties, iteration in key order).
+
+use fjall::{Database, Keyspace, KeyspaceCreateOptions, KvSeparationOptions};
+use hegel::generators;
+use hegel::TestCase;
+use std::collections::BTreeMap;
+
+type Model = BTreeMap<Vec<u8>, Vec<u8>>;
+
+/// Mix of high-collision tiny keys (so overwrites/removals of existing keys
+/// actually happen) and arbitrary binary keys.
+#[hegel::composite]
+fn arb_key(tc: TestCase) -> Vec<u8> {
+    tc.draw(hegel::one_of!(
+        generators::vecs(generators::integers::<u8>().max_value(3))
+            .min_size(1)
+            .max_size(3),
+        generators::binary().min_size(1).max_size(64),
+    ))
+}
+
+/// Mostly small values, sometimes large enough to cross kv-separation thresholds.
+#[hegel::composite]
+fn arb_value(tc: TestCase) -> Vec<u8> {
+    tc.draw(hegel::one_of!(
+        generators::binary().max_size(16),
+        generators::binary().min_size(900).max_size(3000),
+    ))
+}
+
+/// Draw a key, biased towards keys that are already present in the model.
+fn draw_key(tc: &TestCase, model: &Model) -> Vec<u8> {
+    if !model.is_empty() && tc.draw(generators::booleans()) {
+        let i = tc.draw(generators::integers::<usize>().max_value(model.len() - 1));
+        model.keys().nth(i).expect("index is in range").clone()
+    } else {
+        tc.draw(arb_key())
+    }
+}
+
+// Print op failures to stderr so they survive hegel's panic capture
+// (only the final replay's panic payload is shown otherwise).
+fn expect_ok<T>(r: fjall::Result<T>, what: &str) -> T {
+    match r {
+        Ok(v) => v,
+        Err(e) => {
+            eprintln!("MODEL-TEST OP FAILED: {what}: {e:?}");
+            panic!("{what} failed: {e:?}");
+        }
+    }
+}
+
+struct DatabaseMachine {
+    // NOTE: field order matters — struct fields drop in declaration order, and
+    // the TempDir must outlive the Database (deleting the directory while
+    // background flush workers are running crashes them with Io(NotFound),
+    // which poisons the database and makes `Database::drop` hang).
+    keyspaces: Vec<(Keyspace, Model)>,
+    db: Database,
+    _folder: tempfile::TempDir,
+}
+
+impl DatabaseMachine {
+    fn pick_keyspace(&self, tc: &TestCase) -> usize {
+        tc.draw(generators::integers::<usize>().max_value(self.keyspaces.len() - 1))
+    }
+}
+
+#[hegel::state_machine]
+impl DatabaseMachine {
+    /// Create an additional keyspace with generated options
+    /// (kv separation on/off, small or default write buffer).
+    #[rule]
+    fn create_keyspace(&mut self, tc: TestCase) {
+        tc.assume(self.keyspaces.len() < 4);
+
+        let name = format!("ks{}", self.keyspaces.len());
+        let kv_separated = tc.draw(generators::booleans());
+        let separation_threshold = tc.draw(generators::integers::<u32>().min_value(1).max_value(2048));
+        let small_memtable = tc.draw(generators::booleans());
+
+        let keyspace = self
+            .db
+            .keyspace(&name, || {
+                let mut opts = KeyspaceCreateOptions::default();
+                if kv_separated {
+                    opts = opts.with_kv_separation(Some(
+                        KvSeparationOptions::default().separation_threshold(separation_threshold),
+                    ));
+                }
+                if small_memtable {
+                    opts = opts.max_memtable_size(/* 8 KiB */ 8 * 1_024);
+                }
+                opts
+            })
+            .expect("keyspace creation should work");
+
+        self.keyspaces.push((keyspace, Model::new()));
+    }
+
+    #[rule]
+    fn insert(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &mut self.keyspaces[i];
+        let key = draw_key(&tc, model);
+        let value = tc.draw(arb_value());
+
+        expect_ok(keyspace.insert(key.as_slice(), value.as_slice()), "insert");
+        model.insert(key, value);
+    }
+
+    #[rule]
+    fn remove(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &mut self.keyspaces[i];
+        let key = draw_key(&tc, model);
+
+        expect_ok(keyspace.remove(key.as_slice()), "remove");
+        model.remove(&key);
+    }
+
+    /// Commit a batch of writes spanning several keyspaces atomically.
+    #[rule]
+    fn batch_commit(&mut self, tc: TestCase) {
+        let op_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let mut batch = self.db.batch();
+        // (keyspace index, key, Some(value) for insert / None for remove)
+        let mut ops: Vec<(usize, Vec<u8>, Option<Vec<u8>>)> = Vec::new();
+
+        for _ in 0..op_count {
+            let i = self.pick_keyspace(&tc);
+            let (keyspace, model) = &self.keyspaces[i];
+            let key = draw_key(&tc, model);
+
+            if tc.draw(generators::booleans()) {
+                let value = tc.draw(arb_value());
+                batch.insert(keyspace, key.as_slice(), value.as_slice());
+                ops.push((i, key, Some(value)));
+            } else {
+                batch.remove(keyspace, key.as_slice());
+                ops.push((i, key, None));
+            }
+        }
+
+        expect_ok(batch.commit(), "batch commit");
+
+        for (i, key, value) in ops {
+            let model = &mut self.keyspaces[i].1;
+            match value {
+                Some(value) => {
+                    model.insert(key, value);
+                }
+                None => {
+                    model.remove(&key);
+                }
+            }
+        }
+    }
+
+    #[rule]
+    fn clear_keyspace(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &mut self.keyspaces[i];
+        expect_ok(keyspace.clear(), "clear");
+        model.clear();
+    }
+
+    /// Force the active memtable to be flushed to a table on disk.
+    #[rule]
+    fn rotate_memtable(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        expect_ok(self.keyspaces[i].0.rotate_memtable_and_wait(), "rotate_memtable");
+    }
+
+    /// Merge all tables into one.
+    #[rule]
+    fn major_compact(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        expect_ok(self.keyspaces[i].0.major_compact(), "major_compact");
+    }
+
+    #[rule]
+    fn get_matches_model(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &self.keyspaces[i];
+        let key = draw_key(&tc, model);
+
+        let got = expect_ok(keyspace.get(key.as_slice()), "get");
+        if got.as_deref() != model.get(&key).map(Vec::as_slice) {
+            eprintln!("MODEL-TEST GET MISMATCH key={key:?} got={got:?} expected={:?}", model.get(&key));
+            panic!("get({key:?}) disagrees with model");
+        }
+    }
+
+    #[rule]
+    fn contains_key_matches_model(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &self.keyspaces[i];
+        let key = draw_key(&tc, model);
+
+        let got = expect_ok(keyspace.contains_key(key.as_slice()), "contains_key");
+        assert_eq!(got, model.contains_key(&key));
+    }
+
+    #[rule]
+    fn size_of_matches_model(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &self.keyspaces[i];
+        let key = draw_key(&tc, model);
+
+        let got = expect_ok(keyspace.size_of(key.as_slice()), "size_of");
+        assert_eq!(
+            got,
+            model.get(&key).map(|v| u32::try_from(v.len()).expect("fits")),
+        );
+    }
+
+    #[rule]
+    fn first_and_last_match_model(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &self.keyspaces[i];
+
+        let first = keyspace
+            .first_key_value()
+            .map(|guard| guard.into_inner().expect("read kv"))
+            .map(|(k, v)| (k.to_vec(), v.to_vec()));
+        assert_eq!(
+            first,
+            model.first_key_value().map(|(k, v)| (k.clone(), v.clone())),
+        );
+
+        let last = keyspace
+            .last_key_value()
+            .map(|guard| guard.into_inner().expect("read kv"))
+            .map(|(k, v)| (k.to_vec(), v.to_vec()));
+        assert_eq!(
+            last,
+            model.last_key_value().map(|(k, v)| (k.clone(), v.clone())),
+        );
+    }
+
+    #[rule]
+    fn reverse_iter_matches_model(&mut self, tc: TestCase) {
+        let i = self.pick_keyspace(&tc);
+        let (keyspace, model) = &self.keyspaces[i];
+
+        let got: Vec<(Vec<u8>, Vec<u8>)> = keyspace
+            .iter()
+            .rev()
+            .map(|guard| {
+                let (k, v) = guard.into_inner().expect("read kv");
+                (k.to_vec(), v.to_vec())
+            })
+            .collect();
+        let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+            .iter()
+            .rev()
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        if got != expected {
+            eprintln!("MODEL-TEST REV-ITER MISMATCH got={got:?} expected={expected:?}");
+            panic!("reverse iteration disagrees with model");
+        }
+    }
+
+    /// After every step, every keyspace must contain exactly the model's
+    /// entries, in ascending key order.
+    #[invariant]
+    fn contents_match_model(&self, _tc: TestCase) {
+        for (keyspace, model) in &self.keyspaces {
+            let got: Vec<(Vec<u8>, Vec<u8>)> = keyspace
+                .iter()
+                .map(|guard| {
+                    let (k, v) = guard.into_inner().expect("read kv");
+                    (k.to_vec(), v.to_vec())
+                })
+                .collect();
+            let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+                .iter()
+                .map(|(k, v)| (k.clone(), v.clone()))
+                .collect();
+            if got != expected {
+                eprintln!(
+                    "MODEL-TEST INVARIANT MISMATCH in {:?}: got={got:?} expected={expected:?}",
+                    keyspace.name(),
+                );
+                panic!("keyspace {:?} disagrees with model", keyspace.name());
+            }
+        }
+    }
+}
+
+#[hegel::test]
+fn database_matches_btreemap_model(tc: TestCase) {
+    // Surface fjall worker-thread errors on stderr; without a logger,
+    // background flush/compaction crashes are silent.
+    let _ = env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("error"))
+        .is_test(false)
+        .try_init();
+
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+
+    // Start with one keyspace so most rules apply immediately;
+    // `create_keyspace` can add more (with different configurations).
+    let keyspace = db
+        .keyspace("ks_initial", KeyspaceCreateOptions::default)
+        .expect("keyspace creation should work");
+
+    let machine = DatabaseMachine {
+        keyspaces: vec![(keyspace, Model::new())],
+        db,
+        _folder: folder,
+    };
+
+    hegel::stateful::run(machine, tc);
+}
