+fn collect(iter: fjall::Iter) -> Vec<(Vec<u8>, Vec<u8>)> {
+    iter.map(|guard| {
+        let (k, v) = guard.into_inner().expect("read kv");
+        (k.to_vec(), v.to_vec())
+    })
+    .collect()
+}
