+        let resid = (&reconstructed - &a).norm();
+        assert!(
+            resid <= tol,
+            "||Q*R - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // Oracle-independent orthonormality: the columns of the computed Q are
+    // orthonormal, i.e. Q^T * Q ≈ I (Q is rows x min(rows, cols), so the
+    // Gram matrix is min x min).
+    //
+    // Tolerance: for Householder QR the computed Q satisfies
+    // ||Q^T Q - I||_2 <= c * n * eps regardless of A's conditioning (the
+    // Householder reflectors are orthogonal to working precision). In
+    // Frobenius norm this picks up at most a factor sqrt(min(rows, cols));
+    // c = 32 for headroom. No dependence on ||A|| — Q's entries are O(1).
