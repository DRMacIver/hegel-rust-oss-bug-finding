diff --git a/tests/linalg/inverse.rs b/tests/linalg/inverse.rs
index ab641a7..be01f81 100644
--- a/tests/linalg/inverse.rs
+++ b/tests/linalg/inverse.rs
@@ -140,3 +140,93 @@ fn matrix5_try_inverse_scaled_identity() {
 
     assert_relative_eq!(a_inv, expected_inverse);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the example-based tests above with drawn inputs.
+// Dimensions are drawn from 1..=6 and entry magnitudes bounded to
+// [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, zero_tiny_entries};
+    use na::{DMatrix, Matrix4};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // A * A^{-1} ≈ I whenever `try_inverse` succeeds.
+    //
+    // Tolerance: for dynamic matrices the inverse is computed via LU, i.e.
+    // column j of X = A^{-1} is a backward-stable solve of A x = e_j, so
+    // ||A X - I|| <= c * n * g * eps * ||A|| * ||X||  (g <= 2^(n-1) is the
+    // partial-pivoting growth factor). Note ||A|| * ||X|| is (an upper
+    // bound on) the measured Frobenius condition number kappa_F(A), so the
+    // tolerance self-scales with the conditioning — kappa is in the
+    // formula, not just in a comment. We do still skip kappa_F > 1e12: in
+    // that tail the modest constant c is no longer trustworthy and the
+    // check would be vacuous anyway (tolerance near 1).
+    #[hegel::test]
+    fn inverse_composes_to_identity(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — dynamic-size inversion
+        // goes through LU, where subnormal pivots poison the factors with
+        // NaN; pinned in `lu_reconstruction_known_failure_subnormal_pivot`
+        // (tests/linalg/lu.rs).
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        if let Some(inv) = a.clone().try_inverse() {
+            let kappa_f = fro_norm_upper(&a) * fro_norm_upper(&inv);
+            if kappa_f > 1.0e12 {
+                return; // condition threshold: identity not checkable in f64
+            }
+            let tol = (64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa_f)
+                .max(f64::MIN_POSITIVE);
+            let resid = (&a * &inv - DMatrix::<f64>::identity(n, n)).norm();
+            assert!(
+                resid <= tol,
+                "||A A^-1 - I|| = {resid:e} > tol = {tol:e} for A = {a}"
+            );
+        }
+        // `try_inverse` returning None for a randomly drawn matrix is rare
+        // (it requires an exactly zero pivot); the guarded branch fires on
+        // essentially every case — verified during test bring-up.
+    }
+
+    // Statically-sized variant: Matrix4 inversion goes through the
+    // dedicated cofactor formula in `src/linalg/inverse.rs`, a different
+    // code path from the LU-based dynamic case above.
+    //
+    // Tolerance: each adjugate entry is a 3x3 determinant of entries of A,
+    // computed with absolute error <= c' * eps * ||A||^3; dividing by the
+    // computed det gives ||dX|| <= c * eps * (||A||^3 + ||adj(A)||) / |det|
+    // = c * eps * (||A||^3 / |det| + ||X||), hence
+    // ||A X - I|| <= c * eps * (||A||^4 / |det| + ||A|| * ||X||).
+    // We use c = 64 and skip when ||A||^4 / |det| > 1e14 (the cofactor
+    // formula's own condition threshold, beyond which the tolerance is
+    // meaninglessly large).
+    #[hegel::test]
+    fn inverse_composes_to_identity_static4(tc: hegel::TestCase) {
+        let a = Matrix4::<f64>::from_fn(|_, _| {
+            tc.draw(
+                hegel::generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0),
+            )
+        });
+
+        if let Some(inv) = a.try_inverse() {
+            let det = a.determinant().abs();
+            let norm4 = a.norm().powi(4);
+            if det == 0.0 || norm4 / det > 1.0e14 {
+                return; // condition threshold for the cofactor formula
+            }
+            let tol = (64.0 * EPS * (norm4 / det + a.norm() * inv.norm()))
+                .max(f64::MIN_POSITIVE);
+            let resid = (a * inv - Matrix4::<f64>::identity()).norm();
+            assert!(
+                resid <= tol,
+                "||A A^-1 - I|| = {resid:e} > tol = {tol:e} for A = {a}"
+            );
+        }
+    }
+}
diff --git a/tests/linalg/lu.rs b/tests/linalg/lu.rs
index 58a661c..abbbec4 100644
--- a/tests/linalg/lu.rs
+++ b/tests/linalg/lu.rs
@@ -156,3 +156,198 @@ mod proptest_tests {
     gen_tests!(complex, complex_f64(), RandComplex<f64>);
     gen_tests!(f64, PROPTEST_F64, RandScalar<f64>);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest suite above with drawn dimensions (1..=6)
+// and explicitly conditioning-derived tolerances. Entry magnitudes are
+// bounded to [-100, 100] by the shared helpers in `crate::utils` (see the
+// comment there).
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, zero_tiny_entries};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Backward-error tolerance for LU with partial pivoting on an n x n
+    // matrix: the computed factors satisfy L*U = P*(A + dA) with
+    // ||dA|| <= c * n * g * eps * ||A||, where the growth factor g is
+    // bounded by 2^(n-1) for partial pivoting (Higham ch. 9). With n <= 6
+    // we budget g = 2^n and c = 32 for headroom. Floored at
+    // f64::MIN_POSITIVE so subnormal-scale inputs don't underflow the
+    // tolerance to exactly zero.
+    fn lu_backward_tol(n: usize, scale: f64) -> f64 {
+        (32.0 * n as f64 * (1u64 << n) as f64 * EPS * scale).max(f64::MIN_POSITIVE)
+    }
+
+    // Oracle-independent reconstruction: P * A = L * U, checked as
+    // A = P^{-1} * (L * U) exactly like `lu_simple` above.
+    #[hegel::test]
+    fn lu_reconstructs_permuted_matrix(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — subnormal pivots
+        // poison the factors with NaN; pinned deterministically in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let (p, l, u) = a.clone().lu().unpack();
+        let mut lu = l * u;
+        p.inv_permute_rows(&mut lu);
+
+        let tol = lu_backward_tol(n, fro_norm_upper(&a));
+        let resid = (&lu - &a).norm();
+        assert!(
+            resid <= tol,
+            "||P^-1 L U - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // Solve residual: for x = lu_solve(A, b), A * x ≈ b.
+    //
+    // Tolerance: a backward-stable solve returns x that exactly solves
+    // (A + dA) x = b with ||dA|| <= c * n * g * eps * ||A||, so the residual
+    // obeys ||A x - b|| <= c * n * g * eps * ||A|| * ||x||. Scaling the
+    // tolerance by ||x|| makes the property hold even for near-singular A
+    // (where ||x|| blows up), so no condition-number skip is needed here —
+    // we only skip when `solve` itself reports exact singularity (a pivot
+    // is exactly zero and no solution is produced). The + ||b|| term covers
+    // the representation error of b itself when x is tiny.
+    #[hegel::test]
+    fn lu_solve_residual_is_small(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — subnormal pivots
+        // poison the factors with NaN; pinned deterministically in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+        let b = draw_dmatrix(&tc, n, 1);
+
+        let lu = a.clone().lu();
+        if let Some(x) = lu.solve(&b) {
+            // If the true solution's magnitude exceeds f64::MAX the solver
+            // faithfully returns infinities and no finite-residual bound
+            // applies; skip. (Observed for 1x1 systems with a near-1e-308
+            // pivot and O(10) rhs. This protects the property's domain, not
+            // any nalgebra contract.)
+            if !x.iter().all(|v| v.is_finite()) {
+                return;
+            }
+            let tol = lu_backward_tol(n, fro_norm_upper(&a) * fro_norm_upper(&x) + fro_norm_upper(&b));
+            let resid = (&a * &x - &b).norm();
+            assert!(
+                resid <= tol,
+                "||A x - b|| = {resid:e} > tol = {tol:e} for A = {a}, b = {b}"
+            );
+        }
+    }
+
+    // det(A * B) = det(A) * det(B).
+    //
+    // Both sides are computed through LU (for n > 3), whose determinant has
+    // relative error ~ c * n * g * eps * kappa(A): to first order,
+    // |d det| <= ||adj(A)|| * ||dA|| = |det(A)| * ||A^{-1}|| * ||dA||, with
+    // ||dA|| <= c' * n * g * eps * ||A|| from backward stability, i.e. a
+    // relative error c' * n * g * eps * kappa(A). We measure
+    // kappa_2 = sigma_max / sigma_min from the SVD, combine
+    // kappa(A*B) <= kappa(A) * kappa(B), and skip pairs whose resulting
+    // relative tolerance exceeds 1e-3 — for those the identity is not
+    // checkable in f64 (this is the determinant/condition threshold skip;
+    // singular draws, e.g. matrices containing a zero column, are skipped
+    // the same way via sigma_min = 0).
+    #[hegel::test]
+    fn determinant_product_rule(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — the determinant is
+        // computed through LU (n > 3), where subnormal pivots poison the
+        // factors with NaN; pinned in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+        let b = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let sa = a.singular_values();
+        let sb = b.singular_values();
+        if sa.min() <= 0.0 || sb.min() <= 0.0 {
+            return; // exactly singular: det = 0 has no relative accuracy
+        }
+        let kappa = (sa.max() / sa.min()) * (sb.max() / sb.min());
+        let rel_tol = 64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa;
+        if rel_tol > 1.0e-3 {
+            return; // too ill-conditioned for the identity to be checkable
+        }
+
+        let lhs = (&a * &b).determinant();
+        let rhs = a.determinant() * b.determinant();
+        let tol = (rel_tol * lhs.abs().max(rhs.abs())).max(f64::MIN_POSITIVE);
+        assert!(
+            (lhs - rhs).abs() <= tol,
+            "det(A*B) = {lhs:e} vs det(A)*det(B) = {rhs:e}, tol = {tol:e}, A = {a}, B = {b}"
+        );
+    }
+
+    // det(A^T) = det(A).
+    //
+    // The two determinants run LU on different pivot sequences (and, for
+    // n <= 3, evaluate the cofactor formula with different groupings), so
+    // they agree only up to the determinant's own conditioning — the same
+    // c * n * g * eps * kappa(A) relative-error argument as in
+    // `determinant_product_rule`, with the same skip threshold.
+    #[hegel::test]
+    fn determinant_of_transpose_matches(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — see
+        // `determinant_product_rule` above.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let s = a.singular_values();
+        if s.min() <= 0.0 {
+            return; // exactly singular: det = 0 has no relative accuracy
+        }
+        let kappa = s.max() / s.min();
+        let rel_tol = 64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa;
+        if rel_tol > 1.0e-3 {
+            return; // too ill-conditioned for the identity to be checkable
+        }
+
+        let lhs = a.transpose().determinant();
+        let rhs = a.determinant();
+        let tol = (rel_tol * lhs.abs().max(rhs.abs())).max(f64::MIN_POSITIVE);
+        assert!(
+            (lhs - rhs).abs() <= tol,
+            "det(A^T) = {lhs:e} vs det(A) = {rhs:e}, tol = {tol:e}, A = {a}"
+        );
+    }
+
+    // KNOWN FAILURE (real bug, deterministically pinned; found by
+    // `lu_reconstructs_permuted_matrix` at a raised case count, shrunk by
+    // hegel to this input).
+    //
+    // For A = [[0, 0], [5.562684646268003e-309, 0]] — a finite matrix with
+    // a subnormal entry — the unpacked LU factors contain NaN:
+    // L = [[1, 0], [NaN, 1]], U = [[5.56e-309, 0], [0, NaN]], so the
+    // reconstruction P^-1 * L * U is NaN instead of A.
+    //
+    // Root cause: `gauss_step` / `gauss_step_swap` in src/linalg/lu.rs
+    // divide by the pivot via `let inv_diag = T::one() / diag;
+    // coeffs *= inv_diag;`. When |pivot| < 1/f64::MAX (~5.6e-309) the
+    // reciprocal overflows to inf, and the zero entries below the pivot
+    // become 0 * inf = NaN, which then propagates through the elimination.
+    // (LAPACK's dgetrf guards exactly this with an `abs(pivot) >= sfmin`
+    // test, falling back to actual division.) The hegel properties above
+    // exclude the trigger zone via `zero_tiny_entries` and reference this
+    // test.
+    #[test]
+    fn lu_reconstruction_known_failure_subnormal_pivot() {
+        // Column-major: a11, a21, a12, a22.
+        let a = na::DMatrix::<f64>::from_vec(2, 2, vec![0.0, 5.562684646268003e-309, 0.0, 0.0]);
+        let (p, l, u) = a.clone().lu().unpack();
+        let mut lu = l * u;
+        p.inv_permute_rows(&mut lu);
+
+        let tol = lu_backward_tol(2, fro_norm_upper(&a));
+        let resid = (&lu - &a).norm();
+        assert!(
+            resid <= tol,
+            "||P^-1 L U - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+}
