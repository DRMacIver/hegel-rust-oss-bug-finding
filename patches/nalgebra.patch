+    fn qr_reconstruction_known_failure_tiny_negative_pivot() {
+        let a = na::DMatrix::<f64>::from_vec(1, 2, vec![-1.2477274453361457e-162, 1.0]);
+        let qr = a.clone().qr();
+        let reconstructed = qr.q() * qr.r();
+        // Generous tolerance: the residual should be O(eps * ||A||) ~ 1e-16;
+        // the observed residual is 2.0.
