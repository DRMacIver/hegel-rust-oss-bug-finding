+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, is_sorted_descending};
+    use na::DMatrix;
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Oracle-independent reconstruction: U * Sigma * V^T ≈ A.
+    //
+    // Intended tolerance: the Golub–Kahan SVD is backward stable — the
+    // computed factors satisfy U S V^T = A + dA with
+    // ||dA|| <= c * n * eps * ||A||; being iterative it deserves a generous
+    // constant, c = 128 with n = max(rows, cols) <= 6.
+    //
+    // KNOWN BUG accommodation — see the pinned failing test
+    // `svd_reconstruction_known_failure_2x2_cancellation` below. The
+    // trailing-2x2 solver `compute_2x2_uptrig_svd` (src/linalg/svd.rs)
+    // suffers catastrophic cancellation in `v1*v1 - m11*m11` whenever the
+    // 2x2 block has m11 < m22 and a small off-diagonal, losing up to half
+    // the significant digits: the worst observed residual is
+    // ~ sqrt(eps) * ||A||. Because the block arises mid-iteration it cannot
+    // be excluded by constraining the drawn input, so until the bug is
+    // fixed this property runs with the defect ceiling
+    // tol = 8 * n * sqrt(eps) * ||A|| (still falsifiable for any grosser
+    // failure); restore the c * n * eps * ||A|| form afterwards. Floored at
+    // f64::MIN_POSITIVE against subnormal-scale draws.
+    #[hegel::test]
+    fn svd_reconstructs_matrix(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, cols);
+
+        let svd = a.clone().svd(true, true);
+        let u = svd.u.as_ref().expect("u requested");
+        let v_t = svd.v_t.as_ref().expect("v_t requested");
+        let sigma = na::DMatrix::<f64>::from_diagonal(&svd.singular_values);
+        let reconstructed = u * sigma * v_t;
+
+        let n = rows.max(cols) as f64;
+        let tol = (8.0 * n * EPS.sqrt() * fro_norm_upper(&a)).max(f64::MIN_POSITIVE);
+        let resid = (&reconstructed - &a).norm();
+        assert!(
+            resid <= tol,
+            "||U S V^T - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // KNOWN FAILURE (real bug, deterministically pinned; found by
+    // `svd_reconstructs_matrix`, shrunk by hegel to this input).
+    //
+    // For the (already upper-triangular, dynamically-sized) matrix
+    //   A = [ 2.2739560367948712  -2.5014725597524403e-6 ]
+    //       [ 0                    9.00831238235618      ]
+    // the reconstruction residual ||U S V^T - A|| is 1.23e-8 instead of the
+    // O(n * eps * ||A||) ~ 1e-14 a backward-stable SVD delivers.
+    //
+    // Root cause: `compute_2x2_uptrig_svd` in src/linalg/svd.rs computes the
+    // V rotation from `v1 * v1 - m11 * m11`. Its own comment says v1 (the
+    // singular value nearest m22) was chosen exactly so this difference
+    // does not cancel — but v1 = 2*m11*m22/denom is sigma_min, which is
+    // nearest m11 (not m22) whenever m11 < m22. In that ordering the
+    // difference cancels catastrophically and the rotation loses half its
+    // digits; sweeping the off-diagonal magnitude shows the residual peaks
+    // at ~ sqrt(eps) * ||A|| ~ 1e-8 (off-diag ~ 1e-6..1e-8) and equals
+    // |off-diag| below that. The statically-sized Matrix2::svd path does
+    // not go through this routine and reconstructs to 2e-16.
+    //
+    // The general `svd_reconstructs_matrix` property above runs with a
+    // sqrt(eps)-level tolerance until this is fixed and references this
+    // test.
+    #[test]
+    fn svd_reconstruction_known_failure_2x2_cancellation() {
+        // Column-major: a11, a21, a12, a22.
+        let a = DMatrix::<f64>::from_vec(
+            2,
+            2,
+            vec![2.2739560367948712, 0.0, -2.5014725597524403e-6, 9.00831238235618],
+        );
+        let svd = a.clone().svd(true, true);
+        let u = svd.u.as_ref().expect("u requested");
+        let v_t = svd.v_t.as_ref().expect("v_t requested");
+        let sigma = DMatrix::<f64>::from_diagonal(&svd.singular_values);
+        let reconstructed = u * sigma * v_t;
+
+        // Backward-stability tolerance (c = 128, n = 2) that the fixed code
+        // should meet; the observed residual is 1.23e-8.
+        let tol = 128.0 * 2.0 * EPS * a.norm();
+        let resid = (&reconstructed - &a).norm();
+        assert!(
+            resid <= tol,
+            "||U S V^T - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // Structural contract of the singular values: all non-negative and
+    // sorted in descending order. This is exact (no tolerance): the values
+    // are produced as magnitudes and explicitly sorted by the
+    // implementation, and the crate's own tests (`svd_sorted` above) rely
+    // on the same ordering.
+    #[hegel::test]
+    fn svd_singular_values_nonnegative_and_descending(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, cols);
+
+        let sv = a.clone().svd(false, false).singular_values;
+        assert!(
+            sv.iter().all(|&s| s >= 0.0),
+            "negative singular value in {sv} for A = {a}"
+        );
+        assert!(
+            is_sorted_descending(sv.as_slice()),
+            "singular values not descending: {sv} for A = {a}"
+        );
+    }
+}
