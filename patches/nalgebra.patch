index ac7100b..b9857d2 100644
--- a/tests/linalg/cholesky.rs
+++ b/tests/linalg/cholesky.rs
@@ -216,3 +216,50 @@ fn cholesky_non_pd_complex_returns_none() {
     );
     assert!(na::Cholesky::new(m2).is_none());
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest suite above with drawn dimensions (1..=6),
+// an SPD input built by construction instead of `RandomSDP`, and an
+// explicitly conditioning-derived tolerance. Entry magnitudes are bounded
+// to [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix};
+    use na::DMatrix;
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Oracle-independent reconstruction: for SPD A, the Cholesky factor
+    // satisfies L * L^T ≈ A.
+    //
+    // A = M^T M + n*I is symmetric positive definite by construction
+    // (lambda_min(A) >= n > 0), so `cholesky()` must succeed — the
+    // `expect` is part of the property, not a guard that can go vacuous.
+    //
+    // Tolerance: Cholesky on an SPD matrix is backward stable with no
+    // pivot-growth factor: ||L L^T - A|| <= c * n * eps * ||A|| (Higham
+    // ch. 10). c = 32 for headroom; floored at f64::MIN_POSITIVE (though
+    // here ||A|| >= n, so the floor is never active — kept for uniformity
+    // with the other linalg tolerance arguments).
+    #[hegel::test]
+    fn cholesky_reconstructs_spd_matrix(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        let m = draw_dmatrix(&tc, n, n);
+        let a = m.transpose() * &m + DMatrix::<f64>::identity(n, n) * (n as f64);
+
+        let l = a
+            .clone()
+            .cholesky()
+            .expect("A = M^T M + n*I is SPD by construction")
+            .unpack();
+
+        let tol = (32.0 * n as f64 * EPS * a.norm()).max(f64::MIN_POSITIVE);
+        let resid = (&l * l.transpose() - &a).norm();
+        assert!(
+            resid <= tol,
+            "||L L^T - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+}
