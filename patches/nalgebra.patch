index 3816013..63522fd 100644
--- a/tests/lib.rs
+++ b/tests/lib.rs
@@ -40,4 +40,78 @@ mod utils {
     pub fn is_sorted_descending<T: PartialOrd>(slice: &[T]) -> bool {
         slice.windows(2).all(|elts| elts[0] >= elts[1])
     }
+
+    // ------------------------------------------------------------------
+    // Helpers for the hegel property-based tests.
+    //
+    // Dimensions are drawn from 1..=6 and entries from [-100, 100]. The
+    // moderate entry range keeps the matrices well-scaled (||A||_F <= 600
+    // for the largest draws) so the conditioning-based tolerance arguments
+    // used in the individual tests (of the form c * n * eps * ||A||) remain
+    // meaningful; huge or subnormal entries would make norm-scaled
+    // tolerances either overflow or underflow. This bound protects the
+    // tests' error analysis, not any contract of nalgebra.
+    // ------------------------------------------------------------------
+
+    /// Draws a matrix dimension in `1..=6`.
+    pub fn draw_dim(tc: &hegel::TestCase) -> usize {
+        tc.draw(hegel::generators::integers::<usize>().min_value(1).max_value(6))
+    }
+
+    /// Draws an `nrows x ncols` dynamically-sized `f64` matrix with entries
+    /// in `[-100, 100]` (column-major fill; the layout does not matter for
+    /// any of the properties tested).
+    pub fn draw_dmatrix(tc: &hegel::TestCase, nrows: usize, ncols: usize) -> na::DMatrix<f64> {
+        let data: Vec<f64> = tc.draw(
+            hegel::generators::vecs(
+                hegel::generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0),
+            )
+            .min_size(nrows * ncols)
+            .max_size(nrows * ncols),
+        );
+        na::DMatrix::from_vec(nrows, ncols, data)
+    }
+
+    /// Overflow/underflow-safe upper bound on the Frobenius norm:
+    /// `max|a_ij| * sqrt(nrows * ncols)`.
+    ///
+    /// Used for the norm factor in tolerance formulas instead of
+    /// `Matrix::norm()`, because `norm()` computes `sqrt(sum of squares)`
+    /// without scaling and underflows to 0 for entries below ~1e-154 — a
+    /// norm-scaled tolerance built from it collapses to its floor and
+    /// produces false failures on subnormal-scale draws. Being an *upper*
+    /// bound only loosens the tolerance, by at most sqrt(nrows * ncols)
+    /// <= 6 for the shapes drawn here. This protects the tests' own
+    /// arithmetic, not any nalgebra contract.
+    pub fn fro_norm_upper<R, C, S>(m: &na::Matrix<f64, R, C, S>) -> f64
+    where
+        R: na::Dim,
+        C: na::Dim,
+        S: na::base::storage::Storage<f64, R, C>,
+    {
+        let amax = m.iter().fold(0.0_f64, |acc, x| acc.max(x.abs()));
+        amax * ((m.nrows() * m.ncols()) as f64).sqrt()
+    }
+
+    /// Zeroes out entries with magnitude below 1e-100.
+    ///
+    /// This excludes two KNOWN BUGS pinned by deterministic failing tests,
+    /// both triggered by tiny/subnormal entries:
+    ///   * `qr_reconstruction_known_failure_tiny_negative_pivot`
+    ///     (tests/linalg/qr.rs): Householder pivot columns whose
+    ///     norm-squared underflows (entries ~< 1e-162) get an inconsistent
+    ///     sign between Q and R;
+    ///   * `lu_reconstruction_known_failure_subnormal_pivot`
+    ///     (tests/linalg/lu.rs): LU pivots with |pivot| < 1/f64::MAX
+    ///     (~5.6e-309) have their reciprocal overflow to inf, poisoning the
+    ///     factors with NaN.
+    /// The 1e-100 cutoff is decades away from both trigger zones, so
+    /// shrinking cannot walk back into them, and cancellation among the
+    /// surviving entries (all 0 or >= 1e-100 in magnitude, whose ulps are
+    /// >= ~1e-116) cannot re-enter them mid-factorization.
+    pub fn zero_tiny_entries(a: na::DMatrix<f64>) -> na::DMatrix<f64> {
+        a.map(|x| if x.abs() < 1.0e-100 { 0.0 } else { x })
+    }
 }
