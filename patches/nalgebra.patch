+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest transposition tests above (which use fixed
+// 2x3 / 3x3 shapes) with drawn dimensions (1..=6). Entry magnitudes are
+// bounded to [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // (A^T)^T == A, exactly: transposition only moves entries, so no
+    // tolerance is involved.
+    #[hegel::test]
+    fn transpose_involution_dyn(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, cols);
+        assert_eq!(a.transpose().transpose(), a);
+    }
+
+    // (A * B)^T ≈ B^T * A^T.
+    //
+    // Mathematically exact; in floating point each side evaluates the same
+    // set of length-k dot products, but possibly accumulated in different
+    // orders (and, for larger dynamic matrices, through different gemm
+    // kernels). Reassociating a length-k sum perturbs it by at most
+    // (k-1) * eps * sum_j |a_ij b_jk| <= k * eps * ||A||_F * ||B||_F per
+    // entry, and the Frobenius norm over <= 6x6 entries adds a factor
+    // sqrt(rows*cols) <= 6; both are absorbed into c = 64:
+    // tol = 64 * k * eps * ||A|| * ||B||, floored at f64::MIN_POSITIVE.
+    #[hegel::test]
+    fn product_transpose_is_reversed_transpose_product(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let inner = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, inner);
+        let b = draw_dmatrix(&tc, inner, cols);
+
+        let lhs = (&a * &b).transpose();
+        let rhs = b.transpose() * a.transpose();
+
+        let tol =
+            (64.0 * inner as f64 * EPS * fro_norm_upper(&a) * fro_norm_upper(&b)).max(f64::MIN_POSITIVE);
+        let resid = (&lhs - &rhs).norm();
+        assert!(
+            resid <= tol,
+            "||(AB)^T - B^T A^T|| = {resid:e} > tol = {tol:e} for A = {a}, B = {b}"
+        );
+    }
+}
