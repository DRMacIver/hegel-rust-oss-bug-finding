--- a/src/box2d.rs
+++ b/src/box2d.rs
@@ -1045,4 +1045,125 @@ mod tests {
         assert_eq!(b.min, point2(1.0, 2.0));
         assert_eq!(b.size(), size2(5.0, 6.0));
     }
+
+    mod hegel_props {
+        use crate::default::Box2D;
+        use crate::point2;
+        use hegel::generators;
+
+        /// Coordinates from the full i32 range, widened to i64 so that the
+        /// arithmetic inside the library (`max - min`, `origin + size`)
+        /// cannot overflow while still exercising huge magnitudes.
+        fn draw_coord(tc: &hegel::TestCase) -> i64 {
+            tc.draw(generators::integers::<i32>()) as i64
+        }
+
+        /// A well-formed (min <= max) box, frequently degenerate
+        /// (zero width and/or zero height) to probe empty-box edge cases.
+        fn draw_box(tc: &hegel::TestCase) -> Box2D<i64> {
+            let x0 = draw_coord(tc);
+            let y0 = draw_coord(tc);
+            let x1 = if tc.draw(generators::booleans()) {
+                x0
+            } else {
+                draw_coord(tc)
+            };
+            let y1 = if tc.draw(generators::booleans()) {
+                y0
+            } else {
+                draw_coord(tc)
+            };
+            Box2D::new(
+                point2(x0.min(x1), y0.min(y1)),
+                point2(x0.max(x1), y0.max(y1)),
+            )
+        }
+
+        // Box2D -> Rect -> Box2D must be the exact identity for integer
+        // coordinates (`to_rect` stores min and max - min; `to_box2d`
+        // reconstructs origin and origin + size).
+        #[hegel::test]
+        fn hegel_box_rect_box_roundtrip_is_identity(tc: hegel::TestCase) {
+            // Arbitrary boxes, including negative (min > max) ones: the
+            // conversion is pure arithmetic and must roundtrip regardless.
+            let b: Box2D<i64> = Box2D::new(
+                point2(draw_coord(&tc), draw_coord(&tc)),
+                point2(draw_coord(&tc), draw_coord(&tc)),
+            );
+            assert_eq!(b.to_rect().to_box2d(), b);
+        }
+
+        // KNOWN FAILURE: real bug (inconsistent empty-box handling).
+        // `intersection()` documents "returning None if the boxes do not
+        // intersect", i.e. it must agree with `intersects()`. But for an
+        // empty (degenerate) box lying strictly inside another box,
+        // `intersects()` returns true (its strict comparisons all hold, e.g.
+        // a = [(0,0),(0,0)], b = [(-1,-1),(1,1)]) while `intersection()`
+        // returns None because the computed intersection is empty.
+        // Code paths: `Box2D::intersects()` vs `Box2D::intersection()` in
+        // src/box2d.rs.
+        #[hegel::test(test_cases = 300)]
+        fn hegel_intersects_iff_intersection_is_some(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            assert_eq!(
+                a.intersects(&b),
+                a.intersection(&b).is_some(),
+                "intersects() and intersection() disagree for {a:?} and {b:?}"
+            );
+        }
+
+        // When an intersection exists it must be non-empty and contained in
+        // both operands.
+        #[hegel::test]
+        fn hegel_intersection_is_contained_in_both(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            if let Some(i) = a.intersection(&b) {
+                assert!(!i.is_empty(), "intersection {i:?} is empty");
+                assert!(
+                    a.contains_box(&i) && b.contains_box(&i),
+                    "intersection {i:?} of {a:?} and {b:?} is not contained in both"
+                );
+            }
+        }
+
+        // The union of two boxes must contain both of them (`contains_box`
+        // is documented to return true when the probed box is empty, and
+        // `union` is documented to return the other box when one is empty).
+        #[hegel::test]
+        fn hegel_union_contains_both_operands(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            let u = a.union(&b);
+            assert!(
+                u.contains_box(&a) && u.contains_box(&b),
+                "union {u:?} does not contain both {a:?} and {b:?}"
+            );
+        }
+
+        // Documented on `from_points`: "The top/bottom/left/right-most
+        // points are exactly on the box's edges", and all input points are
+        // contained "when probed with contains_inclusive".
+        #[hegel::test]
+        fn hegel_from_points_contains_all_points_inclusive(tc: hegel::TestCase) {
+            // NaN coordinates are excluded: comparisons against NaN are
+            // meaningless and the min/max scan cannot order them. Infinities
+            // are kept.
+            let points: Vec<crate::default::Point2D<f64>> =
+                tc.draw(generators::vecs(hegel::compose!(|tc| {
+                    point2(
+                        tc.draw(generators::floats::<f64>().allow_nan(false)),
+                        tc.draw(generators::floats::<f64>().allow_nan(false)),
+                    )
+                })));
+            let b = Box2D::from_points(&points);
+            for p in &points {
+                assert!(
+                    b.contains_inclusive(*p),
+                    "{b:?} from_points does not contain input point {p:?}"
+                );
+            }
+        }
+    }
 }
