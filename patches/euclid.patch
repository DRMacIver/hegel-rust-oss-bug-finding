     }
+
+    mod hegel_props {
+        use crate::default;
+        use crate::point2;
+        use hegel::generators;
+
+        type DMat = default::Transform2D<f64>;
+
+        /// Draws a well-conditioned invertible transform.
+        ///
+        /// Components come from a wide-but-moderate range and the determinant
+        /// is required to be large relative to the linear part, so that a
+        /// fixed float tolerance is meaningful. Near-singular transforms have
+        /// unboundedly ill-conditioned inverses; excluding them protects the
+        /// test's tolerance, not a library contract.
+        fn draw_invertible(tc: &hegel::TestCase) -> DMat {
+            let c = || {
+                generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0)
+            };
+            let m = DMat::new(
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+            );
+            let s = m.m11.abs().max(m.m12.abs()).max(m.m21.abs()).max(m.m22.abs());
+            tc.assume(s > 1e-3);
+            tc.assume(m.determinant().abs() > 1e-3 * s * s);
+            m
+        }
+
+        // `inverse()` documents "Returns the inverse transform if possible";
+        // composing a transform with its inverse must approximate the
+        // identity transform.
+        #[hegel::test]
+        fn hegel_then_inverse_approximates_identity(tc: hegel::TestCase) {
+            let m = draw_invertible(&tc);
+            let inv = m.inverse().expect("well-conditioned transform must be invertible");
+            let id = m.then(&inv);
+            assert!(
+                id.approx_eq_eps(&DMat::identity(), &1e-6),
+                "{m:?}.then(inverse) = {id:?} is not approximately the identity"
+            );
+        }
+
+        // Transforming a point and then applying the inverse transform must
+        // approximately return the original point.
+        #[hegel::test]
+        fn hegel_transform_point_inverse_roundtrip(tc: hegel::TestCase) {
+            let m = draw_invertible(&tc);
+            let inv = m.inverse().expect("well-conditioned transform must be invertible");
+            let coord = || {
+                generators::floats::<f64>()
+                    .min_value(-1e4)
+                    .max_value(1e4)
+            };
+            let p: default::Point2D<f64> = point2(tc.draw(coord()), tc.draw(coord()));
+            let q = inv.transform_point(m.transform_point(p));
+            let tol = 1e-6 * (1.0 + p.x.abs().max(p.y.abs()));
+            assert!(
+                (q.x - p.x).abs() <= tol && (q.y - p.y).abs() <= tol,
+                "roundtrip of {p:?} through {m:?} gave {q:?}"
+            );
+        }
+    }
