+
+// ===================================================================
+// Hegel property-based tests
+// ===================================================================
+
+/// On the plain-regex subset, fancy-regex's `captures` must agree with the
+/// `regex` crate on the presence of a match, the number of groups, and the
+/// exact span of every group — including with the backtracking VM forced
+/// via a no-op lookahead prefix (which adds no groups).
+#[hegel::test]
+fn prop_plain_subset_captures_agree_with_regex_crate(tc: hegel::TestCase) {
+    let pattern = common::draw_plain_pattern(&tc, true);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+
+    let oracle = match regex::Regex::new(&pattern) {
+        Ok(o) => o,
+        Err(_) => tc.reject(),
+    };
+    let fancy = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("fancy-regex rejected plain pattern {:?}: {:?}", pattern, e)
+    });
+
+    let expected: Option<Vec<Option<(usize, usize)>>> = oracle.captures(&hay).map(|caps| {
+        (0..caps.len())
+            .map(|i| caps.get(i).map(|m| (m.start(), m.end())))
+            .collect()
+    });
+
+    let collect_fancy = |caps: Option<fancy_regex::Captures<str>>| {
+        caps.map(|caps| {
+            (0..caps.len())
+                .map(|i| caps.get(i).map(|m| (m.start(), m.end())))
+                .collect::<Vec<_>>()
+        })
+    };
+
+    let got = collect_fancy(fancy.captures(hay.as_str()).unwrap());
+    assert_eq!(
+        got, expected,
+        "captures disagree with regex crate for {:?} on {:?}",
+        pattern, hay
+    );
+
+    let vm = fancy_regex::Regex::new(&format!(r"(?=[\s\S]?){}", pattern)).unwrap();
+    match vm.captures(hay.as_str()) {
+        Ok(caps) => {
+            let got = collect_fancy(caps);
+            assert_eq!(
+                got.is_some(),
+                expected.is_some(),
+                "VM-path captures presence disagrees with regex crate for {:?} on {:?}",
+                pattern,
+                hay
+            );
+            if let (Some(got), Some(expected)) = (got, &expected) {
+                // Group-count comparison is intentionally one-sided here:
+                // regex-syntax *elides* groups repeated `{0}` (e.g. `(){0}`
+                // reports 1 group), while fancy-regex's own parser keeps them
+                // as never-matching groups on the VM path. Extra VM-side
+                // groups must therefore be unset. See HEGEL_REPORT.md and
+                // prop_capture_names_never_panics_known_failure for the
+                // panic this same elision causes on the delegation path.
+                assert!(
+                    got.len() >= expected.len(),
+                    "VM-path captures dropped groups for {:?} on {:?}: {:?} vs {:?}",
+                    pattern,
+                    hay,
+                    got,
+                    expected
+                );
+                for (i, want) in expected.iter().enumerate() {
+                    assert_eq!(
+                        got[i], *want,
+                        "VM-path capture group {} disagrees with regex crate for {:?} on {:?}",
+                        i, pattern, hay
+                    );
+                }
+                for (i, extra) in got.iter().enumerate().skip(expected.len()) {
+                    assert_eq!(
+                        *extra, None,
+                        "VM-path extra capture group {} is set for {:?} on {:?}",
+                        i, pattern, hay
+                    );
+                }
+            }
+        }
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => {}
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    }
+}
+
+/// KNOWN FAILURE — pins a real bug in fancy-regex; deliberately left failing.
+///
+/// `Regex::capture_names()` panics with an index-out-of-bounds for any
+/// *delegated* pattern in which a named group is repeated `{0}` times.
+/// Root cause: the delegated `regex` program elides `(?<n>a){0}` entirely,
+/// so `captures_len()` is 1, but fancy-regex's own parse recorded
+/// `named_groups["n"] == 1`, and `capture_names()` writes `names[1]` into a
+/// `Vec` of length 1 (src/lib.rs:1643).
+///
+/// Minimal reproducer:
+///     fancy_regex::Regex::new("(?<n>a){0}").unwrap().capture_names();
+///
+/// The generator below constructs the failing shape directly so the test
+/// fails deterministically on every run.
+#[hegel::test]
+fn prop_capture_names_never_panics_known_failure(tc: hegel::TestCase) {
+    use hegel::generators;
+    let name: String = tc.draw(generators::from_regex("[a-z][a-z0-9]{0,5}"));
+    let body: String = tc.draw(generators::from_regex("[a-z]{1,3}"));
+    let pattern = format!("(?<{}>{}){{0}}", name, body);
+    let re = fancy_regex::Regex::new(&pattern)
+        .unwrap_or_else(|e| panic!("pattern {:?} failed to compile: {:?}", pattern, e));
+    // BUG: this panics (index out of bounds) instead of returning the names.
+    let _names: Vec<Option<&str>> = re.capture_names().collect();
+}
+
+/// For arbitrary fancy patterns, group 0 of `captures` must have exactly the
+/// span reported by `find`.
+#[hegel::test]
+fn prop_captures_group0_equals_find(tc: hegel::TestCase) {
+    let pattern = common::draw_fancy_pattern(&tc);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+    let re = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("generated fancy pattern must compile: {:?}: {:?}", pattern, e)
+    });
+
+    let find = match re.find(hay.as_str()) {
+        Ok(m) => m.map(|m| (m.start(), m.end())),
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => {
+            tc.reject()
+        }
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    };
+    let group0 = match re.captures(hay.as_str()) {
+        Ok(caps) => caps.and_then(|c| c.get(0)).map(|m| (m.start(), m.end())),
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => {
+            tc.reject()
+        }
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    };
+    assert_eq!(
+        group0, find,
+        "captures group 0 != find for {:?} on {:?}",
+        pattern, hay
+    );
+}
