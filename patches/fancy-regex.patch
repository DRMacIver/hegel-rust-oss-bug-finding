+// ===================================================================
+// Hegel property-based tests
+// ===================================================================
+
+/// On the plain-regex subset (no lookaround, no backreferences), fancy-regex
+/// must agree with the `regex` crate about whether a haystack matches — both
+/// on the delegation fast path and when the backtracking VM is forced by
+/// prefixing a no-op lookahead.
+#[hegel::test]
+fn prop_plain_subset_is_match_agrees_with_regex_crate(tc: hegel::TestCase) {
+    let pattern = common::draw_plain_pattern(&tc, true);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+
+    let oracle = match regex::Regex::new(&pattern) {
+        Ok(o) => o,
+        // e.g. compiled-size limit exceeded — rare, and not this property.
+        Err(_) => tc.reject(),
+    };
+    let fancy = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("fancy-regex rejected plain pattern {:?}: {:?}", pattern, e)
+    });
+
+    let expected = oracle.is_match(&hay);
+    assert_eq!(
+        fancy.is_match(hay.as_str()).unwrap(),
+        expected,
+        "is_match disagrees with regex crate for {:?} on {:?}",
+        pattern,
+        hay
+    );
+
+    // Force the backtracking VM: `(?=[\s\S]?)` is a zero-width, always-true,
+    // group-free lookahead, so semantics must be unchanged.
+    let vm = fancy_regex::Regex::new(&format!(r"(?=[\s\S]?){}", pattern)).unwrap();
+    match vm.is_match(hay.as_str()) {
+        Ok(got) => assert_eq!(
+            got, expected,
+            "VM-path is_match disagrees with regex crate for {:?} on {:?}",
+            pattern, hay
+        ),
+        // The VM may legitimately hit the documented backtrack limit on
+        // catastrophic generated patterns; that is covered by
+        // prop_backtrack_limit_errors_instead_of_hanging.
+        Err(fancy_regex::Error::RuntimeError(RuntimeError::BacktrackLimitExceeded)) => {}
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    }
+}
+
+/// Compiling an arbitrary pattern string must never panic — it either
+/// succeeds or returns an error. Supplements fuzz/fuzz_targets/fuzz_parser.rs
+/// with near-valid patterns (a valid generated pattern with random edits),
+/// which reach much deeper than uniformly random text.
+#[hegel::test]
+fn prop_compile_never_panics(tc: hegel::TestCase) {
+    use hegel::generators;
+    let mut pattern = if tc.draw(generators::booleans()) {
+        tc.draw(generators::text().max_size(60))
+    } else {
+        common::draw_fancy_pattern(&tc)
+    };
+    // Apply a few random mutations to produce near-valid patterns.
+    let edits = tc.draw(generators::integers::<u8>().max_value(3));
+    for _ in 0..edits {
+        let boundaries: Vec<usize> = pattern
+            .char_indices()
+            .map(|(i, _)| i)
+            .chain(std::iter::once(pattern.len()))
+            .collect();
+        let pos = boundaries[tc
+            .draw(generators::integers::<usize>().max_value(boundaries.len() - 1))];
+        let c = tc.draw(generators::sampled_from(
+            r"(){}[]\*+?|^$<>!=:kgP0123456789,-&~'".chars().collect::<Vec<char>>(),
+        ));
+        pattern.insert(pos, c);
+    }
+    tc.note(&format!("pattern={:?}", pattern));
+    drop(fancy_regex::Regex::new(&pattern));
+    drop(fancy_regex::Expr::parse_tree(&pattern));
+}
+
+/// Matching with a successfully compiled pattern must never panic on any
+/// haystack: every entry point returns Ok or a runtime error.
+#[hegel::test]
+fn prop_match_never_panics(tc: hegel::TestCase) {
+    use hegel::generators;
+    let pattern = if tc.draw(generators::booleans()) {
+        common::draw_fancy_pattern(&tc)
+    } else {
+        tc.draw(generators::text().max_size(40))
+    };
+    let hay = common::draw_haystack(&tc);
+    // A small limit keeps catastrophic patterns fast and exercises the
+    // runtime-error paths; the default limit is exercised elsewhere.
+    let limit = tc.draw(generators::sampled_from(vec![1usize, 1_000, 100_000]));
+    tc.note(&format!("pattern={:?} hay={:?} limit={}", pattern, hay, limit));
+    if let Ok(re) = RegexBuilder::new(&pattern).backtrack_limit(limit).build() {
+        drop(re.is_match(hay.as_str()));
+        drop(re.find(hay.as_str()));
+        drop(re.captures(hay.as_str()));
+        for item in re.find_iter(hay.as_str()) {
+            if item.is_err() {
+                break;
+            }
+        }
+    }
+}
+
+/// Catastrophic backtracking must hit the documented backtrack limit and
+/// return `RuntimeError::BacktrackLimitExceeded` instead of hanging.
+#[hegel::test]
+fn prop_backtrack_limit_errors_instead_of_hanging(tc: hegel::TestCase) {
+    use hegel::generators;
+    let c = tc.draw(generators::sampled_from(vec!['a', 'x', '0']));
+    let tail = if c == '0' { 'b' } else { '1' };
+    // Classic exponential pattern; the atomic group keeps it on the
+    // backtracking VM (a plain pattern would be delegated to `regex`).
+    let pattern = format!("({c}+{c}+)+(?>{tail})");
+    let n = tc.draw(generators::integers::<usize>().min_value(12).max_value(40));
+    let hay: String = std::iter::repeat(c).take(n).collect();
+    let re = RegexBuilder::new(&pattern)
+        .backtrack_limit(1_000)
+        .seek(false)
+        .build()
+        .unwrap();
+    match re.is_match(&hay) {
+        Err(Error::RuntimeError(RuntimeError::BacktrackLimitExceeded)) => {}
+        other => panic!(
+            "expected BacktrackLimitExceeded for {:?} on {:?}, got {:?}",
+            pattern, hay, other
+        ),
+    }
+}
+
+/// `escape` round-trip: escaping arbitrary text yields a pattern that
+/// compiles and matches exactly that text, in full, at position 0.
+#[hegel::test]
+fn prop_escape_then_match_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+    let text: String = tc.draw(generators::text().max_size(30));
+    let pattern = fancy_regex::escape(&text);
+    let re = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("escape({:?}) produced invalid pattern {:?}: {:?}", text, pattern, e)
+    });
+    let m = re
+        .find(text.as_str())
+        .unwrap()
+        .unwrap_or_else(|| panic!("escape({:?}) = {:?} failed to match", text, pattern));
+    assert_eq!((m.start(), m.end()), (0, text.len()));
+}
