+    'a', 'b', 'c', 'd', 'x', 'A', 'B', '0', '1', '9', ' ', '.', '+', 'é', '\n',
+];
+
+#[allow(dead_code)]
+const LITERAL_CHARS: &[char] = &['a', 'b', 'c', 'd', 'x', 'A', '0', '1', ' ', '.', '+', 'é', '\n'];
+
+/// Draw an integer in `0..=max` without recording it individually (the
+/// assembled pattern/haystack is what matters in counterexample output).
+#[allow(dead_code)]
+fn choice(tc: &hegel::TestCase, max: u32) -> u32 {
+    tc.draw_silent(generators::integers::<u32>().max_value(max))
+}
+
+#[allow(dead_code)]
+fn coin(tc: &hegel::TestCase) -> bool {
+    tc.draw_silent(generators::booleans())
+}
+
+#[allow(dead_code)]
+fn sample_char(tc: &hegel::TestCase, chars: &[char]) -> char {
+    chars[choice(tc, (chars.len() - 1) as u32) as usize]
+}
+
+#[allow(dead_code)]
+fn sample_str(tc: &hegel::TestCase, options: &[&str]) -> String {
+    options[choice(tc, (options.len() - 1) as u32) as usize].to_string()
+}
+
+/// A quantifier valid in both engines. Counts kept small so patterns stay
+/// cheap to compile; this bounds the *pattern*, not the code under test.
+#[allow(dead_code)]
+fn draw_quantifier(tc: &hegel::TestCase) -> String {
+    let mut q = match choice(tc, 5) {
+        0 => "*".to_string(),
+        1 => "+".to_string(),
+        2 => "?".to_string(),
+        3 => format!("{{{}}}", choice(tc, 3)),
+        4 => {
+            let m = choice(tc, 3);
+            format!("{{{},{}}}", m, m + choice(tc, 3))
+        }
+        _ => format!("{{{},}}", choice(tc, 3)),
+    };
+    if coin(tc) {
+        q.push('?'); // lazy variant
+    }
+    q
+}
+
+#[allow(dead_code)]
+fn draw_char_class(tc: &hegel::TestCase) -> String {
+    let mut s = String::from("[");
+    if coin(tc) {
