+// ===================================================================
+// Hegel property-based tests
+// ===================================================================
+
+/// On the plain-regex subset, fancy-regex's `find` must return exactly the
+/// same span as the `regex` crate — on the delegation fast path and with the
+/// backtracking VM forced via a no-op lookahead prefix.
+#[hegel::test]
+fn prop_plain_subset_find_agrees_with_regex_crate(tc: hegel::TestCase) {
+    let pattern = common::draw_plain_pattern(&tc, true);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+
+    let oracle = match regex::Regex::new(&pattern) {
+        Ok(o) => o,
+        Err(_) => tc.reject(),
+    };
+    let fancy = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("fancy-regex rejected plain pattern {:?}: {:?}", pattern, e)
+    });
+
+    let expected = oracle.find(&hay).map(|m| (m.start(), m.end()));
+    let got = fancy
+        .find(hay.as_str())
+        .unwrap()
+        .map(|m| (m.start(), m.end()));
+    assert_eq!(
+        got, expected,
+        "find disagrees with regex crate for {:?} on {:?}",
+        pattern, hay
+    );
+
+    let vm = fancy_regex::Regex::new(&format!(r"(?=[\s\S]?){}", pattern)).unwrap();
+    match vm.find(hay.as_str()) {
+        Ok(m) => assert_eq!(
+            m.map(|m| (m.start(), m.end())),
+            expected,
+            "VM-path find disagrees with regex crate for {:?} on {:?}",
+            pattern,
+            hay
+        ),
+        Err(fancy_regex::Error::RuntimeError(
+            fancy_regex::RuntimeError::BacktrackLimitExceeded,
+        )) => {}
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    }
+}
+
+/// `find_iter` (with full fancy features in play) must yield spans that are
+/// in bounds, on char boundaries, non-overlapping and in increasing order,
+/// and its first item must equal `find`.
+#[hegel::test]
+fn prop_find_iter_spans_wellformed(tc: hegel::TestCase) {
+    let pattern = common::draw_fancy_pattern(&tc);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+    let re = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("generated fancy pattern must compile: {:?}: {:?}", pattern, e)
+    });
+
+    let mut prev_end = 0usize;
+    let mut prev_span: Option<(usize, usize)> = None;
+    let mut first = true;
+    for item in re.find_iter(hay.as_str()) {
+        let m = match item {
+            Ok(m) => m,
+            Err(fancy_regex::Error::RuntimeError(
+                fancy_regex::RuntimeError::BacktrackLimitExceeded,
+            )) => break,
+            Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+        };
+        let span = (m.start(), m.end());
+        assert!(m.start() <= m.end(), "reversed span {:?}", span);
+        assert!(m.end() <= hay.len(), "span {:?} out of bounds", span);
+        assert!(
+            hay.is_char_boundary(m.start()) && hay.is_char_boundary(m.end()),
+            "span {:?} not on char boundaries in {:?}",
+            span,
+            hay
+        );
+        assert!(
+            m.start() >= prev_end,
+            "span {:?} overlaps or precedes previous match (prev_end={}) for {:?} on {:?}",
+            span,
+            prev_end,
+            pattern,
+            hay
+        );
+        assert_ne!(
+            Some(span),
+            prev_span,
+            "find_iter yielded the same span twice for {:?} on {:?}",
+            pattern,
+            hay
+        );
+        if first {
+            let f = re
+                .find(hay.as_str())
+                .unwrap()
+                .map(|m| (m.start(), m.end()));
+            assert_eq!(
+                Some(span),
+                f,
+                "first find_iter item != find for {:?} on {:?}",
+                pattern,
+                hay
+            );
+            first = false;
+        }
+        prev_end = m.end();
+        prev_span = Some(span);
+    }
+}
+
+/// For plain patterns with no anchors or word boundaries, matching is
+/// context-free: the matched substring, taken alone, must re-match the
+/// pattern anchored at both ends.
+#[hegel::test]
+fn prop_matched_text_rematches_anchored(tc: hegel::TestCase) {
+    let pattern = common::draw_plain_pattern(&tc, false);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+    let re = match fancy_regex::Regex::new(&pattern) {
+        Ok(r) => r,
+        Err(_) => tc.reject(), // e.g. size limit — rare
+    };
+    let m = match re.find(hay.as_str()).unwrap() {
+        Some(m) => m,
+        None => return,
+    };
+    let anchored = fancy_regex::Regex::new(&format!("^(?:{})$", pattern)).unwrap();
+    assert!(
+        anchored.is_match(m.as_str()).unwrap(),
+        "matched text {:?} does not re-match {:?} anchored (full match of {:?})",
+        m.as_str(),
+        pattern,
+        hay
+    );
+}
