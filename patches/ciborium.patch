+                -(1i128 << 64),
+                -(1i128 << 64) - 1,
+                1i128 << 64,
+            ]),
+        ));
+        let mut bytes = Vec::new();
+        into_writer(&x, &mut bytes).unwrap();
+        let back: i128 = from_reader(bytes.as_slice()).unwrap();
+        assert_eq!(x, back, "encoded as {bytes:x?}");
+    }
+
+    /// Any `u128` roundtrips through CBOR (bignum tag 2 above `u64::MAX`).
+    #[hegel::test]
+    fn u128_bytes_roundtrip(tc: hegel::TestCase) {
+        let x = tc.draw(hegel::one_of!(
+            generators::integers::<u128>(),
+            generators::sampled_from(vec![
+                0u128,
+                23,
+                24,
+                u64::MAX as u128,
+                u64::MAX as u128 + 1,
+                u128::MAX,
+            ]),
+        ));
+        let mut bytes = Vec::new();
+        into_writer(&x, &mut bytes).unwrap();
+        let back: u128 = from_reader(bytes.as_slice()).unwrap();
+        assert_eq!(x, back, "encoded as {bytes:x?}");
+    }
+
+    /// Integers are always serialized to the smallest lossless width
+    /// (crate-level "Always Serialize Numeric Values to the Smallest Size"
+    /// design promise), with major type 0 for non-negative and 1 for negative.
+    #[hegel::test]
+    fn integer_encoding_is_smallest(tc: hegel::TestCase) {
+        let i = draw_integer(&tc);
+        let x = i128::from(i);
+        let bytes = enc(&Value::Integer(i));
+
+        // The wire magnitude: x for non-negative, -1 - x for negative.
+        let magnitude = if x < 0 { (-1 - x) as u128 } else { x as u128 };
+        let expected = 1 + match magnitude {
+            0..=23 => 0,
+            24..=0xff => 1,
+            0x100..=0xffff => 2,
+            0x1_0000..=0xffff_ffff => 4,
+            _ => 8,
+        };
+        assert_eq!(bytes.len(), expected, "{x} encoded as {bytes:x?}");
+        assert_eq!(bytes[0] >> 5, u8::from(x < 0), "major type of {bytes:x?}");
+    }
+
+    /// Floats are encoded at a smaller width only when lossless, and always
+    /// decode back to the exact same bits (crate-level design promise: "This
+    /// coercion is **always** lossless ... only ... if coercion back to the
+    /// original size has the same raw bits").
+    #[hegel::test]
+    fn float_encoding_is_lossless_and_small(tc: hegel::TestCase) {
+        let f = tc.draw(hegel::one_of!(
+            generators::floats::<f64>(),
+            generators::integers::<u64>().map(f64::from_bits),
+            generators::sampled_from(vec![
+                0.0f64,
+                -0.0,
+                f64::MIN_POSITIVE,
+                f64::MAX,
+                5e-324,
+                65504.0, // f16::MAX
+                65536.0,
+                5.960464477539063e-8, // smallest positive f16
+            ]),
+        ));
+        let bytes = enc(&Value::Float(f));
+
+        // f16 is a subset of f32, so any f16-encodable value is f32-lossless.
+        let f32_lossless = ((f as f32) as f64).to_bits() == f.to_bits();
+        if f32_lossless {
+            assert!(
+                bytes.len() == 3 || bytes.len() == 5,
+                "{f:?} ({:#x}) encoded as {bytes:x?}",
+                f.to_bits()
+            );
+        } else {
+            assert_eq!(
+                bytes.len(),
+                9,
+                "{f:?} ({:#x}) encoded as {bytes:x?}",
+                f.to_bits()
+            );
+        }
+
+        let back: Value = from_reader(bytes.as_slice()).unwrap();
+        match back {
+            Value::Float(g) => assert_eq!(f.to_bits(), g.to_bits(), "{f:?} -> {bytes:x?} -> {g:?}"),
+            other => panic!("decoded to non-float {other:?}"),
+        }
+    }
+}
diff --git a/ciborium/tests/common/mod.rs b/ciborium/tests/common/mod.rs
new file mode 100644
index 0000000..31bc64a
--- /dev/null
+++ b/ciborium/tests/common/mod.rs
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! Shared hegel generators and helpers for the ciborium property-based tests.
+
+#![allow(dead_code)] // not every test binary uses every helper
+
+use ciborium::value::{Integer, Value};
+use hegel::generators::{self, BoxedGenerator, Generator};
+use std::collections::HashSet;
+
+/// Configuration for [`arbitrary_values`].
+#[derive(Clone, Copy)]
+pub struct ValueCfg {
+    /// Allow tags 2/3 (bignums). ciborium deliberately decodes wire tags 2/3
+    /// into `Value::Integer` (or a normalized bignum) rather than a `Value::Tag`
+    /// — see the "Not In RFC" cases in tests/codec.rs — so encode->decode
+    /// roundtrip properties must exclude them.
+    pub bignum_tags: bool,
+    /// Allow `Value::Tag` as a map key. `cmp_value` orders two tags by tag
+    /// number instead of the documented serialized-byte order (see the
+    /// KNOWN FAILURE test in tests/canonical.rs), which makes sorting map
+    /// keys containing tags unreliable; canonical tests exclude tag keys.
+    pub tag_keys: bool,
+    /// Deduplicate map keys (by encoded bytes).
+    pub unique_keys: bool,
+}
+
+/// Everything allowed.
+pub const FULL: ValueCfg = ValueCfg {
+    bignum_tags: true,
+    tag_keys: true,
+    unique_keys: false,
+};
+
+/// Encode a `Value` to CBOR bytes.
+pub fn enc(v: &Value) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    ciborium::ser::into_writer(v, &mut bytes).unwrap();
+    bytes
+}
+
+/// Structural equality on `Value` with floats compared bitwise, so that
+/// NaN == NaN (with the same payload). The derived `PartialEq` treats
+/// `Float(NaN) != Float(NaN)`, which is a comparison artifact rather than a
+/// roundtrip failure.
+pub fn eqv(a: &Value, b: &Value) -> bool {
+    match (a, b) {
+        (Value::Float(x), Value::Float(y)) => x.to_bits() == y.to_bits(),
+        (Value::Array(xs), Value::Array(ys)) => {
+            xs.len() == ys.len() && xs.iter().zip(ys).all(|(x, y)| eqv(x, y))
+        }
+        (Value::Map(xs), Value::Map(ys)) => {
+            xs.len() == ys.len()
+                && xs
+                    .iter()
+                    .zip(ys)
+                    .all(|((xk, xv), (yk, yv))| eqv(xk, yk) && eqv(xv, yv))
+        }
+        (Value::Tag(t, x), Value::Tag(u, y)) => t == u && eqv(x, y),
+        _ => a == b,
+    }
+}
+
+/// Draw an `Integer` covering the full encodable range `[-2^64, 2^64 - 1]`,
+/// boosting the encoding-width boundaries where header-size selection changes.
+pub fn draw_integer(tc: &hegel::TestCase) -> Integer {
+    const MIN: i128 = -(1i128 << 64);
+    const MAX: i128 = (1i128 << 64) - 1;
+    let x = tc.draw(hegel::one_of!(
+        generators::integers::<i128>().min_value(MIN).max_value(MAX),
+        generators::integers::<i64>().map(|x| x as i128),
+        generators::sampled_from(vec![
+            MIN,
+            MIN + 1,
+            -(1i128 << 63) - 1,
+            i64::MIN as i128,
+            -65537,
+            -65536,
+            -257,
+            -256,
+            -25,
+            -24,
+            -1,
+            0,
+            1,
+            23,
+            24,
+            255,
+            256,
+            65535,
+            65536,
+            (1i128 << 32) - 1,
+            1i128 << 32,
+            i64::MAX as i128,
+            1i128 << 63,
+            MAX - 1,
+            MAX,
+        ]),
+    ));
+    Integer::try_from(x).unwrap()
+}
+
+/// Draw an arbitrary f64, including NaNs with arbitrary payloads.
+pub fn draw_float(tc: &hegel::TestCase) -> f64 {
+    tc.draw(hegel::one_of!(
+        generators::floats::<f64>(),
+        // Arbitrary bit patterns: exercises subnormals, signaling NaNs and
+        // NaN payloads that do not survive an f64 -> f32 -> f64 conversion.
+        generators::integers::<u64>().map(f64::from_bits),
+    ))
+}
+
+fn draw_tag(tc: &hegel::TestCase, bignum_tags: bool) -> u64 {
+    let t = tc.draw(hegel::one_of!(
+        generators::integers::<u64>(),
+        generators::sampled_from(vec![0u64, 1, 4, 23, 24, 255, 256, 65535, 65536, u64::MAX]),
+    ));
+    if !bignum_tags && (t == 2 || t == 3) {
+        // Shift off the bignum tags without rejection sampling.
+        t + 4
+    } else {
+        t
+    }
+}
+
+/// Recursive generator for arbitrary CBOR `Value`s (up to `depth` levels of
+/// nesting via arrays, maps and tags).
+pub fn arbitrary_values(depth: u32, cfg: ValueCfg) -> BoxedGenerator<'static, Value> {
+    hegel::compose!(|tc| {
+        let max_kind = if depth == 0 { 5 } else { 8 };
+        match tc.draw(generators::integers::<u8>().max_value(max_kind)) {
+            0 => Value::Integer(draw_integer(&tc)),
+            1 => Value::Bytes(tc.draw(generators::binary())),
+            2 => Value::Float(draw_float(&tc)),
+            3 => Value::Text(tc.draw(generators::text())),
+            4 => Value::Bool(tc.draw(generators::booleans())),
+            5 => Value::Null,
+            6 => Value::Tag(
+                draw_tag(&tc, cfg.bignum_tags),
+                Box::new(tc.draw(arbitrary_values(depth - 1, cfg))),
+            ),
+            7 => Value::Array(
+                tc.draw(generators::vecs(arbitrary_values(depth - 1, cfg)).max_size(4)),
+            ),
+            _ => {
+                let n = tc.draw(generators::integers::<usize>().max_value(4));
+                let mut entries = Vec::with_capacity(n);
+                for _ in 0..n {
+                    let mut k = tc.draw(arbitrary_values(depth - 1, cfg));
+                    if !cfg.tag_keys {
+                        while let Value::Tag(_, inner) = k {
+                            k = *inner;
+                        }
+                    }
+                    let v = tc.draw(arbitrary_values(depth - 1, cfg));
+                    entries.push((k, v));
+                }
+                if cfg.unique_keys {
+                    let mut seen = HashSet::new();
+                    entries.retain(|(k, _)| seen.insert(enc(k)));
+                }
+                Value::Map(entries)
+            }
+        }
+    })
+    .boxed()
+}
diff --git a/ciborium/tests/error.rs b/ciborium/tests/error.rs
index 2bc42d9..1bc6961 100644
--- a/ciborium/tests/error.rs
+++ b/ciborium/tests/error.rs
@@ -185,3 +185,64 @@ fn test_long_utf8_deserialization() {
     into_writer(&s, &mut v).unwrap();
     let _: String = from_reader(&*v).unwrap();
 }
+
+mod common;
+
+/// Property-based tests (hegel).
+mod props {
+    use super::common::{arbitrary_values, enc, eqv, ValueCfg, FULL};
+    use ciborium::{de::from_reader, value::Value};
+    use hegel::generators;
+    use std::collections::HashMap;
+
+    /// Decoding arbitrary bytes never panics, whatever the target type
+    /// (parse robustness; same property as the fork-based fuzz test in
+    /// tests/fuzz.rs, but with shrinking).
+    #[hegel::test]
+    fn decoding_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let bytes: Vec<u8> = tc.draw(generators::binary().min_size(n));
+        match tc.draw(generators::integers::<u8>().max_value(5)) {
+            0 => drop(from_reader::<Value, _>(bytes.as_slice())),
+            1 => drop(from_reader::<String, _>(bytes.as_slice())),
+            2 => drop(from_reader::<Vec<i64>, _>(bytes.as_slice())),
+            3 => drop(from_reader::<HashMap<String, u64>, _>(bytes.as_slice())),
+            4 => drop(from_reader::<i128, _>(bytes.as_slice())),
+            _ => drop(from_reader::<(bool, f64, char), _>(bytes.as_slice())),
+        }
+    }
+
+    /// CBOR is self-delimiting, so no strict prefix of a valid encoding is a
+    /// valid encoding: decoding a truncation must fail (and not panic).
+    /// Evidence: all the truncated-input rstest cases above expect errors.
+    #[hegel::test]
+    fn strict_prefix_of_valid_encoding_is_an_error(tc: hegel::TestCase) {
+        let v = tc.draw(arbitrary_values(3, FULL));
+        let bytes = enc(&v);
+        let cut = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+        let result = from_reader::<Value, _>(&bytes[..cut]);
+        assert!(
+            result.is_err(),
+            "decoding {cut}-byte prefix of {bytes:x?} succeeded: {result:?}"
+        );
+    }
+
+    /// `from_reader` consumes exactly one item from the reader: bytes after a
+    /// complete encoding do not affect the decoded value.
+    #[hegel::test]
+    fn trailing_bytes_after_one_item_are_ignored(tc: hegel::TestCase) {
+        // Bignum tags excluded: they decode to a different (normalized) Value,
+        // which is the roundtrip caveat covered in tests/codec.rs, not a
+        // trailing-bytes issue.
+        let cfg = ValueCfg {
+            bignum_tags: false,
+            tag_keys: true,
+            unique_keys: false,
+        };
+        let v = tc.draw(arbitrary_values(3, cfg));
+        let mut bytes = enc(&v);
+        bytes.extend(tc.draw(generators::binary()));
+        let back: Value = from_reader(bytes.as_slice()).unwrap();
+        assert!(eqv(&v, &back), "{v:?} -> {bytes:x?} -> {back:?}");
+    }
+}
