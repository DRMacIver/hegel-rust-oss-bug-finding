+/// Hegel property based tests operating on complete packets.
+mod hegel_props {
+    use super::*;
+    use hegel::generators as gens;
+    use std::{format, string::ToString, vec, vec::Vec};
+
+    fn draw_mac(tc: &hegel::TestCase) -> [u8; 6] {
+        tc.draw(gens::arrays(gens::integers::<u8>()))
+    }
+
+    fn draw_addr4(tc: &hegel::TestCase) -> [u8; 4] {
+        tc.draw(gens::arrays(gens::integers::<u8>()))
+    }
+
+    fn draw_addr16(tc: &hegel::TestCase) -> [u8; 16] {
+        tc.draw(gens::arrays(gens::integers::<u8>()))
+    }
+
+    fn draw_single_vlan(tc: &hegel::TestCase) -> SingleVlanHeader {
+        SingleVlanHeader {
+            pcp: VlanPcp::try_new(tc.draw(gens::integers::<u8>().max_value(0b111))).unwrap(),
+            drop_eligible_indicator: tc.draw(gens::booleans()),
+            vlan_id: VlanId::try_new(tc.draw(gens::integers::<u16>().max_value(0xfff))).unwrap(),
+            // the ether type is determined by the builder based on the
+            // headers that follow
+            ether_type: EtherType(0),
+        }
+    }
+
+    /// IPv4 header for the packet builder (total_len, protocol &
+    /// checksum are computed by the builder on write).
+    fn draw_ipv4_header(tc: &hegel::TestCase) -> Ipv4Header {
+        let options_len = usize::from(tc.draw(gens::integers::<u8>().max_value(10))) * 4;
+        let options: Vec<u8> = tc.draw(
+            gens::vecs(gens::integers::<u8>())
+                .min_size(options_len)
+                .max_size(options_len),
+        );
+        let mut header = Ipv4Header::new(
+            0,
+            tc.draw(gens::integers::<u8>()),
+            IpNumber::UDP, // replaced by the builder
+            draw_addr4(tc),
+            draw_addr4(tc),
+        )
+        .unwrap();
+        header.identification = tc.draw(gens::integers::<u16>());
+        header.dscp = IpDscp::try_new(tc.draw(gens::integers::<u8>().max_value(0b11_1111))).unwrap();
+        header.ecn = IpEcn::try_new(tc.draw(gens::integers::<u8>().max_value(0b11))).unwrap();
+        header.dont_fragment = tc.draw(gens::booleans());
+        header.options = (&options[..]).try_into().unwrap();
+        header
+    }
+
+    /// Raw IPv6 extension header (payload len must be 6 + 8k).
+    fn draw_raw_ext(tc: &hegel::TestCase) -> Ipv6RawExtHeader {
+        let payload_len = 6 + 8 * usize::from(tc.draw(gens::integers::<u8>().max_value(3)));
+        let payload: Vec<u8> = tc.draw(
+            gens::vecs(gens::integers::<u8>())
+                .min_size(payload_len)
+                .max_size(payload_len),
+        );
+        // next_header is fixed up by the builder
+        Ipv6RawExtHeader::new_raw(IpNumber(0), &payload).unwrap()
+    }
+
+    fn draw_tcp_header(tc: &hegel::TestCase) -> TcpHeader {
+        let mut header = TcpHeader::new(
+            tc.draw(gens::integers::<u16>()),
+            tc.draw(gens::integers::<u16>()),
+            tc.draw(gens::integers::<u32>()),
+            tc.draw(gens::integers::<u16>()),
+        );
+        header.acknowledgment_number = tc.draw(gens::integers::<u32>());
+        header.urgent_pointer = tc.draw(gens::integers::<u16>());
+        header.ns = tc.draw(gens::booleans());
+        header.fin = tc.draw(gens::booleans());
+        header.syn = tc.draw(gens::booleans());
+        header.rst = tc.draw(gens::booleans());
+        header.psh = tc.draw(gens::booleans());
+        header.ack = tc.draw(gens::booleans());
+        header.ece = tc.draw(gens::booleans());
+        header.urg = tc.draw(gens::booleans());
+        header.cwr = tc.draw(gens::booleans());
+        let options_len = usize::from(tc.draw(gens::integers::<u8>().max_value(10))) * 4;
+        let options: Vec<u8> = tc.draw(
+            gens::vecs(gens::integers::<u8>())
+                .min_size(options_len)
+                .max_size(options_len),
+        );
+        header.set_options_raw(&options).unwrap();
+        header
+    }
+
+    /// The crown roundtrip: build a packet (Ethernet II, optional
+    /// single/double VLAN, IPv4 with options or IPv6 with extension
+    /// headers, UDP/TCP/ICMPv4/ICMPv6, payload) with the
+    /// `PacketBuilder` and verify `PacketHeaders::from_ethernet_slice`
+    /// & `SlicedPacket::from_ethernet` recover the headers & payload
+    /// exactly.
+    #[hegel::test(test_cases = 200)]
+    fn hegel_builder_parse_roundtrip(tc: hegel::TestCase) {
+        let eth_source = draw_mac(&tc);
+        let eth_destination = draw_mac(&tc);
+
+        // vlan: 0 = none, 1 = single, 2 = double
+        let vlan = match tc.draw(gens::integers::<u8>().max_value(2)) {
+            0 => None,
+            1 => Some(VlanHeader::Single(draw_single_vlan(&tc))),
+            _ => Some(VlanHeader::Double(DoubleVlanHeader {
+                outer: draw_single_vlan(&tc),
+                inner: draw_single_vlan(&tc),
+            })),
+        };
+        let vlan_len = match &vlan {
+            None => 0,
+            Some(VlanHeader::Single(_)) => SingleVlanHeader::LEN,
+            Some(VlanHeader::Double(_)) => SingleVlanHeader::LEN * 2,
+        };
+
+        // net: IPv4 (with options) or IPv6 (with extension headers)
+        let use_ipv4 = tc.draw(gens::booleans());
+        let ip = if use_ipv4 {
+            IpHeaders::Ipv4(draw_ipv4_header(&tc), Default::default())
+        } else {
+            let mut exts = Ipv6Extensions::default();
+            if tc.draw(gens::booleans()) {
+                exts.hop_by_hop_options = Some(draw_raw_ext(&tc));
+            }
+            if tc.draw(gens::booleans()) {
+                exts.destination_options = Some(draw_raw_ext(&tc));
+            }
+            IpHeaders::Ipv6(
+                Ipv6Header {
+                    traffic_class: tc.draw(gens::integers::<u8>()),
+                    flow_label: Ipv6FlowLabel::try_new(
+                        tc.draw(gens::integers::<u32>().max_value(0xf_ffff)),
+                    )
+                    .unwrap(),
+                    payload_length: 0,        // computed by the builder
+                    next_header: IpNumber(0), // computed by the builder
+                    hop_limit: tc.draw(gens::integers::<u8>()),
+                    source: draw_addr16(&tc),
+                    destination: draw_addr16(&tc),
+                },
+                exts,
+            )
+        };
+
+        // transport: 0 = udp, 1 = tcp, 2 = icmpv4 echo request,
+        // 3 = icmpv6 echo request (IPv6 only, as the builder rejects
+        // ICMPv6 in IPv4 due to the pseudo header checksum)
+        let transport_choice = tc.draw(
+            gens::integers::<u8>().max_value(if use_ipv4 { 2 } else { 3 }),
+        );
+        let udp_ports = (
+            tc.draw(gens::integers::<u16>()),
+            tc.draw(gens::integers::<u16>()),
+        );
+        let tcp_header = draw_tcp_header(&tc);
+        let echo = (
+            tc.draw(gens::integers::<u16>()),
+            tc.draw(gens::integers::<u16>()),
+        );
+        let payload: Vec<u8> = tc.draw(gens::vecs(gens::integers::<u8>()).max_size(1024));
+
+        // build the packet
+        let base = PacketBuilder::ethernet2(eth_source, eth_destination);
+        let ip_step = match &vlan {
+            None => base.ip(ip.clone()),
+            Some(v) => base.vlan(v.clone()).ip(ip.clone()),
+        };
+        let mut packet = Vec::new();
+        match transport_choice {
+            0 => ip_step
+                .udp(udp_ports.0, udp_ports.1)
+                .write(&mut packet, &payload)
+                .unwrap(),
+            1 => ip_step
+                .tcp_header(tcp_header.clone())
+                .write(&mut packet, &payload)
+                .unwrap(),
+            2 => ip_step
+                .icmpv4_echo_request(echo.0, echo.1)
+                .write(&mut packet, &payload)
+                .unwrap(),
+            _ => ip_step
+                .icmpv6_echo_request(echo.0, echo.1)
+                .write(&mut packet, &payload)
+                .unwrap(),
+        }
+
+        let transport_ip_number = match transport_choice {
+            0 => IpNumber::UDP,
+            1 => IpNumber::TCP,
+            2 => IpNumber::ICMP,
+            _ => IpNumber::IPV6_ICMP,
+        };
+
+        // parse
+        let headers = PacketHeaders::from_ethernet_slice(&packet).unwrap();
+
+        // link
+        match &headers.link {
+            Some(LinkHeader::Ethernet2(actual)) => {
+                assert_eq!(actual.source, eth_source);
+                assert_eq!(actual.destination, eth_destination);
+            }
+            other => panic!("expected an Ethernet2 header, got {other:?}"),
+        }
+
+        // vlan
+        match (&vlan, &headers.vlan()) {
+            (None, None) => {}
+            (Some(VlanHeader::Single(expected)), Some(VlanHeader::Single(actual))) => {
+                assert_eq!(actual.pcp, expected.pcp);
+                assert_eq!(
+                    actual.drop_eligible_indicator,
+                    expected.drop_eligible_indicator
+                );
+                assert_eq!(actual.vlan_id, expected.vlan_id);
+            }
+            (Some(VlanHeader::Double(expected)), Some(VlanHeader::Double(actual))) => {
+                for (a, e) in [
+                    (&actual.outer, &expected.outer),
+                    (&actual.inner, &expected.inner),
+                ] {
+                    assert_eq!(a.pcp, e.pcp);
+                    assert_eq!(a.drop_eligible_indicator, e.drop_eligible_indicator);
+                    assert_eq!(a.vlan_id, e.vlan_id);
+                }
+            }
+            (expected, actual) => panic!("vlan mismatch: {expected:?} vs {actual:?}"),
+        }
+
+        // net
+        match (&ip, &headers.net) {
+            (IpHeaders::Ipv4(expected, _), Some(NetHeaders::Ipv4(actual, actual_exts))) => {
+                assert_eq!(actual.source, expected.source);
+                assert_eq!(actual.destination, expected.destination);
+                assert_eq!(actual.time_to_live, expected.time_to_live);
+                assert_eq!(actual.identification, expected.identification);
+                assert_eq!(actual.dscp, expected.dscp);
+                assert_eq!(actual.ecn, expected.ecn);
+                assert_eq!(actual.dont_fragment, expected.dont_fragment);
+                assert_eq!(actual.options, expected.options);
+                assert_eq!(actual.protocol, transport_ip_number);
+                // the builder must have written a consistent total
+                // length & a checksum matching calc_header_checksum
+                assert_eq!(
+                    usize::from(actual.total_len),
+                    packet.len() - Ethernet2Header::LEN - vlan_len
+                );
+                assert_eq!(actual.header_checksum, actual.calc_header_checksum());
+                assert_eq!(actual_exts, &Ipv4Extensions::default());
+            }
+            (IpHeaders::Ipv6(expected, expected_exts), Some(NetHeaders::Ipv6(actual, actual_exts))) => {
+                assert_eq!(actual.source, expected.source);
+                assert_eq!(actual.destination, expected.destination);
+                assert_eq!(actual.traffic_class, expected.traffic_class);
+                assert_eq!(actual.flow_label, expected.flow_label);
+                assert_eq!(actual.hop_limit, expected.hop_limit);
+                assert_eq!(
+                    usize::from(actual.payload_length),
+                    packet.len() - Ethernet2Header::LEN - vlan_len - Ipv6Header::LEN
+                );
+                // the extension chain must round trip with the next
+                // header fields fixed up like the builder does
+                let mut expected_exts = expected_exts.clone();
+                let first = expected_exts.set_next_headers(transport_ip_number);
+                assert_eq!(actual.next_header, first);
+                assert_eq!(actual_exts, &expected_exts);
+            }
+            (expected, actual) => panic!("net mismatch: {expected:?} vs {actual:?}"),
+        }
+
+        // transport
+        match (transport_choice, &headers.transport) {
+            (0, Some(TransportHeader::Udp(actual))) => {
+                assert_eq!(actual.source_port, udp_ports.0);
+                assert_eq!(actual.destination_port, udp_ports.1);
+                assert_eq!(
+                    usize::from(actual.length),
+                    UdpHeader::LEN + payload.len()
+                );
+            }
+            (1, Some(TransportHeader::Tcp(actual))) => {
+                // the builder computes the checksum; mirror it in the
+                // expected header (its correctness is separately checked
+                // against a spec transcribed oracle in tcp_header.rs)
+                let mut expected = tcp_header.clone();
+                expected.checksum = match &ip {
+                    IpHeaders::Ipv4(v4, _) => expected
+                        .calc_checksum_ipv4_raw(v4.source, v4.destination, &payload)
+                        .unwrap(),
+                    IpHeaders::Ipv6(v6, _) => expected
+                        .calc_checksum_ipv6_raw(v6.source, v6.destination, &payload)
+                        .unwrap(),
+                };
+                assert_eq!(actual, &expected);
+            }
+            (2, Some(TransportHeader::Icmpv4(actual))) => match actual.icmp_type {
+                Icmpv4Type::EchoRequest(echo_header) => {
+                    assert_eq!(echo_header.id, echo.0);
+                    assert_eq!(echo_header.seq, echo.1);
+                }
+                ref other => panic!("expected an ICMPv4 echo request, got {other:?}"),
+            },
+            (3, Some(TransportHeader::Icmpv6(actual))) => match actual.icmp_type {
+                Icmpv6Type::EchoRequest(echo_header) => {
+                    assert_eq!(echo_header.id, echo.0);
+                    assert_eq!(echo_header.seq, echo.1);
+                }
+                ref other => panic!("expected an ICMPv6 echo request, got {other:?}"),
+            },
+            (choice, actual) => panic!("transport mismatch: {choice} vs {actual:?}"),
+        }
+
+        // payload
+        assert_eq!(headers.payload.slice(), &payload[..]);
+
+        // the sliced variant must also parse & expose the same payload
+        let sliced = SlicedPacket::from_ethernet(&packet).unwrap();
+        match &sliced.transport {
+            Some(TransportSlice::Udp(slice)) => assert_eq!(slice.payload(), &payload[..]),
+            Some(TransportSlice::Tcp(slice)) => assert_eq!(slice.payload(), &payload[..]),
+            Some(TransportSlice::Icmpv4(slice)) => assert_eq!(slice.payload(), &payload[..]),
+            Some(TransportSlice::Icmpv6(slice)) => assert_eq!(slice.payload(), &payload[..]),
+            other => panic!("expected a transport slice, got {other:?}"),
+        }
+    }
+
+    /// Feeding completely arbitrary bytes into any of the packet level
+    /// decoders must never panic, read out of bounds or hang — the
+    /// input is attacker controlled on this API boundary (`Ok` and
+    /// `Err` are both acceptable results).
+    #[hegel::test(test_cases = 500)]
+    fn hegel_arbitrary_bytes_never_panic(tc: hegel::TestCase) {
+        let mut data: Vec<u8> = tc.draw(gens::binary().max_size(2048));
+
+        // occasionally force a plausible IP version nibble into the
+        // first byte so the deeper v4/v6 parsing paths are reached
+        if !data.is_empty() && tc.draw(gens::booleans()) {
+            let version: u8 = if tc.draw(gens::booleans()) { 4 } else { 6 };
+            data[0] = (version << 4) | (data[0] & 0x0f);
+        }
+
+        drop(SlicedPacket::from_ethernet(&data));
+        drop(SlicedPacket::from_ip(&data));
+        drop(PacketHeaders::from_ethernet_slice(&data));
+        drop(PacketHeaders::from_ip_slice(&data));
+        drop(LaxSlicedPacket::from_ethernet(&data));
+        drop(LaxSlicedPacket::from_ip(&data));
+        drop(LaxPacketHeaders::from_ethernet(&data));
+        drop(LaxPacketHeaders::from_ip(&data));
+
+        // also exercise the ether type dispatch (ARP, MACsec, VLAN, ...)
+        let ether_type = EtherType(tc.draw(gens::integers::<u16>()));
+        drop(SlicedPacket::from_ether_type(ether_type, &data));
+        drop(PacketHeaders::from_ether_type(ether_type, &data));
+    }
+
+    /// Corrupting arbitrary bytes of a valid packet — including the
+    /// attacker controlled length fields (IHL, total length, IPv6
+    /// extension header lengths, TCP data offset) — must never cause a
+    /// panic or out of bounds read in any decoder.
+    #[hegel::test(test_cases = 500)]
+    fn hegel_corrupted_packet_never_panics(tc: hegel::TestCase) {
+        // build a valid packet
+        let payload: Vec<u8> = tc.draw(gens::vecs(gens::integers::<u8>()).max_size(128));
+        let use_ipv4 = tc.draw(gens::booleans());
+        let use_tcp = tc.draw(gens::booleans());
+        let ip = if use_ipv4 {
+            IpHeaders::Ipv4(draw_ipv4_header(&tc), Default::default())
+        } else {
+            let mut exts = Ipv6Extensions::default();
+            if tc.draw(gens::booleans()) {
+                exts.hop_by_hop_options = Some(draw_raw_ext(&tc));
+            }
+            IpHeaders::Ipv6(
+                Ipv6Header {
+                    traffic_class: 0,
+                    flow_label: Ipv6FlowLabel::ZERO,
+                    payload_length: 0,
+                    next_header: IpNumber(0),
+                    hop_limit: 64,
+                    source: draw_addr16(&tc),
+                    destination: draw_addr16(&tc),
+                },
+                exts,
+            )
+        };
+        let ip_step = PacketBuilder::ethernet2(draw_mac(&tc), draw_mac(&tc)).ip(ip);
+        let mut packet = Vec::new();
+        if use_tcp {
+            ip_step
+                .tcp_header(draw_tcp_header(&tc))
+                .write(&mut packet, &payload)
+                .unwrap();
+        } else {
+            ip_step
+                .udp(
+                    tc.draw(gens::integers::<u16>()),
+                    tc.draw(gens::integers::<u16>()),
+                )
+                .write(&mut packet, &payload)
+                .unwrap();
+        }
+
+        // corrupt 1..=8 bytes, biased towards the header area where
+        // the length fields live
+        let corruptions = tc.draw(gens::integers::<usize>().min_value(1).max_value(8));
+        for _ in 0..corruptions {
+            let position = tc.draw(hegel::one_of!(
+                gens::integers::<usize>().max_value(packet.len() - 1),
+                gens::integers::<usize>()
+                    .max_value(core::cmp::min(59, packet.len() - 1)),
+            ));
+            packet[position] = tc.draw(gens::integers::<u8>());
+        }
+
+        drop(SlicedPacket::from_ethernet(&packet));
+        drop(SlicedPacket::from_ip(&packet));
+        drop(PacketHeaders::from_ethernet_slice(&packet));
+        drop(PacketHeaders::from_ip_slice(&packet));
+        drop(LaxSlicedPacket::from_ethernet(&packet));
+        drop(LaxSlicedPacket::from_ip(&packet));
+        drop(LaxPacketHeaders::from_ethernet(&packet));
+        drop(LaxPacketHeaders::from_ip(&packet));
+    }
+
+    /// Truncation must always be detected: every strict prefix of a
+    /// valid Ethernet II + IPv4 + UDP packet must be rejected with an
+    /// error (the length fields cover all bytes) and must never panic,
+    /// while the complete packet parses fine.
+    #[hegel::test]
+    fn hegel_truncated_packet_returns_error(tc: hegel::TestCase) {
+        let payload: Vec<u8> = tc.draw(gens::vecs(gens::integers::<u8>()).max_size(64));
+        let mut packet = Vec::new();
+        PacketBuilder::ethernet2(draw_mac(&tc), draw_mac(&tc))
+            .ip(IpHeaders::Ipv4(draw_ipv4_header(&tc), Default::default()))
+            .udp(
+                tc.draw(gens::integers::<u16>()),
+                tc.draw(gens::integers::<u16>()),
+            )
+            .write(&mut packet, &payload)
+            .unwrap();
+
+        for len in 0..packet.len() {
+            let prefix = &packet[..len];
+            assert!(
+                SlicedPacket::from_ethernet(prefix).is_err(),
+                "SlicedPacket: strict prefix of len {len} unexpectedly parsed"
+            );
+            assert!(
+                PacketHeaders::from_ethernet_slice(prefix).is_err(),
+                "PacketHeaders: strict prefix of len {len} unexpectedly parsed"
+            );
+        }
+        assert!(SlicedPacket::from_ethernet(&packet).is_ok());
+        assert!(PacketHeaders::from_ethernet_slice(&packet).is_ok());
+    }
+}
diff --git a/etherparse/src/net/ipv4_header.rs b/etherparse/src/net/ipv4_header.rs
index cf6733f..8c508ea 100644
--- a/etherparse/src/net/ipv4_header.rs
+++ b/etherparse/src/net/ipv4_header.rs
@@ -1435,3 +1435,128 @@ mod test {
         }
     }
 }
+
+#[cfg(test)]
+mod hegel_props {
+    use super::*;
+    use hegel::generators as gens;
+    use std::{format, string::ToString, vec::Vec};
+
+    /// Draws a structurally valid [`Ipv4Header`] with arbitrary field
+    /// values (checksum is left at zero, options len is drawn in
+    /// 4 byte steps as required by the IHL field).
+    fn draw_header(tc: &hegel::TestCase) -> Ipv4Header {
+        let options_len = usize::from(tc.draw(gens::integers::<u8>().max_value(10))) * 4;
+        let options: Vec<u8> = tc.draw(
+            gens::vecs(gens::integers::<u8>())
+                .min_size(options_len)
+                .max_size(options_len),
+        );
+        let header = Ipv4Header {
+            dscp: IpDscp::try_new(tc.draw(gens::integers::<u8>().max_value(0b11_1111))).unwrap(),
+            ecn: IpEcn::try_new(tc.draw(gens::integers::<u8>().max_value(0b11))).unwrap(),
+            total_len: tc.draw(gens::integers::<u16>()),
+            identification: tc.draw(gens::integers::<u16>()),
+            dont_fragment: tc.draw(gens::booleans()),
+            more_fragments: tc.draw(gens::booleans()),
+            fragment_offset: IpFragOffset::try_new(
+                tc.draw(gens::integers::<u16>().max_value(0x1fff)),
+            )
+            .unwrap(),
+            time_to_live: tc.draw(gens::integers::<u8>()),
+            protocol: IpNumber(tc.draw(gens::integers::<u8>())),
+            header_checksum: 0,
+            source: tc.draw(gens::arrays(gens::integers::<u8>())),
+            destination: tc.draw(gens::arrays(gens::integers::<u8>())),
+            options: (&options[..]).try_into().unwrap(),
+        };
+        header
+    }
+
+    /// RFC 1071 one's complement sum (big endian 16 bit words, odd
+    /// trailing byte padded with zero, end-around carry folded).
+    ///
+    /// Spec-transcribed oracle: data containing a valid internet
+    /// checksum sums to 0xFFFF.
+    fn ones_complement_sum(bytes: &[u8]) -> u16 {
+        let mut sum: u32 = 0;
+        let mut chunks = bytes.chunks_exact(2);
+        for word in &mut chunks {
+            sum += u32::from(u16::from_be_bytes([word[0], word[1]]));
+        }
+        if let [last] = chunks.remainder() {
+            sum += u32::from(u16::from_be_bytes([*last, 0]));
+        }
+        while sum > 0xFFFF {
+            sum = (sum & 0xFFFF) + (sum >> 16);
+        }
+        sum as u16
+    }
+
+    /// Roundtrip: serializing a header and parsing it back with
+    /// `from_slice` restores the header exactly, consumes exactly
+    /// `header_len()` bytes and returns the remaining bytes untouched.
+    #[hegel::test]
+    fn hegel_write_from_slice_roundtrip(tc: hegel::TestCase) {
+        let mut header = draw_header(&tc);
+        // `write` calculates the checksum on the fly; set it here so
+        // the serialized & in-memory versions are identical.
+        header.header_checksum = header.calc_header_checksum();
+
+        let mut buffer = Vec::with_capacity(header.header_len() + 32);
+        header.write_raw(&mut buffer).unwrap();
+        assert_eq!(buffer.len(), header.header_len());
+
+        // bytes after the header must be returned untouched as "rest"
+        let extra: Vec<u8> = tc.draw(gens::vecs(gens::integers::<u8>()).max_size(32));
+        buffer.extend_from_slice(&extra);
+
+        let (decoded, rest) = Ipv4Header::from_slice(&buffer).unwrap();
+        assert_eq!(decoded, header);
+        assert_eq!(rest, &extra[..]);
+    }
+
+    /// `calc_header_checksum` must produce a checksum that is valid
+    /// according to RFC 1071 (one's complement sum over the serialized
+    /// header is 0xFFFF).
+    #[hegel::test]
+    fn hegel_header_checksum_matches_rfc1071(tc: hegel::TestCase) {
+        let mut header = draw_header(&tc);
+        header.header_checksum = header.calc_header_checksum();
+        let bytes = header.to_bytes();
+        assert_eq!(ones_complement_sum(&bytes), 0xFFFF);
+    }
+
+    /// Corruption check: flipping any single bit of a serialized header
+    /// with a valid checksum must make the checksum invalid (a single
+    /// bit flip changes a 16 bit word by ±2^k which is never congruent
+    /// to 0 modulo 0xFFFF).
+    #[hegel::test]
+    fn hegel_header_checksum_detects_bit_flip(tc: hegel::TestCase) {
+        let mut header = draw_header(&tc);
+        header.header_checksum = header.calc_header_checksum();
+        let mut bytes = header.to_bytes();
+        let byte_index = tc.draw(gens::integers::<usize>().max_value(bytes.len() - 1));
+        let bit = tc.draw(gens::integers::<u8>().max_value(7));
+        bytes[byte_index] ^= 1 << bit;
+        assert_ne!(ones_complement_sum(&bytes), 0xFFFF);
+    }
+
+    /// Every strict prefix of a serialized header must be rejected with
+    /// a length error (and must never panic), as the data can not
+    /// contain the complete header the IHL field announces.
+    #[hegel::test]
+    fn hegel_from_slice_on_prefix_returns_len_error(tc: hegel::TestCase) {
+        let header = draw_header(&tc);
+        let bytes = header.to_bytes();
+        for len in 0..bytes.len() {
+            match Ipv4Header::from_slice(&bytes[..len]) {
+                Err(err::ipv4::HeaderSliceError::Len(_)) => {}
+                Err(other) => panic!(
+                    "expected a length error for the prefix of len {len}, got {other:?}"
+                ),
+                Ok(_) => panic!("strict prefix of len {len} unexpectedly parsed"),
+            }
+        }
+    }
+}
