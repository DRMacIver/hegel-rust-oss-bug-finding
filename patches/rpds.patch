diff --git a/src/stack/test.rs b/src/stack/test.rs
index 9ca3fd5..ccaa587 100644
--- a/src/stack/test.rs
+++ b/src/stack/test.rs
@@ -264,3 +264,76 @@ fn test_serde() {
 
     assert_eq!(stack, decoded);
 }
+
+mod hegel_properties {
+    use super::*;
+    use hegel::TestCase;
+    use pretty_assertions::assert_eq;
+    use hegel::generators;
+
+    struct StackMachine {
+        subject: Stack<i32>,
+        model: Vec<i32>,
+    }
+
+    #[hegel::state_machine]
+    impl StackMachine {
+        #[rule]
+        fn push_mut(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject.push_mut(v);
+            self.model.push(v);
+        }
+
+        #[rule]
+        fn push(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject = self.subject.push(v);
+            self.model.push(v);
+        }
+
+        #[rule]
+        fn pop_mut(&mut self, _: TestCase) {
+            let popped = self.subject.pop_mut();
+            assert_eq!(popped, self.model.pop().is_some());
+        }
+
+        #[rule]
+        fn pop(&mut self, _: TestCase) {
+            match self.subject.pop() {
+                Some(shorter) => {
+                    assert!(self.model.pop().is_some());
+                    self.subject = shorter;
+                }
+                None => assert!(self.model.is_empty()),
+            }
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.subject.size(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.peek(), self.model.last());
+            // Stack iterates from the top (LIFO order).
+            assert!(self.subject.iter().eq(self.model.iter().rev()));
+        }
+    }
+
+    // Model test: a `Stack` must behave like a `Vec` used as a stack under
+    // any sequence of push/pop operations.
+    #[hegel::test]
+    fn hegel_stack_model_matches_vec(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: Stack<i32> = Stack::new();
+        let mut model: Vec<i32> = Vec::new();
+        for v in init {
+            subject.push_mut(v);
+            model.push(v);
+        }
+
+        hegel::stateful::run(StackMachine { subject, model }, tc);
+    }
+}
diff --git a/src/vector/test.rs b/src/vector/test.rs
index a9222cf..f1dcc29 100644
--- a/src/vector/test.rs
+++ b/src/vector/test.rs
@@ -728,3 +728,181 @@ fn test_serde() {
 
     assert_eq!(vector, decoded);
 }
+
+mod hegel_properties {
+    use super::*;
+    use hegel::TestCase;
+    use pretty_assertions::assert_eq;
+    use hegel::generators;
+
+    struct VectorMachine {
+        subject: Vector<i32>,
+        model: Vec<i32>,
+    }
+
+    #[hegel::state_machine]
+    impl VectorMachine {
+        #[rule]
+        fn push_back_mut(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject.push_back_mut(v);
+            self.model.push(v);
+        }
+
+        #[rule]
+        fn push_back(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject = self.subject.push_back(v);
+            self.model.push(v);
+        }
+
+        // Push a whole batch so the trie grows several levels deep within a
+        // single run (see "Deep structure bugs" in the property catalogue).
+        #[rule]
+        fn push_back_many(&mut self, tc: TestCase) {
+            let vs: Vec<i32> =
+                tc.draw(generators::vecs(generators::integers::<i32>()).max_size(64));
+            for v in vs {
+                self.subject.push_back_mut(v);
+                self.model.push(v);
+            }
+        }
+
+        #[rule]
+        fn drop_last_mut(&mut self, _: TestCase) {
+            let dropped = self.subject.drop_last_mut();
+            assert_eq!(dropped, self.model.pop().is_some());
+        }
+
+        #[rule]
+        fn drop_last(&mut self, _: TestCase) {
+            match self.subject.drop_last() {
+                Some(shorter) => {
+                    assert!(self.model.pop().is_some());
+                    self.subject = shorter;
+                }
+                None => assert!(self.model.is_empty()),
+            }
+        }
+
+        #[rule]
+        fn set_mut(&mut self, tc: TestCase) {
+            // Deliberately allow out-of-range indexes: `set_mut` must return
+            // `false` for those.
+            let index =
+                tc.draw(generators::integers::<usize>().max_value(self.model.len() + 1));
+            let v = tc.draw(generators::integers::<i32>());
+            let updated = self.subject.set_mut(index, v);
+            assert_eq!(updated, index < self.model.len());
+            if updated {
+                self.model[index] = v;
+            }
+        }
+
+        #[rule]
+        fn set(&mut self, tc: TestCase) {
+            let index =
+                tc.draw(generators::integers::<usize>().max_value(self.model.len() + 1));
+            let v = tc.draw(generators::integers::<i32>());
+            match self.subject.set(index, v) {
+                Some(updated) => {
+                    assert!(index < self.model.len());
+                    self.subject = updated;
+                    self.model[index] = v;
+                }
+                None => assert!(index >= self.model.len()),
+            }
+        }
+
+        #[rule]
+        fn get(&mut self, tc: TestCase) {
+            let index =
+                tc.draw(generators::integers::<usize>().max_value(self.model.len() + 1));
+            assert_eq!(self.subject.get(index), self.model.get(index));
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.first(), self.model.first());
+            assert_eq!(self.subject.last(), self.model.last());
+            assert!(self.subject.iter().eq(self.model.iter()));
+        }
+    }
+
+    // Model test: a `Vector` must behave exactly like `Vec` under any sequence
+    // of operations. The vector's `bits` configuration is generated too
+    // (`new_with_bits` is public API): small values of `bits` produce deep
+    // tries with few elements (bits = 1 makes the trie binary).
+    #[hegel::test]
+    fn hegel_vector_model_matches_vec(tc: TestCase) {
+        let bits = tc.draw(generators::integers::<u8>().min_value(1).max_value(8));
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: Vector<i32> = Vector::new_with_bits(bits);
+        let mut model: Vec<i32> = Vec::new();
+        for v in init {
+            subject.push_back_mut(v);
+            model.push(v);
+        }
+
+        hegel::stateful::run(VectorMachine { subject, model }, tc);
+    }
+
+    // Persistence: deriving new versions from a vector (through both the
+    // persistent API and the copy-on-write `_mut` API on clones) must never
+    // change any older version. This is the crate's core promise
+    // ("persistent data structures with structural sharing").
+    #[hegel::test]
+    fn hegel_vector_persistence(tc: TestCase) {
+        let bits = tc.draw(generators::integers::<u8>().min_value(1).max_value(8));
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        // versions[i] contains values[..i].
+        let mut versions: Vec<Vector<i32>> = Vec::with_capacity(values.len() + 1);
+        versions.push(Vector::new_with_bits(bits));
+        for v in &values {
+            versions.push(versions.last().unwrap().push_back(*v));
+        }
+
+        // Derive heavily-mutated versions from a randomly chosen version.
+        let chosen = tc
+            .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+        let mut drained = versions[chosen].clone();
+        while drained.drop_last_mut() {}
+
+        let mut overwritten = versions[chosen].clone();
+        for i in 0..overwritten.len() {
+            assert!(overwritten.set_mut(i, i32::MIN));
+        }
+        overwritten.push_back_mut(i32::MAX);
+
+        // No old version may have changed.
+        for (i, version) in versions.iter().enumerate() {
+            assert_eq!(version.len(), i);
+            assert!(version.iter().eq(values[..i].iter()));
+        }
+    }
+
+    // `new_with_bits` accepts any positive `bits` (that is the only
+    // documented/asserted requirement), so a vector created with any positive
+    // `bits` should support basic operations without panicking.
+    #[hegel::test]
+    fn hegel_vector_new_with_bits_no_panic(tc: TestCase) {
+        let bits = tc.draw(generators::integers::<u8>().min_value(1));
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()));
+
+        let mut v: Vector<i32> = Vector::new_with_bits(bits);
+        for x in &values {
+            v.push_back_mut(*x);
+        }
+        assert_eq!(v.len(), values.len());
+        assert!(v.iter().eq(values.iter()));
+    }
+}
