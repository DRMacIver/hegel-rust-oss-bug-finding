+        // Sometimes build b on top of a's elements so subset relations occur.
+        let mut b_vals: Vec<i8> = if tc.draw(generators::booleans()) {
+            a_vals.clone()
+        } else {
+            Vec::new()
+        };
+        b_vals.extend(tc.draw(
+            generators::vecs(generators::integers::<i8>().min_value(0).max_value(15)),
+        ));
+
+        let mut a: HashTrieSet<i8> = HashTrieSet::new();
+        let mut model_a: HashSet<i8> = HashSet::new();
+        for v in &a_vals {
+            a.insert_mut(*v);
+            model_a.insert(*v);
+        }
+
+        let mut b: HashTrieSet<i8> = HashTrieSet::new();
+        let mut model_b: HashSet<i8> = HashSet::new();
+        for v in &b_vals {
+            b.insert_mut(*v);
+            model_b.insert(*v);
+        }
