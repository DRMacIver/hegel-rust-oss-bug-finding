+mod hegel_properties {
+    use super::*;
+    use hegel::TestCase;
+    use pretty_assertions::assert_eq;
+    use hegel::generators;
+    use std::collections::VecDeque;
+
+    struct ListMachine {
+        subject: List<i32>,
+        model: VecDeque<i32>,
+    }
+
+    #[hegel::state_machine]
+    impl ListMachine {
+        #[rule]
+        fn push_front_mut(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject.push_front_mut(v);
+            self.model.push_front(v);
+        }
+
+        #[rule]
+        fn push_front(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject = self.subject.push_front(v);
+            self.model.push_front(v);
+        }
+
+        #[rule]
+        fn drop_first_mut(&mut self, _: TestCase) {
+            let dropped = self.subject.drop_first_mut();
+            assert_eq!(dropped, self.model.pop_front().is_some());
+        }
+
+        #[rule]
+        fn drop_first(&mut self, _: TestCase) {
+            match self.subject.drop_first() {
+                Some(shorter) => {
+                    assert!(self.model.pop_front().is_some());
+                    self.subject = shorter;
+                }
+                None => assert!(self.model.is_empty()),
+            }
+        }
+
+        #[rule]
+        fn reverse_mut(&mut self, _: TestCase) {
+            self.subject.reverse_mut();
+            let reversed: VecDeque<i32> = self.model.iter().rev().copied().collect();
+            self.model = reversed;
+        }
+
+        #[rule]
+        fn reverse(&mut self, _: TestCase) {
+            self.subject = self.subject.reverse();
+            let reversed: VecDeque<i32> = self.model.iter().rev().copied().collect();
+            self.model = reversed;
+        }
+
+        // The `last` pointer is cached in the `List` struct, so it is a prime
+        // candidate for stale-state bugs: check it after every rule.
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.first(), self.model.front());
+            assert_eq!(self.subject.last(), self.model.back());
+            assert!(self.subject.iter().eq(self.model.iter()));
+        }
+    }
+
+    // Model test: a `List` must behave like `VecDeque` (front operations
+    // only) under any sequence of operations, including interleaved reversals.
+    #[hegel::test]
+    fn hegel_list_model_matches_vec_deque(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: List<i32> = List::new();
+        let mut model: VecDeque<i32> = VecDeque::new();
+        for v in init {
+            subject.push_front_mut(v);
+            model.push_front(v);
+        }
+
+        hegel::stateful::run(ListMachine { subject, model }, tc);
+    }
+
+    // Oracle: `List::reverse` must agree with reversing a `Vec`. (This also
+    // implies reverse is an involution.)
+    #[hegel::test]
+    fn hegel_list_reverse_matches_vec_reverse(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        // push_front-built list contains `values` reversed.
+        let mut list: List<i32> = List::new();
+        for v in &values {
+            list.push_front_mut(*v);
+        }
+
+        let reversed = list.reverse();
+        assert_eq!(reversed.len(), values.len());
+        assert!(reversed.iter().eq(values.iter()));
+        assert_eq!(reversed.first(), values.first());
+        assert_eq!(reversed.last(), values.last());
+
+        // The original list must be untouched (persistence).
+        assert!(list.iter().eq(values.iter().rev()));
+    }
+}
