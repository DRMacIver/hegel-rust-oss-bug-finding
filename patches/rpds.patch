+mod hegel_properties {
+    use super::*;
+    use core::hash::{BuildHasher, Hasher};
+    use pretty_assertions::assert_eq;
+    use hegel::TestCase;
+    use hegel::generators;
+    use std::collections::HashMap;
+    use std::collections::hash_map::DefaultHasher;
+
+    // A hasher that throws away all but the low 4 bits of the hash. This
+    // forces massive hash collisions, so the trie is driven into its
+    // hash-exhaustion/`Bucket::Collision` code paths (which an honest 64-bit
+    // hasher would essentially never reach).
+    #[derive(Clone, Default)]
+    struct LossyBuildHasher;
+
+    struct LossyHasher(DefaultHasher);
+
+    impl BuildHasher for LossyBuildHasher {
+        type Hasher = LossyHasher;
+
+        fn build_hasher(&self) -> LossyHasher {
+            LossyHasher(DefaultHasher::new())
+        }
+    }
+
+    impl Hasher for LossyHasher {
+        fn write(&mut self, bytes: &[u8]) {
+            self.0.write(bytes);
+        }
+
+        fn finish(&self) -> u64 {
+            self.0.finish() & 0xf
+        }
+    }
+
+    fn model_key_or_any(tc: &TestCase, model: &HashMap<i32, i64>) -> i32 {
+        if !model.is_empty() && tc.draw(generators::booleans()) {
+            let keys: Vec<i32> = model.keys().copied().collect();
+            tc.draw(generators::sampled_from(keys))
+        } else {
+            tc.draw(generators::integers::<i32>())
+        }
+    }
+
+    fn check_against_model<H: BuildHasher + Clone>(
+        subject: &HashTrieMap<i32, i64, RcK, H>,
+        model: &HashMap<i32, i64>,
+    ) {
+        assert_eq!(subject.size(), model.len());
+        assert_eq!(subject.is_empty(), model.is_empty());
+        // Every entry the subject yields must be in the model, and the sizes
+        // agree, so the maps are equal as sets of entries.
+        let mut seen = 0;
+        for (k, v) in subject.iter() {
+            assert_eq!(model.get(k), Some(v));
+            seen += 1;
+        }
+        assert_eq!(seen, model.len());
+        assert_eq!(subject.keys().count(), model.len());
+        assert_eq!(subject.values().count(), model.len());
+    }
+
+    struct HtMapMachine<H: BuildHasher + Clone> {
+        subject: HashTrieMap<i32, i64, RcK, H>,
+        model: HashMap<i32, i64>,
+    }
+
+    #[hegel::state_machine]
+    impl<H: BuildHasher + Clone> HtMapMachine<H> {
+        #[rule]
+        fn insert_mut(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let v = tc.draw(generators::integers::<i64>());
+            self.subject.insert_mut(k, v);
+            self.model.insert(k, v);
+        }
+
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let v = tc.draw(generators::integers::<i64>());
+            self.subject = self.subject.insert(k, v);
+            self.model.insert(k, v);
+        }
+
+        #[rule]
+        fn remove_mut(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let removed = self.subject.remove_mut(&k);
+            assert_eq!(removed, self.model.remove(&k).is_some());
+        }
+
