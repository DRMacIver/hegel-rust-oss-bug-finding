+// --- Property-based tests (hegel) ---
+
+mod pbt_model {
+    use super::{Item, ItemKey};
+    use hegel::generators;
+    use hegel::TestCase;
+    use native_db::*;
+    use once_cell::sync::Lazy;
+    use std::collections::BTreeMap;
+
+    static MODELS: Lazy<Models> = Lazy::new(|| {
+        let mut models = Models::new();
+        models.define::<Item>().unwrap();
+        models
+    });
+
+    // Small key spaces so primary-key collisions, unique-secondary-key conflicts
+    // and multi-item secondary groups all happen regularly.
+    fn draw_id(tc: &TestCase) -> u32 {
+        tc.draw(generators::integers::<u32>().max_value(7))
+    }
+
+    fn draw_name(tc: &TestCase) -> String {
+        tc.draw(generators::sampled_from(vec![
+            "a".to_string(),
+            "b".to_string(),
+            "c".to_string(),
+        ]))
+    }
+
+    fn draw_code(tc: &TestCase) -> String {
+        let n = tc.draw(generators::integers::<u8>().max_value(7));
+        format!("C{n}")
+    }
+
+    fn draw_item(tc: &TestCase) -> Item {
+        Item {
+            id: draw_id(tc),
+            name: draw_name(tc),
+            code: draw_code(tc),
+        }
+    }
+
+    // Stateful model test: the database (u32 primary key, non-unique secondary
+    // key `name`, unique secondary key `code`) must behave exactly like a
+    // BTreeMap<u32, Item>. Each rule runs one operation in its own transaction
+    // (committed on success, aborted on expected failure); the invariant checks
+    // after every step that the primary table and *both* secondary indexes agree
+    // exactly with the model — the classic stale-secondary-index bug surface.
+    struct DbMachine {
+        db: Database<'static>,
+        model: BTreeMap<u32, Item>,
+    }
+
+    #[hegel::state_machine]
+    impl DbMachine {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let item = draw_item(&tc);
+            let pk_conflict = self.model.contains_key(&item.id);
+            let unique_sk_conflict = self.model.values().any(|other| other.code == item.code);
+            let rw = self.db.rw_transaction().unwrap();
+            let result = rw.insert(item.clone());
+            if pk_conflict || unique_sk_conflict {
+                assert!(
+                    matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+                    "expected DuplicateKey inserting {item:?}, got {result:?}"
+                );
+                rw.abort().unwrap();
+            } else {
+                result.unwrap();
+                rw.commit().unwrap();
+                self.model.insert(item.id, item);
+            }
+        }
+
+        #[rule]
+        fn upsert(&mut self, tc: TestCase) {
+            let item = draw_item(&tc);
+            let unique_sk_conflict = self
+                .model
+                .values()
+                .any(|other| other.code == item.code && other.id != item.id);
+            let rw = self.db.rw_transaction().unwrap();
+            let result = rw.upsert(item.clone());
+            if unique_sk_conflict {
+                assert!(
+                    matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+                    "expected DuplicateKey upserting {item:?}, got {result:?}"
+                );
+                rw.abort().unwrap();
+            } else {
+                let old = result.unwrap();
+                rw.commit().unwrap();
+                assert_eq!(old, self.model.insert(item.id, item));
+            }
+        }
+
+        #[rule]
+        fn auto_update(&mut self, tc: TestCase) {
+            let item = draw_item(&tc);
+            let exists = self.model.contains_key(&item.id);
+            let unique_sk_conflict = self
+                .model
+                .values()
+                .any(|other| other.code == item.code && other.id != item.id);
+            let rw = self.db.rw_transaction().unwrap();
+            let result = rw.auto_update(item.clone());
+            if !exists {
+                assert_eq!(result.unwrap(), None);
+                rw.abort().unwrap();
+            } else if unique_sk_conflict {
+                assert!(
+                    matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+                    "expected DuplicateKey auto-updating {item:?}, got {result:?}"
+                );
+                rw.abort().unwrap();
+            } else {
+                let old = result.unwrap();
+                rw.commit().unwrap();
+                assert_eq!(old, self.model.insert(item.id, item));
+            }
+        }
+
+        #[rule]
+        fn remove_existing(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let keys: Vec<u32> = self.model.keys().copied().collect();
+            let idx = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+            let item = self.model.get(&keys[idx]).unwrap().clone();
+            let rw = self.db.rw_transaction().unwrap();
+            let removed = rw.remove(item.clone()).unwrap();
+            rw.commit().unwrap();
+            assert_eq!(removed, item);
+            self.model.remove(&item.id);
+        }
+
+        #[rule]
+        fn remove_arbitrary(&mut self, tc: TestCase) {
+            let item = draw_item(&tc);
+            let rw = self.db.rw_transaction().unwrap();
+            let result = rw.remove(item.clone());
+            match self.model.get(&item.id) {
+                None => {
+                    assert!(
+                        matches!(result, Err(db_type::Error::KeyNotFound { .. })),
+                        "expected KeyNotFound removing {item:?}, got {result:?}"
+                    );
+                    rw.abort().unwrap();
+                }
+                Some(stored) if *stored != item => {
+                    assert!(
+                        matches!(result, Err(db_type::Error::IncorrectInputData { .. })),
+                        "expected IncorrectInputData removing {item:?}, got {result:?}"
+                    );
+                    rw.abort().unwrap();
+                }
+                Some(_) => {
+                    assert_eq!(result.unwrap(), item);
+                    rw.commit().unwrap();
+                    self.model.remove(&item.id);
+                }
+            }
+        }
+
+        #[rule]
+        fn get_primary(&mut self, tc: TestCase) {
+            let id = draw_id(&tc);
+            let r = self.db.r_transaction().unwrap();
+            let got: Option<Item> = r.get().primary(id).unwrap();
+            assert_eq!(got.as_ref(), self.model.get(&id));
+        }
+
+        #[rule]
+        fn get_secondary_unique(&mut self, tc: TestCase) {
+            let code = draw_code(&tc);
+            let r = self.db.r_transaction().unwrap();
+            let got: Option<Item> = r.get().secondary(ItemKey::code, code.clone()).unwrap();
+            let want = self.model.values().find(|other| other.code == code).cloned();
+            assert_eq!(got, want);
+        }
+
+        #[rule]
+        fn scan_name_equal(&mut self, tc: TestCase) {
+            let name = draw_name(&tc);
+            let r = self.db.r_transaction().unwrap();
+            let got: Vec<Item> = r
+                .scan()
+                .secondary::<Item>(ItemKey::name)
+                .unwrap()
+                .equal(name.clone())
+                .unwrap()
+                .collect::<Result<_, _>>()
+                .unwrap();
+            // BTreeMap iterates in id order, matching the multimap's
+            // primary-key order within one secondary key group.
+            let want: Vec<Item> = self
+                .model
+                .values()
+                .filter(|other| other.name == name)
+                .cloned()
+                .collect();
+            assert_eq!(got, want);
+        }
+
+        #[invariant]
+        fn tables_match_model(&mut self, _tc: TestCase) {
+            let r = self.db.r_transaction().unwrap();
+
+            // Primary table: exact content, in primary-key order.
+            let got: Vec<Item> = r
+                .scan()
+                .primary::<Item>()
+                .unwrap()
+                .all()
+                .unwrap()
+                .collect::<Result<_, _>>()
+                .unwrap();
+            let want: Vec<Item> = self.model.values().cloned().collect();
+            assert_eq!(got, want, "primary table diverged from model");
+            assert_eq!(r.len().primary::<Item>().unwrap(), self.model.len() as u64);
+
+            // Non-unique secondary index `name`: every item exactly once,
+            // ordered by (name, id) — stale entries or missing updates show
+            // up here.
+            let got_by_name: Vec<Item> = r
+                .scan()
+                .secondary::<Item>(ItemKey::name)
+                .unwrap()
+                .all()
+                .unwrap()
+                .collect::<Result<_, _>>()
+                .unwrap();
+            let mut want_by_name = want.clone();
+            want_by_name.sort_by(|x, y| x.name.cmp(&y.name).then(x.id.cmp(&y.id)));
+            assert_eq!(got_by_name, want_by_name, "name index diverged from model");
+
+            // Unique secondary index `code`: every item exactly once, ordered
+            // by code.
+            let got_by_code: Vec<Item> = r
+                .scan()
+                .secondary::<Item>(ItemKey::code)
+                .unwrap()
+                .all()
+                .unwrap()
+                .collect::<Result<_, _>>()
+                .unwrap();
+            let mut want_by_code = want.clone();
+            want_by_code.sort_by(|x, y| x.code.cmp(&y.code));
+            assert_eq!(got_by_code, want_by_code, "code index diverged from model");
+        }
+    }
+
+    #[hegel::test]
+    fn pbt_db_matches_model_machine(tc: TestCase) {
+        let db = Builder::new().create_in_memory(&MODELS).unwrap();
+        hegel::stateful::run(
+            DbMachine {
+                db,
+                model: BTreeMap::new(),
+            },
+            tc,
+        );
+    }
+}
