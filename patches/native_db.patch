+// --- Property-based tests (hegel) ---
+
+// Property: a read-write transaction is atomic. After applying a random batch of
+// insert/upsert/remove operations, committing makes exactly the batch's effects
+// visible, while aborting leaves the database exactly in its pre-transaction
+// state — compared item-by-item against a BTreeMap model.
+#[hegel::test]
+fn pbt_commit_abort_atomicity(tc: hegel::TestCase) {
+    use hegel::generators;
+    use std::collections::BTreeMap;
+
+    let mut models = Models::new();
+    models.define::<Item>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    // Committed base state. Small key space so the ops below regularly collide.
+    let base_ids: Vec<u32> = tc.draw(
+        generators::vecs(generators::integers::<u32>().max_value(15)).unique(true),
+    );
+    let mut base: BTreeMap<u32, Item> = BTreeMap::new();
+    let rw = db.rw_transaction().unwrap();
+    for id in base_ids {
+        let item = Item {
+            id,
+            name: tc.draw(generators::text().max_size(4)),
+        };
+        rw.insert(item.clone()).unwrap();
+        base.insert(id, item);
+    }
+    rw.commit().unwrap();
+
+    // A batch of random operations in a second transaction.
+    let mut expected = base.clone();
+    let rw = db.rw_transaction().unwrap();
+    let n_ops = tc.draw(generators::integers::<usize>().max_value(12));
+    for _ in 0..n_ops {
+        let op = tc.draw(generators::integers::<u8>().max_value(2));
+        let id = tc.draw(generators::integers::<u32>().max_value(15));
+        match op {
+            0 => {
+                // insert: fails on an existing primary key, changes nothing
+                let item = Item {
+                    id,
+                    name: tc.draw(generators::text().max_size(4)),
+                };
+                let result = rw.insert(item.clone());
+                if expected.contains_key(&id) {
+                    assert!(
+                        matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+                        "expected DuplicateKey, got {result:?}"
+                    );
+                } else {
+                    result.unwrap();
+                    expected.insert(id, item);
+                }
+            }
+            1 => {
+                // upsert: always succeeds, returns the previous value
+                let item = Item {
+                    id,
+                    name: tc.draw(generators::text().max_size(4)),
+                };
+                let old = rw.upsert(item.clone()).unwrap();
+                assert_eq!(old, expected.insert(id, item));
+            }
+            _ => {
+                // remove: exact current value if present, otherwise KeyNotFound
+                if let Some(current) = expected.remove(&id) {
+                    let removed = rw.remove(current.clone()).unwrap();
+                    assert_eq!(removed, current);
+                } else {
+                    let result = rw.remove(Item {
+                        id,
+                        name: String::new(),
+                    });
+                    assert!(
+                        matches!(result, Err(db_type::Error::KeyNotFound { .. })),
+                        "expected KeyNotFound, got {result:?}"
+                    );
+                }
+            }
+        }
+    }
+
+    let commit = tc.draw(generators::booleans());
+    let final_expected = if commit {
+        rw.commit().unwrap();
+        expected
+    } else {
+        rw.abort().unwrap();
+        base
+    };
+
+    let r = db.r_transaction().unwrap();
+    let got: Vec<Item> = r
+        .scan()
+        .primary::<Item>()
+        .unwrap()
+        .all()
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+    let want: Vec<Item> = final_expected.into_values().collect();
+    assert_eq!(got, want);
+}
