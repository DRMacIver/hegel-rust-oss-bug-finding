+// Property: any item, whatever its primary key and (unicode) payload, can be
+// inserted and read back unchanged by primary key (serialize/deserialize + key
+// encoding round-trip).
+#[hegel::test]
+fn pbt_insert_get_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let id = tc.draw(generators::integers::<u32>());
+    let name = tc.draw(generators::text());
+    let item = Item { id, name };
+
+    let mut models = Models::new();
+    models.define::<Item>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    rw.insert(item.clone()).unwrap();
+    rw.commit().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let result_item: Item = r.get().primary(id).unwrap().unwrap();
+    assert_eq!(item, result_item);
+}
+
+// Property: inserting a second item with the same primary key always fails with
+// `DuplicateKey` and leaves the first item untouched (generalizes
+// `test_insert_duplicate_key` below).
+#[hegel::test]
+fn pbt_insert_duplicate_pk_rejected_db_unchanged(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let id = tc.draw(generators::integers::<u32>());
+    let first = Item {
+        id,
+        name: tc.draw(generators::text()),
+    };
+    let second = Item {
+        id,
+        name: tc.draw(generators::text()),
+    };
+
+    let mut models = Models::new();
+    models.define::<Item>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    rw.insert(first.clone()).unwrap();
+    let result = rw.insert(second);
+    assert!(
+        matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+        "expected DuplicateKey, got {result:?}"
+    );
+    rw.commit().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let result_item: Item = r.get().primary(id).unwrap().unwrap();
+    assert_eq!(first, result_item);
+}
