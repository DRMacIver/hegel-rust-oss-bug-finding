+        }
+        assert_eq!(is_nfd(&s), normalized == s);
+    }
+
+    #[hegel::test]
+    fn prop_quick_check_nfkc_consistent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let normalized = nfkc(&s);
+        match is_nfkc_quick(s.chars()) {
+            IsNormalized::Yes => assert_eq!(normalized, s),
