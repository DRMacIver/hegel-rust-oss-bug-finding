+    }
+
+    // --- Stream vs whole: the generic char-iterator adapters and the
+    // single-char impl must agree with the &str methods ---
+
+    #[hegel::test]
+    fn prop_iterator_adapters_match_str_methods(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        // `.map(|c| c)` makes the source a generic iterator, not str::Chars,
+        // so this goes through the blanket `impl UnicodeNormalization for I`.
+        assert_eq!(s.chars().map(|c| c).nfc().collect::<String>(), nfc(&s));
+        assert_eq!(s.chars().map(|c| c).nfd().collect::<String>(), nfd(&s));
+        assert_eq!(s.chars().map(|c| c).nfkc().collect::<String>(), nfkc(&s));
+        assert_eq!(s.chars().map(|c| c).nfkd().collect::<String>(), nfkd(&s));
+        // The `impl UnicodeNormalization for char` must match normalizing
+        // the equivalent one-char string.
+        if let Some(c) = s.chars().next() {
+            let one = c.to_string();
+            assert_eq!(c.nfc().collect::<String>(), nfc(&one));
+            assert_eq!(c.nfd().collect::<String>(), nfd(&one));
+        }
+    }
+
+    // --- Concatenation at a stable code point (UAX #15 §9.1): normalization
+    // forms are NOT closed under arbitrary concatenation, but splitting just
+    // before a *stable* code point (ccc == 0 and quick-check == Yes for the
+    // form) is documented safe: text before a stable code point never
+    // interacts with text after it. ---
+
+    fn norm_of(form: u8, s: &str) -> String {
+        match form {
+            0 => nfc(s),
+            1 => nfd(s),
+            2 => nfkc(s),
+            _ => nfkd(s),
+        }
+    }
+
+    fn quick_yes_char(form: u8, c: char) -> bool {
+        let it = core::iter::once(c);
+        let qc = match form {
+            0 => is_nfc_quick(it),
+            1 => is_nfd_quick(it),
+            2 => is_nfkc_quick(it),
+            _ => is_nfkd_quick(it),
+        };
+        qc == IsNormalized::Yes
+    }
+
+    #[hegel::test]
+    fn prop_concat_at_stable_code_point(tc: hegel::TestCase) {
+        let form = tc.draw(generators::integers::<u8>().max_value(3));
+        let a = tc.draw(unicode_string());
+        let b = tc.draw(unicode_string());
+        // Find a stable code point to start the second piece with; fall back
+        // to an ASCII letter (always stable) if the candidate isn't.
+        let cand = tc.draw(interesting_char());
+        let stable = if canonical_combining_class(cand) == 0 && quick_yes_char(form, cand) {
+            cand
+        } else {
+            'x'
+        };
+        let tail = format!("{}{}", stable, b);
+        let whole = format!("{}{}", a, tail);
+        assert_eq!(
+            norm_of(form, &whole),
+            format!("{}{}", norm_of(form, &a), norm_of(form, &tail)),
+            "form {} not stable across boundary before {:?}",
+            form,
+            stable
+        );
+    }
+
+    // --- Hangul: the composition/decomposition is algorithmic, so the
+    // UAX #15 Hangul arithmetic (transcribed here) is an independent
+    // spec oracle for nfc/nfd/decompose_canonical/compose ---
+
+    #[hegel::test]
+    fn prop_hangul_algorithmic_roundtrip(tc: hegel::TestCase) {
+        const S_BASE: u32 = 0xac00;
+        const L_BASE: u32 = 0x1100;
+        const V_BASE: u32 = 0x1161;
+        const T_BASE: u32 = 0x11a7;
+        const V_COUNT: u32 = 21;
+        const T_COUNT: u32 = 28;
+
+        let l = char::from_u32(tc.draw(
+            generators::integers::<u32>().min_value(0x1100).max_value(0x1112),
+        ))
+        .unwrap();
+        let v = char::from_u32(tc.draw(
+            generators::integers::<u32>().min_value(0x1161).max_value(0x1175),
+        ))
+        .unwrap();
+        let t = tc
+            .draw(generators::optional(
+                generators::integers::<u32>().min_value(0x11a8).max_value(0x11c2),
+            ))
+            .map(|n| char::from_u32(n).unwrap());
+
+        // Spec oracle: UAX #15 section 3.12 arithmetic.
+        let l_index = l as u32 - L_BASE;
+        let v_index = v as u32 - V_BASE;
+        let t_index = t.map_or(0, |t| t as u32 - T_BASE);
+        let syllable =
+            char::from_u32(S_BASE + (l_index * V_COUNT + v_index) * T_COUNT + t_index).unwrap();
+
+        let jamo: String = match t {
+            Some(t) => [l, v, t].iter().collect(),
+            None => [l, v].iter().collect(),
+        };
+        let syllable_str = syllable.to_string();
+
+        // NFC composes the jamo sequence into the computed syllable, and
+        // NFD decomposes the syllable back into the jamo sequence.
+        assert_eq!(nfc(&jamo), syllable_str);
+        assert_eq!(nfd(&syllable_str), jamo);
+
+        // char-level APIs agree with the arithmetic too.
+        let mut dec = String::new();
+        decompose_canonical(syllable, |c| dec.push(c));
+        assert_eq!(dec, jamo);
+        let lv = compose(l, v).expect("L+V must compose");
+        match t {
+            Some(t) => assert_eq!(compose(lv, t), Some(syllable)),
+            None => assert_eq!(lv, syllable),
+        }
+    }
+
+    // --- char::compose: if compose(a, b) == Some(c), then c is canonically
+    // equivalent to <a, b>, so both must have identical NFD and NFC ---
+
+    #[hegel::test]
+    fn prop_compose_result_canonically_equivalent(tc: hegel::TestCase) {
+        // Boost toward pairs that actually compose (ASCII vowels/consonants
+        // with the 0x300..0x30f accents, Hangul L+V), otherwise the Some
+        // branch is almost never reached in a default-sized run.
+        let a = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().min_value(0x41).max_value(0x7a),
+            generators::integers::<u32>().min_value(0x1100).max_value(0x1112),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('a')));
+        let a = if tc.draw(generators::booleans()) {
+            a
+        } else {
+            tc.draw(interesting_char())
+        };
+        let b = tc.draw(hegel::one_of!(
+            generators::integers::<u32>()
+                .min_value(0x300)
+                .max_value(0x30f)
+                .map(|n| char::from_u32(n).unwrap_or('\u{0301}')),
+            generators::integers::<u32>()
+                .min_value(0x1161)
+                .max_value(0x1175)
+                .map(|n| char::from_u32(n).unwrap_or('\u{1161}')),
+            combining_mark(),
+            interesting_char(),
+        ));
+        if let Some(c) = compose(a, b) {
+            let pair: String = [a, b].iter().collect();
+            let single = c.to_string();
+            assert_eq!(nfd(&single), nfd(&pair), "compose({:?},{:?})={:?}", a, b, c);
+            assert_eq!(nfc(&single), nfc(&pair), "compose({:?},{:?})={:?}", a, b, c);
+        }
+    }
+
+    // --- Structural invariants of decomposed forms: every char in NFD/NFKD
+    // output decomposes to itself (fully decomposed), and combining classes
+    // never strictly decrease inside a nonstarter run (canonical order).
+    // Checked with the char-level lookups, independent of the iterator's
+    // internal buffer-and-sort logic. ---
+
+    fn assert_fully_decomposed_and_ordered(out: &str, compat: bool) {
+        let mut prev_cc = 0u8;
+        for ch in out.chars() {
+            let mut dec = String::new();
+            if compat {
+                decompose_compatible(ch, |c| dec.push(c));
+            } else {
+                decompose_canonical(ch, |c| dec.push(c));
+            }
+            assert_eq!(
+                dec,
+                ch.to_string(),
+                "{:?} in output {:?} is not fully decomposed",
+                ch,
+                out
+            );
+            let cc = canonical_combining_class(ch);
+            assert!(
+                !(prev_cc > cc && cc != 0),
+                "canonical ordering violated at {:?} in {:?}",
+                ch,
+                out
+            );
+            prev_cc = cc;
+        }
+    }
+
+    #[hegel::test]
+    fn prop_nfd_output_fully_decomposed_and_ordered(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        assert_fully_decomposed_and_ordered(&nfd(&s), false);
+    }
+
+    #[hegel::test]
+    fn prop_nfkd_output_fully_decomposed_and_ordered(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        assert_fully_decomposed_and_ordered(&nfkd(&s), true);
+    }
+
+    // --- Stream-safe (UAX15-D4): the transform is idempotent, and its only
+    // edit is inserting CGJ (U+034F) — removing CGJs from the output of a
+    // CGJ-free input must give back the input ---
+
+    #[hegel::test]
+    fn prop_stream_safe_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let once: String = s.chars().stream_safe().collect();
+        let twice: String = once.chars().stream_safe().collect();
+        assert_eq!(twice, once);
+    }
+
+    #[hegel::test]
+    fn prop_stream_safe_only_inserts_cgj(tc: hegel::TestCase) {
+        let s: String = tc
+            .draw(unicode_string())
+            .chars()
+            .filter(|&c| c != '\u{034f}')
+            .collect();
+        let ss: String = s.chars().stream_safe().collect();
+        let without_cgj: String = ss.chars().filter(|&c| c != '\u{034f}').collect();
+        assert_eq!(without_cgj, s);
+    }
+}
