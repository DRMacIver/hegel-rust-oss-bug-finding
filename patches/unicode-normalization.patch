+/// Property-based tests (hegel) for the UAX #15 normalization laws.
+///
+/// hegeltest requires std, so these are gated on the `std` feature.
+#[cfg(feature = "std")]
+mod hegel_props {
+    use crate::char::{
+        canonical_combining_class, compose, decompose_canonical, decompose_compatible,
+    };
+    use crate::{
+        is_nfc, is_nfc_quick, is_nfd, is_nfd_quick, is_nfkc, is_nfkc_quick, is_nfkd,
+        is_nfkd_quick, IsNormalized, UnicodeNormalization,
+    };
+    use hegel::generators::{self, Generator};
+
+    fn nfc(s: &str) -> String {
+        s.nfc().collect()
+    }
+    fn nfd(s: &str) -> String {
+        s.nfd().collect()
+    }
+    fn nfkc(s: &str) -> String {
+        s.nfkc().collect()
+    }
+    fn nfkd(s: &str) -> String {
+        s.nfkd().collect()
+    }
+
+    /// A combining mark with a varied canonical combining class, so runs of
+    /// marks exercise the canonical-ordering (sorting) logic. Mixes the Latin
+    /// combining-diacritics block (ccc 220/230/232/233/234...) with specific
+    /// marks of unusual classes: overlays (ccc 1), nuktas (ccc 7), kana
+    /// voicing (ccc 8), Tibetan vowels (ccc 129/130/132), iota subscript
+    /// (ccc 240), and marks with composition behavior (0x0345, 0x3099).
+    #[hegel::composite]
+    fn combining_mark(tc: hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u32>().min_value(0x300).max_value(0x36f),
+            generators::sampled_from(vec![
+                0x0334_u32, // ccc 1 (overlay)
+                0x093c,  // ccc 7 (nukta)
+                0x3099,  // ccc 8 (kana voicing, composes)
+                0x309a,  // ccc 8
+                0x0f71,  // ccc 129
+                0x0f72,  // ccc 130
+                0x0f74,  // ccc 132
+                0x0f7a,  // ccc 130
+                0x0345,  // ccc 240 (iota subscript, composes)
+                0x05ae,  // ccc 228
+                0x0f80,  // ccc 130
+                0x0651,  // ccc 33 (shadda)
+                0x0e38,  // ccc 103
+                0x1d165, // ccc 216 (musical, stream-safe relevant)
+                0x1d16d, // ccc 226
+                0x20d0,  // ccc 230
+                0x034f,  // ccc 0! CGJ, blocks reordering
+            ]),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('\u{0301}')))
+    }
+
+    /// A single Unicode scalar value, boosted toward normalization-sensitive
+    /// regions: combining marks, precomposed Latin/Greek, Hangul syllables
+    /// and conjoining jamo (algorithmic composition), compatibility
+    /// characters, and singleton decompositions — plus the full range.
+    #[hegel::composite]
+    fn interesting_char(tc: hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            // ASCII (starters, always quick-check Yes)
+            generators::integers::<u32>().min_value(0x20).max_value(0x7e),
+            // Precomposed Latin (Latin-1 Supplement through Latin Extended-B)
+            generators::integers::<u32>().min_value(0xc0).max_value(0x2ff),
+            // Combining diacritical marks
+            generators::integers::<u32>().min_value(0x300).max_value(0x36f),
+            // Normalization-relevant specifics: singletons (0x2126, 0x212b),
+            // NFC_QC=No chars (0x0340, 0x0341, 0x0343, 0x0344), CGJ (0x034f),
+            // compat expansions (0x2026, 0xfb01, 0xfdfa), digraphs (0x01c4),
+            // precomposed-with-mark interactions (0x1e0b, 0x1e0d, 0x09be)
+            generators::sampled_from(vec![
+                0x00df_u32, 0x0130, 0x01c4, 0x0340, 0x0341, 0x0343, 0x0344, 0x034f, 0x05ae,
+                0x093c, 0x0958, 0x09be, 0x09c7, 0x0f71, 0x0f72, 0x0f73, 0x0f74, 0x0f75, 0x0f81,
+                0x1e0b, 0x1e0d, 0x1e9b, 0x2000, 0x2026, 0x2126, 0x212b, 0x2460, 0x3099, 0x309a,
+                0x309b, 0xfb01, 0xfdfa, 0xff76, 0xffe0, 0x1d160, 0x1d1c0, 0x2fa1d,
+            ]),
+            // Hangul syllables (algorithmic decomposition)
+            generators::integers::<u32>().min_value(0xac00).max_value(0xd7a3),
+            // Hangul conjoining jamo: bare L/V/T sequences and V/T following
+            // an LV/LVT syllable exercise algorithmic composition
+            generators::integers::<u32>().min_value(0x1100).max_value(0x11ff),
+            // CJK compatibility ideographs (singleton decompositions)
+            generators::integers::<u32>().min_value(0xf900).max_value(0xfaff),
+            // Halfwidth/fullwidth and other compatibility forms
+            generators::integers::<u32>().min_value(0xfe30).max_value(0xffef),
+            // Anywhere in the BMP
+            generators::integers::<u32>().max_value(0xffff),
+            // All of Unicode (surrogates mapped to U+FFFD)
+            generators::integers::<u32>().max_value(0x10ffff),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')))
+    }
+
+    /// Strings built from interesting chars, with occasional dense clusters
+    /// of combining marks: both short clusters (canonical-ordering-sensitive)
+    /// and 28+-mark runs (around the stream-safe MAX_NONSTARTERS boundary).
+    #[hegel::composite]
+    fn unicode_string(tc: hegel::TestCase) -> String {
+        let segments = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut s = String::new();
+        for _ in 0..segments {
+            s.push(tc.draw(interesting_char()));
+            if tc.draw(generators::booleans()) {
+                let marks = tc.draw(hegel::one_of!(
+                    generators::integers::<usize>().min_value(1).max_value(6),
+                    generators::integers::<usize>().min_value(28).max_value(36),
+                ));
+                for _ in 0..marks {
+                    s.push(tc.draw(combining_mark()));
+                }
+            }
+        }
+        s
+    }
+
+    // --- Idempotence: F(F(x)) == F(x) for each normalization form (UAX #15) ---
+
+    #[hegel::test]
+    fn prop_nfc_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let once = nfc(&s);
+        assert_eq!(nfc(&once), once);
+    }
+
+    #[hegel::test]
+    fn prop_nfd_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let once = nfd(&s);
+        assert_eq!(nfd(&once), once);
+    }
+
+    #[hegel::test]
+    fn prop_nfkc_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let once = nfkc(&s);
+        assert_eq!(nfkc(&once), once);
+    }
+
+    #[hegel::test]
+    fn prop_nfkd_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let once = nfkd(&s);
+        assert_eq!(nfkd(&once), once);
+    }
+
+    // --- Round-trip stability: x and NFD(x)/NFC(x) are canonically
+    // equivalent, so they must share both canonical normal forms ---
+
+    #[hegel::test]
+    fn prop_canonical_roundtrip_stability(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        assert_eq!(nfc(&nfd(&s)), nfc(&s));
+        assert_eq!(nfd(&nfc(&s)), nfd(&s));
+    }
+
+    // --- Inclusion: compatibility normalization subsumes canonical.
+    // Applying NFC/NFD/NFKD first must not change the NFKC/NFKD result
+    // (UAX #15 conformance: toNFKC(x) == toNFKC(toNFC(x)) etc.) ---
+
+    #[hegel::test]
+    fn prop_nfkc_subsumes_canonical(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let expected = nfkc(&s);
+        assert_eq!(nfkc(&nfc(&s)), expected);
+        assert_eq!(nfkc(&nfd(&s)), expected);
+        assert_eq!(nfkc(&nfkd(&s)), expected);
+    }
+
+    #[hegel::test]
+    fn prop_nfkd_subsumes_canonical(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let expected = nfkd(&s);
+        assert_eq!(nfkd(&nfc(&s)), expected);
+        assert_eq!(nfkd(&nfd(&s)), expected);
+        assert_eq!(nfkd(&nfkc(&s)), expected);
+    }
+
+    // --- Quick-check consistency: `is_nfX_quick` answering Yes/No must
+    // agree with the full normalization; `is_nfX` must equal `F(x) == x` ---
+
+    #[hegel::test]
+    fn prop_quick_check_nfc_consistent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let normalized = nfc(&s);
+        match is_nfc_quick(s.chars()) {
+            IsNormalized::Yes => assert_eq!(normalized, s),
