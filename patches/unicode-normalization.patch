+
+    #[hegel::test]
+    fn prop_quick_check_nfd_consistent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let normalized = nfd(&s);
+        match is_nfd_quick(s.chars()) {
+            IsNormalized::Yes => assert_eq!(normalized, s),
