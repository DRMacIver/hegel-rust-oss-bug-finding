+
+    #[hegel::test]
+    fn prop_quick_check_nfkd_consistent(tc: hegel::TestCase) {
+        let s = tc.draw(unicode_string());
+        let normalized = nfkd(&s);
+        match is_nfkd_quick(s.chars()) {
+            IsNormalized::Yes => assert_eq!(normalized, s),
