+
+/// Property-based tests written with hegel (https://hegel.dev).
+///
+/// These cover the core CRDT contracts of the public `loro` API:
+/// convergence of concurrent replicas, encode/decode round-trips,
+/// idempotent imports, container semantics against naive models,
+/// and time-travel determinism.
+mod hegel_pbt {
+    use hegel::generators;
+    use hegel::TestCase;
+    use loro::{
+        ExportMode, LoroDoc, LoroList, LoroMap, LoroMovableList, LoroText, LoroValue, ToJson,
+    };
+    use pretty_assertions::assert_eq;
+
+    // ---------- generators / helpers ----------
+
+    fn draw_char(tc: &TestCase) -> char {
+        let cp = tc.draw(hegel::one_of!(
+            // ASCII printable — keeps most strings readable in counterexamples
+            generators::integers::<u32>().min_value(0x20).max_value(0x7E),
+            // full codepoint range, including multi-byte UTF-8 and astral-plane
+            // chars whose utf8/utf16/unicode widths all differ
+            generators::integers::<u32>().max_value(0x10FFFF),
+        ));
+        char::from_u32(cp).unwrap_or('\u{FFFD}')
+    }
+
+    fn draw_string(tc: &TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(8));
+        (0..n).map(|_| draw_char(tc)).collect()
+    }
+
+    fn draw_value(tc: &TestCase) -> LoroValue {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => LoroValue::from(tc.draw(generators::integers::<i64>())),
+            1 => LoroValue::from(tc.draw(generators::booleans())),
+            2 => LoroValue::from(draw_string(tc)),
+            _ => LoroValue::Null,
+        }
+    }
+
+    fn draw_key(tc: &TestCase) -> String {
+        if tc.draw(generators::booleans()) {
+            // small pool so concurrent edits actually collide on the same key
+            tc.draw(generators::sampled_from(vec!["a", "b", "c", "d"]))
+                .to_string()
+        } else {
+            draw_string(tc)
+        }
+    }
+
+    /// Materialize all root containers used by `apply_random_edit`.
+    ///
+    /// Accessing a root container (e.g. `get_text`) registers it in the
+    /// *local* doc state (so it shows up in `get_deep_value` as an empty
+    /// container) without creating any op, and containers are never removed
+    /// from the state once registered. This local-only materialization is
+    /// documented loro behavior (`set_hide_empty_root_containers` exists for
+    /// it, and the upstream fuzzer's `assert_value_eq` normalizes empty
+    /// containers away). To keep deep-value comparisons sound we materialize
+    /// the same fixed set of roots on every doc that takes part in a
+    /// comparison, instead of weakening the equality check.
+    fn touch_roots(doc: &LoroDoc) {
+        let _ = doc.get_text("text");
+        let _ = doc.get_list("list");
+        let _ = doc.get_movable_list("mlist");
+        let _ = doc.get_map("map");
+        let _ = doc.get_counter("counter");
+    }
+
+    /// Apply one randomly drawn edit to one of the doc's root containers.
+    fn apply_random_edit(tc: &TestCase, doc: &LoroDoc) {
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => {
+                let text = doc.get_text("text");
+                let len = text.len_unicode();
+                if len == 0 || tc.draw(generators::booleans()) {
+                    let pos = tc.draw(generators::integers::<usize>().max_value(len));
+                    text.insert(pos, &draw_string(tc)).unwrap();
+                } else {
+                    let pos = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                    let dlen = tc.draw(
+                        generators::integers::<usize>()
+                            .min_value(1)
+                            .max_value(len - pos),
+                    );
+                    text.delete(pos, dlen).unwrap();
+                }
+            }
+            1 => {
+                let list = doc.get_list("list");
+                let len = list.len();
+                if len == 0 || tc.draw(generators::booleans()) {
+                    let pos = tc.draw(generators::integers::<usize>().max_value(len));
+                    list.insert(pos, draw_value(tc)).unwrap();
+                } else {
+                    let pos = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                    let dlen = tc.draw(
+                        generators::integers::<usize>()
+                            .min_value(1)
+                            .max_value(len - pos),
+                    );
+                    list.delete(pos, dlen).unwrap();
+                }
+            }
+            2 => {
+                let mlist = doc.get_movable_list("mlist");
+                let len = mlist.len();
+                let choice = if len == 0 {
+                    0
+                } else {
+                    tc.draw(generators::integers::<u8>().max_value(3))
+                };
+                match choice {
+                    0 => {
+                        let pos = tc.draw(generators::integers::<usize>().max_value(len));
+                        mlist.insert(pos, draw_value(tc)).unwrap();
+                    }
+                    1 => {
+                        let pos = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                        let dlen = tc.draw(
+                            generators::integers::<usize>()
+                                .min_value(1)
+                                .max_value(len - pos),
+                        );
+                        mlist.delete(pos, dlen).unwrap();
+                    }
+                    2 => {
+                        let from = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                        let to = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                        mlist.mov(from, to).unwrap();
+                    }
+                    _ => {
+                        let pos = tc.draw(generators::integers::<usize>().max_value(len - 1));
+                        mlist.set(pos, draw_value(tc)).unwrap();
+                    }
+                }
+            }
+            3 => {
+                let map = doc.get_map("map");
+                let key = draw_key(tc);
+                if tc.draw(generators::booleans()) {
+                    map.insert(&key, draw_value(tc)).unwrap();
+                } else {
+                    // deleting a missing key is documented to be a no-op-ish Ok(())
+                    map.delete(&key).unwrap();
+                }
+            }
+            _ => {
+                let counter = doc.get_counter("counter");
+                // integer-valued increments keep f64 sums exact regardless of
+                // the order replicas apply them in (this bound protects the
+                // test's convergence oracle, not the library's contract)
+                let v = tc.draw(
+                    generators::integers::<i32>()
+                        .min_value(-1000)
+                        .max_value(1000),
+                );
+                counter.increment(v as f64).unwrap();
+            }
+        }
+    }
+
+    /// One-way sync `from -> to` using a drawn transport encoding.
+    fn sync_one_way(tc: &TestCase, from: &LoroDoc, to: &LoroDoc) {
+        from.commit();
+        let bytes = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => from.export(ExportMode::updates(&to.oplog_vv())).unwrap(),
+            1 => from.export(ExportMode::all_updates()).unwrap(),
+            _ => from.export(ExportMode::Snapshot).unwrap(),
+        };
+        to.import(&bytes).unwrap();
+    }
+
+    /// Build a doc with a random (possibly multi-peer, merged) history.
+    /// Peer ids are `peer_base..peer_base + n`.
+    fn build_random_doc(tc: &TestCase, peer_base: u64) -> LoroDoc {
+        let n_peers = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        let docs: Vec<LoroDoc> = (0..n_peers)
+            .map(|i| {
+                let d = LoroDoc::new();
+                d.set_peer_id(peer_base + i as u64).unwrap();
+                d
+            })
+            .collect();
+        let n_edits = tc.draw(generators::integers::<usize>().max_value(15));
+        for _ in 0..n_edits {
+            let i = tc.draw(generators::integers::<usize>().max_value(n_peers - 1));
+            apply_random_edit(tc, &docs[i]);
+        }
+        for d in &docs {
+            d.commit();
+        }
+        for d in docs.iter().skip(1) {
+            let bytes = d.export(ExportMode::all_updates()).unwrap();
+            docs[0].import(&bytes).unwrap();
+        }
+        docs.into_iter().next().unwrap()
+    }
+
+    // ---------- Property 1 (crown): concurrent replicas converge ----------
+    //
+    // Several replicas edit concurrently, occasionally exchanging partial
+    // updates mid-stream (in drawn directions and drawn encodings). After a
+    // full mesh exchange they must be deep-equal and agree on version info.
+    #[hegel::test]
+    fn prop_concurrent_replicas_converge(tc: TestCase) {
+        let n_peers = tc.draw(generators::integers::<usize>().min_value(2).max_value(4));
+        let docs: Vec<LoroDoc> = (0..n_peers)
+            .map(|i| {
+                let d = LoroDoc::new();
+                d.set_peer_id(i as u64 + 1).unwrap();
+                // make locally-materialized empty root containers symmetric
+                // across replicas (see `touch_roots`)
+                touch_roots(&d);
+                d
+            })
+            .collect();
+
+        let n_actions = tc.draw(generators::integers::<usize>().min_value(1).max_value(40));
+        for _ in 0..n_actions {
+            let i = tc.draw(generators::integers::<usize>().max_value(n_peers - 1));
+            if tc.draw(generators::integers::<u8>().max_value(4)) == 0 {
+                // partial sync i -> j (j != i), leaving replicas divergent
+                let j_raw = tc.draw(generators::integers::<usize>().max_value(n_peers - 2));
+                let j = if j_raw >= i { j_raw + 1 } else { j_raw };
+                sync_one_way(&tc, &docs[i], &docs[j]);
+            } else {
+                apply_random_edit(&tc, &docs[i]);
+            }
+        }
+
+        // Full mesh exchange: every ordered pair, in a drawn order, twice.
+        // A single pass over all ordered pairs already delivers every
+        // replica's own ops to every other replica directly.
+        let mut pairs: Vec<(usize, usize)> = Vec::new();
+        for a in 0..n_peers {
+            for b in 0..n_peers {
+                if a != b {
+                    pairs.push((a, b));
+                }
+            }
+        }
+        for _pass in 0..2 {
+            for i in (1..pairs.len()).rev() {
+                let j = tc.draw(generators::integers::<usize>().max_value(i));
+                pairs.swap(i, j);
+            }
+            for &(a, b) in &pairs {
+                sync_one_way(&tc, &docs[a], &docs[b]);
+            }
+        }
+
+        let v0 = docs[0].get_deep_value();
+        let vv0 = docs[0].oplog_vv();
+        let f0 = docs[0].oplog_frontiers();
+        for d in docs.iter().skip(1) {
+            assert_eq!(v0, d.get_deep_value());
+            assert_eq!(vv0, d.oplog_vv());
+            assert_eq!(f0, d.oplog_frontiers());
+        }
+    }
