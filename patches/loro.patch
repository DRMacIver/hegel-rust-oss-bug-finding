+    // ---------- Property 9: checkout time-travel reproduces recorded states ----------
+    #[hegel::test]
+    fn prop_checkout_reproduces_recorded_states(tc: TestCase) {
+        let doc = build_random_doc(&tc, 1);
+        // Materialize all roots before recording the first checkpoint:
+        // containers are never removed from the state, so checking out to a
+        // version before a container was created leaves it present-but-empty.
+        // Recording checkpoints with all roots already materialized makes the
+        // recorded values comparable with post-checkout values.
+        touch_roots(&doc);
+        doc.commit();
+        let mut checkpoints = vec![(doc.state_frontiers(), doc.get_deep_value())];
+        let n_edits = tc.draw(generators::integers::<usize>().min_value(1).max_value(15));
+        for _ in 0..n_edits {
+            apply_random_edit(&tc, &doc);
+            doc.commit();
+            checkpoints.push((doc.state_frontiers(), doc.get_deep_value()));
+        }
+        let latest = doc.get_deep_value();
+        let n_checks = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+        for _ in 0..n_checks {
+            let idx =
+                tc.draw(generators::integers::<usize>().max_value(checkpoints.len() - 1));
+            let (frontiers, expected) = &checkpoints[idx];
+            doc.checkout(frontiers).unwrap();
+            assert_eq!(*expected, doc.get_deep_value());
+        }
+        doc.checkout_to_latest();
+        assert_eq!(latest, doc.get_deep_value());
+        assert!(!doc.is_detached());
+    }
