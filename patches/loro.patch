+    // ---------- Property 5: LoroText behaves like a string (model test) ----------
+
+    fn utf8_offset(model: &[char], char_idx: usize) -> usize {
+        model[..char_idx].iter().map(|c| c.len_utf8()).sum()
+    }
+
+    fn utf16_offset(model: &[char], char_idx: usize) -> usize {
+        model[..char_idx].iter().map(|c| c.len_utf16()).sum()
+    }
+
+    struct TextVsString {
+        _doc: LoroDoc,
+        text: LoroText,
+        model: Vec<char>,
+    }
+
+    #[hegel::state_machine]
+    impl TextVsString {
+        #[rule]
+        fn insert_unicode(&mut self, tc: TestCase) {
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let s = draw_string(&tc);
+            self.text.insert(pos, &s).unwrap();
+            self.model.splice(pos..pos, s.chars());
+        }
+
+        #[rule]
+        fn delete_unicode(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let len = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(self.model.len() - pos),
+            );
+            self.text.delete(pos, len).unwrap();
+            self.model.drain(pos..pos + len);
+        }
+
+        #[rule]
+        fn insert_utf8(&mut self, tc: TestCase) {
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let s = draw_string(&tc);
+            self.text.insert_utf8(utf8_offset(&self.model, pos), &s).unwrap();
+            self.model.splice(pos..pos, s.chars());
+        }
+
+        #[rule]
+        fn delete_utf8(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let len = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(self.model.len() - pos),
+            );
+            let b0 = utf8_offset(&self.model, pos);
+            let b1 = utf8_offset(&self.model, pos + len);
+            self.text.delete_utf8(b0, b1 - b0).unwrap();
+            self.model.drain(pos..pos + len);
+        }
+
+        #[rule]
+        fn insert_utf16(&mut self, tc: TestCase) {
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let s = draw_string(&tc);
+            self.text
+                .insert_utf16(utf16_offset(&self.model, pos), &s)
+                .unwrap();
+            self.model.splice(pos..pos, s.chars());
+        }
+
+        #[rule]
+        fn delete_utf16(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let len = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(self.model.len() - pos),
+            );
+            let u0 = utf16_offset(&self.model, pos);
+            let u1 = utf16_offset(&self.model, pos + len);
+            self.text.delete_utf16(u0, u1 - u0).unwrap();
+            self.model.drain(pos..pos + len);
+        }
+
+        #[rule]
+        fn splice_returns_deleted(&mut self, tc: TestCase) {
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let len = tc.draw(generators::integers::<usize>().max_value(self.model.len() - pos));
+            let s = draw_string(&tc);
+            let expected_removed: String = self.model[pos..pos + len].iter().collect();
+            let removed = self.text.splice(pos, len, &s).unwrap();
+            assert_eq!(expected_removed, removed);
+            self.model.splice(pos..pos + len, s.chars());
+        }
+
+        #[rule]
+        fn push_str(&mut self, tc: TestCase) {
+            let s = draw_string(&tc);
+            self.text.push_str(&s).unwrap();
+            self.model.extend(s.chars());
+        }
+
+        #[rule]
+        fn char_at_agrees(&self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            assert_eq!(self.model[pos], self.text.char_at(pos).unwrap());
+        }
+
+        #[rule]
+        fn slice_agrees(&self, tc: TestCase) {
+            let start = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let end = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(start)
+                    .max_value(self.model.len()),
+            );
+            let expected: String = self.model[start..end].iter().collect();
+            assert_eq!(expected, self.text.slice(start, end).unwrap());
+        }
+
+        #[rule]
+        fn misaligned_utf8_insert_errors(&mut self, tc: TestCase) {
+            // invalid external input must return Err, not panic (see AGENTS.md)
+            let mut bad_offsets = Vec::new();
+            let mut off = 0;
+            for c in &self.model {
+                let w = c.len_utf8();
+                for d in 1..w {
+                    bad_offsets.push(off + d);
+                }
+                off += w;
+            }
+            tc.assume(!bad_offsets.is_empty());
+            let idx = tc.draw(generators::integers::<usize>().max_value(bad_offsets.len() - 1));
+            assert!(self.text.insert_utf8(bad_offsets[idx], "x").is_err());
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: TestCase) {
+            let expected: String = self.model.iter().collect();
+            assert_eq!(expected, self.text.to_string());
+            assert_eq!(self.model.len(), self.text.len_unicode());
+            assert_eq!(expected.len(), self.text.len_utf8());
+            assert_eq!(
+                self.model.iter().map(|c| c.len_utf16()).sum::<usize>(),
+                self.text.len_utf16()
+            );
+        }
+    }
