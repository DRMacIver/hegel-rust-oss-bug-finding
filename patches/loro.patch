+    // ---------- Pinned known failures (real bugs, deliberately left failing) ----------
+
+    // KNOWN FAILURE: replicas with identical oplogs can render different
+    // deep values depending on how the same updates were batched into
+    // `import` calls.
+    //
+    // A counter whose increments sum to (approximately) zero within one
+    // imported batch never materializes the container on the receiving
+    // replica: `InternalDiff::Counter(c).is_empty()` treats `|c| < f64::EPSILON`
+    // as empty (crates/loro-internal/src/event.rs, `InternalDiff::is_empty`),
+    // and `DiffCalculator::calc_diff_internal`
+    // (crates/loro-internal/src/diff_calc.rs, `if !diff.is_empty() || bring_back`)
+    // then drops the diff entirely, so the container is never created in the
+    // receiver's state. A replica that receives the same ops split across two
+    // imports (each with a non-zero net diff) *does* create the container.
+    // Snapshot imports materialize it as well. The upstream fuzzer masks this
+    // by normalizing missing keys to `Double(0.)` in `assert_value_eq`
+    // (crates/fuzz/src/actor.rs).
+    //
+    // Minimal counterexample: peer 1 does `increment(v); commit; decrement(v);
+    // commit`. A replica importing both changes in one blob shows `{}`; a
+    // replica importing them as two blobs shows `{"counter": 0.0}`. Both have
+    // identical version vectors.
+    #[hegel::test]
+    fn prop_counter_zero_sum_import_batching_diverges_known_bug(tc: TestCase) {
+        let v = tc.draw(
+            generators::integers::<i32>()
+                .min_value(1)
+                .max_value(1000),
+        ) as f64;
+        let origin = LoroDoc::new();
+        origin.set_peer_id(1).unwrap();
+        let counter = origin.get_counter("counter");
+        counter.increment(v).unwrap();
+        origin.commit();
+        let mid_vv = origin.oplog_vv();
+        counter.decrement(v).unwrap();
+        origin.commit();
+
+        let two_batches = LoroDoc::new();
+        two_batches.set_peer_id(2).unwrap();
+        two_batches
+            .import(&origin.export(ExportMode::updates_till(&mid_vv)).unwrap())
+            .unwrap();
+        two_batches
+            .import(&origin.export(ExportMode::updates(&mid_vv)).unwrap())
+            .unwrap();
+
+        let one_batch = LoroDoc::new();
+        one_batch.set_peer_id(3).unwrap();
+        one_batch
+            .import(&origin.export(ExportMode::all_updates()).unwrap())
+            .unwrap();
+
+        // Same history on both replicas...
+        assert_eq!(two_batches.oplog_vv(), one_batch.oplog_vv());
+        // ...but different visible state (two_batches has {"counter": 0.0},
+        // one_batch has {}). This assertion fails deterministically.
+        assert_eq!(two_batches.get_deep_value(), one_batch.get_deep_value());
+    }
+
+    // KNOWN FAILURE: `export(ExportMode::ShallowSnapshot(frontiers))` can
+    // succeed yet produce bytes that *cannot be imported*
+    // (`Err(SwitchToVersionBeforeShallowRoot)`), losing the document.
+    //
+    // With >= 3 concurrent frontier tips, `calc_shallow_doc_start`
+    // (crates/loro-internal/src/encoding/shallow_snapshot.rs) reduces the
+    // frontiers by pairwise common ancestors; when a pair of concurrent tips
+    // has an empty GCA the pair is dropped and the odd tip out is kept, so
+    // the loop converges to a single tip that does NOT dominate the others
+    // (instead of falling back to empty frontiers / full history as the
+    // fallback comment intends). The exported snapshot is then shallow-rooted
+    // at a version concurrent with retained ops, and importing it fails.
+    // The trigger needs the surviving tip's change to have counter > 0, and
+    // the upstream fuzzer ignores shallow export/import errors
+    // (`let _ = ...export(...)` in crates/fuzz/src/crdt_fuzzer.rs), so it
+    // never sees this.
+    //
+    // Minimal counterexample: peer 1 inserts then deletes one char (tip 1@1),
+    // peers 2 and 3 each insert one char concurrently (tips 0@2, 0@3); merge
+    // everything into peer 1's doc and export a shallow snapshot at the
+    // doc's own current frontiers. Import into a fresh doc fails.
+    #[hegel::test]
+    fn prop_shallow_snapshot_of_concurrent_tips_is_importable_known_bug(tc: TestCase) {
+        let c = draw_char(&tc).to_string();
+        let d1 = LoroDoc::new();
+        d1.set_peer_id(1).unwrap();
+        d1.get_text("text").insert(0, &c).unwrap();
+        d1.get_text("text").delete(0, 1).unwrap();
+        d1.commit();
+        let d2 = LoroDoc::new();
+        d2.set_peer_id(2).unwrap();
+        d2.get_text("text").insert(0, &c).unwrap();
+        d2.commit();
+        let d3 = LoroDoc::new();
+        d3.set_peer_id(3).unwrap();
+        d3.get_text("text").insert(0, &c).unwrap();
+        d3.commit();
+        d1.import(&d2.export(ExportMode::all_updates()).unwrap())
+            .unwrap();
+        d1.import(&d3.export(ExportMode::all_updates()).unwrap())
+            .unwrap();
+
+        let frontiers = d1.oplog_frontiers();
+        assert_eq!(frontiers.len(), 3);
+        let bytes = d1.export(ExportMode::shallow_snapshot(&frontiers)).unwrap();
+        let fresh = LoroDoc::new();
+        // Fails deterministically with Err(SwitchToVersionBeforeShallowRoot):
+        // the export succeeded but its output is unimportable.
+        fresh.import(&bytes).unwrap();
+        touch_roots(&d1);
+        touch_roots(&fresh);
+        assert_eq!(d1.get_deep_value(), fresh.get_deep_value());
+    }
+}
