index 42df863..0804c65 100644
--- a/crates/loro/tests/loro_rust_test.rs
+++ b/crates/loro/tests/loro_rust_test.rs
@@ -3642,3 +3642,950 @@ fn has_container_test() {
     assert!(doc.has_container(&text.id()));
