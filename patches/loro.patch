+    // ---------- Property 4: importing the same blob again is a no-op ----------
+    #[hegel::test]
+    fn prop_import_is_idempotent(tc: TestCase) {
+        let source = build_random_doc(&tc, 1);
+        source.commit();
+        let bytes = if tc.draw(generators::booleans()) {
+            source.export(ExportMode::all_updates()).unwrap()
+        } else {
+            source.export(ExportMode::Snapshot).unwrap()
+        };
+        // target may already have its own (disjoint-peer) history
+        let target = if tc.draw(generators::booleans()) {
+            build_random_doc(&tc, 100)
+        } else {
+            LoroDoc::new()
+        };
+        target.import(&bytes).unwrap();
+        let value_once = target.get_deep_value();
+        let vv_once = target.oplog_vv();
+        let frontiers_once = target.oplog_frontiers();
+        let n_extra = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        for _ in 0..n_extra {
+            target.import(&bytes).unwrap();
+        }
+        assert_eq!(value_once, target.get_deep_value());
+        assert_eq!(vv_once, target.oplog_vv());
+        assert_eq!(frontiers_once, target.oplog_frontiers());
