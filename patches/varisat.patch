+            solver.add_formula(&CnfFormula::from(clauses.iter().cloned()));
+            solver.assume(&assumptions);
+
+            if solver.solve().ok() == Some(false) {
+                let core = solver.failed_core().unwrap().to_owned();
+
+                for lit in core.iter() {
+                    assert!(
