+                        "core literal {:?} is not an assumption",
+                        lit
+                    );
+                }
+
+                let mut all_clauses = clauses.clone();
+                all_clauses.extend(core.iter().map(|&lit| vec![lit]));
+                assert!(
+                    !brute_force_is_sat(8, &all_clauses),
+                    "formula plus failed core {:?} is satisfiable",
+                    core
+                );
+            }
+        }
+    }
