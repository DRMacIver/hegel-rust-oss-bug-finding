+        /// `sgen_unsat_incremental_clauses` test, which only checks the SAT -> UNSAT
+        /// transition).
+        #[hegel::test]
+        fn hegel_incremental_solves_match_brute_force(tc: TestCase) {
+            let clauses = tc.draw(small_clause_list(6, 12));
+
+            let mut solver = Solver::new();
+
+            for (i, clause) in clauses.iter().enumerate() {
+                solver.add_clause(clause);
+
+                let expected = brute_force_is_sat(6, &clauses[..i + 1]);
+                assert_eq!(solver.solve().ok(), Some(expected));
+            }
+        }
+
+        /// Stateful model test: drive a single solver through interleaved clause additions,
+        /// assumption changes and solve calls, checking each solve result against the
+        /// brute-force oracle and each model against the formula and assumptions.
+        struct SolverModelMachine {
+            solver: Solver<'static>,
+            clauses: Vec<Vec<Lit>>,
+            assumptions: Vec<Lit>,
+        }
+
+        // Clause literals use vars 0..6, assumptions use vars 0..8, so a brute force over 8
+        // variables covers all of them.
+        const MACHINE_VARS: usize = 8;
+
+        #[hegel::state_machine]
+        impl SolverModelMachine {
+            #[rule]
+            fn add_clause(&mut self, tc: TestCase) {
+                let clause: Vec<Lit> = tc.draw(generators::vecs(arb_lit(6)).max_size(4));
+                self.solver.add_clause(&clause);
+                self.clauses.push(clause);
+            }
+
+            #[rule]
+            fn assume(&mut self, tc: TestCase) {
+                let assumptions: Vec<Lit> =
+                    tc.draw(generators::vecs(arb_lit(MACHINE_VARS)).max_size(4));
+                self.solver.assume(&assumptions);
+                self.assumptions = assumptions;
+            }
+
+            #[rule]
+            fn clear_assumptions(&mut self, _: TestCase) {
+                self.solver.assume(&[]);
+                self.assumptions.clear();
+            }
+
+            #[rule]
+            fn solve(&mut self, _: TestCase) {
+                let result = self.solver.solve().expect("unexpected solver error");
+
+                let mut all_clauses = self.clauses.clone();
+                all_clauses.extend(self.assumptions.iter().map(|&lit| vec![lit]));
+                let expected = brute_force_is_sat(MACHINE_VARS, &all_clauses);
+
+                assert_eq!(result, expected);
+
+                if result {
+                    let model = self.solver.model().unwrap();
+                    assert!(
+                        model_satisfies(&model, self.clauses.iter()),
+                        "model {:?} does not satisfy formula",
+                        model
+                    );
+                    for &lit in self.assumptions.iter() {
+                        assert!(
+                            model.contains(&lit),
+                            "model {:?} does not satisfy assumption {:?}",
+                            model,
+                            lit
+                        );
+                    }
+                }
+            }
+        }
+
+        #[hegel::test]
+        fn hegel_solver_model_machine(tc: TestCase) {
+            let machine = SolverModelMachine {
+                solver: Solver::new(),
+                clauses: vec![],
+                assumptions: vec![],
+            };
+            hegel::stateful::run(machine, tc);
+        }
+    }
