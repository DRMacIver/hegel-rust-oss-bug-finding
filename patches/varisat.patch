+    mod hegel_tests {
+        use super::*;
+
+        use hegel::generators::{self, Generator};
+        use hegel::TestCase;
+
+        use varisat_dimacs::write_dimacs;
+
+        use crate::test_helpers::{
+            arb_lit, brute_force_is_sat, model_satisfies, sat_formula, sgen_unsat_formula,
+            small_clause_list,
+        };
+
+        /// The crown property for a SAT solver: on small arbitrary formulas the solve result
+        /// must match a brute-force check over all assignments, and any returned model must
+        /// satisfy every clause.
+        #[hegel::test]
+        fn hegel_solve_matches_brute_force(tc: TestCase) {
+            let clauses = tc.draw(small_clause_list(8, 30));
+
+            let mut solver = Solver::new();
+            solver.add_formula(&CnfFormula::from(clauses.iter().cloned()));
+
+            let expected = brute_force_is_sat(8, &clauses);
+            assert_eq!(solver.solve().ok(), Some(expected));
+
+            if expected {
+                let model = solver.model().unwrap();
+                assert!(
+                    model_satisfies(&model, clauses.iter()),
+                    "model {:?} does not satisfy formula",
+                    model
+                );
+            } else {
+                assert_eq!(solver.model(), None);
+            }
+        }
+
+        /// Hegel port of the proptest `sat` test: a formula constructed to be satisfiable must
+        /// be reported SAT and the model must satisfy every clause.
+        #[hegel::test]
+        fn hegel_sat_formula_has_valid_model(tc: TestCase) {
+            let formula = tc.draw(sat_formula());
+            let test_schedule = tc.draw(generators::booleans());
+
+            let mut solver = Solver::new();
+            solver.add_formula(&formula);
+
+            if test_schedule {
+                enable_test_schedule(&mut solver);
+            }
+
+            assert_eq!(solver.solve().ok(), Some(true));
+
+            let model = solver.model().unwrap();
+            assert!(model_satisfies(&model, formula.iter()));
+        }
+
+        /// Hegel port of the proptest `sgen_unsat` test: hard unsat instances must be reported
+        /// UNSAT.
+        #[hegel::test]
+        fn hegel_sgen_unsat(tc: TestCase) {
+            let formula = tc.draw(sgen_unsat_formula(6));
+            let test_schedule = tc.draw(generators::booleans());
+
+            let mut solver = Solver::new();
+            solver.add_formula(&formula);
+
+            if test_schedule {
+                enable_test_schedule(&mut solver);
+            }
+
+            assert_eq!(solver.solve().ok(), Some(false));
+        }
+
+        /// Hegel port of the proptest `sgen_unsat_checked` test: the same as `hegel_sgen_unsat`
+        /// but with on-the-fly proof checking enabled, using the checker as an oracle for the
+        /// generated proof.
+        #[hegel::test]
+        fn hegel_sgen_unsat_checked(tc: TestCase) {
+            let formula = tc.draw(sgen_unsat_formula(6));
+            let test_schedule = tc.draw(generators::booleans());
+
+            let mut solver = Solver::new();
+            solver.enable_self_checking();
+            solver.add_formula(&formula);
+
+            if test_schedule {
+                enable_test_schedule(&mut solver);
+            }
+
+            assert_eq!(solver.solve().ok(), Some(false));
+        }
+
+        /// With self checking enabled, solving arbitrary small formulas must still agree with
+        /// the brute-force oracle. A proof-checking failure surfaces as a solve error, so this
+        /// also validates the generated proofs for SAT and UNSAT outcomes.
+        #[hegel::test]
+        fn hegel_self_checked_solve_matches_brute_force(tc: TestCase) {
+            let clauses = tc.draw(small_clause_list(8, 30));
+
+            let mut solver = Solver::new();
+            solver.enable_self_checking();
+            solver.add_formula(&CnfFormula::from(clauses.iter().cloned()));
+
+            let expected = brute_force_is_sat(8, &clauses);
+            assert_eq!(solver.solve().ok(), Some(expected));
+        }
+
+        /// Hegel port of the proptest `sat_via_dimacs` test: feeding a satisfiable formula
+        /// through the DIMACS writer and incremental DIMACS parser must produce SAT and a model
+        /// of the original formula.
+        #[hegel::test]
+        fn hegel_sat_via_dimacs(tc: TestCase) {
+            let formula = tc.draw(sat_formula());
+
+            let mut dimacs = vec![];
+            write_dimacs(&mut dimacs, &formula).unwrap();
+
+            let mut solver = Solver::new();
+            solver.add_dimacs_cnf(&mut &dimacs[..]).unwrap();
+
+            assert_eq!(solver.solve().ok(), Some(true));
+
+            let model = solver.model().unwrap();
+            assert!(model_satisfies(&model, formula.iter()));
+        }
+
+        /// Round-trip: writing a formula as DIMACS and parsing it back must reproduce the
+        /// formula exactly, including the variable count from the header (hegel port of the
+        /// `roundtrip` proptest in varisat-dimacs).
+        #[hegel::test]
+        fn hegel_dimacs_roundtrip(tc: TestCase) {
+            let var_count = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(100),
+            );
+            let min_clauses = tc.draw(generators::integers::<usize>().max_value(60));
+            let clauses: Vec<Vec<Lit>> = tc.draw(
+                generators::vecs(generators::vecs(arb_lit(var_count)).max_size(9))
+                    .min_size(min_clauses),
+            );
+
+            let mut formula = CnfFormula::from(clauses.iter().cloned());
+            // Also cover headers that declare more variables than are used in clauses.
+            let padding = tc.draw(generators::integers::<usize>().max_value(10));
+            formula.set_var_count(formula.var_count() + padding);
+
+            let mut buf = vec![];
+            write_dimacs(&mut buf, &formula).unwrap();
+
+            let parsed = DimacsParser::parse(&buf[..]).unwrap();
+            assert_eq!(parsed, formula);
+        }
+
+        /// Parse robustness: the DIMACS parser must return an error, never panic, on arbitrary
+        /// input bytes.
+        #[hegel::test]
+        fn hegel_dimacs_parse_no_panic(tc: TestCase) {
+            let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+                generators::binary().boxed(),
+                generators::text().map(String::into_bytes).boxed(),
+                // DIMACS-like character soup to reach deeper parser states.
+                generators::from_regex(r"[-pc cnf0-9\r\n\t]{0,200}")
+                    .map(String::into_bytes)
+                    .boxed(),
+            ));
+
+            let _ = DimacsParser::parse(&bytes[..]);
+        }
+
+        /// Incremental solving: after each added clause the solve result must match the
