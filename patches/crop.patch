+/// Property-based version of `byte_slice_random`: repeatedly byte-slicing a
+/// `Rope`/`RopeSlice` of arbitrary Unicode text always matches the
+/// equivalent `str` slice.
+#[hegel::test]
+fn byte_slices_match_str_slices(tc: hegel::TestCase) {
+    let s = tc.draw(common::rope_text());
+    let r = Rope::from(s.as_str());
+
+    let mut str_slice = &s[..];
+    let mut rope_slice = r.byte_slice(..);
+
+    let depth = tc.draw(generators::integers::<usize>().max_value(8));
+
+    for _ in 0..depth {
+        rope_slice.assert_invariants();
+        assert_eq!(rope_slice, str_slice);
+        assert_eq!(rope_slice.byte_len(), str_slice.len());
+
+        let (start, end) = common::draw_char_range(&tc, str_slice);
+        str_slice = &str_slice[start..end];
+        rope_slice = rope_slice.byte_slice(start..end);
+    }
+
+    rope_slice.assert_invariants();
+    assert_eq!(rope_slice, str_slice);
+}
+
+/// `line_slice(start..end)` returns exactly the text between the start of
+/// line `start` and the start of line `end` (line terminators included),
+/// per the `line_slice()` docs.
+#[hegel::test]
+fn line_slices_match_str_slices(tc: hegel::TestCase) {
+    let s = tc.draw(common::rope_text());
+    let r = Rope::from(s.as_str());
+
+    let line_len = s.lines().count();
+    let a = tc.draw(generators::integers::<usize>().max_value(line_len));
+    let b = tc.draw(generators::integers::<usize>().max_value(line_len));
+    let (start, end) = (a.min(b), a.max(b));
+
+    let expected = &s
+        [common::str_byte_of_line(&s, start)..common::str_byte_of_line(&s, end)];
+
+    let slice = r.line_slice(start..end);
+    slice.assert_invariants();
+    assert_eq!(slice, expected);
+}
