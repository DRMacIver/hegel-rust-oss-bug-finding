+/// Generates arbitrary Unicode text with a boosted density of line
+/// terminators (LF, CRLF, lone CR), Unicode "line break" code points that
+/// crop must *not* treat as line breaks (NEL, VT, FF, LS, PS), and
+/// supplementary-plane characters (relevant for the utf16-metric feature).
+#[hegel::composite]
+pub fn text_with_line_breaks(tc: hegel::TestCase) -> String {
+    let n = tc.draw(generators::integers::<usize>().max_value(24));
+    let segments: Vec<String> = tc.draw(
+        generators::vecs(hegel::one_of!(
+            generators::text().max_size(12),
+            generators::sampled_from(
+                [
+                    "\n", "\r\n", "\r", "\u{85}", "\u{b}", "\u{c}",
+                    "\u{2028}", "\u{2029}", "ß", "🐸", "𐐀", "🇷🇸", "🐻‍❄️",
+                ]
+                .iter()
+                .map(|s| s.to_string())
+                .collect::<Vec<_>>(),
+            ),
+        ))
+        .min_size(n),
+    );
+    segments.concat()
+}
+
+/// Generates text big enough to force a multi-level B-tree: in non-test
+/// builds of the crate (which is what integration tests link against) each
+/// leaf holds up to 2048 bytes and internal nodes have an arity of 16, so
+/// ~100KB of text yields a tree of depth >= 3.
+#[hegel::composite]
+pub fn large_text(tc: hegel::TestCase) -> String {
+    let target_len =
+        tc.draw(generators::integers::<usize>().max_value(96 * 1024));
+    let seed = tc.draw(text_with_line_breaks());
+    let seed = if seed.is_empty() { String::from("a\n") } else { seed };
+    let mut text = String::with_capacity(target_len + seed.len());
+    while text.len() < target_len {
+        text.push_str(&seed);
+    }
+    text
+}
+
+/// Generates either small varied text or large repetitive text (see
+/// [`large_text`] for why large inputs matter).
+#[hegel::composite]
+pub fn rope_text(tc: hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(text_with_line_breaks(), large_text()))
+}
+
+/// Draws an arbitrary char-boundary byte offset in `s` (snapping upwards,
+/// like the crate's own fuzz target does).
+pub fn draw_char_boundary(tc: &hegel::TestCase, s: &str) -> usize {
+    let mut offset =
+        tc.draw(generators::integers::<usize>().max_value(s.len()));
+    while !s.is_char_boundary(offset) {
+        offset += 1;
+    }
+    offset
+}
+
+/// Draws an arbitrary char-boundary byte range in `s`.
+pub fn draw_char_range(tc: &hegel::TestCase, s: &str) -> (usize, usize) {
+    let a = draw_char_boundary(tc, s);
+    let b = draw_char_boundary(tc, s);
+    (a.min(b), a.max(b))
+}
+
+/// Reference implementation of `Rope::byte_of_line()`: the byte offset of
+/// the start of line `line_offset`, i.e. the offset right after the
+/// `line_offset`-th LF, or the total length if there aren't that many LFs.
+pub fn str_byte_of_line(s: &str, line_offset: usize) -> usize {
+    if line_offset == 0 {
+        return 0;
+    }
+    let mut seen = 0;
+    for (idx, byte) in s.bytes().enumerate() {
+        if byte == b'\n' {
+            seen += 1;
+            if seen == line_offset {
+                return idx + 1;
+            }
+        }
+    }
+    s.len()
+}
+
