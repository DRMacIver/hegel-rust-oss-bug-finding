index 91f57d2..b1d4d0b 100644
--- a/rkyv/src/impls/alloc/collections/btree_map.rs
+++ b/rkyv/src/impls/alloc/collections/btree_map.rs
@@ -309,4 +309,59 @@ mod tests {
             container.check(expected);
         }
     }
+
+    // Hegel property: an archived B-tree map built from generated contents
+    // matches the source map: same length, iteration yields the same entries
+    // in the same (sorted) order, lookups agree (including a probe key that
+    // is usually absent), and deserialization returns the original map. The
+    // size is drawn explicitly up to 300 so that multi-level trees are
+    // exercised (branching factor 6; see
+    // `roundtrip_btree_map_increasing_sizes`).
+    #[cfg(feature = "std")]
+    #[hegel::test]
+    fn roundtrip_generated_btree_map_deep(tc: hegel::TestCase) {
+        use hegel::generators;
+
+        use crate::api::test::deserialize;
+
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let pairs: Vec<(String, i32)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::text().max_size(12),
+                generators::integers::<i32>(),
+            ))
+            .min_size(n),
+        );
+        let map: BTreeMap<String, i32> = pairs.into_iter().collect();
+        let probe: String = tc.draw(generators::text().max_size(12));
+
+        to_archived(&map, |archived| {
+            assert_eq!(archived.len(), map.len());
+
+            // Iteration over the archived tree matches the sorted iteration
+            // order of the source map exactly.
+            let mut entries = map.iter();
+            for (k, v) in archived.iter() {
+                let (ek, ev) = entries.next().unwrap();
+                assert_eq!(k.as_str(), ek);
+                assert_eq!(v.to_native(), *ev);
+            }
+            assert!(entries.next().is_none());
+
+            // Lookups agree with the source map.
+            for (k, v) in map.iter() {
+                assert_eq!(
+                    archived.get(k.as_str()).map(|v| v.to_native()),
+                    Some(*v)
+                );
+            }
+            assert_eq!(
+                archived.contains_key(probe.as_str()),
+                map.contains_key(&probe)
+            );
+
+            let deserialized: BTreeMap<String, i32> = deserialize(&*archived);
+            assert_eq!(deserialized, map);
+        });
+    }
 }
