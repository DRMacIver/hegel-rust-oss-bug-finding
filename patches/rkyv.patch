-#[derive(Archive, Deserialize, Serialize)]
+#[derive(Archive, Deserialize, Serialize, Debug)]
 struct ComplexBag {
     names: Vec<String>,
     counters: Option<HashMap<String, u32>>,
@@ -45,3 +45,230 @@ fuzz_target!(
     hashmap_archivedstring_deserialize_segv_alt_vec_wrapper
         as Vec<HashMap<String, String>>
 );
+
+// Hegel property-based robustness tests. These check rkyv's core safety
+// promise: the checked access path (`access`/`from_bytes`) must return an
+// error on untrusted or corrupted input -- it must never panic or read out
+// of bounds. The `.bin` regression tests above pin inputs that violated this
+// in the past; these properties search for new ones.
+mod hegel_robustness {
+    use std::collections::HashMap;
+
+    use hegel::generators;
+    use rkyv::{
+        access, access_unchecked, deserialize, from_bytes, rancor::Error,
+        to_bytes, util::AlignedVec, Archived,
+    };
+
+    use super::ComplexBag;
+
+    #[hegel::composite]
+    fn complex_bags(tc: hegel::TestCase) -> ComplexBag {
+        let counters = if tc.draw(generators::booleans()) {
+            Some(tc.draw(
+                generators::hashmaps(
+                    generators::text().max_size(12),
+                    generators::integers::<u32>(),
+                )
+                .max_size(6),
+            ))
+        } else {
+            None
+        };
+        ComplexBag {
+            names: tc.draw(
+                generators::vecs(generators::text().max_size(12)).max_size(6),
+            ),
+            counters,
+            payload: Box::new(
+                tc.draw(
+                    generators::vecs(generators::integers::<u64>())
+                        .max_size(8),
+                ),
+            ),
+            flag: tc.draw(generators::booleans()),
+        }
+    }
+
+    // Property: `from_bytes` (validated access + deserialize) on completely
+    // arbitrary bytes returns without panicking. This is the same property
+    // the crate's own fuzz targets check, with the same target types.
+    #[hegel::test]
+    fn from_bytes_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(256));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n));
+        let _ = from_bytes::<ComplexBag, Error>(&data);
+        let _ = from_bytes::<HashMap<String, Vec<u32>>, Error>(&data);
+    }
+
+    // Property: flipping arbitrary bits in a valid archive must not cause
+    // `access` to panic; it may either detect the corruption (Err) or accept
+    // a still-valid archive (Ok), in which case deserialization must also be
+    // safe. The buffer stays in an `AlignedVec` so corruption -- not
+    // misalignment -- is what validation sees.
+    #[hegel::test]
+    fn access_bit_flipped_archive_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw(complex_bags());
+        let mut bytes = to_bytes::<Error>(&value).unwrap();
+        assert!(!bytes.is_empty());
+
+        let flips =
+            tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        for _ in 0..flips {
+            let bit = tc.draw(
+                generators::integers::<usize>()
+                    .max_value(bytes.len() * 8 - 1),
+            );
+            bytes[bit / 8] ^= 1 << (bit % 8);
+        }
+
+        if let Ok(archived) = access::<Archived<ComplexBag>, Error>(&bytes) {
+            // Validation accepted the mutated buffer, so it must also be
+            // safe to deserialize.
+            let _ = deserialize::<ComplexBag, Error>(archived);
+        }
+    }
+
+    // Property: truncating a valid archive must not cause `access` to panic,
+    // and any buffer too small to hold the root must be rejected.
+    #[hegel::test]
+    fn access_truncated_archive_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw(complex_bags());
+        let bytes = to_bytes::<Error>(&value).unwrap();
+
+        let new_len = tc.draw(
+            generators::integers::<usize>().max_value(bytes.len() - 1),
+        );
+        let truncated = &bytes[..new_len];
+
+        let result = access::<Archived<ComplexBag>, Error>(truncated);
+        if new_len < size_of::<Archived<ComplexBag>>() {
+            assert!(result.is_err());
+        }
+        if let Ok(archived) = result {
+            let _ = deserialize::<ComplexBag, Error>(archived);
+        }
+    }
+
+    // Property: checked and unchecked access agree on a valid archive: they
+    // return the same root reference, and the value deserialized through the
+    // unchecked path equals the original.
+    #[hegel::test]
+    fn checked_and_unchecked_access_agree(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(48));
+        let value: HashMap<String, String> = tc.draw(
+            generators::hashmaps(
+                generators::text().max_size(12),
+                generators::text().max_size(12),
+            )
+            .min_size(n),
+        );
+        let bytes = to_bytes::<Error>(&value).unwrap();
+
+        let checked =
+            access::<Archived<HashMap<String, String>>, Error>(&bytes)
+                .unwrap();
+        let unchecked = unsafe {
+            access_unchecked::<Archived<HashMap<String, String>>>(&bytes)
+        };
+        assert!(std::ptr::eq(checked, unchecked));
+
+        let roundtripped: HashMap<String, String> =
+            deserialize::<_, Error>(unchecked).unwrap();
+        assert_eq!(roundtripped, value);
+    }
+
+    // Property: the checked access path rejects under-aligned buffers with
+    // an error instead of performing a misaligned read.
+    #[hegel::test]
+    fn access_misaligned_buffer_errors(tc: hegel::TestCase) {
+        let value = tc.draw(complex_bags());
+        let bytes = to_bytes::<Error>(&value).unwrap();
+
+        let align = align_of::<Archived<ComplexBag>>();
+        assert!(align > 1);
+        // Copy the valid archive to an offset that breaks its alignment
+        // while keeping the underlying allocation over-aligned, so the slice
+        // start is *guaranteed* misaligned.
+        let offset = tc.draw(
+            generators::integers::<usize>()
+                .min_value(1)
+                .max_value(align - 1),
+        );
+        let mut buf = AlignedVec::<16>::new();
+        buf.resize(offset, 0);
+        buf.extend_from_slice(&bytes);
+
+        let result =
+            access::<Archived<ComplexBag>, Error>(&buf[offset..]);
+        assert!(result.is_err());
+    }
+}
+
+// KNOWN FAILURE (aborts the process -- kept `#[ignore]`d so it does not take
+// the whole test binary down; see HEGEL_REPORT.md "Suspected bugs").
+//
+// The validation book chapter claims archive validation "secures against
+// recursion attacks", but `access` (the checked/safe entry point) validates
+// a recursively-nested archive with unbounded native recursion. A valid
+// archive nested a few thousand levels deep -- well within what rkyv's own
+// serializer produces without error -- overflows the stack and aborts the
+// process (SIGABRT) instead of returning an `Err`. Because a process abort
+// is not catchable, this cannot be a live property test; it is pinned here
+// as an ignored reproducer.
+//
+// Observed thresholds on this host (default features, standard 2 MiB test
+// thread stack): serialization succeeds through depth >= 3500, but `access`
+// on the resulting valid bytes already overflows the stack at depth ~2500.
+// Depth 5000 reproduces reliably.
+mod recursion_dos {
+    use rkyv::{
+        access, rancor::Error, ser::Writer, to_bytes, validation,
+        Archive, Archived, Deserialize, Serialize,
+    };
+
+    #[derive(Archive, Serialize, Deserialize)]
+    #[rkyv(
+        bytecheck(bounds(__C: validation::ArchiveContext)),
+        serialize_bounds(__S: Writer),
+        deserialize_bounds(__D::Error: rkyv::rancor::Source),
+    )]
+    enum Chain {
+        End,
+        Link {
+            val: u32,
+            #[rkyv(omit_bounds)]
+            next: Box<Chain>,
+        },
+    }
+
+    // Iterative teardown so dropping the value does not itself recurse.
+    fn dismantle(mut c: Chain) {
+        while let Chain::Link { next, .. } = c {
+            c = *next;
+        }
+    }
+
+    #[ignore = "aborts the process via stack overflow: unbounded recursion in \
+                bytecheck validation of a valid deeply-nested archive"]
+    #[test]
+    fn access_deeply_nested_archive_overflows_stack() {
+        const DEPTH: usize = 5000;
+
+        let mut value = Chain::End;
+        for i in 0..DEPTH {
+            value = Chain::Link {
+                val: i as u32,
+                next: Box::new(value),
+            };
+        }
+
+        // rkyv's own serializer accepts this value without error.
+        let bytes = to_bytes::<Error>(&value).unwrap();
+        dismantle(value);
+
+        // The checked entry point should return an Err for input it cannot
+        // safely validate. Instead this call overflows the stack and aborts.
+        let _ = access::<Archived<Chain>, Error>(&bytes);
+    }
+}
