diff --git a/rkyv/tests/fuzz.rs b/rkyv/tests/fuzz.rs
index b1d07a3..541e76c 100644
--- a/rkyv/tests/fuzz.rs
+++ b/rkyv/tests/fuzz.rs
@@ -26,7 +26,7 @@ fuzz_target!(hashmap_string_oob_read as HashMap<String, Vec<u32>>);
