index df5d81a..20aa6be 100644
--- a/tests/fuzzer.rs
+++ b/tests/fuzzer.rs
@@ -85,3 +85,321 @@ fn test_fuzzer_data_ok(data: &[u8]) {
 fn test_fuzzer_data_err(data: &[u8]) {
     assert!(test_fuzzer_data(data).is_err());
 }
+
+/// Property-based tests (hegel) for decoder robustness against untrusted input.
+mod hegel_robustness {
+    use hegel::generators::{self, Generator};
+    use plist::{Dictionary, Value};
+    use std::io::Cursor;
+
+    /// Byte layout of the binary plist trailer (last 32 bytes of the file):
+    /// 6 bytes padding, 1 byte offset size, 1 byte object ref size,
+    /// 8 bytes (BE) number of objects, 8 bytes (BE) root object ref,
+    /// 8 bytes (BE) file offset of the object offset table.
+    const TRAILER_LEN: usize = 32;
+
+    /// A compact `Value` generator for producing valid plists to corrupt.
+    ///
+    /// This intentionally duplicates a slimmed-down version of the generator in
+    /// `src/value.rs`'s `hegel_tests` module: unit tests and integration tests cannot
+    /// share `#[cfg(test)]` helpers. Dates are omitted here (they are covered by the
+    /// round-trip properties; `Debug`-printing extreme dates panics, see the known
+    /// failure test below).
+    fn arb_value(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let mut kinds: Vec<u8> = vec![0, 1, 2, 3, 4];
+            if depth > 0 {
+                kinds.extend([5, 6]);
+            }
+            match tc.draw(generators::sampled_from(kinds)) {
+                0 => Value::Boolean(tc.draw(generators::booleans())),
+                1 => Value::Integer(tc.draw(generators::integers::<i64>()).into()),
+                2 => Value::Real(f64::from_bits(tc.draw(generators::integers::<u64>()))),
+                3 => Value::String(tc.draw(generators::text())),
+                4 => Value::Data(tc.draw(generators::binary())),
+                5 => Value::Array(tc.draw(generators::vecs(arb_value(depth - 1)))),
+                6 => {
+                    let pairs: Vec<(String, Value)> = tc.draw(generators::vecs(
+                        generators::tuples!(generators::text(), arb_value(depth - 1)),
+                    ));
+                    let mut dict = Dictionary::new();
+                    for (k, v) in pairs {
+                        dict.insert(k, v);
+                    }
+                    Value::Dictionary(dict)
+                }
+                _ => unreachable!(),
+            }
+        })
+        .boxed()
+    }
+
+    fn to_binary_bytes(value: &Value) -> Vec<u8> {
+        let mut buf = Vec::new();
+        value.to_writer_binary(&mut buf).expect("binary write failed");
+        buf
+    }
+
+    fn to_xml_bytes(value: &Value) -> Vec<u8> {
+        let mut buf = Vec::new();
+        value.to_writer_xml(&mut buf).expect("XML write failed");
+        buf
+    }
+
+    /// Property: decoding arbitrary bytes returns `Ok` or `Err` but never panics,
+    /// hangs or makes an unbounded allocation. This supplements the libFuzzer targets
+    /// in fuzz/fuzz_targets with an always-on version, and additionally boosts inputs
+    /// that start with the binary plist magic so the binary reader (offset table,
+    /// trailer parsing) is exercised, not just format detection.
+    #[hegel::test]
+    fn arbitrary_bytes_decode_never_panics(tc: hegel::TestCase) {
+        let mut bytes = tc.draw(generators::binary());
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => (),
+            1 => {
+                let mut prefixed = b"bplist00".to_vec();
+                prefixed.append(&mut bytes);
+                bytes = prefixed;
+            }
+            2 => {
+                let mut prefixed = b"<?xml version=\"1.0\"?><plist>".to_vec();
+                prefixed.append(&mut bytes);
+                bytes = prefixed;
+            }
+            _ => unreachable!(),
+        }
+
+        drop(Value::from_reader(Cursor::new(&bytes)));
+        drop(Value::from_reader_xml(Cursor::new(&bytes)));
+        drop(Value::from_reader_ascii(Cursor::new(&bytes)));
+    }
+
+    /// Property: a valid binary plist whose trailer fields (offset size, ref size,
+    /// object count, root object ref, offset table offset — all attacker-controlled)
+    /// are overwritten with arbitrary values must be handled gracefully: `Ok` or
+    /// `Err`, never a panic or an allocation driven by the corrupted field.
+    #[hegel::test]
+    fn corrupted_binary_trailer_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(2));
+        let mut bytes = to_binary_bytes(&value);
+        let trailer_start = bytes.len() - TRAILER_LEN;
+
+        // A u64 generator boosted towards interesting boundary values.
+        let file_len = bytes.len() as u64;
+        let u64_gen = || {
+            hegel::one_of!(
+                generators::integers::<u64>().boxed(),
+                generators::sampled_from(vec![
+                    0u64,
+                    1,
+                    file_len,
+                    file_len - 1,
+                    file_len.wrapping_sub(TRAILER_LEN as u64),
+                    u32::MAX as u64,
+                    u64::MAX,
+                    i64::MAX as u64,
+                ])
+                .boxed(),
+            )
+        };
+
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            // offset size
+            0 => bytes[trailer_start + 6] = tc.draw(generators::integers::<u8>()),
+            // object ref size
+            1 => bytes[trailer_start + 7] = tc.draw(generators::integers::<u8>()),
+            // number of objects
+            2 => bytes[trailer_start + 8..trailer_start + 16]
+                .copy_from_slice(&tc.draw(u64_gen()).to_be_bytes()),
+            // root object ref
+            3 => bytes[trailer_start + 16..trailer_start + 24]
+                .copy_from_slice(&tc.draw(u64_gen()).to_be_bytes()),
+            // offset table offset
+            4 => bytes[trailer_start + 24..trailer_start + 32]
+                .copy_from_slice(&tc.draw(u64_gen()).to_be_bytes()),
+            _ => unreachable!(),
+        }
+
+        // Must return without panicking; the result value (if any) must also be
+        // droppable without incident.
+        drop(Value::from_reader(Cursor::new(&bytes)));
+    }
+
+    /// Property: inflating the trailer's object count beyond the real one is always
+    /// rejected with an error (the offset table cannot contain that many entries), and
+    /// in particular a huge count must not cause a huge up-front allocation.
+    #[hegel::test]
+    fn inflated_object_count_is_rejected(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(2));
+        let mut bytes = to_binary_bytes(&value);
+        let trailer_start = bytes.len() - TRAILER_LEN;
+
+        let num_objects = u64::from_be_bytes(
+            bytes[trailer_start + 8..trailer_start + 16]
+                .try_into()
+                .unwrap(),
+        );
+        let extra = tc.draw(hegel::one_of!(
+            generators::integers::<u64>()
+                .min_value(1)
+                .max_value(u64::MAX - num_objects)
+                .boxed(),
+            // boost the classic attack: an enormous object count
+            generators::sampled_from(vec![u64::MAX - num_objects]).boxed(),
+        ));
+        let inflated = num_objects + extra;
+        bytes[trailer_start + 8..trailer_start + 16].copy_from_slice(&inflated.to_be_bytes());
+
+        assert!(
+            Value::from_reader(Cursor::new(&bytes)).is_err(),
+            "binary plist with object count inflated from {num_objects} to {inflated} was accepted",
+        );
+    }
+
+    /// Property: flipping or truncating bytes of a valid plist (either encoding) is
+    /// handled gracefully — `Ok` or `Err`, never a panic.
+    #[hegel::test]
+    fn corrupted_valid_plist_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(2));
+        let mut bytes = if tc.draw(generators::booleans()) {
+            to_binary_bytes(&value)
+        } else {
+            to_xml_bytes(&value)
+        };
+
+        if tc.draw(generators::booleans()) {
+            // Truncate
+            let len = tc.draw(generators::integers::<usize>().max_value(bytes.len()));
+            bytes.truncate(len);
+        } else {
+            // Flip bits in a single byte
+            let idx = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+            let mask = tc.draw(generators::integers::<u8>().min_value(1));
+            bytes[idx] ^= mask;
+        }
+
+        drop(Value::from_reader(Cursor::new(&bytes)));
+    }
+
+    /// Dismantles a `Value` iteratively.
+    ///
+    /// `Value`'s derived `Drop` glue recurses, so simply dropping a deeply nested
+    /// value overflows the stack (see
+    /// `known_failure_deeply_nested_value_drop_overflows_stack`). This helper lets the
+    /// deep-nesting property below verify *parsing* at depths well beyond the drop
+    /// glue's limit.
+    fn dismantle(value: Value) {
+        let mut stack = vec![value];
+        while let Some(v) = stack.pop() {
+            match v {
+                Value::Array(arr) => stack.extend(arr),
+                Value::Dictionary(dict) => stack.extend(dict.into_iter().map(|(_k, v)| v)),
+                _ => (),
+            }
+        }
+    }
+
+    /// Property: deeply nested XML plists (arrays or dicts) parse without stack
+    /// overflow — `Ok` when well formed, `Err` when unclosed — at depths into the tens
+    /// of thousands.
+    #[hegel::test]
+    fn deeply_nested_xml_parses_without_stack_overflow(tc: hegel::TestCase) {
+        // Draw the depth directly: uniform recursive generation never reaches
+        // interesting depths.
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(20_000));
+        let use_dict = tc.draw(generators::booleans());
+        let well_formed = tc.draw(generators::booleans());
+
+        let mut xml = String::new();
+        for _ in 0..depth {
+            if use_dict {
+                xml.push_str("<dict><key>k</key>");
+            } else {
+                xml.push_str("<array>");
+            }
+        }
+        if well_formed {
+            xml.push_str("<true/>");
+            for _ in 0..depth {
+                xml.push_str(if use_dict { "</dict>" } else { "</array>" });
+            }
+        }
+
+        let result = Value::from_reader_xml(Cursor::new(xml.as_bytes()));
+        if well_formed {
+            let value = result.unwrap_or_else(|err| {
+                panic!("well-formed XML nested {depth} deep failed to parse: {err}")
+            });
+            dismantle(value);
+        } else {
+            match result {
+                Err(_) => (),
+                Ok(value) => {
+                    dismantle(value);
+                    panic!("unclosed XML nested {depth} deep parsed successfully");
+                }
+            }
+        }
+    }
+
+    /// KNOWN FAILURE (kept failing deliberately — do not "fix" the test):
