+/// Property-based tests (hegel) for the `Value` serialization round-trips.
+#[cfg(test)]
+mod hegel_tests {
+    use std::{
+        io::Cursor,
+        time::{Duration, SystemTime, UNIX_EPOCH},
+    };
+
+    use hegel::generators::{self, Generator};
+
+    use crate::{Date, Dictionary, Integer, Uid, Value};
+
+    /// Bounds (in seconds relative to the unix epoch) for generated dates, roughly
+    /// years 1019..=8942.
+    ///
+    /// This bound protects the tests, not the library's contract: `Date`s outside the
+    /// range representable by `time::OffsetDateTime` panic when formatted as XML or
+    /// even when `Debug`-printed (which hegel does for every drawn value). That bug is
+    /// pinned by `known_failure_far_future_date_xml_write_should_error_not_panic` in
+    /// tests/fuzzer.rs.
+    const MIN_UNIX_SECS: i64 = -30_000_000_000;
+    const MAX_UNIX_SECS: i64 = 220_000_000_000;
+
+    fn system_time(unix_secs: i64, subsec_nanos: u32) -> SystemTime {
+        if unix_secs >= 0 {
+            UNIX_EPOCH + Duration::new(unix_secs as u64, subsec_nanos)
+        } else {
+            UNIX_EPOCH - Duration::from_secs(unix_secs.unsigned_abs())
+                + Duration::new(0, subsec_nanos)
+        }
+    }
+
+    fn draw_integer(tc: &hegel::TestCase) -> Integer {
+        // Full i64 and u64 ranges plus explicitly boosted boundary values.
+        tc.draw(hegel::one_of!(
+            generators::integers::<i64>().map(Integer::from).boxed(),
+            generators::integers::<u64>().map(Integer::from).boxed(),
+            generators::sampled_from(vec![
+                Integer::from(i64::MIN),
+                Integer::from(-1i64),
+                Integer::from(0i64),
+                Integer::from(1i64),
+                Integer::from(i64::MAX),
+                Integer::from(i64::MAX as u64 + 1),
+                Integer::from(u64::MAX),
+            ])
+            .boxed(),
+        ))
+    }
+
+    fn draw_real(tc: &hegel::TestCase) -> f64 {
+        // `from_bits` covers every bit pattern (subnormals, NaN payloads, ...);
+        // `floats` gives a friendlier distribution; plus boosted boundary values.
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().boxed(),
+            generators::integers::<u64>().map(f64::from_bits).boxed(),
+            generators::sampled_from(vec![
+                0.0,
+                -0.0,
+                1.0,
+                -1.0,
+                f64::MIN,
+                f64::MAX,
+                f64::MIN_POSITIVE,
+                5e-324, // smallest subnormal
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+                f64::NAN,
+            ])
+            .boxed(),
+        ))
+    }
+
+    /// Draws a `Date` with whole-second precision. Sub-second dates are exercised by
+    /// the dedicated date properties below: the binary format stores dates as an `f64`
+    /// so nanosecond precision is inherently lossy there.
+    fn draw_whole_second_date(tc: &hegel::TestCase) -> Date {
+        let secs = tc.draw(
+            generators::integers::<i64>()
+                .min_value(MIN_UNIX_SECS)
+                .max_value(MAX_UNIX_SECS),
+        );
+        system_time(secs, 0).into()
+    }
+
+    /// Generator over arbitrary `Value` trees.
+    ///
+    /// `allow_uid` exists because `Uid` is only supported by the binary format
+    /// (`to_writer_xml` returns `Err(UidNotSupportedInXmlPlist)` for it).
+    fn arb_value(depth: u32, allow_uid: bool) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let mut kinds: Vec<u8> = vec![0, 1, 2, 3, 4, 5];
+            if allow_uid {
+                kinds.push(6);
+            }
+            if depth > 0 {
+                kinds.extend([7, 8]);
+            }
+            match tc.draw(generators::sampled_from(kinds)) {
+                0 => Value::Boolean(tc.draw(generators::booleans())),
+                1 => Value::Integer(draw_integer(&tc)),
+                2 => Value::Real(draw_real(&tc)),
+                3 => Value::String(tc.draw(generators::text())),
+                4 => Value::Data(tc.draw(generators::binary())),
+                5 => Value::Date(draw_whole_second_date(&tc)),
+                6 => Value::Uid(Uid::new(tc.draw(generators::integers::<u64>()))),
+                7 => Value::Array(tc.draw(generators::vecs(arb_value(depth - 1, allow_uid)))),
+                8 => {
+                    let pairs: Vec<(String, Value)> = tc.draw(generators::vecs(
+                        generators::tuples!(generators::text(), arb_value(depth - 1, allow_uid)),
+                    ));
+                    let mut dict = Dictionary::new();
+                    for (k, v) in pairs {
+                        dict.insert(k, v);
+                    }
+                    Value::Dictionary(dict)
+                }
+                _ => unreachable!(),
+            }
+        })
+        .boxed()
+    }
+
+    /// Structural equality that is stricter than `Value: PartialEq` where it matters
+    /// for round-trips:
+    /// - `Real`s are compared bit-exactly (`PartialEq` says `NaN != NaN` and
+    ///   `-0.0 == 0.0`).
+    /// - Dictionaries are compared in iteration order (`IndexMap`'s `PartialEq` is
+    ///   order-independent, but both plist encodings preserve key order).
+    ///
+    /// If `canonical_nan` is true, any NaN is considered equal to any other NaN: the
+    /// XML format serializes every NaN as the string "NaN", so payload and sign bits
+    /// are documented-lossy there. The binary format is bit-exact and uses `false`.
+    fn value_eq(a: &Value, b: &Value, canonical_nan: bool) -> bool {
+        match (a, b) {
+            (Value::Real(x), Value::Real(y)) => {
+                x.to_bits() == y.to_bits() || (canonical_nan && x.is_nan() && y.is_nan())
+            }
+            (Value::Array(x), Value::Array(y)) => {
+                x.len() == y.len()
+                    && x.iter()
+                        .zip(y.iter())
+                        .all(|(a, b)| value_eq(a, b, canonical_nan))
+            }
+            (Value::Dictionary(x), Value::Dictionary(y)) => {
+                x.len() == y.len()
+                    && x.iter()
+                        .zip(y.iter())
+                        .all(|((ka, va), (kb, vb))| ka == kb && value_eq(va, vb, canonical_nan))
+            }
+            _ => a == b,
+        }
+    }
+
+    fn to_xml_bytes(value: &Value) -> Vec<u8> {
+        let mut buf = Vec::new();
+        value.to_writer_xml(&mut buf).expect("XML write failed");
+        buf
+    }
+
+    fn to_binary_bytes(value: &Value) -> Vec<u8> {
+        let mut buf = Vec::new();
+        value.to_writer_binary(&mut buf).expect("binary write failed");
+        buf
+    }
+
+    /// Property: writing a `Value` as XML and reading it back yields an equal `Value`,
+    /// and re-serializing yields byte-identical XML (round-trip is a fixpoint).
+    #[hegel::test]
+    fn xml_roundtrip_recovers_value(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(3, false));
+
+        let xml = to_xml_bytes(&value);
+        let read_back = Value::from_reader_xml(Cursor::new(&xml))
+            .unwrap_or_else(|err| panic!("failed to read back generated XML: {err}\n{value:?}"));
+        assert!(
+            value_eq(&value, &read_back, true),
+            "XML round-trip changed the value:\n before: {value:?}\n after:  {read_back:?}\n xml:\n{}",
+            String::from_utf8_lossy(&xml),
+        );
+
+        let xml2 = to_xml_bytes(&read_back);
+        assert_eq!(
+            String::from_utf8_lossy(&xml),
+            String::from_utf8_lossy(&xml2),
+            "XML round-trip is not a fixpoint"
+        );
+    }
+
+    /// Property: writing a `Value` as a binary plist and reading it back yields a
+    /// bit-exact equal `Value`, and re-serializing yields identical bytes.
+    #[hegel::test]
+    fn binary_roundtrip_recovers_value(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(3, true));
+
+        let bytes = to_binary_bytes(&value);
+        let read_back = Value::from_reader(Cursor::new(&bytes)).unwrap_or_else(|err| {
+            panic!("failed to read back generated binary plist: {err}\n{value:?}")
+        });
+        assert!(
+            value_eq(&value, &read_back, false),
+            "binary round-trip changed the value:\n before: {value:?}\n after:  {read_back:?}",
+        );
+
+        let bytes2 = to_binary_bytes(&read_back);
+        assert_eq!(bytes, bytes2, "binary round-trip is not a fixpoint");
+    }
+
+    /// Property: a `Value` written as XML and as binary reads back to the same value
+    /// from both encodings.
+    #[hegel::test]
+    fn xml_and_binary_encodings_agree(tc: hegel::TestCase) {
+        let value = tc.draw(arb_value(3, false));
+
+        let via_xml = Value::from_reader_xml(Cursor::new(to_xml_bytes(&value)))
+            .expect("failed to read back generated XML");
+        let via_binary = Value::from_reader(Cursor::new(to_binary_bytes(&value)))
+            .expect("failed to read back generated binary plist");
+
+        // `canonical_nan` because the XML encoding canonicalizes NaN payloads while
+        // the binary encoding preserves them.
+        assert!(
+            value_eq(&via_xml, &via_binary, true),
+            "encodings disagree:\n via XML:    {via_xml:?}\n via binary: {via_binary:?}\n original:   {value:?}",
+        );
+    }
+
+    /// Property: boundary integers (i64::MIN/MAX, u64::MAX, 0, ±1, ...) round-trip
+    /// exactly through both encodings.
+    #[hegel::test]
+    fn integer_boundary_values_roundtrip_both_formats(tc: hegel::TestCase) {
+        let value = Value::Integer(draw_integer(&tc));
+
+        let via_xml =
+            Value::from_reader_xml(Cursor::new(to_xml_bytes(&value))).expect("XML read failed");
+        assert_eq!(value, via_xml, "XML integer round-trip");
+
+        let via_binary =
+            Value::from_reader(Cursor::new(to_binary_bytes(&value))).expect("binary read failed");
+        assert_eq!(value, via_binary, "binary integer round-trip");
+    }
+
+    /// Property: every `f64` bit pattern round-trips bit-exactly through the binary
+    /// encoding, and through the XML encoding up to NaN canonicalization.
+    #[hegel::test]
+    fn real_boundary_values_roundtrip_both_formats(tc: hegel::TestCase) {
+        let real = draw_real(&tc);
+        let value = Value::Real(real);
+
+        let via_binary = Value::from_reader(Cursor::new(to_binary_bytes(&value)))
+            .expect("binary read failed");
+        assert!(
+            value_eq(&value, &via_binary, false),
+            "binary real round-trip not bit-exact: {:#x} -> {:?}",
+            real.to_bits(),
+            via_binary,
+        );
+
+        let via_xml =
+            Value::from_reader_xml(Cursor::new(to_xml_bytes(&value))).expect("XML read failed");
+        assert!(
+            value_eq(&value, &via_xml, true),
+            "XML real round-trip changed the value: {:#x} -> {:?}",
+            real.to_bits(),
+            via_xml,
+        );
+    }
+
+    /// Property: dates with nanosecond precision round-trip exactly through the XML
+    /// encoding (RFC 3339 carries up to 9 subsecond digits).
+    #[hegel::test]
+    fn date_with_nanoseconds_roundtrips_xml_exactly(tc: hegel::TestCase) {
+        let secs = tc.draw(
+            generators::integers::<i64>()
+                .min_value(MIN_UNIX_SECS)
+                .max_value(MAX_UNIX_SECS),
+        );
+        let nanos = tc.draw(generators::integers::<u32>().max_value(999_999_999));
+        let value = Value::Date(system_time(secs, nanos).into());
+
+        let read_back =
+            Value::from_reader_xml(Cursor::new(to_xml_bytes(&value))).expect("XML read failed");
+        assert_eq!(value, read_back, "XML date round-trip");
+    }
+
+    /// Property: dates round-trip through the binary encoding to within the precision
+    /// of the format. The binary format stores dates as an `f64` of seconds since the
+    /// year 2001, so sub-second precision inherently degrades with distance from that
+    /// epoch (~4µs per ULP at 545 years away, found by a high-count run of this test);
+    /// the round-trip error must never exceed ~2 ULPs of that representation.
+    #[hegel::test]
+    fn date_binary_roundtrip_within_f64_precision(tc: hegel::TestCase) {
+        let secs = tc.draw(
+            generators::integers::<i64>()
+                .min_value(MIN_UNIX_SECS)
+                .max_value(MAX_UNIX_SECS),
+        );
+        let nanos = tc.draw(generators::integers::<u32>().max_value(999_999_999));
+        let value = Value::Date(system_time(secs, nanos).into());
+
+        let read_back =
+            Value::from_reader(Cursor::new(to_binary_bytes(&value))).expect("binary read failed");
+
+        let before: SystemTime = value.as_date().unwrap().into();
+        let after: SystemTime = read_back.as_date().unwrap().into();
+        let diff = match before.duration_since(after) {
+            Ok(d) => d,
+            Err(e) => e.duration(),
+        };
+
+        // Seconds relative to the plist epoch (2001-01-01), which is what the format
+        // stores as an f64. Tolerance: 2 ULPs of that value plus the reader's <=1ns
+        // fract truncation.
+        let plist_epoch = UNIX_EPOCH + Duration::from_secs(978_307_200);
+        let secs_from_plist_epoch = match before.duration_since(plist_epoch) {
+            Ok(d) => d.as_secs_f64(),
+            Err(e) => e.duration().as_secs_f64(),
+        };
+        let tolerance_secs = 2.0 * f64::EPSILON * secs_from_plist_epoch.max(1.0) + 1e-9;
+        assert!(
+            diff.as_secs_f64() <= tolerance_secs,
+            "binary date round-trip drifted by {diff:?} (tolerance {tolerance_secs:e}s): {value:?} -> {read_back:?}",
+        );
+    }
+
+    /// Property: strings built from arbitrary codepoints — deliberately including
+    /// ASCII controls, C1 controls, unicode line separators and non-characters, which
+    /// sit just outside the XML writer's escape set and on the boundary between the
+    /// binary format's ASCII and UTF-16 representations — round-trip through both
+    /// encodings.
+    #[hegel::test]
+    fn string_edge_codepoints_roundtrip_both_formats(tc: hegel::TestCase) {
+        let chars: Vec<char> = tc.draw(generators::vecs(hegel::one_of!(
+            // ASCII controls and low ASCII
+            generators::integers::<u32>().max_value(0x7F).boxed(),
+            // C1 controls and Latin-1
+            generators::integers::<u32>().min_value(0x80).max_value(0xFF).boxed(),
+            // interesting exact codepoints
+            generators::sampled_from(vec![
+                0x0Au32, 0x0D, 0x09, 0x85, 0x2028, 0x2029, 0xFFFD, 0xFFFE, 0xFFFF,
+            ])
+            .boxed(),
+            // rest of the BMP and supplementary planes (surrogates mapped to U+FFFD)
+            generators::integers::<u32>().max_value(0x10_FFFF).boxed(),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}'))));
+        let value = Value::String(chars.into_iter().collect());
+
+        let via_xml =
+            Value::from_reader_xml(Cursor::new(to_xml_bytes(&value))).expect("XML read failed");
+        assert_eq!(value, via_xml, "XML string round-trip");
+
+        let via_binary =
+            Value::from_reader(Cursor::new(to_binary_bytes(&value))).expect("binary read failed");
+        assert_eq!(value, via_binary, "binary string round-trip");
+    }
+}
