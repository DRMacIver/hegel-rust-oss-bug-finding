+    #[ignore = "stack overflow (SIGABRT): Value's recursive drop glue; parse succeeds, drop aborts"]
+    fn known_failure_deeply_nested_value_drop_overflows_stack() {
+        let depth = 100_000;
+        let mut xml = String::with_capacity(depth * 16);
+        for _ in 0..depth {
+            xml.push_str("<array>");
+        }
+        for _ in 0..depth {
+            xml.push_str("</array>");
+        }
+
+        let value = Value::from_reader_xml(Cursor::new(xml.as_bytes())).expect("parses fine");
+        // The implicit drop of `value` here overflows the stack and aborts.
+        drop(value);
+    }
