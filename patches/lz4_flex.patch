+/// Property: `compress_prepend_size` output is documented to be the uncompressed
+/// size as a little-endian u32 followed by the regular compressed data, and
+/// `uncompressed_size` is documented to read that size back and return the rest.
+#[hegel::test]
+fn hegel_prepend_size_consistency(tc: hegel::TestCase) {
+    use lz4_flex::block::uncompressed_size;
+    let data = tc.draw(payload());
+    let plain = compress_block(&data);
+    let prepended = compress_prepend_size(&data);
+    assert_eq!(prepended[..4], (data.len() as u32).to_le_bytes());
+    assert_eq!(prepended[4..], plain[..]);
+    let (size, rest) = uncompressed_size(&prepended).unwrap();
+    assert_eq!(size, data.len());
+    assert_eq!(rest, &plain[..]);
 }
 
