-use proptest::{prelude::*, test_runner::FileFailurePersistence};
+use hegel::generators as gens;
+
+/// Generates byte payloads that mix incompressible (random) segments with highly
+/// compressible (repeated pattern) segments, so that both the literal and the match
+/// code paths of the compressor are exercised. Sizes range from empty up to a few
+/// hundred KB so that multi-block frame paths (blocks > 64KB, linked-mode ext_dict
+/// handoff at > 128KB) and the u16 vs u32 hash table switch (64KB) are reachable.
+#[hegel::composite]
+fn payload(tc: hegel::TestCase) -> Vec<u8> {
+    let n_segments = tc.draw(gens::integers::<usize>().max_value(6));
+    let mut data = Vec::new();
+    for _ in 0..n_segments {
+        if tc.draw(gens::booleans()) {
+            // Compressible segment: a short pattern repeated many times.
+            let pattern: Vec<u8> = tc.draw(gens::binary().min_size(1).max_size(16));
+            let repeats = tc.draw(gens::integers::<usize>().min_value(1).max_value(5000));
+            for _ in 0..repeats {
+                data.extend_from_slice(&pattern);
+            }
+        } else {
+            // Incompressible segment: random bytes.
+            let chunk: Vec<u8> = tc.draw(gens::binary().max_size(2048));
+            data.extend_from_slice(&chunk);
+        }
+    }
+    data
+}
 
