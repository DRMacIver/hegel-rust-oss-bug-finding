+/// Property-based tests (hegel). Decode-robustness / memory-limit family.
+///
+/// The encode->decode round trip and structural invariants live in
+/// `tests/roundtrip.rs`.
+#[cfg(test)]
+mod hegel_props {
+    use gif::{ColorOutput, DecodeOptions, Encoder, Frame, MemoryLimit};
+    use hegel::generators;
+    use std::borrow::Cow;
+
+    // Cap on how many frames we pull from an arbitrary input, and on the memory
+    // limit we hand the decoder. GIF logical-screen and image-descriptor
+    // dimensions are attacker-controlled and LZW can expand hugely, so we always
+    // run the fallible/robustness properties under a bounded memory limit and a
+    // frame cap: a crafted input must surface an `Err`, never panic, OOM, or hang.
+    const FRAME_CAP: usize = 4096;
+    const MEM_LIMIT: u64 = 16 * 1024 * 1024;
+
+    fn small_limit() -> MemoryLimit {
+        MemoryLimit::Bytes(MEM_LIMIT.try_into().unwrap())
+    }
+
+    /// Decoding arbitrary bytes (optionally with a valid GIF magic prefix so the
+    /// fuzzer reaches deeper block-parsing paths) must never panic. It returns
+    /// `Ok` or `Err`; under a bounded memory limit it must not OOM, and being
+    /// finite input it must terminate. We vary the decoder configuration to
+    /// cover paths the crate's single fuzz target (default options only) misses:
+    /// RGBA output, frame-consistency checks, unknown-block tolerance, and the
+    /// LZW end-code requirement.
+    ///
+    /// `skip_frame_decoding` is deliberately NOT exercised here: it reserves
+    /// `width*height/4` bytes ignoring the memory limit (see
+    /// `skip_frame_decoding_ignores_memory_limit_KNOWN_FAILURE`), which would
+    /// let a crafted dimension reserve gigabytes and is pinned separately.
+    #[hegel::test]
+    fn arbitrary_bytes_decode_never_panics(tc: hegel::TestCase) {
+        let mut data = tc.draw(generators::binary().max_size(4096));
+        // Sometimes prepend a valid header so garbage is parsed as GIF body.
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => {
+                let mut prefixed = b"GIF89a".to_vec();
+                prefixed.append(&mut data);
+                data = prefixed;
+            }
+            1 => {
+                let mut prefixed = b"GIF87a".to_vec();
+                prefixed.append(&mut data);
+                data = prefixed;
+            }
+            _ => {}
+        }
+
+        let mut opts = DecodeOptions::new();
+        opts.set_memory_limit(small_limit());
+        opts.set_color_output(if tc.draw(generators::booleans()) {
+            ColorOutput::RGBA
+        } else {
+            ColorOutput::Indexed
+        });
+        opts.check_frame_consistency(tc.draw(generators::booleans()));
+        opts.allow_unknown_blocks(tc.draw(generators::booleans()));
+        opts.check_lzw_end_code(tc.draw(generators::booleans()));
+
+        if let Ok(mut decoder) = opts.read_info(&data[..]) {
+            let mut frames = 0;
+            loop {
+                match decoder.read_next_frame() {
+                    Ok(Some(_)) => {
+                        frames += 1;
+                        assert!(
+                            frames < FRAME_CAP,
+                            "finite input produced an unbounded number of frames"
+                        );
+                    }
+                    Ok(None) => break,
+                    Err(_) => break,
+                }
+            }
+        }
+    }
+
+    /// Build a valid single-frame GIF, then corrupt it (flip a byte or truncate)
+    /// and confirm decoding degrades gracefully — an `Ok` or `Err`, never a
+    /// panic. Oracle-independent robustness.
+    #[hegel::test]
+    fn valid_then_corrupt_never_panics(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u16>().min_value(1).max_value(32));
+        let height = tc.draw(generators::integers::<u16>().min_value(1).max_value(32));
+        let count = usize::from(width) * usize::from(height);
+        let pixels = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(count)
+                .max_size(count),
+        );
+        let palette = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(3)
+                .max_size(256 * 3),
+        );
+
+        let mut data = Vec::new();
+        {
+            let mut encoder = Encoder::new(&mut data, width, height, &palette).unwrap();
+            let frame = Frame::from_indexed_pixels(width, height, pixels, None);
+            encoder.write_frame(&frame).unwrap();
+        }
+        assert!(!data.is_empty());
+
+        // Corrupt: either truncate at a drawn length, or overwrite a byte.
+        if tc.draw(generators::booleans()) {
+            let keep = tc.draw(generators::integers::<usize>().max_value(data.len()));
+            data.truncate(keep);
+        } else {
+            let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            let byte = tc.draw(generators::integers::<u8>());
+            data[idx] = byte;
+        }
+
+        let mut opts = DecodeOptions::new();
+        opts.set_memory_limit(small_limit());
+        if let Ok(mut decoder) = opts.read_info(&data[..]) {
+            let mut frames = 0;
+            loop {
+                match decoder.read_next_frame() {
+                    Ok(Some(_)) => {
+                        frames += 1;
+                        assert!(frames < FRAME_CAP, "unbounded frames from corrupted input");
+                    }
+                    Ok(None) | Err(_) => break,
+                }
+            }
+        }
+    }
+
+    /// Craft a tiny file that declares a huge frame but carries only a few bytes
+    /// of LZW data, then decode it through the normal (pixel) path with a memory
+    /// limit far below width*height. The decoder must reject it with an error
+    /// rather than allocating the full frame — i.e. `set_memory_limit` is honored
+    /// on the pixel path.
+    #[hegel::test]
+    fn memory_limit_enforced_on_pixel_path(tc: hegel::TestCase) {
+        // Draw dimensions whose product exceeds the limit, so the frame cannot
+        // fit and must be rejected.
+        let width = tc.draw(generators::integers::<u16>().min_value(2000).max_value(0xFFFF));
+        let height = tc.draw(generators::integers::<u16>().min_value(2000).max_value(0xFFFF));
+        let limit: u64 = tc.draw(generators::integers::<u64>().min_value(1).max_value(1024));
+        assert!(u64::from(width) * u64::from(height) > limit);
+
+        // Small real LZW payload so the file itself is tiny.
+        let mut lzw = Frame::from_indexed_pixels(2, 2, vec![0u8; 4], None);
+        lzw.make_lzw_pre_encoded();
+
+        let mut data = Vec::new();
+        {
+            let mut encoder = Encoder::new(&mut data, width, height, &[1, 2, 3]).unwrap();
+            let frame = Frame {
+                width,
+                height,
+                buffer: lzw.buffer.clone(),
+                ..Frame::default()
+            };
+            encoder.write_lzw_pre_encoded_frame(&frame).unwrap();
+        }
+
+        let mut opts = DecodeOptions::new();
+        opts.set_memory_limit(MemoryLimit::Bytes(limit.try_into().unwrap()));
+        let mut decoder = opts.read_info(&data[..]).expect("decoder init");
+        let result = decoder.read_next_frame();
+        assert!(
+            result.is_err(),
+            "an oversized frame must be rejected under the memory limit, got {:?}",
+            result.map(|f| f.map(|f| (f.width, f.height, f.buffer.len())))
+        );
+    }
+
+    /// KNOWN FAILURE — pins a real memory-limit bypass.
+    ///
+    /// With `skip_frame_decoding` enabled, `Decoder::read_next_frame`
+    /// (src/reader/mod.rs, the `FrameDataType::Lzw` branch) pre-reserves
+    /// `width * height / 4` bytes for the output buffer using the raw,
+    /// attacker-controlled frame dimensions and WITHOUT consulting the
+    /// configured `MemoryLimit`. A ~45-byte crafted GIF that declares a
+    /// 65535x65535 frame therefore makes the decoder reserve ~1 GiB even though
+    /// a 1 KiB memory limit was explicitly set. This is a decompression-bomb /
+    /// memory-limit-bypass vector.
+    ///
+    /// The reservation is a `try_reserve` (virtual, not committed), so it does
+    /// not abort the process — this fails as a normal assertion, deterministically.
+    /// It stays failing until the crate clamps the skip-path reservation to the
+    /// memory limit. Remove the `should_panic`/pin once fixed.
+    #[hegel::test(test_cases = 1)]
+    #[allow(non_snake_case)]
+    fn skip_frame_decoding_ignores_memory_limit_KNOWN_FAILURE(tc: hegel::TestCase) {
+        let _ = tc.draw(generators::booleans());
+        let width: u16 = 0xFFFF;
+        let height: u16 = 0xFFFF;
+        let limit: u64 = 1024;
+
+        let mut lzw = Frame::from_indexed_pixels(2, 2, vec![0u8; 4], None);
+        lzw.make_lzw_pre_encoded();
+
+        let mut data = Vec::new();
+        {
+            let mut encoder = Encoder::new(&mut data, width, height, &[1, 2, 3]).unwrap();
+            let frame = Frame {
+                width,
+                height,
+                buffer: lzw.buffer.clone(),
+                ..Frame::default()
+            };
+            encoder.write_lzw_pre_encoded_frame(&frame).unwrap();
+        }
+        assert!(data.len() < 100, "crafted file is tiny: {} bytes", data.len());
+
+        let mut opts = DecodeOptions::new();
+        opts.skip_frame_decoding(true);
+        opts.set_memory_limit(MemoryLimit::Bytes(limit.try_into().unwrap()));
+        let mut decoder = opts.read_info(&data[..]).expect("decoder init");
+        let frame = decoder
+            .read_next_frame()
+            .expect("skip-path decode")
+            .expect("one frame");
+        let capacity = match &frame.buffer {
+            Cow::Owned(v) => v.capacity(),
+            Cow::Borrowed(_) => 0,
+        };
+        // The output buffer capacity should stay within a small factor of the
+        // configured limit. It does not: it is ~width*height/4.
+        assert!(
+            (capacity as u64) <= limit.saturating_mul(64),
+            "skip-path reserved {capacity} bytes for a {}-byte file despite a {limit}-byte memory limit",
+            data.len()
+        );
+    }
+}
