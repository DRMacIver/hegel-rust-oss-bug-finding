+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    use hegel::generators;
+
+    use crate::{reader::ReaderBuilder, QuoteStyle, Terminator};
+
+    /// Bytes that can appear in a field for which `csv_core::is_non_numeric`
+    /// returns false, i.e. strings that parse as `f64` (including
+    /// `inf`/`infinity`/`nan`, case-insensitively) or `i128`.
+    const NUMERIC_BYTES: &[u8] = b"0123456789+-.eEiInNfFtTyYaA";
+
+    /// A generated CSV writer/reader configuration for round-trip testing.
+    #[derive(Debug, Clone)]
+    struct RoundtripConfig {
+        delimiter: u8,
+        quote: u8,
+        terminator: Terminator,
+        style: QuoteStyle,
+        double_quote: bool,
+        escape: Option<u8>,
+        comment: Option<u8>,
+    }
+
+    /// Draw a byte that is not in `forbidden`. Constructive (no rejection):
+    /// walks forward from the drawn byte until it leaves the forbidden set.
+    fn draw_byte_avoiding(tc: &hegel::TestCase, forbidden: &[u8]) -> u8 {
+        let mut b = tc.draw(generators::integers::<u8>());
+        while forbidden.contains(&b) {
+            b = b.wrapping_add(1);
+        }
+        b
+    }
+
+    /// Generate an arbitrary *valid* round-trip configuration.
+    ///
+    /// Validity rules are encoded as construction logic: the delimiter,
+    /// quote, terminator byte(s), escape character (when double-quote
+    /// escaping is disabled) and comment character must be pairwise
+    /// distinct, otherwise the CSV output is ambiguous by design (e.g. a
+    /// delimiter equal to the terminator cannot be parsed back).
+    #[hegel::composite]
+    fn roundtrip_configs(tc: hegel::TestCase) -> RoundtripConfig {
+        let terminator = if tc.draw(generators::booleans()) {
+            Terminator::CRLF
+        } else {
+            Terminator::Any(tc.draw(generators::integers::<u8>()))
+        };
+        let mut forbidden: Vec<u8> = match terminator {
+            // The reader treats both `\r` and `\n` as terminators when
+            // configured with CRLF.
+            Terminator::CRLF => vec![b'\r', b'\n'],
+            Terminator::Any(b) => vec![b],
+        };
+        let delimiter = draw_byte_avoiding(&tc, &forbidden);
+        forbidden.push(delimiter);
+        let quote = draw_byte_avoiding(&tc, &forbidden);
+        forbidden.push(quote);
+        let double_quote = tc.draw(generators::booleans());
+        let escape = if double_quote {
+            None
+        } else {
+            let e = draw_byte_avoiding(&tc, &forbidden);
+            forbidden.push(e);
+            Some(e)
+        };
+        let comment = if tc.draw(generators::booleans()) {
+            let c = draw_byte_avoiding(&tc, &forbidden);
+            forbidden.push(c);
+            Some(c)
+        } else {
+            None
+        };
