     }
+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    use hegel::generators;
+
+    use crate::Position;
+
+    /// Property: `StringRecord::trim` is equivalent to rebuilding the
+    /// record from the per-field `str::trim` results (the docs say it
+    /// trims each field with the Unicode definition of whitespace), it
+    /// preserves the record's position, and it is idempotent. Fields are
+    /// full Unicode text, so exotic whitespace and multi-byte content
+    /// exercise the internal bounds rebuild.
+    #[hegel::test]
+    fn hegel_trim_rebuilds_fields_and_preserves_position(
+        tc: hegel::TestCase,
+    ) {
+        let fields: Vec<String> =
+            tc.draw(generators::vecs(generators::text()));
+
+        let mut rec = StringRecord::new();
+        for field in &fields {
+            rec.push_field(field);
+        }
+        let mut pos = Position::new();
+        pos.set_byte(7).set_line(11).set_record(13);
+        rec.set_position(Some(pos.clone()));
+
+        let expected = StringRecord::from(
+            fields.iter().map(|f| f.trim()).collect::<Vec<&str>>(),
+        );
+
+        rec.trim();
+        assert_eq!(rec.len(), expected.len());
+        assert!(rec.iter().eq(expected.iter()));
+        assert_eq!(rec.position(), Some(&pos), "trim must keep position");
+
+        // Idempotence: trimming again changes nothing.
+        let once = rec.clone();
+        rec.trim();
+        assert_eq!(rec.position(), once.position());
+        assert!(rec.iter().eq(once.iter()));
+    }
 }
