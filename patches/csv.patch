+
+        let mut wtr = writer_for(&config);
+        for row in &rows {
+            wtr.write_record(row).unwrap();
+        }
+        let data = wtr.into_inner().unwrap();
+        tc.note(&format!("encoded: {:?}", data));
+
+        assert_eq!(rows, read_all(&config, &data));
+    }
 }
