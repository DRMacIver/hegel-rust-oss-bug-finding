diff --git a/csv-core/src/reader.rs b/csv-core/src/reader.rs
index 5bcbdfa..50dd1f8 100644
--- a/csv-core/src/reader.rs
+++ b/csv-core/src/reader.rs
@@ -2020,4 +2020,224 @@ mod tests {
         assert_eq!(result, Record);
         assert_eq!(ends[0], 3);
     }
+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    // This crate is no_std; hegel's generated code and these tests assume
+    // the std prelude, so link std explicitly and import what we need.
+    extern crate std;
+    use std::{format, string::ToString, vec, vec::Vec};
+
+    use hegel::generators;
+
+    use crate::ReadRecordResult;
+
+    /// An arbitrary core reader configuration. No validity constraints:
+    /// parsing must be independent of input chunking for any of them.
+    #[derive(Debug, Clone)]
+    struct CoreReaderConfig {
+        delimiter: u8,
+        quote: u8,
+        terminator: Terminator,
+        escape: Option<u8>,
+        double_quote: bool,
+        quoting: bool,
+        comment: Option<u8>,
+    }
+
+    #[hegel::composite]
+    fn core_reader_configs(tc: hegel::TestCase) -> CoreReaderConfig {
+        CoreReaderConfig {
+            delimiter: tc.draw(generators::integers::<u8>()),
+            quote: tc.draw(generators::integers::<u8>()),
+            terminator: if tc.draw(generators::booleans()) {
+                Terminator::CRLF
+            } else {
+                Terminator::Any(tc.draw(generators::integers::<u8>()))
+            },
+            escape: tc
+                .draw(generators::optional(generators::integers::<u8>())),
+            double_quote: tc.draw(generators::booleans()),
+            quoting: tc.draw(generators::booleans()),
+            comment: tc
+                .draw(generators::optional(generators::integers::<u8>())),
+        }
+    }
+
+    fn build_core_reader(config: &CoreReaderConfig) -> Reader {
+        ReaderBuilder::new()
+            .delimiter(config.delimiter)
+            .quote(config.quote)
+            .terminator(config.terminator)
+            .escape(config.escape)
+            .double_quote(config.double_quote)
+            .quoting(config.quoting)
+            .comment(config.comment)
+            .build()
+    }
+
+    /// Generate input bytes biased towards CSV structure: a mix of raw
+    /// binary chunks and the configuration's own special bytes.
+    fn draw_core_csvish_bytes(
+        tc: &hegel::TestCase,
+        config: &CoreReaderConfig,
+    ) -> Vec<u8> {
+        let mut specials =
+            vec![config.delimiter, config.quote, b'\r', b'\n', b',', b'"'];
+        if let Terminator::Any(t) = config.terminator {
+            specials.push(t);
+        }
+        if let Some(e) = config.escape {
+            specials.push(e);
+        }
+        if let Some(c) = config.comment {
+            specials.push(c);
+        }
+        let nseg = tc.draw(generators::integers::<usize>().max_value(12));
+        let mut data = Vec::new();
+        for _ in 0..nseg {
+            if tc.draw(generators::booleans()) {
+                data.extend(tc.draw(generators::binary()));
+            } else {
+                data.push(tc.draw(generators::sampled_from(specials.clone())));
+            }
+        }
+        data
+    }
+
+    /// Drive `read_record` over the given input chunks (then over empty
+    /// input until `End`), collecting the parsed records. Uses small
+    /// output/ends buffers so the `OutputFull`/`OutputEndsFull` resume
+    /// paths are exercised too; the `ends` positions are documented to be
+    /// "as if there was a single contiguous buffer", so field data is
+    /// accumulated across calls.
+    fn read_records_chunked(
+        rdr: &mut Reader,
+        chunks: &[Vec<u8>],
+    ) -> Vec<Vec<Vec<u8>>> {
+        let mut records: Vec<Vec<Vec<u8>>> = Vec::new();
+        let mut field_data: Vec<u8> = Vec::new();
+        let mut ends: Vec<usize> = Vec::new();
+
+        fn finish_record(
+            records: &mut Vec<Vec<Vec<u8>>>,
+            field_data: &mut Vec<u8>,
+            ends: &mut Vec<usize>,
+        ) {
+            let mut fields = Vec::new();
+            let mut last = 0;
+            for &end in ends.iter() {
+                fields.push(field_data[last..end].to_vec());
+                last = end;
+            }
+            records.push(fields);
+            field_data.clear();
+            ends.clear();
+        }
+
+        let mut steps = 0usize;
+        for chunk in chunks {
+            let mut inp = &chunk[..];
+            loop {
+                let mut out = [0u8; 97];
+                let mut end = [0usize; 7];
+                let (res, nin, nout, nend) =
+                    rdr.read_record(inp, &mut out, &mut end);
+                inp = &inp[nin..];
+                field_data.extend_from_slice(&out[..nout]);
+                ends.extend_from_slice(&end[..nend]);
+                steps += 1;
+                assert!(steps < 1_000_000, "reader made no progress");
+                match res {
+                    ReadRecordResult::InputEmpty => {
+                        if inp.is_empty() {
+                            break;
+                        }
+                    }
+                    ReadRecordResult::OutputFull
+                    | ReadRecordResult::OutputEndsFull => {}
+                    ReadRecordResult::Record => finish_record(
+                        &mut records,
+                        &mut field_data,
+                        &mut ends,
+                    ),
+                    ReadRecordResult::End => break,
+                }
+            }
+        }
+        // Signal EOF with empty input until End, as the docs instruct.
+        loop {
+            let mut out = [0u8; 97];
+            let mut end = [0usize; 7];
+            let (res, _, nout, nend) =
+                rdr.read_record(&[], &mut out, &mut end);
+            field_data.extend_from_slice(&out[..nout]);
+            ends.extend_from_slice(&end[..nend]);
+            steps += 1;
+            assert!(steps < 1_000_000, "reader made no progress at EOF");
+            match res {
+                ReadRecordResult::Record => finish_record(
+                    &mut records,
+                    &mut field_data,
+                    &mut ends,
+                ),
+                ReadRecordResult::End => break,
+                ReadRecordResult::InputEmpty
+                | ReadRecordResult::OutputFull
+                | ReadRecordResult::OutputEndsFull => {}
+            }
+        }
+        records
+    }
+
+    /// Property: parsing is independent of how the input is chunked —
+    /// feeding `read_record` the whole input at once and feeding it the
+    /// same bytes split at arbitrary boundaries yield the same records.
+    /// This is the core streaming contract (`read_record` docs: the
+    /// caller provides input as it becomes available and signals EOF with
+    /// an empty buffer).
+    ///
+    /// One documented exception: `strip_utf8_bom` "will fail to strip off
+    /// the BOM if only part of the BOM is buffered", so when the data
+    /// starts with a UTF-8 BOM the first chunk is forced to be at least 3
+    /// bytes long.
+    #[hegel::test]
+    fn hegel_chunked_input_equals_whole_input(tc: hegel::TestCase) {
+        let config = tc.draw(core_reader_configs());
+        let data = draw_core_csvish_bytes(&tc, &config);
+
+        // Split `data` into arbitrary non-empty chunks.
+        let mut chunks: Vec<Vec<u8>> = Vec::new();
+        let mut rest = &data[..];
+        // Documented BOM-buffering limitation: keep the BOM in one chunk.
+        if data.starts_with(b"\xef\xbb\xbf") {
+            let k = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(3)
+                    .max_value(data.len()),
+            );
+            chunks.push(rest[..k].to_vec());
+            rest = &rest[k..];
+        }
+        while !rest.is_empty() {
+            let k = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(rest.len()),
+            );
+            chunks.push(rest[..k].to_vec());
+            rest = &rest[k..];
+        }
+
+        let mut whole_rdr = build_core_reader(&config);
+        let whole =
+            read_records_chunked(&mut whole_rdr, &[data.clone()]);
+
+        let mut chunked_rdr = build_core_reader(&config);
+        let chunked = read_records_chunked(&mut chunked_rdr, &chunks);
+
+        assert_eq!(whole, chunked);
+    }
 }
