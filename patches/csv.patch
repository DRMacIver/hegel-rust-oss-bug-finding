index 011ab06..7ad04c5 100644
--- a/csv-core/src/writer.rs
+++ b/csv-core/src/writer.rs
@@ -1075,4 +1075,199 @@ mod tests {
         );
         assert_write!(wtr, finish, &mut out[..], 1, InputEmpty, "\"");
     }
+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    // This crate is no_std; hegel's generated code and these tests assume
+    // the std prelude, so link std explicitly and import what we need.
+    extern crate std;
+    use std::{format, string::ToString, vec, vec::Vec};
+
+    use hegel::generators;
+
+    use crate::{Terminator, WriteResult};
+
+    /// An arbitrary core writer configuration. No validity constraints:
+    /// whatever bytes are configured, streaming and one-shot writing must
+    /// produce identical output.
+    #[derive(Debug, Clone)]
+    struct CoreWriterConfig {
+        delimiter: u8,
+        quote: u8,
+        escape: u8,
+        double_quote: bool,
+        terminator: Terminator,
+        style: QuoteStyle,
+    }
+
+    #[hegel::composite]
+    fn core_writer_configs(tc: hegel::TestCase) -> CoreWriterConfig {
+        CoreWriterConfig {
+            delimiter: tc.draw(generators::integers::<u8>()),
+            quote: tc.draw(generators::integers::<u8>()),
+            escape: tc.draw(generators::integers::<u8>()),
+            double_quote: tc.draw(generators::booleans()),
+            terminator: if tc.draw(generators::booleans()) {
+                Terminator::CRLF
+            } else {
+                Terminator::Any(tc.draw(generators::integers::<u8>()))
+            },
+            style: tc.draw(generators::sampled_from(vec![
+                QuoteStyle::Always,
+                QuoteStyle::Necessary,
+                QuoteStyle::NonNumeric,
+                QuoteStyle::Never,
+            ])),
+        }
+    }
+
+    fn build_writer(config: &CoreWriterConfig) -> Writer {
+        WriterBuilder::new()
+            .delimiter(config.delimiter)
+            .quote(config.quote)
+            .escape(config.escape)
+            .double_quote(config.double_quote)
+            .terminator(config.terminator)
+            .quote_style(config.style)
+            .build()
+    }
+
+    /// Write all rows in one shot, with an output buffer big enough that
+    /// every call reports `InputEmpty` (per the `field` docs, a field
+    /// needs at most `2 + 2 * input.len()` output bytes).
+    fn write_oneshot(
+        config: &CoreWriterConfig,
+        rows: &[Vec<Vec<u8>>],
+    ) -> Vec<u8> {
+        let total: usize = rows
+            .iter()
+            .flat_map(|row| row.iter())
+            .map(|field| 2 + 2 * field.len())
+            .sum();
+        let ops: usize =
+            rows.iter().map(|row| row.len() + 1).sum::<usize>() + 1;
+        let mut buf = vec![0u8; 64 + total + 4 * ops];
+        let mut n = 0;
+        let mut wtr = build_writer(config);
+        for row in rows {
+            for (j, field) in row.iter().enumerate() {
+                if j > 0 {
+                    let (res, o) = wtr.delimiter(&mut buf[n..]);
+                    assert_eq!(WriteResult::InputEmpty, res);
+                    n += o;
+                }
+                let (res, i, o) = wtr.field(&field[..], &mut buf[n..]);
+                assert_eq!(WriteResult::InputEmpty, res);
+                assert_eq!(field.len(), i);
+                n += o;
+            }
+            let (res, o) = wtr.terminator(&mut buf[n..]);
+            assert_eq!(WriteResult::InputEmpty, res);
+            n += o;
+        }
+        let (res, o) = wtr.finish(&mut buf[n..]);
+        assert_eq!(WriteResult::InputEmpty, res);
+        n += o;
+        buf.truncate(n);
+        buf
+    }
+
+    /// Write all rows through tiny output buffers of `chunk` bytes,
+    /// resuming on `OutputFull` as the streaming API documents.
+    fn write_streaming(
+        config: &CoreWriterConfig,
+        rows: &[Vec<Vec<u8>>],
+        chunk: usize,
+    ) -> Vec<u8> {
+        let mut wtr = build_writer(config);
+        let mut out = Vec::new();
+        let mut steps = 0usize;
+        let guard = |steps: &mut usize| {
+            *steps += 1;
+            assert!(*steps < 1_000_000, "writer made no progress");
+        };
+        for row in rows {
+            for (j, field) in row.iter().enumerate() {
+                if j > 0 {
+                    loop {
+                        let mut buf = vec![0u8; chunk];
+                        let (res, o) = wtr.delimiter(&mut buf);
+                        out.extend_from_slice(&buf[..o]);
+                        guard(&mut steps);
+                        match res {
+                            WriteResult::InputEmpty => break,
+                            WriteResult::OutputFull => {}
+                        }
+                    }
+                }
+                let mut rem = &field[..];
+                loop {
+                    let mut buf = vec![0u8; chunk];
+                    let (res, i, o) = wtr.field(rem, &mut buf);
+                    rem = &rem[i..];
+                    out.extend_from_slice(&buf[..o]);
+                    guard(&mut steps);
+                    match res {
+                        WriteResult::InputEmpty => break,
+                        WriteResult::OutputFull => {}
+                    }
+                }
+            }
+            loop {
+                let mut buf = vec![0u8; chunk];
+                let (res, o) = wtr.terminator(&mut buf);
+                out.extend_from_slice(&buf[..o]);
+                guard(&mut steps);
+                match res {
+                    WriteResult::InputEmpty => break,
+                    WriteResult::OutputFull => {}
+                }
+            }
+        }
+        loop {
+            let mut buf = vec![0u8; chunk];
+            let (res, o) = wtr.finish(&mut buf);
+            out.extend_from_slice(&buf[..o]);
+            guard(&mut steps);
+            match res {
+                WriteResult::InputEmpty => break,
+                WriteResult::OutputFull => {}
+            }
+        }
+        out
+    }
+
+    /// Property: writing the same records via the streaming API with tiny
+    /// output buffers (resuming on `OutputFull`) produces byte-identical
+    /// output to writing with one large buffer. The `field`/`delimiter`/
+    /// `terminator`/`finish` docs define this resumability contract.
+    ///
+    /// The chunk size is at least 2 because the writer emits some
+    /// two-byte sequences atomically (escaped quotes, CRLF, the quoted
+    /// empty record); with a 1-byte buffer those can never make progress,
+    /// as documented on the `quote` free function.
+    #[hegel::test]
+    fn hegel_streaming_writes_equal_oneshot(tc: hegel::TestCase) {
+        let config = tc.draw(core_writer_configs());
+        let chunk = tc
+            .draw(generators::integers::<usize>().min_value(2).max_value(5));
+        let nrows =
+            tc.draw(generators::integers::<usize>().max_value(3));
+        let mut rows: Vec<Vec<Vec<u8>>> = Vec::new();
+        for _ in 0..nrows {
+            let nfields =
+                tc.draw(generators::integers::<usize>().max_value(3));
+            let mut row = Vec::new();
+            for _ in 0..nfields {
+                row.push(tc.draw(generators::binary()));
+            }
+            rows.push(row);
+        }
+
+        let oneshot = write_oneshot(&config, &rows);
+        let streaming = write_streaming(&config, &rows, chunk);
+        assert_eq!(oneshot, streaming);
+    }
 }
