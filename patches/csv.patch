+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    use hegel::generators;
+    use hegel::TestCase;
+
+    /// Trim per `u8::is_ascii_whitespace`, mirroring what
+    /// `ByteRecord::trim` actually does. NOTE: the *documented* class on
+    /// `ByteRecord::trim` is `[\t\n\v\f\r ]`, which additionally contains
+    /// `\v` (0x0B); that discrepancy is pinned by
+    /// `hegel_trim_documented_class_known_bug` below.
+    fn model_trim(field: &[u8]) -> Vec<u8> {
+        let start = field
+            .iter()
+            .position(|b| !b.is_ascii_whitespace())
+            .unwrap_or(field.len());
+        let end = field
+            .iter()
+            .rposition(|b| !b.is_ascii_whitespace())
+            .map(|i| i + 1)
+            .unwrap_or(start);
+        field[start..end].to_vec()
+    }
+
+    /// Model-based test: a `ByteRecord` behaves like a `Vec<Vec<u8>>`
+    /// under `push_field`, `truncate`, `clear` and `trim`, as observed
+    /// through `len`, `is_empty`, `get`, `iter`, `range` and `as_slice`
+    /// (which the docs tie together: "The boundaries of each field can be
+    /// determined via the `range` method").
+    struct ByteRecordMachine {
+        subject: ByteRecord,
+        model: Vec<Vec<u8>>,
+    }
+
+    #[hegel::state_machine]
+    impl ByteRecordMachine {
+        #[rule]
+        fn push_field(&mut self, tc: TestCase) {
+            let field = tc.draw(generators::binary());
+            self.subject.push_field(&field);
+            self.model.push(field);
+        }
+
+        #[rule]
+        fn truncate(&mut self, tc: TestCase) {
+            // Deliberately draw past the current length: truncating beyond
+            // the number of fields is documented to have no effect.
+            let n = tc.draw(
+                generators::integers::<usize>()
+                    .max_value(self.model.len() + 2),
+            );
+            self.subject.truncate(n);
+            self.model.truncate(n);
+        }
+
+        #[rule]
+        fn clear(&mut self, _: TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[rule]
+        fn trim(&mut self, _: TestCase) {
+            self.subject.trim();
+            for field in &mut self.model {
+                *field = model_trim(field);
+            }
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            let concat: Vec<u8> = self.model.concat();
+            assert_eq!(self.subject.as_slice(), &concat[..]);
+            for (i, field) in self.model.iter().enumerate() {
+                assert_eq!(self.subject.get(i), Some(&field[..]));
+                let range = self.subject.range(i).expect("range for field");
+                assert_eq!(&self.subject.as_slice()[range], &field[..]);
+            }
+            assert_eq!(self.subject.get(self.model.len()), None);
+            assert_eq!(self.subject.range(self.model.len()), None);
+            assert!(self
+                .subject
+                .iter()
+                .eq(self.model.iter().map(|f| &f[..])));
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_byte_record_model(tc: TestCase) {
+        let machine = ByteRecordMachine {
+            subject: ByteRecord::new(),
+            model: Vec::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    /// The whitespace class documented on `ByteRecord::trim`:
+    /// "only bytes in the class `[\t\n\v\f\r ]` are trimmed".
+    const DOC_WHITESPACE: &[u8] = b"\t\n\x0b\x0c\r ";
+
+    fn doc_trim(field: &[u8]) -> Vec<u8> {
+        let start = field
+            .iter()
+            .position(|b| !DOC_WHITESPACE.contains(b))
+            .unwrap_or(field.len());
+        let end = field
+            .iter()
+            .rposition(|b| !DOC_WHITESPACE.contains(b))
+            .map(|i| i + 1)
+            .unwrap_or(start);
+        field[start..end].to_vec()
+    }
+
+    /// Draw a field biased towards whitespace bytes so trimming happens.
+    fn draw_whitespacey_field(tc: &TestCase) -> Vec<u8> {
+        let len = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut field = Vec::new();
+        for _ in 0..len {
+            if tc.draw(generators::booleans()) {
+                field.push(
+                    tc.draw(generators::sampled_from(DOC_WHITESPACE.to_vec())),
+                );
+            } else {
+                field.push(tc.draw(generators::integers::<u8>()));
+            }
+        }
+        field
+    }
+
+    /// Property: `ByteRecord::trim` removes exactly the whitespace bytes
+    /// documented on the method (`[\t\n\v\f\r ]`) from both ends of every
+    /// field.
+    ///
+    /// KNOWN BUG exclusion: fields containing `\v` (0x0B) are excluded
+    /// here; the implementation uses `u8::is_ascii_whitespace`, which does
+    /// not treat `\v` as whitespace, contradicting the documentation. That
+    /// discrepancy is pinned by `hegel_trim_documented_class_known_bug`.
+    #[hegel::test]
+    fn hegel_trim_matches_documented_class(tc: TestCase) {
+        let nfields =
+            tc.draw(generators::integers::<usize>().max_value(4));
+        let mut fields = Vec::new();
+        for _ in 0..nfields {
+            let mut field = draw_whitespacey_field(&tc);
+            field.retain(|&b| b != 0x0b); // see KNOWN BUG exclusion above
+            fields.push(field);
+        }
+        let mut rec = ByteRecord::new();
+        for field in &fields {
+            rec.push_field(field);
+        }
+        rec.trim();
+        let expected: Vec<Vec<u8>> =
+            fields.iter().map(|f| doc_trim(f)).collect();
+        let got: Vec<Vec<u8>> = rec.iter().map(|f| f.to_vec()).collect();
+        assert_eq!(expected, got);
+    }
+
+    /// KNOWN FAILURE: pins a real (documentation) bug.
+    ///
+    /// `ByteRecord::trim` documents: "only bytes in the class
+    /// `[\t\n\v\f\r ]` are trimmed", but the implementation trims via
+    /// `u8::is_ascii_whitespace`, which does *not* include `\v` (0x0B).
+    /// A field with a leading `\v` therefore keeps it. (Notably, the
+    /// existing unit test `trim_whitespace_only` exercises
+    /// `" \t\n\r\x0c"` — every documented byte except `\v`.)
+    #[hegel::test]
+    fn hegel_trim_documented_class_known_bug(tc: TestCase) {
+        // A field that always starts with `\v` followed by arbitrary
+        // non-whitespace data.
+        let mut field = vec![0x0b];
+        let suffix_len =
+            tc.draw(generators::integers::<usize>().max_value(4));
+        for _ in 0..suffix_len {
+            let mut b = tc.draw(generators::integers::<u8>());
+            while DOC_WHITESPACE.contains(&b) {
+                b = b.wrapping_add(1);
+            }
+            field.push(b);
+        }
+        let mut rec = ByteRecord::new();
+        rec.push_field(&field);
+        rec.trim();
+        assert_eq!(rec.get(0), Some(&doc_trim(&field)[..]));
+    }
 }
