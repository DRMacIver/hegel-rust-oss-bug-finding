+    /// With a fresh `ByteRecord` (4-byte initial field buffer), any
+    /// unterminated record of length >= 5 shows it: reading `aaaaa` with
+    /// `nfa(true)` yields `aaaa\0`. Shrunk from
+    /// `hegel_dfa_nfa_equivalence` (original counterexample: input
+    /// [1,1,1,1,1], DFA [[1,1,1,1,1]] vs NFA [[1,1,1,1,0]]).
+    ///
+    /// The same corruption also triggers via `OutputEndsFull` resumes
+    /// (found by the 10x exploratory run: delimiter-heavy records overflow
+    /// the ends buffer mid-record with `output_pos > 0`), and would also
+    /// trigger for records spanning multiple `fill_buf` chunks.
+    #[hegel::test]
+    fn hegel_nfa_corrupts_records_spanning_output_buffers_known_bug(
+        tc: hegel::TestCase,
+    ) {
+        let n = tc.draw(
+            generators::integers::<usize>().min_value(5).max_value(64),
+        );
+        let data = vec![b'a'; n];
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .nfa(true)
+            .from_reader(&data[..]);
+        let mut rec = ByteRecord::new();
+        assert!(rdr.read_byte_record(&mut rec).unwrap());
+        let got: Vec<Vec<u8>> = rec.iter().map(|f| f.to_vec()).collect();
+        assert_eq!(vec![data.clone()], got);
+    }
+
+    /// KNOWN FAILURE: pins a real bug.
+    ///
+    /// When the input ends inside a comment line (i.e. the final line
+    /// starts with the comment byte and has no trailing terminator), the
+    /// default DFA path emits a phantom empty record, while the NFA path
+    /// (and the documented behavior of comments: such lines are skipped)
+    /// yields nothing. Root cause: `transition_final_dfa` in csv-core
+    /// emits a record for *any* non-start, non-final state at EOF,
+    /// including `InComment`, whereas `transition_final_nfa` correctly
+    /// maps `InComment` to `End`.
+    ///
+    /// Found by `hegel_dfa_nfa_equivalence` (shrunk counterexample:
+    /// delimiter=0, comment=Some(0), input [0] => DFA [[""]], NFA []).
+    /// Reproduces with a plain config: reading
+    /// `"a,b\n# trailing comment"` with `comment(Some(b'#'))` yields
+    /// [["a", "b"], [""]].
+    #[hegel::test]
+    fn hegel_trailing_comment_line_yields_phantom_record_known_bug(
+        tc: hegel::TestCase,
+    ) {
+        // A normal record, then a comment line with no trailing newline.
+        let comment_len = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut data = b"a,b\n#".to_vec();
+        for _ in 0..comment_len {
+            // Comment content: anything but specials/terminators.
+            let b = draw_byte_avoiding_specials(&tc);
+            data.push(b);
+        }
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .comment(Some(b'#'))
+            .flexible(true)
+            .from_reader(&data[..]);
+        let mut rec = ByteRecord::new();
+        assert!(rdr.read_byte_record(&mut rec).unwrap());
+        assert_eq!(
+            rec.iter().collect::<Vec<_>>(),
+            vec![&b"a"[..], &b"b"[..]]
+        );
+        // The comment line must not produce a record.
+        assert!(
+            !rdr.read_byte_record(&mut rec).unwrap(),
+            "phantom record after trailing comment line: {:?}",
+            rec
+        );
+    }
+
+    /// Draw a byte that is not a delimiter, quote, comment marker or line
+    /// terminator under the default configuration.
+    fn draw_byte_avoiding_specials(tc: &hegel::TestCase) -> u8 {
+        let mut b = tc.draw(generators::integers::<u8>());
+        while [b',', b'"', b'#', b'\r', b'\n'].contains(&b) {
+            b = b.wrapping_add(1);
+        }
+        b
+    }
+
+    /// KNOWN FAILURE: pins a real bug.
+    ///
+    /// The NFA exits the `InComment` state on a literal `\n` regardless of
+    /// the configured terminator (`transition_nfa` hardcodes `b'\n' == c`),
+    /// but when the terminator is `Terminator::Any(t)` the DFA's byte
+    /// equivalence classes do not distinguish `\n` (`build_dfa` only adds
+    /// `\r`/`\n` as classes for CRLF terminators). All bytes in the same
+    /// class share one transition-table cell, so on the DFA path a comment
+    /// never ends at `\n`: the rest of the input is swallowed as comment,
+    /// and EOF inside the comment then emits the phantom empty record (see
+    /// `hegel_trailing_comment_line_yields_phantom_record_known_bug`).
+    ///
+    /// Found by `hegel_dfa_nfa_equivalence` (shrunk counterexample:
+    /// terminator=Any(0), comment=Some(127), input [127, 10] => DFA
+    /// [[""]], NFA []). This test states the violated property directly:
+    /// DFA and NFA must agree.
+    #[hegel::test]
+    fn hegel_dfa_nfa_disagree_on_comments_with_any_terminator_known_bug(
+        tc: hegel::TestCase,
+    ) {
+        let mut term = tc.draw(generators::integers::<u8>());
+        while [b'#', b'x', b'c', b'\r', b'\n'].contains(&term) {
+            term = term.wrapping_add(1);
+        }
+        // A comment line ended by `\n`, then a record terminated by `term`.
+        let data = [&b"#c\nx"[..], &[term]].concat();
+        let config = ArbReaderConfig {
+            delimiter: b',',
+            quote: b'"',
+            terminator: Terminator::Any(term),
+            escape: None,
+            double_quote: true,
+            quoting: true,
+            comment: Some(b'#'),
+            flexible: false,
+        };
+        let mut dfa_rdr = arb_builder(&config).from_reader(&data[..]);
+        let dfa = collect_outcomes(&mut dfa_rdr, data.len());
+        let mut nfa_rdr =
+            arb_builder(&config).nfa(true).from_reader(&data[..]);
+        let nfa = collect_outcomes(&mut nfa_rdr, data.len());
+        assert_eq!(dfa, nfa);
+    }
+
+    /// KNOWN FAILURE: pins a real bug.
+    ///
+    /// The NFA code paths in csv-core (`read_record_nfa`,
+    /// `read_field_nfa`) never update `self.line`, while the DFA paths
+    /// increment it on every `\n` consumed. With `nfa(true)`, every
+    /// position reported by the reader claims line 1. Found by
+    /// `hegel_dfa_nfa_equivalence` (position comparison).
+    #[hegel::test]
+    fn hegel_nfa_does_not_track_line_numbers_known_bug(tc: hegel::TestCase) {
+        let nrows = tc.draw(
+            generators::integers::<usize>().min_value(2).max_value(6),
+        );
+        let data = b"x\n".repeat(nrows);
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .nfa(true)
+            .from_reader(&data[..]);
+        let mut rec = ByteRecord::new();
+        for i in 0..nrows {
+            assert!(rdr.read_byte_record(&mut rec).unwrap());
+            let pos = rec.position().expect("record has a position");
+            assert_eq!(
+                pos.line(),
+                i as u64 + 1,
+                "record {} reports the wrong line",
+                i
+            );
+        }
+    }
+
+    /// Property: `position()` before reading a record can be `seek`ed to
+    /// and yields the same record and all subsequent records again
+    /// (documented on `Reader::position`: "seeking to a position returned
+    /// here on the same data will result in parsing the same subsequent
+    /// record").
+    #[hegel::test]
+    fn hegel_position_seek_roundtrip(tc: hegel::TestCase) {
+        let width = tc.draw(
+            generators::integers::<usize>().min_value(1).max_value(3),
+        );
+        let nrows = tc.draw(
+            generators::integers::<usize>().min_value(1).max_value(5),
+        );
+        let mut rows: Vec<Vec<Vec<u8>>> = Vec::new();
+        for _ in 0..nrows {
+            let mut row = Vec::new();
+            for _ in 0..width {
+                row.push(tc.draw(generators::binary()));
+            }
+            rows.push(row);
+        }
+        let mut wtr = WriterBuilder::new().from_writer(vec![]);
+        for row in &rows {
+            wtr.write_record(row).unwrap();
+        }
+        let data = wtr.into_inner().unwrap();
+
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .from_reader(io::Cursor::new(data));
+        let mut positions = Vec::new();
+        let mut records: Vec<ByteRecord> = Vec::new();
+        let mut rec = ByteRecord::new();
+        loop {
+            let pos = rdr.position().clone();
+            if !rdr.read_byte_record(&mut rec).unwrap() {
+                break;
+            }
+            positions.push(pos);
+            records.push(rec.clone());
+        }
+        assert_eq!(records.len(), rows.len());
+
+        let idx = tc.draw(
+            generators::integers::<usize>().max_value(records.len() - 1),
+        );
+        rdr.seek(positions[idx].clone()).unwrap();
+        for expected in &records[idx..] {
+            assert!(rdr.read_byte_record(&mut rec).unwrap());
+            assert_eq!(&rec, expected);
+            assert_eq!(rec.position(), expected.position());
+        }
+        assert!(!rdr.read_byte_record(&mut rec).unwrap());
+    }
+
+    /// Property: with `flexible(true)` the reader returns records of
+    /// varying lengths as-is; with the default strict mode, each record
+    /// whose length differs from the *first* record's length yields an
+    /// `UnequalLengths` error carrying the documented `expected_len`/`len`
+    /// values (see `ReaderBuilder::flexible` and `ReaderState::add_record`).
+    #[hegel::test]
+    fn hegel_flexible_vs_strict_record_lengths(tc: hegel::TestCase) {
+        let nrows = tc.draw(
+            generators::integers::<usize>().min_value(1).max_value(5),
+        );
+        let mut rows: Vec<Vec<Vec<u8>>> = Vec::new();
+        for _ in 0..nrows {
+            let width = tc.draw(
+                generators::integers::<usize>().min_value(1).max_value(4),
+            );
+            let mut row = Vec::new();
+            for _ in 0..width {
+                row.push(tc.draw(generators::binary()));
+            }
+            rows.push(row);
+        }
+        let mut wtr =
+            WriterBuilder::new().flexible(true).from_writer(vec![]);
+        for row in &rows {
+            wtr.write_record(row).unwrap();
+        }
+        let data = wtr.into_inner().unwrap();
+
+        // Flexible: all records come back unchanged.
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .flexible(true)
+            .from_reader(&data[..]);
+        let mut got: Vec<Vec<Vec<u8>>> = Vec::new();
+        let mut rec = ByteRecord::new();
+        while rdr.read_byte_record(&mut rec).unwrap() {
+            got.push(rec.iter().map(|f| f.to_vec()).collect());
+        }
+        assert_eq!(rows, got);
+
+        // Strict: a record errors if and only if its length differs from
+        // the first record's length.
+        let expected_len = rows[0].len();
+        let mut rdr = ReaderBuilder::new()
+            .has_headers(false)
+            .from_reader(&data[..]);
+        for row in &rows {
+            if row.len() == expected_len {
+                assert!(rdr.read_byte_record(&mut rec).unwrap());
+                assert_eq!(&rec, row);
+            } else {
+                let err = rdr.read_byte_record(&mut rec).unwrap_err();
+                match *err.kind() {
+                    ErrorKind::UnequalLengths { expected_len: e, len, .. } => {
+                        assert_eq!(e, expected_len as u64);
+                        assert_eq!(len, row.len() as u64);
+                    }
+                    ref wrong => {
+                        panic!("expected UnequalLengths, got {:?}", wrong)
+                    }
+                }
+            }
+        }
+        assert!(!rdr.read_byte_record(&mut rec).unwrap());
+    }
+
+    /// Property: the reader never panics on arbitrary input bytes under any
+    /// configuration (including `trim` and header handling, and the
+    /// `StringRecord` path which performs UTF-8 validation); byte positions
+    /// never decrease and never exceed the input length; and the reader
+    /// reports `is_done()` after exhaustion.
+    #[hegel::test]
+    fn hegel_reader_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+        let config = tc.draw(arb_reader_configs());
+        let trim = tc.draw(generators::sampled_from(vec![
+            Trim::None,
+            Trim::Headers,
+            Trim::Fields,
+            Trim::All,
+        ]));
+        let has_headers = tc.draw(generators::booleans());
+        let data = draw_csvish_bytes(&tc, &config);
+
+        let mut builder = arb_builder(&config);
+        builder.trim(trim).has_headers(has_headers);
+        let mut rdr = builder.from_reader(&data[..]);
+        // May return a UTF-8 error, but must not panic.
+        let _ = rdr.headers().map(|h| h.clone());
+
+        let mut rec = StringRecord::new();
+        let mut iterations = 0usize;
+        loop {
+            let before = rdr.position().byte();
+            let result = rdr.read_record(&mut rec);
+            let after = rdr.position().byte();
+            assert!(after >= before, "position went backwards");
+            assert!(after as usize <= data.len(), "position beyond input");
+            match result {
+                Ok(false) => break,
+                Ok(true) | Err(_) => {}
+            }
+            iterations += 1;
+            assert!(
+                iterations <= data.len() + 8,
+                "reader appears to be stuck"
+            );
+        }
+        assert!(rdr.is_done());
+    }
 }
