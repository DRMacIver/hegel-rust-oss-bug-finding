+// Property-based tests written with hegel.
+//
+// The centrepiece is a stateful model test: we mirror every `insert`/`remove`
+// in a `BTreeMap<i32, u8>` treated as a per-point model of the map's contents
+// over a bounded integer domain, and after every operation check that
+// `RangeMap::get` agrees with the model at every point in (and slightly
+// beyond) that domain, that no two stored ranges are adjacent with equal
+// values (the crate's headline coalescing promise), and that stored ranges
+// are sorted, non-empty, and non-overlapping.
+#[cfg(test)]
+mod hegel_tests {
+    use super::*;
+    use alloc::collections::BTreeMap;
+    use alloc::format;
+    use alloc::string::ToString;
+    use alloc::vec;
+    use alloc::vec::Vec;
+    use core::ops::Range;
+    use hegel::generators;
+    use hegel::TestCase;
+
+    // Bounded domain for the per-point model. Small enough that checking
+    // every point after every operation is cheap, large enough that many
+    // distinct overlap/adjacency configurations arise.
+    const DOMAIN_MIN: i32 = -50;
+    const DOMAIN_MAX: i32 = 50;
+
+    /// Draw a non-empty `Range<i32>` with endpoints inside the model domain.
+    fn draw_domain_range(tc: &TestCase) -> Range<i32> {
+        let start = tc.draw(
+            generators::integers::<i32>()
+                .min_value(DOMAIN_MIN)
+                .max_value(DOMAIN_MAX - 1),
+        );
+        let end = tc.draw(
+            generators::integers::<i32>()
+                .min_value(start + 1)
+                .max_value(DOMAIN_MAX),
+        );
+        start..end
+    }
+
+    /// Draw a small value. The value domain is deliberately tiny so that
+    /// inserted ranges frequently collide with equal-valued neighbours,
+    /// exercising the coalescing paths.
+    fn draw_value(tc: &TestCase) -> u8 {
+        tc.draw(generators::integers::<u8>().max_value(2))
+    }
+
+    /// Apply a drawn sequence of insert/remove operations to both a
+    /// `RangeMap` and the per-point model.
+    fn apply_random_ops(tc: &TestCase, map: &mut RangeMap<i32, u8>, model: &mut BTreeMap<i32, u8>) {
+        let num_ops = tc.draw(generators::integers::<usize>().max_value(12));
+        for _ in 0..num_ops {
+            let range = draw_domain_range(tc);
+            if tc.draw(generators::booleans()) {
+                let value = draw_value(tc);
+                map.insert(range.clone(), value);
+                for p in range {
+                    model.insert(p, value);
+                }
+            } else {
+                map.remove(range.clone());
+                for p in range {
+                    model.remove(&p);
+                }
+            }
+        }
+    }
+
+    struct MapVsPointModel {
+        map: RangeMap<i32, u8>,
+        model: BTreeMap<i32, u8>,
+    }
+
+    #[hegel::state_machine]
+    impl MapVsPointModel {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let range = draw_domain_range(&tc);
+            let value = draw_value(&tc);
+            self.map.insert(range.clone(), value);
+            for p in range {
+                self.model.insert(p, value);
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let range = draw_domain_range(&tc);
+            self.map.remove(range.clone());
+            for p in range {
+                self.model.remove(&p);
+            }
+        }
+
+        // Property: `get` agrees with the per-point model at every point of
+        // the domain (and slightly beyond it, to catch anything leaking past
+        // the domain edges).
+        #[invariant]
+        fn per_point_agreement(&self, _: TestCase) {
+            for p in (DOMAIN_MIN - 2)..=(DOMAIN_MAX + 2) {
+                assert_eq!(
+                    self.map.get(&p),
+                    self.model.get(&p),
+                    "map and point model diverged at point {}",
+                    p
+                );
+            }
+        }
+
+        // Property: "Contiguous and overlapping ranges that map to the same
+        // value are coalesced into a single range" -- so no two stored
+        // ranges may be adjacent AND carry equal values.
+        #[invariant]
+        fn coalesced(&self, _: TestCase) {
+            let mut iter = self.map.iter().peekable();
+            while let Some((range, value)) = iter.next() {
+                if let Some((next_range, next_value)) = iter.peek() {
+                    assert!(
+                        !(range.end == next_range.start && value == *next_value),
+                        "adjacent ranges {:?} and {:?} with equal value {:?} were not coalesced",
+                        range,
+                        next_range,
+                        value
+                    );
+                }
+            }
+        }
+
+        // Property: stored ranges are non-empty, sorted by start, and
+        // non-overlapping.
+        #[invariant]
+        fn sorted_disjoint_nonempty(&self, _: TestCase) {
+            let mut prev_end: Option<i32> = None;
+            for (range, _) in self.map.iter() {
+                assert!(range.start < range.end, "stored empty range {:?}", range);
+                if let Some(prev_end) = prev_end {
+                    assert!(
+                        prev_end <= range.start,
+                        "stored ranges out of order or overlapping around {:?}",
+                        range
+                    );
+                }
+                prev_end = Some(range.end);
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_map_matches_point_model(tc: TestCase) {
+        let machine = MapVsPointModel {
+            map: RangeMap::new(),
+            model: BTreeMap::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    // Property: `gaps(outer)` returns exactly the maximal uncovered runs of
+    // points within `outer`, as computed naively from the per-point model.
+    #[hegel::test]
+    fn hegel_gaps_match_point_model(tc: TestCase) {
+        let mut map = RangeMap::new();
+        let mut model = BTreeMap::new();
+        apply_random_ops(&tc, &mut map, &mut model);
+
+        // The outer range may extend beyond the stored domain and may be empty.
+        let outer_start = tc.draw(
+            generators::integers::<i32>()
+                .min_value(DOMAIN_MIN - 5)
+                .max_value(DOMAIN_MAX + 5),
+        );
+        let outer_end = tc.draw(
+            generators::integers::<i32>()
+                .min_value(outer_start)
+                .max_value(DOMAIN_MAX + 5),
+        );
+        let outer = outer_start..outer_end;
+
+        let gaps: Vec<Range<i32>> = map.gaps(&outer).collect();
+
+        // Naive oracle: walk every point of the outer range, collecting
+        // maximal runs of points not covered by the model.
+        let mut expected: Vec<Range<i32>> = Vec::new();
+        let mut run_start: Option<i32> = None;
+        for p in outer.clone() {
+            if model.contains_key(&p) {
+                if let Some(s) = run_start.take() {
+                    expected.push(s..p);
+                }
+            } else if run_start.is_none() {
+                run_start = Some(p);
+            }
+        }
+        if let Some(s) = run_start {
+            expected.push(s..outer.end);
+        }
+
+        assert_eq!(gaps, expected, "gaps({:?}) diverged from point model", outer);
+    }
+
+    // Property: `overlapping(query)` yields exactly the stored ranges that
+    // overlap the query range, in order. The oracle is a naive filter over
+    // `iter()`, which uses a different code path (plain BTreeMap iteration)
+    // than `overlapping`'s range-wrapper search.
+    #[hegel::test]
+    fn hegel_overlapping_matches_iter_filter(tc: TestCase) {
+        let mut map = RangeMap::new();
+        let mut model = BTreeMap::new();
+        apply_random_ops(&tc, &mut map, &mut model);
+
+        let query_start = tc.draw(
+            generators::integers::<i32>()
+                .min_value(DOMAIN_MIN - 5)
+                .max_value(DOMAIN_MAX + 5),
+        );
+        let query_end = tc.draw(
+            generators::integers::<i32>()
+                .min_value(query_start)
+                .max_value(DOMAIN_MAX + 5),
+        );
+        let query = query_start..query_end;
+
+        let via_overlapping: Vec<(&Range<i32>, &u8)> = map.overlapping(&query).collect();
+        let via_filter: Vec<(&Range<i32>, &u8)> = map
+            .iter()
+            .filter(|(range, _)| range.start < query.end && query.start < range.end)
+            .collect();
+        assert_eq!(via_overlapping, via_filter);
+    }
+
+    // Property: empty (and backwards) ranges are rejected. `insert` and
+    // `remove` document "Panics if range start >= end".
+    #[hegel::test]
+    fn hegel_empty_range_ops_panic(tc: TestCase) {
+        // Any start..end with start >= end, over the full i32 range.
+        let end = tc.draw(generators::integers::<i32>());
+        let start = tc.draw(generators::integers::<i32>().min_value(end));
+
+        let insert_result = std::panic::catch_unwind(move || {
+            let mut map: RangeMap<i32, u8> = RangeMap::new();
+            map.insert(start..end, 0);
+        });
+        assert!(
+            insert_result.is_err(),
+            "insert({}..{}) should panic for start >= end",
+            start,
+            end
+        );
+
+        let remove_result = std::panic::catch_unwind(move || {
+            let mut map: RangeMap<i32, u8> = RangeMap::new();
+            map.insert(i32::MIN..i32::MAX, 0);
+            map.remove(start..end);
+        });
+        assert!(
+            remove_result.is_err(),
+            "remove({}..{}) should panic for start >= end",
+            start,
+            end
+        );
+    }
+
+    /// Structural invariants that must hold for any `RangeMap`:
+    /// stored ranges non-empty, sorted, disjoint, and coalesced.
+    fn assert_well_formed(map: &RangeMap<i32, u8>) {
+        let mut prev: Option<(&Range<i32>, &u8)> = None;
+        for (range, value) in map.iter() {
+            assert!(range.start < range.end, "stored empty range {:?}", range);
+            if let Some((prev_range, prev_value)) = prev {
+                assert!(
+                    prev_range.end <= range.start,
+                    "stored ranges out of order or overlapping: {:?} then {:?}",
+                    prev_range,
+                    range
+                );
+                assert!(
+                    !(prev_range.end == range.start && prev_value == value),
+                    "adjacent ranges {:?} and {:?} with equal value {:?} were not coalesced",
+                    prev_range,
+                    range,
+                    value
+                );
+            }
+            prev = Some((range, value));
+        }
+    }
+
+    /// Draw an i32 boosted towards the type's boundary values, where
+    /// overflow bugs would hide. (The bounded-domain model test above can
+    /// never produce these.)
+    fn draw_extreme_i32(tc: &TestCase) -> i32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i32>(),
+            generators::sampled_from(vec![
+                i32::MIN,
+                i32::MIN + 1,
+                -1,
+                0,
+                1,
+                i32::MAX - 1,
+                i32::MAX
+            ]),
+        ))
+    }
+
+    // Property: insert/remove never panic and preserve the structural
+    // invariants across the FULL i32 domain, including i32::MIN/MAX
+    // endpoints.
+    #[hegel::test]
+    fn hegel_full_i32_domain_invariants(tc: TestCase) {
+        let mut map: RangeMap<i32, u8> = RangeMap::new();
+        let num_ops = tc.draw(generators::integers::<usize>().max_value(16));
+        for _ in 0..num_ops {
+            let a = draw_extreme_i32(&tc);
+            let b = draw_extreme_i32(&tc);
+            let (start, end) = if a <= b { (a, b) } else { (b, a) };
+            // Nudge equal endpoints apart: insert/remove require non-empty
+            // ranges (that contract is tested separately above).
+            let (start, end) = if start == end {
+                if end == i32::MAX {
+                    (start - 1, end)
+                } else {
+                    (start, end + 1)
+                }
+            } else {
+                (start, end)
+            };
+            let value = draw_value(&tc);
+            if tc.draw(generators::booleans()) {
+                map.insert(start..end, value);
+            } else {
+                map.remove(start..end);
+            }
+            assert_well_formed(&map);
+        }
+    }
+}
