+// Property-based tests written with hegel.
+//
+// Mirrors the `RangeMap` hegel tests in `map.rs`, but for the inclusive
+// variant, which has its own arithmetic (`add_one`/`sub_one` stepping for
+// adjacency detection) and is a classic spot for off-by-one and overflow
+// bugs. The key type is `u8` and generated ranges span the FULL `u8` domain,
+// so `0..=255`, `255..=255`, and other boundary-hugging ranges are generated
+// routinely, and the per-point model check enumerates every one of the 256
+// possible keys.
+#[cfg(test)]
+mod hegel_tests {
+    use super::*;
+    use alloc::collections::BTreeMap;
+    use alloc::format;
+    use alloc::string::ToString;
+    use alloc::vec::Vec;
+    use core::ops::RangeInclusive;
+    use hegel::generators;
+    use hegel::TestCase;
+
+    /// Draw a valid (start <= end) `RangeInclusive<u8>` anywhere in the full
+    /// `u8` domain, including ranges touching 0 and 255.
+    fn draw_u8_inclusive_range(tc: &TestCase) -> RangeInclusive<u8> {
+        let start = tc.draw(generators::integers::<u8>());
+        let end = tc.draw(generators::integers::<u8>().min_value(start));
+        start..=end
+    }
+
+    /// Small value domain so equal-valued neighbours (and hence coalescing)
+    /// are common.
+    fn draw_value(tc: &TestCase) -> u8 {
+        tc.draw(generators::integers::<u8>().max_value(2))
+    }
+
+    /// Apply a drawn sequence of insert/remove operations to both a
+    /// `RangeInclusiveMap` and a per-point model.
+    fn apply_random_ops(
+        tc: &TestCase,
+        map: &mut RangeInclusiveMap<u8, u8>,
+        model: &mut BTreeMap<u8, u8>,
+    ) {
+        let num_ops = tc.draw(generators::integers::<usize>().max_value(12));
+        for _ in 0..num_ops {
+            let range = draw_u8_inclusive_range(tc);
+            if tc.draw(generators::booleans()) {
+                let value = draw_value(tc);
+                map.insert(range.clone(), value);
+                for p in range {
+                    model.insert(p, value);
+                }
+            } else {
+                map.remove(range.clone());
+                for p in range {
+                    model.remove(&p);
+                }
+            }
+        }
+    }
+
+    struct InclusiveMapVsPointModel {
+        map: RangeInclusiveMap<u8, u8>,
+        model: BTreeMap<u8, u8>,
+    }
+
+    #[hegel::state_machine]
+    impl InclusiveMapVsPointModel {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let range = draw_u8_inclusive_range(&tc);
+            let value = draw_value(&tc);
+            self.map.insert(range.clone(), value);
+            for p in range {
+                self.model.insert(p, value);
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let range = draw_u8_inclusive_range(&tc);
+            self.map.remove(range.clone());
+            for p in range {
+                self.model.remove(&p);
+            }
+        }
+
+        // Property: `get` agrees with the per-point model at every one of
+        // the 256 possible keys.
+        #[invariant]
+        fn per_point_agreement(&self, _: TestCase) {
+            for p in 0..=255u8 {
+                assert_eq!(
+                    self.map.get(&p),
+                    self.model.get(&p),
+                    "map and point model diverged at point {}",
+                    p
+                );
+            }
+        }
+
+        // Property: no two stored ranges are adjacent (prev.end() + 1 ==
+        // next.start()) with equal values -- they must have been coalesced.
+        // Inclusive-range adjacency needs successor arithmetic, which is
+        // exactly where off-by-one bugs live.
+        #[invariant]
+        fn coalesced(&self, _: TestCase) {
+            let mut iter = self.map.iter().peekable();
+            while let Some((range, value)) = iter.next() {
+                if let Some((next_range, next_value)) = iter.peek() {
+                    let adjacent = range.end().checked_add(1) == Some(*next_range.start());
+                    assert!(
+                        !(adjacent && value == *next_value),
+                        "adjacent ranges {:?} and {:?} with equal value {:?} were not coalesced",
+                        range,
+                        next_range,
+                        value
+                    );
+                }
+            }
+        }
+
+        // Property: stored ranges are valid (start <= end), sorted, and
+        // strictly disjoint (an inclusive range's end is a covered point, so
+        // disjointness means prev.end() < next.start()).
+        #[invariant]
+        fn sorted_disjoint_valid(&self, _: TestCase) {
+            let mut prev_end: Option<u8> = None;
+            for (range, _) in self.map.iter() {
+                assert!(range.start() <= range.end(), "backwards range {:?}", range);
+                if let Some(prev_end) = prev_end {
+                    assert!(
+                        prev_end < *range.start(),
+                        "stored ranges out of order or overlapping around {:?}",
+                        range
+                    );
+                }
+                prev_end = Some(*range.end());
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_inclusive_map_matches_point_model(tc: TestCase) {
+        let machine = InclusiveMapVsPointModel {
+            map: RangeInclusiveMap::new(),
+            model: BTreeMap::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    // Property: `gaps(outer)` returns exactly the maximal uncovered runs of
+    // points within `outer`, as computed naively from the per-point model.
+    // Inclusive endpoints make the gap-edge arithmetic (add_one/sub_one)
+    // easy to get wrong, especially with outer ranges ending at u8::MAX.
+    #[hegel::test]
+    fn hegel_inclusive_gaps_match_point_model(tc: TestCase) {
+        let mut map = RangeInclusiveMap::new();
+        let mut model = BTreeMap::new();
+        apply_random_ops(&tc, &mut map, &mut model);
+
+        let outer = draw_u8_inclusive_range(&tc);
+        let gaps: Vec<RangeInclusive<u8>> = map.gaps(&outer).collect();
+
+        // Naive oracle: walk every point of the outer range, collecting
+        // maximal runs of points not covered by the model.
+        let mut expected: Vec<RangeInclusive<u8>> = Vec::new();
+        let mut run_start: Option<u8> = None;
+        let mut p = *outer.start();
+        loop {
+            if model.contains_key(&p) {
+                if let Some(s) = run_start.take() {
+                    // A run that ended just before a covered point `p`.
+                    // `p >= 1` here because the run started strictly before `p`.
+                    expected.push(s..=p - 1);
+                }
+            } else if run_start.is_none() {
+                run_start = Some(p);
+            }
+            if p == *outer.end() {
+                break;
+            }
+            p += 1;
+        }
+        if let Some(s) = run_start {
+            expected.push(s..=*outer.end());
+        }
+
+        assert_eq!(gaps, expected, "gaps({:?}) diverged from point model", outer);
+    }
+
+    // Property: backwards ranges are rejected. `insert` and `remove`
+    // document "Panics if range start > end".
+    #[hegel::test]
+    fn hegel_inclusive_backwards_range_ops_panic(tc: TestCase) {
+        let start = tc.draw(generators::integers::<u8>().min_value(1));
+        let end = tc.draw(generators::integers::<u8>().max_value(start - 1));
+
+        let insert_result = std::panic::catch_unwind(move || {
+            let mut map: RangeInclusiveMap<u8, u8> = RangeInclusiveMap::new();
+            map.insert(start..=end, 0);
+        });
+        assert!(
+            insert_result.is_err(),
+            "insert({}..={}) should panic for start > end",
+            start,
+            end
+        );
+
+        let remove_result = std::panic::catch_unwind(move || {
+            let mut map: RangeInclusiveMap<u8, u8> = RangeInclusiveMap::new();
+            map.insert(0..=255, 0);
+            map.remove(start..=end);
+        });
+        assert!(
+            remove_result.is_err(),
+            "remove({}..={}) should panic for start > end",
+            start,
+            end
+        );
+    }
+}
