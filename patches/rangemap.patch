+// Property-based tests written with hegel.
+//
+// These check the raw `union()`/`intersection()` iterator output (rather
+// than the result of collecting it into a new set, which the proptest
+// versions above use) against per-point membership over the FULL `u8`
+// domain. Note the existing proptests iterate `0..u8::MAX`, which skips 255
+// -- the maximum representable point is exactly what `RangeInclusive`
+// exists to cover, so these tests include it.
+#[cfg(test)]
+mod hegel_tests {
+    use super::*;
+    use alloc::format;
+    use alloc::string::ToString;
+    use alloc::vec::Vec;
+    use core::ops::RangeInclusive;
+    use hegel::generators;
+    use hegel::TestCase;
+
+    /// Build a `RangeInclusiveSet<u8>` from drawn ranges spanning the full
+    /// `u8` domain, including ranges touching 0 and 255.
+    fn draw_inclusive_set(tc: &TestCase) -> RangeInclusiveSet<u8> {
+        let mut set = RangeInclusiveSet::new();
+        let num_ranges = tc.draw(generators::integers::<usize>().max_value(8));
+        for _ in 0..num_ranges {
+            let start = tc.draw(generators::integers::<u8>());
+            let end = tc.draw(generators::integers::<u8>().min_value(start));
+            set.insert(start..=end);
+        }
+        set
+    }
+
+    // Property: a point is covered by the union iterator's output iff it is
+    // in either input set, for every point in the u8 domain including 255.
+    #[hegel::test]
+    fn hegel_union_matches_point_membership(tc: TestCase) {
+        let left = draw_inclusive_set(&tc);
+        let right = draw_inclusive_set(&tc);
+
+        let union: Vec<RangeInclusive<u8>> = left.union(&right).collect();
+        for p in 0..=255u8 {
+            assert_eq!(
+                union.iter().any(|range| range.contains(&p)),
+                left.contains(&p) || right.contains(&p),
+                "union membership diverged at point {}",
+                p
+            );
+        }
+    }
+
+    // Property: a point is covered by the intersection iterator's output
+    // iff it is in both input sets, for every point in the u8 domain
+    // including 255.
+    #[hegel::test]
+    fn hegel_intersection_matches_point_membership(tc: TestCase) {
+        let left = draw_inclusive_set(&tc);
+        let right = draw_inclusive_set(&tc);
+
+        let intersection: Vec<RangeInclusive<u8>> = left.intersection(&right).collect();
+        for p in 0..=255u8 {
+            assert_eq!(
+                intersection.iter().any(|range| range.contains(&p)),
+                left.contains(&p) && right.contains(&p),
+                "intersection membership diverged at point {}",
+                p
+            );
+        }
+    }
+}
