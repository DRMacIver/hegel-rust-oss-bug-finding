+//! Shared hegel generators for the property-based tests.
+//!
+//! Not every helper is used by every integration-test target, hence the
+//! `#[allow(dead_code)]` annotations.
+
+use hegel::generators;
+
+/// Draw a payload for compression round-trips.
+///
+/// Compression codecs treat different input shapes very differently, so a
+/// uniform random byte string (incompressible noise) exercises mostly the
+/// literal path. This assembles a payload from segments of distinct shapes:
+/// single-byte runs, repeated short patterns (match/distance encoding),
+/// ASCII text, and raw noise.
+#[allow(dead_code)]
+pub fn draw_payload(tc: &hegel::TestCase) -> Vec<u8> {
+    let n_segments = tc.draw(generators::integers::<usize>().max_value(6));
+    let mut data = Vec::new();
+    for _ in 0..n_segments {
+        let kind = tc.draw(generators::integers::<u8>().max_value(3));
+        match kind {
+            0 => {
+                // Run of a single byte.
+                let byte = tc.draw(generators::integers::<u8>());
+                let len = tc.draw(generators::integers::<usize>().max_value(4000));
+                data.extend(std::iter::repeat(byte).take(len));
+            }
+            1 => {
+                // Repeated short pattern.
+                let pattern = tc.draw(generators::binary().min_size(1).max_size(16));
+                let reps = tc.draw(generators::integers::<usize>().max_value(400));
+                for _ in 0..reps {
+                    data.extend_from_slice(&pattern);
+                }
+            }
+            2 => {
+                // ASCII-ish text.
+                let text = tc.draw(generators::from_regex(r"[ -~\t\n]{0,300}").fullmatch(true));
+                data.extend_from_slice(text.as_bytes());
+            }
+            _ => {
+                // Raw noise.
+                let noise = tc.draw(generators::binary().max_size(300));
+                data.extend_from_slice(&noise);
+            }
+        }
+    }
+    data
+}
+
+/// Corrupt a (non-empty) byte stream in place: flip one bit, truncate it, or
+/// overwrite one byte. Used to check that decoders reject damaged streams
+/// with an error instead of panicking.
+#[allow(dead_code)]
+pub fn corrupt(tc: &hegel::TestCase, data: &mut Vec<u8>) {
+    let kind = tc.draw(generators::integers::<u8>().max_value(2));
+    match kind {
+        0 => {
+            // Flip a single bit.
+            let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            let bit = tc.draw(generators::integers::<u8>().max_value(7));
+            data[idx] ^= 1 << bit;
+        }
+        1 => {
+            // Truncate.
+            let new_len = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            data.truncate(new_len);
+        }
+        _ => {
+            // Overwrite a byte with an arbitrary value.
+            let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            data[idx] = tc.draw(generators::integers::<u8>());
+        }
+    }
+}
diff --git a/tests/lzma.rs b/tests/lzma.rs
index 287f20a..246a3a7 100644
--- a/tests/lzma.rs
+++ b/tests/lzma.rs
@@ -354,3 +354,253 @@ fn memlimit() {
         );
