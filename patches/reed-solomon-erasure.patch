 }
+
+// ===================================================================
+// Hegel property-based tests
+//
+// These supplement the quickcheck properties above. Differences from
+// the quickcheck suite:
+//   - the erased-shard subset is drawn through hegel (the quickcheck
+//     tests pick corruption positions with `rand::random`, which is
+//     not shrinkable),
+//   - erasure counts beyond the parity count are exercised (the
+//     quickcheck tests cap `corrupt` at `parity`),
+//   - `reconstruct_data`, single-byte corruption detection, and the
+//     k = 1 / m = 1 edge cases are covered.
+// ===================================================================
+
+/// Draws a `count`-element subset of `0..n` as erasure positions,
+/// via a Fisher-Yates shuffle so every decision is shrinkable and no
+/// rejection sampling is needed.
+fn draw_erased_indices(tc: &hegel::TestCase, n: usize, count: usize) -> Vec<usize> {
+    use hegel::generators;
+
+    let mut idx: Vec<usize> = (0..n).collect();
+    for i in (1..n).rev() {
+        let j = tc.draw(generators::integers::<usize>().max_value(i));
+        idx.swap(i, j);
+    }
+    idx.truncate(count);
+    idx
+}
+
+/// Draws `k` data shards of `shard_len` bytes each (full 0..=255 byte
+/// range) followed by `m` zeroed parity shards, ready for `encode`.
+fn draw_shards(tc: &hegel::TestCase, k: usize, m: usize, shard_len: usize) -> Vec<Vec<u8>> {
+    use hegel::generators;
+
+    let flat: Vec<u8> = tc.draw(
+        generators::binary()
+            .min_size(k * shard_len)
+            .max_size(k * shard_len),
+    );
+    let mut shards: Vec<Vec<u8>> = flat.chunks(shard_len).map(|c| c.to_vec()).collect();
+    for _ in 0..m {
+        shards.push(vec![0u8; shard_len]);
+    }
+    shards
+}
+
+/// Crown property: encode k data shards into k+m total, erase any
+/// subset of up to m shards (data and/or parity), then `reconstruct`
+/// must recover every shard exactly and the result must verify.
+#[hegel::test]
+fn hegel_encode_erase_reconstruct_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let n = k + m;
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    let mut shards = draw_shards(&tc, k, m, shard_len);
+    let r = ReedSolomon::new(k, m).unwrap();
+    r.encode(&mut shards).unwrap();
+    let expect = shards.clone();
+
+    // Erase any subset of size <= m.
+    let erase_count = tc.draw(generators::integers::<usize>().max_value(m));
+    let erased = draw_erased_indices(&tc, n, erase_count);
+
+    let mut option_shards = shards_into_option_shards(shards);
+    for &i in erased.iter() {
+        option_shards[i] = None;
+    }
+
+    r.reconstruct(&mut option_shards).unwrap();
+
+    let recovered = option_shards_into_shards(option_shards);
+    assert_eq!(expect, recovered);
+    assert!(r.verify(&recovered).unwrap());
+}
+
+/// When more than m shards are erased, `reconstruct` must fail with
+/// `Error::TooFewShardsPresent` — and per its docs ("if the method
+/// returns an `Error`, then nothing is touched") it must leave every
+/// shard exactly as it found it.
+#[hegel::test]
+fn hegel_reconstruct_too_many_erasures_fails_cleanly(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let n = k + m;
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    let mut shards = draw_shards(&tc, k, m, shard_len);
+    let r = ReedSolomon::new(k, m).unwrap();
+    r.encode(&mut shards).unwrap();
+
+    // Erase strictly more than m shards.
+    let erase_count = tc.draw(
+        generators::integers::<usize>()
+            .min_value(m + 1)
+            .max_value(n),
+    );
+    let erased = draw_erased_indices(&tc, n, erase_count);
+
+    let mut option_shards = shards_into_option_shards(shards);
+    for &i in erased.iter() {
+        option_shards[i] = None;
+    }
+    let before = option_shards.clone();
+
+    let result = r.reconstruct(&mut option_shards);
+    assert_eq!(Err(Error::TooFewShardsPresent), result);
+    // Nothing is touched: present shards unchanged, erased still None.
+    assert_eq!(before, option_shards);
+}
+
+/// `reconstruct_data` must recover the data shards exactly while
+/// leaving erased parity shards missing (it only reconstructs data).
+#[hegel::test]
+fn hegel_reconstruct_data_recovers_only_data_shards(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let n = k + m;
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    let mut shards = draw_shards(&tc, k, m, shard_len);
+    let r = ReedSolomon::new(k, m).unwrap();
+    r.encode(&mut shards).unwrap();
+    let expect = shards.clone();
+
+    let erase_count = tc.draw(generators::integers::<usize>().max_value(m));
+    let erased = draw_erased_indices(&tc, n, erase_count);
+
+    let mut option_shards = shards_into_option_shards(shards);
+    for &i in erased.iter() {
+        option_shards[i] = None;
+    }
+
+    r.reconstruct_data(&mut option_shards).unwrap();
+
+    for i in 0..n {
+        if i < k {
+            // Every data shard must be recovered exactly.
+            assert_eq!(Some(&expect[i]), option_shards[i].as_ref());
+        } else if erased.contains(&i) {
+            // Erased parity shards must stay missing.
+            assert_eq!(None, option_shards[i]);
+        } else {
+            // Present parity shards must be untouched.
+            assert_eq!(Some(&expect[i]), option_shards[i].as_ref());
+        }
+    }
+}
+
+/// `verify` returns true for a correctly encoded set, and false after
+/// any single byte of any shard (data or parity) is changed. The
+/// encode matrix is MDS (every parity coefficient is non-zero), so a
+/// single-byte change must always be detected.
+#[hegel::test]
+fn hegel_verify_detects_single_byte_corruption(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let n = k + m;
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    let mut shards = draw_shards(&tc, k, m, shard_len);
+    let r = ReedSolomon::new(k, m).unwrap();
+    r.encode(&mut shards).unwrap();
+
+    assert!(r.verify(&shards).unwrap());
+
+    // Corrupt one drawn byte of one drawn shard by a non-zero delta,
+    // guaranteeing the shard set is genuinely different.
+    let shard_idx = tc.draw(generators::integers::<usize>().max_value(n - 1));
+    let byte_idx = tc.draw(generators::integers::<usize>().max_value(shard_len - 1));
+    let delta = tc.draw(generators::integers::<u8>().min_value(1));
+    shards[shard_idx][byte_idx] ^= delta;
+
+    assert!(!r.verify(&shards).unwrap());
+}
+
+/// Encoding is a pure function of (k, m, data): two independently
+/// constructed codecs must produce identical parity, regardless of
+/// what the parity buffers contained beforehand (the docs promise the
+/// parity slots are completely overwritten).
+#[hegel::test]
+fn hegel_encode_deterministic_regardless_of_parity_prefill(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    // First copy: zeroed parity buffers.
+    let mut shards_a = draw_shards(&tc, k, m, shard_len);
+    // Second copy: same data, garbage in the parity buffers.
+    let mut shards_b = shards_a.clone();
+    let garbage: Vec<u8> = tc.draw(
+        generators::binary()
+            .min_size(m * shard_len)
+            .max_size(m * shard_len),
+    );
+    for (i, chunk) in garbage.chunks(shard_len).enumerate() {
+        shards_b[k + i].copy_from_slice(chunk);
+    }
+
+    let r_a = ReedSolomon::new(k, m).unwrap();
+    let r_b = ReedSolomon::new(k, m).unwrap();
+    r_a.encode(&mut shards_a).unwrap();
+    r_b.encode(&mut shards_b).unwrap();
+
+    assert_eq!(shards_a, shards_b);
+
+    // Re-encoding with the same codec is idempotent.
+    let mut shards_c = shards_a.clone();
+    r_a.encode(&mut shards_c).unwrap();
+    assert_eq!(shards_a, shards_c);
+}
+
+/// Shard-size independence: encoding operates on each byte position
+/// independently, so parity byte j of the full-length encoding must
+/// equal the parity produced by encoding just column j as 1-byte
+/// shards.
+#[hegel::test]
+fn hegel_encode_is_columnwise(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+
+    let mut shards = draw_shards(&tc, k, m, shard_len);
+    let r = ReedSolomon::new(k, m).unwrap();
+    let data_only = shards[..k].to_vec();
+    r.encode(&mut shards).unwrap();
+
+    let col = tc.draw(generators::integers::<usize>().max_value(shard_len - 1));
+
+    // Encode just that column as 1-byte shards.
+    let mut column_shards: Vec<Vec<u8>> = data_only.iter().map(|s| vec![s[col]]).collect();
+    for _ in 0..m {
+        column_shards.push(vec![0u8]);
+    }
+    r.encode(&mut column_shards).unwrap();
+
+    for i in 0..m {
+        assert_eq!(shards[k + i][col], column_shards[k + i][0]);
+    }
+}
+
+/// k = 1 edge case: with a single data shard the systematic
+/// Vandermonde construction makes every encode-matrix row equal to
+/// [1] (`vandermonde` entry [r][0] = nth(r)^0 = 1, and the top 1x1
+/// submatrix is [1]), so every parity shard is an exact copy of the
+/// data shard.
+#[hegel::test]
+fn hegel_single_data_shard_parity_equals_data(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let m = tc.draw(generators::integers::<usize>().min_value(1).max_value(255));
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(32));
+
+    let mut shards = draw_shards(&tc, 1, m, shard_len);
+    let r = ReedSolomon::new(1, m).unwrap();
+    r.encode(&mut shards).unwrap();
+
+    for i in 0..m {
+        assert_eq!(shards[0], shards[1 + i]);
+    }
+}
+
+/// m = 1 edge case: a single parity shard must be able to recover any
+/// one erased shard, for any data shard count up to the field limit.
+#[hegel::test]
+fn hegel_single_parity_recovers_any_single_erasure(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(255));
+    let n = k + 1;
+    let shard_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(16));
+
+    let mut shards = draw_shards(&tc, k, 1, shard_len);
+    let r = ReedSolomon::new(k, 1).unwrap();
+    r.encode(&mut shards).unwrap();
+    let expect = shards.clone();
+
+    let erased = tc.draw(generators::integers::<usize>().max_value(n - 1));
+
+    let mut option_shards = shards_into_option_shards(shards);
+    option_shards[erased] = None;
+
+    r.reconstruct(&mut option_shards).unwrap();
+
+    assert_eq!(expect, option_shards_into_shards(option_shards));
+}
