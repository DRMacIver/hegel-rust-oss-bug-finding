+        TextAlign::LegacyCenter,
+    ]));
+    style.float = tc.draw(generators::sampled_from(vec![Float::None, Float::Left, Float::Right]));
+    style.clear = tc.draw(generators::sampled_from(vec![Clear::None, Clear::Left, Clear::Right, Clear::Both]));
+    style.flex_direction = tc.draw(generators::sampled_from(vec![
+        FlexDirection::Row,
