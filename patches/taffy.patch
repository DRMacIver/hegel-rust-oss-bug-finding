+/// Generator for arbitrary (but valid) `Style` configurations.
+///
+/// Encodes documented validity rules as construction logic: padding/border/gap are
+/// non-negative, flex_grow/flex_shrink are non-negative, aspect_ratio is positive.
+#[hegel::composite]
+pub(crate) fn styles(tc: hegel::TestCase) -> Style {
+    let mut style = Style::default();
