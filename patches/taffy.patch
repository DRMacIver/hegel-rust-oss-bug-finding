index ab9beb03..cbdb7a14 100644
--- a/src/tree/taffy_tree.rs
+++ b/src/tree/taffy_tree.rs
@@ -1402,4 +1402,201 @@ mod tests {
 
         assert!(taffy.children(old_parent).unwrap().is_empty());
