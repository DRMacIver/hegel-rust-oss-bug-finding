+
+/// Generator for `Dimension` values (auto, lengths, percentages)
+// NOTE: `Dimension`/`LengthPercentage`/`LengthPercentageAuto` contain a tagged pointer and are
+// not `Send + Sync`, so `generators::just(...)`/`sampled_from(...)` cannot be used with them.
+// These composites draw a discriminant and construct the value imperatively instead.
+
+#[hegel::composite]
+pub(crate) fn dimensions(tc: hegel::TestCase) -> Dimension {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => Dimension::AUTO,
+        1 => Dimension::from_length(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1000.0))),
+        _ => Dimension::from_percent(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0))),
+    }
+}
+
+/// Generator for `LengthPercentage` values (padding/border/gap - non-negative per CSS)
+#[hegel::composite]
+pub(crate) fn length_percentages(tc: hegel::TestCase) -> LengthPercentage {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => LengthPercentage::ZERO,
+        1 => LengthPercentage::from_length(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(100.0))),
+        _ => LengthPercentage::from_percent(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1.0))),
+    }
+}
+
+/// Generator for `LengthPercentageAuto` values (margins/insets - may be negative)
+#[hegel::composite]
+pub(crate) fn length_percentage_autos(tc: hegel::TestCase) -> LengthPercentageAuto {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => LengthPercentageAuto::AUTO,
+        1 => LengthPercentageAuto::from_length(
+            tc.draw(generators::floats::<f32>().min_value(-100.0).max_value(100.0)),
+        ),
+        _ => LengthPercentageAuto::from_percent(tc.draw(generators::floats::<f32>().min_value(-1.0).max_value(1.0))),
+    }
+}
+
+/// Generator for grid placements (auto / line / span)
+#[hegel::composite]
+pub(crate) fn grid_placements(tc: hegel::TestCase) -> GridPlacement {
+    tc.draw(hegel::one_of!(
+        generators::just(GridPlacement::Auto),
+        generators::sampled_from(vec![-4i16, -3, -2, -1, 1, 2, 3, 4]).map(|n| line(n)),
+        generators::integers::<u16>().min_value(1).max_value(4).map(|n| span(n)),
