+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod min_max_properties {
+    use hegel::generators;
+    use taffy::prelude::*;
+    use taffy_test_helpers::new_test_tree;
+
+    /// Property: for a leaf with definite `size`, `min_size` and `max_size`, the computed
+    /// size is the styled size clamped by max then min - i.e. `max(min(size, max), min)`,
+    /// with min taking precedence over max (evidence: the `min_overrides_max`,
+    /// `max_overrides_size` and `min_overrides_size` unit tests above).
+    #[hegel::test]
+    fn hegel_leaf_size_is_clamped_by_min_and_max(tc: hegel::TestCase) {
+        let dim = || generators::floats::<f32>().min_value(0.0).max_value(1000.0);
+
+        let size = Size { width: tc.draw(dim()), height: tc.draw(dim()) };
+        let min = Size { width: tc.draw(dim()), height: tc.draw(dim()) };
+        let max = Size { width: tc.draw(dim()), height: tc.draw(dim()) };
+
+        let mut taffy = new_test_tree();
+        // Disable rounding so the clamping arithmetic can be checked exactly
+        taffy.disable_rounding();
+
+        let node = taffy
+            .new_leaf(Style {
+                size: Size {
+                    width: Dimension::from_length(size.width),
+                    height: Dimension::from_length(size.height),
+                },
+                min_size: Size {
+                    width: Dimension::from_length(min.width),
+                    height: Dimension::from_length(min.height),
+                },
+                max_size: Size {
+                    width: Dimension::from_length(max.width),
+                    height: Dimension::from_length(max.height),
+                },
+                ..Default::default()
+            })
+            .unwrap();
+
+        let avail = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1000.0));
+        taffy
+            .compute_layout(node, Size { width: AvailableSpace::Definite(avail), height: AvailableSpace::Definite(avail) })
+            .unwrap();
+
+        let expected =
+            Size { width: size.width.min(max.width).max(min.width), height: size.height.min(max.height).max(min.height) };
+        assert_eq!(taffy.layout(node).unwrap().size, expected);
+    }
+}
