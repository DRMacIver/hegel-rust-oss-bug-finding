+        y: tc.draw(generators::sampled_from(vec![Overflow::Visible, Overflow::Clip, Overflow::Hidden, Overflow::Scroll])),
+    };
+    style.scrollbar_width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(20.0));
+    style.size = Size { width: tc.draw(dimensions()), height: tc.draw(dimensions()) };
+    style.min_size = Size { width: tc.draw(dimensions()), height: tc.draw(dimensions()) };
+    style.max_size = Size { width: tc.draw(dimensions()), height: tc.draw(dimensions()) };
+    style.aspect_ratio = tc.draw(generators::optional(generators::floats::<f32>().min_value(0.01).max_value(100.0)));
+    style.inset = Rect {
