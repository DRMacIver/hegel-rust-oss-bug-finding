+    };
+    style.padding = Rect {
+        left: tc.draw(length_percentages()),
+        right: tc.draw(length_percentages()),
+        top: tc.draw(length_percentages()),
+        bottom: tc.draw(length_percentages()),
+    };
+    style.border = Rect {
+        left: tc.draw(length_percentages()),
+        right: tc.draw(length_percentages()),
+        top: tc.draw(length_percentages()),
