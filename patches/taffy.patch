+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+use super::relayout::{available_spaces, build_tree, tree_specs};
+use hegel::generators;
+
+/// Property: with rounding enabled (the default), every rounded layout value
+/// (location, size, content_size, scrollbar_size, border, padding) is a whole number
+/// (evidence: `round_layout` docs - "Rounds the calculated layout to exact pixel values").
+/// Note that `Layout::margin` is deliberately not asserted on: `round_layout` does not
+/// round margins.
+#[hegel::test]
+fn hegel_rounded_layout_values_are_whole_numbers(tc: hegel::TestCase) {
+    let spec = tc.draw(tree_specs(3));
+    let available_space = Size { width: tc.draw(available_spaces()), height: tc.draw(available_spaces()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+    taffy.compute_layout(root, available_space).unwrap();
+
+    for node in &nodes {
+        let layout = taffy.layout(*node).unwrap();
+        let rounded_fields = [
+            ("location.x", layout.location.x),
+            ("location.y", layout.location.y),
+            ("size.width", layout.size.width),
+            ("size.height", layout.size.height),
+            ("content_size.width", layout.content_size.width),
+            ("content_size.height", layout.content_size.height),
+            ("scrollbar_size.width", layout.scrollbar_size.width),
+            ("scrollbar_size.height", layout.scrollbar_size.height),
+            ("border.left", layout.border.left),
+            ("border.right", layout.border.right),
+            ("border.top", layout.border.top),
+            ("border.bottom", layout.border.bottom),
+            ("padding.left", layout.padding.left),
+            ("padding.right", layout.padding.right),
+            ("padding.top", layout.padding.top),
+            ("padding.bottom", layout.padding.bottom),
+        ];
+        for (name, value) in rounded_fields {
+            assert!(
+                value.fract() == 0.0,
+                "rounded layout field {name} = {value} is not a whole number in {layout:?}"
+            );
+        }
+    }
+}
+
+/// Property: rounding does not open gaps (or create overlap) between adjacent children
+/// of a flex row - each child's right edge is exactly the next child's left edge, even
+/// for fractional sizes (evidence: the `rounding_doesnt_leave_gaps` test above and the
+/// `round_layout` doc comment).
+#[hegel::test]
+fn hegel_rounding_leaves_no_gaps_between_adjacent_children(tc: hegel::TestCase) {
+    let mut taffy = new_test_tree();
+
+    // A row of children with (fractional) fixed sizes
+    let child_count = tc.draw(generators::integers::<usize>().min_value(2).max_value(6));
+    let mut children = Vec::new();
+    for _ in 0..child_count {
+        let width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(300.0));
+        let height = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(300.0));
+        let grow = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0));
+        let shrink = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0));
+        let child = taffy
+            .new_leaf(Style {
+                size: Size { width: length(width), height: length(height) },
+                flex_grow: grow,
+                flex_shrink: shrink,
+                ..Default::default()
+            })
+            .unwrap();
+        children.push(child);
+    }
+
+    // Justifications that keep the children contiguous (Space* distribute extra space
+    // *between* children, so gaps are expected for those)
+    let justify_content = tc.draw(generators::optional(generators::sampled_from(vec![
+        JustifyContent::START,
+        JustifyContent::END,
+        JustifyContent::FLEX_START,
+        JustifyContent::FLEX_END,
+        JustifyContent::CENTER,
+    ])));
+    let root_width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1500.0));
+    let root_height = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(500.0));
+    let padding = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(50.0));
+    let root = taffy
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                flex_direction: FlexDirection::Row,
+                flex_wrap: FlexWrap::NoWrap,
+                justify_content,
+                size: Size { width: length(root_width), height: length(root_height) },
+                padding: Rect {
+                    left: LengthPercentage::from_length(padding),
+                    right: LengthPercentage::from_length(padding),
+                    top: LengthPercentage::from_length(padding),
+                    bottom: LengthPercentage::from_length(padding),
+                },
+                ..Default::default()
+            },
+            &children,
+        )
+        .unwrap();
+
+    taffy.compute_layout(root, Size::MAX_CONTENT).unwrap();
+
+    for pair in children.windows(2) {
+        let a = taffy.layout(pair[0]).unwrap();
+        let b = taffy.layout(pair[1]).unwrap();
+        assert_eq!(
+            a.location.x + a.size.width,
+            b.location.x,
+            "gap or overlap after rounding: {a:?} then {b:?}"
+        );
+    }
+}
