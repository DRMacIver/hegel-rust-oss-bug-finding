+    style.align_items = tc.draw(generators::optional(generators::sampled_from(align_items_values())));
+    style.align_self = tc.draw(generators::optional(generators::sampled_from(align_items_values())));
+    style.justify_items = tc.draw(generators::optional(generators::sampled_from(align_items_values())));
