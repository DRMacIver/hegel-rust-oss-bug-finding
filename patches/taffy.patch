+
+    // -----------------------------------------------------------------------
+    // Hegel property-based tests
+    // -----------------------------------------------------------------------
+
+    use hegel::generators;
+    use std::collections::HashMap;
+
+    /// Stateful model test: run tree-mutation operations against both `TaffyTree` and a
+    /// simple parent/children reference model, and assert the structural queries
+    /// (`children`, `parent`, `child_at_index`, `total_node_count`) always agree
+    /// (evidence: the documented semantics of each mutation method and the unit tests above).
+    #[derive(Debug)]
+    struct TreeModelMachine {
+        taffy: TaffyTree<()>,
+        /// Model: children list per live node
+        children: HashMap<NodeId, sys::Vec<NodeId>>,
+        /// Model: parent per live node
+        parents: HashMap<NodeId, Option<NodeId>>,
+        /// Live nodes in a stable order (for sampling)
+        order: sys::Vec<NodeId>,
+    }
+
+    impl TreeModelMachine {
+        fn new() -> Self {
+            Self { taffy: TaffyTree::new(), children: HashMap::new(), parents: HashMap::new(), order: Vec::new() }
+        }
+
+        /// Whether `needle` is in the subtree rooted at `haystack` (per the model)
+        fn in_subtree(&self, needle: NodeId, haystack: NodeId) -> bool {
+            needle == haystack || self.children[&haystack].iter().any(|c| self.in_subtree(needle, *c))
+        }
+
+        /// Draw an arbitrary live node, skipping the test case if there are none
+        fn draw_node(&self, tc: &hegel::TestCase) -> NodeId {
+            tc.assume(!self.order.is_empty());
+            let idx = tc.draw(generators::integers::<usize>().max_value(self.order.len() - 1));
+            self.order[idx]
+        }
+
+        /// Draw a node from `candidates`, skipping the test case if there are none
+        fn draw_from(&self, tc: &hegel::TestCase, candidates: Vec<NodeId>) -> NodeId {
+            tc.assume(!candidates.is_empty());
+            let idx = tc.draw(generators::integers::<usize>().max_value(candidates.len() - 1));
+            candidates[idx]
+        }
+
+        /// Nodes that may become a child of `parent` without creating a cycle or a
+        /// second parent: unattached roots whose subtree does not contain `parent`.
+        fn attachable_under(&self, parent: NodeId) -> Vec<NodeId> {
+            self.order
+                .iter()
+                .copied()
+                .filter(|n| self.parents[n].is_none() && !self.in_subtree(parent, *n))
+                .collect()
+        }
+    }
+
+    #[hegel::state_machine]
+    impl TreeModelMachine {
+        #[rule]
+        fn new_leaf(&mut self, _tc: hegel::TestCase) {
+            let node = self.taffy.new_leaf(Style::default()).unwrap();
+            self.children.insert(node, Vec::new());
+            self.parents.insert(node, None);
+            self.order.push(node);
+        }
+
+        #[rule]
+        fn add_child(&mut self, tc: hegel::TestCase) {
+            let parent = self.draw_node(&tc);
+            let child = self.draw_from(&tc, self.attachable_under(parent));
+            self.taffy.add_child(parent, child).unwrap();
+            self.children.get_mut(&parent).unwrap().push(child);
+            *self.parents.get_mut(&child).unwrap() = Some(parent);
+        }
+
+        #[rule]
+        fn insert_child_at_index(&mut self, tc: hegel::TestCase) {
+            let parent = self.draw_node(&tc);
+            let child = self.draw_from(&tc, self.attachable_under(parent));
+            let index = tc.draw(generators::integers::<usize>().max_value(self.children[&parent].len()));
+            self.taffy.insert_child_at_index(parent, index, child).unwrap();
+            self.children.get_mut(&parent).unwrap().insert(index, child);
+            *self.parents.get_mut(&child).unwrap() = Some(parent);
+        }
+
+        #[rule]
+        fn remove_child_at_index(&mut self, tc: hegel::TestCase) {
+            let candidates: Vec<NodeId> =
+                self.order.iter().copied().filter(|n| !self.children[n].is_empty()).collect();
+            let parent = self.draw_from(&tc, candidates);
+            let index = tc.draw(generators::integers::<usize>().max_value(self.children[&parent].len() - 1));
+            let removed = self.taffy.remove_child_at_index(parent, index).unwrap();
+            let model_removed = self.children.get_mut(&parent).unwrap().remove(index);
+            assert_eq!(removed, model_removed);
+            *self.parents.get_mut(&model_removed).unwrap() = None;
+        }
+
+        #[rule]
+        fn replace_child_at_index(&mut self, tc: hegel::TestCase) {
+            let candidates: Vec<NodeId> =
+                self.order.iter().copied().filter(|n| !self.children[n].is_empty()).collect();
+            let parent = self.draw_from(&tc, candidates);
+            let new_child = self.draw_from(&tc, self.attachable_under(parent));
+            let index = tc.draw(generators::integers::<usize>().max_value(self.children[&parent].len() - 1));
+            let old = self.taffy.replace_child_at_index(parent, index, new_child).unwrap();
+            let model_old = core::mem::replace(&mut self.children.get_mut(&parent).unwrap()[index], new_child);
+            assert_eq!(old, model_old);
+            *self.parents.get_mut(&model_old).unwrap() = None;
+            *self.parents.get_mut(&new_child).unwrap() = Some(parent);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let node = self.draw_node(&tc);
+            let removed = self.taffy.remove(node).unwrap();
+            assert_eq!(removed, node);
+            // Model: detach from parent, orphan the children, drop the node
+            if let Some(Some(parent)) = self.parents.get(&node).copied() {
+                self.children.get_mut(&parent).unwrap().retain(|c| *c != node);
+            }
+            for child in self.children[&node].clone() {
+                *self.parents.get_mut(&child).unwrap() = None;
+            }
+            self.children.remove(&node);
+            self.parents.remove(&node);
+            self.order.retain(|n| *n != node);
+        }
+
+        #[rule]
+        fn set_children(&mut self, tc: hegel::TestCase) {
+            let parent = self.draw_node(&tc);
+            // Any node that isn't `parent` itself or one of its (model) ancestors may be
+            // re-parented under `parent`; `set_children` documents that it detaches nodes
+            // from their previous parent.
+            let candidates: Vec<NodeId> = self
+                .order
+                .iter()
+                .copied()
+                .filter(|n| *n != parent && !self.in_subtree(parent, *n))
+                .collect();
+            let count = tc.draw(generators::integers::<usize>().max_value(candidates.len().min(3)));
+            let mut new_children: Vec<NodeId> = Vec::new();
+            let mut remaining = candidates;
+            for _ in 0..count {
+                let idx = tc.draw(generators::integers::<usize>().max_value(remaining.len() - 1));
+                new_children.push(remaining.remove(idx));
+            }
+
+            self.taffy.set_children(parent, &new_children).unwrap();
+
+            // Model update: detach old children, detach new children from previous
+            // parents, then attach.
+            for child in self.children[&parent].clone() {
+                *self.parents.get_mut(&child).unwrap() = None;
+            }
+            for child in &new_children {
+                if let Some(Some(prev)) = self.parents.get(child).copied() {
+                    self.children.get_mut(&prev).unwrap().retain(|c| c != child);
+                }
+                *self.parents.get_mut(child).unwrap() = Some(parent);
+            }
+            *self.children.get_mut(&parent).unwrap() = new_children;
+        }
+
+        #[rule]
+        fn check_child_at_index(&mut self, tc: hegel::TestCase) {
+            let candidates: Vec<NodeId> =
+                self.order.iter().copied().filter(|n| !self.children[n].is_empty()).collect();
+            let parent = self.draw_from(&tc, candidates);
+            let index = tc.draw(generators::integers::<usize>().max_value(self.children[&parent].len() - 1));
+            assert_eq!(self.taffy.child_at_index(parent, index).unwrap(), self.children[&parent][index]);
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: hegel::TestCase) {
+            assert_eq!(self.taffy.total_node_count(), self.order.len());
+            for node in &self.order {
+                assert_eq!(
+                    self.taffy.children(*node).unwrap(),
+                    self.children[node],
+                    "children of {node:?} disagree with model"
+                );
+                assert_eq!(
+                    self.taffy.parent(*node),
+                    self.parents[node],
+                    "parent of {node:?} disagrees with model"
+                );
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_tree_mutations_match_model(tc: hegel::TestCase) {
+        hegel::stateful::run(TreeModelMachine::new(), tc);
+    }
 }
