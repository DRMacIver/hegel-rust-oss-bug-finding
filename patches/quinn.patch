@@ -193,6 +193,183 @@ macro_rules! common_set_tests {
 common_set_tests!(range_set, RangeSet);
 common_set_tests!(array_range_set, ArrayRangeSet);
 
+/// Stateful model test: drive `RangeSet` and `ArrayRangeSet` through the same
+/// random operation sequences as a `BTreeSet<u64>` element-wise model (in the
+/// spirit of `RefRangeSet` below and the `compare_*_to_reference` tests above)
+/// and require all three to agree after every step.
+mod model {
+    use std::collections::BTreeSet;
+
+    use hegel::TestCase;
+    use hegel::generators;
+
+    use super::*;
+
+    /// Values are kept small so the element-wise model stays cheap. This bound
+    /// protects the *test's* memory, not the libraries' contract; the wire-level
+    /// u64 extremes are covered by the varint/frame tests.
+    const MAX_VALUE: u64 = 1_000;
+
+    struct SetModel {
+        btree: RangeSet,
+        array: ArrayRangeSet,
+        model: BTreeSet<u64>,
+    }
+
+    impl SetModel {
+        fn draw_range(tc: &TestCase) -> Range<u64> {
+            let start = tc.draw(generators::integers::<u64>().max_value(MAX_VALUE));
+            // Allow empty ranges: `insert`/`remove` document them as no-ops
+            let len = tc.draw(generators::integers::<u64>().max_value(MAX_VALUE - start));
+            start..start + len
+        }
+
+        fn model_insert(&mut self, range: Range<u64>) -> bool {
+            let mut changed = false;
+            for x in range {
+                changed |= self.model.insert(x);
+            }
+            changed
+        }
+
+        fn model_remove(&mut self, range: Range<u64>) -> bool {
+            let mut changed = false;
+            for x in range {
+                changed |= self.model.remove(&x);
+            }
+            changed
+        }
+    }
+
+    #[hegel::state_machine]
+    impl SetModel {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let range = Self::draw_range(&tc);
+            let expected = self.model_insert(range.clone());
+            assert_eq!(self.btree.insert(range.clone()), expected);
+            assert_eq!(self.array.insert(range), expected);
+        }
+
+        #[rule]
+        fn insert_one(&mut self, tc: TestCase) {
+            let x = tc.draw(generators::integers::<u64>().max_value(MAX_VALUE));
+            let expected = self.model.insert(x);
+            assert_eq!(self.btree.insert_one(x), expected);
+            assert_eq!(self.array.insert_one(x), expected);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let range = Self::draw_range(&tc);
+            let expected = self.model_remove(range.clone());
+            assert_eq!(self.btree.remove(range.clone()), expected);
+            assert_eq!(self.array.remove(range), expected);
+        }
+
+        #[rule]
+        fn replace(&mut self, tc: TestCase) {
+            // `replace` is only implemented for the BTree-based set. Its doc
+            // contract: return the intersection of current ranges with the new
+            // one, leaving the set containing the union.
+            //
+            // NOTE: empty ranges are deliberately excluded here. Unlike `insert`
+            // and `remove`, `replace` does NOT no-op on an empty range; it stores
+            // a degenerate `x..x` entry and corrupts the set. That is a real bug,
+            // covered by the dedicated failing test
+            // `replace_empty_range_corrupts_set` below; excluding it here lets
+            // this model exercise the rest of the API in depth.
+            let start = tc.draw(generators::integers::<u64>().max_value(MAX_VALUE - 1));
+            let len = tc.draw(
+                generators::integers::<u64>()
+                    .min_value(1)
+                    .max_value(MAX_VALUE - start),
+            );
+            let range = start..start + len;
+            // Expected intersection, as maximal runs (compare structurally rather
+            // than element-wise so a buggy huge range fails cleanly instead of
+            // OOMing the test)
+            let mut expected: Vec<Range<u64>> = Vec::new();
+            for x in range.clone() {
+                if self.model.contains(&x) {
+                    match expected.last_mut() {
+                        Some(r) if r.end == x => r.end = x + 1,
+                        _ => expected.push(x..x + 1),
+                    }
+                }
+            }
+            let replaced: Vec<Range<u64>> = self.btree.replace(range.clone()).collect();
+            assert_eq!(replaced, expected, "replace() must return the intersection");
+            self.model_insert(range.clone());
+            self.array.insert(range);
+        }
+
+        #[rule]
+        fn pop_min(&mut self, _: TestCase) {
+            let expected = self.model.iter().next().copied().map(|start| {
+                let end = (start..).take_while(|x| self.model.contains(x)).last().unwrap() + 1;
+                start..end
+            });
+            if let Some(r) = &expected {
+                for x in r.clone() {
+                    self.model.remove(&x);
+                }
+            }
+            assert_eq!(self.btree.pop_min(), expected);
+            assert_eq!(self.array.pop_min(), expected);
+        }
+
+        #[rule]
+        fn contains(&mut self, tc: TestCase) {
+            let x = tc.draw(generators::integers::<u64>().max_value(MAX_VALUE));
+            let expected = self.model.contains(&x);
+            assert_eq!(self.btree.contains(x), expected);
+            assert_eq!(self.array.contains(x), expected);
+        }
+
+        #[invariant]
+        fn all_three_agree(&self, _: TestCase) {
+            // Cheap well-formedness check first: if a set ever contains a
+            // malformed or out-of-domain range, fail here rather than OOM
+            // materializing its elements below
