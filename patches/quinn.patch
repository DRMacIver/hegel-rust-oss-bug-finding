+
+    /// Stateful test of the CID retirement protocol. Properties, grounded in the
+    /// doc comments on `insert`/`next` and in RFC 9000 §5.1.2 (an endpoint must
+    /// retire each issued CID exactly once):
+    /// - retirement ranges returned by `insert` and `next` are non-empty,
+    /// - no sequence number is ever retired twice,
+    /// - the active sequence number never decreases and is never one that was
+    ///   already retired,
+    /// - there is always an active CID (`active()` must not panic).
+    mod retirement {
+        use std::collections::BTreeSet;
+
+        use hegel::TestCase;
+        use hegel::generators;
+
+        use super::*;
+
+        struct QueueModel {
+            queue: CidQueue,
+            retired: BTreeSet<u64>,
+            last_active_seq: u64,
+        }
+
+        impl QueueModel {
+            fn note_retired(&mut self, range: Range<u64>) {
+                assert!(!range.is_empty(), "retirement ranges must be non-empty");
+                for seq in range {
+                    assert!(
+                        self.retired.insert(seq),
+                        "sequence {seq} was retired twice"
+                    );
+                }
+            }
+        }
+
+        #[hegel::state_machine]
+        impl QueueModel {
+            #[rule]
+            fn insert(&mut self, tc: TestCase) {
+                // Frame decoding guarantees retire_prior_to <= sequence and both
+                // are varints; beyond that any value may arrive off the wire.
+                // Bias towards the current window, where the interesting
+                // interactions live.
+                let offset = self.queue.active_seq();
+                let sequence = tc.draw(hegel::one_of!(
+                    generators::integers::<u64>()
+                        .min_value(offset.saturating_sub(2))
+                        .max_value(offset.saturating_add(2 * CidQueue::LEN as u64)),
+                    generators::integers::<u64>().max_value((1 << 62) - 1),
+                ));
+                let retire_prior_to = tc.draw(hegel::one_of!(
+                    generators::integers::<u64>()
+                        .min_value(offset.saturating_sub(2).min(sequence))
+                        .max_value(offset.saturating_add(2 * CidQueue::LEN as u64).min(sequence)),
+                    generators::integers::<u64>().max_value(sequence),
+                ));
+                let frame = NewConnectionId {
+                    sequence,
+                    id: ConnectionId::new(&sequence.to_be_bytes()),
+                    reset_token: ResetToken::from([0xCD; crate::RESET_TOKEN_SIZE]),
+                    retire_prior_to,
+                };
+                match self.queue.insert(frame) {
+                    Ok(Some((retired, _token))) => self.note_retired(retired),
+                    Ok(None) => {}
+                    Err(InsertError::Retired | InsertError::ExceedsLimit) => {}
+                }
+            }
+
+            #[rule]
+            fn next(&mut self, _: TestCase) {
+                if let Some((_token, retired)) = self.queue.next() {
+                    self.note_retired(retired.clone());
+                    assert_eq!(
+                        retired.end,
+                        self.queue.active_seq(),
+                        "everything before the new active CID must have been retired"
+                    );
+                }
+            }
+
+            #[invariant]
+            fn active_cid_is_live(&mut self, _: TestCase) {
+                // active() unwraps internally: there must always be an active CID
+                let _ = self.queue.active();
+                let seq = self.queue.active_seq();
+                assert!(seq >= self.last_active_seq, "active sequence went backwards");
+                assert!(
+                    !self.retired.contains(&seq),
+                    "active CID {seq} was already retired"
+                );
+                self.last_active_seq = seq;
+            }
+        }
+
+        #[hegel::test]
+        fn cid_queue_retires_each_sequence_at_most_once(tc: TestCase) {
+            let machine = QueueModel {
+                queue: CidQueue::new(initial_cid()),
+                retired: BTreeSet::new(),
+                last_active_seq: 0,
+            };
+            hegel::stateful::run(machine, tc);
+        }
+    }
 }
