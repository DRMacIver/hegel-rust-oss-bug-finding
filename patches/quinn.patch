+
+/// Data integrity over the simulated network: any payload, written in arbitrary
+/// chunks with arbitrary interleaved link-driving, over a link with arbitrary
+/// MTU (>= QUIC's required 1200) and latency, is delivered exactly and in order.
+/// Built on the same `Pair` harness and stream API as `finish_stream_simple`.
+#[hegel::test(test_cases = 25)]
+fn stream_data_integrity_across_simulated_link(tc: hegel::TestCase) {
+    use hegel::generators;
+    let _guard = subscribe();
+    let mut pair = Pair::default();
+    pair.mtu = tc.draw(generators::integers::<usize>().min_value(1200).max_value(65527));
+    pair.latency =
+        Duration::from_micros(tc.draw(generators::integers::<u64>().max_value(50_000)));
+    let (client_ch, server_ch) = pair.connect();
+
+    let s = pair.client_streams(client_ch).open(Dir::Uni).unwrap();
+    let chunks: Vec<Vec<u8>> =
+        tc.draw(generators::vecs(generators::binary().max_size(4096)).max_size(8));
+    let mut sent = Vec::new();
+    for chunk in &chunks {
+        let mut written = 0;
+        while written < chunk.len() {
+            match pair.client_send(client_ch, s).write(&chunk[written..]) {
+                Ok(n) => written += n,
+                Err(WriteError::Blocked) => pair.drive(),
+                Err(e) => panic!("write failed: {e}"),
+            }
+        }
+        sent.extend_from_slice(chunk);
+        // Sometimes flush the link between writes to vary packetization
+        if tc.draw(generators::booleans()) {
+            pair.drive();
+        }
+    }
+    pair.client_send(client_ch, s).finish().unwrap();
+    pair.drive();
+
+    while pair.server_conn_mut(server_ch).poll().is_some() {}
+    assert_eq!(pair.server_streams(server_ch).accept(Dir::Uni), Some(s));
+
+    let mut recv = pair.server_recv(server_ch, s);
+    let mut recv_chunks = recv.read(true).unwrap();
+    let mut received = Vec::new();
+    loop {
+        match recv_chunks.next(usize::MAX) {
+            Ok(Some(chunk)) => received.extend_from_slice(&chunk.bytes),
+            Ok(None) => break,
+            Err(e) => panic!("read failed: {e}"),
+        }
+    }
+    let _ = recv_chunks.finalize();
+    assert_eq!(received, sent);
+}
