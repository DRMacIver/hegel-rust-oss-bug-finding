+    /// Any encoded packet number of any width survives a wire roundtrip, its
+    /// encoding is exactly `len()` bytes, and the wire tag agrees with `len()`
+    /// via `decode_len`. Generalizes `roundtrip_packet_numbers` above.
+    #[hegel::test]
+    fn pn_wire_roundtrip(tc: hegel::TestCase) {
+        use hegel::generators;
+        let pn = match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => PacketNumber::U8(tc.draw(generators::integers::<u8>())),
+            1 => PacketNumber::U16(tc.draw(generators::integers::<u16>())),
+            2 => PacketNumber::U24(tc.draw(generators::integers::<u32>().max_value((1 << 24) - 1))),
+            _ => PacketNumber::U32(tc.draw(generators::integers::<u32>())),
+        };
+        let mut buf = Vec::new();
+        pn.encode(&mut buf);
+        assert_eq!(buf.len(), pn.len());
+        assert_eq!(PacketNumber::decode_len(pn.tag()), pn.len());
+        let decoded = PacketNumber::decode(pn.len(), &mut io::Cursor::new(&buf)).unwrap();
+        assert_eq!(decoded, pn);
+    }
+
+    /// RFC 9000 Appendix A: a packet number truncated relative to `largest_acked`
+    /// is recovered exactly by `expand(expected)` for any decoder reference point
+    /// `expected` between `largest_acked` and the packet number itself.
+    /// Generalizes the exhaustive small-range `pn_expand_roundtrip` above to the
+    /// full packet number space (packet numbers are < 2^62, RFC 9000 §12.3).
+    #[hegel::test]
+    fn pn_new_expand_recovers_original(tc: hegel::TestCase) {
+        use crate::VarInt;
+        use hegel::generators;
+        let largest_acked = tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(VarInt::MAX.0),
+            generators::sampled_from(vec![0, 1, u32::MAX as u64, VarInt::MAX.0]),
+        ));
+        // PacketNumber::new supports deltas where 2 * delta fits in 32 bits
+        let max_delta = (u64::from(u32::MAX) / 2).min(VarInt::MAX.0 - largest_acked);
+        let delta = tc.draw(generators::integers::<u64>().max_value(max_delta));
+        let n = largest_acked + delta;
+        // The decoder's reference point trails the encoder's by at most the
+        // unacknowledged span; anywhere in [largest_acked, n] must recover n.
+        let expected = tc.draw(
+            generators::integers::<u64>()
+                .min_value(largest_acked)
+                .max_value(n),
+        );
+        assert_eq!(PacketNumber::new(n, largest_acked).expand(expected), n);
+    }
+
+    /// Port of `fuzz/fuzz_targets/packet.rs`: `PartialDecode::new` never panics on
+    /// arbitrary input, and on success every input byte is accounted for exactly
+    /// once between the decoded packet and the returned trailing datagram bytes.
+    #[hegel::test]
+    fn partial_decode_accounts_for_every_byte(tc: hegel::TestCase) {
+        use hegel::generators;
+        let data: Vec<u8> = tc.draw(generators::binary());
+        // The local CID length is chosen by our own endpoint and is always in
+        // 0..=MAX_CID_SIZE; the fuzz harness (fuzz/fuzz_targets/packet.rs) bounds
+        // it identically. Larger values are outside the parser's domain and only
+        // trip a debug_assert in ConnectionId::from_buf.
+        let cid_len: usize = tc.draw(generators::integers::<usize>().max_value(crate::MAX_CID_SIZE));
+        let grease_quic_bit = tc.draw(generators::booleans());
+        let len = data.len();
+        let supported_versions = crate::DEFAULT_SUPPORTED_VERSIONS.to_vec();
+        if let Ok(decoded) = PartialDecode::new(
+            BytesMut::from(&data[..]),
+            &FixedLengthConnectionIdParser::new(cid_len),
+            &supported_versions,
+            grease_quic_bit,
+        ) {
+            match decoded.1 {
+                Some(rest) => assert_eq!(len, decoded.0.len() + rest.len()),
+                None => assert_eq!(len, decoded.0.len()),
+            }
+        }
+    }
