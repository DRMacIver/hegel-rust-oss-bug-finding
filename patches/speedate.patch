+/// Property-based tests written with hegel.
+///
+/// These cover format->parse roundtrips, parser robustness, rejection of
+/// out-of-range calendar/clock components, timestamp roundtrips, duration
+/// sign handling and differential checks against chrono.
+mod hegel_properties {
+    use super::*;
+    use hegel::generators::{self, Generator};
+
+    /// Independent transcription of the Gregorian calendar rule (the spec, not
+    /// the implementation) used to build valid and invalid dates.
+    fn days_in_month(year: u16, month: u8) -> u8 {
+        match month {
+            1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+            4 | 6 | 9 | 11 => 30,
+            2 => {
+                if year.is_multiple_of(4) && (!year.is_multiple_of(100) || year.is_multiple_of(400)) {
+                    29
+                } else {
+                    28
+                }
+            }
+            _ => unreachable!("month is always drawn in 1..=12"),
+        }
+    }
+
+    #[hegel::composite]
+    fn valid_dates(tc: hegel::TestCase) -> Date {
+        let year = tc.draw(generators::integers::<u16>().max_value(9999));
+        let month = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+        let max_day = days_in_month(year, month);
+        // boost the month-end boundary (28/29/30/31) alongside the full range
+        let day = tc.draw(hegel::one_of!(
+            generators::integers::<u8>().min_value(1).max_value(max_day),
+            generators::just(max_day),
+        ));
+        Date { year, month, day }
+    }
+
+    #[hegel::composite]
+    fn valid_times(tc: hegel::TestCase) -> Time {
+        let hour = tc.draw(generators::integers::<u8>().max_value(23));
+        let minute = tc.draw(generators::integers::<u8>().max_value(59));
+        let second = tc.draw(generators::integers::<u8>().max_value(59));
+        let microsecond = tc.draw(hegel::one_of!(
+            generators::just(0u32),
+            generators::integers::<u32>().max_value(999_999),
+        ));
+        // Offsets representable by the parser are whole minutes, strictly less
+        // than 24h in magnitude (this bound is the parser's own contract).
+        let tz_offset = tc.draw(generators::optional(
+            generators::integers::<i32>()
+                .min_value(-1439)
+                .max_value(1439)
+                .map(|minutes| minutes * 60),
+        ));
+        Time {
+            hour,
+            minute,
+            second,
+            microsecond,
+            tz_offset,
+        }
+    }
+
+    #[hegel::composite]
+    fn valid_datetimes(tc: hegel::TestCase) -> DateTime {
+        DateTime {
+            date: tc.draw(valid_dates()),
+            time: tc.draw(valid_times()),
+        }
+    }
+
+    /// Like `valid_datetimes` but always timezone-aware, so the canonical
+    /// string form is valid RFC 3339 and chrono can parse it.
+    #[hegel::composite]
+    fn tz_aware_datetimes(tc: hegel::TestCase) -> DateTime {
+        let mut dt = tc.draw(valid_datetimes());
+        let minutes = tc.draw(generators::integers::<i32>().min_value(-1439).max_value(1439));
+        dt.time.tz_offset = Some(minutes * 60);
+        dt
+    }
+
+    /// Normalized `Duration`s: field values already within the documented
+    /// ranges (second < 86_400, microsecond < 1_000_000, day <= 999_999_999),
+    /// i.e. what `Duration::new` would produce.
+    #[hegel::composite]
+    fn normalized_durations(tc: hegel::TestCase) -> Duration {
+        let positive = tc.draw(generators::booleans());
+        let day = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(999_999_999),
+            // year boundaries (Display splits days into years at 365) and the max
+            generators::sampled_from(vec![0u32, 1, 7, 30, 364, 365, 366, 999_999_999]),
+        ));
+        let second = tc.draw(generators::integers::<u32>().max_value(86_399));
+        let microsecond = tc.draw(hegel::one_of!(
+            generators::just(0u32),
+            generators::integers::<u32>().max_value(999_999),
+        ));
+        Duration {
+            positive,
+            day,
+            second,
+            microsecond,
+        }
+    }
+
+    /// Format -> parse roundtrip for `Date`: any valid calendar date survives
+    /// Display and re-parsing unchanged, and the string form is a fixpoint.
+    #[hegel::test]
+    fn prop_date_display_parse_roundtrip(tc: hegel::TestCase) {
+        let d = tc.draw(valid_dates());
+        let s = d.to_string();
+        let parsed = Date::parse_str_rfc3339(&s).unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e:?}"));
+        assert_eq!(parsed, d, "roundtrip changed the value via {s:?}");
+        assert_eq!(parsed.to_string(), s, "serialized form is not a fixpoint");
+        // the lax parser must agree with the strict one on canonical input
+        assert_eq!(Date::parse_str(&s).unwrap(), d);
+    }
+
+    /// Format -> parse roundtrip for `Time`, including microseconds and
+    /// timezone offsets (`Z` and `+HH:MM`/`-HH:MM` forms).
+    #[hegel::test]
+    fn prop_time_display_parse_roundtrip(tc: hegel::TestCase) {
+        let t = tc.draw(valid_times());
+        let s = t.to_string();
+        let parsed = Time::parse_str(&s).unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e:?}"));
+        assert_eq!(parsed, t, "roundtrip changed the value via {s:?}");
+        assert_eq!(parsed.to_string(), s, "serialized form is not a fixpoint");
+    }
+
+    /// Format -> parse roundtrip for `DateTime` (the crown roundtrip).
+    #[hegel::test]
+    fn prop_datetime_display_parse_roundtrip(tc: hegel::TestCase) {
+        let dt = tc.draw(valid_datetimes());
+        let s = dt.to_string();
+        let parsed = DateTime::parse_str(&s).unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e:?}"));
+        assert_eq!(parsed, dt, "roundtrip changed the value via {s:?}");
+        assert_eq!(parsed.to_string(), s, "serialized form is not a fixpoint");
+    }
+
+    /// All four parsers must return an error rather than panic, on both
+    /// arbitrary text and near-miss input (a canonical datetime string with
+    /// one byte corrupted).
+    #[hegel::test]
+    fn prop_parse_never_panics(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = if tc.draw(generators::booleans()) {
+            tc.draw(generators::text()).into_bytes()
+        } else {
+            let dt = tc.draw(tz_aware_datetimes());
+            let mut b = dt.to_string().into_bytes();
+            let idx = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+            b[idx] = tc.draw(generators::integers::<u8>());
+            b
+        };
+        let _ = Date::parse_bytes(&bytes);
+        let _ = Time::parse_bytes(&bytes);
+        let _ = DateTime::parse_bytes(&bytes);
+        let _ = Duration::parse_bytes(&bytes);
+        if let Ok(s) = std::str::from_utf8(&bytes) {
+            let _ = Date::from_str(s);
+            let _ = Time::from_str(s);
+            let _ = DateTime::from_str(s);
+            let _ = Duration::from_str(s);
+        }
+    }
+
+    /// Date strings with any component pushed just outside the calendar are
+    /// rejected: month 0/13+, day 0, day beyond the month's length (which
+    /// covers Feb 29 in non-leap years, Feb 30, Apr 31, ...).
+    #[hegel::test]
+    fn prop_date_rejects_out_of_range_components(tc: hegel::TestCase) {
+        let year = tc.draw(generators::integers::<u16>().max_value(9999));
+        let good_month = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+        let max_day = days_in_month(year, good_month);
+        let (month, day) = match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => (0, tc.draw(generators::integers::<u8>().min_value(1).max_value(28))),
+            1 => (
+                tc.draw(generators::integers::<u8>().min_value(13).max_value(99)),
+                tc.draw(generators::integers::<u8>().min_value(1).max_value(28)),
+            ),
+            2 => (good_month, 0),
+            _ => (
+                good_month,
+                tc.draw(generators::integers::<u8>().min_value(max_day + 1).max_value(99)),
+            ),
+        };
+        let s = format!("{year:04}-{month:02}-{day:02}");
+        assert!(
+            Date::parse_str_rfc3339(&s).is_err(),
+            "strict parser accepted invalid date {s:?}"
+        );
+        assert!(Date::parse_str(&s).is_err(), "lax parser accepted invalid date {s:?}");
+    }
+
+    /// Time strings with any component pushed out of range are rejected:
+    /// hour 24+, minute 60+, second 60+ (i.e. leap seconds are not accepted),
+    /// timezone offsets of 24h or more, and timezone minutes of 60+.
+    #[hegel::test]
+    fn prop_time_rejects_out_of_range_components(tc: hegel::TestCase) {
+        let mut hour = tc.draw(generators::integers::<u8>().max_value(23));
+        let mut minute = tc.draw(generators::integers::<u8>().max_value(59));
+        let mut second = tc.draw(generators::integers::<u8>().max_value(59));
+        let mut tz: Option<(char, u8, u8)> = None;
+        let sign = tc.draw(generators::sampled_from(vec!['+', '-']));
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => hour = tc.draw(generators::integers::<u8>().min_value(24).max_value(99)),
+            1 => minute = tc.draw(generators::integers::<u8>().min_value(60).max_value(99)),
+            // 60 is the leap-second boundary; speedate documents seconds 0..=59
+            2 => second = tc.draw(generators::integers::<u8>().min_value(60).max_value(99)),
+            3 => {
+                // |offset| >= 24h must be rejected
+                tz = Some((
+                    sign,
+                    tc.draw(generators::integers::<u8>().min_value(24).max_value(99)),
+                    tc.draw(generators::integers::<u8>().max_value(59)),
+                ));
+            }
+            _ => {
+                // offset minutes >= 60 must be rejected
+                tz = Some((
+                    sign,
+                    tc.draw(generators::integers::<u8>().max_value(23)),
+                    tc.draw(generators::integers::<u8>().min_value(60).max_value(99)),
+                ));
+            }
+        }
+        let mut s = format!("{hour:02}:{minute:02}:{second:02}");
+        if let Some((sign, tz_hour, tz_minute)) = tz {
+            s.push(sign);
+            s.push_str(&format!("{tz_hour:02}:{tz_minute:02}"));
+        }
+        assert!(Time::parse_str(&s).is_err(), "accepted invalid time {s:?}");
+    }
+
+    /// `DateTime::from_timestamp(ts, micro).timestamp()` recovers `ts` for the
+    /// whole documented "interpreted as seconds" range (|ts| <= 2e10).
+    #[hegel::test]
+    fn prop_datetime_timestamp_roundtrip(tc: hegel::TestCase) {
+        let ts = tc.draw(hegel::one_of!(
+            generators::integers::<i64>()
+                .min_value(-20_000_000_000)
+                .max_value(20_000_000_000),
+            // watershed and epoch boundaries
+            generators::sampled_from(vec![-20_000_000_000i64, 20_000_000_000, -1, 0, 1]),
+        ));
+        let micro = tc.draw(generators::integers::<u32>().max_value(999_999));
+        let dt = DateTime::from_timestamp(ts, micro)
+            .unwrap_or_else(|e| panic!("from_timestamp({ts}, {micro}) unexpectedly failed: {e:?}"));
+        assert_eq!(dt.timestamp(), ts, "timestamp not recovered for ({ts}, {micro})");
+        assert_eq!(dt.time.microsecond, micro);
+        assert_eq!(dt.time.tz_offset, None);
+    }
+
+    /// With the timestamp unit pinned to seconds (no watershed inference),
+    /// `Date -> timestamp -> Date` is the identity for every valid date,
+    /// including dates beyond the 2e10 inference watershed (year > 2603).
+    #[hegel::test]
+    fn prop_date_timestamp_roundtrip_second_unit(tc: hegel::TestCase) {
+        let d = tc.draw(valid_dates());
+        let config = DateConfigBuilder::new().timestamp_unit(TimestampUnit::Second).build();
+        let ts = d.timestamp();
+        let d2 = Date::from_timestamp(ts, true, &config)
+            .unwrap_or_else(|e| panic!("from_timestamp({ts}) failed for {d}: {e:?}"));
+        assert_eq!(d2, d, "date -> timestamp({ts}) -> date roundtrip failed");
+    }
+
+    /// Format -> parse roundtrip for `Duration` in ISO 8601 form, including
+    /// the year/day split in Display and fractional-second trimming.
+    #[hegel::test]
+    fn prop_duration_display_parse_roundtrip(tc: hegel::TestCase) {
+        let d = tc.draw(normalized_durations());
+        let s = d.to_string();
+        let parsed = Duration::parse_str(&s).unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e:?}"));
+        assert_eq!(parsed, d, "roundtrip changed the value via {s:?}");
+        assert_eq!(parsed.to_string(), s, "serialized form is not a fixpoint");
+    }
+
+    /// Sign handling: `-X` parses to the same magnitude as `X` and `+X`, with
+    /// `positive` flipped and all signed totals exactly negated.
+    #[hegel::test]
+    fn prop_duration_sign_symmetry(tc: hegel::TestCase) {
+        let mut magnitude = tc.draw(normalized_durations());
+        magnitude.positive = true;
+        let s = magnitude.to_string();
+        let plus = Duration::parse_str(&format!("+{s}")).unwrap();
+        let minus = Duration::parse_str(&format!("-{s}")).unwrap();
+        assert_eq!(plus, magnitude, "explicit + changed the parse of {s:?}");
+        assert!(!minus.positive);
+        assert_eq!(
+            (minus.day, minus.second, minus.microsecond),
+            (magnitude.day, magnitude.second, magnitude.microsecond),
+            "-{s} changed the magnitude"
+        );
+        assert_eq!(minus.signed_total_seconds(), -plus.signed_total_seconds());
+        assert_eq!(minus.signed_microseconds(), -plus.signed_microseconds());
+        assert_eq!(minus.signed_total_ms(), -plus.signed_total_ms());
+    }
+
+    /// Differential against chrono: the canonical string of any tz-aware
+    /// DateTime parses as RFC 3339 in chrono and denotes the same instant.
+    #[hegel::test]
+    fn prop_datetime_agrees_with_chrono(tc: hegel::TestCase) {
+        let dt = tc.draw(tz_aware_datetimes());
+        let s = dt.to_string();
+        let ch = chrono::DateTime::parse_from_rfc3339(&s)
+            .unwrap_or_else(|e| panic!("chrono rejected speedate's canonical form {s:?}: {e:?}"));
+        assert_eq!(dt.timestamp_tz(), ch.timestamp(), "instant mismatch for {s:?}");
+        assert_eq!(
+            dt.time.microsecond,
+            ch.timestamp_subsec_micros(),
+            "subsecond mismatch for {s:?}"
+        );
+    }
+
+    /// Ordering consistency: comparing two tz-aware DateTimes agrees with
+    /// chrono's instant-based ordering of the same values.
+    #[hegel::test]
+    fn prop_datetime_ordering_matches_chrono(tc: hegel::TestCase) {
+        let a = tc.draw(tz_aware_datetimes());
+        let b = tc.draw(tz_aware_datetimes());
+        let ca = chrono::DateTime::parse_from_rfc3339(&a.to_string()).unwrap();
+        let cb = chrono::DateTime::parse_from_rfc3339(&b.to_string()).unwrap();
+        assert_eq!(
+            a.partial_cmp(&b),
+            Some(ca.cmp(&cb)),
+            "ordering mismatch: {a} vs {b} (chrono: {ca} vs {cb})"
+        );
+    }
+}
