+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use postcard::accumulator::{CobsAccumulator, FeedResult};
+    use serde::{Deserialize, Serialize};
+
+    use hegel::generators;
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+    struct SmallMsg {
+        a: u32,
+        b: i16,
+        c: Option<u8>,
+    }
+
+    #[hegel::composite]
+    fn small_msgs(tc: hegel::TestCase) -> SmallMsg {
+        SmallMsg {
+            a: tc.draw(generators::integers::<u32>()),
+            b: tc.draw(generators::integers::<i16>()),
+            c: tc.draw(generators::optional(generators::integers::<u8>())),
+        }
+    }
+
+    /// Feeding a well-formed COBS stream to `CobsAccumulator` in arbitrary
+    /// chunks reassembles exactly the original sequence of messages,
+    /// regardless of where the chunk boundaries fall (mid-frame, on frame
+    /// boundaries, multiple frames per chunk, ...).
+    #[hegel::test]
+    fn prop_accumulator_reassembles_arbitrarily_chunked_stream(tc: hegel::TestCase) {
+        let msgs: Vec<SmallMsg> = tc.draw(generators::vecs(small_msgs()));
+
+        // Build the contiguous COBS stream.
+        let mut stream: Vec<u8> = Vec::new();
+        for m in &msgs {
+            let mut buf = [0u8; 64];
+            stream.extend_from_slice(postcard::to_slice_cobs(m, &mut buf).unwrap());
+        }
+
+        let mut acc: CobsAccumulator<64> = CobsAccumulator::new();
+        let mut got: Vec<SmallMsg> = Vec::new();
+
+        // Feed the stream in arbitrarily-sized chunks.
+        let mut pos = 0;
+        while pos < stream.len() {
+            let chunk_len = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(stream.len() - pos),
+            );
+            let mut window = &stream[pos..pos + chunk_len];
+            'cobs: while !window.is_empty() {
+                window = match acc.feed::<SmallMsg>(window) {
+                    FeedResult::Consumed => break 'cobs,
+                    FeedResult::OverFull(_) => {
+                        panic!("accumulator reported OverFull on a well-formed stream")
+                    }
+                    FeedResult::DeserError(_) => {
+                        panic!("accumulator reported DeserError on a well-formed stream")
+                    }
+                    FeedResult::Success { data, remaining } => {
+                        got.push(data);
+                        remaining
+                    }
+                };
+            }
+            pos += chunk_len;
+        }
+
+        assert_eq!(got, msgs);
+    }
+}
