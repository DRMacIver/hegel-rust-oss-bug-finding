@@ -171,3 +171,53 @@ mod expand_prefixes {
         out.into_iter().map(|b| b.to_string()).collect()
     }
 }
+
+/// Property-based tests (hegel).
+mod properties {
+    use bstr::ByteSlice;
+    use gix_refspec::parse::Operation;
+    use hegel::generators;
+
+    /// A refspec whose relevant side is likely `refs/`-prefixed, so that `prefix()` is often `Some`.
+    #[hegel::composite]
+    fn prefixy_side(tc: hegel::TestCase) -> String {
+        tc.draw(hegel::one_of!(
+            generators::from_regex(r"refs/(heads|tags|namespaces/[a-z]{1,4}/refs/heads)/[a-zA-Z0-9._-]{1,8}")
+                .fullmatch(true),
+            generators::from_regex(r"refs/[a-zA-Z0-9._-]{1,8}/(\*|[a-zA-Z0-9._-]{0,4}\*?)").fullmatch(true),
+            generators::just("HEAD".to_string()),
+            generators::from_regex(r"[a-zA-Z0-9._-]{1,8}").fullmatch(true),
+        ))
+    }
+
+    /// Property: `prefix()` is documented to return the source (fetch) / destination (push) side
+    /// unchanged for exact `refs/`-prefixed refs, or "the portion up to their single `*`" for
+    /// simple glob refspecs — so whatever it returns must be a prefix of that side.
+    #[hegel::test]
+    fn prefix_is_a_prefix_of_the_relevant_side(tc: hegel::TestCase) {
+        let op = tc.draw(generators::sampled_from(vec![Operation::Fetch, Operation::Push]));
+        let input = {
+            let mut spec = String::new();
+            spec.push_str(tc.draw(generators::sampled_from(vec!["", "+"])));
+            spec.push_str(&tc.draw(prefixy_side()));
+            if tc.draw(generators::booleans()) {
+                spec.push(':');
+                spec.push_str(&tc.draw(prefixy_side()));
+            }
+            spec
+        };
+        let Ok(spec) = gix_refspec::parse(input.as_str().into(), op) else {
+            tc.reject()
+        };
+        let Some(prefix) = spec.prefix() else { tc.reject() };
+        let side = match op {
+            Operation::Fetch => spec.source(),
+            Operation::Push => spec.destination(),
+        }
+        .expect("a spec with a prefix has the corresponding side");
+        assert!(
+            side.starts_with(prefix.as_bytes()),
+            "prefix {prefix:?} must be a prefix of {side:?}"
+        );
+    }
+}
diff --git a/gix-refspec/tests/refspec/write.rs b/gix-refspec/tests/refspec/write.rs
index 57c61bcba..8846fe22b 100644
--- a/gix-refspec/tests/refspec/write.rs
+++ b/gix-refspec/tests/refspec/write.rs
@@ -96,3 +96,90 @@ mod fetch {
         );
     }
 }
+
+/// Property-based tests (hegel).
+pub(crate) mod properties {
+    use bstr::ByteSlice;
+    use gix_refspec::parse::Operation;
+    use hegel::generators;
+
+    /// Refspec-ish input: arbitrary text plus structured `[+^]src[:dst]` shapes built from
+    /// refname-like fragments, globs, object hashes and `HEAD`.
+    #[hegel::composite]
+    pub(crate) fn refspec_ish(tc: hegel::TestCase) -> Vec<u8> {
+        let side = |tc: &hegel::TestCase| -> String {
+            tc.draw(hegel::one_of!(
+                generators::from_regex(r"(refs/(heads|tags|remotes)/)?[a-zA-Z0-9*._@{}/-]{0,15}").fullmatch(true),
+                generators::just("HEAD".to_string()),
+                generators::from_regex(r"[0-9a-f]{40}").fullmatch(true),
+            ))
+        };
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => tc.draw(generators::text().max_size(30)).into_bytes(),
+            1 => {
+                let mut out = String::new();
+                out.push_str(tc.draw(generators::sampled_from(vec!["", "+", "^"])));
+                out.push_str(&side(&tc));
+                if tc.draw(generators::booleans()) {
+                    out.push(':');
+                    out.push_str(&side(&tc));
+                }
+                out.into_bytes()
+            }
+            _ => tc.draw(generators::binary().max_size(30)),
+        }
+    }
+
+    /// Property: `RefSpecRef::to_bstring()` is documented to "reproduce ourselves in parseable form",
+    /// so serializing any successfully parsed refspec must parse again under the same operation and
+    /// yield the same instruction.
+    #[hegel::test]
+    fn parsed_specs_reproduce_in_parseable_form(tc: hegel::TestCase) {
+        let op = tc.draw(generators::sampled_from(vec![Operation::Fetch, Operation::Push]));
+        let input = tc.draw(refspec_ish());
+        let Ok(spec) = gix_refspec::parse(input.as_bstr(), op) else {
+            tc.reject()
+        };
+        // KNOWN BUG exclusion: one-sided push specs skip source validation when they contain globs,
+        // but serialize via `Push::Matching` to `src:src` which is validated strictly on reparse.
+        // See `one_sided_push_glob_specs_reproduce_in_parseable_form` for the canonical failing test.
+        tc.assume(
+            !(op == Operation::Push
+                && spec.destination().is_none()
+                && spec.source().is_some_and(|src| src.contains(&b'*'))),
+        );
+        let serialized = spec.to_bstring();
+        let reparsed = gix_refspec::parse(serialized.as_bstr(), op).unwrap_or_else(|err| {
+            panic!("serialization {serialized:?} of a parsed refspec must be parseable, but failed with: {err}")
+        });
+        assert_eq!(
+            reparsed.instruction(),
+            spec.instruction(),
+            "reparsing the serialization {serialized:?} must reproduce the same instruction"
+        );
+    }
+
+    /// KNOWN FAILURE: pins a real bug — one-sided push specs with complex globs (or other content
+    /// that only passes the relaxed one-sided validation) serialize to an unparseable form.
+    ///
+    /// `parse("a*b*", Push)` succeeds because `validated()` in src/parse.rs skips all validation
+    /// for one-sided specs containing globs ("we allow complex glob patterns in one-sided refspecs").
+    /// Its instruction is `Push::Matching { src: "a*b*", dst: "a*b*" }`, so `to_bstring()` yields
+    /// `"a*b*:a*b*"` — which fails to reparse with `PatternUnsupported` since two-sided specs allow
+    /// at most one `*` per side. This violates the documented contract of `to_bstring()`:
+    /// "Reproduce ourselves in parseable form". The same happens for invalid ref-name bytes next to
+    /// a glob, e.g. `parse("\x01*", Push)` serializes to `"\x01*:\x01*"` (`InvalidByte` on reparse).
+    #[hegel::test]
+    fn one_sided_push_glob_specs_reproduce_in_parseable_form(tc: hegel::TestCase) {
+        let a: String = tc.draw(generators::from_regex(r"[a-z]{0,4}").fullmatch(true));
+        let b: String = tc.draw(generators::from_regex(r"[a-z]{0,4}").fullmatch(true));
+        let input = format!("{a}*{b}*");
+        let spec = gix_refspec::parse(input.as_str().into(), Operation::Push)
+            .expect("one-sided push specs accept complex globs");
+        let serialized = spec.to_bstring();
+        let reparsed = gix_refspec::parse(serialized.as_bstr(), Operation::Push).unwrap_or_else(|err| {
+            panic!("serialization {serialized:?} of a parsed refspec must be parseable, but failed with: {err}")
+        });
+        assert_eq!(reparsed.instruction(), spec.instruction());
+    }
+}
