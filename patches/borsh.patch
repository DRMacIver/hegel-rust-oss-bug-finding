diff --git a/borsh/tests/roundtrip/test_primitives.rs b/borsh/tests/roundtrip/test_primitives.rs
index 58fbd773..9e48b4e5 100644
--- a/borsh/tests/roundtrip/test_primitives.rs
+++ b/borsh/tests/roundtrip/test_primitives.rs
@@ -23,3 +23,60 @@ test_primitive!(test_isize_max, isize::max_value(), isize);
 test_primitive!(test_usize, 100usize, usize);
 test_primitive!(test_usize_min, usize::min_value(), usize);
 test_primitive!(test_usize_max, usize::max_value(), usize);
+
+/// Property-based (hegel) tests for float wire semantics.
+///
+/// The BORSH spec fixes floats as IEEE-754 little-endian bit patterns and
+/// explicitly forbids NaN on both the serialization and deserialization
+/// sides (see the `impl_for_float!` macros in src/ser and src/de).
+#[cfg(feature = "std")]
+mod hegel_float_props {
+    use borsh::{from_slice, to_vec};
+    use hegel::generators;
+
+    /// Non-NaN floats round-trip bit-exactly (covers -0.0, infinities and
+    /// subnormals), and the encoding is exactly the little-endian bytes of
+    /// the IEEE-754 bit pattern (spec oracle).
+    #[hegel::test]
+    fn prop_f32_f64_bit_exact_roundtrip_and_le_layout(tc: hegel::TestCase) {
+        // Draw raw bit patterns so that every float value, not just "nice"
+        // ones, is exercised.
+        let bits32 = tc.draw(generators::integers::<u32>());
+        let f = f32::from_bits(bits32);
+        if !f.is_nan() {
+            let bytes = to_vec(&f).unwrap();
+            assert_eq!(bytes, bits32.to_le_bytes().to_vec());
+            assert_eq!(from_slice::<f32>(&bytes).unwrap().to_bits(), bits32);
+        }
+
+        let bits64 = tc.draw(generators::integers::<u64>());
+        let g = f64::from_bits(bits64);
+        if !g.is_nan() {
+            let bytes = to_vec(&g).unwrap();
+            assert_eq!(bytes, bits64.to_le_bytes().to_vec());
+            assert_eq!(from_slice::<f64>(&bytes).unwrap().to_bits(), bits64);
+        }
+    }
+
+    /// Every NaN bit pattern is rejected by serialization, and its byte
+    /// encoding is rejected by deserialization (validation/rejection).
+    #[hegel::test]
+    fn prop_nan_rejected_on_both_sides(tc: hegel::TestCase) {
+        // NaN = exponent all ones + non-zero mantissa; construct directly.
+        let sign32 = u32::from(tc.draw(generators::booleans())) << 31;
+        let mantissa32 = tc
+            .draw(generators::integers::<u32>().min_value(1).max_value((1 << 23) - 1));
+        let bits32 = sign32 | 0x7f80_0000 | mantissa32;
+        assert!(f32::from_bits(bits32).is_nan());
+        assert!(to_vec(&f32::from_bits(bits32)).is_err());
+        assert!(from_slice::<f32>(&bits32.to_le_bytes()).is_err());
+
+        let sign64 = u64::from(tc.draw(generators::booleans())) << 63;
+        let mantissa64 = tc
+            .draw(generators::integers::<u64>().min_value(1).max_value((1 << 52) - 1));
+        let bits64 = sign64 | 0x7ff0_0000_0000_0000 | mantissa64;
+        assert!(f64::from_bits(bits64).is_nan());
+        assert!(to_vec(&f64::from_bits(bits64)).is_err());
+        assert!(from_slice::<f64>(&bits64.to_le_bytes()).is_err());
+    }
+}
