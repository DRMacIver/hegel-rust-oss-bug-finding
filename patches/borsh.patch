+
+/// Property-based (hegel) tests for explicit-discriminant enum wire format:
+/// the spec says the enum tag byte is the declared discriminant, and any
+/// tag not naming a declared variant must be rejected.
+#[cfg(feature = "std")]
+mod hegel_discriminant_props {
+    use super::XY;
+    use alloc::vec::Vec;
+    use borsh::{from_slice, to_vec};
+    use hegel::generators;
+
+    // Declared discriminants of XY: A=0, B=20, C=21, D=22, E=10, F=11.
+    const XY_TAGS: [u8; 6] = [0, 20, 21, 22, 10, 11];
+
+    fn draw_xy(tc: &hegel::TestCase) -> (XY, u8) {
+        let which = tc.draw(generators::integers::<u8>().max_value(5));
+        match which {
+            0 => (XY::A, 0),
+            1 => (XY::B, 20),
+            2 => (XY::C, 21),
+            3 => (
+                XY::D(
+                    tc.draw(generators::integers::<u32>()),
+                    tc.draw(generators::integers::<u32>()),
+                ),
+                22,
+            ),
+            4 => (XY::E, 10),
+            _ => (XY::F(tc.draw(generators::integers::<u64>())), 11),
+        }
+    }
+
+    /// The first byte on the wire is the declared discriminant, and the
+    /// value (with arbitrary payloads) round-trips.
+    #[hegel::test]
+    fn prop_enum_tag_is_declared_discriminant_and_roundtrips(tc: hegel::TestCase) {
+        let (value, expected_tag) = draw_xy(&tc);
+        let bytes = to_vec(&value).unwrap();
+        assert_eq!(bytes[0], expected_tag);
+        assert_eq!(from_slice::<XY>(&bytes).unwrap(), value);
+    }
+
+    /// Any tag byte that is not a declared discriminant is rejected,
+    /// whatever bytes follow it.
+    #[hegel::test]
+    fn prop_undeclared_enum_tag_rejected(tc: hegel::TestCase) {
+        let tag = tc.draw(generators::integers::<u8>());
+        tc.assume(!XY_TAGS.contains(&tag));
+        let trailing = tc.draw(generators::binary().max_size(16));
+        let mut data: Vec<u8> = Vec::new();
+        data.push(tag);
+        data.extend_from_slice(&trailing);
+        assert!(
+            from_slice::<XY>(&data).is_err(),
+            "undeclared tag {} accepted",
+            tag
+        );
+    }
+}
diff --git a/borsh/tests/roundtrip/test_btree_map.rs b/borsh/tests/roundtrip/test_btree_map.rs
index 6967d2e0..0449c925 100644
--- a/borsh/tests/roundtrip/test_btree_map.rs
+++ b/borsh/tests/roundtrip/test_btree_map.rs
@@ -92,3 +92,106 @@ const ERROR_WRONG_ORDER_OF_KEYS: &str = "keys were not serialized in ascending o
 set_wrong_order_test!(test_btreeset_deser_err_wrong_order, BTreeSet<String>);
 
 map_wrong_order_test!(test_btreemap_deser_err_wrong_order, BTreeMap<String, String>);
+
+/// Property-based (hegel) tests for the spec's map/set key-ordering rule.
+///
+/// The BORSH spec mandates that map keys / set items are serialized in
+/// strictly ascending order. On deserialization, borsh only *enforces* this
+/// when built with the `de_strict_order` feature; by default, out-of-order
+/// (and even duplicate) keys are silently accepted and reordered. Both
+/// behaviors are pinned here, mirroring `set_wrong_order_test!` in
+/// common_macro.rs but over generated key sequences.
+#[cfg(feature = "std")]
+mod hegel_key_order_props {
+    use alloc::collections::{BTreeMap, BTreeSet};
+    use alloc::vec::Vec;
+    use borsh::from_slice;
+    use hegel::generators;
+
+    /// Hand-encode `pairs` as a borsh map and check the ordering contract:
+    /// strictly ascending keys are always accepted (and decode to exactly
+    /// those entries); non-ascending keys are rejected under
+    /// `de_strict_order` and accepted (last key wins) without it.
+    #[hegel::test]
+    fn prop_btreemap_key_order_enforcement(tc: hegel::TestCase) {
+        let mut pairs: Vec<(u8, u8)> = tc.draw(generators::vecs(generators::tuples!(
+            generators::integers::<u8>(),
+            generators::integers::<u8>()
+        )));
+        // Bias half the cases toward valid (sorted, unique-key) input so
+        // both accept and reject branches are exercised.
+        if tc.draw(generators::booleans()) {
+            pairs.sort_by_key(|(k, _)| *k);
+            pairs.dedup_by_key(|(k, _)| *k);
+        }
+
+        let mut data: Vec<u8> = Vec::new();
+        data.extend_from_slice(&(pairs.len() as u32).to_le_bytes());
+        for (k, v) in &pairs {
+            data.push(*k);
+            data.push(*v);
+        }
+
+        let strictly_ascending = pairs.windows(2).all(|w| w[0].0 < w[1].0);
+        let expected: BTreeMap<u8, u8> = pairs.iter().copied().collect();
+        let result = from_slice::<BTreeMap<u8, u8>>(&data);
+
+        #[cfg(feature = "de_strict_order")]
+        {
+            if strictly_ascending {
+                assert_eq!(result.unwrap(), expected);
+            } else {
+                assert!(
+                    result.is_err(),
+                    "non-ascending keys {:?} accepted under de_strict_order",
+                    pairs
+                );
+            }
+        }
+        #[cfg(not(feature = "de_strict_order"))]
+        {
+            // Default behavior: accepted regardless of order; last value
+            // wins for duplicate keys (sequential-insert semantics).
+            let _ = strictly_ascending;
+            assert_eq!(result.unwrap(), expected);
+        }
+    }
+
+    /// The same ordering contract for sets.
+    #[hegel::test]
+    fn prop_btreeset_item_order_enforcement(tc: hegel::TestCase) {
+        let mut items: Vec<u16> = tc.draw(generators::vecs(generators::integers::<u16>()));
+        if tc.draw(generators::booleans()) {
+            items.sort_unstable();
+            items.dedup();
+        }
+
+        let mut data: Vec<u8> = Vec::new();
+        data.extend_from_slice(&(items.len() as u32).to_le_bytes());
+        for item in &items {
+            data.extend_from_slice(&item.to_le_bytes());
+        }
+
+        let strictly_ascending = items.windows(2).all(|w| w[0] < w[1]);
+        let expected: BTreeSet<u16> = items.iter().copied().collect();
+        let result = from_slice::<BTreeSet<u16>>(&data);
+
+        #[cfg(feature = "de_strict_order")]
+        {
+            if strictly_ascending {
+                assert_eq!(result.unwrap(), expected);
+            } else {
+                assert!(
+                    result.is_err(),
+                    "non-ascending items {:?} accepted under de_strict_order",
+                    items
+                );
+            }
+        }
+        #[cfg(not(feature = "de_strict_order"))]
+        {
+            let _ = strictly_ascending;
+            assert_eq!(result.unwrap(), expected);
+        }
+    }
+}
