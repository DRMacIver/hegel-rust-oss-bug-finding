@@ -57,3 +57,102 @@ fn test_find_coherent() -> anyhow::Result<()> {
 
     Ok(())
 }
+
+// ---
+// Property-based tests (hegel).
+// ---
+
+use std::collections::BTreeSet;
+
+use hegel::generators;
+
+use crate::quorum::QuorumSet;
+
+/// Number of node ids used for exhaustive quorum enumeration.
+///
+/// Kept small so that enumerating all `2^UNIVERSE` id subsets stays cheap.
+/// This bound protects the test's running time, not the library's contract.
+const UNIVERSE: u64 = 7;
+
+#[hegel::composite]
+fn small_config(tc: hegel::TestCase) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(generators::integers::<u64>().max_value(UNIVERSE - 1)).min_size(1).max_size(5))
+        .into_iter()
+        .collect()
+}
+
+/// A joint quorum set of 1 or 2 non-empty configs, as `Membership` uses.
+#[hegel::composite]
+fn small_joint(tc: hegel::TestCase) -> Vec<BTreeSet<u64>> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+    (0..n).map(|_| tc.draw(small_config())).collect()
+}
+
+/// Enumerate every subset of `0..UNIVERSE` that `qs` accepts as a quorum,
+/// each represented as a bitmask over the ids.
+fn all_quorums<QS: QuorumSet<Id = u64>>(qs: &QS) -> Vec<u32> {
+    let mut quorums = Vec::new();
+    for mask in 0u32..(1 << UNIVERSE) {
+        let ids = (0..UNIVERSE).filter(|id| mask & (1 << id) != 0).collect::<Vec<_>>();
+        if qs.is_quorum(ids.iter()) {
+            quorums.push(mask);
+        }
+    }
+    quorums
+}
+
+/// Return true if every quorum in `a` intersects every quorum in `b`.
+fn quorums_pairwise_intersect(a: &[u32], b: &[u32]) -> bool {
+    a.iter().all(|qa| b.iter().all(|qb| qa & qb != 0))
+}
+
+/// `find_coherent` must return an intermediate quorum set `X` with
+/// `self ~ X ~ other`: every quorum of `self` intersects every quorum of `X`,
+/// and every quorum of `X` intersects every quorum of `other`.
+///
+/// This is the safety property that makes joint-consensus membership change
+/// correct; it is checked against an exhaustive enumeration of all quorums.
+#[hegel::test]
+fn hegel_find_coherent_yields_pairwise_intersecting_quorums(tc: hegel::TestCase) {
+    let current: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+    let goal: BTreeSet<u64> = tc.draw(small_config());
+
+    let intermediate = current.find_coherent(goal.clone());
+
+    let current_quorums = all_quorums(&current);
+    let intermediate_quorums = all_quorums(&intermediate);
+    let goal_quorums = all_quorums(&vec![goal.clone()]);
+
+    assert!(
+        quorums_pairwise_intersect(&current_quorums, &intermediate_quorums),
+        "current {current:?} must be coherent with intermediate {intermediate:?}"
+    );
+    assert!(
+        quorums_pairwise_intersect(&intermediate_quorums, &goal_quorums),
+        "intermediate {intermediate:?} must be coherent with goal {goal:?}"
+    );
+}
+
+/// If `is_coherent_with` reports two joint configs as coherent, then every
+/// quorum of one must intersect every quorum of the other (the definition of
+/// coherence documented on the `Coherent` trait).
+#[hegel::test]
+fn hegel_is_coherent_with_implies_intersecting_quorums(tc: hegel::TestCase) {
+    let a: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+    let mut b: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+
+    // Half of the time, force a shared config so that the coherent case is
+    // actually exercised; random independent draws are rarely coherent.
+    if tc.draw(generators::booleans()) {
+        let from = tc.draw(generators::integers::<usize>().max_value(a.len() - 1));
+        let to = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+        b[to] = a[from].clone();
+    }
+
+    if a.is_coherent_with(&b) {
+        assert!(
+            quorums_pairwise_intersect(&all_quorums(&a), &all_quorums(&b)),
+            "coherent joints {a:?} and {b:?} must have pairwise intersecting quorums"
+        );
+    }
+}
diff --git a/openraft/src/quorum/quorum_set_test.rs b/openraft/src/quorum/quorum_set_test.rs
index a09de6b..46513ed 100644
--- a/openraft/src/quorum/quorum_set_test.rs
+++ b/openraft/src/quorum/quorum_set_test.rs
@@ -67,3 +67,90 @@ fn test_ids() -> anyhow::Result<()> {
 
     Ok(())
 }
+
+// ---
+// Property-based tests (hegel).
+// ---
+
+use std::collections::BTreeSet;
+
+use hegel::generators;
+
+/// Independent oracle for the simple-majority rule: a set of granted ids is a
+/// quorum of `config` iff strictly more than half of the config members are
+/// granted.
+fn is_majority_oracle(config: &BTreeSet<u64>, granted: &BTreeSet<u64>) -> bool {
+    let overlap = config.intersection(granted).count();
+    overlap * 2 > config.len()
+}
+
+/// Node ids are mostly drawn from a small pool so that configs and granted
+/// sets collide often; occasionally full-range ids cover boundary values.
+#[hegel::composite]
+fn node_id(tc: hegel::TestCase) -> u64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u64>().max_value(9),
+        generators::integers::<u64>(),
+    ))
+}
+
+#[hegel::composite]
+fn id_set(tc: hegel::TestCase, min_size: usize) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(node_id()).min_size(min_size).max_size(9)).into_iter().collect()
+}
+
+/// A joint quorum set of 1 to 3 non-empty configs.
+#[hegel::composite]
+fn joint(tc: hegel::TestCase) -> Vec<BTreeSet<u64>> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+    (0..n).map(|_| tc.draw(id_set(1))).collect()
+}
+
+/// `BTreeSet::is_quorum` implements simple majority, and the `&[ID]`
+/// implementation agrees with it.
+#[hegel::test]
+fn hegel_majority_quorum_matches_counting_oracle(tc: hegel::TestCase) {
+    let config: BTreeSet<u64> = tc.draw(id_set(0));
+    let granted: BTreeSet<u64> = tc.draw(id_set(0));
+
+    let want = is_majority_oracle(&config, &granted);
+    assert_eq!(want, config.is_quorum(granted.iter()));
+
+    let slice = config.iter().copied().collect::<Vec<_>>();
+    assert_eq!(want, slice.as_slice().is_quorum(granted.iter()));
+}
+
+/// A joint quorum set grants iff the granted set is a majority in every config.
+#[hegel::test]
+fn hegel_joint_quorum_is_majority_in_every_config(tc: hegel::TestCase) {
+    let joint: Vec<BTreeSet<u64>> = tc.draw(joint());
+    let granted: BTreeSet<u64> = tc.draw(id_set(0));
+
+    let want = joint.iter().all(|config| is_majority_oracle(config, &granted));
+    assert_eq!(want, joint.is_quorum(granted.iter()));
+}
+
+/// The `QuorumSet` trait requires implementations to be upward-closed:
+/// adding more ids to a quorum must still be a quorum.
+#[hegel::test]
+fn hegel_quorum_is_upward_closed(tc: hegel::TestCase) {
+    let joint: Vec<BTreeSet<u64>> = tc.draw(joint());
+
+    // Draw the granted set mostly from the members so that quorums are common.
+    let members = joint.ids().collect::<Vec<_>>();
+    let mut granted = BTreeSet::new();
+    for id in members {
+        if tc.draw(generators::booleans()) {
+            granted.insert(id);
+        }
+    }
+    let extra: BTreeSet<u64> = tc.draw(id_set(0));
+    let bigger = granted.union(&extra).copied().collect::<BTreeSet<_>>();
+
+    if joint.is_quorum(granted.iter()) {
+        assert!(
+            joint.is_quorum(bigger.iter()),
+            "adding ids {extra:?} to quorum {granted:?} of {joint:?} must still be a quorum"
+        );
+    }
+}
diff --git a/openraft/src/vote/vote.rs b/openraft/src/vote/vote.rs
index 8302215..f0b734b 100644
--- a/openraft/src/vote/vote.rs
+++ b/openraft/src/vote/vote.rs
@@ -259,3 +259,185 @@ mod tests {
         }
     }
 }
+
+/// Property-based tests (hegel) for the `Vote` ordering semantics.
+#[cfg(test)]
+mod hegel_props {
+    use std::cmp::Ordering;
+
+    use hegel::generators;
+
+    use crate::Vote;
+    use crate::vote::leader_id_std;
+
+    type StdLeaderId = leader_id_std::LeaderId<u64, u64>;
+    type AdvLeaderId = crate::impls::leader_id_adv::LeaderId<u64, u64>;
+
+    /// Terms and node ids are mostly small so that equal-term and equal-node
+    /// collisions (where the interesting comparison rules live) are common;
+    /// occasionally full-range values cover boundaries.
+    #[hegel::composite]
+    fn small_or_any_u64(tc: hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(2),
+            generators::integers::<u64>(),
+        ))
+    }
+
+    /// A `Vote` as constructible through the public constructors
+    /// (`voted_for` is always `Some`).
+    #[hegel::composite]
+    fn arb_std_vote(tc: hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// A `Vote` over the full public field space: `LeaderId.voted_for` is
+    /// `pub` and `Option`, so `None` is publicly constructible (and reachable
+    /// through serde).
+    #[hegel::composite]
+    fn arb_std_vote_full(tc: hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let voted_for = tc.draw(generators::optional(small_or_any_u64()));
+        Vote {
+            leader_id: StdLeaderId { term, voted_for },
+            committed: tc.draw(generators::booleans()),
+        }
+    }
+
+    #[hegel::composite]
+    fn arb_adv_vote(tc: hegel::TestCase) -> Vote<AdvLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// `Vote<leader_id_adv>` is documented as totally ordered: term first,
+    /// then node id, and a committed vote is greater than a non-committed one.
+    /// Check against a lexicographic tuple oracle.
+    #[hegel::test]
+    fn hegel_adv_vote_order_matches_tuple_oracle(tc: hegel::TestCase) {
+        let a = tc.draw(arb_adv_vote());
+        let b = tc.draw(arb_adv_vote());
+
+        let key = |v: &Vote<AdvLeaderId>| (v.leader_id.term, v.leader_id.node_id, v.committed);
+
+        assert_eq!(Some(key(&a).cmp(&key(&b))), a.partial_cmp(&b));
+    }
+
+    /// `partial_cmp` must be a dual: comparing `(b, a)` yields the reverse of
+    /// comparing `(a, b)`, and `Some(Equal)` must coincide with `==`.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_duality(tc: hegel::TestCase) {
+        let a = tc.draw(arb_std_vote());
+        let b = tc.draw(arb_std_vote());
+
+        assert_eq!(a.partial_cmp(&b), b.partial_cmp(&a).map(Ordering::reverse));
+        assert_eq!(a == b, a.partial_cmp(&b) == Some(Ordering::Equal));
+    }
+
+    /// `partial_cmp` must be transitive: `a <= b` and `b <= c` imply `a <= c`.
+    /// This is required for `PartialOrd` and is what lets vote-granting
+    /// decisions chain safely.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_transitive(tc: hegel::TestCase) {
+        let a = tc.draw(arb_std_vote());
+        let b = tc.draw(arb_std_vote());
+        let c = tc.draw(arb_std_vote());
+
+        if a <= b && b <= c {
+            assert!(a <= c, "transitivity violated: {a} <= {b} <= {c} but not {a} <= {c}");
+        }
+        if a >= b && b >= c {
+            assert!(a >= c, "transitivity violated: {a} >= {b} >= {c} but not {a} >= {c}");
+        }
+    }
+
+    /// Comparing any two publicly-constructible votes must not panic, even
+    /// when `voted_for` is `None` (all `Vote` and `LeaderId` fields are `pub`,
+    /// and serde accepts `"voted_for": null`).
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_no_panic_on_full_domain(tc: hegel::TestCase) {
+        let a = tc.draw(arb_std_vote_full());
+        let b = tc.draw(arb_std_vote_full());
+
+        // KNOWN FAILURE exclusion: equal-term comparisons involving
+        // `voted_for: None` panic; that bug is pinned by
+        // `hegel_std_vote_partial_cmp_none_voted_for_panics` below. Skip the
+        // known-buggy input class so this property keeps checking the rest.
+        if a.leader_id.term == b.leader_id.term && (a.leader_id.voted_for.is_none() || b.leader_id.voted_for.is_none())
+        {
+            return;
+        }
+
+        let _ = a.partial_cmp(&b);
+    }
+
+    /// KNOWN FAILURE: comparing two `Vote<leader_id_std::LeaderId>` with equal
+    /// terms panics when either side has `voted_for: None`, because
+    /// `LeaderIdCompare::std` calls `RaftLeaderId::node_id()`, which is
+    /// `self.voted_for.as_ref().unwrap()` (leader_id_std.rs).
+    ///
+    /// `voted_for` is a `pub` field of type `Option<NID>`, `Display` renders
+    /// the `None` case, and the serde format accepts `"voted_for": null`, so
+    /// such votes are publicly constructible; `PartialOrd` must not panic on
+    /// them. Minimal counterexample: both sides
+    /// `Vote { leader_id: LeaderId { term: 0, voted_for: None }, committed: false }`.
+    ///
+    /// This test fails deterministically (every generated case hits the bug)
+    /// until the comparison handles `voted_for: None`.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_none_voted_for_panics(tc: hegel::TestCase) {
+        let term = tc.draw(small_or_any_u64());
+
+        // At least one side has `voted_for: None`; terms are equal so the
+        // node-id comparison is reached.
+        let voted_for_a = tc.draw(generators::optional(small_or_any_u64()));
+        let voted_for_b = if voted_for_a.is_some() {
+            None
+        } else {
+            tc.draw(generators::optional(small_or_any_u64()))
+        };
+
+        let a = Vote {
+            leader_id: StdLeaderId {
+                term,
+                voted_for: voted_for_a,
+            },
+            committed: tc.draw(generators::booleans()),
+        };
+        let b = Vote {
+            leader_id: StdLeaderId {
+                term,
+                voted_for: voted_for_b,
+            },
+            committed: tc.draw(generators::booleans()),
+        };
+
+        let _ = a.partial_cmp(&b);
+    }
+
+    /// Serde round-trip for both leader-id flavors of `Vote`.
+    #[cfg(feature = "serde")]
+    #[hegel::test]
+    fn hegel_vote_serde_roundtrip(tc: hegel::TestCase) {
+        let std_vote = tc.draw(arb_std_vote_full());
+        let s = serde_json::to_string(&std_vote).unwrap();
+        let back: Vote<StdLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(std_vote, back);
+
+        let adv_vote = tc.draw(arb_adv_vote());
+        let s = serde_json::to_string(&adv_vote).unwrap();
+        let back: Vote<AdvLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(adv_vote, back);
+    }
+}
