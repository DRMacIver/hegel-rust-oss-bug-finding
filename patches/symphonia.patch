+
+    use hegel::generators;
+
+    #[hegel::test]
+    fn hegel_buf_reader_matches_slice_oracle(tc: hegel::TestCase) {
+        // Model test: any schedule of ReadBytes operations must agree with reading the same
+        // little/big-endian values directly out of the underlying slice, must error (without
+        // moving the position) when insufficient bytes remain, and must track the position
+        // exactly.
+        let data: Vec<u8> = tc.draw(generators::binary());
+
+        let ops: Vec<(u8, u8)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<u8>().max_value(10),
+                generators::integers::<u8>().max_value(16),
+            ))
+            .max_size(24),
+        );
+
+        let mut reader = BufReader::new(&data);
+        let mut pos = 0usize;
+
+        for &(op, arg) in &ops {
+            let rem = data.len() - pos;
+
+            match op {
+                0 => {
+                    let r = reader.read_u8();
+                    if rem >= 1 {
+                        assert_eq!(r.unwrap(), data[pos]);
+                        pos += 1;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                1 => {
+                    let r = reader.read_u16();
+                    if rem >= 2 {
+                        let b: [u8; 2] = data[pos..pos + 2].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u16::from_le_bytes(b));
+                        pos += 2;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                2 => {
+                    let r = reader.read_be_u16();
+                    if rem >= 2 {
+                        let b: [u8; 2] = data[pos..pos + 2].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u16::from_be_bytes(b));
+                        pos += 2;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                3 => {
+                    let r = reader.read_u24();
+                    if rem >= 3 {
+                        let expected =
+                            u32::from_le_bytes([data[pos], data[pos + 1], data[pos + 2], 0]);
+                        assert_eq!(r.unwrap(), expected);
+                        pos += 3;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                4 => {
+                    let r = reader.read_be_u24();
+                    if rem >= 3 {
+                        let expected =
+                            u32::from_be_bytes([0, data[pos], data[pos + 1], data[pos + 2]]);
+                        assert_eq!(r.unwrap(), expected);
+                        pos += 3;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                5 => {
+                    let r = reader.read_u32();
+                    if rem >= 4 {
+                        let b: [u8; 4] = data[pos..pos + 4].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u32::from_le_bytes(b));
+                        pos += 4;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                6 => {
+                    let r = reader.read_be_u32();
+                    if rem >= 4 {
+                        let b: [u8; 4] = data[pos..pos + 4].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u32::from_be_bytes(b));
+                        pos += 4;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                7 => {
+                    let r = reader.read_u64();
+                    if rem >= 8 {
+                        let b: [u8; 8] = data[pos..pos + 8].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u64::from_le_bytes(b));
+                        pos += 8;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                8 => {
+                    let r = reader.read_be_u64();
+                    if rem >= 8 {
+                        let b: [u8; 8] = data[pos..pos + 8].try_into().unwrap();
+                        assert_eq!(r.unwrap(), u64::from_be_bytes(b));
+                        pos += 8;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                9 => {
+                    let n = usize::from(arg);
+                    let r = reader.ignore_bytes(n as u64);
+                    if rem >= n {
+                        assert!(r.is_ok());
+                        pos += n;
+                    }
+                    else {
+                        assert!(r.is_err());
+                    }
+                }
+                _ => {
+                    let n = usize::from(arg);
+                    let mut buf = vec![0u8; n];
+                    // read_buf reads up-to n bytes, so it never errors on underrun.
+                    let read = reader.read_buf(&mut buf).unwrap();
+                    assert_eq!(read, rem.min(n));
+                    assert_eq!(&buf[..read], &data[pos..pos + read]);
+                    pos += read;
+                }
+            }
+
+            assert_eq!(reader.pos(), pos as u64, "position after op ({}, {})", op, arg);
+        }
+    }
