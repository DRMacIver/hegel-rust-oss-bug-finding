--- a/symphonia-core/src/io/bit.rs
+++ b/symphonia-core/src/io/bit.rs
@@ -2094,4 +2094,440 @@ mod tests {
             assert_eq!(bs.buf.len(), 0);
         }
     }
+
+    // ------------------------------------------------------------------------------------------
+    // Property-based tests (hegel).
+    // ------------------------------------------------------------------------------------------
+
+    use hegel::generators;
+
+    use super::FiniteBitStream;
+    use super::vlc::Entry16x32;
+
+    /// Oracle: the bit sequence of `buf` in the order a `BitReaderLtr` reads it (MSb first within
+    /// each byte).
+    fn bits_ltr(buf: &[u8]) -> Vec<u8> {
+        buf.iter().flat_map(|&b| (0..8).rev().map(move |i| (b >> i) & 1)).collect()
+    }
+
+    /// Oracle: the bit sequence of `buf` in the order a `BitReaderRtl` reads it (LSb first within
+    /// each byte).
+    fn bits_rtl(buf: &[u8]) -> Vec<u8> {
+        buf.iter().flat_map(|&b| (0..8).map(move |i| (b >> i) & 1)).collect()
+    }
+
+    /// Oracle: the sequence of unary codes in `bits`, where each code is a run of `count_bit`s
+    /// terminated by the opposite bit. Trailing `count_bit`s without a terminator are not a code.
+    fn unary_oracle(bits: &[u8], count_bit: u8) -> Vec<u32> {
+        let mut vals = Vec::new();
+        let mut run = 0u32;
+        for &b in bits {
+            if b == count_bit {
+                run += 1;
+            }
+            else {
+                vals.push(run);
+                run = 0;
+            }
+        }
+        vals
+    }
+
+    #[hegel::test]
+    fn hegel_ltr_read_bit_matches_byte_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let mut bs = BitReaderLtr::new(&buf);
+
+        for (i, &bit) in bits_ltr(&buf).iter().enumerate() {
+            assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "bit index {}", i);
+        }
+
+        // Reading past the end must be a clean error, not a panic.
+        assert!(bs.read_bit().is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_rtl_read_bit_matches_byte_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let mut bs = BitReaderRtl::new(&buf);
+
+        for (i, &bit) in bits_rtl(&buf).iter().enumerate() {
+            assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "bit index {}", i);
+        }
+
+        // Reading past the end must be a clean error, not a panic.
+        assert!(bs.read_bit().is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_ltr_read_bits_matches_bit_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        // A bounded schedule of bit widths that is cycled while bits remain.
+        let widths: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>().max_value(64)).min_size(1).max_size(8),
+        );
+
+        let bits = bits_ltr(&buf);
+
+        let mut bs = BitReaderLtr::new(&buf);
+        let mut pos = 0;
+
+        // Cap iterations so an all-zero width schedule terminates.
+        let max_iters = widths.len() * (bits.len() + 1);
+
+        for i in 0..max_iters {
+            let w = widths[i % widths.len()] as usize;
+
+            if pos + w > bits.len() {
+                break;
+            }
+
+            // For Ltr the first bit read is the most-significant bit of the result.
+            let expected =
+                bits[pos..pos + w].iter().fold(0u64, |acc, &b| (acc << 1) | u64::from(b));
+
+            // Exercise both the leq32 and leq64 read paths.
+            let actual = if w <= 32 {
+                u64::from(bs.read_bits_leq32(w as u32).unwrap())
+            }
+            else {
+                bs.read_bits_leq64(w as u32).unwrap()
+            };
+
+            assert_eq!(actual, expected, "reading {} bits at bit position {}", w, pos);
+
+            pos += w;
+
+            assert_eq!(bs.bits_left(), (bits.len() - pos) as u64);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_rtl_read_bits_matches_bit_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        // A bounded schedule of bit widths that is cycled while bits remain.
+        let widths: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>().max_value(64)).min_size(1).max_size(8),
+        );
+
+        let bits = bits_rtl(&buf);
+
+        let mut bs = BitReaderRtl::new(&buf);
+        let mut pos = 0;
+
+        // Cap iterations so an all-zero width schedule terminates.
+        let max_iters = widths.len() * (bits.len() + 1);
+
+        for i in 0..max_iters {
+            let w = widths[i % widths.len()] as usize;
+
+            if pos + w > bits.len() {
+                break;
+            }
+
+            // For Rtl the first bit read is the least-significant bit of the result.
+            let expected = bits[pos..pos + w]
+                .iter()
+                .enumerate()
+                .fold(0u64, |acc, (k, &b)| acc | (u64::from(b) << k));
+
+            // Exercise both the leq32 and leq64 read paths.
+            let actual = if w <= 32 {
+                u64::from(bs.read_bits_leq32(w as u32).unwrap())
+            }
+            else {
+                bs.read_bits_leq64(w as u32).unwrap()
+            };
+
+            assert_eq!(actual, expected, "reading {} bits at bit position {}", w, pos);
+
+            pos += w;
+
+            assert_eq!(bs.bits_left(), (bits.len() - pos) as u64);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_ignore_bits_equals_reading_bits(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let total = 8 * buf.len() as u32;
+        let n = tc.draw(generators::integers::<u32>().max_value(total));
+
+        // After ignoring n bits the remaining bit sequence must be the oracle tail.
+        let bits = bits_ltr(&buf);
+        let mut bs = BitReaderLtr::new(&buf);
+        bs.ignore_bits(n).unwrap();
+        for (i, &bit) in bits[n as usize..].iter().enumerate() {
+            assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "ltr bit {} after ignoring {}", i, n);
+        }
+
+        let bits = bits_rtl(&buf);
+        let mut bs = BitReaderRtl::new(&buf);
+        bs.ignore_bits(n).unwrap();
+        for (i, &bit) in bits[n as usize..].iter().enumerate() {
+            assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "rtl bit {} after ignoring {}", i, n);
+        }
+
+        // Ignoring more bits than the stream holds must error.
+        let extra = tc.draw(generators::integers::<u32>().min_value(1).max_value(1 << 20));
+        assert!(BitReaderLtr::new(&buf).ignore_bits(total + extra).is_err());
+        assert!(BitReaderRtl::new(&buf).ignore_bits(total + extra).is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_read_unary_zeros_matches_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let mut bs = BitReaderLtr::new(&buf);
+        for (i, &v) in unary_oracle(&bits_ltr(&buf), 0).iter().enumerate() {
+            assert_eq!(bs.read_unary_zeros().unwrap(), v, "ltr code {}", i);
+        }
+        // The remaining bits (if any) have no terminator, so the next read must error.
+        assert!(bs.read_unary_zeros().is_err());
+
+        let mut bs = BitReaderRtl::new(&buf);
+        for (i, &v) in unary_oracle(&bits_rtl(&buf), 0).iter().enumerate() {
+            assert_eq!(bs.read_unary_zeros().unwrap(), v, "rtl code {}", i);
+        }
+        assert!(bs.read_unary_zeros().is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_read_unary_ones_matches_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let mut bs = BitReaderLtr::new(&buf);
+        for (i, &v) in unary_oracle(&bits_ltr(&buf), 1).iter().enumerate() {
+            assert_eq!(bs.read_unary_ones().unwrap(), v, "ltr code {}", i);
+        }
+        // The remaining bits (if any) have no terminator, so the next read must error.
+        assert!(bs.read_unary_ones().is_err());
+
+        let mut bs = BitReaderRtl::new(&buf);
+        for (i, &v) in unary_oracle(&bits_rtl(&buf), 1).iter().enumerate() {
+            assert_eq!(bs.read_unary_ones().unwrap(), v, "rtl code {}", i);
+        }
+        assert!(bs.read_unary_ones().is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_read_unary_capped_matches_oracle(tc: hegel::TestCase) {
+        let buf: Vec<u8> = tc.draw(generators::binary());
+        let limit = tc.draw(generators::integers::<u32>().max_value(600));
+
+        // The value returned by a capped unary read is the length of the leading run capped to
+        // the limit. If the run was capped, exactly `limit` bits are consumed; otherwise the run
+        // and its terminator are consumed. If the (uncapped) run reaches the end of the stream,
+        // the read must error.
+        macro_rules! check_capped_unary {
+            ($reader:expr, $method:ident, $bits:expr, $target:literal) => {{
+                let bits = $bits;
+                let lead = bits.iter().take_while(|&&b| b == $target).count();
+                let mut bs = $reader;
+                let res = bs.$method(limit);
+
+                if lead as u32 >= limit {
+                    assert_eq!(res.unwrap(), limit);
+                    for (i, &bit) in bits[limit as usize..].iter().enumerate() {
+                        assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "bit {} after cap", i);
+                    }
+                }
+                else if lead < bits.len() {
+                    assert_eq!(res.unwrap(), lead as u32);
+                    for (i, &bit) in bits[lead + 1..].iter().enumerate() {
+                        assert_eq!(bs.read_bit().unwrap(), u32::from(bit), "bit {} after code", i);
+                    }
+                }
+                else {
+                    assert!(res.is_err());
+                }
+            }};
+        }
+
+        check_capped_unary!(BitReaderLtr::new(&buf), read_unary_zeros_capped, bits_ltr(&buf), 0);
+        check_capped_unary!(BitReaderLtr::new(&buf), read_unary_ones_capped, bits_ltr(&buf), 1);
+        check_capped_unary!(BitReaderRtl::new(&buf), read_unary_zeros_capped, bits_rtl(&buf), 0);
+        check_capped_unary!(BitReaderRtl::new(&buf), read_unary_ones_capped, bits_rtl(&buf), 1);
+    }
+
+    #[hegel::test]
+    fn hegel_arbitrary_ops_never_panic(tc: hegel::TestCase) {
+        // Any sequence of read operations on any buffer, including reads far past the end of the
+        // stream, must return errors rather than panic.
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let ops: Vec<(u8, u32)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<u8>().max_value(11),
+                generators::integers::<u32>().max_value(1 << 16),
+            ))
+            .max_size(32),
+        );
+
+        let mut ltr = BitReaderLtr::new(&buf);
+        let mut rtl = BitReaderRtl::new(&buf);
+
+        for &(op, arg) in &ops {
+            match op {
+                0 => {
+                    let _ = ltr.read_bit();
+                    let _ = rtl.read_bit();
+                }
+                1 => {
+                    let _ = ltr.read_bool();
+                    let _ = rtl.read_bool();
+                }
+                2 => {
+                    let _ = ltr.read_bits_leq32(arg % 33);
+                    let _ = rtl.read_bits_leq32(arg % 33);
+                }
+                3 => {
+                    let _ = ltr.read_bits_leq64(arg % 65);
+                    let _ = rtl.read_bits_leq64(arg % 65);
+                }
+                4 => {
+                    let _ = ltr.read_bits_leq32_signed(arg % 33);
+                    let _ = rtl.read_bits_leq32_signed(arg % 33);
+                }
+                5 => {
+                    let _ = ltr.read_bits_leq64_signed(arg % 65);
+                    let _ = rtl.read_bits_leq64_signed(arg % 65);
+                }
+                6 => {
+                    let _ = ltr.ignore_bits(arg);
+                    let _ = rtl.ignore_bits(arg);
+                }
+                7 => {
+                    let _ = ltr.read_unary_zeros();
+                    let _ = rtl.read_unary_zeros();
+                }
+                8 => {
+                    let _ = ltr.read_unary_ones();
+                    let _ = rtl.read_unary_ones();
+                }
+                9 => {
+                    let _ = ltr.read_unary_zeros_capped(arg);
+                    let _ = rtl.read_unary_zeros_capped(arg);
+                }
+                10 => {
+                    let _ = ltr.read_unary_ones_capped(arg);
+                    let _ = rtl.read_unary_ones_capped(arg);
+                }
+                _ => {
+                    ltr.realign();
+                    rtl.realign();
+                }
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_codebook_roundtrip(tc: hegel::TestCase) {
+        // Decoding an encoded symbol stream through a codebook must return the original symbols,
+        // for a randomly generated complete prefix code, in both bit orders, and for any
+        // bits-per-read configuration.
+
+        // Generate a random complete prefix code by repeatedly splitting leaves. Since at least
+        // one split occurs, no codeword is zero-length.
+        let num_splits = tc.draw(generators::integers::<u8>().min_value(1).max_value(48));
+
+        let mut leaves: Vec<(u32, u8)> = vec![(0, 0)];
+
+        for _ in 0..num_splits {
+            let idx = tc.draw(generators::integers::<usize>().max_value(leaves.len() - 1));
+
+            let (code, len) = leaves[idx];
+
+            // Keep codewords to a testable length.
+            if len >= 14 {
+                continue;
+            }
+
+            leaves.swap_remove(idx);
+            leaves.push((code << 1, len + 1));
+            leaves.push(((code << 1) | 1, len + 1));
+        }
+
+        let codes: Vec<u32> = leaves.iter().map(|&(c, _)| c).collect();
+        let code_lens: Vec<u8> = leaves.iter().map(|&(_, l)| l).collect();
+        let values: Vec<u16> = (0..leaves.len() as u16).collect();
+
+        // Generate the configuration too, not just the payload.
+        let bits_per_read = tc.draw(generators::integers::<u8>().min_value(1).max_value(16));
+
+        // Draw a symbol sequence and encode it MSb-first.
+        let seq: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(leaves.len() - 1))
+                .max_size(24),
+        );
+
+        let mut bitvec: Vec<u8> = Vec::new();
+
+        for &s in &seq {
+            let (code, len) = leaves[s];
+            for k in (0..len).rev() {
+                bitvec.push(((code >> k) & 1) as u8);
+            }
+        }
+
+        // Pack MSb-first, padding the final byte with zeros.
+        let mut data = vec![0u8; bitvec.len().div_ceil(8)];
+        for (i, &b) in bitvec.iter().enumerate() {
+            data[i / 8] |= b << (7 - (i % 8));
+        }
+
+        // Verbatim bit order read MSb-first.
+        let codebook = CodebookBuilder::new(BitOrder::Verbatim)
+            .bits_per_read(bits_per_read)
+            .make::<Entry16x32>(&codes, &code_lens, &values)
+            .unwrap();
+
+        let mut bs = BitReaderLtr::new(&data);
+
+        for (i, &s) in seq.iter().enumerate() {
+            let (value, code_len) = bs.read_codebook(&codebook).unwrap();
+            assert_eq!(value, s as u16, "ltr symbol {}", i);
+            assert_eq!(code_len, u32::from(leaves[s].1), "ltr code length of symbol {}", i);
+        }
+
+        // Reverse bit order read LSb-first. Reversing the bits of each byte preserves the bit
+        // sequence in read order.
+        let codebook = CodebookBuilder::new(BitOrder::Reverse)
+            .bits_per_read(bits_per_read)
+            .make::<Entry16x32>(&codes, &code_lens, &values)
+            .unwrap();
+
+        let rdata: Vec<u8> = data.iter().map(|&b| b.reverse_bits()).collect();
+
+        let mut bs = BitReaderRtl::new(&rdata);
+
+        for (i, &s) in seq.iter().enumerate() {
+            let (value, code_len) = bs.read_codebook(&codebook).unwrap();
+            assert_eq!(value, s as u16, "rtl symbol {}", i);
+            assert_eq!(code_len, u32::from(leaves[s].1), "rtl code length of symbol {}", i);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_read_codebook_arbitrary_data_consumes_all_bytes(tc: hegel::TestCase) {
+        // Hegel-driven version of fuzz_bitstreamltr_read_codebook/fuzz_bitstreamrtl_read_codebook
+        // above: decoding arbitrary bytes until an error must consume the entire buffer and must
+        // never panic.
+        let buf: Vec<u8> = tc.draw(generators::binary());
+
+        let (codebook, _, _) = generate_codebook(BitOrder::Verbatim);
+        let mut bs = BitReaderLtr::new(&buf);
+        while bs.read_codebook(&codebook).is_ok() {}
+        assert_eq!(bs.buf.len(), 0);
+
+        let (codebook, _, _) = generate_codebook(BitOrder::Reverse);
+        let mut bs = BitReaderRtl::new(&buf);
+        while bs.read_codebook(&codebook).is_ok() {}
+        assert_eq!(bs.buf.len(), 0);
+    }
 }
