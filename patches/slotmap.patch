+        #[hegel::test]
+        fn hegel_key_ffi_roundtrip(tc: hegel::TestCase) {
+            let (_, live, stale) = churned_map(&tc);
+            for k in live.into_iter().chain(stale).chain([DefaultKey::null()]) {
+                let kd = k.data();
+                assert_eq!(KeyData::from_ffi(kd.as_ffi()), kd);
+                let k2: DefaultKey = KeyData::from_ffi(kd.as_ffi()).into();
+                assert_eq!(k2, k);
+            }
+        }
