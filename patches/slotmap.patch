+        fn hegel_keydata_deserialize_normalizes(tc: hegel::TestCase) {
+            let idx = tc.draw(generators::integers::<u32>());
+            let version = tc.draw(generators::integers::<u32>());
+            let json = format!(r#"{{"idx":{},"version":{}}}"#, idx, version);
+            let kd: KeyData = serde_json::from_str(&json).unwrap();
