+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+#[cfg(target_endian = "little")]
+mod hegel_props {
+    use super::common::{draw_dims, draw_pixels, hash};
+    use hegel::generators::{self, Generator};
+    use libqoi::qoi_decode;
+    use qoi::consts::{
+        QOI_OP_DIFF, QOI_OP_INDEX, QOI_OP_LUMA, QOI_OP_RGB, QOI_OP_RGBA, QOI_OP_RUN, QOI_PADDING,
+    };
+    use qoi::{decode_to_vec, Channels, ColorSpace, Encoder, Header};
+
+    /// QOI is lossless: encode -> decode is the identity on the pixel buffer,
+    /// and the header roundtrips the full configuration (dimensions, both
+    /// channel counts, both colorspaces).
+    #[hegel::test]
+    fn prop_encode_decode_roundtrip(tc: hegel::TestCase) {
+        let channels = tc.draw(generators::sampled_from(vec![Channels::Rgb, Channels::Rgba]));
+        let colorspace =
+            tc.draw(generators::sampled_from(vec![ColorSpace::Srgb, ColorSpace::Linear]));
+        let (width, height) = draw_dims(&tc, 2048);
+        let pixels = draw_pixels(&tc, (width * height) as usize, channels.as_u8() as usize);
+
+        let encoder = Encoder::new(&pixels, width, height).unwrap().with_colorspace(colorspace);
+        assert_eq!(encoder.channels(), channels);
+        let encoded = encoder.encode_to_vec().unwrap();
+
+        let (header, decoded) = decode_to_vec(&encoded).unwrap();
+        assert_eq!((header.width, header.height), (width, height));
+        assert_eq!(header.channels, channels);
+        assert_eq!(header.colorspace, colorspace);
+        assert_eq!(decoded, pixels, "pixel buffer not bit-exact after roundtrip");
+    }
+
+    /// The reference C implementation (qoi.h) decodes qoi-rust's output back
+    /// to the original pixels: our encoder emits spec-conformant streams.
+    #[hegel::test]
+    fn prop_c_reference_decodes_our_encoding(tc: hegel::TestCase) {
+        let channels = tc.draw(generators::sampled_from(vec![3_u8, 4]));
+        let (width, height) = draw_dims(&tc, 2048);
+        let pixels = draw_pixels(&tc, (width * height) as usize, channels as usize);
+
+        let encoded = qoi::encode_to_vec(&pixels, width, height).unwrap();
+        let (desc, decoded_c) = qoi_decode(&encoded, channels).unwrap();
+        assert_eq!((desc.width, desc.height), (width, height));
+        assert_eq!(desc.channels, channels);
+        assert_eq!(decoded_c.as_ref(), pixels.as_slice());
+    }
+
+    /// Draw an arbitrary syntactically-valid QOI chunk stream (ops only, no
+    /// header/padding) producing exactly the returned number of pixels. This
+    /// covers op interleavings a conformant encoder would never emit
+    /// (INDEX-after-RUN, self-referential INDEX, no-op DIFFs, ...).
+    ///
+    /// The generator simulates the spec (qoi.h) decoder to track the color
+    /// index table state as the stream grows.
+    ///
+    /// Restrictions, each excluding inputs pinned as known bugs by the
+    /// KNOWN FAILURE tests below:
+    /// - QOI_OP_INDEX chunks only reference table slots that have been
+    ///   written. Referencing an uninitialized slot is well-defined per the
+    ///   spec (zero-initialized table) but qoi-rust diverges from qoi.h on
+    ///   it, for two independent reasons: qoi.h re-registers the fetched
+    ///   pixel in the table (a no-op except for uninitialized slots, whose
+    ///   zero value is not stored at its own hash position) while qoi-rust
+    ///   never writes the table on INDEX chunks -- see
+    ///   `prop_decode_uninit_index_slot_diverges_from_c_reference`; and in
+    ///   3-channel mode the fetched alpha=0 enters qoi.h's hash state, which
+    ///   qoi-rust's `Pixel<3>` decoder cannot represent -- see
+    ///   `prop_decode_3ch_uninit_index_diverges_from_c_reference`.
+    /// - No QOI_OP_RGBA chunks in streams whose header declares 3 channels:
+    ///   qoi-rust's `decode_impl_slice::<3, false>` does not process them at
+    ///   all, while qoi.h decodes them regardless of the declared channel
+    ///   count (the spec calls the header field purely informative).
+    fn draw_op_stream(tc: &hegel::TestCase, channels: u8) -> (Vec<u8>, usize) {
+        let allow_rgba_ops = channels == 4;
+        let target = tc.draw(generators::integers::<usize>().min_value(1).max_value(400));
+        let mut ops = Vec::new();
+        let mut n_pixels = 0_usize;
+        // spec-decoder simulation state (qoi.h semantics)
+        let mut px: [u8; 4] = [0, 0, 0, 255];
+        let mut table: [[u8; 4]; 64] = [[0; 4]; 64];
+        let mut written_slots: Vec<u8> = Vec::new();
+        while n_pixels < target {
+            let max_kind = if allow_rgba_ops { 5 } else { 4 };
+            let mut kind = tc.draw_silent(generators::integers::<u8>().max_value(max_kind));
+            if kind == 0 && written_slots.is_empty() {
+                kind = 4; // no written slot to reference yet; emit RGB instead
+            }
+            match kind {
+                0 => {
+                    let i = tc.draw_silent(
+                        generators::integers::<usize>().max_value(written_slots.len() - 1),
+                    );
+                    let slot = written_slots[i];
+                    ops.push(QOI_OP_INDEX | slot);
+                    px = table[slot as usize];
+                    n_pixels += 1;
+                }
+                1 => {
+                    // run lengths 1..=62 (biased encoding: 0x00 -> run of 1)
+                    let r = tc.draw_silent(generators::integers::<u8>().max_value(61));
+                    ops.push(QOI_OP_RUN | r);
+                    n_pixels += r as usize + 1;
+                }
+                2 => {
+                    let d = tc.draw_silent(generators::integers::<u8>().max_value(63));
+                    ops.push(QOI_OP_DIFF | d);
+                    px[0] = px[0].wrapping_add((d >> 4) & 0x03).wrapping_sub(2);
+                    px[1] = px[1].wrapping_add((d >> 2) & 0x03).wrapping_sub(2);
+                    px[2] = px[2].wrapping_add(d & 0x03).wrapping_sub(2);
+                    n_pixels += 1;
+                }
+                3 => {
+                    let b1 = tc.draw_silent(generators::integers::<u8>().max_value(63));
+                    let b2 = tc.draw_silent(generators::integers::<u8>());
+                    ops.push(QOI_OP_LUMA | b1);
+                    ops.push(b2);
+                    let vg = b1.wrapping_sub(32);
+                    let vg_8 = vg.wrapping_sub(8);
+                    px[0] = px[0].wrapping_add(vg_8.wrapping_add((b2 >> 4) & 0x0f));
+                    px[1] = px[1].wrapping_add(vg);
+                    px[2] = px[2].wrapping_add(vg_8.wrapping_add(b2 & 0x0f));
+                    n_pixels += 1;
+                }
+                4 => {
+                    ops.push(QOI_OP_RGB);
+                    for c in 0..3 {
+                        px[c] = tc.draw_silent(generators::integers::<u8>());
+                        ops.push(px[c]);
+                    }
+                    n_pixels += 1;
+                }
+                _ => {
+                    ops.push(QOI_OP_RGBA);
+                    for c in 0..4 {
+                        px[c] = tc.draw_silent(generators::integers::<u8>());
+                        ops.push(px[c]);
+                    }
+                    n_pixels += 1;
+                }
+            }
+            // qoi.h writes index[hash(px)] = px after every chunk
+            let h = hash(px);
+            table[h as usize] = px;
+            if !written_slots.contains(&h) {
+                written_slots.push(h);
+            }
+        }
+        (ops, n_pixels)
+    }
+
+    /// Differential test of the decoder against the reference C decoder on
+    /// arbitrary valid chunk streams (not just encoder outputs).
+    #[hegel::test]
+    fn prop_decode_arbitrary_streams_matches_c_reference(tc: hegel::TestCase) {
+        let channels = tc.draw(generators::sampled_from(vec![3_u8, 4]));
+        let (ops, n_pixels) = draw_op_stream(&tc, channels);
+
+        let header = Header::try_new(
+            n_pixels as u32,
+            1,
+            Channels::try_from(channels).unwrap(),
+            ColorSpace::Srgb,
+        )
+        .unwrap();
+        let mut data = header.encode().to_vec();
+        data.extend_from_slice(&ops);
+        data.extend_from_slice(&QOI_PADDING);
+
+        let (hdr, out_rust) = decode_to_vec(&data).unwrap();
+        assert_eq!(hdr, header);
+        let (desc, out_c) = qoi_decode(&data, channels).unwrap();
+        assert_eq!((desc.width as usize, desc.height), (n_pixels, 1));
+        assert_eq!(out_rust.as_slice(), out_c.as_ref());
+    }
+
+    /// KNOWN FAILURE (real bug, do not "fix" the test): on a valid 3-channel
+    /// stream, qoi-rust's decoder diverges from the reference C decoder
+    /// (qoi.h) once a QOI_OP_INDEX chunk references an uninitialized index
+    /// slot. The spec zero-initializes the table, so such a reference is
+    /// well-defined and yields {0,0,0,0} -- alpha 0. qoi.h carries that alpha
+    /// into subsequent index-hash computations, but qoi-rust's 3-channel
+    /// decoder (`decode_impl_slice::<3, false>`, src/decode.rs) tracks pixels
+    /// as `Pixel<3>` and hashes via `as_rgba(0xff)`, so later QOI_OP_INDEX
+    /// chunks resolve to different slots than the spec prescribes. Same root
+    /// cause as `prop_decode_rgba_as_rgb_drops_alpha` in tests/test_misc.rs:
+    /// the 3-channel decode paths discard alpha state.
+    ///
+    /// The op stream [INDEX(i), DIFF(d), INDEX(hash(px, alpha=0))] is built
+    /// directly so the test fails deterministically on every case.
+    #[hegel::test]
+    fn prop_decode_3ch_uninit_index_diverges_from_c_reference(tc: hegel::TestCase) {
+        let i = tc.draw(generators::integers::<u8>().max_value(63));
+        // d != 0b101010 so the DIFF produces a pixel with RGB != (0,0,0)
+        let d = tc.draw(generators::integers::<u8>().max_value(63).filter(|&d| d != 0b10_1010));
+        let px = [
+            ((d >> 4) & 0x03).wrapping_sub(2),
+            ((d >> 2) & 0x03).wrapping_sub(2),
+            (d & 0x03).wrapping_sub(2),
+            0, // alpha inherited from the uninitialized index entry
+        ];
+        let ops = [QOI_OP_INDEX | i, QOI_OP_DIFF | d, QOI_OP_INDEX | hash(px)];
+
+        let header = Header::try_new(3, 1, Channels::Rgb, ColorSpace::Srgb).unwrap();
+        let mut data = header.encode().to_vec();
+        data.extend_from_slice(&ops);
+        data.extend_from_slice(&QOI_PADDING);
+
+        let (_, out_rust) = decode_to_vec(&data).unwrap();
+        let (_, out_c) = qoi_decode(&data, 3).unwrap();
+        assert_eq!(out_rust.as_slice(), out_c.as_ref());
+    }
+
+    /// KNOWN FAILURE (real bug, do not "fix" the test): the alpha-independent
+    /// half of the uninitialized-index divergence, on a 4-channel stream.
+    ///
+    /// The reference decoder re-registers every decoded pixel in the color
+    /// index, *including* pixels produced by QOI_OP_INDEX chunks. That write
+    /// is a no-op when the referenced slot was previously written (table
+    /// entries sit at their own hash position), but a reference to an
+    /// uninitialized slot yields {0,0,0,0}, whose hash position is slot 0 --
+    /// qoi.h then stores {0,0,0,0} into slot 0, clobbering whatever was
+    /// there. qoi-rust's decoders never write the index on QOI_OP_INDEX
+    /// chunks (`decode_impl_slice`'s INDEX arm `continue`s), so a later
+    /// QOI_OP_INDEX(0) chunk reads different values.
+    ///
+    /// Ops: [RGBA(0,0,0,a) with hash 0, INDEX(j) uninitialized, INDEX(0)];
+    /// constructed directly so the test fails deterministically on every
+    /// case.
+    #[hegel::test]
+    fn prop_decode_uninit_index_slot_diverges_from_c_reference(tc: hegel::TestCase) {
+        // hash4(0,0,0,a) = 11a mod 64 = 0 for these; pixel != (0,0,0,0)
+        let a = tc.draw(generators::sampled_from(vec![64_u8, 128, 192]));
+        // slot j stays uninitialized: the only written slot is 0
+        let j = tc.draw(generators::integers::<u8>().min_value(1).max_value(63));
+        let ops = [QOI_OP_RGBA, 0, 0, 0, a, QOI_OP_INDEX | j, QOI_OP_INDEX | 0];
+
+        let header = Header::try_new(3, 1, Channels::Rgba, ColorSpace::Srgb).unwrap();
+        let mut data = header.encode().to_vec();
+        data.extend_from_slice(&ops);
+        data.extend_from_slice(&QOI_PADDING);
+
+        let (_, out_rust) = decode_to_vec(&data).unwrap();
+        let (_, out_c) = qoi_decode(&data, 4).unwrap();
+        assert_eq!(out_rust.as_slice(), out_c.as_ref());
+    }
+}
