+#[allow(unused)]
+use hegel::generators::{self, Generator};
+
+/// Draw image dimensions with `width * height <= max_pixels` (and both >= 1).
+///
+/// The bound protects the *test's* time/memory budget, not the library's
+/// contract (which allows up to 400Mp); boundary-sized headers are covered
+/// separately by the header property tests.
+#[allow(unused)]
+pub fn draw_dims(tc: &hegel::TestCase, max_pixels: u32) -> (u32, u32) {
+    let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(max_pixels));
+    let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(max_pixels / width));
+    (width, height)
+}
+
+/// Draw a raw pixel buffer of exactly `n_pixels` pixels with `channels` (3 or 4)
+/// bytes per pixel, structured so that all QOI chunk types get exercised:
+///
+/// - fresh random pixels        -> QOI_OP_RGB / QOI_OP_RGBA
+/// - runs of identical pixels   -> QOI_OP_RUN (lengths cross the 62/124 limits)
+/// - small per-channel deltas   -> QOI_OP_DIFF
+/// - luma-style deltas          -> QOI_OP_LUMA
+/// - revisiting earlier pixels  -> QOI_OP_INDEX
+/// - alpha-only changes (4ch)   -> QOI_OP_RGBA with equal RGB
+///
+/// Individual draws are silent to keep counterexample output readable; the
+/// assembled buffer is what failing assertions display.
+#[allow(unused)]
+pub fn draw_pixels(tc: &hegel::TestCase, n_pixels: usize, channels: usize) -> Vec<u8> {
+    assert!(channels == 3 || channels == 4);
+    let mut px: [u8; 4] = [0, 0, 0, 0xff];
+    let mut seen: Vec<[u8; 4]> = Vec::new();
+    let mut out: Vec<u8> = Vec::with_capacity(n_pixels * channels);
+    let mut n = 0_usize;
+    let max_kind = if channels == 4 { 5 } else { 4 };
+    while n < n_pixels {
+        let mut reps = 1_usize;
+        match tc.draw_silent(generators::integers::<u8>().max_value(max_kind)) {
+            0 => {
+                // fresh pixel
+                px[0] = tc.draw_silent(generators::integers::<u8>());
+                px[1] = tc.draw_silent(generators::integers::<u8>());
+                px[2] = tc.draw_silent(generators::integers::<u8>());
+                if channels == 4 {
+                    px[3] = tc.draw_silent(generators::integers::<u8>());
+                }
+            }
+            1 => {
+                // run of identical pixels; 70 > 62 so run-splitting is exercised
+                reps = tc.draw_silent(
+                    generators::integers::<usize>().min_value(1).max_value(70),
+                );
+            }
+            2 => {
+                // small diff (each channel -2..=1, the QOI_OP_DIFF range)
+                for c in px.iter_mut().take(3) {
+                    let d = tc.draw_silent(generators::integers::<u8>().max_value(3));
+                    *c = c.wrapping_add(d).wrapping_sub(2);
+                }
+            }
+            3 => {
+                // luma-style diff (dg in -32..=31, dr/db in dg-8..=dg+7)
+                let dg = tc.draw_silent(generators::integers::<u8>().max_value(63)).wrapping_sub(32);
+                let dr =
+                    tc.draw_silent(generators::integers::<u8>().max_value(15)).wrapping_sub(8).wrapping_add(dg);
+                let db =
+                    tc.draw_silent(generators::integers::<u8>().max_value(15)).wrapping_sub(8).wrapping_add(dg);
+                px[0] = px[0].wrapping_add(dr);
+                px[1] = px[1].wrapping_add(dg);
+                px[2] = px[2].wrapping_add(db);
+            }
+            4 => {
+                // revisit a previously seen pixel (palette-like repetition)
+                if !seen.is_empty() {
+                    let i = tc.draw_silent(
+                        generators::integers::<usize>().max_value(seen.len() - 1),
+                    );
+                    px = seen[i];
+                }
+            }
+            _ => {
+                // alpha-only change (4-channel images only)
+                px[3] = tc.draw_silent(generators::integers::<u8>());
+            }
+        }
+        seen.push(px);
+        for _ in 0..reps.min(n_pixels - n) {
+            out.extend_from_slice(&px[..channels]);
+            n += 1;
+        }
+    }
+    out
+}
