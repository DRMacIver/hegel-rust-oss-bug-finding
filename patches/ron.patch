diff --git a/tests/escape.rs b/tests/escape.rs
index 876ecd0..0208060 100644
--- a/tests/escape.rs
+++ b/tests/escape.rs
@@ -98,3 +98,83 @@ fn test_nul_in_string() {
     check_same("Hello\x00World!".to_owned());
     check_same("Hello\u{0}World!".to_owned());
 }
+
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use ron::{de::from_str, ser::to_string};
+
+    /// Characters at the boundary of the serializer's escape set:
+    /// `serialize_escaped_str` escapes via `char::escape_debug` (quotes,
+    /// backslashes, controls, and non-printable/grapheme-extending unicode),
+    /// and `serialize_char` escapes only `'` and `\`. Bugs live just inside
+    /// and just outside those sets.
+    fn draw_boundary_char(tc: &hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                '"', '\'', '\\', '\n', '\r', '\t', '\0', '\x07', '\x08', '\x0b', '\x0c',
+                '\x1b', '\x1f', ' ', '\x7f', '\u{80}', '\u{85}', '\u{a0}', '\u{ad}',
+                '\u{200e}', '\u{2028}', '\u{2029}', '\u{301}', '\u{feff}', '\u{fffd}',
+                '\u{e000}', '\u{d7ff}', '\u{10ffff}', '#', '/', '*', 'r', 'b',
+            ]),
+            generators::integers::<u32>()
+                .max_value(0x10_FFFF)
+                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        ))
+    }
+
+    /// Strings built from escape-set-boundary characters must roundtrip
+    /// through escaped serialization.
+    #[hegel::test]
+    fn prop_string_escape_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(12));
+        let s: String = (0..n).map(|_| draw_boundary_char(&tc)).collect();
+
+        let ron = to_string(&s).unwrap();
+        assert_eq!(
+            from_str::<String>(&ron).as_ref(),
+            Ok(&s),
+            "string {s:?} did not roundtrip via {ron:?}"
+        );
+    }
+
+    /// Every char must roundtrip through char-literal serialization.
+    #[hegel::test]
+    fn prop_char_escape_roundtrip(tc: hegel::TestCase) {
+        let c = draw_boundary_char(&tc);
+
+        let ron = to_string(&c).unwrap();
+        assert_eq!(
+            from_str::<char>(&ron),
+            Ok(c),
+            "char {c:?} did not roundtrip via {ron:?}"
+        );
+    }
+
+    /// With `escape_strings(false)` the serializer falls back to raw strings
+    /// (`r#"..."#`) whenever the string contains `"` or `\`, choosing the
+    /// number of hash marks from the longest `#` run in the content. Strings
+    /// made of quotes, hashes, backslashes, and line breaks target exactly
+    /// that delimiter-selection boundary.
+    #[hegel::test]
+    fn prop_unescaped_raw_string_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(12));
+        let s: String = (0..n)
+            .map(|_| {
+                tc.draw(hegel::one_of!(
+                    generators::sampled_from(vec!['"', '#', '\\', '\n', '\r', '\t', 'a', ' ']),
+                    generators::integers::<u32>()
+                        .max_value(0x10_FFFF)
+                        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+                ))
+            })
+            .collect();
+
+        let config = ron::ser::PrettyConfig::new().escape_strings(false);
+        let ron = ron::ser::to_string_pretty(&s, config).unwrap();
+        assert_eq!(
+            from_str::<String>(&ron).as_ref(),
+            Ok(&s),
+            "string {s:?} did not roundtrip unescaped via {ron:?}"
+        );
+    }
+}
