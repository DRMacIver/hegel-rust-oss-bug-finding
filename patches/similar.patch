+#[cfg(test)]
+pub(crate) mod pbt_support {
+    //! Shared helpers for the hegel property-based tests in this crate.
+    use alloc::vec::Vec;
+
+    use hegel::generators;
+
+    use crate::{Algorithm, DiffOp};
+
+    pub(crate) const ALL_ALGORITHMS: [Algorithm; 5] = [
+        Algorithm::Myers,
+        Algorithm::Patience,
+        Algorithm::Lcs,
+        Algorithm::Hunt,
+        Algorithm::Histogram,
+    ];
+
+    /// Draws a pair of sequences over a small alphabet so that real matches
+    /// occur.  `b` is either drawn independently or produced as an edited
+    /// copy of `a` (random deletions/insertions/substitutions) so that the
+    /// diffs are non-trivial.  Sequences are sometimes long (>100 elements)
+    /// to exercise the `IdentifyDistinct` path used by `TextDiff` and the
+    /// deep recursion paths of the algorithms.
+    pub(crate) fn draw_seq_pair(tc: &hegel::TestCase) -> (Vec<u8>, Vec<u8>) {
+        let alphabet_max = tc.draw(generators::integers::<u8>().max_value(4));
+        let long = tc.draw(generators::booleans());
+        let max_len = if long { 140 } else { 24 };
+        let a: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(alphabet_max))
+                .max_size(max_len),
+        );
+        let b = if tc.draw(generators::booleans()) {
+            tc.draw(
+                generators::vecs(generators::integers::<u8>().max_value(alphabet_max))
+                    .max_size(max_len),
+            )
+        } else {
+            draw_edited_copy(tc, &a, alphabet_max)
+        };
+        (a, b)
+    }
+
+    /// Applies a small number of drawn edits (delete/insert/substitute) to a
+    /// copy of `a`.
+    fn draw_edited_copy(tc: &hegel::TestCase, a: &[u8], alphabet_max: u8) -> Vec<u8> {
+        let mut b = a.to_vec();
+        let edits = tc.draw(generators::integers::<usize>().max_value(8));
+        for _ in 0..edits {
+            match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 if !b.is_empty() => {
+                    let i = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+                    b.remove(i);
+                }
+                1 => {
+                    let i = tc.draw(generators::integers::<usize>().max_value(b.len()));
+                    let v = tc.draw(generators::integers::<u8>().max_value(alphabet_max));
+                    b.insert(i, v);
+                }
+                2 if !b.is_empty() => {
+                    let i = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+                    b[i] = tc.draw(generators::integers::<u8>().max_value(alphabet_max));
+                }
+                _ => {}
+            }
+        }
+        b
+    }
+
+    /// Reconstructs `b` by applying `ops` to `a`, walking the
+    /// Equal/Delete/Insert/Replace ops in order.  Equal content is looked up
+    /// in `a` (that is what makes the roundtrip meaningful); inserted content
+    /// is looked up in `b` because the ops only carry indices, exactly like a
+    /// patch consumer would.
+    pub(crate) fn apply_ops(ops: &[DiffOp], a: &[u8], b: &[u8]) -> Vec<u8> {
+        let mut out = Vec::new();
+        for op in ops {
+            match *op {
+                DiffOp::Equal { old_index, len, .. } => {
+                    out.extend_from_slice(&a[old_index..old_index + len]);
+                }
+                DiffOp::Delete { .. } => {}
+                DiffOp::Insert {
+                    new_index, new_len, ..
+                }
+                | DiffOp::Replace {
+                    new_index, new_len, ..
+                } => {
+                    out.extend_from_slice(&b[new_index..new_index + new_len]);
+                }
+            }
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod pbt {
+    use alloc::vec::Vec;
+
+    use hegel::generators;
+
+    use super::pbt_support::{ALL_ALGORITHMS, apply_ops, draw_seq_pair};
+    use super::*;
+    use crate::DiffTag;
+
+    /// Crown property: diffing `a` against `b` and then applying the
+    /// resulting ops to `a` must reconstruct `b` exactly, for every
+    /// algorithm.  Evidence: this is the core contract of a diff (the crate
+    /// docs describe ops as "ranges of the differences by index in the
+    /// source sequence" that expand to the changes between the sequences).
+    #[hegel::test]
+    fn hegel_capture_diff_apply_roundtrip(tc: hegel::TestCase) {
+        let (a, b) = draw_seq_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            let ops = capture_diff_slices(alg, &a, &b);
+            let reconstructed = apply_ops(&ops, &a, &b);
+            assert_eq!(
+                reconstructed, b,
+                "{alg:?} ops failed to reconstruct b\na={a:?}\nb={b:?}\nops={ops:?}"
+            );
+        }
+    }
+
+    /// Op-sequence well-formedness: the captured ops partition both inputs.
+    /// Old ranges tile `0..a.len()` and new ranges tile `0..b.len()`, in
+    /// order, with no gaps or overlaps.  Evidence: the unit tests
+    /// `test_compact_keeps_diffop_cursors_contiguous` and
+    /// `test_regression_issue_95` assert exactly this contract on fixed
+    /// inputs, and `UnifiedHunkHeader` relies on it.
+    #[hegel::test]
+    fn hegel_ops_partition_both_inputs(tc: hegel::TestCase) {
+        let (a, b) = draw_seq_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            let ops = capture_diff_slices(alg, &a, &b);
+            let mut old_cursor = 0;
+            let mut new_cursor = 0;
+            for op in &ops {
+                assert_eq!(
+                    op.old_range().start,
+                    old_cursor,
+                    "{alg:?}: old range gap/overlap at {op:?}\na={a:?}\nb={b:?}\nops={ops:?}"
+                );
+                assert_eq!(
+                    op.new_range().start,
+                    new_cursor,
+                    "{alg:?}: new range gap/overlap at {op:?}\na={a:?}\nb={b:?}\nops={ops:?}"
+                );
+                old_cursor = op.old_range().end;
+                new_cursor = op.new_range().end;
+            }
+            assert_eq!(old_cursor, a.len(), "{alg:?}: ops do not cover all of a");
+            assert_eq!(new_cursor, b.len(), "{alg:?}: ops do not cover all of b");
+        }
+    }
+
+    /// Equal ops must reference slices that are actually equal, and no op
+    /// may be completely empty (`Compact`/`Replace` are documented to clean
+    /// up the raw hook output; an empty op encodes nothing).  Evidence:
+    /// `DiffOp::as_tag_tuple` docs say `Equal`: `a[i1..i2]` is equal to
+    /// `b[j1..j2]`; `test_regression_issue_95` asserts the same.
+    #[hegel::test]
+    fn hegel_equal_ops_reference_equal_slices(tc: hegel::TestCase) {
+        let (a, b) = draw_seq_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            // KNOWN BUG exclusion: Lcs and Hunt emit a spurious empty Delete
+            // op for two empty inputs, pinned by
+            // `hegel_known_failure_lcs_hunt_empty_inputs_spurious_delete`.
+            if matches!(alg, Algorithm::Lcs | Algorithm::Hunt) && a.is_empty() && b.is_empty() {
+                continue;
+            }
+            let ops = capture_diff_slices(alg, &a, &b);
+            for op in &ops {
+                if let DiffOp::Equal {
+                    old_index,
+                    new_index,
+                    len,
+                } = *op
+                {
+                    assert_eq!(
+                        &a[old_index..old_index + len],
+                        &b[new_index..new_index + len],
+                        "{alg:?}: Equal op names unequal slices: {op:?}\na={a:?}\nb={b:?}"
+                    );
+                }
+                assert!(
+                    !(op.old_range().is_empty() && op.new_range().is_empty()),
+                    "{alg:?}: fully empty op {op:?}\na={a:?}\nb={b:?}\nops={ops:?}"
+                );
+            }
+        }
+    }
+
+    /// Diffing a sequence with itself yields only Equal ops and a ratio of
+    /// exactly 1.0, for every algorithm.  Uses the full u8 range: identity
+    /// must hold regardless of alphabet.
+    #[hegel::test]
+    fn hegel_self_diff_is_all_equal(tc: hegel::TestCase) {
+        let long = tc.draw(generators::booleans());
+        let max_len = if long { 140 } else { 24 };
+        let a: Vec<u8> =
+            tc.draw(generators::vecs(generators::integers::<u8>()).max_size(max_len));
+        for alg in ALL_ALGORITHMS {
+            // KNOWN BUG exclusion: Lcs and Hunt emit a spurious empty Delete
+            // op for two empty inputs, pinned by
+            // `hegel_known_failure_lcs_hunt_empty_inputs_spurious_delete`.
+            if matches!(alg, Algorithm::Lcs | Algorithm::Hunt) && a.is_empty() {
+                continue;
+            }
+            let ops = capture_diff_slices(alg, &a, &a);
+            assert!(
+                ops.iter().all(|op| op.tag() == DiffTag::Equal),
+                "{alg:?}: self-diff produced non-Equal ops: {ops:?}\na={a:?}"
+            );
+            assert_eq!(
+                diff_ratio(&ops, a.len(), a.len()),
+                1.0,
+                "{alg:?}: self-diff ratio != 1.0\na={a:?}\nops={ops:?}"
+            );
+        }
+    }
+
+    /// KNOWN FAILURE: `Algorithm::Lcs` and `Algorithm::Hunt` on two empty
+    /// ranges emit a spurious zero-length
+    /// `Delete { old_index: 0, old_len: 0, new_index: 0 }` op instead of no
+    /// ops (Myers, Patience and Histogram return `[]`).  Root cause:
+    /// `lcs::diff_deadline_impl` and `hunt::diff_deadline_impl` check
+    /// `is_empty_range(&new_range)` first and unconditionally emit a delete
+    /// of the (empty) old range; `myers.rs:925` and `histogram.rs:192` have
+    /// the missing both-empty guard.  This also makes
+    /// `utils::diff_chars(Algorithm::Lcs, "", "")` panic, see
+    /// `utils::pbt::hegel_known_failure_lcs_hunt_empty_diff_chars_panics`.
+    /// Deterministic pin for the bug found by
+    /// `hegel_self_diff_is_all_equal` / `hegel_equal_ops_reference_equal_slices`.
+    #[test]
+    fn hegel_known_failure_lcs_hunt_empty_inputs_spurious_delete() {
+        let empty: [u8; 0] = [];
+        let offenders: Vec<(Algorithm, Vec<DiffOp>)> = ALL_ALGORITHMS
+            .into_iter()
+            .map(|alg| (alg, capture_diff_slices(alg, &empty, &empty)))
+            .filter(|(_, ops)| !ops.is_empty())
+            .collect();
+        assert_eq!(
+            offenders,
+            alloc::vec![],
+            "these algorithms emitted ops for two empty inputs"
+        );
+    }
+
+    /// Grouping ops for context display must preserve every change: the
+    /// non-Equal ops of the groups are exactly the non-Equal ops of the
+    /// original op sequence (in order), and replaying the groups over `a`
+    /// (copying the elided equal gaps from `a`) reconstructs `b`.
+    /// Evidence: `group_diff_ops` docs ("Isolate change clusters by
+    /// eliminating ranges with no changes") and its use by unified diffs.
+    #[hegel::test]
+    fn hegel_grouped_ops_preserve_changes(tc: hegel::TestCase) {
+        let (a, b) = draw_seq_pair(&tc);
+        let n = tc.draw(generators::integers::<usize>().max_value(5));
+        for alg in ALL_ALGORITHMS {
+            let ops = capture_diff_slices(alg, &a, &b);
+            let groups = group_diff_ops(ops.clone(), n);
+
+            let grouped_changes: Vec<DiffOp> = groups
+                .iter()
+                .flatten()
+                .filter(|op| op.tag() != DiffTag::Equal)
+                .copied()
+                .collect();
+            let original_changes: Vec<DiffOp> = ops
+                .iter()
+                .filter(|op| op.tag() != DiffTag::Equal)
+                .copied()
+                .collect();
+            assert_eq!(
+                grouped_changes, original_changes,
+                "{alg:?} n={n}: grouping altered the change ops\nops={ops:?}\ngroups={groups:?}"
+            );
+
+            // Replay the grouped ops over `a`, copying the gaps between
+            // groups (which grouping promises are all-equal ranges) from `a`.
+            let mut out: Vec<u8> = Vec::new();
+            let mut old_cursor = 0;
+            for group in &groups {
+                let first = group.first().expect("grouped_ops produced an empty group");
+                let start = first.old_range().start;
+                assert!(
+                    start >= old_cursor,
+                    "{alg:?} n={n}: group starts before previous group ended\ngroups={groups:?}"
+                );
+                out.extend_from_slice(&a[old_cursor..start]);
+                out.extend_from_slice(&apply_ops(group, &a, &b));
+                old_cursor = group.last().unwrap().old_range().end;
+            }
+            assert!(old_cursor <= a.len());
+            out.extend_from_slice(&a[old_cursor..]);
+            assert_eq!(
+                out, b,
+                "{alg:?} n={n}: replaying grouped ops failed to reconstruct b\na={a:?}\nb={b:?}\ngroups={groups:?}"
+            );
