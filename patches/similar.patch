+#[cfg(test)]
+mod pbt {
+    use alloc::string::String;
+    use alloc::vec::Vec;
+
+    use hegel::generators;
+
+    use super::unified_diff;
+    use crate::common::pbt_support::ALL_ALGORITHMS;
+    use crate::text::pbt::draw_line_text_pair;
+
+    /// Parses the old-side range of a hunk header line (without trailing
+    /// newline) like `@@ -3,2 +4 @@` and returns the 0-based start line of
+    /// the old range.  Follows the unified diff format: ranges are
+    /// `start,len` with 1-based starts, a plain `start` means `len == 1`,
+    /// and an empty range (`len == 0`) names the line *before* the range.
+    fn parse_old_start(header: &str) -> usize {
+        let rest = header
+            .strip_prefix("@@ -")
+            .unwrap_or_else(|| panic!("malformed hunk header: {header:?}"));
+        let old_part = rest.split(' ').next().unwrap();
+        match old_part.split_once(',') {
+            Some((start, len)) => {
+                let start: usize = start.parse().expect("bad old start");
+                let len: usize = len.parse().expect("bad old len");
+                if len == 0 { start } else { start - 1 }
+            }
+            None => old_part.parse::<usize>().expect("bad old start") - 1,
+        }
+    }
+
+    /// Minimal unified-diff applier used as an oracle: reconstructs the new
+    /// text from the old text plus the textual patch, implementing the
+    /// unified diff format as specified (hunk headers, ' '/'-'/'+' lines,
+    /// `\ No newline at end of file` hints).  Inputs must not contain
+    /// lone-`\r` line endings (the generator guarantees this) so that
+    /// patch lines can be split on `\n`.
+    fn apply_unified_patch(patch: &str, old: &str) -> String {
+        let old_lines: Vec<&str> = old.split_inclusive('\n').collect();
+        let mut out = String::new();
+        let mut cursor = 0usize;
+        let mut lines = patch.split_inclusive('\n').peekable();
+
+        fn consume_no_newline_hint<'a>(
+            lines: &mut core::iter::Peekable<impl Iterator<Item = &'a str>>,
+        ) -> bool {
+            if lines.peek().is_some_and(|l| l.starts_with('\\')) {
+                lines.next();
+                true
+            } else {
+                false
+            }
+        }
+
+        while let Some(line) = lines.next() {
+            let line_no_nl = line.strip_suffix('\n').unwrap_or(line);
+            if line.starts_with("@@ ") {
+                let start = parse_old_start(line_no_nl);
+                assert!(
+                    start >= cursor,
+                    "hunks out of order or overlapping: hunk starts at old line {start}, cursor already at {cursor}\npatch:\n{patch}"
+                );
+                while cursor < start {
+                    out.push_str(old_lines[cursor]);
+                    cursor += 1;
+                }
+            } else if let Some(content) = line.strip_prefix('+') {
+                let mut value = String::from(content);
+                if consume_no_newline_hint(&mut lines) {
+                    assert!(value.ends_with('\n'), "hint after newline-terminated line");
+                    value.pop();
+                }
+                out.push_str(&value);
+            } else if line.starts_with('-') {
+                consume_no_newline_hint(&mut lines);
+                cursor += 1;
+            } else if line.starts_with(' ') {
+                consume_no_newline_hint(&mut lines);
+                out.push_str(old_lines[cursor]);
+                cursor += 1;
+            } else {
+                panic!("unexpected patch line {line:?}\npatch:\n{patch}");
+            }
+        }
+        while cursor < old_lines.len() {
+            out.push_str(old_lines[cursor]);
+            cursor += 1;
+        }
+        out
+    }
+
+    /// Unified-diff apply roundtrip: rendering a unified diff of `a` -> `b`
+    /// and applying the textual patch to `a` with an independent applier
+    /// reconstructs `b` exactly, for every algorithm and context radius.
+    /// This exercises diffing, `grouped_ops`, hunk-header arithmetic and
+    /// the missing-newline handling end to end.  Evidence: this is the
+    /// documented purpose of the module ("This module provides unified
+    /// diff functionality") and the format spec linked from
+    /// `UnifiedDiff::header`.
+    #[hegel::test]
+    fn hegel_unified_diff_apply_roundtrip(tc: hegel::TestCase) {
+        let (a, b) = draw_line_text_pair(&tc);
+        let radius = tc.draw(generators::integers::<usize>().max_value(4));
+        for alg in ALL_ALGORITHMS {
+            let patch = unified_diff(alg, &a, &b, radius, None);
+            let applied = apply_unified_patch(&patch, &a);
+            assert_eq!(
+                applied, b,
+                "{alg:?} radius={radius}: applying the patch to old did not produce new\nold={a:?}\nnew={b:?}\npatch:\n{patch}"
+            );
+        }
+    }
+}
