+
+    /// A single line including its terminator, over a small body alphabet
+    /// (so line diffs get real matches) with `\n` and `\r\n` terminators.
+    /// Lone `\r` is deliberately never produced: values are reused verbatim
+    /// in unified diff output, and a lone-`\r` "line" would not be
+    /// parseable as a text patch line (see the udiff pbt tests).
+    #[hegel::composite]
+    fn terminated_line(tc: hegel::TestCase) -> String {
+        let body = tc.draw(generators::sampled_from(vec!["a", "b", "c", "dd", ""]));
+        let term = tc.draw(generators::sampled_from(vec!["\n", "\r\n"]));
+        let mut line = String::from(body);
+        line.push_str(term);
+        line
+    }
+
+    fn draw_lines(tc: &hegel::TestCase) -> Vec<String> {
+        let mut lines: Vec<String> = tc.draw(generators::vecs(terminated_line()).max_size(25));
+        // Sometimes drop the final newline so the text is not
+        // newline-terminated (exercises the missing-newline handling).
+        if tc.draw(generators::booleans())
+            && let Some(last) = lines.last_mut()
+        {
+            while last.ends_with(['\r', '\n']) {
+                last.pop();
+            }
+        }
+        lines
+    }
+
+    /// Line-structured text pair; `b` is either independent or an edited
+    /// copy of `a` (line deletions/insertions/substitutions) so the diffs
+    /// are non-trivial.
+    pub(crate) fn draw_line_text_pair(tc: &hegel::TestCase) -> (String, String) {
+        let a_lines = draw_lines(tc);
+        let b_lines = if tc.draw(generators::booleans()) {
+            draw_lines(tc)
+        } else {
+            let mut b = a_lines.clone();
+            let edits = tc.draw(generators::integers::<usize>().max_value(6));
+            for _ in 0..edits {
+                match tc.draw(generators::integers::<u8>().max_value(2)) {
+                    0 if !b.is_empty() => {
+                        let i = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+                        b.remove(i);
+                    }
+                    1 => {
+                        let i = tc.draw(generators::integers::<usize>().max_value(b.len()));
+                        b.insert(i, tc.draw(terminated_line()));
+                    }
+                    2 if !b.is_empty() => {
+                        let i = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+                        b[i] = tc.draw(terminated_line());
+                    }
+                    _ => {}
+                }
+            }
+            b
+        };
+        (a_lines.concat(), b_lines.concat())
+    }
+
+    /// Text pair: fully independent full-Unicode strings, the same string
+    /// twice (fires the equal/ratio==1 branches), or line-structured text
+    /// over a small alphabet.
+    pub(crate) fn draw_text_pair(tc: &hegel::TestCase) -> (String, String) {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => (
+                tc.draw(generators::text().max_size(30)),
+                tc.draw(generators::text().max_size(30)),
+            ),
+            1 => {
+                let a = tc.draw(generators::text().max_size(30));
+                (a.clone(), a)
+            }
+            _ => draw_line_text_pair(tc),
+        }
+    }
+
+    /// `TextDiff::ratio` stays within `0..=1` and is exactly `1.0` iff the
+    /// inputs are equal.  Evidence: `ratio` docs ("A ratio of 1.0 means the
+    /// two sequences are a complete match, a ratio of 0.0 would indicate
+    /// completely distinct sequences").  Token counts here are far below
+    /// 2^24, so the f32 comparison with 1.0 is exact.
+    #[hegel::test]
+    fn hegel_ratio_bounds_and_equality(tc: hegel::TestCase) {
+        let (a, b) = draw_text_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            let diff = TextDiff::configure()
+                .algorithm(alg)
+                .diff_chars(a.as_str(), b.as_str());
+            let ratio = diff.ratio();
+            assert!(
+                (0.0..=1.0).contains(&ratio),
+                "{alg:?}: ratio {ratio} out of bounds for {a:?} vs {b:?}"
+            );
+            if a == b {
+                assert_eq!(ratio, 1.0, "{alg:?}: equal inputs {a:?} but ratio {ratio}");
+            } else {
+                assert_ne!(ratio, 1.0, "{alg:?}: unequal inputs {a:?} vs {b:?} but ratio 1.0");
+            }
+        }
+    }
+
+    /// Concatenating the Equal+Delete change values of a text diff yields
+    /// the old input and Equal+Insert yields the new input, for every
+    /// tokenization mode and algorithm.  This is the text-level
+    /// diff-then-apply roundtrip; it also checks that the tokenizers
+    /// partition their input.  Uses full-Unicode text as well as
+    /// line-structured text.
+    #[hegel::test]
+    fn hegel_textdiff_changes_reconstruct_inputs(tc: hegel::TestCase) {
+        let (a, b) = draw_text_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            let mut config = TextDiff::configure();
+            let config = config.algorithm(alg);
+            for (mode, diff) in [
+                ("lines", config.diff_lines(a.as_str(), b.as_str())),
+                ("words", config.diff_words(a.as_str(), b.as_str())),
+                ("chars", config.diff_chars(a.as_str(), b.as_str())),
+            ] {
+                let mut old_out = String::new();
+                let mut new_out = String::new();
+                for change in diff.iter_all_changes() {
+                    match change.tag() {
+                        ChangeTag::Equal => {
+                            old_out.push_str(change.value());
+                            new_out.push_str(change.value());
+                        }
+                        ChangeTag::Delete => old_out.push_str(change.value()),
+                        ChangeTag::Insert => new_out.push_str(change.value()),
+                    }
+                }
+                assert_eq!(
+                    old_out, a,
+                    "{alg:?}/{mode}: Equal+Delete changes do not reconstruct old input\nb={b:?}"
+                );
+                assert_eq!(
+                    new_out, b,
+                    "{alg:?}/{mode}: Equal+Insert changes do not reconstruct new input\na={a:?}"
+                );
+            }
+        }
+    }
+
+    /// The changes yielded by `iter_all_changes` carry consistent indices:
+    /// old indices walk `0..old_len()` and new indices walk `0..new_len()`
+    /// in order, each index is present according to the tag, and the change
+    /// value equals the token at that index.  Evidence: `Change` docs and
+    /// the `iter_changes` doc examples.
+    #[hegel::test]
+    fn hegel_iter_changes_index_consistency(tc: hegel::TestCase) {
+        let (a, b) = draw_text_pair(&tc);
+        for alg in ALL_ALGORITHMS {
+            let diff = TextDiff::configure()
+                .algorithm(alg)
+                .diff_lines(a.as_str(), b.as_str());
+            let mut next_old = 0;
+            let mut next_new = 0;
+            for change in diff.iter_all_changes() {
+                let ctx = || {
+                    alloc::format!("{alg:?}: change {change:?} (a={a:?}, b={b:?})")
+                };
+                match change.tag() {
+                    ChangeTag::Equal => {
+                        assert_eq!(change.old_index(), Some(next_old), "{}", ctx());
+                        assert_eq!(change.new_index(), Some(next_new), "{}", ctx());
+                        assert_eq!(diff.old_slice(next_old), Some(change.value()), "{}", ctx());
+                        assert_eq!(diff.new_slice(next_new), Some(change.value()), "{}", ctx());
+                        next_old += 1;
+                        next_new += 1;
+                    }
+                    ChangeTag::Delete => {
+                        assert_eq!(change.old_index(), Some(next_old), "{}", ctx());
+                        assert_eq!(change.new_index(), None, "{}", ctx());
+                        assert_eq!(diff.old_slice(next_old), Some(change.value()), "{}", ctx());
+                        next_old += 1;
+                    }
+                    ChangeTag::Insert => {
+                        assert_eq!(change.old_index(), None, "{}", ctx());
+                        assert_eq!(change.new_index(), Some(next_new), "{}", ctx());
+                        assert_eq!(diff.new_slice(next_new), Some(change.value()), "{}", ctx());
+                        next_new += 1;
+                    }
+                }
+            }
+            assert_eq!(next_old, diff.old_len(), "{alg:?}: not all old tokens visited");
+            assert_eq!(next_new, diff.new_len(), "{alg:?}: not all new tokens visited");
+        }
+    }
