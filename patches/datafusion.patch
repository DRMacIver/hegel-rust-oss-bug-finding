diff --git a/datafusion/common/src/rounding.rs b/datafusion/common/src/rounding.rs
index 1796143..f4bfbbb 100644
--- a/datafusion/common/src/rounding.rs
+++ b/datafusion/common/src/rounding.rs
@@ -432,4 +432,133 @@ mod tests {
         let result = next_down(value);
         assert_eq!(result, -0.0);
     }
+
+    // ----------------------------------------------------------------------
+    // hegel property-based tests
+    // ----------------------------------------------------------------------
+
+    use hegel::generators as hg;
+    use std::cmp::Ordering;
+
+    /// Draws an f64 from raw bits, boosting the boundary bit patterns where
+    /// the interesting behavior lives (zeros, tiniest subnormals, infinities,
+    /// NaN, largest finite values).
+    fn draw_f64_bits(tc: &hegel::TestCase) -> f64 {
+        f64::from_bits(tc.draw(hegel::one_of!(
+            hg::integers::<u64>(),
+            hg::sampled_from(vec![
+                0u64,                  // +0.0
+                1,                     // smallest positive subnormal
+                0x8000_0000_0000_0000, // -0.0
+                0x8000_0000_0000_0001, // smallest (magnitude) negative
+                f64::INFINITY.to_bits(),
+                f64::INFINITY.to_bits() - 1, // f64::MAX
+                f64::NEG_INFINITY.to_bits(),
+                f64::NEG_INFINITY.to_bits() - 1, // f64::MIN
+                f64::NAN.to_bits(),
+            ]),
+        )))
+    }
+
+    /// f32 analogue of [`draw_f64_bits`].
+    fn draw_f32_bits(tc: &hegel::TestCase) -> f32 {
+        f32::from_bits(tc.draw(hegel::one_of!(
+            hg::integers::<u32>(),
+            hg::sampled_from(vec![
+                0u32,
+                1,
+                0x8000_0000,
+                0x8000_0001,
+                f32::INFINITY.to_bits(),
+                f32::INFINITY.to_bits() - 1,
+                f32::NEG_INFINITY.to_bits(),
+                f32::NEG_INFINITY.to_bits() - 1,
+                f32::NAN.to_bits(),
+            ]),
+        )))
+    }
+
+    /// Property: `next_up`/`next_down` agree bit-for-bit with the std library
+    /// `f64::next_up`/`f64::next_down` (and the f32 versions), except at
+    /// ±0.0, where this implementation deliberately steps through the signed
+    /// zeros one at a time (`-0.0 -> +0.0 -> TINY`, mirrored for
+    /// `next_down`), which the unit tests above pin.
+    #[hegel::test]
+    fn prop_next_up_next_down_match_std(tc: hegel::TestCase) {
+        fn check64(x: f64) {
+            if x.is_nan() {
+                assert!(next_up(x).is_nan());
+                assert!(next_down(x).is_nan());
+            } else if x == 0.0 {
+                if x.to_bits() == (-0.0f64).to_bits() {
+                    assert_eq!(next_up(x).to_bits(), (0.0f64).to_bits());
+                    assert_eq!(
+                        next_down(x).to_bits(),
+                        f64::from_bits(0x8000_0000_0000_0001).to_bits()
+                    );
+                } else {
+                    assert_eq!(next_up(x).to_bits(), f64::from_bits(0x1).to_bits());
+                    assert_eq!(next_down(x).to_bits(), (-0.0f64).to_bits());
+                }
+            } else {
+                assert_eq!(next_up(x).to_bits(), x.next_up().to_bits());
+                assert_eq!(next_down(x).to_bits(), x.next_down().to_bits());
+            }
+        }
+        fn check32(x: f32) {
+            if x.is_nan() {
+                assert!(next_up(x).is_nan());
+                assert!(next_down(x).is_nan());
+            } else if x == 0.0 {
+                if x.to_bits() == (-0.0f32).to_bits() {
+                    assert_eq!(next_up(x).to_bits(), (0.0f32).to_bits());
+                    assert_eq!(
+                        next_down(x).to_bits(),
+                        f32::from_bits(0x8000_0001).to_bits()
+                    );
+                } else {
+                    assert_eq!(next_up(x).to_bits(), f32::from_bits(0x1).to_bits());
+                    assert_eq!(next_down(x).to_bits(), (-0.0f32).to_bits());
+                }
+            } else {
+                assert_eq!(next_up(x).to_bits(), x.next_up().to_bits());
+                assert_eq!(next_down(x).to_bits(), x.next_down().to_bits());
+            }
+        }
+        check64(draw_f64_bits(&tc));
+        check32(draw_f32_bits(&tc));
+    }
+
+    /// Property: on non-NaN input, `next_up` is the strict successor in the
+    /// IEEE total order (`total_cmp`) and `next_down` its exact inverse, and
+    /// vice versa — so `next_down(next_up(x))` returns `x` bit-for-bit.
+    #[hegel::test]
+    fn prop_next_up_next_down_are_inverses(tc: hegel::TestCase) {
+        let x64 = draw_f64_bits(&tc);
+        if !x64.is_nan() {
+            if x64 != f64::INFINITY {
+                let up = next_up(x64);
+                assert_eq!(up.total_cmp(&x64), Ordering::Greater);
+                assert_eq!(next_down(up).to_bits(), x64.to_bits());
+            }
+            if x64 != f64::NEG_INFINITY {
+                let down = next_down(x64);
+                assert_eq!(down.total_cmp(&x64), Ordering::Less);
+                assert_eq!(next_up(down).to_bits(), x64.to_bits());
+            }
+        }
+        let x32 = draw_f32_bits(&tc);
+        if !x32.is_nan() {
+            if x32 != f32::INFINITY {
+                let up = next_up(x32);
+                assert_eq!(up.total_cmp(&x32), Ordering::Greater);
+                assert_eq!(next_down(up).to_bits(), x32.to_bits());
+            }
+            if x32 != f32::NEG_INFINITY {
+                let down = next_down(x32);
+                assert_eq!(down.total_cmp(&x32), Ordering::Less);
+                assert_eq!(next_up(down).to_bits(), x32.to_bits());
+            }
+        }
+    }
 }
