+            33 => {
+                let value = if is_null {
+                    None
+                } else {
+                    let months = tc.draw(hg::integers::<i32>());
+                    let days = tc.draw(hg::integers::<i32>());
+                    let nanoseconds = tc.draw(hg::integers::<i64>());
+                    Some(IntervalMonthDayNano::new(months, days, nanoseconds))
+                };
