index 79aebe6..c2b5a4d 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -464,4 +464,251 @@ mod tests {
         println!("{}", DecodeError::InvalidLength);
         println!("{}", DecodeError::InvalidChar);
     }
+
+    // -----------------------------------------------------------------
+    // Property-based tests (hegel)
+    // -----------------------------------------------------------------
+
+    use hegel::generators::{self, Generator as _};
+
+    /// Bytes that are valid Crockford base32 input for this crate (the
+    /// uppercase alphabet plus its lowercase aliases). Written out
+    /// independently of the crate's LOOKUP table so it can act as an oracle.
+    fn is_crockford_byte(b: u8) -> bool {
+        b"0123456789ABCDEFGHJKMNPQRSTVWXYZ".contains(&b.to_ascii_uppercase())
+    }
+
+    /// Draw a 26-character Crockford base32 string. The first character's
+    /// alphabet index is drawn from `first_min..=first_max` (index 7 is '7',
+    /// the highest first char of any encoded u128), the remaining 25 from the
+    /// full alphabet, with random per-character lowercasing (decoding is
+    /// case-insensitive).
+    fn draw_ulid_string(tc: &hegel::TestCase, first_min: usize, first_max: usize) -> String {
+        const ALPHABET: &[u8; 32] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+        let first = tc.draw(
+            generators::integers::<usize>()
+                .min_value(first_min)
+                .max_value(first_max),
+        );
+        let rest: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(31))
+                .min_size(ULID_LEN - 1)
+                .max_size(ULID_LEN - 1),
+        );
+        let lower_mask: u32 = tc.draw(generators::integers::<u32>());
+        let mut s = String::with_capacity(ULID_LEN);
+        for (i, idx) in core::iter::once(first).chain(rest).enumerate() {
+            let mut b = ALPHABET[idx];
+            if lower_mask >> (i % 32) & 1 == 1 {
+                b = b.to_ascii_lowercase(); // digits are unaffected
+            }
+            s.push(b as char);
+        }
+        s
+    }
+
+    /// Crown roundtrip: any u128 encodes to a 26-char string which parses
+    /// back to the same Ulid via every parsing entry point, including the
+    /// lowercase form (Crockford base32 decoding is case-insensitive).
+    #[hegel::test]
+    fn prop_string_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u128>());
+        let ulid = Ulid(n);
+        let s = ulid.to_string();
+        assert_eq!(s.len(), ULID_LEN);
+        // the fast inherent to_string and the Display impl must agree
+        assert_eq!(s, format!("{}", ulid));
+        assert_eq!(Ulid::from_string(&s), Ok(ulid));
+        assert_eq!(Ulid::from_str(&s), Ok(ulid));
+        assert_eq!(Ulid::try_from(s.as_str()), Ok(ulid));
+        assert_eq!(Ulid::from_string(&s.to_lowercase()), Ok(ulid));
+    }
+
+    /// u128, big-endian bytes, and (u64, u64) conversions are all bijective
+    /// views of the same 128 bits (std's to_be_bytes/shifts as the oracle).
+    #[hegel::test]
+    fn prop_integer_conversions_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u128>());
+        let ulid = Ulid::from(n);
+        assert_eq!(ulid.0, n);
+        assert_eq!(u128::from(ulid), n);
+        assert_eq!(ulid.to_bytes(), n.to_be_bytes());
+        assert_eq!(Ulid::from_bytes(n.to_be_bytes()), ulid);
+        assert_eq!(<[u8; 16]>::from(ulid), n.to_be_bytes());
+        assert_eq!(Ulid::from(n.to_be_bytes()), ulid);
+        let (msb, lsb): (u64, u64) = ulid.into();
+        assert_eq!(msb, (n >> 64) as u64);
+        assert_eq!(lsb, n as u64);
+        assert_eq!(Ulid::from((msb, lsb)), ulid);
+    }
+
+    /// `from_parts` keeps exactly the low 48 timestamp bits and low 80 random
+    /// bits ("Any overflow bits in the given args are discarded"), and
+    /// `timestamp_ms`/`random` recover them. For in-width inputs the masks
+    /// are identities, so this subsumes the exact roundtrip.
+    #[hegel::test]
+    fn prop_from_parts_roundtrip(tc: hegel::TestCase) {
+        const TIME_MASK: u64 = bitmask!(Ulid::TIME_BITS);
+        const RAND_MASK: u128 = bitmask!(Ulid::RAND_BITS);
+        // boost in-width values so the exact-roundtrip case is well covered
+        let ts = tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(TIME_MASK),
+            generators::integers::<u64>(),
+        ));
+        let random = tc.draw(hegel::one_of!(
+            generators::integers::<u128>().max_value(RAND_MASK),
+            generators::integers::<u128>(),
+        ));
+        let ulid = Ulid::from_parts(ts, random);
+        assert_eq!(ulid.timestamp_ms(), ts & TIME_MASK);
+        assert_eq!(ulid.random(), random & RAND_MASK);
+    }
+
+    /// Strings whose length is not exactly 26 are rejected with
+    /// InvalidLength, even when every character is valid Crockford base32.
+    #[hegel::test]
+    fn prop_from_string_rejects_wrong_length(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u128>());
+        let s = Ulid(n).to_string();
+        let len = tc.draw(
+            generators::integers::<usize>()
+                .max_value(2 * ULID_LEN)
+                .filter(|&l| l != ULID_LEN),
+        );
+        let mutated = if len <= ULID_LEN {
+            s[..len].to_string() // safe: encoded strings are ASCII
+        } else {
+            let mut m = s;
+            while m.len() < len {
+                m.push('0');
+            }
+            m
+        };
+        assert_eq!(Ulid::from_string(&mutated), Err(DecodeError::InvalidLength));
+    }
+
+    /// Corrupting one character of a valid encoding with a non-Crockford
+    /// ASCII byte (boosting the deliberately excluded letters I, L, O, U) is
+    /// rejected with InvalidChar.
+    #[hegel::test]
+    fn prop_from_string_rejects_invalid_char(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u128>());
+        let mut buf = [0u8; ULID_LEN];
+        Ulid(n).array_to_str(&mut buf);
+        let pos = tc.draw(generators::integers::<usize>().max_value(ULID_LEN - 1));
+        let bad = tc.draw(hegel::one_of!(
+            // Crockford base32 deliberately excludes these letters
+            generators::sampled_from(vec![b'I', b'L', b'O', b'U', b'i', b'l', b'o', b'u']),
+            generators::integers::<u8>()
+                .max_value(0x7F)
+                .filter(|b| !is_crockford_byte(*b)),
+        ));
+        buf[pos] = bad;
+        let s = core::str::from_utf8(&buf).unwrap();
+        assert_eq!(Ulid::from_string(s), Err(DecodeError::InvalidChar));
+    }
+
+    /// `from_string` returns (never panics) on arbitrary text.
+    #[hegel::test]
+    fn prop_from_string_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let _ = Ulid::from_string(&s);
+        let _ = s.parse::<Ulid>();
+    }
+
+    /// Any in-range 26-char Crockford string (first char '0'..='7', mixed
+    /// case) decodes, and re-encoding yields its uppercase canonical form —
+    /// i.e. decode is injective on in-range strings modulo case.
+    #[hegel::test]
+    fn prop_valid_string_canonical_roundtrip(tc: hegel::TestCase) {
+        let s = draw_ulid_string(&tc, 0, 7);
+        let ulid = Ulid::from_string(&s).expect("in-range Crockford base32 string must decode");
+        assert_eq!(ulid.to_string(), s.to_ascii_uppercase());
+    }
+
+    /// 26 Crockford base32 chars encode 130 bits, but a Ulid has only 128:
+    /// the ULID spec caps ULIDs at "7ZZZZZZZZZZZZZZZZZZZZZZZZZ" (which is
+    /// Ulid::max()), so any string whose first char encodes 8..=31 denotes a
+    /// value >= 2^128 and must be rejected rather than silently truncated.
+    ///
+    /// KNOWN FAILURE — real bug, deliberately left failing: `base32::decode`
+    /// never checks the two overflow bits, so every out-of-range string is
+    /// accepted and its top two bits are silently discarded. Minimal
+    /// counterexample: "80000000000000000000000000" decodes to Ok(Ulid(0)),
+    /// i.e. it collides with "00000000000000000000000000". This violates the
+    /// ULID spec ("Any attempt to decode or encode a ULID larger than
+    /// [7ZZZZZZZZZZZZZZZZZZZZZZZZZ] should be rejected ... to prevent
+    /// overflow bugs") and makes from_string non-injective. The failure is
+    /// deterministic: every input this generator draws is out of range, so
+    /// the property fails on the first case of every run.
+    #[hegel::test]
+    fn prop_from_string_rejects_out_of_range(tc: hegel::TestCase) {
+        let s = draw_ulid_string(&tc, 8, 31);
+        let res = Ulid::from_string(&s);
+        assert!(
+            res.is_err(),
+            "out-of-range ULID string {:?} decoded to {:?}",
+            s,
+            res
+        );
+    }
+
+    /// "Lexicographically sortable": comparing two Ulids as strings gives
+    /// the same ordering as comparing their 128-bit values.
+    #[hegel::test]
+    fn prop_string_order_matches_value_order(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<u128>());
+        let b = tc.draw(generators::integers::<u128>());
+        assert_eq!(Ulid(a).to_string().cmp(&Ulid(b).to_string()), a.cmp(&b));
+    }
+
+    /// A Ulid with a strictly larger timestamp sorts strictly later as a
+    /// string, regardless of the random parts (the documented reason the
+    /// timestamp occupies the high bits).
+    #[hegel::test]
+    fn prop_timestamp_order_implies_string_order(tc: hegel::TestCase) {
+        const TIME_MASK: u64 = bitmask!(Ulid::TIME_BITS);
+        const RAND_MASK: u128 = bitmask!(Ulid::RAND_BITS);
+        let ts_lo = tc.draw(generators::integers::<u64>().max_value(TIME_MASK - 1));
+        let ts_hi = tc.draw(
+            generators::integers::<u64>()
+                .min_value(ts_lo + 1)
+                .max_value(TIME_MASK),
+        );
+        let r_lo = tc.draw(generators::integers::<u128>().max_value(RAND_MASK));
+        let r_hi = tc.draw(generators::integers::<u128>().max_value(RAND_MASK));
+        let early = Ulid::from_parts(ts_lo, r_lo);
+        let late = Ulid::from_parts(ts_hi, r_hi);
+        assert!(early < late);
+        assert!(early.to_string() < late.to_string());
+    }
+
+    /// `increment` bumps the random part and keeps the timestamp; when the
+    /// random part is maxed it returns the overflowed (next-millisecond)
+    /// Ulid in Err, saturating at Ulid::max.
+    #[hegel::test]
+    fn prop_increment(tc: hegel::TestCase) {
+        const RAND_MASK: u128 = bitmask!(Ulid::RAND_BITS);
+        // boost the maxed-random boundary so the Err branch fires often
+        let n = tc.draw(hegel::one_of!(
+            generators::integers::<u128>(),
+            generators::integers::<u64>().map(|ts| Ulid::from_parts(ts, RAND_MASK).0),
+        ));
+        let ulid = Ulid(n);
+        match ulid.increment() {
+            Ok(next) => {
+                assert!(ulid.random() < RAND_MASK);
+                assert_eq!(next.timestamp_ms(), ulid.timestamp_ms());
+                assert_eq!(next.random(), ulid.random() + 1);
+            }
+            Err(overflowed) => {
+                assert_eq!(ulid.random(), RAND_MASK);
+                assert_eq!(overflowed.0, ulid.0.saturating_add(1));
+                if !ulid.is_max() {
+                    assert_eq!(overflowed.timestamp_ms(), ulid.timestamp_ms() + 1);
+                    assert_eq!(overflowed.random(), 0);
+                }
+            }
+        }
+    }
 }
