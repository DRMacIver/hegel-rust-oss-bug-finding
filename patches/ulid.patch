--- a/src/generator.rs
+++ b/src/generator.rs
@@ -322,4 +322,49 @@ mod tests {
         assert!(next_ulid > maxed_random);
         assert_eq!(generator.previous, next_ulid);
     }
+
+    // -----------------------------------------------------------------
+    // Property-based tests (hegel)
+    // -----------------------------------------------------------------
+
+    use hegel::generators;
+
+    /// The generator's documented guarantee: "Each call is guaranteed to
+    /// provide a Ulid with a larger value than the last call", for arbitrary
+    /// timestamp sequences — including repeated and backwards clocks.
+    #[hegel::test]
+    fn prop_generator_monotonic(tc: hegel::TestCase) {
+        const TIME_MASK: u64 = crate::bitmask!(Ulid::TIME_BITS);
+        let timestamps: Vec<u64> = tc.draw(
+            generators::vecs(generators::integers::<u64>().max_value(TIME_MASK))
+                .min_size(2)
+                .max_size(20),
+        );
+        // StepRng is a counter, not a seeded PRNG: the drawn value/increment
+        // map directly onto the random bits consumed per generation, so
+        // hegel can shrink them meaningfully.
+        let value = tc.draw(generators::integers::<u64>());
+        let increment = tc.draw(generators::integers::<u64>());
+        let mut source = crate::StepRng::new(value, increment);
+        let mut generator = Generator::new();
+        let mut prev: Option<Ulid> = None;
+        for ts in timestamps {
+            let dt = SystemTime::UNIX_EPOCH + Duration::from_millis(ts);
+            let next = match generator.generate_from_datetime_with_source(dt, &mut source) {
+                Ok(ulid) => ulid,
+                Err(overflow) => overflow.commit_overflow_increment(),
+            };
+            if let Some(p) = prev {
+                // saturation at Ulid::max is the one documented exception
+                if !p.is_max() {
+                    assert!(next > p, "generator went backwards: {} then {}", p, next);
+                }
+                // a strictly advancing clock is reflected in the timestamp
+                if ts > p.timestamp_ms() {
+                    assert_eq!(next.timestamp_ms(), ts);
+                }
+            }
+            prev = Some(next);
+        }
+    }
 }
