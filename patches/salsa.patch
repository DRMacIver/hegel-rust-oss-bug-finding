+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Crown property: *incremental recomputation equals from-scratch computation*.
+//
+// We build a small database of input cells with a few layers of derived
+// arithmetic queries over them, apply an arbitrary sequence of input
+// mutations (value changes, durability changes, adding/removing cells,
+// synthetic writes) with queries interleaved, and at drawn points compare
+// every derived value against a fresh database built from the current input
+// state. Evidence: the `execute` test above pins exactly this contract for
+// one hand-picked sequence (set field, re-query, expect same values as a
+// from-scratch run).
+
+use hegel::TestCase;
+use hegel::generators;
+use salsa::{Database as _, Durability};
+
+#[salsa::input(debug)]
+struct Cell {
+    #[returns(copy)]
+    value: i64,
+}
+
+#[salsa::input(debug)]
+struct Group {
+    #[returns(ref)]
+    cells: Vec<Cell>,
+}
+
+// Derived layer 1: per-cell arithmetic.
+#[salsa::tracked(returns(copy))]
+fn cell_doubled(db: &dyn salsa::Database, cell: Cell) -> i64 {
+    cell.value(db).wrapping_mul(2)
+}
+
+// Derived layer 2: aggregates over the group, one built on layer 1 and one
+// reading the inputs directly.
+#[salsa::tracked(returns(copy))]
+fn group_sum_of_doubled(db: &dyn salsa::Database, group: Group) -> i64 {
+    group
+        .cells(db)
+        .iter()
+        .fold(0i64, |acc, cell| acc.wrapping_add(cell_doubled(db, *cell)))
+}
+
+#[salsa::tracked(returns(copy))]
+fn group_max(db: &dyn salsa::Database, group: Group) -> i64 {
+    group
+        .cells(db)
+        .iter()
+        .map(|cell| cell.value(db))
+        .max()
+        .unwrap_or(0)
+}
+
+// Derived layer 3: built on both layer-2 queries.
+#[salsa::tracked(returns(copy))]
+fn group_summary(db: &dyn salsa::Database, group: Group) -> i64 {
+    group_sum_of_doubled(db, group).wrapping_sub(group_max(db, group))
+}
+
+/// What a from-scratch database computes for the given cell values.
+fn fresh_db_results(values: &[i64]) -> (Vec<i64>, i64, i64, i64) {
+    let db = salsa::DatabaseImpl::new();
+    let cells: Vec<Cell> = values.iter().map(|&v| Cell::new(&db, v)).collect();
+    let group = Group::new(&db, cells.clone());
+    (
+        cells.iter().map(|&cell| cell_doubled(&db, cell)).collect(),
+        group_sum_of_doubled(&db, group),
+        group_max(&db, group),
+        group_summary(&db, group),
+    )
+}
+
+fn optional_durability(tc: &TestCase) -> Option<Durability> {
+    tc.draw(generators::sampled_from(vec![
+        None,
+        Some(Durability::LOW),
+        Some(Durability::MEDIUM),
+        Some(Durability::HIGH),
+        Some(Durability::NEVER_CHANGE),
+    ]))
+}
+
+struct IncrementalMachine {
+    db: salsa::DatabaseImpl,
+    group: Group,
+    cells: Vec<Cell>,
+    /// Cells whose `value` field was set with `Durability::NEVER_CHANGE`.
+    /// Writing to such a field again panics *by documented contract*
+    /// (see `Durability::NEVER_CHANGE`), so mutation rules skip them.
+    frozen: Vec<bool>,
+    /// Reference model: the intended current value of every cell.
+    model: Vec<i64>,
+}
+
+#[hegel::state_machine]
+impl IncrementalMachine {
+    #[rule]
+    fn set_value(&mut self, tc: TestCase) {
+        tc.assume(!self.cells.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.cells.len() - 1));
+        tc.assume(!self.frozen[idx]);
+        // Re-setting the current value exercises salsa's backdating path.
+        let value = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::just(self.model[idx]),
+        ));
+        match optional_durability(&tc) {
+            None => {
+                self.cells[idx].set_value(&mut self.db).to(value);
+            }
+            Some(durability) => {
+                self.cells[idx]
+                    .set_value(&mut self.db)
+                    .with_durability(durability)
+                    .to(value);
+                if durability == Durability::NEVER_CHANGE {
+                    self.frozen[idx] = true;
+                }
+            }
+        }
+        self.model[idx] = value;
+    }
+
+    #[rule]
+    fn add_cell(&mut self, tc: TestCase) {
+        // The size cap keeps the fresh-db oracle cheap; it is not a salsa
+        // contract (bound protects the test's resources).
+        tc.assume(self.cells.len() < 8);
+        let value = tc.draw(generators::integers::<i64>());
+        let durability = optional_durability(&tc);
+        let cell = match durability {
+            None => Cell::new(&self.db, value),
+            Some(d) => Cell::builder(value).value_durability(d).new(&self.db),
+        };
+        self.cells.push(cell);
+        self.frozen
+            .push(durability == Some(Durability::NEVER_CHANGE));
+        self.model.push(value);
+        let cells = self.cells.clone();
+        self.group.set_cells(&mut self.db).to(cells);
+    }
+
+    #[rule]
+    fn remove_cell(&mut self, tc: TestCase) {
+        tc.assume(!self.cells.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.cells.len() - 1));
+        self.cells.remove(idx);
+        self.frozen.remove(idx);
+        self.model.remove(idx);
+        self.group.set_cells(&mut self.db).to(self.cells.clone());
+    }
+
+    #[rule]
+    fn synthetic_write(&mut self, tc: TestCase) {
+        // `synthetic_write` documents a panic on NEVER_CHANGE, so draw from
+        // the three writable durabilities.
+        let durability = tc.draw(generators::sampled_from(vec![
+            Durability::LOW,
+            Durability::MEDIUM,
+            Durability::HIGH,
+        ]));
+        self.db.synthetic_write(durability);
+    }
+
+    /// Warm a single memo so that different revisions see different query
+    /// orders (some revisions are queried lazily, some eagerly).
+    #[rule]
+    fn query_one(&mut self, tc: TestCase) {
+        tc.assume(!self.cells.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.cells.len() - 1));
+        let _ = cell_doubled(&self.db, self.cells[idx]);
+        if tc.draw(generators::booleans()) {
+            let _ = group_summary(&self.db, self.group);
+        }
+    }
+
+    /// The property: every derived value in the incrementally-updated
+    /// database equals the value a from-scratch database computes.
+    #[rule]
+    fn check_against_fresh_db(&mut self, _tc: TestCase) {
+        let (fresh_doubled, fresh_sum, fresh_max, fresh_summary) = fresh_db_results(&self.model);
+        for (i, cell) in self.cells.iter().enumerate() {
+            assert_eq!(cell.value(&self.db), self.model[i], "cell {i} value");
+            assert_eq!(
+                cell_doubled(&self.db, *cell),
+                fresh_doubled[i],
+                "cell {i} doubled"
+            );
+        }
+        assert_eq!(
+            group_sum_of_doubled(&self.db, self.group),
+            fresh_sum,
+            "group_sum_of_doubled"
+        );
+        assert_eq!(group_max(&self.db, self.group), fresh_max, "group_max");
+        assert_eq!(
+            group_summary(&self.db, self.group),
+            fresh_summary,
+            "group_summary"
+        );
+    }
+}
+
+#[hegel::test]
+fn incremental_computation_matches_fresh_db(tc: TestCase) {
+    let db = salsa::DatabaseImpl::new();
+    let initial: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(6));
+    let cells: Vec<Cell> = initial.iter().map(|&v| Cell::new(&db, v)).collect();
+    let group = Group::new(&db, cells.clone());
+    let frozen = vec![false; cells.len()];
+    hegel::stateful::run(
+        IncrementalMachine {
+            db,
+            group,
+            cells,
+            frozen,
+            model: initial,
+        },
+        tc,
+    );
+}
+
