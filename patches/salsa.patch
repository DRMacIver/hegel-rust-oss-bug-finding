+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Generalization of the unit tests above: after *any* sequence of mutations
+// to `field_a`/`field_b`, `push_logs::accumulated::<Log>` must return exactly
+// the `a` logs followed by the `b` logs for the *current* field values —
+// i.e. accumulated values always reflect the current input state, in
+// execution order, with no stale or duplicated entries.
+
+use hegel::TestCase;
+use hegel::generators;
+
+#[hegel::test]
+fn accumulated_logs_match_current_inputs(tc: TestCase) {
+    let mut db = common::LoggerDatabase::default();
+
+    // The bound keeps the number of accumulated entries per query small so
+    // the test stays fast; it protects the test's resources, not a salsa
+    // contract.
+    let field_gen = || generators::integers::<u32>().max_value(20);
+
+    let mut a = tc.draw(field_gen());
+    let mut b = tc.draw(field_gen());
+    let input = MyInput::new(&db, a, b);
+
+    let check = |db: &dyn LogDatabase, a: u32, b: u32| {
+        let logs = push_logs::accumulated::<Log>(db, input);
+        let expected: Vec<Log> = (0..a)
+            .map(|i| Log(format!("log_a({i} of {a})")))
+            .chain((0..b).map(|i| Log(format!("log_b({i} of {b})"))))
+            .collect();
+        // `Log` doesn't implement `PartialEq`; compare debug renderings.
+        assert_eq!(format!("{logs:?}"), format!("{expected:?}"));
+    };
+    check(&db, a, b);
+
+    let steps = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    for _ in 0..steps {
+        if tc.draw(generators::booleans()) {
+            a = tc.draw(field_gen());
+            input.set_field_a(&mut db).to(a);
+        } else {
+            b = tc.draw(field_gen());
+            input.set_field_b(&mut db).to(b);
+        }
+        // Only sometimes re-query, so some revisions are skipped entirely.
+        if tc.draw(generators::booleans()) {
+            check(&db, a, b);
+        }
+    }
+    check(&db, a, b);
+}
diff --git a/tests/cycle.rs b/tests/cycle.rs
index bd64dd84..943b4202 100644
--- a/tests/cycle.rs
+++ b/tests/cycle.rs
@@ -1382,3 +1382,105 @@ fn repeat_query_participating_in_cycle2() {
             "salsa_event(DidFinalizeCycle { database_key: head(Id(0)), iteration: 2 })",
         ]"#]]);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Default cycle-handling contract: a tracked function *without*
+// `cycle_fn`/`cycle_initial` panics if (and only if) evaluation encounters a
+// dependency cycle; on acyclic graphs it returns the correct value. The
+// panic message is pinned in `src/function/fetch.rs`: "dependency graph
+// cycle when querying ... set cycle_fn/cycle_initial to fixpoint iterate".
+
+use hegel::TestCase;
+use hegel::generators;
+
+#[salsa::input(debug)]
+struct Node {
+    #[returns(ref)]
+    successors: Vec<Node>,
+}
+
+/// Height of a node: 0 for a leaf, else 1 + max height of its successors.
+/// Uses default (panic) cycle handling.
+#[salsa::tracked(returns(copy))]
+fn node_height(db: &dyn Db, node: Node) -> u64 {
+    node.successors(db)
+        .iter()
+        .map(|&s| node_height(db, s))
+        .max()
+        .map_or(0, |h| h + 1)
+}
+
+/// Model oracle: `Some(height)` if no cycle is reachable from `node`,
+/// `None` if evaluating `node` would encounter a cycle.
+fn model_height(
+    edges: &[Vec<usize>],
+    node: usize,
+    state: &mut [u8],
+    memo: &mut [u64],
+) -> Option<u64> {
+    match state[node] {
+        1 => return None, // back-edge: cycle
+        2 => return Some(memo[node]),
+        _ => {}
+    }
+    state[node] = 1;
+    let mut height = 0;
+    for &succ in &edges[node] {
+        height = height.max(model_height(edges, succ, state, memo)? + 1);
+    }
+    state[node] = 2;
+    memo[node] = height;
+    Some(height)
+}
+
+#[hegel::test]
+fn default_cycle_handling_panics_iff_cycle_reachable(tc: TestCase) {
+    let mut db = DbImpl::new();
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    let edges: Vec<Vec<usize>> = (0..n)
+        .map(|_| {
+            tc.draw(generators::vecs(generators::integers::<usize>().max_value(n - 1)).max_size(3))
+        })
+        .collect();
+
+    let nodes: Vec<Node> = (0..n).map(|_| Node::new(&db, Vec::new())).collect();
+    for (i, succs) in edges.iter().enumerate() {
+        if !succs.is_empty() {
+            nodes[i]
+                .set_successors(&mut db)
+                .to(succs.iter().map(|&j| nodes[j]).collect());
+        }
+    }
+
+    let mut state = vec![0u8; n];
+    let mut memo = vec![0u64; n];
+    let expected = model_height(&edges, 0, &mut state, &mut memo);
+
+    let result =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| node_height(&db, nodes[0])));
+
+    match expected {
+        Some(height) => {
+            assert_eq!(
+                result.expect("acyclic evaluation must not panic"),
+                height,
+                "height of node 0"
+            );
+        }
+        None => {
+            let payload = result.expect_err("reachable cycle must panic");
+            let message = payload
+                .downcast_ref::<String>()
+                .map(String::as_str)
+                .or_else(|| payload.downcast_ref::<&str>().copied())
+                .unwrap_or("");
+            assert!(
+                message.contains("dependency graph cycle"),
+                "expected the documented cycle panic, got: {message:?}"
+            );
+        }
+    }
+}
