+        let a_data: Vec<i64> = tc.draw(generators::vecs(value_gen()).min_size(m * k).max_size(m * k));
+        let b_data: Vec<i64> = tc.draw(generators::vecs(value_gen()).min_size(k * n).max_size(k * n));
+        let a = Array2::from_shape_vec((m, k), a_data.clone()).unwrap();
