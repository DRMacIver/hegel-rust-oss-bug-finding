+/// Hegel property-based tests: axis insertion/removal round-trips and
+/// `into_dimensionality` shape invariants.
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape};
+    use hegel::generators;
+    use ndarray::prelude::*;
+
+    #[hegel::test]
+    fn hegel_insert_remove_axis_roundtrip(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+        let pos = tc.draw(generators::integers::<usize>().max_value(shape.len()));
