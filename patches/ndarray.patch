+mod hegel_support;
+
+/// Hegel property-based tests: iteration follows logical (row-major) order,
+/// for both standard-layout arrays and non-contiguous views, and
+/// `indexed_iter` produces the matching lexicographic indices.
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, flat_offset, lex_indices, row_major_strides};
+    use ndarray::prelude::*;
+    use ndarray::Dimension;
+
+    #[hegel::test]
+    fn hegel_iter_yields_row_major_logical_order(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+
+        // A C-order array iterates exactly in the order of its backing data.
+        assert!(a.iter().eq(data.iter()));
+
+        // A non-contiguous view (reversed axes) still iterates in *its own*
+        // logical row-major order, which we compute from the flat data.
+        let t = a.view().reversed_axes();
+        let rev_shape: Vec<usize> = shape.iter().rev().cloned().collect();
+        let strides = row_major_strides(&shape);
+        let expected: Vec<i64> = lex_indices(&rev_shape)
+            .into_iter()
+            .map(|ridx| {
+                let idx: Vec<usize> = ridx.iter().rev().cloned().collect();
+                data[flat_offset(&idx, &strides)]
+            })
+            .collect();
+        assert!(t.iter().eq(expected.iter()));
+    }
+
+    #[hegel::test]
+    fn hegel_indexed_iter_indices_are_lexicographic_and_correct(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+        let strides = row_major_strides(&shape);
+
+        let items: Vec<(IxDyn, &i64)> = a.indexed_iter().collect();
+        let expected_indices = lex_indices(&shape);
+        assert_eq!(items.len(), expected_indices.len());
+        for ((pattern, value), idx) in items.iter().zip(&expected_indices) {
+            assert_eq!(pattern.slice(), &idx[..]);
+            assert_eq!(**value, data[flat_offset(idx, &strides)]);
+        }
+    }
+}
diff --git a/tests/numeric.rs b/tests/numeric.rs
