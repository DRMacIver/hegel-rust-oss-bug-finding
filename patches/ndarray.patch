+        let res = a.clone().into_dimensionality::<Ix2>();
+        if shape.len() == 2 {
+            let a2 = res.expect("2-axis dynamic array must convert to Ix2");
+            assert_eq!(a2.shape(), &shape[..]);
+            assert_eq!(a2.into_dyn(), a);
