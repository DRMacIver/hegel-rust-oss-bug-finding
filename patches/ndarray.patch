         assert_eq!(s, array![[1, 5], [2, 6], [3, 7], [4, 8]]);
     }
 }
+
+mod hegel_support;
+
+/// Hegel property-based tests: reshaping to any compatible shape preserves
+/// the elements in logical (row-major) order, and an incompatible total size
+/// is an error, never a panic.
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape};
+    use hegel::generators;
+    use ndarray::prelude::*;
+
+    /// Draw a shape with the same number of elements as `n` by drawing a
+    /// chain of divisors of `n` (plus an explicit zero axis when `n == 0`).
+    fn draw_compatible_shape(tc: &hegel::TestCase, n: usize) -> Vec<usize>
+    {
+        if n == 0 {
+            let mut shape = draw_shape(tc, 1, 4);
+            let pos = tc.draw(generators::integers::<usize>().max_value(shape.len() - 1));
+            shape[pos] = 0;
+            return shape;
+        }
+        let mut dims = Vec::new();
+        let mut rem = n;
+        let extra_axes = tc.draw(generators::integers::<usize>().max_value(3));
+        for _ in 0..extra_axes {
+            let divisors: Vec<usize> = (1..=rem).filter(|d| rem % d == 0).collect();
+            let d = tc.draw(generators::sampled_from(divisors));
+            dims.push(d);
+            rem /= d;
+        }
+        dims.push(rem);
+        dims
+    }
+
+    #[hegel::test]
+    fn hegel_reshape_roundtrip_preserves_logical_order(tc: hegel::TestCase)
+    {
+        let shape1 = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape1, i64::MIN, i64::MAX);
+        let shape2 = draw_compatible_shape(&tc, data.len());
+
+        let b = a
+            .to_shape(IxDyn(&shape2))
+            .expect("reshape to a shape with the same number of elements must succeed");
+        assert_eq!(b.shape(), &shape2[..]);
+        // Row-major reshape of a C-order array preserves logical element order.
+        assert!(b.iter().eq(data.iter()));
+
+        // Reshaping back restores the original array exactly.
+        let c = b.to_shape(IxDyn(&shape1)).unwrap();
+        assert_eq!(c, a);
+    }
+
+    #[hegel::test]
+    fn hegel_reshape_incompatible_size_errors(tc: hegel::TestCase)
+    {
+        let shape1 = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape1, i64::MIN, i64::MAX);
+        let shape2 = draw_shape(&tc, 0, 4);
+        let n2: usize = shape2.iter().product();
+        tc.assume(n2 != data.len());
+        // Mismatched element count must be a ShapeError, not a panic.
+        assert!(a.to_shape(IxDyn(&shape2)).is_err());
+    }
+}
