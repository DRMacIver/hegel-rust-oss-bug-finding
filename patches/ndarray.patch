+mod hegel_support;
+
+/// Hegel property-based tests: broadcasting checked against a manual
+/// index-mapping model over the flat data, plus the error case and
+/// co-broadcasting element-wise arithmetic.
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, lex_indices, row_major_strides};
+    use hegel::generators;
+    use ndarray::prelude::*;
+
+    #[hegel::test]
+    fn hegel_broadcast_repeats_elements_per_model(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 3);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+
+        // A valid broadcast target: prepend up to 2 new axes, and expand any
+        // length-1 source axis to an arbitrary length.
+        let extra = tc.draw(generators::integers::<usize>().max_value(2));
+        let mut target: Vec<usize> = (0..extra)
+            .map(|_| tc.draw(generators::integers::<usize>().max_value(5)))
+            .collect();
+        for &s in &shape {
+            if s == 1 {
+                target.push(tc.draw(generators::integers::<usize>().max_value(5)));
+            } else {
+                target.push(s);
+            }
+        }
+
+        let b = a
+            .broadcast(IxDyn(&target))
+            .expect("broadcast to a compatible shape must succeed");
+        assert_eq!(b.shape(), &target[..]);
+
+        let strides = row_major_strides(&shape);
+        let offset = target.len() - shape.len();
+        for idx in lex_indices(&target) {
+            let flat: usize = shape
+                .iter()
+                .enumerate()
+                .map(|(i, &s)| (if s == 1 { 0 } else { idx[offset + i] }) * strides[i])
+                .sum();
+            assert_eq!(b[IxDyn(&idx)], data[flat]);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_broadcast_incompatible_shape_is_none(tc: hegel::TestCase)
+    {
+        // Force one source axis to have length >= 2, then request a target
+        // that differs on that axis: broadcasting can never change it.
+        let mut shape = draw_shape(&tc, 1, 3);
+        let p = tc.draw(generators::integers::<usize>().max_value(shape.len() - 1));
+        shape[p] = tc.draw(generators::integers::<usize>().min_value(2).max_value(5));
+        let (a, _) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+
+        let mut target = shape.clone();
+        let mut t_p = tc.draw(generators::integers::<usize>().max_value(5));
+        if t_p == shape[p] {
+            t_p = (t_p + 1) % 6;
+        }
+        target[p] = t_p;
+
+        assert!(a.broadcast(IxDyn(&target)).is_none());
+    }
+
+    #[hegel::test]
+    fn hegel_elementwise_add_cobroadcast_matches_model(tc: hegel::TestCase)
+    {
+        // Draw the common target shape, then derive two operand shapes that
+        // co-broadcast to it: `a` spans all axes, `b` a trailing suffix, and
+        // each axis is kept by at least one operand (the other may be 1).
+        let t = draw_shape(&tc, 0, 3);
+        let q = t.len();
+        let lb = tc.draw(generators::integers::<usize>().max_value(q));
+        let mut sa = Vec::with_capacity(q);
+        let mut sb = Vec::with_capacity(lb);
+        for (i, &dim) in t.iter().enumerate() {
+            let b_has_axis = i >= q - lb;
+            let mut keep_a = tc.draw(generators::booleans());
+            let keep_b = b_has_axis && tc.draw(generators::booleans());
+            if !keep_a && !keep_b {
+                keep_a = true;
+            }
+            sa.push(if keep_a { dim } else { 1 });
+            if b_has_axis {
+                sb.push(if keep_b { dim } else { 1 });
+            }
+        }
+
+        // Value bounds protect the test's `+` from primitive i64 overflow
+        // (inherited behavior, not a library contract).
+        let (a, da) = draw_array_i64(&tc, &sa, i64::MIN / 2, i64::MAX / 2);
+        let (b, db) = draw_array_i64(&tc, &sb, i64::MIN / 2, i64::MAX / 2);
+
+        let sum = &a + &b;
+        assert_eq!(sum.shape(), &t[..]);
+
+        let stride_a = row_major_strides(&sa);
+        let stride_b = row_major_strides(&sb);
+        for idx in lex_indices(&t) {
+            let fa: usize = sa
+                .iter()
+                .enumerate()
+                .map(|(i, &s)| (if s == 1 { 0 } else { idx[i] }) * stride_a[i])
+                .sum();
+            let fb: usize = sb
+                .iter()
+                .enumerate()
+                .map(|(i, &s)| (if s == 1 { 0 } else { idx[q - lb + i] }) * stride_b[i])
+                .sum();
+            assert_eq!(sum[IxDyn(&idx)], da[fa] + db[fb]);
+        }
+    }
+}
