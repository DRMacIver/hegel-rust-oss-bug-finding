+mod hegel_support;
+
+/// Hegel property-based tests: in-place `append` along an axis matches the
+/// concatenation model (append does layout-shuffling internally, so it gets
+/// its own coverage beyond `concatenate`).
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, flat_offset, lex_indices, row_major_strides};
+    use hegel::generators;
+    use ndarray::prelude::*;
+
+    #[hegel::test]
+    fn hegel_append_matches_concatenation_model(tc: hegel::TestCase)
+    {
+        let shape_a = draw_shape(&tc, 1, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 1));
+        let mut shape_b = shape_a.clone();
+        shape_b[axis] = tc.draw(generators::integers::<usize>().max_value(5));
+
+        let (mut a, da) = draw_array_i64(&tc, &shape_a, i64::MIN, i64::MAX);
+        let (b, db) = draw_array_i64(&tc, &shape_b, i64::MIN, i64::MAX);
+
+        a.append(Axis(axis), b.view())
+            .expect("appending an array matching on all other axes must succeed");
+
+        let mut expected_shape = shape_a.clone();
+        expected_shape[axis] += shape_b[axis];
+        assert_eq!(a.shape(), &expected_shape[..]);
+
+        let stride_a = row_major_strides(&shape_a);
+        let stride_b = row_major_strides(&shape_b);
+        for idx in lex_indices(&expected_shape) {
+            let expected = if idx[axis] < shape_a[axis] {
+                da[flat_offset(&idx, &stride_a)]
+            } else {
+                let mut j = idx.clone();
+                j[axis] -= shape_a[axis];
+                db[flat_offset(&j, &stride_b)]
+            };
+            assert_eq!(a[IxDyn(&idx)], expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_append_shape_mismatch_errors(tc: hegel::TestCase)
+    {
+        let shape_a = draw_shape(&tc, 2, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 1));
+        let j0 = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 2));
+        let j = if j0 >= axis { j0 + 1 } else { j0 };
+        let mut shape_b = shape_a.clone();
+        let mut v = tc.draw(generators::integers::<usize>().max_value(5));
+        if v == shape_a[j] {
+            v = (v + 1) % 6;
+        }
+        shape_b[j] = v;
+
+        let (mut a, _) = draw_array_i64(&tc, &shape_a, i64::MIN, i64::MAX);
+        let (b, _) = draw_array_i64(&tc, &shape_b, i64::MIN, i64::MAX);
+
+        // Mismatch on a non-append axis must be an error, not a panic.
+        assert!(a.append(Axis(axis), b.view()).is_err());
+    }
+}
