+
+mod hegel_support;
+
+/// Hegel property-based tests: axis reductions checked against naive folds
+/// over the flat data (exact in i64; norm-scaled tolerance for f64 mean).
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, flat_offset, lex_indices, row_major_strides};
+    use hegel::generators;
+    use ndarray::prelude::*;
+
+    /// Indices of the reduced array (shape with `axis` removed), returned
+    /// with the shape/strides needed to walk the source data.
+    fn reduced_shape(shape: &[usize], axis: usize) -> Vec<usize>
+    {
+        let mut out = shape.to_vec();
+        out.remove(axis);
+        out
+    }
+
+    #[hegel::test]
+    fn hegel_sum_axis_matches_naive_fold(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 1, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape.len() - 1));
+        // Bound protects the naive fold (and the library's inherited `+`)
+        // from primitive i64 overflow: at most 5 addends of magnitude 2^55.
+        let (a, data) = draw_array_i64(&tc, &shape, -(1 << 55), 1 << 55);
+
+        let s = a.sum_axis(Axis(axis));
+        let out_shape = reduced_shape(&shape, axis);
+        assert_eq!(s.shape(), &out_shape[..]);
+
+        let strides = row_major_strides(&shape);
+        for idx in lex_indices(&out_shape) {
+            let mut expected = 0i64;
+            for j in 0..shape[axis] {
+                let mut src = idx.clone();
+                src.insert(axis, j);
+                expected += data[flat_offset(&src, &strides)];
+            }
+            assert_eq!(s[IxDyn(&idx)], expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_product_axis_matches_naive_fold(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 1, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape.len() - 1));
+        // Bound protects against i64 overflow: at most 1000^5 < 2^50.
+        let (a, data) = draw_array_i64(&tc, &shape, -1000, 1000);
+
+        let p = a.product_axis(Axis(axis));
+        let out_shape = reduced_shape(&shape, axis);
+        assert_eq!(p.shape(), &out_shape[..]);
+
+        let strides = row_major_strides(&shape);
+        for idx in lex_indices(&out_shape) {
+            let mut expected = 1i64;
+            for j in 0..shape[axis] {
+                let mut src = idx.clone();
+                src.insert(axis, j);
+                expected *= data[flat_offset(&src, &strides)];
+            }
+            assert_eq!(p[IxDyn(&idx)], expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_sum_matches_naive_total(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        // Bound protects the fold from i64 overflow: <= 625 addends of 2^50.
+        let (a, data) = draw_array_i64(&tc, &shape, -(1 << 50), 1 << 50);
+        assert_eq!(a.sum(), data.iter().sum::<i64>());
+    }
+
+    #[hegel::test]
+    fn hegel_mean_axis_matches_naive_mean(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 1, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape.len() - 1));
+        let n: usize = shape.iter().product();
+        let data: Vec<f64> = tc.draw(
+            generators::vecs(
+                generators::floats::<f64>().min_value(-1e100).max_value(1e100),
+            )
+            .min_size(n)
+            .max_size(n),
+        );
+        let a = ArrayD::from_shape_vec(IxDyn(&shape), data.clone()).unwrap();
+
+        let mean = a.mean_axis(Axis(axis));
+        if shape[axis] == 0 {
+            assert!(mean.is_none(), "mean over an empty axis must be None");
+            return;
+        }
+        let mean = mean.expect("mean over a non-empty axis must be Some");
+        let out_shape = reduced_shape(&shape, axis);
+        assert_eq!(mean.shape(), &out_shape[..]);
+
+        let len = shape[axis] as f64;
+        let strides = row_major_strides(&shape);
+        for idx in lex_indices(&out_shape) {
+            let mut sum = 0.0f64;
+            let mut max_abs = 0.0f64;
+            for j in 0..shape[axis] {
+                let mut src = idx.clone();
+                src.insert(axis, j);
+                let x = data[flat_offset(&src, &strides)];
+                sum += x;
+                max_abs = max_abs.max(x.abs());
+            }
+            let expected = sum / len;
+            // Norm-scaled tolerance: pairwise vs sequential summation may
+            // differ by O(n * eps * max|x|); floor it for subnormal scales.
+            let tol = 4.0 * f64::EPSILON * len * max_abs + f64::MIN_POSITIVE;
+            let actual = mean[IxDyn(&idx)];
+            assert!(
+                (actual - expected).abs() <= tol,
+                "mean mismatch at {:?}: {} vs {} (tol {})",
+                idx,
+                actual,
+                expected,
+                tol
+            );
+        }
+    }
+}
