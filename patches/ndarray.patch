+++ b/tests/array.rs
@@ -2902,3 +2902,137 @@ fn permute_axes_oob()
         .unwrap();
     a.permute_axes([1, 0, 3]);
 }
+
+mod hegel_support;
+
+/// Hegel property-based tests: transposition and slicing checked against the
+/// flat data buffer the arrays were built from (independent of ndarray's own
+/// indexing).
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, flat_offset, lex_indices, row_major_strides};
+    use hegel::generators;
+    use ndarray::prelude::*;
+    use ndarray::Slice;
+
+    #[hegel::test]
+    fn hegel_transpose_involution_and_element_mapping(tc: hegel::TestCase)
+    {
+        let r = tc.draw(generators::integers::<usize>().max_value(5));
+        let c = tc.draw(generators::integers::<usize>().max_value(5));
+        let data: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(r * c)
+                .max_size(r * c),
+        );
+        let a = Array2::from_shape_vec((r, c), data.clone()).unwrap();
+
+        let t = a.t();
+        assert_eq!(t.shape(), &[c, r]);
+        assert_eq!(t.strides(), &[a.strides()[1], a.strides()[0]]);
+        for i in 0..r {
+            for j in 0..c {
+                assert_eq!(t[[j, i]], data[i * c + j]);
+            }
+        }
+        // Transposition is an involution.
+        assert_eq!(t.t(), a);
+    }
+
+    #[hegel::test]
+    fn hegel_reversed_axes_matches_index_reversal(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+
+        let t = a.view().reversed_axes();
+        let rev_shape: Vec<usize> = shape.iter().rev().cloned().collect();
+        assert_eq!(t.shape(), &rev_shape[..]);
+        assert_eq!(t.view().reversed_axes(), a);
+
+        let strides = row_major_strides(&shape);
+        for idx in lex_indices(&shape) {
+            let ridx: Vec<usize> = idx.iter().rev().cloned().collect();
+            assert_eq!(t[IxDyn(&ridx)], data[flat_offset(&idx, &strides)]);
+        }
+    }
+
+    /// The indices selected by `Slice::new(start, end, step)` on an axis of
+    /// length `len`, per the documented semantics: negative `start`/`end`
+    /// count from the back, `end` is exclusive (`None` = axis end), and a
+    /// negative step walks the `start..end` range from its back.
+    fn model_slice(len: usize, start: isize, end: Option<isize>, step: isize) -> Vec<usize>
+    {
+        let abs = |i: isize| -> usize {
+            if i < 0 {
+                (len as isize + i) as usize
+            } else {
+                i as usize
+            }
+        };
+        let s = abs(start);
+        let mut e = abs(end.unwrap_or(len as isize));
+        if e < s {
+            e = s;
+        }
+        let mut selected = Vec::new();
+        if step > 0 {
+            let mut i = s;
+            while i < e {
+                selected.push(i);
+                i += step as usize;
+            }
+        } else {
+            let mut i = e as isize - 1;
+            while i >= s as isize {
+                selected.push(i as usize);
+                i += step;
+            }
+        }
+        selected
+    }
+
+    #[hegel::test]
+    fn hegel_slice_matches_manual_model(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 1, 4);
+        let (a, data) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+
+        let mut view = a.view();
+        let mut selected: Vec<Vec<usize>> = Vec::new();
+        for (ax, &len) in shape.iter().enumerate() {
+            let l = len as isize;
+            // In-bounds slice arguments (out-of-bounds ones are a documented
+            // panic); negative values index from the back of the axis.
+            let start = tc.draw(generators::integers::<isize>().min_value(-l).max_value(l));
+            let end: Option<isize> = if tc.draw(generators::booleans()) {
+                Some(tc.draw(generators::integers::<isize>().min_value(-l).max_value(l)))
+            } else {
+                None
+            };
+            let step = tc.draw(hegel::one_of!(
+                generators::integers::<isize>().min_value(1).max_value(3),
+                generators::integers::<isize>().min_value(-3).max_value(-1),
+            ));
+            view.slice_axis_inplace(Axis(ax), Slice::new(start, end, step));
+            selected.push(model_slice(len, start, end, step));
+        }
+
+        let out_shape: Vec<usize> = selected.iter().map(|v| v.len()).collect();
+        assert_eq!(view.shape(), &out_shape[..]);
+
+        let strides = row_major_strides(&shape);
+        let expected: Vec<i64> = lex_indices(&out_shape)
+            .into_iter()
+            .map(|idx| {
+                let flat: usize = idx
+                    .iter()
+                    .enumerate()
+                    .map(|(ax, &i)| selected[ax][i] * strides[ax])
+                    .sum();
+                data[flat]
+            })
+            .collect();
+        assert!(view.iter().eq(expected.iter()));
+    }
+}
