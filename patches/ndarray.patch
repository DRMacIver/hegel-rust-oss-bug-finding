+mod hegel_support;
+
+/// Hegel property-based tests: `concatenate` and `stack` checked against a
+/// manual index-mapping model over the source arrays' flat data.
+mod hegel_props
+{
+    use crate::hegel_support::{draw_array_i64, draw_shape, flat_offset, lex_indices, row_major_strides};
+    use hegel::generators;
+    use ndarray::{concatenate, stack, Axis, IxDyn};
+
+    #[hegel::test]
+    fn hegel_concatenate_matches_model(tc: hegel::TestCase)
+    {
+        let shape_a = draw_shape(&tc, 1, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 1));
+        let mut shape_b = shape_a.clone();
+        shape_b[axis] = tc.draw(generators::integers::<usize>().max_value(5));
+
+        let (a, da) = draw_array_i64(&tc, &shape_a, i64::MIN, i64::MAX);
+        let (b, db) = draw_array_i64(&tc, &shape_b, i64::MIN, i64::MAX);
+
+        let c = concatenate(Axis(axis), &[a.view(), b.view()])
+            .expect("concatenating same-shape-except-axis arrays must succeed");
+
+        let mut expected_shape = shape_a.clone();
+        expected_shape[axis] += shape_b[axis];
+        assert_eq!(c.shape(), &expected_shape[..]);
+
+        let stride_a = row_major_strides(&shape_a);
+        let stride_b = row_major_strides(&shape_b);
+        for idx in lex_indices(&expected_shape) {
+            let expected = if idx[axis] < shape_a[axis] {
+                da[flat_offset(&idx, &stride_a)]
+            } else {
+                let mut j = idx.clone();
+                j[axis] -= shape_a[axis];
+                db[flat_offset(&j, &stride_b)]
+            };
+            assert_eq!(c[IxDyn(&idx)], expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_concatenate_shape_mismatch_errors(tc: hegel::TestCase)
+    {
+        let shape_a = draw_shape(&tc, 2, 4);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 1));
+        // Pick a *different* axis and make the shapes differ there.
+        let j0 = tc.draw(generators::integers::<usize>().max_value(shape_a.len() - 2));
+        let j = if j0 >= axis { j0 + 1 } else { j0 };
+        let mut shape_b = shape_a.clone();
+        let mut v = tc.draw(generators::integers::<usize>().max_value(5));
+        if v == shape_a[j] {
+            v = (v + 1) % 6;
+        }
+        shape_b[j] = v;
+
+        let (a, _) = draw_array_i64(&tc, &shape_a, i64::MIN, i64::MAX);
+        let (b, _) = draw_array_i64(&tc, &shape_b, i64::MIN, i64::MAX);
+
+        // Mismatch on a non-concatenation axis must be an error, not a panic.
+        assert!(concatenate(Axis(axis), &[a.view(), b.view()]).is_err());
+    }
+
+    #[hegel::test]
+    fn hegel_stack_matches_model(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 3);
+        let axis = tc.draw(generators::integers::<usize>().max_value(shape.len()));
+        let n_arrays = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+
+        let mut arrays = Vec::with_capacity(n_arrays);
+        let mut datas = Vec::with_capacity(n_arrays);
+        for _ in 0..n_arrays {
+            let (a, d) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
+            arrays.push(a);
+            datas.push(d);
+        }
+        let views: Vec<_> = arrays.iter().map(|a| a.view()).collect();
+
+        let s = stack(Axis(axis), &views).expect("stacking same-shape arrays must succeed");
+
+        let mut expected_shape = shape.clone();
+        expected_shape.insert(axis, n_arrays);
+        assert_eq!(s.shape(), &expected_shape[..]);
+
+        let strides = row_major_strides(&shape);
+        for idx in lex_indices(&expected_shape) {
+            let which = idx[axis];
+            let mut src = idx.clone();
+            src.remove(axis);
+            assert_eq!(s[IxDyn(&idx)], datas[which][flat_offset(&src, &strides)]);
+        }
+    }
+}
