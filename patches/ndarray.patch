+//! Shared helpers for hegel property-based tests.
+//!
+//! Included via `mod hegel_support;` from the integration test files that use
+//! generated small arrays. All model computations here work directly on the
+//! flat data `Vec` and hand-computed row-major strides, so they are
+//! independent of ndarray's own indexing/iteration machinery.
+#![allow(dead_code)]
+
+use hegel::generators;
+use ndarray::{ArrayD, IxDyn};
+
+/// Draw a shape with `min_ndim..=max_ndim` axes and 0..=5 elements per axis.
+pub fn draw_shape(tc: &hegel::TestCase, min_ndim: usize, max_ndim: usize) -> Vec<usize>
+{
+    let ndim = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_ndim)
+            .max_value(max_ndim),
+    );
+    (0..ndim)
+        .map(|_| tc.draw(generators::integers::<usize>().max_value(5)))
+        .collect()
+}
+
+/// Draw a C-order `ArrayD<i64>` with the given shape and element values in
+/// `min..=max`, returning both the array and the flat row-major data it was
+/// built from (an independent copy the properties can check against).
+pub fn draw_array_i64(tc: &hegel::TestCase, shape: &[usize], min: i64, max: i64) -> (ArrayD<i64>, Vec<i64>)
+{
+    let n: usize = shape.iter().product();
+    let data: Vec<i64> = tc.draw(
+        generators::vecs(generators::integers::<i64>().min_value(min).max_value(max))
+            .min_size(n)
+            .max_size(n),
+    );
+    let a = ArrayD::from_shape_vec(IxDyn(shape), data.clone()).unwrap();
+    (a, data)
+}
+
+/// Row-major (C order) strides, in elements, for `shape`.
+///
+/// If some later axis has length 0 the earlier strides are 0, but in that
+/// case the shape contains no valid indices, so they are never used.
+pub fn row_major_strides(shape: &[usize]) -> Vec<usize>
+{
+    let mut strides = vec![1usize; shape.len()];
+    for i in (0..shape.len().saturating_sub(1)).rev() {
+        strides[i] = strides[i + 1] * shape[i + 1];
+    }
+    strides
+}
+
+/// All indices of `shape`, in lexicographic (row-major) order.
+///
+/// For a 0-dimensional shape this is the single empty index; for any shape
+/// with a zero-length axis it is empty.
+pub fn lex_indices(shape: &[usize]) -> Vec<Vec<usize>>
+{
+    let mut out = Vec::new();
+    if shape.iter().product::<usize>() == 0 {
+        return out;
+    }
+    let mut idx = vec![0usize; shape.len()];
+    loop {
+        out.push(idx.clone());
+        // Odometer increment on the last axis.
+        let mut i = shape.len();
+        loop {
+            if i == 0 {
+                return out;
+            }
+            i -= 1;
+            idx[i] += 1;
+            if idx[i] < shape[i] {
+                break;
+            }
+            idx[i] = 0;
+        }
+    }
+}
+
+/// Flat offset of `idx` given per-axis strides.
+pub fn flat_offset(idx: &[usize], strides: &[usize]) -> usize
+{
+    idx.iter().zip(strides).map(|(&i, &s)| i * s).sum()
+}
