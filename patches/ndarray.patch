+        assert!(b.iter().eq(data.iter()));
+
+        // remove_axis undoes insert_axis exactly.
+        assert_eq!(b.remove_axis(Axis(pos)), a);
+    }
+
+    #[hegel::test]
+    fn hegel_into_dimensionality_succeeds_iff_ndim_matches(tc: hegel::TestCase)
+    {
+        let shape = draw_shape(&tc, 0, 4);
+        let (a, _) = draw_array_i64(&tc, &shape, i64::MIN, i64::MAX);
