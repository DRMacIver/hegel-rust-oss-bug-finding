+// ---------------------------------------------------------------------------
+// Property-based tests (hegel) for host function value roundtrips.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+use wasmi::{Linker, Module};
+
+/// Draws one of the four Wasm numeric value types.
+fn draw_num_val_type(tc: &hegel::TestCase) -> ValType {
+    tc.draw(generators::sampled_from(vec![
+        ValType::I32,
+        ValType::I64,
+        ValType::F32,
+        ValType::F64,
+    ]))
+}
+
+/// Draws a [`Val`] of the given numeric [`ValType`].
+///
+/// Floats are drawn via their raw bit representation so that all bit
+/// patterns — including NaNs with arbitrary payloads — are covered.
+fn draw_val_of_type(tc: &hegel::TestCase, ty: ValType) -> Val {
+    match ty {
+        ValType::I32 => Val::I32(tc.draw(generators::integers::<i32>())),
+        ValType::I64 => Val::I64(tc.draw(generators::integers::<i64>())),
+        ValType::F32 => Val::F32(F32::from_bits(tc.draw(generators::integers::<u32>()))),
+        ValType::F64 => Val::F64(F64::from_bits(tc.draw(generators::integers::<u64>()))),
+        ty => panic!("unsupported value type: {ty:?}"),
+    }
+}
+
+/// Asserts that two numeric [`Val`]s are bitwise identical.
+///
+/// Floats are compared by bit pattern: value roundtrips must preserve
+/// NaN payloads and signed zeros exactly.
+#[track_caller]
+fn assert_val_bits_eq(lhs: &Val, rhs: &Val) {
+    match (lhs, rhs) {
+        (Val::I32(l), Val::I32(r)) => assert_eq!(l, r),
+        (Val::I64(l), Val::I64(r)) => assert_eq!(l, r),
+        (Val::F32(l), Val::F32(r)) => assert_eq!(
+            l.to_bits(),
+            r.to_bits(),
+            "f32 bits differ: {l:?} vs {r:?}"
+        ),
+        (Val::F64(l), Val::F64(r)) => assert_eq!(
+            l.to_bits(),
+            r.to_bits(),
+            "f64 bits differ: {l:?} vs {r:?}"
+        ),
+        (lhs, rhs) => panic!("value type mismatch: {lhs:?} vs {rhs:?}"),
+    }
+}
+
+/// Property: a dynamically-typed identity host function ([`Func::new`])
+/// with an arbitrary numeric signature returns all parameter values
+/// bitwise unchanged through [`Func::call`].
+#[hegel::test]
+fn host_identity_func_roundtrips_arbitrary_values(tc: hegel::TestCase) {
+    let mut store = test_setup();
+    let types: Vec<ValType> = tc.draw(
+        generators::vecs(generators::sampled_from(vec![
+            ValType::I32,
+            ValType::I64,
+            ValType::F32,
+            ValType::F64,
+        ]))
+        .max_size(16),
+    );
+    let params: Vec<Val> = types.iter().map(|ty| draw_val_of_type(&tc, *ty)).collect();
+    let func_ty = FuncType::new(types.iter().copied(), types.iter().copied());
+    let identity = Func::new(&mut store, func_ty, |_caller, params, results| {
+        results.clone_from_slice(params);
+        Ok(())
+    });
+    let mut results: Vec<Val> = types.iter().map(|ty| Val::default_for_ty(*ty)).collect();
+    identity.call(&mut store, &params, &mut results).unwrap();
+    assert_eq!(params.len(), results.len());
+    for (param, result) in params.iter().zip(&results) {
+        assert_val_bits_eq(param, result);
+    }
+}
+
+/// Property: a numeric value passed from the host into a Wasm function,
+/// through an imported identity host function, and back out to the host
+/// arrives bitwise unchanged (Wasm -> host -> Wasm value roundtrip).
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn value_roundtrips_through_wasm_and_host(tc: hegel::TestCase) {
+    let ty = draw_num_val_type(&tc);
+    let value = draw_val_of_type(&tc, ty);
+    let ty_wat = match ty {
+        ValType::I32 => "i32",
+        ValType::I64 => "i64",
+        ValType::F32 => "f32",
+        ValType::F64 => "f64",
+        ty => panic!("unsupported value type: {ty:?}"),
+    };
+    let wat = format!(
+        r#"
+        (module
+            (import "env" "id" (func $id (param {ty_wat}) (result {ty_wat})))
+            (func (export "call_id") (param $x {ty_wat}) (result {ty_wat})
+                (call $id (local.get $x))
+            )
+        )"#
+    );
+    let mut store = test_setup();
+    let engine = store.engine().clone();
+    let host_id = Func::new(
+        &mut store,
+        FuncType::new([ty], [ty]),
+        |_caller, params, results| {
+            results.clone_from_slice(params);
+            Ok(())
+        },
+    );
+    let mut linker = Linker::<()>::new(&engine);
+    linker.define("env", "id", host_id).unwrap();
+    let module = Module::new(&engine, wat.as_str()).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let func = instance.get_func(&store, "call_id").unwrap();
+    let mut results = [Val::default_for_ty(ty)];
+    func.call(&mut store, &[value.clone()], &mut results)
+        .unwrap();
+    assert_val_bits_eq(&value, &results[0]);
+}
