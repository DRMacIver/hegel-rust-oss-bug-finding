+// ---------------------------------------------------------------------------
+// Property-based stateful model test (hegel) for the `Memory` API.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+/// The default Wasm page size in bytes.
+const PAGE_SIZE: usize = 65536;
+
+/// Stateful model test: a Wasmi [`Memory`] must behave exactly like a plain
+/// `Vec<u8>` under `read`, `write` and `grow`, including agreement on which
+/// accesses are out of bounds.
+struct MemoryMachine {
+    store: Store<()>,
+    memory: Memory,
+    /// Reference model of the full memory contents.
+    model: Vec<u8>,
+    /// The maximum size of the memory in pages.
+    max_pages: u64,
+}
+
+#[hegel::state_machine]
+impl MemoryMachine {
+    #[rule]
+    fn write(&mut self, tc: hegel::TestCase) {
+        let len = self.model.len();
+        // Offsets may point past the current size to exercise the
+        // out-of-bounds error path.
+        let offset = tc.draw(generators::integers::<usize>().max_value(len + PAGE_SIZE));
+        let data: Vec<u8> = tc.draw(generators::binary().max_size(64));
+        let result = self.memory.write(&mut self.store, offset, &data);
+        let in_bounds = offset
+            .checked_add(data.len())
+            .is_some_and(|end| end <= len);
+        assert_eq!(
+            result.is_ok(),
+            in_bounds,
+            "write of {} bytes at offset {offset} with memory size {len}: {result:?}",
+            data.len(),
+        );
+        if in_bounds {
+            self.model[offset..offset + data.len()].copy_from_slice(&data);
+        }
+    }
+
+    #[rule]
+    fn read(&mut self, tc: hegel::TestCase) {
+        let len = self.model.len();
+        let offset = tc.draw(generators::integers::<usize>().max_value(len + PAGE_SIZE));
+        let read_len = tc.draw(generators::integers::<usize>().max_value(128));
+        let mut buffer = vec![0xA5; read_len];
+        let result = self.memory.read(&self.store, offset, &mut buffer);
+        let in_bounds = offset.checked_add(read_len).is_some_and(|end| end <= len);
+        assert_eq!(
+            result.is_ok(),
+            in_bounds,
+            "read of {read_len} bytes at offset {offset} with memory size {len}: {result:?}",
+        );
+        if in_bounds {
+            assert_eq!(buffer, &self.model[offset..offset + read_len]);
+        }
+    }
+
+    #[rule]
+    fn grow(&mut self, tc: hegel::TestCase) {
+        let current_pages = self.memory.size(&self.store);
+        let delta = tc.draw(generators::integers::<u64>().max_value(6));
+        let result = self.memory.grow(&mut self.store, delta);
+        if current_pages + delta <= self.max_pages {
+            // Growing within the maximum returns the previous size in pages
+            // and zero-initializes the new pages.
+            assert_eq!(result.unwrap(), current_pages);
+            let new_len = self.model.len() + delta as usize * PAGE_SIZE;
+            self.model.resize(new_len, 0);
+        } else {
+            assert!(
+                result.is_err(),
+                "growing from {current_pages} by {delta} pages exceeds the maximum \
+                 of {} pages but succeeded",
+                self.max_pages,
+            );
+        }
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _tc: hegel::TestCase) {
+        assert_eq!(self.memory.data_size(&self.store), self.model.len());
+        assert_eq!(
+            self.memory.size(&self.store),
+            (self.model.len() / PAGE_SIZE) as u64
+        );
+        assert_eq!(self.memory.data(&self.store), &self.model[..]);
+    }
+}
+
+/// Property: the [`Memory`] API (read/write/grow/data) behaves exactly like
+/// a plain `Vec<u8>` reference model, including out-of-bounds error cases.
+#[hegel::test]
+fn memory_behaves_like_byte_vec_model(tc: hegel::TestCase) {
+    // Small page limits keep the model comparison cheap; this protects the
+    // test's resources, not the library's contract.
+    let max_pages = tc.draw(generators::integers::<u64>().max_value(4));
+    let initial_pages = tc.draw(generators::integers::<u64>().max_value(max_pages));
+    let engine = Engine::default();
+    let mut store = Store::new(&engine, ());
+    let ty = MemoryType::new(initial_pages as u32, Some(max_pages as u32));
+    let memory = Memory::new(&mut store, ty).unwrap();
+    let machine = MemoryMachine {
+        store,
+        memory,
+        model: vec![0; initial_pages as usize * PAGE_SIZE],
+        max_pages,
+    };
+    hegel::stateful::run(machine, tc);
+}
