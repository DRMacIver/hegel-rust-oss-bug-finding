+//! Property-based tests that compile randomly generated Wasm arithmetic
+//! expression modules and compare Wasmi's execution results against a
+//! Rust-side reference interpreter implementing the Wasm `i32` operator
+//! semantics.
+//!
+//! These tests use the `hegel` property-based testing library.
+
+use hegel::generators::{self, Generator};
+use wasmi::{CompilationMode, Config, Engine, Linker, Module, Store, TrapCode};
+
+/// A randomly generated Wasm `i32` expression over two parameters `$a` and `$b`.
+#[derive(Debug, Clone)]
+pub enum Expr {
+    /// An `i32.const` constant.
+    Const(i32),
+    /// A `local.get $a` of the first function parameter.
+    ParamA,
+    /// A `local.get $b` of the second function parameter.
+    ParamB,
+    /// A unary `i32` operator applied to a sub-expression.
+    Unop(Unop, Box<Expr>),
+    /// A binary `i32` operator applied to two sub-expressions.
+    Binop(Binop, Box<Expr>, Box<Expr>),
+}
+
+/// Unary Wasm `i32` operators.
+#[derive(Debug, Clone, Copy)]
+pub enum Unop {
+    Clz,
+    Ctz,
+    Popcnt,
+    Eqz,
+}
+
+/// Binary Wasm `i32` operators.
+#[derive(Debug, Clone, Copy)]
+pub enum Binop {
+    Add,
+    Sub,
+    Mul,
+    DivS,
+    DivU,
+    RemS,
+    RemU,
+    And,
+    Or,
+    Xor,
+    Shl,
+    ShrS,
+    ShrU,
+    Rotl,
+    Rotr,
+    Eq,
+    Ne,
+    LtS,
+    LtU,
+    GtS,
+    GtU,
+    LeS,
+    LeU,
+    GeS,
+    GeU,
+}
+
+/// All binary operators, used for `sampled_from`.
+const ALL_BINOPS: &[Binop] = &[
+    Binop::Add,
+    Binop::Sub,
+    Binop::Mul,
+    Binop::DivS,
+    Binop::DivU,
+    Binop::RemS,
+    Binop::RemU,
+    Binop::And,
+    Binop::Or,
+    Binop::Xor,
+    Binop::Shl,
+    Binop::ShrS,
+    Binop::ShrU,
+    Binop::Rotl,
+    Binop::Rotr,
+    Binop::Eq,
+    Binop::Ne,
+    Binop::LtS,
+    Binop::LtU,
+    Binop::GtS,
+    Binop::GtU,
+    Binop::LeS,
+    Binop::LeU,
+    Binop::GeS,
+    Binop::GeU,
+];
+
+impl Unop {
+    fn wat(self) -> &'static str {
+        match self {
+            Self::Clz => "i32.clz",
+            Self::Ctz => "i32.ctz",
+            Self::Popcnt => "i32.popcnt",
+            Self::Eqz => "i32.eqz",
+        }
+    }
+}
+
+impl Binop {
+    fn wat(self) -> &'static str {
+        match self {
+            Self::Add => "i32.add",
+            Self::Sub => "i32.sub",
+            Self::Mul => "i32.mul",
+            Self::DivS => "i32.div_s",
+            Self::DivU => "i32.div_u",
+            Self::RemS => "i32.rem_s",
+            Self::RemU => "i32.rem_u",
+            Self::And => "i32.and",
+            Self::Or => "i32.or",
+            Self::Xor => "i32.xor",
+            Self::Shl => "i32.shl",
+            Self::ShrS => "i32.shr_s",
+            Self::ShrU => "i32.shr_u",
+            Self::Rotl => "i32.rotl",
+            Self::Rotr => "i32.rotr",
+            Self::Eq => "i32.eq",
+            Self::Ne => "i32.ne",
+            Self::LtS => "i32.lt_s",
+            Self::LtU => "i32.lt_u",
+            Self::GtS => "i32.gt_s",
+            Self::GtU => "i32.gt_u",
+            Self::LeS => "i32.le_s",
+            Self::LeU => "i32.le_u",
+            Self::GeS => "i32.ge_s",
+            Self::GeU => "i32.ge_u",
+        }
+    }
+}
+
+impl Expr {
+    /// Renders `self` as folded Wasm text format expression.
+    pub fn to_wat(&self) -> String {
+        match self {
+            Self::Const(c) => format!("(i32.const {c})"),
+            Self::ParamA => "(local.get $a)".to_string(),
+            Self::ParamB => "(local.get $b)".to_string(),
+            Self::Unop(op, inner) => format!("({} {})", op.wat(), inner.to_wat()),
+            Self::Binop(op, lhs, rhs) => {
+                format!("({} {} {})", op.wat(), lhs.to_wat(), rhs.to_wat())
+            }
+        }
+    }
+
+    /// Reference interpreter implementing the Wasm `i32` operator semantics.
+    ///
+    /// Returns the same result (or trap) that a spec-conforming Wasm engine
+    /// must produce for the expression with parameters `a` and `b`.
+    pub fn eval(&self, a: i32, b: i32) -> Result<i32, TrapCode> {
+        Ok(match self {
+            Self::Const(c) => *c,
+            Self::ParamA => a,
+            Self::ParamB => b,
+            Self::Unop(op, inner) => {
+                let x = inner.eval(a, b)?;
+                match op {
+                    Unop::Clz => x.leading_zeros() as i32,
+                    Unop::Ctz => x.trailing_zeros() as i32,
+                    Unop::Popcnt => x.count_ones() as i32,
+                    Unop::Eqz => (x == 0) as i32,
+                }
+            }
+            Self::Binop(op, lhs, rhs) => {
+                let l = lhs.eval(a, b)?;
+                let r = rhs.eval(a, b)?;
+                match op {
+                    Binop::Add => l.wrapping_add(r),
+                    Binop::Sub => l.wrapping_sub(r),
+                    Binop::Mul => l.wrapping_mul(r),
+                    Binop::DivS => {
+                        if r == 0 {
+                            return Err(TrapCode::IntegerDivisionByZero);
+                        }
+                        if l == i32::MIN && r == -1 {
+                            return Err(TrapCode::IntegerOverflow);
+                        }
+                        l / r
+                    }
+                    Binop::DivU => {
+                        if r == 0 {
+                            return Err(TrapCode::IntegerDivisionByZero);
+                        }
+                        ((l as u32) / (r as u32)) as i32
+                    }
+                    Binop::RemS => {
+                        if r == 0 {
+                            return Err(TrapCode::IntegerDivisionByZero);
+                        }
+                        // Wasm: `i32::MIN rem_s -1` is defined as 0 (no trap).
+                        l.wrapping_rem(r)
+                    }
+                    Binop::RemU => {
+                        if r == 0 {
+                            return Err(TrapCode::IntegerDivisionByZero);
+                        }
+                        ((l as u32) % (r as u32)) as i32
+                    }
+                    Binop::And => l & r,
+                    Binop::Or => l | r,
+                    Binop::Xor => l ^ r,
+                    // Wasm masks the shift amount by 31, as does `wrapping_shl/shr`.
+                    Binop::Shl => l.wrapping_shl(r as u32),
+                    Binop::ShrS => l.wrapping_shr(r as u32),
+                    Binop::ShrU => ((l as u32).wrapping_shr(r as u32)) as i32,
+                    Binop::Rotl => l.rotate_left((r as u32) % 32),
+                    Binop::Rotr => l.rotate_right((r as u32) % 32),
+                    Binop::Eq => (l == r) as i32,
+                    Binop::Ne => (l != r) as i32,
+                    Binop::LtS => (l < r) as i32,
+                    Binop::LtU => ((l as u32) < (r as u32)) as i32,
+                    Binop::GtS => (l > r) as i32,
+                    Binop::GtU => ((l as u32) > (r as u32)) as i32,
+                    Binop::LeS => (l <= r) as i32,
+                    Binop::LeU => ((l as u32) <= (r as u32)) as i32,
+                    Binop::GeS => (l >= r) as i32,
+                    Binop::GeU => ((l as u32) >= (r as u32)) as i32,
+                }
+            }
+        })
+    }
+}
+
+/// Generator for random [`Expr`] trees of at most the given `depth`.
+///
+/// Recursive generators cannot use `#[hegel::composite]`, so this follows
+/// the `compose!` + `boxed()` pattern.
+pub fn expr_trees(depth: u32) -> generators::BoxedGenerator<'static, Expr> {
+    hegel::compose!(|tc| {
+        let make_leaf = depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) == 0;
+        if make_leaf {
+            match tc.draw(generators::integers::<u8>().max_value(3)) {
+                0 => Expr::ParamA,
+                1 => Expr::ParamB,
+                _ => Expr::Const(tc.draw(interesting_i32())),
+            }
+        } else if tc.draw(generators::integers::<u8>().max_value(4)) == 0 {
+            let op = tc.draw(generators::sampled_from(vec![
+                Unop::Clz,
+                Unop::Ctz,
+                Unop::Popcnt,
+                Unop::Eqz,
+            ]));
+            Expr::Unop(op, Box::new(tc.draw(expr_trees(depth - 1))))
+        } else {
+            let op = tc.draw(generators::sampled_from(ALL_BINOPS.to_vec()));
+            let lhs = tc.draw(expr_trees(depth - 1));
+            let rhs = tc.draw(expr_trees(depth - 1));
+            Expr::Binop(op, Box::new(lhs), Box::new(rhs))
+        }
+    })
+    .boxed()
+}
+
+/// Generator for `i32` values boosting the boundary values.
+///
+/// Boundary conjunctions (e.g. `i32::MIN / -1`) are unlikely under uniform
+/// generation, so boundaries are boosted explicitly per the hegel skill.
+#[hegel::composite]
+pub fn interesting_i32(tc: hegel::TestCase) -> i32 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<i32>(),
+        generators::sampled_from(vec![0, 1, -1, 2, 31, 32, i32::MIN, i32::MAX]),
+    ))
+}
+
+/// Draws a random expression together with its two `i32` arguments.
+pub fn draw_expr_and_args(tc: &hegel::TestCase) -> (Expr, i32, i32) {
+    let depth = tc.draw(generators::integers::<u32>().max_value(6));
+    let expr = tc.draw(expr_trees(depth));
+    let a = tc.draw(interesting_i32());
+    let b = tc.draw(interesting_i32());
+    (expr, a, b)
+}
+
+/// Wraps the expression into a Wasm module exporting it as function `"eval"`.
+pub fn expr_module_wat(expr: &Expr) -> String {
+    format!(
+        "(module (func (export \"eval\") (param $a i32) (param $b i32) (result i32) {}))",
+        expr.to_wat()
+    )
+}
+
+/// Compiles and runs the given expression module with Wasmi.
+///
+/// Returns the execution outcome (result value or trap code) and,
+/// if `fuel` is `Some`, the remaining fuel after the call.
+///
+/// # Panics
+///
+/// If the module fails to compile or instantiate: the generated modules
+/// are valid Wasm by construction, so such a failure is itself a bug.
+pub fn run_expr_module(
+    mode: CompilationMode,
+    fuel: Option<u64>,
+    wat: &str,
+    a: i32,
+    b: i32,
+) -> (Result<i32, TrapCode>, Option<u64>) {
+    let mut config = Config::default();
+    config.compilation_mode(mode);
+    config.consume_fuel(fuel.is_some());
+    let engine = Engine::new(&config);
+    let module = Module::new(&engine, wat)
+        .unwrap_or_else(|err| panic!("generated module must compile but got: {err}\nwat: {wat}"));
+    let mut store = Store::new(&engine, ());
+    if let Some(fuel) = fuel {
+        store.set_fuel(fuel).unwrap();
+    }
+    let linker = Linker::<()>::new(&engine);
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap_or_else(|err| panic!("generated module must instantiate but got: {err}"));
+    let func = instance
+        .get_func(&store, "eval")
+        .unwrap()
+        .typed::<(i32, i32), i32>(&store)
+        .unwrap();
+    let result = func.call(&mut store, (a, b)).map_err(|err| {
+        err.as_trap_code()
+            .unwrap_or_else(|| panic!("expected a trap error but got: {err}"))
+    });
+    let remaining = fuel.map(|_| store.get_fuel().unwrap());
+    (result, remaining)
+}
+
+/// Property: Wasmi evaluates generated `i32` expression modules to exactly
+/// the result (or trap) computed by a Rust-side reference interpreter of the
+/// Wasm operator semantics.
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn wasmi_execution_matches_reference_interpreter(tc: hegel::TestCase) {
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let expected = expr.eval(a, b);
+    let (actual, _) = run_expr_module(CompilationMode::Eager, None, &wat, a, b);
+    assert_eq!(actual, expected);
+}
+
+/// Property: executing the same module with the same inputs always produces
+/// the same outcome (value or trap), independently of the engine instance
+/// and of the chosen compilation mode (eager vs. lazy).
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn execution_is_deterministic_across_engines_and_compilation_modes(tc: hegel::TestCase) {
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let modes = || {
+        generators::sampled_from(vec![
+            CompilationMode::Eager,
+            CompilationMode::LazyTranslation,
+            CompilationMode::Lazy,
+        ])
+    };
+    let mode1 = tc.draw(modes());
+    let mode2 = tc.draw(modes());
+    let (outcome1, _) = run_expr_module(mode1, None, &wat, a, b);
+    let (outcome2, _) = run_expr_module(mode2, None, &wat, a, b);
+    assert_eq!(
+        outcome1, outcome2,
+        "outcome differs between {mode1:?} and {mode2:?}"
+    );
+}
+
+/// Property: calling an exported function via the untyped `Func::call` API
+/// and via the `TypedFunc` API produces the same outcome.
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn typed_and_untyped_calls_agree(tc: hegel::TestCase) {
+    use wasmi::Val;
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let engine = Engine::default();
+    let module = Module::new(&engine, wat.as_str()).unwrap();
+    let mut store = Store::new(&engine, ());
+    let linker = Linker::<()>::new(&engine);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let func = instance.get_func(&store, "eval").unwrap();
+    // The module is stateless, so both calls run under identical conditions.
+    let untyped: Result<i32, TrapCode> = {
+        let mut results = [Val::I32(0)];
+        func.call(&mut store, &[Val::I32(a), Val::I32(b)], &mut results)
+            .map(|_| results[0].i32().unwrap())
+            .map_err(|err| err.as_trap_code().expect("expected a trap error"))
+    };
+    let typed: Result<i32, TrapCode> = func
+        .typed::<(i32, i32), i32>(&store)
+        .unwrap()
+        .call(&mut store, (a, b))
+        .map_err(|err| err.as_trap_code().expect("expected a trap error"));
+    assert_eq!(untyped, typed);
+}
