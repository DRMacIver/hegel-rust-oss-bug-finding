diff --git a/tests/modpow.rs b/tests/modpow.rs
index d7a247b..d331bdb 100644
--- a/tests/modpow.rs
+++ b/tests/modpow.rs
@@ -179,3 +179,97 @@ mod bigint {
         check_modpow(b, e, m, r);
     }
 }
+
+/// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use num_bigint::BigInt;
+    use num_integer::Integer;
+    use num_traits::{One, Signed, Zero};
+    use std::str::FromStr;
+
+    /// Mix of machine-word-range values (hits `MIN`/`MAX`/`0` boundaries) and
+    /// decimal strings much wider than any machine type.
+    #[hegel::composite]
+    fn big_ints(tc: hegel::TestCase) -> BigInt {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i128>().map(BigInt::from),
+            generators::from_regex(r"-?[1-9][0-9]{0,80}")
+                .map(|s: String| BigInt::from_str(&s).unwrap()),
+        ))
+    }
+
+    // modpow with a small exponent must match naive repeated multiplication
+    // reduced with mod_floor, and land in the documented interval:
+    // [0, m) for m > 0, (m, 0] for m < 0.
+    #[hegel::test]
+    fn hegel_modpow_matches_naive(tc: hegel::TestCase) {
+        let base = tc.draw(big_ints());
+        let m = tc.draw(big_ints());
+        tc.assume(!m.is_zero());
+        let e = tc.draw(generators::integers::<u32>().max_value(24));
+        let result = base.modpow(&BigInt::from(e), &m);
+        let mut expected = BigInt::one().mod_floor(&m);
+        for _ in 0..e {
+            expected = (&expected * &base).mod_floor(&m);
+        }
+        assert_eq!(result, expected);
+        if m.is_positive() {
+            assert!(!result.is_negative() && result < m);
+        } else {
+            assert!(!result.is_positive() && result > m);
+        }
+    }
+
+    // modinv exists iff gcd(a, m) == 1 (documented); when it exists,
+    // a * x ≡ 1 (mod m) and x lies in the documented mod_floor interval.
+    //
+    // m == 1 and m == -1 are excluded here because they hit the known
+    // interval bug pinned by `hegel_modinv_unit_modulus_interval` below.
+    #[hegel::test]
+    fn hegel_modinv_contract(tc: hegel::TestCase) {
+        let a = tc.draw(big_ints());
+        let m = tc.draw(big_ints());
+        tc.assume(!m.is_zero() && !m.abs().is_one());
+        let g = a.gcd(&m);
+        match a.modinv(&m) {
+            None => assert!(!g.is_one()),
+            Some(x) => {
+                assert!(g.is_one());
+                assert_eq!((&a * &x).mod_floor(&m), BigInt::one().mod_floor(&m));
+                if m.is_positive() {
+                    assert!(!x.is_negative() && x < m);
+                } else {
+                    assert!(!x.is_positive() && x > m);
+                }
+            }
+        }
+    }
+
+    // KNOWN FAILURE: modinv violates its documented result interval when the
+    // modulus is 1 or -1. The docs promise the solution lies in [0, m) for
+    // m > 0 (so for m == 1 the only legal answer is 0) and in (m, 0] for
+    // m < 0 (so for m == -1 the only legal answer is 0). But the sign fixup
+    // in `BigInt::modinv` (src/bigint.rs) computes `&modulus.data - result`
+    // when the signs differ, and the unsigned inverse `result` is 0 whenever
+    // |m| == 1, so it returns m.abs() / -m.abs() instead of 0:
+    //   modinv(-1, 1) == Some(1)   (expected Some(0))
+    //   modinv(1, -1) == Some(-1)  (expected Some(0))
+    // The generator below makes every drawn case hit the bug, so this test
+    // fails deterministically until the bug is fixed.
+    #[hegel::test]
+    fn hegel_modinv_unit_modulus_interval(tc: hegel::TestCase) {
+        let a = tc.draw(big_ints());
+        tc.assume(!a.is_zero());
+        // Pick the unit modulus whose sign differs from a's, which is the
+        // combination that routes through the buggy `modulus - 0` branch.
+        let m = if a.is_negative() {
+            BigInt::one()
+        } else {
+            -BigInt::one()
+        };
+        let x = a.modinv(&m).expect("gcd(a, ±1) is always 1");
+        // The documented interval for |m| == 1 contains only zero.
+        assert!(x.is_zero(), "modinv({}, {}) = {} lies outside the documented interval", a, m, x);
+    }
+}
