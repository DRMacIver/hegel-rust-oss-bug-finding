+// ---------------------------------------------------------------------------
+// Hegel property-based tests: deserializer robustness.
+// ---------------------------------------------------------------------------
+
+mod hegel_props {
+    use hegel::generators;
+    use serde::Deserialize;
+    use std::collections::BTreeMap;
+
+    #[derive(Deserialize, Debug)]
+    #[allow(dead_code)]
+    enum AnyEnum {
+        Unit,
+        NewType(i64),
+        Tuple(u8, String),
+        Struct { a: Option<u32>, b: Vec<i16> },
+    }
+
+    #[derive(Deserialize, Debug)]
+    #[allow(dead_code)]
+    struct AnyStruct {
+        i: i64,
+        s: String,
+        v: Vec<u8>,
+        e: AnyEnum,
+    }
+
+    /// Robustness: `from_slice` must return an error (never panic) for any
+    /// arbitrary byte input, whatever the target type.
+    #[hegel::test]
+    fn from_slice_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(300));
+        match tc.draw(generators::integers::<u8>().max_value(9)) {
+            0 => drop(rmp_serde::from_slice::<i64>(&bytes)),
+            1 => drop(rmp_serde::from_slice::<u128>(&bytes)),
+            2 => drop(rmp_serde::from_slice::<f64>(&bytes)),
+            3 => drop(rmp_serde::from_slice::<String>(&bytes)),
+            4 => drop(rmp_serde::from_slice::<Vec<u64>>(&bytes)),
+            5 => drop(rmp_serde::from_slice::<BTreeMap<String, String>>(&bytes)),
+            6 => drop(rmp_serde::from_slice::<Option<Vec<u8>>>(&bytes)),
+            7 => drop(rmp_serde::from_slice::<serde_bytes::ByteBuf>(&bytes)),
+            8 => drop(rmp_serde::from_slice::<(u8, String)>(&bytes)),
+            _ => drop(rmp_serde::from_slice::<AnyStruct>(&bytes)),
+        }
+    }
+}
