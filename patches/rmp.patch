diff --git a/rmpv/tests/decode.rs b/rmpv/tests/decode.rs
index 5430d9b..4c6407c 100644
--- a/rmpv/tests/decode.rs
+++ b/rmpv/tests/decode.rs
@@ -401,3 +401,105 @@ fn invalid_buf_size_arr() {
         Err(e) => panic!("Unexpected error: {e}"),
     }
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests: decoder robustness on arbitrary input.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+use rmpv::decode::read_value_ref;
+
+/// Structural equality comparing floats by bit pattern (NaN-safe).
+fn values_eq(a: &Value, b: &Value) -> bool {
+    match (a, b) {
+        (Value::F32(x), Value::F32(y)) => x.to_bits() == y.to_bits(),
+        (Value::F64(x), Value::F64(y)) => x.to_bits() == y.to_bits(),
+        (Value::Array(x), Value::Array(y)) => {
+            x.len() == y.len() && x.iter().zip(y).all(|(u, v)| values_eq(u, v))
+        }
+        (Value::Map(x), Value::Map(y)) => {
+            x.len() == y.len()
+                && x.iter()
+                    .zip(y)
+                    .all(|((ka, va), (kb, vb))| values_eq(ka, kb) && values_eq(va, vb))
+        }
+        _ => a == b,
+    }
+}
+
+/// Robustness: feeding completely arbitrary bytes to either decoder must
+/// never panic, and both decoders must agree on success/failure and on the
+/// decoded value.
+#[hegel::test]
+fn arbitrary_bytes_never_panic_and_decoders_agree(tc: hegel::TestCase) {
+    let bytes: Vec<u8> = tc.draw(generators::binary().max_size(300));
+
+    let owned = read_value(&mut &bytes[..]);
+    let by_ref = read_value_ref(&mut &bytes[..]);
+    match (owned, by_ref) {
+        (Ok(a), Ok(b)) => {
+            let b = b.to_owned();
+            assert!(values_eq(&a, &b), "read_value gave {a:?}, read_value_ref gave {b:?}");
+        }
+        (Err(_), Err(_)) => {}
+        (a, b) => panic!("decoders disagree on arbitrary input {bytes:02x?}: {a:?} vs {b:?}"),
+    }
+}
+
+/// Depth limiting: the recursion budget passed to
+/// `read_value_with_max_depth` is enforced exactly (each array level costs
+/// two units of budget: one for the value, one for the array payload),
+/// exceeding it yields `Error::DepthLimitExceeded`, and both decoders agree.
+///
+/// The nesting depth is capped at 250 levels to protect this test from the
+/// known debug-build stack overflow pinned by
+/// `known_bug_stack_overflow_within_max_depth` below; the cap protects the
+/// test process, not the library's contract.
+#[hegel::test]
+fn nesting_depth_limit_is_enforced_without_crashing(tc: hegel::TestCase) {
+    let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(250));
+    let max_depth = tc.draw(generators::integers::<usize>().max_value(600));
+    let mut bytes = vec![0x91; depth - 1]; // single-element arrays ...
+    bytes.push(0x90); // ... terminated by an empty array
+
+    let owned = rmpv::decode::read_value_with_max_depth(&mut &bytes[..], max_depth);
+    let by_ref = rmpv::decode::read_value_ref_with_max_depth(&mut &bytes[..], max_depth);
+    assert_eq!(
+        owned.is_ok(),
+        by_ref.is_ok(),
+        "decoders disagree at nesting depth {depth} (max_depth {max_depth}): {owned:?} vs {by_ref:?}"
+    );
+
+    if 2 * depth <= max_depth {
+        assert!(
+            owned.is_ok(),
+            "depth {depth} within budget {max_depth} failed: {owned:?}"
+        );
+    } else {
+        assert!(
+            matches!(owned, Err(Error::DepthLimitExceeded)),
+            "depth {depth} over budget {max_depth} gave {owned:?}"
+        );
+    }
+}
+
+/// KNOWN BUG (kept `#[ignore]`d because it aborts the process): in debug
+/// builds, `read_value` overflows the thread stack at roughly 380 levels of
+/// array nesting -- far below its own `MAX_DEPTH` guard of 1024, whose
+/// documented purpose is to bound recursion. In release builds the same
+/// input decodes fine (recursion is only limited at ~512 levels, where
+/// `DepthLimitExceeded` is returned as intended), so the guard constant is
+/// simply too large for debug-build stack frames. Discovered by the hegel
+/// property `nesting_depth_limit_is_enforced_without_crashing` before its
+/// depth cap was added.
+///
+/// Run with: cargo test -p rmpv --test decode -- --ignored
+/// (expect SIGABRT "has overflowed its stack" in debug profile)
+#[test]
+#[ignore = "aborts the process in debug builds: stack overflow within MAX_DEPTH"]
+fn known_bug_stack_overflow_within_max_depth() {
+    let depth = 380; // < MAX_DEPTH = 1024, yet overflows a debug-build stack
+    let mut bytes = vec![0x91; depth - 1];
+    bytes.push(0x90);
+    let _ = read_value(&mut &bytes[..]);
+}
diff --git a/rmpv/tests/mirror.rs b/rmpv/tests/mirror.rs
index f3b4165..cf507ec 100644
--- a/rmpv/tests/mirror.rs
+++ b/rmpv/tests/mirror.rs
@@ -43,3 +43,317 @@ quickcheck! {
         mirror_test(xs)
     }
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These extend the quickcheck mirror tests above to the full `Value` domain:
+// recursive values, integers at every marker-width boundary, float NaN bit
+// patterns, ext values and nested containers.
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+use rmpv::decode::read_value_ref;
+
+/// All width boundaries of the MessagePack unsigned integer formats.
+const U64_BOUNDARIES: [u64; 14] = [
+    0,
+    1,
+    127,
+    128,
+    255,
+    256,
+    65535,
+    65536,
+    4294967295,
+    4294967296,
+    i64::MAX as u64,
+    i64::MAX as u64 + 1,
+    u64::MAX - 1,
+    u64::MAX,
+];
+
+/// All width boundaries of the MessagePack signed integer formats.
+const I64_BOUNDARIES: [i64; 16] = [
+    i64::MIN,
+    i64::MIN + 1,
+    -2147483649,
+    -2147483648,
+    -32769,
+    -32768,
+    -129,
+    -128,
+    -33,
+    -32,
+    -1,
+    0,
+    1,
+    127,
+    128,
+    i64::MAX,
+];
+
+fn u64_values() -> generators::BoxedGenerator<'static, u64> {
+    hegel::one_of!(
+        generators::integers::<u64>().boxed(),
+        generators::sampled_from(U64_BOUNDARIES.to_vec()).boxed(),
+    )
+    .boxed()
+}
+
+fn i64_values() -> generators::BoxedGenerator<'static, i64> {
+    hegel::one_of!(
+        generators::integers::<i64>().boxed(),
+        generators::sampled_from(I64_BOUNDARIES.to_vec()).boxed(),
+    )
+    .boxed()
+}
+
+/// Generates an arbitrary `Value`, recursing up to `depth` container levels.
+///
+/// Strings are always valid UTF-8: `write_value` deliberately encodes
+/// invalid-UTF-8 `Value::String`s with the *bin* marker (see
+/// `rmpv/src/encode/value.rs`), so they decode as `Value::Binary` and do not
+/// round-trip by design.
+fn arbitrary_values(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+    hegel::compose!(|tc| {
+        let max_kind = if depth == 0 { 8 } else { 10 };
+        match tc.draw(generators::integers::<u8>().max_value(max_kind)) {
+            0 => Value::Nil,
+            1 => Value::Boolean(tc.draw(generators::booleans())),
+            2 => Value::from(tc.draw(u64_values())),
+            3 => Value::from(tc.draw(i64_values())),
+            // Floats from raw bits so NaN payloads and infinities are covered.
+            4 => Value::F32(f32::from_bits(tc.draw(generators::integers::<u32>()))),
+            5 => Value::F64(f64::from_bits(tc.draw(generators::integers::<u64>()))),
+            6 => Value::from(tc.draw(generators::text().max_size(40))),
+            7 => Value::Binary(tc.draw(generators::binary().max_size(40))),
+            8 => {
+                let ty = tc.draw(generators::integers::<i8>());
+                let data = tc.draw(generators::binary().max_size(40));
+                Value::Ext(ty, data)
+            }
+            9 => Value::Array(tc.draw(generators::vecs(arbitrary_values(depth - 1)).max_size(6))),
+            _ => Value::Map(tc.draw(
+                generators::vecs(generators::tuples!(
+                    arbitrary_values(depth - 1),
+                    arbitrary_values(depth - 1),
+                ))
+                .max_size(4),
+            )),
+        }
+    })
+    .boxed()
+}
+
+/// Structural equality that compares floats by bit pattern, so NaN values
+/// (which `PartialEq` reports unequal) still count as round-tripped.
+fn values_eq(a: &Value, b: &Value) -> bool {
+    match (a, b) {
+        (Value::F32(x), Value::F32(y)) => x.to_bits() == y.to_bits(),
+        (Value::F64(x), Value::F64(y)) => x.to_bits() == y.to_bits(),
+        (Value::Array(x), Value::Array(y)) => {
+            x.len() == y.len() && x.iter().zip(y).all(|(u, v)| values_eq(u, v))
+        }
+        (Value::Map(x), Value::Map(y)) => {
+            x.len() == y.len()
+                && x.iter()
+                    .zip(y)
+                    .all(|((ka, va), (kb, vb))| values_eq(ka, kb) && values_eq(va, vb))
+        }
+        _ => a == b,
+    }
+}
+
+/// Round-trip: `read_value` inverts `write_value` for every `Value`,
+/// including NaN bit patterns (compared bitwise).
+#[hegel::test]
+fn mirror_arbitrary_value(tc: hegel::TestCase) {
+    let val = tc.draw(arbitrary_values(3));
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    let out = read_value(&mut &buf[..]).unwrap();
+    assert!(values_eq(&val, &out), "wrote {val:?}, read back {out:?}");
+}
+
+/// Consistency: the zero-copy decoder agrees with the owned decoder on every
+/// valid encoding.
+#[hegel::test]
+fn mirror_value_ref_agrees_with_value(tc: hegel::TestCase) {
+    let val = tc.draw(arbitrary_values(3));
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    let owned = read_value(&mut &buf[..]).unwrap();
+    let by_ref = read_value_ref(&mut &buf[..]).unwrap().to_owned();
+    assert!(
+        values_eq(&owned, &by_ref),
+        "read_value gave {owned:?}, read_value_ref gave {by_ref:?}"
+    );
+}
+
+/// Expected (first byte, total encoded length) for an unsigned integer,
+/// derived independently from the MessagePack spec's smallest-width rule.
+fn expected_uint_encoding(n: u64) -> (u8, usize) {
+    if n < 128 {
+        (n as u8, 1) // positive fixint
+    } else if n < 256 {
+        (0xcc, 2) // uint 8
+    } else if n < 65536 {
+        (0xcd, 3) // uint 16
+    } else if n < 4294967296 {
+        (0xce, 5) // uint 32
+    } else {
+        (0xcf, 9) // uint 64
+    }
+}
+
+/// Expected (first byte, total encoded length) for a negative integer.
+fn expected_sint_encoding(n: i64) -> (u8, usize) {
+    assert!(n < 0);
+    if n >= -32 {
+        (n as u8, 1) // negative fixint, 0xe0..=0xff
+    } else if n >= -128 {
+        (0xd0, 2) // int 8
+    } else if n >= -32768 {
+        (0xd1, 3) // int 16
+    } else if n >= -2147483648 {
+        (0xd2, 5) // int 32
+    } else {
+        (0xd3, 9) // int 64
+    }
+}
+
+/// Spec conformance: `write_value` encodes every integer with the
+/// smallest-width marker ("a serializer SHOULD use the format which
+/// represents the data in the smallest number of bytes").
+#[hegel::test]
+fn integer_encoding_uses_smallest_width(tc: hegel::TestCase) {
+    let (val, (first, total)) = if tc.draw(generators::booleans()) {
+        let n = tc.draw(u64_values());
+        (Value::from(n), expected_uint_encoding(n))
+    } else {
+        let n = tc.draw(i64_values());
+        let expected = if n >= 0 {
+            expected_uint_encoding(n as u64)
+        } else {
+            expected_sint_encoding(n)
+        };
+        (Value::from(n), expected)
+    };
+
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    assert_eq!(buf[0], first, "wrong marker for {val:?}: {buf:02x?}");
+    assert_eq!(buf.len(), total, "wrong width for {val:?}: {buf:02x?}");
+}
+
+/// Spec conformance: str/bin/array/map length headers use the smallest-width
+/// format for the payload length.
+#[hegel::test]
+fn length_markers_use_smallest_width(tc: hegel::TestCase) {
+    let len: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().max_value(40).boxed(),
+        generators::sampled_from(vec![15, 16, 31, 32, 255, 256, 65535, 65536, 66000]).boxed(),
+    ));
+
+    // (value, expected first byte, header length, payload length)
+    let (val, first, header, payload) = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => {
+            let first_header = if len < 32 {
+                (0xa0 | len as u8, 1) // fixstr
+            } else if len < 256 {
+                (0xd9, 2) // str 8
+            } else if len < 65536 {
+                (0xda, 3) // str 16
+            } else {
+                (0xdb, 5) // str 32
+            };
+            (Value::from("a".repeat(len)), first_header.0, first_header.1, len)
+        }
+        1 => {
+            let first_header = if len < 256 {
+                (0xc4, 2) // bin 8
+            } else if len < 65536 {
+                (0xc5, 3) // bin 16
+            } else {
+                (0xc6, 5) // bin 32
+            };
+            (Value::Binary(vec![0u8; len]), first_header.0, first_header.1, len)
+        }
+        2 => {
+            let first_header = if len < 16 {
+                (0x90 | len as u8, 1) // fixarray
+            } else if len < 65536 {
+                (0xdc, 3) // array 16
+            } else {
+                (0xdd, 5) // array 32
+            };
+            // Nil elements: 1 byte each.
+            (Value::Array(vec![Value::Nil; len]), first_header.0, first_header.1, len)
+        }
+        _ => {
+            let first_header = if len < 16 {
+                (0x80 | len as u8, 1) // fixmap
+            } else if len < 65536 {
+                (0xde, 3) // map 16
+            } else {
+                (0xdf, 5) // map 32
+            };
+            // Nil key + Nil value: 2 bytes per entry.
+            (
+                Value::Map(vec![(Value::Nil, Value::Nil); len]),
+                first_header.0,
+                first_header.1,
+                2 * len,
+            )
+        }
+    };
+
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    assert_eq!(buf[0], first, "wrong marker for len {len}: {:02x?}", &buf[..buf.len().min(8)]);
+    assert_eq!(buf.len(), header + payload, "wrong total size for len {len}");
+}
+
+/// Every strict prefix of a valid encoding is an incomplete value: both
+/// decoders must return an error (and must not panic).
+#[hegel::test]
+fn truncated_encoding_fails_to_decode(tc: hegel::TestCase) {
+    let val = tc.draw(arbitrary_values(3));
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    let cut = tc.draw(generators::integers::<usize>().max_value(buf.len() - 1));
+
+    assert!(
+        read_value(&mut &buf[..cut]).is_err(),
+        "read_value decoded a strict prefix ({cut}/{} bytes) of {val:?}",
+        buf.len()
+    );
+    assert!(
+        read_value_ref(&mut &buf[..cut]).is_err(),
+        "read_value_ref decoded a strict prefix ({cut}/{} bytes) of {val:?}",
+        buf.len()
+    );
+}
+
+/// Robustness/consistency: corrupting one byte of a valid encoding must never
+/// panic either decoder, and both decoders must still agree on the result.
+#[hegel::test]
+fn mutated_encoding_never_panics_and_decoders_agree(tc: hegel::TestCase) {
+    let val = tc.draw(arbitrary_values(3));
+    let mut buf = Vec::new();
+    write_value(&mut buf, &val).unwrap();
+    let idx = tc.draw(generators::integers::<usize>().max_value(buf.len() - 1));
+    buf[idx] = tc.draw(generators::integers::<u8>());
+
+    let owned = read_value(&mut &buf[..]);
+    let by_ref = read_value_ref(&mut &buf[..]);
+    match (owned, by_ref) {
+        (Ok(a), Ok(b)) => {
+            let b = b.to_owned();
+            assert!(values_eq(&a, &b), "read_value gave {a:?}, read_value_ref gave {b:?}");
+        }
+        (Err(_), Err(_)) => {}
+        (a, b) => panic!("decoders disagree on corrupted input: {a:?} vs {b:?}"),
+    }
+}
