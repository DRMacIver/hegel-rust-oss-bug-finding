+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+// ---------------------------------------------------------------------------
+
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use rmp_serde::{from_slice, to_vec, Deserializer, Serializer};
+    use serde::{Deserialize, Serialize};
+    use std::collections::BTreeMap;
+    use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+    const U64_BOUNDARIES: [u64; 14] = [
+        0,
+        1,
+        127,
+        128,
+        255,
+        256,
+        65535,
+        65536,
+        4294967295,
+        4294967296,
+        i64::MAX as u64,
+        i64::MAX as u64 + 1,
+        u64::MAX - 1,
+        u64::MAX,
+    ];
+
+    const I64_BOUNDARIES: [i64; 16] = [
+        i64::MIN,
+        i64::MIN + 1,
+        -2147483649,
+        -2147483648,
+        -32769,
+        -32768,
+        -129,
+        -128,
+        -33,
+        -32,
+        -1,
+        0,
+        1,
+        127,
+        128,
+        i64::MAX,
+    ];
+
+    fn u64_values() -> generators::BoxedGenerator<'static, u64> {
+        hegel::one_of!(
+            generators::integers::<u64>().boxed(),
+            generators::sampled_from(U64_BOUNDARIES.to_vec()).boxed(),
+        )
+        .boxed()
+    }
+
+    fn i64_values() -> generators::BoxedGenerator<'static, i64> {
+        hegel::one_of!(
+            generators::integers::<i64>().boxed(),
+            generators::sampled_from(I64_BOUNDARIES.to_vec()).boxed(),
+        )
+        .boxed()
+    }
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+    enum AnyEnum {
+        Unit,
+        NewType(i64),
+        Tuple(u8, String),
+        Struct { a: Option<u32>, b: Vec<i16> },
+    }
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+    struct Inner {
+        s: String,
+        bytes: serde_bytes::ByteBuf,
+        opt: Option<i64>,
+    }
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+    struct Outer {
+        i: i64,
+        u: u64,
+        f: f64,
+        b: bool,
+        c: char,
+        t: (u8, i32, String),
+        inner: Inner,
+        e: AnyEnum,
+        m: BTreeMap<String, i32>,
+        ip: IpAddr,
+    }
+
+    #[hegel::composite]
+    fn any_enums(tc: hegel::TestCase) -> AnyEnum {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => AnyEnum::Unit,
+            1 => AnyEnum::NewType(tc.draw(i64_values())),
+            2 => AnyEnum::Tuple(
+                tc.draw(generators::integers::<u8>()),
+                tc.draw(generators::text().max_size(20)),
+            ),
+            _ => AnyEnum::Struct {
+                a: tc.draw(generators::optional(generators::integers::<u32>())),
+                b: tc.draw(generators::vecs(generators::integers::<i16>()).max_size(8)),
+            },
+        }
+    }
+
+    #[hegel::composite]
+    fn outers(tc: hegel::TestCase) -> Outer {
+        Outer {
+            i: tc.draw(i64_values()),
+            u: tc.draw(u64_values()),
+            // Non-NaN because `Outer` is compared with `PartialEq`; NaN bit
+            // patterns are covered by `float_roundtrip_preserves_bits`.
+            f: tc.draw(generators::floats::<f64>().allow_nan(false)),
+            b: tc.draw(generators::booleans()),
+            c: char::from_u32(tc.draw(generators::integers::<u32>().max_value(0x10FFFF)))
+                .unwrap_or('\u{FFFD}'),
+            t: (
+                tc.draw(generators::integers::<u8>()),
+                tc.draw(generators::integers::<i32>()),
+                tc.draw(generators::text().max_size(20)),
+            ),
+            inner: Inner {
+                s: tc.draw(generators::text().max_size(20)),
+                bytes: serde_bytes::ByteBuf::from(tc.draw(generators::binary().max_size(20))),
+                opt: tc.draw(generators::optional(generators::integers::<i64>())),
+            },
+            e: tc.draw(any_enums()),
+            m: tc.draw(generators::hashmaps(
+                generators::text().max_size(10),
+                generators::integers::<i32>(),
+            ).max_size(5))
+                .into_iter()
+                .collect(),
+            ip: if tc.draw(generators::booleans()) {
+                IpAddr::V4(Ipv4Addr::from(tc.draw(generators::integers::<u32>())))
+            } else {
+                IpAddr::V6(Ipv6Addr::from(tc.draw(generators::integers::<u128>())))
+            },
+        }
+    }
+
+    /// Round-trip of a struct/enum tree under every serializer configuration:
+    /// struct-as-tuple vs struct-as-map crossed with the human-readable flag
+    /// (the deserializer's human-readable flag must match the serializer's).
+    #[hegel::test]
+    fn struct_roundtrip_under_any_config(tc: hegel::TestCase) {
+        let val = tc.draw(outers());
+        let named = tc.draw(generators::booleans());
+        let human = tc.draw(generators::booleans());
+
+        let mut buf = Vec::new();
+        match (named, human) {
+            (false, false) => val.serialize(&mut Serializer::new(&mut buf)).unwrap(),
+            (true, false) => val
+                .serialize(&mut Serializer::new(&mut buf).with_struct_map())
+                .unwrap(),
+            (false, true) => val
+                .serialize(&mut Serializer::new(&mut buf).with_human_readable())
+                .unwrap(),
+            (true, true) => val
+                .serialize(&mut Serializer::new(&mut buf).with_struct_map().with_human_readable())
+                .unwrap(),
+        }
+
+        let back: Outer = if human {
+            let mut de = Deserializer::new(&buf[..]).with_human_readable();
+            Deserialize::deserialize(&mut de).unwrap()
+        } else {
+            from_slice(&buf).unwrap()
+        };
+        assert_eq!(val, back, "config: named={named}, human={human}");
+    }
+
+    /// Round-trip for every integer width, including 128-bit integers (which
+    /// take a dedicated bin-16 encoding path).
+    #[hegel::test]
+    fn integer_roundtrip_all_widths(tc: hegel::TestCase) {
+        match tc.draw(generators::integers::<u8>().max_value(9)) {
+            0 => {
+                let v = tc.draw(generators::integers::<i8>());
+                assert_eq!(v, from_slice::<i8>(&to_vec(&v).unwrap()).unwrap());
+            }
+            1 => {
+                let v = tc.draw(generators::integers::<i16>());
+                assert_eq!(v, from_slice::<i16>(&to_vec(&v).unwrap()).unwrap());
+            }
+            2 => {
+                let v = tc.draw(generators::integers::<i32>());
+                assert_eq!(v, from_slice::<i32>(&to_vec(&v).unwrap()).unwrap());
+            }
+            3 => {
+                let v = tc.draw(i64_values());
+                assert_eq!(v, from_slice::<i64>(&to_vec(&v).unwrap()).unwrap());
+            }
+            4 => {
+                let v = tc.draw(generators::integers::<i128>());
+                assert_eq!(v, from_slice::<i128>(&to_vec(&v).unwrap()).unwrap());
+            }
+            5 => {
+                let v = tc.draw(generators::integers::<u8>());
+                assert_eq!(v, from_slice::<u8>(&to_vec(&v).unwrap()).unwrap());
+            }
+            6 => {
+                let v = tc.draw(generators::integers::<u16>());
+                assert_eq!(v, from_slice::<u16>(&to_vec(&v).unwrap()).unwrap());
+            }
+            7 => {
+                let v = tc.draw(generators::integers::<u32>());
+                assert_eq!(v, from_slice::<u32>(&to_vec(&v).unwrap()).unwrap());
+            }
+            8 => {
+                let v = tc.draw(u64_values());
+                assert_eq!(v, from_slice::<u64>(&to_vec(&v).unwrap()).unwrap());
+            }
+            _ => {
+                let v = tc.draw(generators::integers::<u128>());
+                assert_eq!(v, from_slice::<u128>(&to_vec(&v).unwrap()).unwrap());
+            }
+        }
+    }
+
+    /// Round-trip for floats generated from raw bit patterns (NaN payloads,
+    /// infinities, subnormals), compared bitwise.
+    #[hegel::test]
+    fn float_roundtrip_preserves_bits(tc: hegel::TestCase) {
+        if tc.draw(generators::booleans()) {
+            let v = f32::from_bits(tc.draw(generators::integers::<u32>()));
+            let back: f32 = from_slice(&to_vec(&v).unwrap()).unwrap();
+            assert_eq!(v.to_bits(), back.to_bits(), "f32 {v:?} came back as {back:?}");
+        } else {
+            let v = f64::from_bits(tc.draw(generators::integers::<u64>()));
+            let back: f64 = from_slice(&to_vec(&v).unwrap()).unwrap();
+            assert_eq!(v.to_bits(), back.to_bits(), "f64 {v:?} came back as {back:?}");
+        }
+    }
+
+    /// Round-trip for common std types: strings (full Unicode), chars,
+    /// options, sequences, maps, tuples and byte buffers.
+    #[hegel::test]
+    fn std_types_roundtrip(tc: hegel::TestCase) {
+        match tc.draw(generators::integers::<u8>().max_value(6)) {
+            0 => {
+                let v: String = tc.draw(generators::text());
+                assert_eq!(v, from_slice::<String>(&to_vec(&v).unwrap()).unwrap());
+            }
+            1 => {
+                let v = char::from_u32(tc.draw(generators::integers::<u32>().max_value(0x10FFFF)))
+                    .unwrap_or('\u{FFFD}');
+                assert_eq!(v, from_slice::<char>(&to_vec(&v).unwrap()).unwrap());
+            }
+            2 => {
+                let v: Option<String> = tc.draw(generators::optional(generators::text().max_size(20)));
+                assert_eq!(v, from_slice::<Option<String>>(&to_vec(&v).unwrap()).unwrap());
+            }
+            3 => {
+                let v: Vec<u64> = tc.draw(generators::vecs(u64_values()));
+                assert_eq!(v, from_slice::<Vec<u64>>(&to_vec(&v).unwrap()).unwrap());
+            }
+            4 => {
+                let v: BTreeMap<i64, String> = tc
+                    .draw(generators::hashmaps(
+                        i64_values(),
+                        generators::text().max_size(10),
+                    ))
+                    .into_iter()
+                    .collect();
+                assert_eq!(v, from_slice::<BTreeMap<i64, String>>(&to_vec(&v).unwrap()).unwrap());
+            }
+            5 => {
+                let v: (u8, String, Option<bool>) = (
+                    tc.draw(generators::integers::<u8>()),
+                    tc.draw(generators::text().max_size(20)),
+                    tc.draw(generators::optional(generators::booleans())),
+                );
+                assert_eq!(
+                    v,
+                    from_slice::<(u8, String, Option<bool>)>(&to_vec(&v).unwrap()).unwrap()
+                );
+            }
+            _ => {
+                let v = serde_bytes::ByteBuf::from(tc.draw(generators::binary()));
+                assert_eq!(v, from_slice::<serde_bytes::ByteBuf>(&to_vec(&v).unwrap()).unwrap());
+            }
+        }
+    }
+
+    /// Cross-crate consistency: for data with a direct `rmpv::Value`
+    /// equivalent, `rmp_serde::to_vec` must produce byte-for-byte the same
+    /// encoding as `rmpv::encode::write_value`.
+    #[hegel::test]
+    fn encoding_matches_rmpv_value_encoding(tc: hegel::TestCase) {
+        use rmpv::Value;
+
+        let (serde_encoded, value): (Vec<u8>, Value) =
+            match tc.draw(generators::integers::<u8>().max_value(9)) {
+                0 => {
+                    let n = tc.draw(u64_values());
+                    (to_vec(&n).unwrap(), Value::from(n))
+                }
+                1 => {
+                    let n = tc.draw(i64_values());
+                    (to_vec(&n).unwrap(), Value::from(n))
+                }
+                2 => {
+                    let f = f32::from_bits(tc.draw(generators::integers::<u32>()));
+                    (to_vec(&f).unwrap(), Value::F32(f))
+                }
+                3 => {
+                    let f = f64::from_bits(tc.draw(generators::integers::<u64>()));
+                    (to_vec(&f).unwrap(), Value::F64(f))
+                }
+                4 => {
+                    let b = tc.draw(generators::booleans());
+                    (to_vec(&b).unwrap(), Value::Boolean(b))
+                }
+                5 => {
+                    let s: String = tc.draw(generators::text().max_size(40));
+                    (to_vec(&s).unwrap(), Value::from(s))
+                }
+                6 => {
+                    let bytes: Vec<u8> = tc.draw(generators::binary().max_size(40));
+                    (
+                        to_vec(&serde_bytes::ByteBuf::from(bytes.clone())).unwrap(),
+                        Value::Binary(bytes),
+                    )
+                }
+                7 => {
+                    let v: Vec<i64> = tc.draw(generators::vecs(i64_values()).max_size(8));
+                    (
+                        to_vec(&v).unwrap(),
+                        Value::Array(v.into_iter().map(Value::from).collect()),
+                    )
+                }
+                8 => {
+                    let m: BTreeMap<String, i64> = tc
+                        .draw(generators::hashmaps(
+                            generators::text().max_size(10),
+                            i64_values(),
+                        ).max_size(5))
+                        .into_iter()
+                        .collect();
+                    let pairs = m
+                        .iter()
+                        .map(|(k, v)| (Value::from(k.clone()), Value::from(*v)))
+                        .collect();
+                    (to_vec(&m).unwrap(), Value::Map(pairs))
+                }
+                _ => {
+                    let o: Option<u32> = tc.draw(generators::optional(generators::integers::<u32>()));
+                    let value = o.map_or(Value::Nil, Value::from);
+                    (to_vec(&o).unwrap(), value)
+                }
+            };
+
+        let mut value_encoded = Vec::new();
+        rmpv::encode::write_value(&mut value_encoded, &value).unwrap();
+        assert_eq!(
+            serde_encoded, value_encoded,
+            "rmp-serde and rmpv disagree on the encoding of {value:?}"
+        );
+    }
+
+    /// Every strict prefix of a valid encoding must fail to deserialize
+    /// (MessagePack is self-delimiting, so a truncated value is incomplete).
+    #[hegel::test]
+    fn truncated_struct_encoding_fails(tc: hegel::TestCase) {
+        let val = tc.draw(outers());
+        let buf = to_vec(&val).unwrap();
+        let cut = tc.draw(generators::integers::<usize>().max_value(buf.len() - 1));
+        assert!(
+            from_slice::<Outer>(&buf[..cut]).is_err(),
+            "decoded a strict prefix ({cut}/{} bytes) of {val:?}",
+            buf.len()
+        );
+    }
+}
