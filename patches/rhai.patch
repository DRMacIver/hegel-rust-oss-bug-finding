+//! Shared hegel generators for property-based tests.
+//!
+//! This module is included via `mod common;` from several integration test
+//! files, so not every item is used by every test target.
+#![allow(dead_code)]
+
+use hegel::generators::{self, Generator};
+use rhai::INT;
+
+// ---------------------------------------------------------------------------
+// Arithmetic expression trees with a Rust-side checked-arithmetic oracle.
+//
+// Evidence: rhai's default build uses checked arithmetic (see
+// `src/packages/arithmetic.rs` and `src/func/builtin.rs`, gated on
+// `#[cfg(not(feature = "unchecked"))]`), where every binary integer operation
+// is `checked_add`/`checked_sub`/`checked_mul`/`checked_div`/`checked_rem`
+// and unary minus is `checked_neg`, erroring on overflow/division by zero.
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+pub enum Op {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Rem,
+}
+
+impl Op {
+    pub fn symbol(&self) -> &'static str {
+        match self {
+            Op::Add => "+",
+            Op::Sub => "-",
+            Op::Mul => "*",
+            Op::Div => "/",
+            Op::Rem => "%",
+        }
+    }
+
+    pub fn apply_checked(&self, l: INT, r: INT) -> Option<INT> {
+        match self {
+            Op::Add => l.checked_add(r),
+            Op::Sub => l.checked_sub(r),
+            Op::Mul => l.checked_mul(r),
+            Op::Div => l.checked_div(r),
+            Op::Rem => l.checked_rem(r),
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub enum Expr {
+    Lit(INT),
+    Neg(Box<Expr>),
+    Bin(Op, Box<Expr>, Box<Expr>),
+}
+
+impl Expr {
+    /// Render as rhai source. Everything is parenthesized so operator
+    /// precedence in the rendered text is irrelevant.
+    pub fn render(&self) -> String {
+        match self {
+            Expr::Lit(n) => format!("({n})"),
+            Expr::Neg(e) => format!("(-{})", e.render()),
+            Expr::Bin(op, l, r) => format!("({} {} {})", l.render(), op.symbol(), r.render()),
+        }
+    }
+
+    /// Render as a rhai script where every literal is first bound to a `let`
+    /// variable. This forces all arithmetic (including unary minus) through
+    /// the *runtime* operators. Rendering literals inline instead would hit
+    /// rhai's parse-time constant folding of unary minus, which deliberately
+    /// converts `-<int constant>` to a *float* constant when negation
+    /// overflows (src/parser.rs, "Negative integer" arm) — a different,
+    /// parse-time semantics that this oracle does not model.
+    pub fn render_via_lets(&self) -> String {
+        fn walk(e: &Expr, lets: &mut Vec<INT>) -> String {
+            match e {
+                Expr::Lit(n) => {
+                    lets.push(*n);
+                    format!("v{}", lets.len() - 1)
+                }
+                Expr::Neg(e) => format!("(-{})", walk(e, lets)),
+                Expr::Bin(op, l, r) => {
+                    format!("({} {} {})", walk(l, lets), op.symbol(), walk(r, lets))
+                }
+            }
+        }
+        let mut lets = Vec::new();
+        let body = walk(self, &mut lets);
+        let mut script = String::new();
+        for (i, n) in lets.iter().enumerate() {
+            script.push_str(&format!("let v{i} = {n};\n"));
+        }
+        script.push_str(&body);
+        script
+    }
+
+    /// Reference implementation with Rust checked arithmetic.
+    /// `None` means "evaluation must produce an arithmetic error".
+    pub fn eval_checked(&self) -> Option<INT> {
+        match self {
+            Expr::Lit(n) => Some(*n),
+            Expr::Neg(e) => e.eval_checked()?.checked_neg(),
+            Expr::Bin(op, l, r) => op.apply_checked(l.eval_checked()?, r.eval_checked()?),
+        }
+    }
+}
+
+/// Full-range integers with boundary values boosted (boundary conjunctions
+/// are rare under uniform generation).
+pub fn int_literals() -> generators::BoxedGenerator<'static, INT> {
+    hegel::one_of!(
+        generators::integers::<INT>(),
+        generators::sampled_from(vec![INT::MIN, INT::MIN + 1, -2, -1, 0, 1, 2, INT::MAX - 1, INT::MAX]),
+    )
+    .boxed()
+}
+
+/// Recursive generator for arithmetic expression trees.
+pub fn exprs(depth: u32) -> generators::BoxedGenerator<'static, Expr> {
+    hegel::compose!(|tc| {
+        if depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) == 0 {
+            Expr::Lit(tc.draw(int_literals()))
+        } else if tc.draw(generators::integers::<u8>().max_value(5)) == 0 {
+            Expr::Neg(Box::new(tc.draw(exprs(depth - 1))))
+        } else {
+            let op = tc.draw(generators::sampled_from(vec![
+                Op::Add,
+                Op::Sub,
+                Op::Mul,
+                Op::Div,
+                Op::Rem,
+            ]));
+            let l = tc.draw(exprs(depth - 1));
+            let r = tc.draw(exprs(depth - 1));
+            Expr::Bin(op, Box::new(l), Box::new(r))
+        }
+    })
+    .boxed()
+}
+
+// ---------------------------------------------------------------------------
+// Well-formed script generator.
+//
+// Generates typed (INT / bool) statements plus a final INT expression, so
+// the whole script always compiles, terminates (loops are bounded), has no
+// side effects, and evaluates to an INT (or fails with a runtime error such
+// as an arithmetic overflow).
+// ---------------------------------------------------------------------------
+
+struct ScriptCtx {
+    ints: Vec<String>,
+    bools: Vec<String>,
+    counter: usize,
+}
+
+impl ScriptCtx {
+    fn fresh(&mut self, prefix: &str) -> String {
+        self.counter += 1;
+        format!("{prefix}{}", self.counter)
+    }
+}
+
+/// Generate a well-formed, terminating, side-effect-free rhai script whose
+/// value is an INT (or a runtime arithmetic error).
+pub fn arbitrary_script(tc: &hegel::TestCase) -> String {
+    let mut ctx = ScriptCtx {
+        ints: Vec::new(),
+        bools: Vec::new(),
+        counter: 0,
+    };
+    let n = tc.draw(generators::integers::<usize>().max_value(8));
+    let mut stmts = Vec::new();
+    for _ in 0..n {
+        let s = statement(tc, &mut ctx);
+        stmts.push(s);
+    }
+    stmts.push(int_expr(tc, &ctx, 3));
+    stmts.join("\n")
+}
+
+fn statement(tc: &hegel::TestCase, ctx: &mut ScriptCtx) -> String {
+    match tc.draw(generators::integers::<u8>().max_value(5)) {
+        // let <int var> = <int expr>;
+        0 => {
+            let name = ctx.fresh("i");
+            let s = format!("let {name} = {};", int_expr(tc, ctx, 2));
+            ctx.ints.push(name);
+            s
+        }
+        // let <int var> = if <bool> { <int> } else { <int> };
+        1 => {
+            let name = ctx.fresh("i");
+            let s = format!(
+                "let {name} = if {} {{ {} }} else {{ {} }};",
+                bool_expr(tc, ctx, 2),
+                int_expr(tc, ctx, 2),
+                int_expr(tc, ctx, 2)
+            );
+            ctx.ints.push(name);
+            s
+        }
+        // let <bool var> = <bool expr>;
+        2 => {
+            let name = ctx.fresh("b");
+            let s = format!("let {name} = {};", bool_expr(tc, ctx, 2));
+            ctx.bools.push(name);
+            s
+        }
+        // <existing int var> = <int expr>;
+        3 if !ctx.ints.is_empty() => {
+            let name = tc.draw(generators::sampled_from(ctx.ints.clone()));
+            format!("{name} = {};", int_expr(tc, ctx, 2))
+        }
+        // if <bool> { <assignments> } else { <assignments> }
+        4 => {
+            let cond = bool_expr(tc, ctx, 2);
+            let then_body = assignments(tc, ctx);
+            let else_body = assignments(tc, ctx);
+            format!("if {cond} {{ {then_body} }} else {{ {else_body} }}")
+        }
+        // bounded for loop over a small range
+        5 => {
+            let loop_var = ctx.fresh("k");
+            let bound = tc.draw(generators::integers::<u8>().max_value(8));
+            ctx.ints.push(loop_var.clone());
+            let body = assignments(tc, ctx);
+            ctx.ints.retain(|v| *v != loop_var);
+            format!("for {loop_var} in 0..{bound} {{ {body} }}")
+        }
+        // fallback (covers choice 3 when no int vars exist yet)
+        _ => {
+            let name = ctx.fresh("i");
+            let s = format!("let {name} = {};", int_expr(tc, ctx, 2));
+            ctx.ints.push(name);
+            s
+        }
+    }
+}
+
+/// 0..=2 assignment statements to already-declared int variables.
+fn assignments(tc: &hegel::TestCase, ctx: &ScriptCtx) -> String {
+    if ctx.ints.is_empty() {
+        return String::new();
+    }
+    let n = tc.draw(generators::integers::<u8>().max_value(2));
+    let mut out = Vec::new();
+    for _ in 0..n {
+        let name = tc.draw(generators::sampled_from(ctx.ints.clone()));
+        out.push(format!("{name} = {};", int_expr(tc, ctx, 2)));
+    }
+    out.join(" ")
+}
+
+fn int_expr(tc: &hegel::TestCase, ctx: &ScriptCtx, depth: u32) -> String {
+    if depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) == 0 {
+        // Leaf: variable or literal.
+        if !ctx.ints.is_empty() && tc.draw(generators::booleans()) {
+            tc.draw(generators::sampled_from(ctx.ints.clone()))
+        } else {
+            format!("({})", tc.draw(int_literals()))
+        }
+    } else if tc.draw(generators::integers::<u8>().max_value(6)) == 6 {
+        format!("(-{})", int_expr(tc, ctx, depth - 1))
+    } else {
+        let op = tc.draw(generators::sampled_from(vec!["+", "-", "*", "/", "%"]));
+        format!(
+            "({} {op} {})",
+            int_expr(tc, ctx, depth - 1),
+            int_expr(tc, ctx, depth - 1)
+        )
+    }
+}
+
+fn bool_expr(tc: &hegel::TestCase, ctx: &ScriptCtx, depth: u32) -> String {
+    if depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) == 0 {
+        // Leaf: variable or literal.
+        if !ctx.bools.is_empty() && tc.draw(generators::booleans()) {
+            tc.draw(generators::sampled_from(ctx.bools.clone()))
+        } else if tc.draw(generators::booleans()) {
+            "true".to_string()
+        } else {
+            "false".to_string()
+        }
+    } else {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => {
+                let op = tc.draw(generators::sampled_from(vec!["==", "!=", "<", "<=", ">", ">="]));
+                format!(
+                    "({} {op} {})",
+                    int_expr(tc, ctx, depth - 1),
+                    int_expr(tc, ctx, depth - 1)
+                )
+            }
+            1 => format!("(!{})", bool_expr(tc, ctx, depth - 1)),
+            2 => format!(
+                "({} && {})",
+                bool_expr(tc, ctx, depth - 1),
+                bool_expr(tc, ctx, depth - 1)
+            ),
+            _ => format!(
+                "({} || {})",
+                bool_expr(tc, ctx, depth - 1),
+                bool_expr(tc, ctx, depth - 1)
+            ),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Token soup: script-shaped text built from real rhai tokens with random
+// whitespace, mirroring the dictionary approach of `fuzz/fuzz_targets/`.
+// Mostly does not compile; occasionally does.
+// ---------------------------------------------------------------------------
+
+pub fn token_soup(tc: &hegel::TestCase) -> String {
+    const TOKENS: &[&str] = &[
+        "let", "const", "if", "else", "fn", "private", "while", "loop", "for", "in", "do",
+        "until", "return", "throw", "try", "catch", "switch", "true", "false", "break",
+        "continue", "import", "export", "as", "global", "this",
+        "+", "-", "*", "/", "%", "**", "==", "!=", "<", "<=", ">", ">=", "&&", "||", "!", "&",
+        "|", "^", "<<", ">>", "=", "+=", "-=", "*=", "/=", "%=", "**=", "&=", "|=", "^=", "<<=",
+        ">>=", "==>", ";", ",", ".", ":", "::", "=>", "(", ")", "{", "}", "[", "]", "#{", "..",
+        "..=", "?.", "?[", "in",
+        "x", "y", "foo", "bar", "_", "abc",
+        "0", "1", "2", "42", "0x7f", "0o17", "0b101", "123456789012345678901234567890", "0.5",
+        "1e10", "9223372036854775807",
+        "\"hello\"", "'c'", "`interp ${", "}`", "// comment", "/*", "*/",
+    ];
+    const SEPS: &[&str] = &[" ", "", "\n", "\t", "  "];
+    let n = tc.draw(generators::integers::<usize>().max_value(64));
+    let mut s = String::new();
+    for _ in 0..n {
+        s.push_str(tc.draw(generators::sampled_from(TOKENS.to_vec())));
+        s.push_str(tc.draw(generators::sampled_from(SEPS.to_vec())));
+    }
+    s
+}
