+    // -----------------------------------------------------------------
+    // Property-based tests (hegel)
+    // -----------------------------------------------------------------
+
+    use crate::errors::PolylineError;
+    use geo_types::Coord;
+    use hegel::generators::{self};
+
+    /// Longitude in [-180, 180], with the exact boundary values boosted.
+    fn draw_lng(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(-180.0).max_value(180.0),
+            generators::sampled_from(vec![-180.0, 180.0, 0.0, -0.0]),
+        ))
+    }
+
+    /// Latitude in [-90, 90], with the exact boundary values boosted.
+    fn draw_lat(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(-90.0).max_value(90.0),
+            generators::sampled_from(vec![-90.0, 90.0, 0.0, -0.0]),
+        ))
+    }
+
+    /// A line of `min_len..=200` in-range coordinates. Long lines matter:
+    /// the format delta-encodes, so a per-coordinate error that accumulated
+    /// across deltas would only show up on many-point lines.
+    fn draw_line(tc: &hegel::TestCase, min_len: usize) -> Vec<Coord<f64>> {
+        let n = tc.draw(
+            generators::integers::<usize>()
+                .min_value(min_len)
+                .max_value(200),
+        );
+        (0..n)
+            .map(|_| Coord {
+                x: draw_lng(tc),
+                y: draw_lat(tc),
+            })
+            .collect()
+    }
+
+    /// Worst-case rounding error when snapping to the 10^-precision grid,
+    /// plus a small epsilon for f64 scaling noise in `scale()`/decode division.
+    fn tolerance(precision: u32) -> f64 {
+        0.5 / 10f64.powi(precision as i32) + 1e-10
+    }
+
+    /// Crown roundtrip: encoding is lossy (grid rounding), but every decoded
+    /// coordinate must be within half a grid step of the original — checked
+    /// per coordinate, so delta-encoding drift on long lines would fail it.
+    #[hegel::test]
+    fn prop_encode_decode_roundtrip_within_tolerance(tc: hegel::TestCase) {
+        let precision = tc.draw(generators::sampled_from(vec![5u32, 6]));
+        let coords = draw_line(&tc, 0);
+        let encoded = encode_coordinates(coords.iter().copied(), precision).unwrap();
+        assert_eq!(encoded.is_empty(), coords.is_empty());
+        let decoded = decode_polyline(&encoded, precision).unwrap();
+        assert_eq!(decoded.0.len(), coords.len());
+        let tol = tolerance(precision);
+        for (i, (orig, dec)) in coords.iter().zip(decoded.0.iter()).enumerate() {
+            assert!(
+                (orig.x - dec.x).abs() <= tol,
+                "lng drift at index {i}: {} -> {} (tol {tol}, precision {precision})",
+                orig.x,
+                dec.x
+            );
+            assert!(
+                (orig.y - dec.y).abs() <= tol,
+                "lat drift at index {i}: {} -> {} (tol {tol}, precision {precision})",
+                orig.y,
+                dec.y
+            );
+        }
+    }
+
+    /// Precision monotonicity: for the same input, precision 6 must recover
+    /// each coordinate at least as accurately as precision 5 (the 1e-5 grid
+    /// is a subset of the 1e-6 grid; epsilon covers f64 tie-rounding noise).
+    #[hegel::test]
+    fn prop_higher_precision_loses_less(tc: hegel::TestCase) {
+        let coords = draw_line(&tc, 0);
+        let d5 =
+            decode_polyline(&encode_coordinates(coords.iter().copied(), 5).unwrap(), 5).unwrap();
+        let d6 =
+            decode_polyline(&encode_coordinates(coords.iter().copied(), 6).unwrap(), 6).unwrap();
+        for ((orig, c5), c6) in coords.iter().zip(d5.0.iter()).zip(d6.0.iter()) {
+            assert!(
+                (orig.x - c6.x).abs() <= (orig.x - c5.x).abs() + 1e-9,
+                "lng: precision 6 lost more than precision 5 for {}",
+                orig.x
+            );
+            assert!(
+                (orig.y - c6.y).abs() <= (orig.y - c5.y).abs() + 1e-9,
+                "lat: precision 6 lost more than precision 5 for {}",
+                orig.y
+            );
+        }
+    }
+
+    /// Canonical roundtrip: decode(encode(line)) is on the grid, so
+    /// re-encoding must reproduce the exact same string, and decoding that
+    /// string must be a fixpoint (no further value drift).
+    #[hegel::test]
+    fn prop_decode_encode_fixpoint(tc: hegel::TestCase) {
+        let precision = tc.draw(generators::integers::<u32>().max_value(9));
+        let coords = draw_line(&tc, 0);
+        let encoded = encode_coordinates(coords.iter().copied(), precision).unwrap();
+        let decoded = decode_polyline(&encoded, precision).unwrap();
+        let reencoded = encode_coordinates(decoded.coords().copied(), precision).unwrap();
+        assert_eq!(encoded, reencoded, "re-encoding a decoded polyline changed the string");
+        let decoded_again = decode_polyline(&reencoded, precision).unwrap();
+        assert_eq!(decoded, decoded_again, "decode∘encode is not a fixpoint");
+    }
+
+    /// A coordinate value on or near the rounding grid: k*10^-p plus an
+    /// offset right at the round-half boundary (clamped into range).
+    fn draw_near_grid(tc: &hegel::TestCase, max_abs: f64, factor: f64) -> f64 {
+        let max_scaled = (max_abs * factor) as i64;
+        let k = tc.draw(
+            generators::integers::<i64>()
+                .min_value(-max_scaled)
+                .max_value(max_scaled),
+        );
+        let off = tc.draw(generators::sampled_from(vec![
+            0.0,
+            0.49 / factor,
+            -0.49 / factor,
+            0.5 / factor,
+            -0.5 / factor,
+            0.51 / factor,
+            -0.51 / factor,
+        ]));
+        (k as f64 / factor + off).clamp(-max_abs, max_abs)
+    }
+
+    /// Boundary hunting: coordinates sitting exactly on grid points and at
+    /// the round-half tie boundaries (including clamped ±90/±180) must still
+    /// encode successfully and decode within tolerance.
+    #[hegel::test]
+    fn prop_rounding_boundary_roundtrip(tc: hegel::TestCase) {
+        let precision = tc.draw(generators::sampled_from(vec![5u32, 6]));
+        let factor = 10f64.powi(precision as i32);
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(20));
+        let coords: Vec<Coord<f64>> = (0..n)
+            .map(|_| Coord {
+                x: draw_near_grid(&tc, 180.0, factor),
+                y: draw_near_grid(&tc, 90.0, factor),
+            })
+            .collect();
+        let encoded = encode_coordinates(coords.iter().copied(), precision).unwrap();
+        let decoded = decode_polyline(&encoded, precision).unwrap();
+        assert_eq!(decoded.0.len(), coords.len());
+        let tol = tolerance(precision);
+        for (orig, dec) in coords.iter().zip(decoded.0.iter()) {
+            assert!((orig.x - dec.x).abs() <= tol, "lng {} -> {}", orig.x, dec.x);
+            assert!((orig.y - dec.y).abs() <= tol, "lat {} -> {}", orig.y, dec.y);
+        }
+    }
+
+    /// An out-of-range value for an axis whose valid range is [-limit, limit]:
+    /// beyond either end (up to infinity) or NaN.
+    fn draw_out_of_range(tc: &hegel::TestCase, limit: f64) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(limit).exclude_min(true),
+            generators::floats::<f64>().max_value(-limit).exclude_max(true),
+            generators::sampled_from(vec![f64::NAN, f64::INFINITY, f64::NEG_INFINITY]),
+        ))
+    }
+
+    /// Validation: a line with one out-of-range coordinate anywhere in it is
+    /// rejected with the right error variant, index, and offending value.
+    #[hegel::test]
+    fn prop_out_of_range_coordinates_rejected(tc: hegel::TestCase) {
+        let mut coords = draw_line(&tc, 0);
+        let idx = tc.draw(generators::integers::<usize>().max_value(coords.len()));
+        let corrupt_lat = tc.draw(generators::booleans());
+        let bad = if corrupt_lat {
+            Coord {
+                x: draw_lng(&tc),
+                y: draw_out_of_range(&tc, 90.0),
+            }
+        } else {
+            Coord {
+                x: draw_out_of_range(&tc, 180.0),
+                y: draw_lat(&tc),
+            }
+        };
+        coords.insert(idx, bad);
+        let precision = tc.draw(generators::sampled_from(vec![5u32, 6]));
+        let err = encode_coordinates(coords.iter().copied(), precision).unwrap_err();
+        match err {
+            PolylineError::LatitudeCoordError { coord, idx: err_idx } => {
+                assert!(corrupt_lat, "got latitude error for a bad longitude");
+                assert_eq!(err_idx, idx);
+                assert!(coord == bad.y || (coord.is_nan() && bad.y.is_nan()));
+            }
+            PolylineError::LongitudeCoordError { coord, idx: err_idx } => {
+                assert!(!corrupt_lat, "got longitude error for a bad latitude");
+                assert_eq!(err_idx, idx);
+                assert!(coord == bad.x || (coord.is_nan() && bad.x.is_nan()));
+            }
+            other => panic!("unexpected error variant: {:?}", other),
+        }
+    }
+
+    /// Parse robustness: decoding arbitrary (full Unicode) strings must
+    /// return Ok/Err, never panic.
+    #[hegel::test]
+    fn prop_decode_never_panics_on_arbitrary_strings(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let precision = tc.draw(generators::integers::<u32>().max_value(9));
+        drop(decode_polyline(&s, precision));
+    }
+
+    /// Parse robustness on polyline-shaped input: strings drawn from the
+    /// polyline alphabet (bytes 63..=126) exercise the varint-chunk decoder
+    /// deeply. Must never panic, and (per the docs) any Ok result contains
+    /// only in-range coordinates.
+    #[hegel::test]
+    fn prop_decode_polyline_alphabet_no_panic_and_in_range(tc: hegel::TestCase) {
+        let len = tc.draw(generators::integers::<usize>().max_value(300));
+        let bytes: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().min_value(63).max_value(126))
+                .min_size(len),
+        );
+        let s = String::from_utf8(bytes).unwrap();
+        let precision = tc.draw(generators::integers::<u32>().max_value(9));
+        if let Ok(line) = decode_polyline(&s, precision) {
+            for c in line.coords() {
+                assert!(
+                    (-90.0..=90.0).contains(&c.y) && (-180.0..=180.0).contains(&c.x),
+                    "decode returned Ok with out-of-range coordinate {:?}",
+                    c
+                );
+            }
+        }
+    }
+
+    /// Robustness against corruption of a *valid* polyline: truncating it at
+    /// any byte, overwriting any byte with arbitrary ASCII, or inserting an
+    /// ASCII byte must be handled gracefully (no panic; Ok results in range).
+    #[hegel::test]
+    fn prop_decode_corrupted_polyline_never_panics(tc: hegel::TestCase) {
+        let precision = tc.draw(generators::sampled_from(vec![5u32, 6]));
+        let coords = draw_line(&tc, 1);
+        let mut bytes = encode_coordinates(coords.iter().copied(), precision)
+            .unwrap()
+            .into_bytes();
+        let kind = tc.draw(generators::integers::<u8>().max_value(2));
+        let pos = tc.draw(generators::integers::<usize>().max_value(bytes.len()));
+        // ASCII-only mutations keep the buffer valid UTF-8.
+        match kind {
+            0 => bytes.truncate(pos),
+            1 => {
+                let pos = pos.min(bytes.len() - 1);
+                bytes[pos] = tc.draw(generators::integers::<u8>().max_value(127));
+            }
+            _ => bytes.insert(pos, tc.draw(generators::integers::<u8>().max_value(127))),
+        }
+        let s = String::from_utf8(bytes).unwrap();
+        if let Ok(line) = decode_polyline(&s, precision) {
+            for c in line.coords() {
+                assert!(
+                    (-90.0..=90.0).contains(&c.y) && (-180.0..=180.0).contains(&c.x),
+                    "decode returned Ok with out-of-range coordinate {:?}",
+                    c
+                );
+            }
+        }
+    }
+
+    /// Degenerate line shapes: the empty line encodes to the empty string
+    /// (and back), and a single-point line roundtrips within tolerance.
+    #[hegel::test]
+    fn prop_empty_and_single_point_roundtrip(tc: hegel::TestCase) {
+        let precision = tc.draw(generators::sampled_from(vec![5u32, 6]));
+
+        // Empty line.
+        assert_eq!(
+            encode_coordinates(std::iter::empty::<Coord<f64>>(), precision).unwrap(),
+            ""
+        );
+        assert_eq!(decode_polyline("", precision).unwrap().0.len(), 0);
+
+        // Single point.
+        let point = Coord {
+            x: draw_lng(&tc),
+            y: draw_lat(&tc),
+        };
+        let encoded = encode_coordinates(std::iter::once(point), precision).unwrap();
+        let decoded = decode_polyline(&encoded, precision).unwrap();
+        assert_eq!(decoded.0.len(), 1);
+        let tol = tolerance(precision);
+        assert!((decoded.0[0].x - point.x).abs() <= tol);
+        assert!((decoded.0[0].y - point.y).abs() <= tol);
+    }
+
+    /// The precision parameter is an unrestricted `u32` with no documented
+    /// upper bound; encode/decode should return Ok/Err for any value, not
+    /// panic.
+    ///
+    /// KNOWN FAILURE: any `precision >= 10` panics with "attempt to multiply
+    /// with overflow" — both `encode_coordinates` and `decode_polyline`
+    /// compute `10_i32.pow(precision)`, which overflows `i32` for
+    /// precision >= 10 (debug builds panic; release builds would silently
+    /// wrap). The `sampled_from` branch below pins the failure so it
+    /// reproduces deterministically on every run (shrinks to precision = 10).
+    #[hegel::test]
+    fn prop_any_precision_no_panic(tc: hegel::TestCase) {
+        let precision = tc.draw(hegel::one_of!(
+            generators::integers::<u32>(),
+            generators::sampled_from(vec![10u32, 11, 31, u32::MAX]),
+        ));
+        let coords = vec![
+            Coord { x: -120.2, y: 38.5 },
+            Coord { x: -120.95, y: 40.7 },
+        ];
+        drop(encode_coordinates(coords, precision));
+        drop(decode_polyline("_p~iF~ps|U", precision));
+    }
 }
