+// ---- Hegel property-based tests ----
+
+use hegel::generators::{self, Generator};
+use crate::AgentId;
+use crate::list_fuzzer_tools::hegel_tools::hegel_make_random_change;
+
+/// Build a ListCRDT containing drawn history: local edits, and (optionally) concurrent edits
+/// from a second replica merged back in.
+fn hegel_doc_with_history(tc: &hegel::TestCase) -> ListCRDT {
+    let mut a = ListCRDT::new();
+    a.get_or_create_agent_id("agent 0"); // 0
+    a.get_or_create_agent_id("agent 1"); // 1
+
+    let mut b = ListCRDT::new();
+    b.get_or_create_agent_id("agent 0");
+    b.get_or_create_agent_id("agent 1");
+
+    // Shared prefix of history.
+    let shared = tc.draw(generators::integers::<usize>().max_value(4));
+    for _ in 0..shared {
+        hegel_make_random_change(tc, &mut a, 0);
+    }
+    b.oplog.add_missing_operations_from(&a.oplog);
+    b.branch.merge(&b.oplog, b.oplog.cg.version.as_ref());
+
+    // Concurrent edits on both replicas.
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(4)) {
+        hegel_make_random_change(tc, &mut a, 0);
+    }
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(4)) {
+        hegel_make_random_change(tc, &mut b, 1);
+    }
+
+    a.oplog.add_missing_operations_from(&b.oplog);
+    a.branch.merge(&a.oplog, a.oplog.cg.version.as_ref());
+    a
+}
+
+/// Encode -> decode round trip: an oplog with arbitrary (possibly concurrent) history, encoded
+/// with full fidelity, must decode to an equivalent oplog with identical checkout text.
+#[hegel::test]
+fn hegel_encode_decode_roundtrip(tc: hegel::TestCase) {
+    let doc = hegel_doc_with_history(&tc);
+
+    let data = doc.oplog.encode(&EncodeOptions::full()
+        .store_deleted_content(true));
+    let decoded = ListOpLog::load_from(&data).unwrap();
+    decoded.dbg_check(true);
+
+    assert_eq!(decoded, doc.oplog);
+    assert_eq!(decoded.checkout_tip().content, doc.branch.content);
+}
+
+/// Generate the encoding *configuration* too, not just the payload: any combination of the
+/// EncodeOptions flags must produce bytes which decode without error, and which reproduce the
+/// document text whenever the inserted content was stored.
+#[hegel::test]
+fn hegel_encode_options_roundtrip(tc: hegel::TestCase) {
+    let doc = hegel_doc_with_history(&tc);
+
+    let store_start_branch_content = tc.draw(generators::booleans());
+    let store_inserted_content = tc.draw(generators::booleans());
+    let store_deleted_content = tc.draw(generators::booleans());
+    let compress_content = tc.draw(generators::booleans());
+    let user_data: Option<Vec<u8>> = tc.draw(generators::optional(generators::binary().max_size(64)));
+
+    let mut opts = EncodeOptions::full()
+        .store_start_branch_content(store_start_branch_content)
+        .store_inserted_content(store_inserted_content)
+        .store_deleted_content(store_deleted_content)
+        .compress_content(compress_content);
+    if let Some(data) = user_data.as_deref() {
+        opts = opts.user_data(data);
+    }
+
+    let bytes = doc.oplog.encode(&opts);
+    let decoded = ListOpLog::load_from(&bytes).unwrap();
+    decoded.dbg_check(true);
+
+    // The causal graph always round trips, whatever the options.
+    assert_eq!(decoded.cg.version, doc.oplog.cg.version);
+    assert_eq!(decoded.len(), doc.oplog.len());
+
+    if store_inserted_content {
+        // With inserted content stored, the checkout must reproduce the document text.
+        assert_eq!(decoded.checkout_tip().content, doc.branch.content);
+    }
+    if store_inserted_content && store_deleted_content {
+        // With everything stored, the whole oplog round trips.
+        assert_eq!(decoded, doc.oplog);
+    }
+}
+
+/// Incremental save/load: a snapshot plus a patch (encode_from the snapshot's version) must
+/// recompose, via decode_and_add, into the full oplog.
+#[hegel::test]
+fn hegel_encode_patch_composes(tc: hegel::TestCase) {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+
+    let opts = || EncodeOptions::full().store_deleted_content(true);
+
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(6)) {
+        hegel_make_random_change(&tc, &mut doc, agent);
+    }
+    let snapshot_bytes = doc.oplog.encode(&opts());
+    let snapshot_version = doc.oplog.cg.version.clone();
+
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(6)) {
+        hegel_make_random_change(&tc, &mut doc, agent);
+    }
+    let patch_bytes = doc.oplog.encode_from(&opts(), snapshot_version.as_ref());
+
+    let mut reassembled = ListOpLog::load_from(&snapshot_bytes).unwrap();
+    reassembled.decode_and_add(&patch_bytes).unwrap();
+    reassembled.dbg_check(true);
+
+    assert_eq!(reassembled, doc.oplog);
+    assert_eq!(reassembled.checkout_tip().content, doc.branch.content);
+}
+
+/// Corrupt an encoded document arbitrarily. Decoding the corrupted bytes must never panic, and
+/// when it errors, it must leave the target oplog untouched (matching `error_unrolling` above).
+#[hegel::test]
+fn hegel_corrupt_decode_errors_or_unrolls(tc: hegel::TestCase) {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+
+    // Some history the decode target already knows about...
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(4)) {
+        hegel_make_random_change(&tc, &mut doc, agent);
+    }
+    let base_oplog = doc.oplog.clone();
+
+    // ...and some newer history which (only) the encoded bytes carry.
+    for _ in 0..tc.draw(generators::integers::<usize>().max_value(4)) {
+        hegel_make_random_change(&tc, &mut doc, agent);
+    }
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    // Corrupt the bytes: byte flips, truncation, and/or splicing in garbage.
+    let mut corrupted = bytes.clone();
+    let num_mutations = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    for _ in 0..num_mutations {
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => { // Flip a byte.
+                let i = tc.draw(generators::integers::<usize>().max_value(corrupted.len() - 1));
+                corrupted[i] = !corrupted[i];
+            }
+            1 => { // Truncate.
+                let keep = tc.draw(generators::integers::<usize>().max_value(corrupted.len()));
+                corrupted.truncate(keep);
+                if corrupted.is_empty() { break; }
+            }
+            _ => { // Splice in garbage.
+                let i = tc.draw(generators::integers::<usize>().max_value(corrupted.len()));
+                let garbage: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(8));
+                corrupted.splice(i..i, garbage);
+            }
+        }
+    }
+
+    let mut target = base_oplog.clone();
+    let result = {
+        // KNOWN BUG: decoding corrupted data can panic instead of returning ParseError (see
+        // hegel_pinned_decode_corrupted_bytes_panics below). Skip those inputs here so this
+        // property keeps checking the error-unrolling contract on everything else.
+        let mut target_ref = std::panic::AssertUnwindSafe(&mut target);
+        let corrupted_ref = &corrupted;
+        match std::panic::catch_unwind(move || {
+            target_ref.decode_and_add_opts(corrupted_ref, DecodeOptions { ignore_crc: false, verbose: false })
+        }) {
+            Ok(result) => result,
+            Err(_) => return, // Known panic bug; pinned separately.
+        }
+    };
+    match result {
+        Err(_) => {
+            // A failed decode must unroll. The strict form of this (target == base_oplog) is
+            // violated by a KNOWN BUG pinned in hegel_pinned_failed_decode_must_unroll below
+            // (the unwind leaks agent assignment state), so here we only assert that the
+            // user-visible state didn't change.
+            assert_eq!(target.cg.version, base_oplog.cg.version);
+            assert_eq!(target.len(), base_oplog.len());
+        }
+        Ok(_) => {
+            // The corruption survived the checksum (eg it only hit the CRC chunk itself, or the
+            // mutations cancelled out). The result must still be internally consistent.
+            target.dbg_check(true);
+        }
+    }
+}
+
+/// KNOWN FAILURE: this test pins a real bug and fails deterministically. Do not "fix" the test.
+///
+/// Decoding malformed data panics instead of returning `ParseError`. Splicing a single byte
+/// into a valid encoding desynchronizes the history chunk from the version map built while
+/// reading the patches chunk, and `history_entry_map_and_truncate`
+/// (src/list/encoding/decode_oplog.rs:242) hits `RleVec::find_packed_with_offset` ->
+/// `Option::unwrap()` on None (src/rle/rle_vec.rs:191).
+///
+/// The file CRC cannot save us: it is only verified at the *end* of `decode_internal`
+/// (src/list/encoding/decode_oplog.rs:949), after all the chunks have already been parsed, so
+/// any panic reachable during parsing is reachable from corrupted / untrusted input.
+///
+/// Found by hegel via hegel_corrupt_decode_errors_or_unrolls; this deterministic version
+/// exhaustively splices one byte at every position so it fails on every run.
+#[test]
+fn hegel_pinned_decode_corrupted_bytes_panics() {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+    doc.insert(agent, 0, "\0");
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    // Splice a single byte at every position, and try to load each corrupted file.
+    let mut panics = Vec::new();
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {})); // Quiet the expected panic spam.
+    for i in 0..=bytes.len() {
+        for b in [0u8, 2, 0xff] {
+            let mut corrupted = bytes.clone();
+            corrupted.splice(i..i, [b]);
+            if std::panic::catch_unwind(|| {
+                drop(ListOpLog::load_from(&corrupted));
+            }).is_err() {
+                panics.push((i, b));
+            }
+        }
+    }
+    std::panic::set_hook(prev_hook);
+
+    assert!(panics.is_empty(),
+        "ListOpLog::load_from panicked (instead of returning ParseError) for {} corrupted \
+         inputs, eg (splice position, byte value) = {:?}",
+        panics.len(), &panics[..panics.len().min(5)]);
