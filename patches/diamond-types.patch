+
+/// KNOWN FAILURE: this test pins a real bug and fails deterministically. Do not "fix" the test.
+///
+/// When `decode_and_add` fails, it must leave the oplog exactly as it was.
+/// `decode_and_add_opts` says so itself: "when an error happens we need to unwind all the
+/// merged operations before returning. Otherwise self is in an invalid state"
+/// (src/list/encoding/decode_oplog.rs:476), and the existing `error_unrolling` test asserts
+/// exactly this for a fresh (empty) target oplog.
+///
+/// But when the target *already knows a prefix* of the encoded operations, the unwind is
+/// incomplete: `client_data[agent].lv_for_seq` keeps the seq -> LV mappings assigned during the
+/// failed decode (the unwind loop in decode_and_add_opts, src/list/encoding/decode_oplog.rs:500,
+/// removes the wrong / no seq range from lv_for_seq). The oplog is left claiming seqs map to
+/// local versions which don't exist, so later edits by that agent can silently collide.
+///
+/// Repro: an oplog A with one op; encode an extension of A (one more op); flip one byte so the
+/// decode fails on the CRC check; decode_and_add into A errors but leaves lv_for_seq covering
+/// both ops while A.len() == 1.
+///
+/// Found by hegel via hegel_corrupt_decode_errors_or_unrolls; this deterministic version flips
+/// every byte in turn so it fails on every run.
+#[test]
+fn hegel_pinned_failed_decode_must_unroll() {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+    doc.insert(agent, 0, "\0");
+    let base = doc.oplog.clone(); // The decode target already knows this operation...
+    doc.delete(agent, 0..1);      // ...but not this one.
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    let mut violations = Vec::new();
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {})); // Quiet panics from the separately-pinned panic bug.
+    for i in 0..bytes.len() {
+        let mut corrupted = bytes.clone();
+        corrupted[i] = !corrupted[i];
+
+        let mut target = base.clone();
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            target.decode_and_add_opts(&corrupted, DecodeOptions { ignore_crc: false, verbose: false })
+        }));
+        match result {
+            // Decoder panic: a different bug, pinned in hegel_pinned_decode_corrupted_bytes_panics.
+            Err(_) => continue,
+            Ok(Err(_)) => {
+                if target != base { violations.push(i); }
+            }
+            Ok(Ok(_)) => {} // Corruption survived (eg it hit the optional CRC chunk). Fine here.
+        }
+    }
+    std::panic::set_hook(prev_hook);
+
+    assert!(violations.is_empty(),
+        "decode_and_add errored but left the oplog modified for {} corrupted inputs \
+         (byte-flip positions {:?})",
+        violations.len(), &violations[..violations.len().min(5)]);
+}
