+            let pos = tc.draw(generators::integers::<usize>().max_value(doc_len - 1));
+            let span = tc.draw(generators::integers::<usize>()
+                .min_value(1)
+                .max_value(usize::min(10, doc_len - pos)));
+            let fwd = span == 1 || tc.draw(generators::booleans());
+
+            if fwd {
+                // Using make_delete_op (rather than add_delete_without_content) preserves the
+                // deleted content, which the encoding tests need.
+                let op = branch.make_delete_op(pos..pos + span);
+                oplog.add_operations_at(agent, branch.local_frontier_ref(), &[op])
+            } else {
