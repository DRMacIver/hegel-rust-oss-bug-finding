+/// KNOWN FAILURE: display normalizes CRLF line endings in decor to LF.
+///
+/// `RawString::encode` (src/raw_string.rs:88) writes raw decor spans via
+/// `raw.split('\r')`, silently dropping every `\r`. Parsing a valid document
+/// with CRLF line endings and calling `to_string()` therefore rewrites every
+/// line ending (`"a = 1\r\n"` -> `"a = 1\n"`), contradicting the crate
+/// promise of "preserving comments, spaces *and* relative order of items"
+/// (lib.rs), whose example asserts `doc.to_string() == toml`. CRLF inside
+/// *string values* is preserved; only decor (whitespace, comments, line
+/// ends) is affected. This test fails deterministically on every case.
+#[hegel::test]
+fn crlf_line_endings_are_preserved(tc: hegel::TestCase) {
+    let extra: String = tc.draw(generators::from_regex("[A-Za-z0-9_-]{0,5}").fullmatch(true));
+    let v: i64 = tc.draw(generators::integers::<i64>());
+    let src = format!("# header\r\nk_{extra} = {v}\r\n");
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("valid CRLF document did not parse: {err}"));
+    assert_eq!(
+        doc.to_string(),
+        src,
+        "CRLF line endings were not preserved"
+    );
+}
