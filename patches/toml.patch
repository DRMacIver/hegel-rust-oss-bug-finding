+/// Editing one value leaves every other byte of the document untouched, and
+/// rewrites only the edited line (key and its decor preserved, value decor
+/// reset to the default single space).
+#[hegel::test]
+fn editing_one_value_preserves_all_other_bytes(tc: hegel::TestCase) {
+    let mut counter = 0_u32;
+    let mut segments: Vec<String> = vec![draw_trivia_lines(&tc)];
+    // (segment index, bare key, leading ws, ws between key and `=`)
+    let mut editable: Vec<(usize, String, String, String)> = Vec::new();
+    let n: usize = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+    for _ in 0..n {
+        let key = format!("k{counter}_");
+        counter += 1;
+        let lead = draw_ws(&tc);
+        let ws1 = draw_ws(&tc);
+        let ws2 = draw_ws(&tc);
+        let val = draw_value_text(&tc, 2, &mut counter);
+        let ws3 = draw_ws(&tc);
+        let comment = if tc.draw(generators::booleans()) {
+            draw_comment(&tc)
+        } else {
+            String::new()
+        };
+        editable.push((segments.len(), key.clone(), lead.clone(), ws1.clone()));
+        segments.push(format!("{lead}{key}{ws1}={ws2}{val}{ws3}{comment}\n"));
+        segments.push(draw_trivia_lines(&tc));
+    }
+    let src: String = segments.concat();
+    let mut doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("generated document did not parse: {err}\n```\n{src}\n```"));
+    let pick: usize = tc.draw(generators::integers::<usize>().max_value(editable.len() - 1));
+    let (seg_idx, key, lead, ws1) = &editable[pick];
+    let new_v: i64 = tc.draw(generators::integers::<i64>());
+    doc[key.as_str()] = value(new_v);
+    let out = doc.to_string();
+    let prefix: String = segments[..*seg_idx].concat();
+    let suffix: String = segments[seg_idx + 1..].concat();
+    let expected = format!("{prefix}{lead}{key}{ws1}= {new_v}\n{suffix}");
+    assert_eq!(
+        out, expected,
+        "edit of {key:?} disturbed unrelated bytes\noriginal:\n```\n{src}\n```"
+    );
+}
