+/// Deeply nested input must never crash the parser: the recursion guard
+/// (`LIMIT = 80` in `src/parser/mod.rs`) turns it into a clean parse error.
+/// Sweeps depth well past the guard, pinning the exact boundary.
+#[hegel::test(test_cases = 75)]
+fn deeply_nested_input_errors_gracefully(tc: hegel::TestCase) {
+    let depth: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(200),
+        generators::sampled_from(vec![79_usize, 80, 81, 1000, 4096]),
+    ));
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(4));
+    let (input, expect_ok) = match kind {
+        0 => (
+            format!("a = {}{}", "[".repeat(depth), "]".repeat(depth)),
+            depth <= 80,
+        ),
+        1 => (
+            format!("a = {}1{}", "{a = ".repeat(depth), "}".repeat(depth)),
+            depth <= 80,
+        ),
+        2 => {
+            let mut s = String::from("a");
+            for _ in 1..depth {
+                s.push_str(".a");
+            }
+            s.push_str(" = 1");
+            (s, depth <= 80)
+        }
+        3 => {
+            let mut s = String::from("[a");
+            for _ in 1..depth {
+                s.push_str(".a");
+            }
+            s.push(']');
+            (s, depth <= 80)
+        }
+        // Unclosed bracket soup is never valid, but must not crash either.
+        _ => ("[".repeat(depth), false),
+    };
+    let result = input.parse::<DocumentMut>();
+    assert_eq!(
+        result.is_ok(),
+        expect_ok,
+        "depth {depth}, kind {kind}: expected ok={expect_ok}"
+    );
+    if let Ok(doc) = result {
+        // Displaying and re-parsing a maximally nested document must also
+        // not crash.
+        let out = doc.to_string();
+        assert_eq!(out.parse::<DocumentMut>().unwrap().to_string(), out);
+    }
+}
