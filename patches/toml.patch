+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+use toml_edit::{Array, ArrayOfTables, Date, Datetime, InlineTable, Offset, Time};
+
+/// A valid TOML datetime in one of the four documented forms (offset
+/// datetime, local datetime, local date, local time), with field ranges
+/// taken from the `toml_datetime` docs.
+#[hegel::composite]
+fn arbitrary_datetime(tc: hegel::TestCase) -> Datetime {
+    // 0 = offset datetime, 1 = local datetime, 2 = local date, 3 = local time
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+    let date = (kind != 3).then(|| {
+        let year: u16 = tc.draw(generators::integers::<u16>().max_value(9999));
+        let month: u8 = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+        let max_day: u8 = match month {
+            2 => {
+                if leap {
+                    29
+                } else {
+                    28
+                }
+            }
+            4 | 6 | 9 | 11 => 30,
+            _ => 31,
+        };
+        let day: u8 = tc.draw(generators::integers::<u8>().min_value(1).max_value(max_day));
+        Date { year, month, day }
+    });
+    let time = (kind != 2).then(|| {
+        let hour: u8 = tc.draw(generators::integers::<u8>().max_value(23));
+        let minute: u8 = tc.draw(generators::integers::<u8>().max_value(59));
+        // Seconds are optional per TOML 1.1 (`Time::second` is an `Option`).
+        // `60` is only valid "based on leap second rules", which we cannot
+        // model here, so we stay within 0..=59.
+        let second: Option<u8> =
+            tc.draw(generators::optional(generators::integers::<u8>().max_value(59)));
+        // A fractional part requires a seconds part.
+        let nanosecond: Option<u32> = if second.is_some() {
+            tc.draw(generators::optional(
+                generators::integers::<u32>().max_value(999_999_999),
+            ))
+        } else {
+            None
+        };
+        Time {
+            hour,
+            minute,
+            second,
+            nanosecond,
+        }
+    });
+    let offset = (kind == 0).then(|| {
+        tc.draw(hegel::one_of!(
+            generators::just(Offset::Z),
+            // RFC 3339 allows offsets up to +/-23:59. (The doc comment on
+            // `Offset::Custom` says `-1_440..1_440`, but -24:00 is not
+            // representable in the TOML/RFC 3339 grammar.)
+            generators::integers::<i16>()
+                .min_value(-1439)
+                .max_value(1439)
+                .map(|minutes| Offset::Custom { minutes }),
+        ))
+    });
+    Datetime { date, time, offset }
+}
+
+/// Any scalar TOML value.
+#[hegel::composite]
+fn arbitrary_scalar(tc: hegel::TestCase) -> Value {
+    tc.draw(hegel::one_of!(
+        generators::integers::<i64>().map(Value::from),
+        generators::floats::<f64>().map(Value::from),
+        generators::booleans().map(Value::from),
+        generators::text().map(Value::from),
+        arbitrary_datetime().map(Value::from),
+    ))
+}
+
+/// Any TOML value, with arrays and inline tables nested up to `depth` levels.
+///
+/// This is a plain helper rather than a `#[hegel::composite]` because a
+/// composite cannot recursively draw from itself (the opaque generator type's
+/// `Send` bound cannot be resolved: E0283).
+fn arbitrary_value(tc: &hegel::TestCase, depth: u8) -> Value {
+    let choice: u8 = if depth == 0 {
+        0
+    } else {
+        tc.draw(generators::integers::<u8>().max_value(3))
+    };
+    match choice {
+        0 | 1 => tc.draw(arbitrary_scalar()),
+        2 => {
+            let n: usize = tc.draw(generators::integers::<usize>().max_value(4));
+            let mut arr = Array::new();
+            for _ in 0..n {
+                arr.push(arbitrary_value(tc, depth - 1));
+            }
+            Value::Array(arr)
+        }
+        _ => {
+            let n: usize = tc.draw(generators::integers::<usize>().max_value(4));
+            let mut t = InlineTable::new();
+            for _ in 0..n {
+                let k: String = tc.draw(generators::text());
+                let v = arbitrary_value(tc, depth - 1);
+                t.insert(k, v);
+            }
+            Value::InlineTable(t)
+        }
+    }
+}
+
+/// A table containing values, sub-tables, and arrays of tables, nested up to
+/// `depth` levels, with arbitrary (including non-bare) keys.
+///
+/// Plain helper for the same recursion reason as [`arbitrary_value`].
+fn arbitrary_table(tc: &hegel::TestCase, depth: u8) -> Table {
+    let mut t = Table::new();
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(4));
+    for _ in 0..n {
+        let k: String = tc.draw(generators::text());
+        let choice: u8 = if depth == 0 {
+            0
+        } else {
+            tc.draw(generators::integers::<u8>().max_value(3))
+        };
+        match choice {
+            0 | 1 => {
+                t.insert(&k, value(arbitrary_value(tc, depth)));
+            }
+            2 => {
+                t.insert(&k, Item::Table(arbitrary_table(tc, depth - 1)));
+            }
+            _ => {
+                let m: usize = tc.draw(generators::integers::<usize>().max_value(2));
+                let mut aot = ArrayOfTables::new();
+                for _ in 0..m {
+                    aot.push(arbitrary_table(tc, depth - 1));
+                }
+                t.insert(&k, Item::ArrayOfTables(aot));
+            }
+        }
+    }
+    t
+}
+
+/// Round-trip: encoding an integer `Value` and parsing it back yields the
+/// same integer, across the full `i64` range (including `MIN`/`MAX`).
+#[hegel::test]
+fn integer_value_roundtrip(tc: hegel::TestCase) {
+    let i: i64 = tc.draw(generators::integers::<i64>());
+    let encoded = Value::from(i).to_string();
+    let parsed: Value = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded: {encoded:?}"));
+    assert_eq!(parsed.as_integer(), Some(i), "encoded: {encoded:?}");
+}
+
+/// Round-trip: encoding a float `Value` and parsing it back yields the same
+/// float, including NaN, infinities, and signed zero.
+#[hegel::test]
+fn float_value_roundtrip(tc: hegel::TestCase) {
+    let f: f64 = tc.draw(generators::floats::<f64>());
+    let encoded = Value::from(f).to_string();
+    let parsed: Value = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded: {encoded:?}"));
+    let p = parsed.as_float().unwrap_or_else(|| {
+        panic!("not parsed back as float\nencoded: {encoded:?}\nparsed: {parsed:?}")
+    });
+    if f.is_nan() {
+        assert!(p.is_nan(), "expected NaN, got {p}\nencoded: {encoded:?}");
+    } else {
+        assert_eq!(p.to_bits(), f.to_bits(), "{f} != {p}\nencoded: {encoded:?}");
+    }
+}
+
+/// Round-trip: encoding a datetime `Value` and parsing it back yields the
+/// same `Datetime` for all four datetime forms.
+#[hegel::test]
+fn datetime_value_roundtrip(tc: hegel::TestCase) {
+    let dt: Datetime = tc.draw(arbitrary_datetime());
+    let encoded = Value::from(dt).to_string();
+    let parsed: Value = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded: {encoded:?}"));
+    assert_eq!(parsed.as_datetime(), Some(&dt), "encoded: {encoded:?}");
+}
+
+/// Parse robustness: `DocumentMut::from_str` must never panic, no matter the
+/// input (mirrors the `toml_edit_fuzz/parse_document.rs` fuzz target).
+#[hegel::test]
+fn parse_arbitrary_input_does_not_panic(tc: hegel::TestCase) {
+    let s: String = tc.draw(generators::text());
+    let _ = s.parse::<DocumentMut>();
+}
+
+/// TOML-ish input: a mix of fully arbitrary text and text drawn from TOML's
+/// syntax alphabet, so that a useful fraction of inputs actually parses.
+#[hegel::composite]
+fn toml_ish(tc: hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        generators::text(),
+        generators::from_regex(r#"[a-z0-9=\[\]{}.,#'"\\ \n\t-]{0,60}"#).fullmatch(true),
+    ))
+}
+
+/// Port of the `parse_document` fuzz target's property: if input parses, the
+/// displayed document must re-parse, and its display must be a fixed point.
+#[hegel::test(test_cases = 500)]
+fn parsed_document_display_roundtrip_is_stable(tc: hegel::TestCase) {
+    let s: String = tc.draw(toml_ish());
+    let Ok(doc) = s.parse::<DocumentMut>() else {
+        return;
+    };
+    let encoded = doc.to_string();
+    let reparsed: DocumentMut = encoded.parse().unwrap_or_else(|err| {
+        panic!("error: {err}\ninput: {s:?}\nencoded: {encoded:?}")
+    });
+    assert_eq!(reparsed.to_string(), encoded, "input: {s:?}");
+}
+
+/// A programmatically-constructed document displays as valid TOML, and that
+/// display is a fixed point of parse -> display.
+#[hegel::test]
+fn constructed_document_display_parse_display_is_identity(tc: hegel::TestCase) {
+    let root: Table = arbitrary_table(&tc, 2);
+    let mut doc = DocumentMut::new();
+    *doc.as_table_mut() = root;
+    let encoded = doc.to_string();
+    let parsed: DocumentMut = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded:\n```\n{encoded}\n```"));
+    assert_eq!(parsed.to_string(), encoded);
+}
+
+/// Keys drawn from a small pool (to get collisions) plus arbitrary text.
+#[hegel::composite]
+fn model_key(tc: hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        generators::sampled_from(vec![
+            "a".to_owned(),
+            "b".to_owned(),
+            "c".to_owned(),
+            "d".to_owned(),
+        ]),
+        generators::text(),
+    ))
+}
+
+/// Model test: `Table` behaves like an insertion-ordered map
+/// (`Vec<(String, i64)>` model): `insert` replaces in place, `remove` shifts,
+/// and iteration order matches.
+struct TableModel {
+    subject: Table,
+    model: Vec<(String, i64)>,
+}
+
+#[hegel::state_machine]
+impl TableModel {
+    #[rule]
+    fn insert(&mut self, tc: hegel::TestCase) {
+        let key: String = tc.draw(model_key());
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        let old = self.subject.insert(&key, value(v));
+        match self.model.iter_mut().find(|(k, _)| *k == key) {
+            Some((_, mv)) => {
+                assert_eq!(old.as_ref().and_then(|i| i.as_integer()), Some(*mv));
+                *mv = v;
+            }
+            None => {
+                assert!(old.is_none());
+                self.model.push((key, v));
+            }
+        }
+    }
+
+    #[rule]
+    fn get_or_insert_via_entry(&mut self, tc: hegel::TestCase) {
+        let key: String = tc.draw(model_key());
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        let item = self.subject.entry(&key).or_insert(value(v));
+        match self.model.iter().find(|(k, _)| *k == key) {
+            Some((_, mv)) => assert_eq!(item.as_integer(), Some(*mv)),
+            None => {
+                assert_eq!(item.as_integer(), Some(v));
+                self.model.push((key, v));
+            }
+        }
+    }
+
+    #[rule]
+    fn remove(&mut self, tc: hegel::TestCase) {
+        let key: String = tc.draw(model_key());
+        let removed = self.subject.remove(&key);
+        match self.model.iter().position(|(k, _)| *k == key) {
+            Some(idx) => {
+                let (_, mv) = self.model.remove(idx);
+                assert_eq!(removed.and_then(|i| i.as_integer()), Some(mv));
+            }
+            None => assert!(removed.is_none()),
+        }
+    }
+
+    #[rule]
+    fn get(&mut self, tc: hegel::TestCase) {
+        let key: String = tc.draw(model_key());
+        let got = self.subject.get(&key).and_then(|i| i.as_integer());
+        let expected = self
+            .model
+            .iter()
+            .find(|(k, _)| *k == key)
+            .map(|(_, v)| *v);
+        assert_eq!(got, expected);
+        assert_eq!(
+            self.subject.contains_key(&key),
+            expected.is_some()
+        );
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _: hegel::TestCase) {
+        assert_eq!(self.subject.len(), self.model.len());
+        for ((sk, sv), (mk, mv)) in self.subject.iter().zip(self.model.iter()) {
+            assert_eq!(sk, mk);
+            assert_eq!(sv.as_integer(), Some(*mv));
+        }
+    }
+}
+
+#[hegel::test]
+fn table_matches_model_map(tc: hegel::TestCase) {
+    let machine = TableModel {
+        subject: Table::new(),
+        model: Vec::new(),
+    };
+    hegel::stateful::run(machine, tc);
+}
+
+/// Model test: `Array` behaves like a `Vec<i64>` under push/insert/remove/
+/// replace/clear, including returned old values and iteration order.
+struct ArrayModel {
+    subject: Array,
+    model: Vec<i64>,
+}
+
+#[hegel::state_machine]
+impl ArrayModel {
+    #[rule]
+    fn push(&mut self, tc: hegel::TestCase) {
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        self.subject.push(v);
+        self.model.push(v);
+    }
+
+    #[rule]
+    fn insert(&mut self, tc: hegel::TestCase) {
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        let idx: usize = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+        self.subject.insert(idx, v);
+        self.model.insert(idx, v);
+    }
+
+    #[rule]
+    fn remove(&mut self, tc: hegel::TestCase) {
+        tc.assume(!self.model.is_empty());
+        let idx: usize = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+        let removed = self.subject.remove(idx);
+        let expected = self.model.remove(idx);
+        assert_eq!(removed.as_integer(), Some(expected));
+    }
+
+    #[rule]
+    fn replace(&mut self, tc: hegel::TestCase) {
+        tc.assume(!self.model.is_empty());
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        let idx: usize = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+        let old = self.subject.replace(idx, v);
+        assert_eq!(old.as_integer(), Some(self.model[idx]));
+        self.model[idx] = v;
+    }
+
+    #[rule]
+    fn clear(&mut self, _: hegel::TestCase) {
+        self.subject.clear();
+        self.model.clear();
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _: hegel::TestCase) {
+        assert_eq!(self.subject.len(), self.model.len());
+        assert_eq!(self.subject.is_empty(), self.model.is_empty());
+        for (i, mv) in self.model.iter().enumerate() {
+            let sv = self.subject.get(i).and_then(Value::as_integer);
+            assert_eq!(sv, Some(*mv));
+        }
+    }
+}
+
+#[hegel::test]
+fn array_matches_model_vec(tc: hegel::TestCase) {
+    let machine = ArrayModel {
+        subject: Array::new(),
+        model: Vec::new(),
+    };
+    hegel::stateful::run(machine, tc);
+}
+
+/// `Table::sort_values` sorts the key/value pairs by key ("sorts
+/// Key/Value Pairs of the table" — table.rs), so iteration afterwards yields
+/// keys in non-decreasing order.
+#[hegel::test]
+fn sort_values_sorts_keys(tc: hegel::TestCase) {
+    let keys: Vec<String> = tc.draw(generators::vecs(generators::text()).unique(true));
+    let mut t = Table::new();
+    for (i, k) in keys.iter().enumerate() {
+        t.insert(k, value(i as i64));
+    }
+    t.sort_values();
+    let sorted: Vec<&str> = t.iter().map(|(k, _)| k).collect();
+    assert_eq!(sorted.len(), keys.len());
+    for w in sorted.windows(2) {
+        assert!(w[0] <= w[1], "keys out of order: {:?} > {:?}", w[0], w[1]);
+    }
+}
+
+/// `Table::sort_values` is idempotent: sorting twice renders the same
+/// document as sorting once.
+#[hegel::test]
+fn sort_values_is_idempotent(tc: hegel::TestCase) {
+    let root: Table = arbitrary_table(&tc, 1);
+    let mut doc = DocumentMut::new();
+    *doc.as_table_mut() = root;
+    doc.as_table_mut().sort_values();
+    let once = doc.to_string();
+    doc.as_table_mut().sort_values();
+    let twice = doc.to_string();
+    assert_eq!(once, twice);
+}
+
+/// `Table::into_inline_table` and `InlineTable::into_table` are inverse
+/// conversions for flat tables of scalar values: keys, order, and values are
+/// preserved.
+#[hegel::test]
+fn table_inline_table_roundtrip_preserves_pairs(tc: hegel::TestCase) {
+    let keys: Vec<String> = tc.draw(generators::vecs(generators::text()).unique(true));
+    let mut t = Table::new();
+    let mut expected = Vec::new();
+    for k in &keys {
+        let v: i64 = tc.draw(generators::integers::<i64>());
+        t.insert(k, value(v));
+        expected.push((k.clone(), v));
+    }
+    let roundtripped = t.into_inline_table().into_table();
+    assert_eq!(roundtripped.len(), expected.len());
+    for ((sk, sv), (mk, mv)) in roundtripped.iter().zip(expected.iter()) {
+        assert_eq!(sk, mk);
+        assert_eq!(sv.as_integer(), Some(*mv));
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Generators for *valid TOML text*, used to test toml_edit's core promise:
+// parsing and re-displaying a document preserves it byte-for-byte (lib.rs:
+// "parse and modify toml documents, while preserving comments, spaces *and
+// relative order* of items"; the lib.rs example asserts
+// `doc.to_string() == toml`). Validity rules are transcribed from the TOML
+// ABNF, so these generators double as a spec oracle for string decoding.
+// ---------------------------------------------------------------------------
+
+/// Horizontal whitespace (`ws` in the TOML ABNF): spaces and tabs.
+fn draw_ws(tc: &hegel::TestCase) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(2));
+    let mut s = String::new();
+    for _ in 0..n {
+        s.push(if tc.draw(generators::booleans()) {
+            ' '
+        } else {
+            '\t'
+        });
+    }
+    s
+}
+
+/// A TOML newline.
+///
+/// CRLF is equally valid TOML, but display strips the `\r` from all decor
+/// (`RawString::encode`, src/raw_string.rs:88), so generating it here would
+/// fail byte-identity for the known reason pinned by
+/// `crlf_line_endings_are_preserved` below. LF-only keeps the sibling
+/// properties green while still testing everything else.
+fn draw_newline(_tc: &hegel::TestCase) -> String {
+    "\n".to_owned()
+}
+
+/// A comment, without the trailing newline. TOML 1.1 forbids control
+/// characters other than tab in comments, so the alphabet stays printable
+/// (plus tab and non-ASCII).
+fn draw_comment(tc: &hegel::TestCase) -> String {
+    let body: String = tc.draw(
+        generators::from_regex("[ \\ta-zA-Z0-9=\\[\\]'\",.#!☃é-]{0,10}").fullmatch(true),
+    );
+    format!("#{body}")
+}
+
+/// Zero or more blank/comment lines (`ws [comment] newline`).
+fn draw_trivia_lines(tc: &hegel::TestCase) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(2));
+    let mut s = String::new();
+    for _ in 0..n {
+        s.push_str(&draw_ws(tc));
+        if tc.draw(generators::booleans()) {
+            s.push_str(&draw_comment(tc));
+        }
+        s.push_str(&draw_newline(tc));
+    }
+    s
+}
+
+/// `ws-comment-newline` in the array ABNF: whitespace in which comments and
+/// newlines may freely appear.
+fn draw_ws_comment_newline(tc: &hegel::TestCase) -> String {
+    let mut s = draw_trivia_lines(tc);
+    s.push_str(&draw_ws(tc));
+    s
+}
+
+/// A character allowed *literally* in literal strings and literal keys:
+/// anything printable except the apostrophe (literal-char ABNF:
+/// `%x09 / %x20-26 / %x28-7E / non-ascii`).
+fn draw_literal_char(tc: &hegel::TestCase) -> char {
+    let c: char = tc.draw(
+        hegel::one_of!(
+            generators::integers::<u32>().min_value(0x20).max_value(0x7E),
+            generators::just(0x09_u32),
+            generators::sampled_from(vec![0xE9_u32, 0x2603, 0x1F600]), // é ☃ 😀
+        )
+        .map(|n| char::from_u32(n).unwrap()),
+    );
+    if c == '\'' { 'x' } else { c }
+}
+
+/// Arbitrary string *content* biased toward the escape boundary: quotes,
+/// backslashes, control characters, DEL, and non-ASCII.
+fn draw_string_content(tc: &hegel::TestCase) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(6));
+    let mut s = String::new();
+    for _ in 0..n {
+        let c: char = tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                '"', '\\', '\'', '\n', '\t', '\r', '\u{0}', '\u{8}', '\u{c}', '\u{1f}',
+                '\u{7f}',
+            ]),
+            generators::integers::<u32>()
+                .min_value(0x20)
+                .max_value(0x7E)
+                .map(|n| char::from_u32(n).unwrap()),
+            generators::sampled_from(vec!['é', '☃', '😀', '\u{FFFD}']),
+        ));
+        s.push(c);
+    }
+    s
+}
+
+/// Encode `content` as a TOML basic string (`"..."` or `"""..."""`), drawing
+/// among the *valid* representations of each character (literal, shorthand
+/// escape, `\uXXXX`/`\UXXXXXXXX`) — the escape-boundary choices where
+/// writer/parser bugs live. Transcribed from the TOML ABNF.
+fn encode_basic_string(tc: &hegel::TestCase, content: &str, multiline: bool) -> String {
+    let delim = if multiline { "\"\"\"" } else { "\"" };
+    let mut out = String::from(delim);
+    if multiline && tc.draw(generators::booleans()) {
+        // A newline immediately after the opening delimiter is trimmed, so
+        // this is purely cosmetic and must be preserved but not decoded.
+        out.push('\n');
+    }
+    let mut quote_run = 0_usize;
+    for (i, c) in content.chars().enumerate() {
+        let mut is_literal_quote = false;
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '"' => {
+                // Runs of one or two literal quotes are allowed anywhere in a
+                // multiline body (`mlb-quotes` in the ABNF), including
+                // immediately before the closing delimiter.
+                if multiline && quote_run < 2 && tc.draw(generators::booleans()) {
+                    out.push('"');
+                    is_literal_quote = true;
+                } else {
+                    out.push_str("\\\"");
+                }
+            }
+            '\n' => {
+                // Literal newlines are only allowed in multiline strings; as
+                // the first content character one would be trimmed, so it
+                // must be escaped there.
+                if multiline && i != 0 && tc.draw(generators::booleans()) {
+                    out.push('\n');
+                } else {
+                    out.push_str("\\n");
+                }
+            }
+            '\t' => {
+                if tc.draw(generators::booleans()) {
+                    out.push('\t');
+                } else {
+                    out.push_str("\\t");
+                }
+            }
+            '\u{8}' => out.push_str("\\b"),
+            '\u{c}' => out.push_str("\\f"),
+            '\r' => out.push_str("\\r"),
+            c if (c as u32) < 0x20 || c == '\u{7f}' => {
+                out.push_str(&format!("\\u{:04X}", c as u32));
+            }
+            c => {
+                let esc: u8 = tc.draw(generators::integers::<u8>().max_value(9));
+                if esc == 0 && (c as u32) <= 0xFFFF {
+                    out.push_str(&format!("\\u{:04X}", c as u32));
+                } else if esc == 1 {
+                    out.push_str(&format!("\\U{:08X}", c as u32));
+                } else {
+                    out.push(c);
+                }
+            }
+        }
+        quote_run = if is_literal_quote { quote_run + 1 } else { 0 };
+    }
+    out.push_str(delim);
+    out
+}
+
+/// Multiline-literal string content: printable chars, tabs, newlines, and
+/// apostrophe runs of length one or two (never three; `mll-quotes` ABNF).
+fn draw_ml_literal_content(tc: &hegel::TestCase) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(5));
+    let mut s = String::new();
+    for _ in 0..n {
+        let piece: u8 = tc.draw(generators::integers::<u8>().max_value(4));
+        match piece {
+            0 => s.push('\n'),
+            1..=3 => s.push(draw_literal_char(tc)),
+            _ => {
+                let quotes: usize =
+                    tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+                for _ in 0..quotes {
+                    s.push('\'');
+                }
+                // A quote run must be followed by content unless it is the
+                // final piece; a trailing run before the closing delimiter is
+                // also valid, which the loop end covers naturally.
+                s.push(draw_literal_char(tc));
+            }
+        }
+    }
+    // Optional trailing apostrophes (allowed by the `[ mll-quotes ]` tail).
+    let trailing: usize = tc.draw(generators::integers::<usize>().max_value(2));
+    for _ in 0..trailing {
+        s.push('\'');
+    }
+    s
+}
+
+/// A TOML string in any of the four forms, returned as
+/// `(valid TOML representation, expected decoded value)`.
+fn draw_string_repr(tc: &hegel::TestCase) -> (String, String) {
+    let style: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+    match style {
+        // basic "..."
+        0 => {
+            let content = draw_string_content(tc);
+            (encode_basic_string(tc, &content, false), content)
+        }
+        // multiline basic """..."""
+        1 => {
+            let content = draw_string_content(tc);
+            (encode_basic_string(tc, &content, true), content)
+        }
+        // literal '...'
+        2 => {
+            let n: usize = tc.draw(generators::integers::<usize>().max_value(6));
+            let content: String = (0..n).map(|_| draw_literal_char(tc)).collect();
+            (format!("'{content}'"), content)
+        }
+        // multiline literal '''...'''
+        _ => {
+            let content = draw_ml_literal_content(tc);
+            let mut repr = String::from("'''");
+            // A newline right after the opening delimiter is trimmed; emit
+            // one when the content itself starts with a newline (mandatory,
+            // no escapes exist to protect it) or cosmetically.
+            if content.starts_with('\n') || tc.draw(generators::booleans()) {
+                repr.push('\n');
+            }
+            repr.push_str(&content);
+            repr.push_str("'''");
+            (repr, content)
+        }
+    }
+}
+
+/// Insert TOML-valid underscore separators between digits.
+fn insert_underscores(tc: &hegel::TestCase, digits: &str) -> String {
+    let chars: Vec<char> = digits.chars().collect();
+    let mut out = String::new();
+    for (i, c) in chars.iter().enumerate() {
+        out.push(*c);
+        if i + 1 < chars.len() && tc.draw(generators::integers::<u8>().max_value(7)) == 0 {
+            out.push('_');
+        }
+    }
+    out
+}
+
+/// A valid TOML integer literal: decimal (full `i64` range, optional `+`,
+/// underscores) or hex/octal/binary (which must still fit in `i64`).
+fn draw_integer_text(tc: &hegel::TestCase) -> String {
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(4));
+    match kind {
+        0 | 1 => {
+            let v: i64 = tc.draw(generators::integers::<i64>());
+            let s = v.to_string();
+            let (sign, digits) = if let Some(rest) = s.strip_prefix('-') {
+                ("-", rest.to_owned())
+            } else if v >= 0 && tc.draw(generators::booleans()) {
+                ("+", s)
+            } else {
+                ("", s)
+            };
+            format!("{sign}{}", insert_underscores(tc, &digits))
+        }
+        2 => {
+            let v: i64 = tc.draw(generators::integers::<i64>().min_value(0));
+            let digits = if tc.draw(generators::booleans()) {
+                format!("{v:x}")
+            } else {
+                format!("{v:X}")
+            };
+            format!("0x{}", insert_underscores(tc, &digits))
+        }
+        3 => {
+            let v: i64 = tc.draw(generators::integers::<i64>().min_value(0));
+            format!("0o{}", insert_underscores(tc, &format!("{v:o}")))
+        }
+        _ => {
+            let v: i64 = tc.draw(generators::integers::<i64>().min_value(0));
+            format!("0b{}", insert_underscores(tc, &format!("{v:b}")))
+        }
+    }
+}
+
+/// A valid TOML float literal: fractional and/or exponent forms (exponents
+/// may have leading zeros), underscores, and the inf/nan specials.
+fn draw_float_text(tc: &hegel::TestCase) -> String {
+    let sign = match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => "",
+        1 => "+",
+        _ => "-",
+    };
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(4));
+    match kind {
+        0 => format!("{sign}inf"),
+        1 => format!("{sign}nan"),
+        _ => {
+            let int_part = insert_underscores(tc, &tc.draw(generators::integers::<u32>()).to_string());
+            let frac: Option<String> = if kind == 3 {
+                None
+            } else {
+                Some(insert_underscores(
+                    tc,
+                    &tc.draw(generators::from_regex("[0-9]{1,6}").fullmatch(true)),
+                ))
+            };
+            let exp: Option<String> = if kind == 2 {
+                None
+            } else {
+                let e = if tc.draw(generators::booleans()) { "e" } else { "E" };
+                let esign = match tc.draw(generators::integers::<u8>().max_value(2)) {
+                    0 => "",
+                    1 => "+",
+                    _ => "-",
+                };
+                // Exponents are zero-prefixable per the ABNF. Two digits at
+                // most: the parser rejects floats that overflow f64
+                // ("floating-point number overflowed", e.g. `1E310`), so
+                // larger exponents would leave the parser's accepted domain.
+                let digits = tc.draw(generators::from_regex("[0-9]{1,2}").fullmatch(true));
+                Some(format!("{e}{esign}{}", insert_underscores(tc, &digits)))
+            };
+            let mut s = format!("{sign}{int_part}");
+            if let Some(frac) = frac {
+                s.push('.');
+                s.push_str(&frac);
+            }
+            if let Some(exp) = exp {
+                s.push_str(&exp);
+            }
+            s
+        }
+    }
+}
+
+/// A valid TOML datetime literal, in any of the four forms, including the
+/// lowercase `t`/`z` and space-separator spellings the grammar allows.
+fn draw_datetime_text(tc: &hegel::TestCase) -> String {
+    let dt: Datetime = tc.draw(arbitrary_datetime());
+    let mut s = dt.to_string();
+    if dt.date.is_some() && dt.time.is_some() {
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => {}
+            1 => s = s.replacen('T', "t", 1),
+            _ => s = s.replacen('T', " ", 1),
+        }
+    }
+    if s.ends_with('Z') && tc.draw(generators::booleans()) {
+        s.pop();
+        s.push('z');
+    }
+    s
+}
+
+/// A fresh simple key (bare, literal-quoted, or basic-quoted). The decoded
+/// form always starts with `k{n}_`, so every key in a document is unique and
+/// generated table paths can never conflict.
+fn draw_simple_key(tc: &hegel::TestCase, counter: &mut u32) -> String {
+    let n = *counter;
+    *counter += 1;
+    let style: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+    match style {
+        0 | 1 => {
+            let extra: String =
+                tc.draw(generators::from_regex("[A-Za-z0-9_-]{0,5}").fullmatch(true));
+            format!("k{n}_{extra}")
+        }
+        2 => {
+            let len: usize = tc.draw(generators::integers::<usize>().max_value(4));
+            let extra: String = (0..len).map(|_| draw_literal_char(tc)).collect();
+            format!("'k{n}_{extra}'")
+        }
+        _ => {
+            let extra = draw_string_content(tc);
+            encode_basic_string(tc, &format!("k{n}_{extra}"), false)
+        }
+    }
+}
+
+/// A (possibly dotted) key, with whitespace around the dots.
+fn draw_key_text(tc: &hegel::TestCase, counter: &mut u32) -> String {
+    let mut s = draw_simple_key(tc, counter);
+    let dots: usize = tc.draw(generators::integers::<usize>().max_value(2));
+    for _ in 0..dots {
+        s.push_str(&draw_ws(tc));
+        s.push('.');
+        s.push_str(&draw_ws(tc));
+        s.push_str(&draw_simple_key(tc, counter));
+    }
+    s
+}
+
+/// A valid TOML value literal, recursing into arrays and inline tables.
+fn draw_value_text(tc: &hegel::TestCase, depth: u8, counter: &mut u32) -> String {
+    let max = if depth == 0 { 5 } else { 7 };
+    let choice: u8 = tc.draw(generators::integers::<u8>().max_value(max));
+    match choice {
+        0 => draw_integer_text(tc),
+        1 => draw_float_text(tc),
+        2 => {
+            if tc.draw(generators::booleans()) {
+                "true".to_owned()
+            } else {
+                "false".to_owned()
+            }
+        }
+        3 => draw_datetime_text(tc),
+        4 | 5 => draw_string_repr(tc).0,
+        6 => draw_array_text(tc, depth - 1, counter),
+        _ => draw_inline_table_text(tc, depth - 1, counter),
+    }
+}
+
+/// An array literal, with comments, newlines, and an optional trailing comma.
+fn draw_array_text(tc: &hegel::TestCase, depth: u8, counter: &mut u32) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(3));
+    let mut s = String::from("[");
+    for i in 0..n {
+        s.push_str(&draw_ws_comment_newline(tc));
+        s.push_str(&draw_value_text(tc, depth, counter));
+        s.push_str(&draw_ws_comment_newline(tc));
+        if i + 1 < n || tc.draw(generators::booleans()) {
+            s.push(',');
+        }
+    }
+    s.push_str(&draw_ws_comment_newline(tc));
+    s.push(']');
+    s
+}
+
+/// An inline table literal (TOML 1.0 form: single line, no trailing comma).
+fn draw_inline_table_text(tc: &hegel::TestCase, depth: u8, counter: &mut u32) -> String {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(2));
+    let mut s = String::from("{");
+    for i in 0..n {
+        s.push_str(&draw_ws(tc));
+        s.push_str(&draw_simple_key(tc, counter));
+        s.push_str(&draw_ws(tc));
+        s.push('=');
+        s.push_str(&draw_ws(tc));
+        s.push_str(&draw_value_text(tc, depth, counter));
+        if i + 1 < n {
+            s.push_str(&draw_ws(tc));
+            s.push(',');
+        }
+    }
+    s.push_str(&draw_ws(tc));
+    s.push('}');
+    s
+}
+
+/// A full `key = value` line with decor and an optional trailing comment.
+fn draw_keyval_line(tc: &hegel::TestCase, counter: &mut u32) -> String {
+    let mut s = draw_ws(tc);
+    s.push_str(&draw_key_text(tc, counter));
+    s.push_str(&draw_ws(tc));
+    s.push('=');
+    s.push_str(&draw_ws(tc));
+    s.push_str(&draw_value_text(tc, 2, counter));
+    s.push_str(&draw_ws(tc));
+    if tc.draw(generators::booleans()) {
+        s.push_str(&draw_comment(tc));
+    }
+    s.push_str(&draw_newline(tc));
+    s
+}
+
+/// A complete, valid TOML document: root key/values, standard tables, and
+/// arrays of tables, interleaved with comment/blank lines. Every simple key
+/// is globally unique, so no construct can collide with another.
+fn draw_valid_toml_document(tc: &hegel::TestCase) -> String {
+    let mut counter = 0_u32;
+    let mut s = draw_trivia_lines(tc);
+    let n_root: usize = tc.draw(generators::integers::<usize>().max_value(3));
+    for _ in 0..n_root {
+        s.push_str(&draw_keyval_line(tc, &mut counter));
+        s.push_str(&draw_trivia_lines(tc));
+    }
+    let n_sections: usize = tc.draw(generators::integers::<usize>().max_value(3));
+    for _ in 0..n_sections {
+        let aot = tc.draw(generators::booleans());
+        let path = draw_key_text(tc, &mut counter);
+        let reps: usize = if aot {
+            tc.draw(generators::integers::<usize>().min_value(1).max_value(2))
+        } else {
+            1
+        };
+        // The header core (brackets, internal whitespace, key path) is drawn
+        // once and reused for every `[[...]]` repetition: toml_edit stores
+        // the key repr of an array-of-tables once, so differing whitespace
+        // in later headers is normalized to the first occurrence's (see
+        // "Suspected bugs" in HEGEL_REPORT.md).
+        let header_core = {
+            let open = if aot { "[[" } else { "[" };
+            let close = if aot { "]]" } else { "]" };
+            format!(
+                "{}{open}{}{path}{}{close}",
+                draw_ws(tc),
+                draw_ws(tc),
+                draw_ws(tc)
+            )
+        };
+        for _ in 0..reps {
+            s.push_str(&header_core);
+            s.push_str(&draw_ws(tc));
+            if tc.draw(generators::booleans()) {
+                s.push_str(&draw_comment(tc));
+            }
+            s.push_str(&draw_newline(tc));
+            s.push_str(&draw_trivia_lines(tc));
+            let n_kv: usize = tc.draw(generators::integers::<usize>().max_value(2));
+            for _ in 0..n_kv {
+                s.push_str(&draw_keyval_line(tc, &mut counter));
+                s.push_str(&draw_trivia_lines(tc));
+            }
+        }
+    }
+    // A document may validly end without a trailing newline, but display
+    // appends one (e.g. "[t]" displays as "[t]\n"), so that final byte is
+    // not preserved; see the "Suspected bugs" notes in HEGEL_REPORT.md. The
+    // generated document therefore always ends with a newline.
+    s
+}
+
+/// Core promise: parsing a valid document and re-displaying it is
+/// byte-for-byte identical (format preservation), and hence a fixpoint.
+#[hegel::test]
+fn valid_document_display_is_byte_identical(tc: hegel::TestCase) {
+    let src = draw_valid_toml_document(&tc);
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("generated document did not parse: {err}\n```\n{src}\n```"));
+    let out = doc.to_string();
+    assert_eq!(out, src, "display is not byte-identical to the parsed input");
+    // Fixpoint: re-parsing the display and displaying again is stable.
+    let redoc: DocumentMut = out
+        .parse()
+        .unwrap_or_else(|err| panic!("display did not re-parse: {err}\n```\n{out}\n```"));
+    assert_eq!(redoc.to_string(), out);
+}
+
+/// String forms at the escape boundary: every generated representation
+/// (basic, literal, and their multiline forms, with escapes chosen at the
+/// boundary) must decode to exactly the content it encodes (oracle:
+/// the TOML ABNF, transcribed into the generator) and be preserved verbatim.
+#[hegel::test]
+fn string_reprs_decode_correctly_and_are_preserved(tc: hegel::TestCase) {
+    let (repr, expected) = draw_string_repr(&tc);
+    let src = format!("k = {repr}\n");
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("string repr did not parse: {err}\nrepr: {repr:?}"));
+    assert_eq!(
+        doc["k"].as_str(),
+        Some(expected.as_str()),
+        "string decoded incorrectly\nrepr: {repr:?}"
+    );
+    assert_eq!(doc.to_string(), src, "string repr was not preserved");
+}
