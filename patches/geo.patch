+/// Hegel property-based tests for `Simplify`.
+#[cfg(test)]
+mod hegel_props {
+    use super::*;
+    use crate::algorithm::Length;
+    use hegel::generators::{self, Generator};
+
+    /// Arbitrary line strings with finite coordinates. Non-finite coords are
+    /// excluded because `Validation` deems them invalid geometry. Magnitude is
+    /// bounded by `max_coord` — see the callers for why.
+    #[hegel::composite]
+    fn line_strings(tc: hegel::TestCase, max_coord: f64) -> LineString<f64> {
+        let coords: Vec<Coord<f64>> = tc.draw(generators::vecs(
+            generators::tuples!(
+                generators::floats::<f64>()
+                    .min_value(-max_coord)
+                    .max_value(max_coord),
+                generators::floats::<f64>()
+                    .min_value(-max_coord)
+                    .max_value(max_coord),
+            )
+            .map(|(x, y)| Coord { x, y }),
+        ));
+        LineString::from(coords)
+    }
+
+    // `simplify` and `simplify_idx` are documented to describe the same
+    // result: "Returns the indices of the points retained by
+    // `Simplify::simplify`, relative to the input geometry". So the indices
+    // must be strictly increasing, in-bounds, and map input coords exactly
+    // onto the simplified output. Epsilon is entirely unconstrained
+    // (negative, NaN, infinite): whatever the two entry points do, they must
+    // agree.
+    //
+    // KNOWN FAILURE — suspected library bug (kept failing on purpose; this is
+    // the canonical witness). For finite coordinates large enough that the
+    // cross product inside `Euclidean.distance(coord, &Line)` overflows f64,
+    // the distance becomes NaN, so `compute_rdp`'s farthest-point fold never
+    // advances past its `(0, 0.0)` seed and the library's own
+    // `debug_assert_ne!(farthest_index, 0)` (simplify.rs:108) panics in debug
+    // builds. Minimal counterexample:
+    //   LINESTRING(0 -8.988465674311469e307, 0 0, 3 -0), epsilon = 2.0
+    // In release builds there is no panic, but the middle point — at true
+    // perpendicular distance ~3.0 > epsilon — is silently discarded,
+    // violating the documented contract that only "points closer than
+    // `epsilon` distance from the simplified output may be discarded".
+    #[hegel::test]
+    fn pbt_simplify_matches_simplify_idx(tc: hegel::TestCase) {
+        let ls = tc.draw(line_strings(f64::MAX));
+        let epsilon = tc.draw(generators::floats::<f64>());
+        let simplified = ls.simplify(epsilon);
+        // Qualified call: the deprecated `SimplifyIdx` trait also has a
+        // `simplify_idx` method.
+        let indices = Simplify::simplify_idx(&ls, epsilon);
+        assert_eq!(
+            simplified.0.len(),
+            indices.len(),
+            "simplify and simplify_idx retained different numbers of points"
+        );
+        assert!(
+            indices.windows(2).all(|w| w[0] < w[1]),
+            "simplify_idx indices are not strictly increasing: {indices:?}"
+        );
+        for (coord, &index) in simplified.0.iter().zip(&indices) {
+            assert_eq!(
+                *coord, ls.0[index],
+                "simplified coord does not match input coord at index {index}"
+            );
+        }
+    }
+
+    // RDP retains a subsequence of the input vertices, and a polyline through
+    // a subsequence of vertices is never longer than the original (triangle
+    // inequality) — the same property the repo's `fuzz/fuzz_targets/simplify.rs`
+    // checks for polygons.
+    // Coordinates are capped at ±1e150 to stay clear of the overflow-to-NaN
+    // distance bug pinned by `pbt_simplify_matches_simplify_idx` above, so
+    // this property keeps testing everything else while that bug is open.
+    #[hegel::test]
+    fn pbt_simplify_never_increases_length(tc: hegel::TestCase) {
+        let ls = tc.draw(line_strings(1e150));
+        let epsilon = tc.draw(generators::floats::<f64>());
+        let simplified = ls.simplify(epsilon);
+        let original_length = Euclidean.length(&ls);
+        let simplified_length = Euclidean.length(&simplified);
+        // Relative slack covers float rounding only: removing exactly
+        // collinear vertices keeps the true length equal, but the two
+        // summations may round in opposite directions.
+        assert!(
+            simplified_length <= original_length * (1.0 + 1e-9) + 1e-9,
+            "simplification increased length: {original_length} -> {simplified_length}"
+        );
+    }
+}
