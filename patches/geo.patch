+/// Hegel property-based tests for `Centroid`.
+#[cfg(test)]
+mod hegel_props {
+    use crate::algorithm::Translate;
+    use crate::centroid::Centroid;
+    use crate::utils::pbt_gens::star_polygon;
+    use hegel::generators;
+
+    // The centroid is translation-equivariant:
+    // centroid(translate(P, dx, dy)) == centroid(P) + (dx, dy).
+    // The implementation deliberately shifts each ring by its first coordinate
+    // to stay numerically stable far from the origin (see
+    // `centroid_polygon_numerical_stability` above), so this must hold to high
+    // precision even for large offsets.
+    #[hegel::test]
+    fn pbt_centroid_translation_equivariant(tc: hegel::TestCase) {
+        let poly = tc.draw(star_polygon());
+        let dx = tc.draw(generators::floats::<f64>().min_value(-1e6).max_value(1e6));
+        let dy = tc.draw(generators::floats::<f64>().min_value(-1e6).max_value(1e6));
+        let c = poly
+            .centroid()
+            .expect("star polygons have strictly positive area");
+        let translated = poly
+            .translate(dx, dy)
+            .centroid()
+            .expect("translation preserves positive area");
+        // Absolute slack scales with the offset: translating by up to 1e6
+        // costs ~ulp(1e6) per coordinate. Both slack terms protect the test's
+        // float tolerance, not a library contract.
+        let tol = 1e-9 * (1.0 + dx.abs() + dy.abs());
+        assert_relative_eq!(translated.x(), c.x() + dx, max_relative = 1e-9, epsilon = tol);
+        assert_relative_eq!(translated.y(), c.y() + dy, max_relative = 1e-9, epsilon = tol);
+    }
+}
