+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel / hegeltest)
+//
+// These exercise Tera's untrusted-input contracts: the compiler must never
+// panic on arbitrary template text, arithmetic must match a Rust oracle, and
+// HTML autoescaping must never leak an unescaped special character. See
+// HEGEL_REPORT.md for the findings, including a documented stack-overflow bug.
+// ---------------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_props {
+    use hegel::generators;
+    use tera::{Context, Tera};
+
+    // Reimplementation of tera's default (non-`fast_escape`) HTML escape, from
+    // tera/src/utils.rs::escape_html. Used as an independent oracle.
+    fn oracle_escape(input: &str) -> String {
+        let mut out = String::new();
+        for c in input.chars() {
+            match c {
+                '&' => out.push_str("&amp;"),
+                '<' => out.push_str("&lt;"),
+                '>' => out.push_str("&gt;"),
+                '"' => out.push_str("&quot;"),
+                '\'' => out.push_str("&#39;"),
+                _ => out.push(c),
+            }
+        }
+        out
+    }
+
+    // A string generator biased toward the HTML encode-set boundary: the five
+    // escaped characters plus adjacent ASCII and some multibyte codepoints.
+    // Bugs live exactly on the characters the escaper forgot.
+    fn boundary_char(tc: &hegel::TestCase) -> char {
+        let choice = tc.draw(generators::integers::<u8>().max_value(9));
+        match choice {
+            0 => '&',
+            1 => '<',
+            2 => '>',
+            3 => '"',
+            4 => '\'',
+            5 => tc.draw(generators::sampled_from(vec![
+                '/', '\\', ';', '#', '=', ' ', '\n', '\t', '`', '{', '}',
+            ])),
+            _ => {
+                // Any codepoint, so multibyte content is exercised too.
+                let n = tc.draw(generators::integers::<u32>().max_value(0x10_FFFF));
+                char::from_u32(n).unwrap_or('\u{FFFD}')
+            }
+        }
+    }
+
+    fn boundary_string(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(40));
+        let mut s = String::new();
+        for _ in 0..n {
+            s.push(boundary_char(tc));
+        }
+        s
+    }
+
+    // -------------------------------------------------------------------
+    // Property 1: compiling arbitrary text never panics.
+    // add_raw_template must return Ok or Err, never unwind or abort.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn compile_arbitrary_text_never_panics(tc: hegel::TestCase) {
+        let src = tc.draw(generators::text().max_size(200));
+        let mut tera = Tera::default();
+        // Result deliberately discarded; we only assert it does not panic.
+        let _ = tera.add_raw_template("probe.html", &src);
+    }
+
+    // -------------------------------------------------------------------
+    // Property 2: compiling template-shaped "token soup" never panics.
+    // We assemble strings out of Tera's delimiters and operators, which is
+    // far more likely to reach deep parser paths than uniform text.
+    // Depth is capped well below the ~8500-repetition stack-overflow
+    // threshold documented in HEGEL_REPORT.md so this stays a live, green
+    // no-panic property; the overflow itself is pinned separately below.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn compile_token_soup_never_panics(tc: hegel::TestCase) {
+        let fragments = vec![
+            "{{", "}}", "{%", "%}", "{#", "#}", "-}}", "-%}", "{{-", "{%-",
+            "|", "+", "-", "*", "/", "//", "%", "**", "and", "or", "not",
+            "(", ")", "[", "]", "{", "}", "if", "endif", "for", "in",
+            "endfor", "set", "true", "false", "none", ".", ",", "==", "!=",
+            "<", ">", "safe", "abs", "upper", "x", "1", "\"s\"", "'t'", " ",
+        ];
+        let n = tc.draw(generators::integers::<usize>().max_value(60));
+        let mut src = String::new();
+        for _ in 0..n {
+            let f = tc.draw(generators::sampled_from(fragments.clone()));
+            src.push_str(f);
+        }
+        let mut tera = Tera::default();
+        let _ = tera.add_raw_template("probe.html", &src);
+    }
+
+    // -------------------------------------------------------------------
+    // Property 3: deeply nested (guarded) constructs return Err, never
+    // overflow. Parentheses/arrays/unary go through MAX_RECURSION_DEPTH,
+    // so even thousands deep must be a clean syntax error.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn deep_guarded_nesting_returns_err_not_overflow(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(50).max_value(5000));
+        let kind = tc.draw(generators::integers::<u8>().max_value(2));
+        let src = match kind {
+            0 => format!("{{{{ {}1{} }}}}", "(".repeat(depth), ")".repeat(depth)),
+            1 => format!("{{{{ {}1{} }}}}", "[".repeat(depth), "]".repeat(depth)),
+            _ => format!("{}x{}", "{% if true %}".repeat(depth), "{% endif %}".repeat(depth)),
+        };
+        let mut tera = Tera::default();
+        // Guarded recursion: must be a graceful Err, never a panic/abort.
+        let res = tera.add_raw_template("probe.html", &src);
+        assert!(res.is_err(), "expected deep nesting depth={depth} kind={kind} to error");
+    }
+
+    // -------------------------------------------------------------------
+    // Property 4: integer arithmetic (+, -, *) matches an i128 checked
+    // oracle. In range -> exact decimal string; overflow -> render error.
+    // Semantics: tera/src/value/number.rs (math! macro, checked_* in i128).
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn integer_arithmetic_matches_i128_oracle(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i128>());
+        let b = tc.draw(generators::integers::<i128>());
+        let op = tc.draw(generators::sampled_from(vec!['+', '-', '*']));
+        let (expected, sym): (Option<i128>, &str) = match op {
+            '+' => (a.checked_add(b), "+"),
+            '-' => (a.checked_sub(b), "-"),
+            _ => (a.checked_mul(b), "*"),
+        };
+        let mut ctx = Context::new();
+        ctx.insert("a", &a);
+        ctx.insert("b", &b);
+        let src = format!("{{{{ a {sym} b }}}}");
+        let res = Tera::one_off(&src, &ctx, false);
+        match expected {
+            Some(v) => {
+                let out = res.unwrap_or_else(|e| panic!("a={a} {sym} b={b}: {e}"));
+                assert_eq!(out, v.to_string(), "a={a} {sym} b={b}");
+            }
+            None => {
+                assert!(res.is_err(), "a={a} {sym} b={b} should overflow -> Err");
+            }
+        }
+    }
+
+    // -------------------------------------------------------------------
+    // Property 5: `/` is always float division and matches an f64 oracle
+    // (rendered via Rust's `{:?}`, which is how tera formats floats).
+    // Division by zero must error. See number.rs::div.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn division_matches_f64_oracle(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i64>());
+        let b = tc.draw(generators::integers::<i64>());
+        let mut ctx = Context::new();
+        ctx.insert("a", &a);
+        ctx.insert("b", &b);
+        let res = Tera::one_off("{{ a / b }}", &ctx, false);
+        if b == 0 {
+            assert!(res.is_err(), "division by zero must error");
+        } else {
+            let expected = format!("{:?}", a as f64 / b as f64);
+            assert_eq!(res.unwrap(), expected, "a={a} / b={b}");
+        }
+    }
+
+    // -------------------------------------------------------------------
+    // Property 6: autoescape safety. With autoescape on, `{{ x }}` must
+    // equal the escaped form of x -- no raw &,<,>,",' survives.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn autoescape_escapes_all_special_chars(tc: hegel::TestCase) {
+        let x = boundary_string(&tc);
+        let mut ctx = Context::new();
+        ctx.insert("x", &x);
+        let out = Tera::one_off("{{ x }}", &ctx, true).expect("render");
+        assert_eq!(out, oracle_escape(&x), "input={x:?}");
+        // Independent structural check: the only special chars in the output
+        // are the ones our template literal has none of, so any raw special
+        // byte would be a leak from x.
+        for bad in ['<', '>', '"', '\''] {
+            assert!(!out.contains(bad), "unescaped {bad:?} leaked from {x:?}");
+        }
+    }
+
+    // -------------------------------------------------------------------
+    // Property 7: `{{ x | safe }}` is verbatim even under autoescape.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn safe_filter_is_verbatim(tc: hegel::TestCase) {
+        let x = boundary_string(&tc);
+        let mut ctx = Context::new();
+        ctx.insert("x", &x);
+        let out = Tera::one_off("{{ x | safe }}", &ctx, true).expect("render");
+        assert_eq!(out, x, "safe filter must not alter {x:?}");
+    }
+
+    // -------------------------------------------------------------------
+    // Property 8: render determinism. Same template + context -> same
+    // output (or the same error), across repeated renders.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn render_is_deterministic(tc: hegel::TestCase) {
+        let x = boundary_string(&tc);
+        let mut ctx = Context::new();
+        ctx.insert("x", &x);
+        let autoescape = tc.draw(generators::booleans());
+        let tpl = "prefix {{ x }} {{ x | upper }} {{ x | length }} suffix";
+        let r1 = Tera::one_off(tpl, &ctx, autoescape).map_err(|e| e.to_string());
+        let r2 = Tera::one_off(tpl, &ctx, autoescape).map_err(|e| e.to_string());
+        assert_eq!(r1, r2, "render not deterministic for {x:?}");
+    }
+
+    // -------------------------------------------------------------------
+    // Property 9: string filters match their Rust equivalents.
+    // upper/lower/length vs std; length uses char count (no `unicode` feat).
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn string_filters_match_rust(tc: hegel::TestCase) {
+        // Avoid the five HTML-special chars here and render without autoescape,
+        // so the filter output is compared verbatim to the Rust oracle.
+        let x = boundary_string(&tc);
+        let mut ctx = Context::new();
+        ctx.insert("x", &x);
+
+        let upper = Tera::one_off("{{ x | upper }}", &ctx, false).expect("upper");
+        assert_eq!(upper, x.to_uppercase(), "upper on {x:?}");
+
+        let lower = Tera::one_off("{{ x | lower }}", &ctx, false).expect("lower");
+        assert_eq!(lower, x.to_lowercase(), "lower on {x:?}");
+
+        let length = Tera::one_off("{{ x | length }}", &ctx, false).expect("length");
+        assert_eq!(length, x.chars().count().to_string(), "length on {x:?}");
+
+        let trimmed = Tera::one_off("{{ x | trim }}", &ctx, false).expect("trim");
+        assert_eq!(trimmed, x.trim(), "trim on {x:?}");
+    }
+
+    // -------------------------------------------------------------------
+    // Property 10: undefined-variable strictness. Rendering a variable that
+    // is not in the context must error, never silently emit anything.
+    // -------------------------------------------------------------------
+    #[hegel::test]
+    fn undefined_variable_errors(tc: hegel::TestCase) {
+        // A fresh, definitely-absent identifier.
+        let suffix = tc.draw(generators::integers::<u32>());
+        let name = format!("missing_var_{suffix}");
+        let src = format!("{{{{ {name} }}}}");
+        let res = Tera::one_off(&src, &Context::new(), false);
+        assert!(res.is_err(), "undefined variable {name} must error");
+    }
+
+    // -------------------------------------------------------------------
+    // KNOWN FAILURE (ignored): compiling long unguarded operator/filter
+    // chains overflows the stack and ABORTS the process. The parser's
+    // MAX_RECURSION_DEPTH (=40) guards parens/arrays/unary/blocks but NOT
+    // left-associative binary chains, `and`/`or` chains, or filter chains,
+    // so `{{ 1 + 1 + 1 + ... }}` (~8500+ terms) aborts inside
+    // add_raw_template. An abort cannot be caught, so this reproducer is
+    // #[ignore]d to keep it out of the normal suite. See HEGEL_REPORT.md.
+    // -------------------------------------------------------------------
+    #[test]
+    #[ignore = "process-aborting stack overflow on deep unguarded operator chains; see HEGEL_REPORT.md"]
+    fn deep_operator_chain_overflows_stack() {
+        let src = format!("{{{{ 1{} }}}}", " + 1".repeat(9000));
+        let mut tera = Tera::default();
+        // This ABORTS with 'stack overflow' rather than returning Err.
+        let res = tera.add_raw_template("probe.html", &src);
+        // If tera is ever fixed to guard these chains, this becomes a clean Err
+        // and the assertion documents the expected fixed behavior.
+        assert!(res.is_err(), "expected graceful error, not a stack overflow");
+    }
+}
