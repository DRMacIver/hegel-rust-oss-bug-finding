+            (258, TYPE_SHORT, 1, short4(big_endian, bits_per_sample)), // BitsPerSample
+            (259, TYPE_SHORT, 1, short4(big_endian, compression)), // Compression
+            (262, TYPE_SHORT, 1, short4(big_endian, photometric)), // PhotometricInterpretation
+            (273, TYPE_LONG, strip_offsets_count, long4(big_endian, strip_offset)), // StripOffsets
+            (277, TYPE_SHORT, 1, short4(big_endian, samples_per_pixel)), // SamplesPerPixel
