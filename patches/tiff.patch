+// ---------------------------------------------------------------------------
+// Property-based decoder tests (hegel)
+// ---------------------------------------------------------------------------
+
+mod hegel_decode {
+    use std::io::Cursor;
+
+    use hegel::generators;
+    use tiff::decoder::{Decoder, DecodingSampleBuffer};
+    use tiff::tags::ByteOrder;
+    use tiff::ColorType;
+
+    /// Hand-serialize a minimal single-strip Gray16 TIFF per the TIFF 6.0
+    /// spec, in the requested byte order. This is a spec-transcribed oracle:
+    /// it shares no code with the crate's encoder, so it independently checks
+    /// the decoder's header, IFD and sample byte-order handling.
+    fn gray16_tiff(big_endian: bool, width: u32, height: u32, pixels: &[u16]) -> Vec<u8> {
+        fn e16(be: bool, v: u16) -> [u8; 2] {
+            if be { v.to_be_bytes() } else { v.to_le_bytes() }
+        }
+        fn e32(be: bool, v: u32) -> [u8; 4] {
+            if be { v.to_be_bytes() } else { v.to_le_bytes() }
+        }
+        // Inline SHORT values sit in the first two bytes of the value field.
+        fn short4(be: bool, v: u16) -> [u8; 4] {
+            let mut out = [0u8; 4];
+            out[..2].copy_from_slice(&e16(be, v));
+            out
+        }
+
+        const TYPE_SHORT: u16 = 3;
+        const TYPE_LONG: u16 = 4;
+        // header (8) + entry count (2) + 9 entries (108) + next-IFD (4)
+        const DATA_OFFSET: u32 = 122;
+
+        let entries: [(u16, u16, u32, [u8; 4]); 9] = [
+            (256, TYPE_LONG, 1, e32(big_endian, width)),   // ImageWidth
+            (257, TYPE_LONG, 1, e32(big_endian, height)),  // ImageLength
+            (258, TYPE_SHORT, 1, short4(big_endian, 16)),  // BitsPerSample
+            (259, TYPE_SHORT, 1, short4(big_endian, 1)),   // Compression: none
+            (262, TYPE_SHORT, 1, short4(big_endian, 1)),   // Photometric: BlackIsZero
+            (273, TYPE_LONG, 1, e32(big_endian, DATA_OFFSET)), // StripOffsets
+            (277, TYPE_SHORT, 1, short4(big_endian, 1)),   // SamplesPerPixel
+            (278, TYPE_LONG, 1, e32(big_endian, height)),  // RowsPerStrip
+            (279, TYPE_LONG, 1, e32(big_endian, width * height * 2)), // StripByteCounts
+        ];
+
+        let mut out = Vec::new();
+        out.extend_from_slice(if big_endian { b"MM" } else { b"II" });
+        out.extend_from_slice(&e16(big_endian, 42));
+        out.extend_from_slice(&e32(big_endian, 8));
+        out.extend_from_slice(&e16(big_endian, entries.len() as u16));
+        for (tag, ty, count, value) in entries {
+            out.extend_from_slice(&e16(big_endian, tag));
+            out.extend_from_slice(&e16(big_endian, ty));
+            out.extend_from_slice(&e32(big_endian, count));
+            out.extend_from_slice(&value);
+        }
+        out.extend_from_slice(&e32(big_endian, 0)); // no next IFD
+        assert_eq!(out.len() as u32, DATA_OFFSET);
+        for &px in pixels {
+            out.extend_from_slice(&e16(big_endian, px));
+        }
+        out
+    }
+
+    fn decode_gray16(data: &[u8], expected_order: ByteOrder, w: u32, h: u32) -> Vec<u16> {
+        let mut decoder = Decoder::open(Cursor::new(data)).unwrap();
+        assert_eq!(decoder.byte_order(), expected_order);
+        decoder.next_image().unwrap();
+        assert_eq!(decoder.dimensions().unwrap(), (w, h));
+        assert_eq!(decoder.colortype().unwrap(), ColorType::Gray(16));
+        match decoder.read_image().unwrap() {
+            DecodingSampleBuffer::U16(samples) => samples,
+            _ => panic!("expected U16 buffer for a 16-bit grayscale image"),
+        }
+    }
+
+    /// Property: the same logical image serialized in little-endian (`II`)
+    /// and big-endian (`MM`) byte order — by a spec-transcribed writer
+    /// independent of the crate's encoder — decodes to identical samples,
+    /// which are exactly the source pixels.
+    #[hegel::test]
+    fn byte_order_ii_vs_mm_decode_identically(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let n = (width * height) as usize;
+        let pixels: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>())
+                .min_size(n)
+                .max_size(n),
+        );
+
+        let le = gray16_tiff(false, width, height, &pixels);
+        let be = gray16_tiff(true, width, height, &pixels);
+
+        let le_samples = decode_gray16(&le, ByteOrder::LittleEndian, width, height);
+        let be_samples = decode_gray16(&be, ByteOrder::BigEndian, width, height);
+
+        assert_eq!(le_samples, pixels, "little-endian decode differs from source");
+        assert_eq!(be_samples, pixels, "big-endian decode differs from source");
+    }
+}
diff --git a/tests/encode_images.rs b/tests/encode_images.rs
index 3790cb5..640430b 100644
--- a/tests/encode_images.rs
+++ b/tests/encode_images.rs
@@ -872,3 +872,322 @@ fn test_auxiliary_directory() {
         assert_eq!(artist, ARTIST);
