+// ---------------------------------------------------------------------------
+// Property-based encode -> decode tests (hegel)
+// ---------------------------------------------------------------------------
+
+mod hegel_roundtrip {
+    use std::io::{Cursor, Seek, SeekFrom};
+
+    use hegel::generators::{self, Generator};
+    use tiff::decoder::{Decoder, DecodingSampleBuffer};
+    use tiff::encoder::{colortype, Compression, Predictor, TiffEncoder, TiffValue};
+
+    /// Encode a single image with the given configuration and decode it back,
+    /// returning the decoded sample buffer. Asserts the decoder reports the
+    /// encoded dimensions.
+    fn encode_then_decode<C>(
+        width: u32,
+        height: u32,
+        data: &[C::Inner],
+        compression: Compression,
+        predictor: Predictor,
+        big_tiff: bool,
+        rows_per_strip: Option<u32>,
+    ) -> DecodingSampleBuffer
+    where
+        C: colortype::ColorType,
+        [C::Inner]: TiffValue,
+    {
+        let mut file = Cursor::new(Vec::new());
+        if big_tiff {
+            let mut encoder = TiffEncoder::new_big(&mut file)
+                .unwrap()
+                .with_compression(compression)
+                .with_predictor(predictor);
+            let mut image = encoder.new_image::<C>(width, height).unwrap();
+            if let Some(rows) = rows_per_strip {
+                image.rows_per_strip(rows).unwrap();
+            }
+            image.write_data(data).unwrap();
+        } else {
+            let mut encoder = TiffEncoder::new(&mut file)
+                .unwrap()
+                .with_compression(compression)
+                .with_predictor(predictor);
+            let mut image = encoder.new_image::<C>(width, height).unwrap();
+            if let Some(rows) = rows_per_strip {
+                image.rows_per_strip(rows).unwrap();
+            }
+            image.write_data(data).unwrap();
+        }
+        file.seek(SeekFrom::Start(0)).unwrap();
+
+        let mut decoder = Decoder::open(&mut file).unwrap();
+        decoder.next_image().unwrap();
+        assert_eq!(decoder.dimensions().unwrap(), (width, height));
+        decoder.read_image().unwrap()
+    }
+
+    /// Draw an exact-size pixel vector, run the roundtrip, and check the
+    /// decoded buffer variant and contents against the drawn pixels.
+    macro_rules! check_roundtrip {
+        ($tc:expr, $C:ty, $variant:ident, $elem_gen:expr, $eq:expr,
+         $w:expr, $h:expr, $comp:expr, $pred:expr, $big:expr, $rps:expr) => {{
+            let n = ($w as usize)
+                * ($h as usize)
+                * <$C as colortype::ColorType>::BITS_PER_SAMPLE.len();
+            let data = $tc.draw(generators::vecs($elem_gen).min_size(n).max_size(n));
+            let buf = encode_then_decode::<$C>($w, $h, &data, $comp, $pred, $big, $rps);
+            match buf {
+                DecodingSampleBuffer::$variant(decoded) => {
+                    assert_eq!(decoded.len(), data.len(), "decoded sample count differs");
+                    for (i, (a, b)) in decoded.iter().zip(data.iter()).enumerate() {
+                        assert!(
+                            $eq(a, b),
+                            "sample {i} differs after roundtrip: {a:?} != {b:?}"
+                        );
+                    }
+                }
+                _ => panic!(
+                    "decoded buffer has the wrong sample type for {}",
+                    stringify!($C)
+                ),
+            }
+        }};
+    }
+
+    /// Property: encoding any image (drawn dimensions, color type, bit depth,
+    /// compression, predictor, TIFF vs BigTIFF, strip size) and decoding it
+    /// back recovers exactly the pixels that were written.
+    ///
+    /// Floats are compared bit-for-bit (NaN payloads included) since nothing
+    /// in the pipeline may alter sample bytes.
+    #[hegel::test]
+    fn roundtrip_arbitrary_image_and_config(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let big_tiff = tc.draw(generators::booleans());
+        let compression = match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => Compression::Uncompressed,
+            1 => Compression::Lzw,
+            2 => Compression::Deflate(
+                tc.draw(generators::integers::<u8>().min_value(1).max_value(9)),
+            ),
+            _ => Compression::Packbits,
+        };
+        // Horizontal is invalid for float samples, FloatingPoint for integer
+        // samples (the encoder rejects the combination), so the predictor is
+        // drawn per sample family.
+        let use_predictor = tc.draw(generators::booleans());
+        let int_pred = if use_predictor {
+            Predictor::Horizontal
+        } else {
+            Predictor::None
+        };
+        let float_pred = if use_predictor {
+            Predictor::FloatingPoint
+        } else {
+            Predictor::None
+        };
+        // Drawn strip size, including strips larger than the image.
+        let rps = if tc.draw(generators::booleans()) {
+            Some(tc.draw(generators::integers::<u32>().min_value(1).max_value(height + 4)))
+        } else {
+            None
+        };
+
+        fn int_eq<T: PartialEq>(a: &T, b: &T) -> bool {
+            a == b
+        }
+
+        match tc.draw(generators::integers::<u8>().max_value(14)) {
+            0 => check_roundtrip!(tc, colortype::Gray8, U8, generators::integers::<u8>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            1 => check_roundtrip!(tc, colortype::GrayI8, I8, generators::integers::<i8>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            2 => check_roundtrip!(tc, colortype::Gray16, U16, generators::integers::<u16>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            3 => check_roundtrip!(tc, colortype::GrayI16, I16, generators::integers::<i16>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            4 => check_roundtrip!(tc, colortype::Gray32, U32, generators::integers::<u32>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            5 => check_roundtrip!(tc, colortype::GrayI32, I32, generators::integers::<i32>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            6 => check_roundtrip!(tc, colortype::Gray64, U64, generators::integers::<u64>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            7 => check_roundtrip!(tc, colortype::GrayI64, I64, generators::integers::<i64>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            8 => check_roundtrip!(tc, colortype::RGB8, U8, generators::integers::<u8>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            9 => check_roundtrip!(tc, colortype::RGB16, U16, generators::integers::<u16>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            10 => check_roundtrip!(tc, colortype::RGBA8, U8, generators::integers::<u8>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            11 => check_roundtrip!(tc, colortype::CMYK8, U8, generators::integers::<u8>(),
+                int_eq, width, height, compression, int_pred, big_tiff, rps),
+            12 => check_roundtrip!(tc, colortype::Gray32Float, F32, generators::floats::<f32>(),
+                |a: &f32, b: &f32| a.to_bits() == b.to_bits(),
+                width, height, compression, float_pred, big_tiff, rps),
+            13 => check_roundtrip!(tc, colortype::Gray64Float, F64, generators::floats::<f64>(),
+                |a: &f64, b: &f64| a.to_bits() == b.to_bits(),
+                width, height, compression, float_pred, big_tiff, rps),
+            _ => check_roundtrip!(tc, colortype::RGB32Float, F32, generators::floats::<f32>(),
+                |a: &f32, b: &f32| a.to_bits() == b.to_bits(),
+                width, height, compression, float_pred, big_tiff, rps),
+        }
+    }
+
+    /// Property: a multi-page file roundtrips — every page is recovered in
+    /// order by `next_image`, `more_images` reports exactly the encoded
+    /// number of pages, and `seek_to_image` random access agrees with the
+    /// sequential walk.
+    #[hegel::test]
+    fn multipage_roundtrip(tc: hegel::TestCase) {
+        let page_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let mut pages: Vec<(u32, u32, Vec<u8>)> = Vec::new();
+        for _ in 0..page_count {
+            let w = tc.draw(generators::integers::<u32>().min_value(1).max_value(10));
+            let h = tc.draw(generators::integers::<u32>().min_value(1).max_value(10));
+            let n = (w * h) as usize;
+            let data: Vec<u8> = tc.draw(
+                generators::vecs(generators::integers::<u8>())
+                    .min_size(n)
+                    .max_size(n),
+            );
+            pages.push((w, h, data));
+        }
+
+        let mut file = Cursor::new(Vec::new());
+        {
+            let mut encoder = TiffEncoder::new(&mut file).unwrap();
+            for (w, h, data) in &pages {
+                encoder.write_image::<colortype::Gray8>(*w, *h, data).unwrap();
+            }
+        }
+        file.seek(SeekFrom::Start(0)).unwrap();
+
+        let check_page = |buf: DecodingSampleBuffer, page: &(u32, u32, Vec<u8>)| {
+            match buf {
+                DecodingSampleBuffer::U8(decoded) => assert_eq!(&decoded, &page.2),
+                _ => panic!("expected U8 buffer for Gray8 page"),
+            }
+        };
+
+        let mut decoder = Decoder::open(&mut file).unwrap();
+        let mut decoded_pages = 0usize;
+        while decoder.more_images() {
+            decoder.next_image().unwrap();
+            let (w, h, _) = pages[decoded_pages];
+            assert_eq!(decoder.dimensions().unwrap(), (w, h));
+            check_page(decoder.read_image().unwrap(), &pages[decoded_pages]);
+            decoded_pages += 1;
+            assert!(decoded_pages <= pages.len(), "decoder reports extra pages");
+        }
+        assert_eq!(decoded_pages, pages.len());
+
+        // Random access must agree with the sequential walk.
+        let index = tc.draw(
+            generators::integers::<usize>()
+                .min_value(0)
+                .max_value(page_count - 1),
+        );
+        decoder.seek_to_image(index).unwrap();
+        assert_eq!(
+            decoder.dimensions().unwrap(),
+            (pages[index].0, pages[index].1)
+        );
+        check_page(decoder.read_image().unwrap(), &pages[index]);
+    }
+
+    /// Property: reading an image strip by strip (`read_chunk`) and
+    /// concatenating the strips yields exactly the same samples as
+    /// `read_image`, and both equal the encoded pixels; per-strip data
+    /// dimensions tile the image height exactly.
+    #[hegel::test]
+    fn strip_chunks_reassemble_to_image(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let rows_per_strip =
+            tc.draw(generators::integers::<u32>().min_value(1).max_value(height + 4));
+        // Packbits is excluded: the encoder documents that packbits strips
+        // must pack each row separately (its default rows_per_strip is 1),
+        // so an overridden strip size is outside the supported configuration.
+        let compression = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => Compression::Uncompressed,
+            1 => Compression::Lzw,
+            _ => Compression::Deflate(6),
+        };
+
+        let n = (width * height * 3) as usize;
+        let data: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(n)
+                .max_size(n),
+        );
+
+        let mut file = Cursor::new(Vec::new());
+        {
+            let mut encoder = TiffEncoder::new(&mut file)
+                .unwrap()
+                .with_compression(compression);
+            let mut image = encoder.new_image::<colortype::RGB8>(width, height).unwrap();
+            image.rows_per_strip(rows_per_strip).unwrap();
+            image.write_data(&data).unwrap();
+        }
+        file.seek(SeekFrom::Start(0)).unwrap();
+
+        let mut decoder = Decoder::open(&mut file).unwrap();
+        decoder.next_image().unwrap();
+
+        let strip_count = decoder.strip_count().unwrap();
+        assert_eq!(
+            u64::from(strip_count),
+            u64::from(height).div_ceil(u64::from(rows_per_strip)),
+            "strip count disagrees with ceil(height / rows_per_strip)"
+        );
+
+        let mut reassembled: Vec<u8> = Vec::new();
+        let mut total_rows = 0u64;
+        for chunk in 0..strip_count {
+            let (cw, ch) = decoder.chunk_data_dimensions(chunk);
+            assert_eq!(cw, width, "strip width must equal image width");
+            total_rows += u64::from(ch);
+            match decoder.read_chunk(chunk).unwrap() {
+                DecodingSampleBuffer::U8(samples) => {
+                    assert_eq!(samples.len(), (cw * ch * 3) as usize);
+                    reassembled.extend_from_slice(&samples);
+                }
+                _ => panic!("expected U8 strip buffer for RGB8"),
+            }
+        }
+        assert_eq!(total_rows, u64::from(height), "strip heights must tile the image");
+        assert_eq!(reassembled, data, "concatenated strips differ from encoded pixels");
+
+        match decoder.read_image().unwrap() {
+            DecodingSampleBuffer::U8(whole) => assert_eq!(whole, data),
+            _ => panic!("expected U8 buffer for RGB8"),
+        }
+    }
+
+    /// KNOWN FAILURE: `ImageEncoder::rows_per_strip` returns `TiffResult`,
+    /// but calling it with `0` panics with an unchecked divide-by-zero
+    /// (`height.div_ceil(value)` at src/encoder/mod.rs:895) instead of
+    /// returning `Err`. The `just(0)` branch makes the failure deterministic.
+    #[hegel::test]
+    fn rows_per_strip_returns_err_instead_of_panicking(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(8));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(8));
+        let rows = tc.draw(hegel::one_of!(
+            generators::just(0u32),
+            generators::integers::<u32>(),
+        ));
+
+        let mut file = Cursor::new(Vec::new());
+        let mut encoder = TiffEncoder::new(&mut file).unwrap();
+        let mut image = encoder.new_image::<colortype::Gray8>(width, height).unwrap();
+        // Any value may be rejected, but rejection must be an `Err`.
+        let _ = image.rows_per_strip(rows);
+    }
+}
