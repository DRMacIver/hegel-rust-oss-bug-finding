+
+    /// Property 3: take a *valid* encoder-produced TIFF and corrupt it —
+    /// truncation at any point, or arbitrary byte edits anywhere (header,
+    /// IFD entries, strip offsets, pixel data). Decoding the result must not
+    /// panic; if it still succeeds, the dimension-sanity invariant must hold.
+    #[hegel::test]
+    fn corrupted_valid_tiff_never_panics(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+        let n = (width * height) as usize;
+        let pixels: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(n)
+                .max_size(n),
+        );
+
+        let mut file = Cursor::new(Vec::new());
+        {
+            let mut encoder = TiffEncoder::new(&mut file).unwrap();
+            encoder
+                .write_image::<colortype::Gray8>(width, height, &pixels)
+                .unwrap();
+        }
+        file.seek(SeekFrom::Start(0)).unwrap();
+        let mut data = file.into_inner();
+
+        // Either truncate the file, or flip a handful of bytes, or both.
+        if tc.draw(generators::booleans()) {
+            let cut = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(0)
+                    .max_value(data.len()),
+            );
+            data.truncate(cut);
+        }
+        if !data.is_empty() {
+            let edits = tc.draw(generators::integers::<usize>().min_value(0).max_value(8));
+            for _ in 0..edits {
+                let pos = tc.draw(
+                    generators::integers::<usize>()
+                        .min_value(0)
+                        .max_value(data.len() - 1),
+                );
+                let byte = tc.draw(generators::integers::<u8>());
+                data[pos] = byte;
+            }
