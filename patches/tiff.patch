+// ---------------------------------------------------------------------------
+// Property-based robustness tests (hegel)
+//
+// The decoder consumes fully untrusted input: IFD tag tables carry
+// attacker-controlled dimensions, strip offsets/counts, tag counts and value
+// offsets. The properties below assert that no input — arbitrary garbage,
+// valid-magic garbage, hand-crafted adversarial IFDs, or corrupted/truncated
+// valid files — can make the decoder panic, hang, or allocate past its
+// configured `Limits`.
+// ---------------------------------------------------------------------------
+
+mod hegel_robustness {
+    use std::io::{Cursor, Seek, SeekFrom};
+
+    use hegel::generators;
+    use tiff::decoder::{Decoder, DecodingSampleBuffer, Limits, TiffHeader};
+    use tiff::encoder::{colortype, TiffEncoder};
+
+    /// Small limits, mirroring `fuzz/fuzz_targets/decode_comprehensive.rs`.
+    ///
+    /// With these in place any multi-megabyte allocation driven by a crafted
+    /// width/height/strip-byte-count is a real bug (an allocation made before
+    /// the limit is consulted), and shows up as an OOM abort of this test.
+    fn capped_limits() -> Limits {
+        let mut limits = Limits::default();
+        limits.decoding_buffer_size = 512 * 1024;
+        limits.ifd_value_size = 64 * 1024;
+        limits.intermediate_buffer_size = 512 * 1024;
+        limits
+    }
+
+    fn sample_count(buf: &DecodingSampleBuffer) -> usize {
+        match buf {
+            DecodingSampleBuffer::U8(v) => v.len(),
+            DecodingSampleBuffer::U16(v) => v.len(),
+            DecodingSampleBuffer::U32(v) => v.len(),
+            DecodingSampleBuffer::U64(v) => v.len(),
+            DecodingSampleBuffer::F16(v) => v.len(),
+            DecodingSampleBuffer::F32(v) => v.len(),
+            DecodingSampleBuffer::F64(v) => v.len(),
+            DecodingSampleBuffer::I8(v) => v.len(),
+            DecodingSampleBuffer::I16(v) => v.len(),
+            DecodingSampleBuffer::I32(v) => v.len(),
+            DecodingSampleBuffer::I64(v) => v.len(),
+        }
+    }
+
+    /// Expected element count of a decoded buffer, computed from
+    /// decoder-reported metadata (dimensions, colortype, planar config)
+    /// independently of the buffer itself.
+    ///
+    /// Layout contract (see `readout_for_size` in src/decoder/image.rs):
+    /// - bit depths > 8 are promoted to the next standard element width, so
+    ///   the buffer holds one element per sample: `w * h * samples`;
+    /// - sub-byte depths (< 8) stay packed in a `U8` buffer, each row padded
+    ///   to a byte boundary: `planes * h * ceil(w * texel_samples * bits / 8)`
+    ///   bytes, where planar images store one sample per texel per plane.
+    fn expected_element_count(
+        width: u32,
+        height: u32,
+        colortype: tiff::ColorType,
+        planar: bool,
+    ) -> u64 {
+        let bits = u64::from(colortype.bit_depth());
+        let samples = u64::from(colortype.num_samples());
+        if bits >= 8 {
+            u64::from(width) * u64::from(height) * samples
+        } else {
+            let (planes, texel_samples) = if planar { (samples, 1) } else { (1, samples) };
+            let row_bytes = (u64::from(width) * texel_samples * bits).div_ceil(8);
+            planes * u64::from(height) * row_bytes
+        }
+    }
+
+    /// Drive the decoder over `data` the way a consumer would: walk a few
+    /// directories, query metadata, read a chunk and the whole image. Every
+    /// call may return `Err` — none may panic.
+    ///
+    /// Whenever `read_image` succeeds, additionally check the
+    /// oracle-independent dimension-sanity invariant: the returned buffer
+    /// size matches the decoder's own reported dimensions and colortype.
+    fn probe_all_inputs_no_panic(data: &[u8]) {
+        // Standalone header parse (separate code path from Decoder::open).
+        let _ = TiffHeader::parse(Cursor::new(data));
+
+        let Ok(decoder) = Decoder::open(Cursor::new(data)) else {
+            return;
+        };
+        let mut decoder = decoder.with_limits(capped_limits());
+
+        let mut ifd_count = 0u32;
+        while decoder.more_images() && ifd_count < 4 {
+            if decoder.next_directory().is_err() {
+                break;
+            }
+            ifd_count += 1;
+
+            // Tag iteration exercises value parsing for every entry.
+            for entry in decoder.current_ifd().tag_iter() {
+                let _ = entry;
+            }
+
+            // dimensions() triggers lazy parsing of the IFD as an image.
+            if decoder.dimensions().is_err() {
+                continue;
+            }
+            let _ = decoder.colortype();
+            let _ = decoder.color_map();
+            let _ = decoder.chunk_dimensions();
+            let _ = decoder.strip_count();
+            let _ = decoder.tile_count();
+            let _ = decoder.image_buffer_layout();
+            let _ = decoder.read_chunk(0);
+
+            if let Ok(buf) = decoder.read_image() {
+                let (width, height) = decoder.dimensions().expect("dimensions succeeded before");
+                let planar = matches!(
+                    decoder.find_tag(tiff::tags::Tag::PlanarConfiguration),
+                    Ok(Some(ref v)) if v.clone().into_u16().ok() == Some(2)
+                );
+                if let Ok(colortype) = decoder.colortype() {
+                    let expected = expected_element_count(width, height, colortype, planar);
+                    assert_eq!(
+                        sample_count(&buf) as u64,
+                        expected,
+                        "decoded buffer size disagrees with reported dimensions \
+                         {width}x{height} and colortype {colortype:?} (planar: {planar})"
+                    );
+                }
+            }
+        }
+    }
+
+    /// Property 1: arbitrary bytes — with or without a valid TIFF/BigTIFF
+    /// magic prefix — never panic, hang, or blow past the decoding limits.
+    #[hegel::test]
+    fn decode_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let prefix: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::just(Vec::new()),
+            // Classic TIFF magic, no IFD offset (offset comes from the body).
+            generators::just(b"II*\0".to_vec()),
+            generators::just(b"MM\0*".to_vec()),
+            // Classic TIFF magic + pointer to an IFD right after the header.
+            generators::just(b"II*\0\x08\0\0\0".to_vec()),
+            generators::just(b"MM\0*\0\0\0\x08".to_vec()),
+            // BigTIFF magic (43), offset size 8, reserved 0.
+            generators::just(b"II+\0\x08\0\0\0".to_vec()),
+            generators::just(b"MM\0+\0\x08\0\0".to_vec()),
+        ));
+        let body: Vec<u8> = tc.draw(generators::binary().max_size(512));
+
+        let mut data = prefix;
+        data.extend_from_slice(&body);
+        probe_all_inputs_no_panic(&data);
+    }
+
+    // -- Hand-crafted adversarial IFDs ------------------------------------
+
+    fn end16(big_endian: bool, v: u16) -> [u8; 2] {
+        if big_endian {
+            v.to_be_bytes()
+        } else {
+            v.to_le_bytes()
+        }
+    }
+
+    fn end32(big_endian: bool, v: u32) -> [u8; 4] {
+        if big_endian {
+            v.to_be_bytes()
+        } else {
+            v.to_le_bytes()
+        }
+    }
+
+    /// Inline SHORT value: occupies the first two bytes of the 4-byte field.
+    fn short4(big_endian: bool, v: u16) -> [u8; 4] {
+        let mut out = [0u8; 4];
+        out[..2].copy_from_slice(&end16(big_endian, v));
+        out
+    }
+
+    fn long4(big_endian: bool, v: u32) -> [u8; 4] {
+        end32(big_endian, v)
+    }
+
+    /// Serialize a classic TIFF: header, one IFD at offset 8 with the given
+    /// entries (tag, type, count, 4-byte value/offset field), then trailing
+    /// bytes (nominally pixel data).
+    fn build_classic_tiff(
+        big_endian: bool,
+        entries: &[(u16, u16, u32, [u8; 4])],
+        trailing: &[u8],
+    ) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.extend_from_slice(if big_endian { b"MM" } else { b"II" });
+        out.extend_from_slice(&end16(big_endian, 42));
+        out.extend_from_slice(&end32(big_endian, 8));
+        out.extend_from_slice(&end16(big_endian, entries.len() as u16));
+        for &(tag, ty, count, value) in entries {
+            out.extend_from_slice(&end16(big_endian, tag));
+            out.extend_from_slice(&end16(big_endian, ty));
+            out.extend_from_slice(&end32(big_endian, count));
+            out.extend_from_slice(&value);
+        }
+        // Next-IFD pointer: none.
+        out.extend_from_slice(&end32(big_endian, 0));
+        out.extend_from_slice(trailing);
+        out
+    }
+
+    const TYPE_SHORT: u16 = 3;
+    const TYPE_LONG: u16 = 4;
+
+    /// Data offset directly after a classic header + 9-entry IFD:
+    /// 8 (header) + 2 (entry count) + 9 * 12 (entries) + 4 (next-IFD pointer).
+    const DATA_OFFSET: u32 = 122;
+
+    /// Property 2: a syntactically well-formed IFD whose *fields* are
+    /// adversarial (huge dimensions, huge strip byte counts, out-of-range
+    /// offsets, absurd sample counts, giant entry counts) must be handled
