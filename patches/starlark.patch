+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+//
+// Starlark integers are arbitrary-precision (backed by `num_bigint::BigInt`
+// via `values::types::bigint`), so we can use `num_bigint` directly as an
+// independent oracle for integer semantics.
+// ---------------------------------------------------------------------------
+
+mod prop {
+    use std::str::FromStr;
+
+    use hegel::generators::{self, Generator};
+    use num_bigint::BigInt;
+    use num_traits::Signed;
+    use num_traits::Zero;
+
+    use crate::assert;
+    use crate::values::types::string::StarlarkStr;
+
+    /// Interesting boundary values: around the inline `i32` representation,
+    /// around `i64`/`u64`, and small values.
+    fn boundary_big_ints() -> Vec<BigInt> {
+        let mut result = Vec::new();
+        for base in [
+            BigInt::from(0),
+            BigInt::from(i32::MIN),
+            BigInt::from(i32::MAX),
+            BigInt::from(i64::MIN),
+            BigInt::from(i64::MAX),
+            BigInt::from(u64::MAX),
+        ] {
+            for delta in [-1, 0, 1] {
+                result.push(&base + BigInt::from(delta));
+            }
+        }
+        result
+    }
+
+    /// A Starlark integer: machine-word sized (hits the inline-int boundary
+    /// cases), explicitly boundary-shaped, or too wide for any machine type.
+    #[hegel::composite]
+    fn starlark_ints(tc: hegel::TestCase) -> BigInt {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i128>().map(BigInt::from),
+            generators::sampled_from(boundary_big_ints()),
+            generators::from_regex(r"-?[1-9][0-9]{0,59}")
+                .map(|s: String| BigInt::from_str(&s).unwrap()),
+        ))
+    }
+
+    /// Python/Starlark floored division and modulo, computed independently
+    /// from num_bigint's truncated division.
+    fn floor_div_mod(a: &BigInt, b: &BigInt) -> (BigInt, BigInt) {
+        let q = a / b;
+        let r = a - &q * b;
+        if !r.is_zero() && (r.is_negative() != b.is_negative()) {
+            (q - 1, r + b)
+        } else {
+            (q, r)
+        }
+    }
+
+    /// Every Starlark integer binary operator agrees with an independent
+    /// `num_bigint` reference implementation, across inline-int boundaries
+    /// and values wider than any machine integer.
+    ///
+    /// Evidence: docs/types.md says Starlark ints are arbitrary precision;
+    /// `//` and `%` follow Python floor semantics (see `test_arithmetic` /
+    /// `test_bitwise` above for hand-picked instances of the same claims).
+    #[hegel::test]
+    fn test_prop_int_binop_matches_bigint_reference(tc: hegel::TestCase) {
+        let a = tc.draw(starlark_ints());
+        let op = tc.draw(generators::sampled_from(vec![
+            "+", "-", "*", "//", "%", "&", "|", "^",
+        ]));
+        let b = tc.draw(starlark_ints());
+        if matches!(op, "//" | "%") {
+            tc.assume(!b.is_zero());
+        }
+        let expected = match op {
+            "+" => &a + &b,
+            "-" => &a - &b,
+            "*" => &a * &b,
+            "//" => floor_div_mod(&a, &b).0,
+            "%" => floor_div_mod(&a, &b).1,
+            "&" => &a & &b,
+            "|" => &a | &b,
+            "^" => &a ^ &b,
+            _ => unreachable!(),
+        };
+        assert::is_true(&format!("({a}) {op} ({b}) == ({expected})"));
+    }
+
+    /// Left/right shifts agree with `num_bigint` (which, like Starlark,
+    /// shifts negative numbers with floor semantics).
+    #[hegel::test]
+    fn test_prop_int_shift_matches_bigint_reference(tc: hegel::TestCase) {
+        let a = tc.draw(starlark_ints());
+        // Bound protects the test's memory (a << huge allocates), not the
+        // library's contract.
+        let s = tc.draw(generators::integers::<usize>().max_value(512));
+        let left = tc.draw(generators::booleans());
+        let (op, expected) = if left {
+            ("<<", &a << s)
+        } else {
+            (">>", &a >> s)
+        };
+        assert::is_true(&format!("({a}) {op} {s} == ({expected})"));
+    }
+
+    /// Integer comparison operators agree with `num_bigint`'s `Ord`.
+    #[hegel::test]
+    fn test_prop_int_comparison_matches_bigint_reference(tc: hegel::TestCase) {
+        let a = tc.draw(starlark_ints());
+        // Force equality often enough that == / <= / >= are exercised on it.
+        let b = if tc.draw(generators::booleans()) {
+            a.clone()
+        } else {
+            tc.draw(starlark_ints())
+        };
+        let op = tc.draw(generators::sampled_from(vec![
+            "<", "<=", ">", ">=", "==", "!=",
+        ]));
+        let expected = match op {
+            "<" => a < b,
+            "<=" => a <= b,
+            ">" => a > b,
+            ">=" => a >= b,
+            "==" => a == b,
+            "!=" => a != b,
+            _ => unreachable!(),
+        };
+        let program = format!("({a}) {op} ({b})");
+        if expected {
+            assert::is_true(&program);
+        } else {
+            assert::is_false(&program);
+        }
+    }
+
+    /// A random nested integer arithmetic expression evaluates to the value
+    /// computed by an independent BigInt evaluator over the same tree.
+    ///
+    /// Leaves are randomly wrapped in `noop(...)` (an identity function from
+    /// the test globals) so both the constant-folding path and the runtime
+    /// path of the bytecode compiler are exercised.
+    fn arith_exprs(depth: u32) -> generators::BoxedGenerator<'static, (String, BigInt)> {
+        hegel::compose!(|tc| {
+            let leaf = depth == 0 || tc.draw(generators::integers::<u8>().max_value(2)) == 0;
+            if leaf {
+                let n = tc.draw(starlark_ints());
+                let text = if tc.draw(generators::booleans()) {
+                    format!("noop({n})")
+                } else {
+                    format!("({n})")
+                };
+                (text, n)
+            } else {
+                let (ls, lv) = tc.draw(arith_exprs(depth - 1));
+                let (rs, rv) = tc.draw(arith_exprs(depth - 1));
+                let op = tc.draw(generators::sampled_from(vec!["+", "-", "*"]));
+                let value = match op {
+                    "+" => lv + rv,
+                    "-" => lv - rv,
+                    "*" => lv * rv,
+                    _ => unreachable!(),
+                };
+                (format!("({ls} {op} {rs})"), value)
+            }
+        })
+        .boxed()
+    }
+
+    #[hegel::test]
+    fn test_prop_nested_int_arithmetic_matches_bigint_reference(tc: hegel::TestCase) {
+        let (text, value) = tc.draw(arith_exprs(4));
+        assert::is_true(&format!("{text} == ({value})"));
+    }
+
+    /// `sorted` on a list of ints agrees with Rust's slice sort.
+    ///
+    /// Evidence: stdlib docs for `sorted` promise the sorted elements.
+    #[hegel::test]
+    fn test_prop_sorted_matches_rust_sort(tc: hegel::TestCase) {
+        let xs: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()));
+        let mut expected = xs.clone();
+        expected.sort();
+        let literal = |v: &[i64]| {
+            let elems: Vec<String> = v.iter().map(|x| format!("({x})")).collect();
+            format!("[{}]", elems.join(", "))
+        };
+        assert::is_true(&format!(
+            "sorted({}) == {}",
+            literal(&xs),
+            literal(&expected)
+        ));
+    }
+
+    /// `repr` of a string produces a literal that parses and evaluates back
+    /// to the same string. The writer is `StarlarkStr::repr` (the same code
+    /// as the `repr()` builtin); the reader is the independent lexer path.
+    #[hegel::test]
+    fn test_prop_string_repr_parse_eval_roundtrip(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(50));
+        let literal = StarlarkStr::repr(&s);
+        let v = assert::pass(&literal);
+        assert_eq!(v.unpack_str(), Some(s.as_str()));
+    }
+
+    /// `len` of a string counts chars, consistently with Rust's
+    /// `str::chars().count()` (see `StarlarkStr::length`, which uses
+    /// `fast_string::len`).
+    #[hegel::test]
+    fn test_prop_string_len_matches_char_count(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(50));
+        let literal = StarlarkStr::repr(&s);
+        let n = s.chars().count();
+        assert::is_true(&format!("len({literal}) == {n}"));
+    }
+
+    /// A random hashable Starlark literal, rendered as program text.
+    /// Values are biased toward collisions (small ints, int-valued floats,
+    /// short strings) so `x == y` is regularly true.
+    fn hashable_literals(depth: u32) -> generators::BoxedGenerator<'static, String> {
+        hegel::compose!(|tc| {
+            let max = if depth == 0 { 4 } else { 5 };
+            match tc.draw(generators::integers::<u8>().max_value(max)) {
+                0 => "None".to_owned(),
+                1 => if tc.draw(generators::booleans()) {
+                    "True"
+                } else {
+                    "False"
+                }
+                .to_owned(),
+                2 => tc
+                    .draw(hegel::one_of!(
+                        generators::integers::<i8>().map(|n| n.to_string()),
+                        generators::from_regex(r"-?[1-9][0-9]{0,30}"),
+                    )),
+                3 => {
+                    // int-valued and half-valued floats, including -0.0
+                    let n = tc.draw(generators::integers::<i8>());
+                    if tc.draw(generators::booleans()) {
+                        format!("{n}.5")
+                    } else {
+                        format!("{n}.0")
+                    }
+                }
+                4 => {
+                    let s: String = tc.draw(generators::text().max_size(2));
+                    StarlarkStr::repr(&s)
+                }
+                _ => {
+                    let elems: Vec<String> =
+                        tc.draw(generators::vecs(hashable_literals(depth - 1)).max_size(3));
+                    match elems.len() {
+                        1 => format!("({},)", elems[0]),
+                        _ => format!("({})", elems.join(", ")),
+                    }
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// The eq/hash contract, observed through dicts: inserting `x` and `y`
+    /// as keys leaves one entry iff `x == y`. This catches any type pair
+    /// that compares equal but hashes differently (e.g. `1` vs `1.0` vs
+    /// `340282366920938463463374607431768211456`), and any hash collision
+    /// mishandling in the dict itself.
+    ///
+    /// Evidence: `pointer_i32.rs` and `float.rs` both hash through
+    /// `NumRef::get_hash_64` precisely so that equal numbers hash equal.
+    #[hegel::test]
+    fn test_prop_equal_dict_keys_collide(tc: hegel::TestCase) {
+        let x = tc.draw(hashable_literals(2));
+        let y = tc.draw(hashable_literals(2));
+        assert::is_true(&format!(
+            "\
+x = {x}
+y = {y}
+d = {{}}
+d[x] = 0
+d[y] = 0
+(len(d) == 1) == (x == y)"
+        ));
+    }
+}
