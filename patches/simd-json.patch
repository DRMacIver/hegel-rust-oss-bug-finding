+/// Shared generators/helpers for the hegel property tests in this file and in
+/// `tests/serde.rs`. Everything generates JSON *text* by construction so the
+/// documents are valid by definition and avoid the divergences simd-json
+/// documents relative to serde_json (out-of-range integer literals, duplicate
+/// object keys, bare `-0`).
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) mod hegel_gens {
+    use hegel::generators::{self, BoxedGenerator, Generator};
+
+    /// Draw a run of JSON whitespace of length `0..=max`.
+    pub(crate) fn draw_ws(tc: &hegel::TestCase, max: usize) -> String {
+        let n = tc.draw_silent(generators::integers::<usize>().max_value(max));
+        (0..n)
+            .map(|_| tc.draw_silent(generators::sampled_from(vec![' ', '\t', '\n', '\r'])))
+            .collect()
+    }
+
+    /// Escape sequences and raw characters legal inside a JSON string literal,
+    /// as (literal-piece, decoded-piece) pairs.
+    pub(crate) fn string_pieces() -> Vec<(&'static str, &'static str)> {
+        vec![
+            ("\\\"", "\""),
+            ("\\\\", "\\"),
+            ("\\/", "/"),
+            ("\\b", "\u{8}"),
+            ("\\f", "\u{c}"),
+            ("\\n", "\n"),
+            ("\\r", "\r"),
+            ("\\t", "\t"),
+            ("\\u0000", "\u{0}"),
+            ("\\u0041", "A"),
+            ("\\u00e9", "é"),
+            ("\\u2028", "\u{2028}"),
+            ("\\ufffd", "\u{fffd}"),
+            // surrogate pair (U+1D11E)
+            ("\\ud834\\udd1e", "𝄞"),
+            // raw multi-byte UTF-8 (2, 3 and 4 byte encodings)
+            ("é", "é"),
+            ("\u{2028}", "\u{2028}"),
+            ("𝄞", "𝄞"),
+        ]
+    }
+
+    /// Replace characters that may not appear raw in a JSON string literal.
+    pub(crate) fn sanitize(s: &str) -> String {
+        s.chars()
+            .map(|c| {
+                if (c as u32) < 0x20 || c == '"' || c == '\\' {
+                    'x'
+                } else {
+                    c
+                }
+            })
+            .collect()
+    }
+
+    /// Draw the contents of a JSON string literal. Returns
+    /// (literal-without-quotes, decoded-string).
+    pub(crate) fn draw_string_contents(tc: &hegel::TestCase) -> (String, String) {
+        let n = tc.draw_silent(generators::integers::<usize>().max_value(5));
+        let mut lit = String::new();
+        let mut dec = String::new();
+        for _ in 0..n {
+            if tc.draw_silent(generators::booleans()) {
+                let (l, d) = tc.draw_silent(generators::sampled_from(string_pieces()));
+                lit.push_str(l);
+                dec.push_str(d);
+            } else {
+                let raw = sanitize(&tc.draw_silent(generators::text().max_size(20)));
+                lit.push_str(&raw);
+                dec.push_str(&raw);
+            }
+        }
+        (lit, dec)
+    }
+
+    /// Draw a number token that parses identically in serde_json and
+    /// simd-json's documented domain: integers within `i64::MIN..=u64::MAX`,
+    /// and floats that neither overflow to infinity nor are a bare `-0`.
+    pub(crate) fn draw_safe_number_token(tc: &hegel::TestCase) -> String {
+        match tc.draw_silent(generators::integers::<u8>().max_value(3)) {
+            0 => tc.draw_silent(generators::integers::<i64>()).to_string(),
+            1 => tc.draw_silent(generators::integers::<u64>()).to_string(),
+            2 => format!(
+                "{:?}",
+                tc.draw_silent(
+                    generators::floats::<f64>()
+                        .allow_nan(false)
+                        .allow_infinity(false)
+                )
+            ),
+            _ => draw_sci_number_token(tc, 280),
+        }
+    }
+
+    /// Draw a textual float in scientific/fraction notation. `max_exp` bounds
+    /// the exponent; with `max_exp <= 280` and at most 19 integer digits the
+    /// value cannot overflow to infinity (magnitude < 1e300).
+    pub(crate) fn draw_sci_number_token(tc: &hegel::TestCase, max_exp: i32) -> String {
+        let mut s = String::new();
+        if tc.draw_silent(generators::booleans()) {
+            s.push('-');
+        }
+        // integer part: "0" or a 1..=19 digit run without a leading zero
+        if tc.draw_silent(generators::booleans()) {
+            s.push('0');
+        } else {
+            let n = tc.draw_silent(generators::integers::<usize>().min_value(1).max_value(19));
+            s.push(tc.draw_silent(generators::sampled_from("123456789".chars().collect::<Vec<_>>())));
+            for _ in 1..n {
+                s.push(tc.draw_silent(generators::sampled_from("0123456789".chars().collect::<Vec<_>>())));
+            }
+        }
+        let frac = tc.draw_silent(generators::booleans());
+        if frac {
+            s.push('.');
+            let n = tc.draw_silent(generators::integers::<usize>().min_value(1).max_value(20));
+            for _ in 0..n {
+                s.push(tc.draw_silent(generators::sampled_from("0123456789".chars().collect::<Vec<_>>())));
+            }
+        }
+        let exp = tc.draw_silent(generators::booleans());
+        if exp {
+            s.push(tc.draw_silent(generators::sampled_from(vec!['e', 'E'])));
+            let e = tc.draw_silent(
+                generators::integers::<i32>()
+                    .min_value(-324)
+                    .max_value(max_exp),
+            );
+            if e >= 0 && tc.draw_silent(generators::booleans()) {
+                s.push('+');
+            }
+            s.push_str(&e.to_string());
+        }
+        if !frac && !exp {
+            // avoid producing a bare integer (in particular `-0`, which
+            // serde_json types as -0.0 while simd-json types it as 0i64)
+            s.push_str(".0");
+        }
+        s
+    }
+
+    /// Recursively generate a valid JSON document as text. Objects use unique
+    /// keys, integers stay in range, depth is bounded by `depth`.
+    pub(crate) fn json_text(depth: u32) -> BoxedGenerator<'static, String> {
+        hegel::compose!(|tc| {
+            let max_choice = if depth == 0 { 2 } else { 5 };
+            match tc.draw_silent(generators::integers::<u8>().max_value(max_choice)) {
+                0 => tc.draw_silent(generators::sampled_from(vec![
+                    "null".to_string(),
+                    "true".to_string(),
+                    "false".to_string(),
+                ])),
+                1 => draw_safe_number_token(&tc),
+                2 => {
+                    let (lit, _) = draw_string_contents(&tc);
+                    format!("\"{lit}\"")
+                }
+                3 => {
+                    // array
+                    let n = tc.draw_silent(generators::integers::<usize>().max_value(6));
+                    let items: Vec<String> =
+                        (0..n).map(|_| tc.draw(json_text(depth - 1))).collect();
+                    wrap_array(&tc, &items)
+                }
+                4 => {
+                    // object with unique keys
+                    let keys = draw_unique_keys(&tc, 6);
+                    let kvs: Vec<(String, String)> = keys
+                        .into_iter()
+                        .map(|k| (k, tc.draw(json_text(depth - 1))))
+                        .collect();
+                    wrap_object(&tc, &kvs)
+                }
+                _ => {
+                    // wide, flat container: many keys/items to exercise the
+                    // SIMD scanners over long structural runs
+                    if tc.draw_silent(generators::booleans()) {
+                        let n =
+                            tc.draw_silent(generators::integers::<usize>().max_value(60));
+                        let items: Vec<String> =
+                            (0..n).map(|_| tc.draw(json_text(0))).collect();
+                        wrap_array(&tc, &items)
+                    } else {
+                        let keys = draw_unique_keys(&tc, 50);
+                        let kvs: Vec<(String, String)> = keys
+                            .into_iter()
+                            .map(|k| (k, tc.draw(json_text(0))))
+                            .collect();
+                        wrap_object(&tc, &kvs)
+                    }
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// Draw a set of object keys that are unique *after decoding* (plain
+    /// characters only, so literal uniqueness equals decoded uniqueness).
+    fn draw_unique_keys(tc: &hegel::TestCase, max: usize) -> Vec<String> {
+        let raw: Vec<String> = tc.draw_silent(
+            generators::vecs(generators::text().max_size(10))
+                .max_size(max)
+                .unique(true),
+        );
+        let mut seen = std::collections::BTreeSet::new();
+        raw.into_iter()
+            .map(|k| sanitize(&k))
+            .filter(|k| seen.insert(k.clone()))
+            .collect()
+    }
+
+    fn wrap_array(tc: &hegel::TestCase, items: &[String]) -> String {
+        format!(
+            "[{}{}{}]",
+            draw_ws(tc, 2),
+            items.join(&format!("{},{}", draw_ws(tc, 2), draw_ws(tc, 2))),
+            draw_ws(tc, 2)
+        )
+    }
+
+    fn wrap_object(tc: &hegel::TestCase, kvs: &[(String, String)]) -> String {
+        let body = kvs
+            .iter()
+            .map(|(k, v)| format!("\"{k}\"{}:{}{v}", draw_ws(tc, 2), draw_ws(tc, 2)))
+            .collect::<Vec<_>>()
+            .join(&format!("{},{}", draw_ws(tc, 2), draw_ws(tc, 2)));
+        format!("{{{}{}{}}}", draw_ws(tc, 2), body, draw_ws(tc, 2))
+    }
+
+    /// Arbitrary input bytes: either raw binary junk or a "JSON soup" of
+    /// tokens that frequently forms valid or nearly-valid documents.
+    pub(crate) fn draw_junk_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        if tc.draw_silent(generators::booleans()) {
+            let n = tc.draw_silent(generators::integers::<usize>().max_value(2048));
+            tc.draw_silent(generators::binary().min_size(n))
+        } else {
+            let tokens = vec![
+                "{", "}", "[", "]", ":", ",", "\"", "\\", "-", "+", ".", "e", "E", "0", "1",
+                "9", "123", "9999999999", "null", "true", "false", " ", "\n", "\t", "\r", "a",
+                "ß", "\u{0}", "\u{7f}", "\u{fffd}",
+            ];
+            // Bounded token count: deeply nested valid documents crash the
+            // recursive DOM builders (see owned_value_deep_nesting_stack_overflow),
+            // so keep possible nesting well below that threshold.
+            let n = tc.draw_silent(generators::integers::<usize>().max_value(400));
+            let mut out = Vec::new();
+            for _ in 0..n {
+                out.extend_from_slice(
+                    tc.draw_silent(generators::sampled_from(tokens.clone()))
+                        .as_bytes(),
+                );
+            }
+            out
+        }
+    }
+
+    /// True if `v` (or a nested object) contains duplicate keys. simd-json
+    /// documents duplicate-key objects as having unspecified behavior for its
+    /// DOM values (see the `value-no-dup-keys` feature), so equality
+    /// assertions must skip them.
+    pub(crate) fn has_dup_keys(v: &crate::owned::Value) -> bool {
+        use crate::owned::Value;
+        match v {
+            Value::Object(o) => {
+                let mut seen = std::collections::BTreeSet::new();
+                o.iter().any(|(k, _)| !seen.insert(k.clone()))
+                    || o.iter().any(|(_, v)| has_dup_keys(v))
+            }
+            Value::Array(a) => a.iter().any(has_dup_keys),
+            _ => false,
+        }
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod hegel_props {
+    use super::hegel_gens::{
+        draw_junk_bytes, draw_ws, has_dup_keys, json_text, string_pieces,
+    };
+    use super::*;
+    use hegel::generators::{self, Generator};
+
+    /// Property: all of simd-json's parsing entry points agree on whether an
+    /// arbitrary input is valid JSON, and (duplicate keys aside) produce equal
+    /// values: `to_owned_value`, `to_borrowed_value`, `to_tape`, and the
+    /// serde-Deserialize path.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_prop_parse_paths_agree(tc: hegel::TestCase) {
+        let input: Vec<u8> = if tc.draw(generators::booleans()) {
+            draw_junk_bytes(&tc)
+        } else {
+            tc.draw(json_text(3)).into_bytes()
+        };
+        tc.note(&format!("input: {:?}", String::from_utf8_lossy(&input)));
+
+        let mut b1 = input.clone();
+        let owned = to_owned_value(&mut b1);
+        let mut b2 = input.clone();
+        let borrowed = to_borrowed_value(&mut b2);
+        let mut b3 = input.clone();
+        let tape_ok = crate::to_tape(&mut b3).is_ok();
+
+        assert_eq!(
+            owned.is_ok(),
+            borrowed.is_ok(),
+            "owned/borrowed disagree on validity"
+        );
+        assert_eq!(owned.is_ok(), tape_ok, "owned/tape disagree on validity");
+
+        #[cfg(feature = "serde_impl")]
+        {
+            let mut b4 = input.clone();
+            let via_serde: Result<Value, _> = crate::serde::from_slice(&mut b4);
+            assert_eq!(
+                owned.is_ok(),
+                via_serde.is_ok(),
+                "value path and serde path disagree on validity"
+            );
+            if let (Ok(o), Ok(s)) = (&owned, &via_serde) {
+                if !has_dup_keys(o) {
+                    assert_eq!(o, s, "value path and serde path disagree on value");
+                }
+            }
+        }
+
+        if let (Ok(o), Ok(b)) = (&owned, &borrowed) {
+            if !has_dup_keys(o) {
+                assert_eq!(*o, *b, "owned and borrowed values disagree");
+            }
+        }
+    }
+
+    /// Property: surrounding a document with arbitrary whitespace (lengths 0..=130,
+    /// crossing the 64-byte SIMD block boundaries at every offset) never changes
+    /// the parse result.
+    #[hegel::test]
+    fn hegel_prop_whitespace_padding_invariance(tc: hegel::TestCase) {
+        let doc = tc.draw(json_text(3));
+        let lead = draw_ws(&tc, 130);
+        let trail = draw_ws(&tc, 130);
+
+        let mut plain = doc.clone().into_bytes();
+        let v_plain = to_owned_value(&mut plain).expect("generated JSON must parse");
+
+        let mut padded = format!("{lead}{doc}{trail}").into_bytes();
+        let v_padded = to_owned_value(&mut padded).expect("padded JSON must parse");
+
+        assert_eq!(v_plain, v_padded, "padding changed the parsed value");
+    }
+
+    /// Property: escape sequences and multi-byte characters are decoded
+    /// correctly regardless of their byte offset relative to the 64-byte SIMD
+    /// blocks stage1/stage2 operate on. The expected string is constructed
+    /// alongside the literal, giving an exact oracle.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_prop_string_escapes_across_simd_boundaries(tc: hegel::TestCase) {
+        let n_segments = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let mut lit = String::new();
+        let mut expected = String::new();
+        for _ in 0..n_segments {
+            // filler positions the special piece at arbitrary offsets,
+            // including just before/after 64-byte boundaries
+            let filler = tc.draw_silent(generators::integers::<usize>().max_value(80));
+            lit.push_str(&"a".repeat(filler));
+            expected.push_str(&"a".repeat(filler));
+            let (l, d) = tc.draw(generators::sampled_from(string_pieces()));
+            lit.push_str(l);
+            expected.push_str(d);
+        }
+        let doc = format!("\"{lit}\"");
+        tc.note(&format!("doc: {doc:?}"));
+
+        let mut b = doc.clone().into_bytes();
+        let owned = to_owned_value(&mut b).expect("string literal must parse");
+        assert_eq!(owned, Value::from(expected.clone()));
+
+        let mut b = doc.into_bytes();
+        let borrowed = to_borrowed_value(&mut b).expect("string literal must parse");
+        assert_eq!(borrowed, crate::BorrowedValue::from(expected));
+    }
+
+    /// Recursively generate an arbitrary `OwnedValue`, *including floats*
+    /// (the existing proptest `prop_json_encode_decode` excludes them).
+    /// Non-finite floats are excluded because JSON cannot represent them.
+    fn arb_owned_value(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let max_choice = if depth == 0 { 5 } else { 7 };
+            match tc.draw_silent(generators::integers::<u8>().max_value(max_choice)) {
+                0 => Value::Static(StaticNode::Null),
+                1 => Value::from(tc.draw_silent(generators::booleans())),
+                2 => Value::from(tc.draw_silent(generators::integers::<i64>())),
+                3 => Value::from(tc.draw_silent(generators::integers::<u64>())),
+                4 => Value::from(
+                    tc.draw_silent(
+                        generators::floats::<f64>()
+                            .allow_nan(false)
+                            .allow_infinity(false),
+                    ),
+                ),
+                5 => Value::from(tc.draw_silent(generators::text().max_size(30))),
+                6 => {
+                    let n = tc.draw_silent(generators::integers::<usize>().max_value(6));
+                    let items: Vec<Value> =
+                        (0..n).map(|_| tc.draw(arb_owned_value(depth - 1))).collect();
+                    Value::from(items)
+                }
+                _ => {
+                    let keys: Vec<String> = tc.draw_silent(
+                        generators::vecs(generators::text().max_size(10))
+                            .max_size(6)
+                            .unique(true),
+                    );
+                    let mut o = Value::object();
+                    for k in keys {
+                        let v = tc.draw(arb_owned_value(depth - 1));
+                        o.insert(k, v).expect("insert into object");
+                    }
+                    o
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// Property: encode -> parse is the identity for arbitrary values,
+    /// including floats. simd-json's default number parser documents
+    /// round-trip correctness (the `approx-number-parsing` feature is the
+    /// documented opt-out, hence the cfg).
+    #[cfg(not(feature = "approx-number-parsing"))]
+    #[hegel::test(test_cases = 300)]
+    fn hegel_prop_encode_parse_roundtrip(tc: hegel::TestCase) {
+        let val = tc.draw(arb_owned_value(4));
+        let encoded = val.encode();
+        tc.note(&format!("encoded: {encoded}"));
+
+        let mut b = encoded.clone().into_bytes();
+        let owned = to_owned_value(&mut b).expect("encoded value must parse");
+        assert_eq!(val, owned, "owned round-trip changed the value");
+
+        let mut b = encoded.into_bytes();
+        let borrowed = to_borrowed_value(&mut b).expect("encoded value must parse");
+        assert_eq!(val, borrowed, "borrowed round-trip changed the value");
+    }
+
+    /// Property: the tape stage (stage1 + stage2) is fully iterative and must
+    /// handle arbitrarily deep nesting without crashing — unlike the DOM
+    /// builders (see owned_value_deep_nesting_stack_overflow below).
+    #[hegel::test(test_cases = 30)]
+    fn hegel_prop_tape_handles_deep_nesting(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(100_000));
+        let open = tc.draw(generators::sampled_from(vec![("[", "]"), ("{\"a\":", "}")]));
+        let mut doc = open.0.repeat(depth);
+        doc.push('1');
+        doc.push_str(&open.1.repeat(depth));
+        let mut b = doc.into_bytes();
+        let tape = crate::to_tape(&mut b);
+        assert!(tape.is_ok(), "tape stage failed on deep nesting: {tape:?}");
+    }
+
+    /// KNOWN BUG (deterministically pinned, kept failing on purpose):
+    ///
+    /// A lone *high* surrogate escape that is not followed by `\u` is
+    /// accepted and silently decoded to U+0000 (NUL), while a lone *low*
+    /// surrogate escape (`"\udd1e"`) is correctly rejected. serde_json and
+    /// upstream simdjson (C++) reject both. Code path:
+    /// `get_unicode_codepoint` in src/stringparse.rs returns
+    /// `Ok((0, src_offset))` when the byte after a high surrogate escape is
+    /// not `\\` or the following one is not `u` (and likewise when the second
+    /// escape's hex digits are invalid) — a mistranslation of the C++
+    /// `return false;` error path — so the caller writes code point 0 into
+    /// the output and keeps parsing. Besides accepting invalid JSON, this
+    /// injects NUL bytes into parsed strings, which is a data-corruption /
+    /// NUL-injection hazard. Found by hegel_prop_differential_junk_bytes
+    /// (which now excludes such inputs; see contains_high_surrogate_escape).
+    #[test]
+    fn lone_high_surrogate_escape_is_rejected() {
+        // Sibling sanity check that *does* hold: lone low surrogates error.
+        let mut low = br#""\udd1e""#.to_vec();
+        assert!(to_owned_value(&mut low).is_err());
+
+        // The bug: this parses to Ok(String("\0x")) instead of an error.
+        let mut high = br#""\ud834x""#.to_vec();
+        let res = to_owned_value(&mut high);
+        assert!(
+            res.is_err(),
+            "lone high surrogate escape was accepted and decoded to {res:?}"
+        );
+    }
+
+    /// KNOWN FAILURE (kept #[ignore]d because it aborts the process):
+    ///
+    /// `to_owned_value` / `to_borrowed_value` / the serde path build the DOM
+    /// with unbounded recursion (`OwnedDeserializer::parse` ->
+    /// `parse_array`/`parse_map` -> `parse`, src/value/owned.rs:307-347, same
+    /// for borrowed), so a deeply nested but *valid* document overflows the
+    /// stack and SIGABRTs the whole process. Depth 10_000 reliably aborts a
+    /// default 2 MiB test thread (threshold ~4-5k in debug builds); the tape
+    /// stage itself handles depth 1_000_000 fine (see
+    /// hegel_prop_tape_handles_deep_nesting). serde_json defends against this
+    /// with a 128-level recursion limit; simdjson (C++) uses a max-depth
+    /// parameter. This is a DoS vector for anyone parsing untrusted input
+    /// into simd-json's DOM values.
+    #[test]
+    #[ignore = "aborts the process: stack overflow in recursive DOM build on deeply nested input"]
+    fn owned_value_deep_nesting_stack_overflow() {
+        let n = 10_000;
+        let mut b = ("[".repeat(n) + &"]".repeat(n)).into_bytes();
+        // SIGABRT: stack overflow in OwnedDeserializer::parse recursion
+        let _ = to_owned_value(&mut b);
+    }
+}
