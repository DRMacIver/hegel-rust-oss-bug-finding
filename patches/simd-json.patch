+/// Hegel property tests: differential testing against serde_json as the
+/// oracle. serde_json's parser is an independent, widely-vetted
+/// implementation; simd-json's stated goal is "serde compatibility", so any
+/// disagreement outside the documented divergences (integer literals outside
+/// `i64::MIN..=u64::MAX`, duplicate object keys, serde_json's 128-level
+/// recursion limit, bare `-0` typing) is a bug in one of the two.
+#[cfg(not(target_arch = "wasm32"))]
+mod hegel_differential {
+    use super::super::hegel_gens::{draw_junk_bytes, draw_sci_number_token, json_text};
+    use super::from_slice;
+    use hegel::generators;
+
+    /// Structural equality on serde_json values with one documented
+    /// exception: a bare `-0` integer literal parses to the integer 0 in
+    /// simd-json but to the float -0.0 in serde_json.
+    fn json_eq(a: &serde_json::Value, b: &serde_json::Value) -> bool {
+        use serde_json::Value as V;
+        match (a, b) {
+            (V::Number(x), V::Number(y)) => num_eq(x, y),
+            (V::Array(x), V::Array(y)) => {
+                x.len() == y.len() && x.iter().zip(y.iter()).all(|(v, w)| json_eq(v, w))
+            }
+            (V::Object(x), V::Object(y)) => {
+                x.len() == y.len()
+                    && x.iter()
+                        .all(|(k, v)| y.get(k).is_some_and(|w| json_eq(v, w)))
+            }
+            _ => a == b,
+        }
+    }
+
+    fn num_eq(x: &serde_json::Number, y: &serde_json::Number) -> bool {
+        if x == y {
+            return true;
+        }
+        // `-0` typing divergence: integer zero on one side, float -0.0 on the other
+        let int_zero =
+            |n: &serde_json::Number| n.as_u64() == Some(0) || n.as_i64() == Some(0);
+        let neg_zero = |n: &serde_json::Number| {
+            n.is_f64() && n.as_f64().is_some_and(|f| f == 0.0 && f.is_sign_negative())
+        };
+        (int_zero(x) && neg_zero(y)) || (int_zero(y) && neg_zero(x))
+    }
+
+    fn depth(v: &serde_json::Value) -> usize {
+        match v {
+            serde_json::Value::Array(a) => 1 + a.iter().map(depth).max().unwrap_or(0),
+            serde_json::Value::Object(o) => 1 + o.values().map(depth).max().unwrap_or(0),
+            _ => 0,
+        }
+    }
+
+    /// True if the input contains a `\uD8xx`..`\uDBxx` escape (a high
+    /// surrogate). Necessary condition for the KNOWN BUG pinned by
+    /// `lone_high_surrogate_escape_is_rejected` (src/tests.rs): simd-json
+    /// accepts a lone high surrogate escape (decoding it to U+0000) while
+    /// serde_json rejects it, so the differential property must exclude such
+    /// inputs to keep testing everything else.
+    fn contains_high_surrogate_escape(input: &[u8]) -> bool {
+        input.windows(4).any(|w| {
+            w[0] == b'\\'
+                && w[1] == b'u'
+                && (w[2] == b'd' || w[2] == b'D')
+                && matches!(w[3], b'8' | b'9' | b'a' | b'A' | b'b' | b'B')
+        })
+    }
+
+    /// A run of >= 19 ASCII digits is a necessary condition for an integer
+    /// literal outside `i64::MIN..=u64::MAX` (simd-json's documented
+    /// rejection; serde_json parses such literals as f64).
+    fn has_long_digit_run(input: &[u8]) -> bool {
+        let mut run = 0usize;
+        for &b in input {
+            if b.is_ascii_digit() {
+                run += 1;
+                if run >= 19 {
+                    return true;
+                }
+            } else {
+                run = 0;
+            }
+        }
+        false
+    }
+
+    /// Property: on arbitrary bytes, simd-json and serde_json agree — both
+    /// reject, or both accept with equal values. Divergences are allowed only
+    /// in the two documented cases (out-of-range integer literals, serde's
+    /// recursion limit).
+    #[cfg(not(any(feature = "128bit", feature = "approx-number-parsing")))]
+    #[hegel::test(test_cases = 500)]
+    fn hegel_prop_differential_junk_bytes(tc: hegel::TestCase) {
+        // Three input classes: raw junk (mostly rejected), valid documents
+        // (so the both-accept comparison branch actually fires), and valid
+        // documents with one corrupted byte (borderline accept/reject).
+        let input: Vec<u8> = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => draw_junk_bytes(&tc),
+            1 => tc.draw(json_text(3)).into_bytes(),
+            _ => {
+                let mut b = tc.draw(json_text(3)).into_bytes();
+                let i = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+                b[i] = tc.draw(generators::integers::<u8>());
+                b
+            }
+        };
+        tc.note(&format!("input: {:?}", String::from_utf8_lossy(&input)));
+
+        let mut b = input.clone();
+        let simd: Result<serde_json::Value, _> = from_slice(&mut b);
+        let serde: Result<serde_json::Value, _> = serde_json::from_slice(&input);
+
+        match (simd, serde) {
+            (Ok(a), Ok(b)) => {
+                assert!(json_eq(&a, &b), "parsers disagree:\nsimd:  {a}\nserde: {b}");
+            }
+            (Err(_), Err(_)) => {}
+            (Ok(a), Err(e)) => {
+                // Allowed: serde_json enforces a 128-level recursion limit,
+                // and inputs containing high surrogate escapes hit the KNOWN
+                // BUG pinned by lone_high_surrogate_escape_is_rejected.
+                assert!(
+                    depth(&a) >= 128 || contains_high_surrogate_escape(&input),
+                    "simd-json accepted what serde_json rejected ({e}): {a}"
+                );
+            }
+            (Err(e), Ok(b)) => {
+                // simd-json documents rejecting integers outside i64/u64 range
+                assert!(
+                    has_long_digit_run(&input),
+                    "simd-json rejected ({e}) what serde_json accepted: {b}"
+                );
+            }
+        }
+    }
+
+    /// Property: on *valid* generated JSON documents (constructed to avoid the
+    /// documented divergences) both parsers accept and produce equal values.
+    #[cfg(not(any(feature = "128bit", feature = "approx-number-parsing")))]
+    #[hegel::test(test_cases = 300)]
+    fn hegel_prop_differential_generated_json(tc: hegel::TestCase) {
+        let doc = tc.draw(json_text(4));
+        tc.note(&format!("doc: {doc}"));
+
+        let serde_v: serde_json::Value = serde_json::from_str(&doc)
+            .expect("generator must produce JSON that serde_json accepts");
+        let mut b = doc.clone().into_bytes();
+        let simd_v: serde_json::Value =
+            from_slice(&mut b).expect("simd-json rejected valid JSON");
+
+        assert!(
+            json_eq(&simd_v, &serde_v),
+            "parsers disagree on valid JSON:\ndoc:   {doc}\nsimd:  {simd_v}\nserde: {serde_v}"
+        );
+    }
+
+    /// Property: number parsing matches serde_json exactly — same
+    /// accept/reject decision and bit-identical values — across integer
+    /// boundaries, scientific notation, subnormals, and overflow candidates.
+    #[cfg(not(any(feature = "128bit", feature = "approx-number-parsing")))]
+    #[hegel::test(test_cases = 1000)]
+    fn hegel_prop_number_parse_matches_serde_json(tc: hegel::TestCase) {
+        let token: String = match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => tc.draw(generators::integers::<i64>()).to_string(),
+            1 => tc.draw(generators::integers::<u64>()).to_string(),
+            2 => format!(
+                "{:?}",
+                tc.draw(
+                    generators::floats::<f64>()
+                        .allow_nan(false)
+                        .allow_infinity(false)
+                )
+            ),
+            // exponent up to 400: overflow-to-infinity candidates, which both
+            // parsers must *reject* in agreement
+            3 => draw_sci_number_token(&tc, 400),
+            _ => tc.draw(generators::sampled_from(vec![
+                "-0".to_string(),
+                "-0.0".to_string(),
+                "0e-1".to_string(),
+                "9007199254740992".to_string(),  // 2^53
+                "9007199254740993".to_string(),  // 2^53 + 1
+                "-9007199254740993".to_string(),
+                "18446744073709551615".to_string(), // u64::MAX
+                "-9223372036854775808".to_string(), // i64::MIN
+                "5e-324".to_string(),               // smallest subnormal
+                "2.2250738585072014e-308".to_string(), // smallest normal
+                "2.2250738585072011e-308".to_string(), // largest subnormal
+                "1.7976931348623157e308".to_string(),  // f64::MAX
+                "1.7976931348623159e308".to_string(),  // just past f64::MAX
+                "1e309".to_string(),
+                "-1e-400".to_string(),
+                "0.000000000000000000000000000000000000000000000000000000001".to_string(),
+            ])),
+        };
+        tc.note(&format!("token: {token}"));
+
+        let mut b = token.clone().into_bytes();
+        let simd: Result<serde_json::Value, _> = from_slice(&mut b);
+        let serde: Result<serde_json::Value, _> = serde_json::from_str(&token);
+
+        assert_eq!(
+            simd.is_ok(),
+            serde.is_ok(),
+            "accept/reject disagreement on {token:?}: simd={simd:?} serde={serde:?}"
+        );
+        if let (Ok(a), Ok(b)) = (simd, serde) {
+            assert!(
+                json_eq(&a, &b),
+                "value disagreement on {token:?}: simd={a} serde={b}"
+            );
+        }
+    }
+
+    /// Property (pins documented behavior): integer literals outside
+    /// `i64::MIN..=u64::MAX` are rejected by simd-json under default features,
+    /// while serde_json parses them as f64.
+    #[cfg(not(any(feature = "128bit", feature = "big-int-as-float")))]
+    #[hegel::test]
+    fn hegel_prop_out_of_range_int_rejected(tc: hegel::TestCase) {
+        let text = if tc.draw(generators::booleans()) {
+            // positive: strictly above u64::MAX
+            tc.draw(
+                generators::integers::<u128>()
+                    .min_value(u128::from(u64::MAX) + 1),
+            )
+            .to_string()
+        } else {
+            // negative: strictly below i64::MIN
+            (-tc.draw(
+                generators::integers::<i128>()
+                    .min_value(i128::from(i64::MAX) + 2)
+                    .max_value(i128::MAX),
+            ))
+            .to_string()
+        };
+        tc.note(&format!("literal: {text}"));
+
+        let mut b = text.clone().into_bytes();
+        let simd: Result<serde_json::Value, _> = from_slice(&mut b);
+        assert!(
+            simd.is_err(),
+            "simd-json accepted out-of-range integer {text}: {simd:?}"
+        );
+        let serde: Result<serde_json::Value, _> = serde_json::from_str(&text);
+        assert!(serde.is_ok(), "serde_json rejected {text}");
+    }
