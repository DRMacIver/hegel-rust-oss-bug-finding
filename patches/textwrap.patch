+    // Property-based tests (hegel)
+    // ------------------------------------------------------------
+
+    /// `wrap_first_fit` accumulates fragments "one by one and when a
+    /// fragment no longer fits, start a new line". The output must
+    /// partition the input fragments in order, and every line must
+    /// fit its target width — except that a line's *first* fragment
+    /// is allowed to overflow, since the function "will not (and
+    /// cannot) attempt to split" fragments.
+    ///
+    /// Fragment and line widths are drawn as `u32` so that all sums
+    /// are exactly representable in `f64` (the fit check below would
+    /// otherwise be subject to rounding differences); this protects
+    /// the test's oracle, not the library, which is documented to
+    /// work with arbitrary `f64` widths.
+    #[hegel::test]
+    fn hegel_wrap_first_fit_partitions_and_fits(tc: hegel::TestCase) {
+        use hegel::generators;
+
+        #[derive(Debug, PartialEq, Clone, Copy)]
+        struct Frag {
+            width: f64,
+            whitespace_width: f64,
+            penalty_width: f64,
+        }
+
+        #[rustfmt::skip]
+        impl Fragment for Frag {
+            fn width(&self) -> f64 { self.width }
+            fn whitespace_width(&self) -> f64 { self.whitespace_width }
+            fn penalty_width(&self) -> f64 { self.penalty_width }
+        }
+
+        let frag_gen = hegel::compose!(|tc| {
+            Frag {
+                width: tc.draw(generators::integers::<u32>()) as f64,
+                whitespace_width: tc.draw(generators::integers::<u32>()) as f64,
+                penalty_width: tc.draw(generators::integers::<u32>()) as f64,
+            }
+        });
+        let fragments: Vec<Frag> = tc.draw(generators::vecs(frag_gen).max_size(50));
+        let line_widths: Vec<f64> = tc
+            .draw(generators::vecs(generators::integers::<u32>()).max_size(3))
+            .into_iter()
+            .map(|w| w as f64)
+            .collect();
+
+        let lines = wrap_first_fit(&fragments, &line_widths);
+
+        // The lines partition the fragments in order.
+        let flattened: Vec<Frag> = lines.iter().flat_map(|line| line.iter().copied()).collect();
+        assert_eq!(flattened, fragments);
+
+        // Every line fits, except that a lone (first) fragment may
+        // overflow its line.
+        let default_line_width = line_widths.last().copied().unwrap_or(0.0);
+        for (i, line) in lines.iter().enumerate() {
+            let target = line_widths.get(i).copied().unwrap_or(default_line_width);
+            if line.len() < 2 {
+                continue;
+            }
+            let mut acc = 0.0;
+            for (k, frag) in line.iter().enumerate() {
+                if k + 1 == line.len() {
+                    assert!(
+                        acc + frag.width + frag.penalty_width <= target,
+                        "line {} does not fit target {}: {:?}",
+                        i,
+                        target,
+                        line
+                    );
+                } else {
+                    acc += frag.width + frag.whitespace_width;
+                }
+            }
+        }
+    }
