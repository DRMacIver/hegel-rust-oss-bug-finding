+    // ------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ------------------------------------------------------------
+
+    /// `indent()` adds a fixed prefix to every non-blank line;
+    /// `dedent()` "removes common leading whitespace from each line".
+    /// When the common leading whitespace of the indented text is
+    /// exactly the added prefix, dedent must undo indent. That holds
+    /// when the prefix is pure whitespace, every non-blank input line
+    /// starts at column zero (there is at least one), no line is
+    /// whitespace-only (dedent drops the content of whitespace-only
+    /// lines), and there are no '\r' characters (dedent uses
+    /// `str::lines`, indent splits on '\n').
+    #[hegel::test]
+    fn hegel_dedent_undoes_indent(tc: hegel::TestCase) {
+        use hegel::generators;
+        let prefix: String = tc.draw(generators::from_regex(r"[ \t]{1,6}").fullmatch(true));
+        let line_gen = || generators::from_regex(r"[!-~][ -~]{0,10}").fullmatch(true);
+
+        let n = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut lines: Vec<String> = Vec::new();
+        for _ in 0..n {
+            if tc.draw(generators::booleans()) {
+                lines.push(String::new());
+            } else {
+                lines.push(tc.draw(line_gen()));
+            }
+        }
+        if !lines.iter().any(|line| !line.is_empty()) {
+            // Ensure at least one non-blank line at column zero, so
+            // that dedent's common prefix is pinned to `prefix`.
+            lines.push(tc.draw(line_gen()));
+        }
+        let mut text = lines.join("\n");
+        if tc.draw(generators::booleans()) {
+            text.push('\n');
+        }
+
+        let indented = indent(&text, &prefix);
+        assert_eq!(
+            dedent(&indented),
+            text,
+            "prefix: {:?}, indented: {:?}",
+            prefix,
+            indented
+        );
+    }
+
