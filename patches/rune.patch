+            }
+            (Err(RefError::Arith(op)), Err(TestError::VmError(error))) => {
+                let kind = error.into_kind();
+                let ok = match op {
+                    ArithOp::Add | ArithOp::Mul => matches!(kind, Overflow),
+                    ArithOp::Sub => matches!(kind, Underflow),
