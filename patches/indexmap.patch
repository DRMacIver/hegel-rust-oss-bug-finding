+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the quickcheck properties above. The main addition is a
+// stateful model test that checks *iteration order* (the core IndexMap
+// invariant) after every operation, which the quickcheck `operations_*`
+// tests do not do -- their HashMap oracle only checks the key->value mapping.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use hegel::TestCase;
+    use hegel::generators;
+    use indexmap::{IndexMap, IndexSet};
+    use std::collections::{HashMap, HashSet};
+
+    // ------------------------------------------------------------------
+    // Stateful model test for IndexMap.
+    //
+    // Oracle: a Vec<(K, V)> mirroring the documented insertion order plus a
+    // std HashMap mirroring the key->value mapping. After every rule, the
+    // invariant checks len, iteration order, get/get_index/get_index_of
+    // round-trips, and agreement with the HashMap.
+    // ------------------------------------------------------------------
+    struct MapMachine {
+        map: IndexMap<u8, i32>,
+        model: Vec<(u8, i32)>,
+        reference: HashMap<u8, i32>,
+    }
+
+    impl MapMachine {
+        /// Draw a key, biased ~50% toward keys currently in the map so that
+        /// update/remove rules regularly hit existing entries.
+        fn draw_key(&self, tc: &TestCase) -> u8 {
+            if !self.model.is_empty() && tc.draw(generators::booleans()) {
+                let i = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+                self.model[i].0
+            } else {
+                tc.draw(generators::integers::<u8>())
+            }
+        }
+
+        fn model_pos(&self, k: u8) -> Option<usize> {
+            self.model.iter().position(|&(mk, _)| mk == k)
+        }
+    }
+
+    #[hegel::state_machine]
+    impl MapMachine {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let k = self.draw_key(&tc);
+            let v = tc.draw(generators::integers::<i32>());
+            let old = self.map.insert(k, v);
+            // Documented contract: an existing key keeps its position and only
+            // the value is updated; a new key is appended last in order.
+            let model_old = match self.model_pos(k) {
+                Some(i) => Some(std::mem::replace(&mut self.model[i].1, v)),
+                None => {
+                    self.model.push((k, v));
+                    None
+                }
+            };
+            assert_eq!(old, model_old);
+            assert_eq!(old, self.reference.insert(k, v));
+        }
+
+        #[rule]
+        fn swap_remove(&mut self, tc: TestCase) {
+            let k = self.draw_key(&tc);
+            let removed = self.map.swap_remove(&k);
+            // Documented contract: like Vec::swap_remove, the last entry is
+            // swapped into the removed slot.
+            let model_removed = self.model_pos(k).map(|i| self.model.swap_remove(i).1);
+            assert_eq!(removed, model_removed);
+            assert_eq!(removed, self.reference.remove(&k));
+        }
+
+        #[rule]
+        fn shift_remove(&mut self, tc: TestCase) {
+            let k = self.draw_key(&tc);
+            let removed = self.map.shift_remove(&k);
+            // Documented contract: like Vec::remove, all following entries
+            // shift down, preserving their relative order.
+            let model_removed = self.model_pos(k).map(|i| self.model.remove(i).1);
+            assert_eq!(removed, model_removed);
+            assert_eq!(removed, self.reference.remove(&k));
+        }
+
+        #[rule]
+        fn get(&mut self, tc: TestCase) {
+            let k = self.draw_key(&tc);
+            assert_eq!(self.map.get(&k), self.reference.get(&k));
+            assert_eq!(self.map.get_index_of(&k), self.model_pos(k));
+        }
+
+        #[rule]
+        fn get_index(&mut self, tc: TestCase) {
+            // Deliberately drawn a little past the end to also check None.
+            let i = tc.draw(generators::integers::<usize>().max_value(self.model.len() + 2));
+            let expected = self.model.get(i).map(|(k, v)| (k, v));
+            assert_eq!(self.map.get_index(i), expected);
+            // Round-trip: index -> key -> index.
+            if let Some(&(k, _)) = self.model.get(i) {
+                assert_eq!(self.map.get_index_of(&k), Some(i));
+            }
+        }
+
+        #[rule]
+        fn swap_indices(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let a = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let b = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            self.map.swap_indices(a, b);
+            self.model.swap(a, b);
+        }
+
+        #[rule]
+        fn move_index(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let from = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let to = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            self.map.move_index(from, to);
+            let entry = self.model.remove(from);
+            self.model.insert(to, entry);
+        }
+
+        #[rule]
+        fn sort_keys(&mut self, tc: TestCase) {
+            // Keys are unique, so the stable and unstable sorts must agree
+            // with the same model sort.
+            if tc.draw(generators::booleans()) {
+                self.map.sort_keys();
+            } else {
+                self.map.sort_unstable_keys();
+            }
+            self.model.sort_by_key(|&(k, _)| k);
+        }
+
+        #[rule]
+        fn reverse(&mut self, _: TestCase) {
+            self.map.reverse();
+            self.model.reverse();
+        }
+
+        #[rule]
+        fn truncate(&mut self, tc: TestCase) {
+            // Drawn a little past the end: truncate beyond len is a no-op.
+            let n = tc.draw(generators::integers::<usize>().max_value(self.model.len() + 2));
+            for &(k, _) in self.model.get(n..).unwrap_or(&[]) {
+                self.reference.remove(&k);
+            }
+            self.map.truncate(n);
+            self.model.truncate(n);
+        }
+
+        #[rule]
+        fn pop(&mut self, _: TestCase) {
+            let popped = self.map.pop();
+            let model_popped = self.model.pop();
+            assert_eq!(popped, model_popped);
+            if let Some((k, _)) = model_popped {
+                self.reference.remove(&k);
+            }
+        }
+
+        #[rule]
+        fn retain(&mut self, tc: TestCase) {
+            let t = tc.draw(generators::integers::<u8>());
+            let keep_below = tc.draw(generators::booleans());
+            self.map.retain(|&k, _| (k <= t) == keep_below);
+            self.model.retain(|&(k, _)| (k <= t) == keep_below);
+            self.reference.retain(|&k, _| (k <= t) == keep_below);
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.map.len(), self.model.len());
+            assert_eq!(self.map.len(), self.reference.len());
+            // Same iteration order -- the core IndexMap invariant.
+            assert!(self.map.iter().eq(self.model.iter().map(|(k, v)| (k, v))));
+            for (i, &(k, v)) in self.model.iter().enumerate() {
+                assert_eq!(self.map.get_index(i), Some((&k, &v)));
+                assert_eq!(self.map.get_index_of(&k), Some(i));
+                assert_eq!(self.map.get(&k), Some(&v));
+                assert_eq!(self.reference.get(&k), Some(&v));
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn map_model(tc: TestCase) {
+        let machine = MapMachine {
+            map: IndexMap::new(),
+            model: Vec::new(),
+            reference: HashMap::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    // ------------------------------------------------------------------
+    // Stateful model test for IndexSet, mirroring the map machine.
+    // Oracle: Vec<T> for order + std HashSet for membership.
+    // ------------------------------------------------------------------
+    struct SetMachine {
+        set: IndexSet<u8>,
+        model: Vec<u8>,
+        reference: HashSet<u8>,
+    }
+
+    impl SetMachine {
+        fn draw_value(&self, tc: &TestCase) -> u8 {
+            if !self.model.is_empty() && tc.draw(generators::booleans()) {
+                let i = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+                self.model[i]
+            } else {
+                tc.draw(generators::integers::<u8>())
+            }
+        }
+
+        fn model_pos(&self, x: u8) -> Option<usize> {
+            self.model.iter().position(|&m| m == x)
+        }
+    }
+
+    #[hegel::state_machine]
+    impl SetMachine {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let x = self.draw_value(&tc);
+            let added = self.set.insert(x);
+            let model_added = self.model_pos(x).is_none();
+            if model_added {
+                self.model.push(x);
+            }
+            assert_eq!(added, model_added);
+            assert_eq!(added, self.reference.insert(x));
+        }
+
+        #[rule]
+        fn swap_remove(&mut self, tc: TestCase) {
+            let x = self.draw_value(&tc);
+            let removed = self.set.swap_remove(&x);
+            let model_removed = match self.model_pos(x) {
+                Some(i) => {
+                    self.model.swap_remove(i);
+                    true
+                }
+                None => false,
+            };
+            assert_eq!(removed, model_removed);
+            assert_eq!(removed, self.reference.remove(&x));
+        }
+
+        #[rule]
+        fn shift_remove(&mut self, tc: TestCase) {
+            let x = self.draw_value(&tc);
+            let removed = self.set.shift_remove(&x);
+            let model_removed = match self.model_pos(x) {
+                Some(i) => {
+                    self.model.remove(i);
+                    true
+                }
+                None => false,
+            };
+            assert_eq!(removed, model_removed);
+            assert_eq!(removed, self.reference.remove(&x));
+        }
+
+        #[rule]
+        fn move_index(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let from = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let to = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            self.set.move_index(from, to);
+            let x = self.model.remove(from);
+            self.model.insert(to, x);
+        }
+
+        #[rule]
+        fn swap_indices(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let a = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let b = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            self.set.swap_indices(a, b);
+            self.model.swap(a, b);
+        }
+
+        #[rule]
+        fn sort(&mut self, tc: TestCase) {
+            if tc.draw(generators::booleans()) {
+                self.set.sort();
+            } else {
+                self.set.sort_unstable();
+            }
+            self.model.sort_unstable();
+        }
+
+        #[rule]
+        fn reverse(&mut self, _: TestCase) {
+            self.set.reverse();
+            self.model.reverse();
+        }
+
+        #[rule]
+        fn truncate(&mut self, tc: TestCase) {
+            let n = tc.draw(generators::integers::<usize>().max_value(self.model.len() + 2));
+            for &x in self.model.get(n..).unwrap_or(&[]) {
+                self.reference.remove(&x);
+            }
+            self.set.truncate(n);
+            self.model.truncate(n);
+        }
+
+        #[rule]
+        fn pop(&mut self, _: TestCase) {
+            let popped = self.set.pop();
+            let model_popped = self.model.pop();
+            assert_eq!(popped, model_popped);
+            if let Some(x) = model_popped {
+                self.reference.remove(&x);
+            }
+        }
+
+        #[rule]
+        fn retain(&mut self, tc: TestCase) {
+            let t = tc.draw(generators::integers::<u8>());
+            let keep_below = tc.draw(generators::booleans());
+            self.set.retain(|&x| (x <= t) == keep_below);
+            self.model.retain(|&x| (x <= t) == keep_below);
+            self.reference.retain(|&x| (x <= t) == keep_below);
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.set.len(), self.model.len());
+            assert_eq!(self.set.len(), self.reference.len());
+            assert!(self.set.iter().eq(self.model.iter()));
+            for (i, &x) in self.model.iter().enumerate() {
+                assert_eq!(self.set.get_index(i), Some(&x));
+                assert_eq!(self.set.get_index_of(&x), Some(i));
+                assert!(self.reference.contains(&x));
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn set_model(tc: TestCase) {
+        let machine = SetMachine {
+            set: IndexSet::new(),
+            model: Vec::new(),
+            reference: HashSet::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    // ------------------------------------------------------------------
+    // Standalone properties.
+    // ------------------------------------------------------------------
+
+    /// For an insert-only sequence, iteration order is first-occurrence
+    /// insertion order and each key holds the last value inserted for it.
+    /// Full-range i64 keys (the quickcheck version only uses u32 keys with
+    /// unit values).
+    #[hegel::test]
+    fn insert_only_iteration_matches_insertion_order(tc: TestCase) {
+        // Bias keys toward a small subdomain so duplicate keys (the
+        // update-in-place branch) actually occur; uniform full-range i64
+        // draws would essentially never collide.
+        let pairs: Vec<(i64, i64)> = tc.draw(generators::vecs(generators::tuples!(
+            hegel::one_of!(
+                generators::integers::<i64>(),
+                generators::integers::<i64>().min_value(0).max_value(7),
+            ),
+            generators::integers::<i64>(),
+        )));
+        let mut map = IndexMap::new();
+        let mut expected: Vec<(i64, i64)> = Vec::new();
+        for &(k, v) in &pairs {
+            map.insert(k, v);
+            match expected.iter_mut().find(|e| e.0 == k) {
+                Some(e) => e.1 = v,
+                None => expected.push((k, v)),
+            }
+        }
+        assert!(map.iter().eq(expected.iter().map(|(k, v)| (k, v))));
+    }
+
+    /// swap_remove and shift_remove agree on the returned value and on the
+    /// remaining key-value *set*; they differ only in order, each matching
+    /// its exact Vec counterpart (Vec::swap_remove / Vec::remove).
+    #[hegel::test]
+    fn swap_remove_vs_shift_remove(tc: TestCase) {
+        let keys: Vec<u16> =
+            tc.draw(generators::vecs(generators::integers::<u16>()).unique(true));
+        let map: IndexMap<u16, usize> = keys.iter().enumerate().map(|(i, &k)| (k, i)).collect();
+        let k = if !keys.is_empty() && tc.draw(generators::booleans()) {
+            let i = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+            keys[i]
+        } else {
+            tc.draw(generators::integers::<u16>())
+        };
+
+        let mut swapped = map.clone();
+        let mut shifted = map.clone();
+        let a = swapped.swap_remove(&k);
+        let b = shifted.shift_remove(&k);
+        assert_eq!(a, b);
+
+        let entries: Vec<(u16, usize)> = map.iter().map(|(&k, &v)| (k, v)).collect();
+        match map.get_index_of(&k) {
+            None => {
+                assert!(swapped.iter().eq(map.iter()));
+                assert!(shifted.iter().eq(map.iter()));
+            }
+            Some(i) => {
+                let mut expect_shift = entries.clone();
+                expect_shift.remove(i);
+                assert!(shifted.iter().map(|(&k, &v)| (k, v)).eq(expect_shift));
+
+                let mut expect_swap = entries.clone();
+                expect_swap.swap_remove(i);
+                assert!(swapped.iter().map(|(&k, &v)| (k, v)).eq(expect_swap));
+            }
+        }
+
+        let set_a: HashSet<(u16, usize)> = swapped.iter().map(|(&k, &v)| (k, v)).collect();
+        let set_b: HashSet<(u16, usize)> = shifted.iter().map(|(&k, &v)| (k, v)).collect();
+        assert_eq!(set_a, set_b);
+    }
+
+    /// Inserting an existing key updates the value in place: same length,
+    /// same index for the key, iteration order completely unchanged, and the
+    /// old value is returned.
+    #[hegel::test]
+    fn insert_existing_key_keeps_position(tc: TestCase) {
+        let keys: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>())
+                .min_size(1)
+                .unique(true),
+        );
+        let mut map: IndexMap<u32, i64> = keys
+            .iter()
+            .enumerate()
+            .map(|(i, &k)| (k, i as i64))
+            .collect();
+        let i = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+        let k = keys[i];
+        let v = tc.draw(generators::integers::<i64>());
+
+        let old = map.insert(k, v);
+        assert_eq!(old, Some(i as i64));
+        assert_eq!(map.len(), keys.len());
+        assert_eq!(map.get_index_of(&k), Some(i));
+        assert!(map.keys().eq(keys.iter()));
+        assert_eq!(map.get(&k), Some(&v));
+    }
+
+    /// split_off partitions the entries at the given index: the head keeps
+    /// [0, at) and the tail gets [at, len), both in the original order, and
+    /// hash lookups work on both halves.
+    #[hegel::test]
+    fn split_off_partitions_in_order(tc: TestCase) {
+        let keys: Vec<u16> =
+            tc.draw(generators::vecs(generators::integers::<u16>()).unique(true));
+        let mut map: IndexMap<u16, usize> = keys.iter().enumerate().map(|(i, &k)| (k, i)).collect();
+        let entries: Vec<(u16, usize)> = map.iter().map(|(&k, &v)| (k, v)).collect();
+        let at = tc.draw(generators::integers::<usize>().max_value(entries.len()));
+
+        let tail = map.split_off(at);
+
+        assert!(map.iter().map(|(&k, &v)| (k, v)).eq(entries[..at].iter().copied()));
+        assert!(tail.iter().map(|(&k, &v)| (k, v)).eq(entries[at..].iter().copied()));
+        for (i, &(k, _)) in entries.iter().enumerate() {
+            if i < at {
+                assert_eq!(map.get_index_of(&k), Some(i));
+                assert!(!tail.contains_key(&k));
+            } else {
+                assert_eq!(tail.get_index_of(&k), Some(i - at));
+                assert!(!map.contains_key(&k));
+            }
+        }
+    }
+
+    /// After sorting by keys, binary_search_keys agrees with get_index_of for
+    /// present keys and returns a correct insertion point for absent keys.
+    #[hegel::test]
+    fn binary_search_keys_agrees_with_get_index_of(tc: TestCase) {
+        let keys: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).unique(true));
+        let mut map: IndexMap<i32, ()> = keys.iter().map(|&k| (k, ())).collect();
+        map.sort_unstable_keys();
+
+        let probe = if !keys.is_empty() && tc.draw(generators::booleans()) {
+            let i = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+            keys[i]
+        } else {
+            tc.draw(generators::integers::<i32>())
+        };
+
+        match map.binary_search_keys(&probe) {
+            Ok(i) => assert_eq!(map.get_index_of(&probe), Some(i)),
+            Err(i) => {
+                assert_eq!(map.get_index_of(&probe), None);
+                assert!(map.keys().take(i).all(|&k| k < probe));
+                assert!(map.keys().skip(i).all(|&k| k > probe));
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // IndexSet binary set operations: documented iteration orders.
+    // Keys are biased toward a small subdomain so the two sets regularly
+    // overlap (uniform full-range u8 draws rarely collide at default sizes).
+    // ------------------------------------------------------------------
+    fn two_sets(tc: &TestCase) -> (IndexSet<u8>, IndexSet<u8>) {
+        let elem = || {
+            hegel::one_of!(
+                generators::integers::<u8>(),
+                generators::integers::<u8>().max_value(7),
+            )
+        };
+        let a: Vec<u8> = tc.draw(generators::vecs(elem()));
+        let b: Vec<u8> = tc.draw(generators::vecs(elem()));
+        (IndexSet::from_iter(a), IndexSet::from_iter(b))
+    }
+
+    /// union yields self's values in order, then other's unique values in
+    /// order; as a set it equals the HashSet union.
+    #[hegel::test]
+    fn set_union_order(tc: TestCase) {
+        let (a, b) = two_sets(&tc);
+        let expected: Vec<u8> = a
+            .iter()
+            .copied()
+            .chain(b.iter().copied().filter(|x| !a.contains(x)))
+            .collect();
+        assert!(a.union(&b).copied().eq(expected.iter().copied()));
+
+        let ha: HashSet<u8> = a.iter().copied().collect();
+        let hb: HashSet<u8> = b.iter().copied().collect();
+        let expected_set: HashSet<u8> = ha.union(&hb).copied().collect();
+        assert_eq!(expected.into_iter().collect::<HashSet<u8>>(), expected_set);
+    }
+
+    /// intersection yields values in self's order; as a set it equals the
+    /// HashSet intersection.
+    #[hegel::test]
+    fn set_intersection_order(tc: TestCase) {
+        let (a, b) = two_sets(&tc);
+        let expected: Vec<u8> = a.iter().copied().filter(|x| b.contains(x)).collect();
+        assert!(a.intersection(&b).copied().eq(expected.iter().copied()));
+
+        let ha: HashSet<u8> = a.iter().copied().collect();
+        let hb: HashSet<u8> = b.iter().copied().collect();
+        let expected_set: HashSet<u8> = ha.intersection(&hb).copied().collect();
+        assert_eq!(expected.into_iter().collect::<HashSet<u8>>(), expected_set);
+    }
+
+    /// difference yields values in self's order; as a set it equals the
+    /// HashSet difference.
+    #[hegel::test]
+    fn set_difference_order(tc: TestCase) {
+        let (a, b) = two_sets(&tc);
+        let expected: Vec<u8> = a.iter().copied().filter(|x| !b.contains(x)).collect();
+        assert!(a.difference(&b).copied().eq(expected.iter().copied()));
+
+        let ha: HashSet<u8> = a.iter().copied().collect();
+        let hb: HashSet<u8> = b.iter().copied().collect();
+        let expected_set: HashSet<u8> = ha.difference(&hb).copied().collect();
+        assert_eq!(expected.into_iter().collect::<HashSet<u8>>(), expected_set);
+    }
+
+    /// symmetric_difference yields self-only values in self's order, then
+    /// other-only values in other's order; as a set it equals the HashSet
+    /// symmetric difference.
+    #[hegel::test]
+    fn set_symmetric_difference_order(tc: TestCase) {
+        let (a, b) = two_sets(&tc);
+        let expected: Vec<u8> = a
+            .iter()
+            .copied()
+            .filter(|x| !b.contains(x))
+            .chain(b.iter().copied().filter(|x| !a.contains(x)))
+            .collect();
+        assert!(a.symmetric_difference(&b).copied().eq(expected.iter().copied()));
+
+        let ha: HashSet<u8> = a.iter().copied().collect();
+        let hb: HashSet<u8> = b.iter().copied().collect();
+        let expected_set: HashSet<u8> = ha.symmetric_difference(&hb).copied().collect();
+        assert_eq!(expected.into_iter().collect::<HashSet<u8>>(), expected_set);
+    }
+}
