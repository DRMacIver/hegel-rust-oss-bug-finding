+// ===========================================================================
+// Property-based tests (hegel / hegeltest).
+//
+// These exercise dyon's public module/runtime API (`load_str`, `run_str`,
+// `Module`, `Runtime`, `Call`) on generated source. dyon uses f64 for all
+// numbers, so arithmetic is checked against a Rust f64 oracle.
+//
+// See HEGEL_REPORT.md for a summary of findings. Two classes of test here:
+//   * live properties (should pass) — real, falsifiable invariants
+//   * #[ignore]d reproducers — pin process-hanging parser bugs that would take
+//     the whole suite down if run un-ignored.
+// ===========================================================================
+#[cfg(test)]
+mod hegel_tests {
+    use dyon::{load_str, Call, Module, Runtime};
+    use hegel::generators;
+    use std::sync::Arc;
+
+    // ---- helpers -----------------------------------------------------------
+
+    /// Load `f() = <expr>` and evaluate it to an f64 via the runtime.
+    fn eval_dyon_f64(expr_src: &str) -> Result<f64, String> {
+        let mut module = Module::new();
+        load_str(
+            "prop.dyon",
+            Arc::new(format!("f() = {}", expr_src)),
+            &mut module,
+        )?;
+        let module = Arc::new(module);
+        Call::new("f").run_ret::<f64>(&mut Runtime::new(), &module)
+    }
+
+    /// Load `f() = <expr>` and evaluate it to a bool.
+    fn eval_dyon_bool(expr_src: &str) -> Result<bool, String> {
+        let mut module = Module::new();
+        load_str(
+            "prop.dyon",
+            Arc::new(format!("f() = {}", expr_src)),
+            &mut module,
+        )?;
+        let module = Arc::new(module);
+        Call::new("f").run_ret::<bool>(&mut Runtime::new(), &module)
+    }
+
+    /// f64 equality that treats NaN == NaN as true (IEEE ops are otherwise
+    /// bit-identical between dyon and the Rust oracle because both use f64).
+    fn f64_eq(a: f64, b: f64) -> bool {
+        a == b || (a.is_nan() && b.is_nan())
+    }
+
+    /// Draw a fully-parenthesized numeric expression tree, returning the dyon
+    /// source and the Rust f64 oracle value. Depth is bounded to keep the
+    /// leftmost paren spine shallow: nesting parens deeply triggers the
+    /// exponential-time parser blowup pinned by `nested_parens_parser_hang`.
+    fn draw_expr(tc: &hegel::TestCase, depth: u32) -> (String, f64) {
+        let leaf = depth == 0 || tc.draw(generators::booleans());
+        if leaf {
+            // Integer-valued leaves (well within 2^53, so exactly representable
+            // and parsed exactly by dyon). This isolates the arithmetic
+            // OPERATIONS under test from dyon's separate decimal-literal
+            // mis-rounding bug, which is pinned by
+            // `prop_float_literal_parse_correctly_rounded_KNOWN_FAILURE`.
+            let x = tc.draw(
+                generators::integers::<i32>()
+                    .min_value(-1_000_000)
+                    .max_value(1_000_000),
+            ) as f64;
+            (format!("{:?}", x), x)
+        } else {
+            let op = tc.draw(generators::sampled_from(vec!['+', '-', '*', '/', '%']));
+            let (ls, lv) = draw_expr(tc, depth - 1);
+            let (rs, rv) = draw_expr(tc, depth - 1);
+            let v = match op {
+                '+' => lv + rv,
+                '-' => lv - rv,
+                '*' => lv * rv,
+                '/' => lv / rv,
+                '%' => lv % rv,
+                _ => unreachable!(),
+            };
+            (format!("({} {} {})", ls, op, rs), v)
+        }
+    }
+
+    // ---- Property 1: arithmetic vs a Rust f64 oracle -----------------------
+    // A fully-parenthesized (+ - * / %) expression tree evaluates identically
+    // in dyon and in Rust f64. Parens fix evaluation order so this is
+    // independent of dyon's precedence/associativity.
+    #[hegel::test]
+    fn prop_arithmetic_matches_rust_oracle(tc: hegel::TestCase) {
+        let (src, expected) = draw_expr(&tc, 4);
+        let got = eval_dyon_f64(&src).expect("well-formed arithmetic must evaluate");
+        assert!(
+            f64_eq(got, expected),
+            "`{}` => dyon {:?} vs rust {:?}",
+            src,
+            got,
+            expected
+        );
+    }
+
+    // ---- Property 2: operator precedence/associativity ---------------------
+    // An UN-parenthesized chain `l0 op0 l1 op1 ...` is evaluated by dyon per
+    // its grammar: `* / %` bind tighter than `+ -`, both left-associative.
+    // Oracle = a transcription of that precedence (two left-to-right passes).
+    // Non-negative integer leaves isolate precedence from unary-minus parsing
+    // and from the decimal-literal mis-rounding bug (see the KNOWN_FAILURE
+    // test); they are exactly representable and parsed exactly.
+    #[hegel::test]
+    fn prop_operator_precedence_matches_oracle(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().min_value(2).max_value(6));
+        let mut leaves = Vec::with_capacity(n);
+        for _ in 0..n {
+            leaves.push(
+                tc.draw(generators::integers::<u32>().max_value(1_000_000)) as f64,
+            );
+        }
+        let mut ops = Vec::with_capacity(n - 1);
+        for _ in 0..n - 1 {
+            ops.push(tc.draw(generators::sampled_from(vec!['+', '-', '*', '/', '%'])));
+        }
+
+        // Render with no parentheses.
+        let mut src = format!("{:?}", leaves[0]);
+        for i in 0..ops.len() {
+            src.push(' ');
+            src.push(ops[i]);
+            src.push(' ');
+            src.push_str(&format!("{:?}", leaves[i + 1]));
+        }
+
+        // Oracle: pass 1 folds * / % left-to-right, pass 2 folds + -.
+        let mut vals = vec![leaves[0]];
+        let mut add_ops = vec![];
+        for i in 0..ops.len() {
+            match ops[i] {
+                '*' | '/' | '%' => {
+                    let last = vals.pop().unwrap();
+                    let r = leaves[i + 1];
+                    let v = match ops[i] {
+                        '*' => last * r,
+                        '/' => last / r,
+                        '%' => last % r,
+                        _ => unreachable!(),
+                    };
+                    vals.push(v);
+                }
+                _ => {
+                    add_ops.push(ops[i]);
+                    vals.push(leaves[i + 1]);
+                }
+            }
+        }
+        let mut expected = vals[0];
+        for i in 0..add_ops.len() {
+            expected = if add_ops[i] == '+' {
+                expected + vals[i + 1]
+            } else {
+                expected - vals[i + 1]
+            };
+        }
+
+        let got = eval_dyon_f64(&src).expect("well-formed arithmetic must evaluate");
+        assert!(
+            f64_eq(got, expected),
+            "`{}` => dyon {:?} vs precedence-oracle {:?}",
+            src,
+            got,
+            expected
+        );
+    }
+
+    // ---- Property 3: parenthesization equivalence --------------------------
+    // Wrapping any sub-expression in redundant parentheses must not change the
+    // result. Compares the tree rendered fully-parenthesized against the same
+    // tree rendered with no parens (which relies on dyon's precedence).
+    #[hegel::test]
+    fn prop_parenthesization_is_neutral(tc: hegel::TestCase) {
+        // Reuse the precedence structure but also produce a fully-parenthesized
+        // left-associative rendering of the same flat chain.
+        let n = tc.draw(generators::integers::<usize>().min_value(2).max_value(5));
+        let mut leaves = Vec::with_capacity(n);
+        for _ in 0..n {
+            leaves.push(tc.draw(
+                generators::floats::<f64>()
+                    .min_value(0.0)
+                    .max_value(1.0e6)
+                    .allow_nan(false)
+                    .allow_infinity(false),
+            ));
+        }
+        // Only + and - so a flat left-associative parenthesization matches the
+        // parser (same precedence level, left-assoc) without needing to model
+        // the mul/add split.
+        let mut ops = Vec::with_capacity(n - 1);
+        for _ in 0..n - 1 {
+            ops.push(tc.draw(generators::sampled_from(vec!['+', '-'])));
+        }
+
+        let mut bare = format!("{:?}", leaves[0]);
+        let mut paren = format!("{:?}", leaves[0]);
+        for i in 0..ops.len() {
+            bare = format!("{} {} {:?}", bare, ops[i], leaves[i + 1]);
+            paren = format!("({} {} {:?})", paren, ops[i], leaves[i + 1]);
+        }
+
+        let a = eval_dyon_f64(&bare).expect("bare form must evaluate");
+        let b = eval_dyon_f64(&paren).expect("paren form must evaluate");
+        assert!(f64_eq(a, b), "`{}` ({:?}) vs `{}` ({:?})", bare, a, paren, b);
+    }
+
+    // ---- Property 4: string concatenation vs Rust --------------------------
+    // dyon `a + b` on strings must equal Rust string concatenation.
+    #[hegel::test]
+    fn prop_string_concat_matches_rust(tc: hegel::TestCase) {
+        let a = tc.draw(generators::text().max_size(64));
+        let b = tc.draw(generators::text().max_size(64));
+        let mut module = Module::new();
+        load_str(
+            "prop.dyon",
+            Arc::new("g(a, b) = a + b".to_string()),
+            &mut module,
+        )
+        .expect("load");
+        let module = Arc::new(module);
+        let got = Call::new("g")
+            .arg(a.clone())
+            .arg(b.clone())
+            .run_ret::<String>(&mut Runtime::new(), &module)
+            .expect("concat must succeed");
+        let expected = format!("{}{}", a, b);
+        assert_eq!(got, expected);
+    }
+
+    // ---- Property 5: boolean logic vs Rust ---------------------------------
+    // A fully-parenthesized boolean expression (&&, ||, !) over true/false
+    // literals evaluates identically in dyon and Rust.
+    fn draw_bool_expr(tc: &hegel::TestCase, depth: u32) -> (String, bool) {
+        let leaf = depth == 0 || tc.draw(generators::booleans());
+        if leaf {
+            let b = tc.draw(generators::booleans());
+            (b.to_string(), b)
+        } else if tc.draw(generators::booleans()) {
+            let (s, v) = draw_bool_expr(tc, depth - 1);
+            (format!("!({})", s), !v)
+        } else {
+            let and = tc.draw(generators::booleans());
+            let (ls, lv) = draw_bool_expr(tc, depth - 1);
+            let (rs, rv) = draw_bool_expr(tc, depth - 1);
+            let (op, v) = if and {
+                ("&&", lv && rv)
+            } else {
+                ("||", lv || rv)
+            };
+            (format!("({} {} {})", ls, op, rs), v)
+        }
+    }
+
+    #[hegel::test]
+    fn prop_boolean_logic_matches_rust(tc: hegel::TestCase) {
+        let (src, expected) = draw_bool_expr(&tc, 4);
+        let got = eval_dyon_bool(&src).expect("boolean expr must evaluate");
+        assert_eq!(got, expected, "`{}`", src);
+    }
+
+    // ---- Property 6: run determinism ---------------------------------------
+    // Evaluating the same source twice (fresh Runtime each time) yields the
+    // same result.
+    #[hegel::test]
+    fn prop_run_is_deterministic(tc: hegel::TestCase) {
+        let (src, _) = draw_expr(&tc, 4);
+        let a = eval_dyon_f64(&src);
+        let b = eval_dyon_f64(&src);
+        match (a, b) {
+            (Ok(x), Ok(y)) => assert!(f64_eq(x, y), "`{}`: {:?} vs {:?}", src, x, y),
+            (Err(_), Err(_)) => {}
+            (x, y) => panic!("`{}` nondeterministic: {:?} vs {:?}", src, x, y),
+        }
+    }
+
+    // ---- Property 7: array indexing / bounds -------------------------------
+    // In-range integer indices return the stored element; indices at or beyond
+    // the length return an Err (never a panic). Indices are non-negative
+    // integers: fractional/negative/NaN indices have documented clamping
+    // quirks (see HEGEL_REPORT.md) that are out of scope here.
+    #[hegel::test]
+    fn prop_array_indexing_and_bounds(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let mut elems = Vec::with_capacity(n);
+        for _ in 0..n {
+            // Integer-valued elements: exactly parsed, so the stored value
+            // equals the oracle without depending on decimal-literal rounding.
+            elems.push(
+                tc.draw(generators::integers::<i32>().min_value(-1_000_000).max_value(1_000_000))
+                    as f64,
+            );
+        }
+        // index in 0..2n so roughly half are out of bounds
+        let idx = tc.draw(generators::integers::<usize>().max_value(2 * n));
+
+        let arr_src = elems
+            .iter()
+            .map(|x| format!("{:?}", x))
+            .collect::<Vec<_>>()
+            .join(", ");
+        let src = format!(
+            "fn f(i: f64) -> f64 {{\n    a := [{}]\n    return clone(a[i])\n}}",
+            arr_src
+        );
+        let mut module = Module::new();
+        load_str("prop.dyon", Arc::new(src.clone()), &mut module).expect("load");
+        let module = Arc::new(module);
+        let got = Call::new("f")
+            .arg(idx as f64)
+            .run_ret::<f64>(&mut Runtime::new(), &module);
+
+        if idx < n {
+            let got = got.expect("in-range index must succeed");
+            assert!(f64_eq(got, elems[idx]), "a[{}] => {:?}", idx, got);
+        } else {
+            assert!(
+                got.is_err(),
+                "out-of-bounds index {} (len {}) must be Err, got {:?}",
+                idx,
+                n,
+                got
+            );
+        }
+    }
+
+    // ---- KNOWN FAILURE (real bug): decimal literal parsing is not -----------
+    // ---- correctly rounded --------------------------------------------------
+    // dyon's decimal->f64 parser does not return the nearest f64 to the
+    // literal. `1.4375` is *exactly representable* in f64, yet dyon parses it
+    // to the adjacent value 1.4374999999999998; `0.3` and `3.14159` are also
+    // off by one ULP from the correctly-rounded value. Rust's f64 parser (the
+    // oracle) is guaranteed correctly-rounded, so `x.to_bits()` is the correct
+    // answer. This means a numeric literal written in a dyon program does not
+    // denote the value it appears to. Pinned as a deterministic failure per
+    // investigation policy (do NOT "fix" by loosening the comparison — the
+    // bug is in dyon's parser).
+    //
+    // All three sampled literals mis-parse, so this fails on every case.
+    #[hegel::test(test_cases = 30)]
+    #[allow(non_snake_case)]
+    fn prop_float_literal_parse_correctly_rounded_KNOWN_FAILURE(tc: hegel::TestCase) {
+        let x = tc.draw(generators::sampled_from(vec![1.4375f64, 0.3, 3.14159]));
+        let got = eval_dyon_f64(&format!("{:?}", x)).expect("literal must evaluate");
+        assert_eq!(
+            got.to_bits(),
+            x.to_bits(),
+            "literal {:?} should parse to the correctly-rounded f64 {} (bits {:#018x}), \
+             but dyon returned {} (bits {:#018x})",
+            format!("{:?}", x),
+            x,
+            x.to_bits(),
+            got,
+            got.to_bits()
+        );
+    }
+
+    // ---- Property 8: parse never panics on arbitrary text ------------------
+    // Loading arbitrary source returns Ok or Err, never panics/aborts.
+    #[hegel::test]
+    fn prop_load_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+        // Bounded size: keeps the (tiny) chance of randomly landing on deeply
+        // nested balanced parens — which hang the parser, see
+        // `nested_parens_parser_hang` — negligible.
+        let src = tc.draw(generators::text().max_size(300));
+        let mut module = Module::new();
+        let _ = load_str("fuzz.dyon", Arc::new(src), &mut module);
+    }
+
+    // ---- Property 9: parse never panics on dyon-shaped token soup ----------
+    // Random sequences of real dyon tokens/keywords, joined by spaces, must
+    // not panic the loader.
+    #[hegel::test]
+    fn prop_load_never_panics_on_token_soup(tc: hegel::TestCase) {
+        let vocab = vec![
+            "fn", "return", "if", "else", "for", "loop", "in", "break", "continue", "true",
+            "false", "(", ")", "[", "]", "{", "}", "+", "-", "*", "/", "%", "^", "&&", "||",
+            "!", "==", "!=", "<", ">", "<=", ">=", ":=", "=", ",", ".", "\"str\"", "x", "y",
+            "1", "2.5", "main", "a", "b", "->", ":",
+        ];
+        let ntoks = tc.draw(generators::integers::<usize>().max_value(40));
+        let mut toks = Vec::with_capacity(ntoks);
+        for _ in 0..ntoks {
+            toks.push(tc.draw(generators::sampled_from(vocab.clone())));
+        }
+        let src = toks.join(" ");
+        let mut module = Module::new();
+        let _ = load_str("fuzz.dyon", Arc::new(src), &mut module);
+    }
+
+    // ---- Property 10: deep nesting does not abort (bounded, safe) ----------
+    // Sweeps nesting depth upward for several recursive constructs and asserts
+    // the loader returns (Ok/Err) without panic/abort. Depth is capped in the
+    // SAFE zone: beyond it the parser hangs (exponential time), pinned by the
+    // #[ignore]d reproducers below. This property is the falsifiable, runnable
+    // portion of "deep nesting never aborts".
+    #[hegel::test]
+    fn prop_shallow_nesting_no_abort(tc: hegel::TestCase) {
+        let kind = tc.draw(generators::sampled_from(vec![
+            "paren", "block", "if", "neg", "add",
+        ]));
+        // paren nesting is exponential; keep it very shallow. Others are cheap
+        // at this depth.
+        let max_depth = if kind == "paren" { 4 } else { 6 };
+        let depth = tc.draw(generators::integers::<usize>().max_value(max_depth));
+        let src = match kind {
+            "paren" => format!("f() = {}1{}", "(".repeat(depth), ")".repeat(depth)),
+            "neg" => format!("f() = {}1", "-".repeat(depth)),
+            "add" => format!("f() = 1{}", " + 1".repeat(depth)),
+            "block" => format!(
+                "fn f() -> f64 {{ return {}1{} }}",
+                "{".repeat(depth),
+                "}".repeat(depth)
+            ),
+            "if" => {
+                let mut s = String::from("1");
+                for _ in 0..depth {
+                    s = format!("if true {{ {} }} else {{ 0 }}", s);
+                }
+                format!("fn f() -> f64 {{ return {} }}", s)
+            }
+            _ => unreachable!(),
+        };
+        let mut module = Module::new();
+        let _ = load_str("nest.dyon", Arc::new(src), &mut module);
+    }
+
+    // =======================================================================
+    // #[ignore]d reproducers for a REAL bug: the dyon parser takes
+    // exponential time on deeply nested constructs, hanging the process (no
+    // stack overflow, no panic — it just never returns). Untrusted script can
+    // therefore wedge a host that calls `load`/`run`. These are #[ignore]d
+    // because an un-ignored hang would take the whole test suite down (there
+    // is no per-test timeout). Run one explicitly to observe the hang:
+    //   cargo test --test lib -- --ignored nested_parens_parser_hang
+    // Measured: paren depth 5 ~1s, depth 6 ~9s, depth 7 did not finish in 60s.
+    // =======================================================================
+    #[test]
+    #[ignore = "KNOWN BUG: exponential-time parse of nested parens hangs the process"]
+    fn nested_parens_parser_hang() {
+        let depth = 40;
+        let src = format!("f() = {}1{}", "(".repeat(depth), ")".repeat(depth));
+        let mut module = Module::new();
+        let _ = load_str("hang.dyon", Arc::new(src), &mut module);
+    }
+
+    #[test]
+    #[ignore = "KNOWN BUG: exponential-time parse of nested blocks hangs the process"]
+    fn nested_blocks_parser_hang() {
+        let depth = 80;
+        let src = format!(
+            "fn f() -> f64 {{ return {}1{} }}",
+            "{".repeat(depth),
+            "}".repeat(depth)
+        );
+        let mut module = Module::new();
+        let _ = load_str("hang.dyon", Arc::new(src), &mut module);
+    }
+
+    #[test]
+    #[ignore = "KNOWN BUG: exponential-time parse of nested if/else hangs the process"]
+    fn nested_if_parser_hang() {
+        let depth = 80;
+        let mut s = String::from("1");
+        for _ in 0..depth {
+            s = format!("if true {{ {} }} else {{ 0 }}", s);
+        }
+        let src = format!("fn f() -> f64 {{ return {} }}", s);
+        let mut module = Module::new();
+        let _ = load_str("hang.dyon", Arc::new(src), &mut module);
+    }
+}
