+
+    // ===== hegel property-based tests =====
+
+    use core::net::{Ipv4Addr, Ipv6Addr};
+
+    use hegel::generators;
+
+    use crate::rr::DNSClass;
+    use crate::rr::rdata::{CNAME, MX, NS, PTR, SOA, SRV, TXT};
+
+    /// A wire-format name: labels are 8-bit clean, and every name read off the wire
+    /// is fully qualified.
+    #[hegel::composite]
+    fn wire_name(tc: hegel::TestCase) -> Name {
+        let labels: Vec<Vec<u8>> = tc.draw(generators::vecs(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(1)
+                .max_size(63),
+        )
+        .max_size(8));
+        let mut name = Name::new();
+        for label in labels {
+            match name.clone().append_label(label.as_slice()) {
+                Ok(extended) => name = extended,
+                Err(_) => break, // reached the 255-octet name limit
+            }
+        }
+        name.set_fqdn(true);
+        name
+    }
+
+    /// RData spanning address, name-bearing (compressible), text, and multi-field
+    /// record types.
+    #[hegel::composite]
+    fn arbitrary_rdata(tc: hegel::TestCase) -> RData {
+        match tc.draw(generators::integers::<u8>().max_value(8)) {
+            0 => RData::A(Ipv4Addr::from(tc.draw(generators::integers::<u32>())).into()),
+            1 => RData::AAAA(Ipv6Addr::from(tc.draw(generators::integers::<u128>())).into()),
+            2 => RData::CNAME(CNAME(tc.draw(wire_name()))),
+            3 => RData::NS(NS(tc.draw(wire_name()))),
+            4 => RData::PTR(PTR(tc.draw(wire_name()))),
+            5 => RData::MX(MX::new(
+                tc.draw(generators::integers::<u16>()),
+                tc.draw(wire_name()),
+            )),
+            6 => RData::TXT(TXT::new(tc.draw(
+                // Each character-string is at most 255 bytes on the wire; 60 chars of
+                // up-to-4-byte UTF-8 stays within that contract. RFC 1035 defines
+                // TXT-DATA as "one or more <character-string>s", hence min_size(1):
+                // an empty TXT encodes as a zero-length RDATA, which the decoder
+                // rejects as InvalidEmptyRecord outside of UPDATE messages.
+                generators::vecs(generators::text().max_size(60))
+                    .min_size(1)
+                    .max_size(4),
+            ))),
+            7 => RData::SRV(SRV::new(
+                tc.draw(generators::integers::<u16>()),
+                tc.draw(generators::integers::<u16>()),
+                tc.draw(generators::integers::<u16>()),
+                tc.draw(wire_name()),
+            )),
+            _ => RData::SOA(SOA::new(
+                tc.draw(wire_name()),
+                tc.draw(wire_name()),
+                tc.draw(generators::integers::<u32>()),
+                tc.draw(generators::integers::<i32>()),
+                tc.draw(generators::integers::<i32>()),
+                tc.draw(generators::integers::<i32>()),
+                tc.draw(generators::integers::<u32>()),
+            )),
+        }
+    }
+
+    #[hegel::composite]
+    fn arbitrary_record(tc: hegel::TestCase) -> Record {
+        let mut record = Record::from_rdata(
+            tc.draw(wire_name()),
+            tc.draw(generators::integers::<u32>()),
+            tc.draw(arbitrary_rdata()),
+        );
+        record.dns_class = tc.draw(generators::sampled_from(vec![
+            DNSClass::IN,
+            DNSClass::CH,
+            DNSClass::HS,
+        ]));
+        record
+    }
+
+    #[hegel::composite]
+    fn arbitrary_query(tc: hegel::TestCase) -> Query {
+        let mut query = Query::new(
+            tc.draw(wire_name()),
+            // From<u16> and Into<u16> are inverses for every record type code
+            RecordType::from(tc.draw(generators::integers::<u16>())),
+        );
+        query.query_class = tc.draw(generators::sampled_from(vec![
+            DNSClass::IN,
+            DNSClass::CH,
+            DNSClass::HS,
+            DNSClass::NONE,
+            DNSClass::ANY,
+        ]));
+        query
+    }
+
+    #[hegel::composite]
+    fn arbitrary_message(tc: hegel::TestCase) -> Message {
+        let mut metadata = Metadata::new(
+            tc.draw(generators::integers::<u16>()),
+            if tc.draw(generators::booleans()) {
+                MessageType::Query
+            } else {
+                MessageType::Response
+            },
+            // the OPCODE field is 4 bits; OpCode::from_u8 is the inverse of
+            // From<OpCode> for u8 on this range
+            OpCode::from_u8(tc.draw(generators::integers::<u8>().max_value(15))),
+        );
+        metadata.authoritative = tc.draw(generators::booleans());
+        metadata.truncation = tc.draw(generators::booleans());
+        metadata.recursion_desired = tc.draw(generators::booleans());
+        metadata.recursion_available = tc.draw(generators::booleans());
+        metadata.authentic_data = tc.draw(generators::booleans());
+        metadata.checking_disabled = tc.draw(generators::booleans());
+        // the RCODE field is 4 bits; codes >= 16 require an EDNS OPT record (see
+        // emit_message_parts), which this message does not carry
+        metadata.response_code =
+            ResponseCode::from(0, tc.draw(generators::integers::<u8>().max_value(15)));
+
+        Message {
+            metadata,
+            queries: tc.draw(generators::vecs(arbitrary_query()).max_size(4)),
+            answers: tc.draw(generators::vecs(arbitrary_record()).max_size(4)),
+            authorities: tc.draw(generators::vecs(arbitrary_record()).max_size(4)),
+            additionals: tc.draw(generators::vecs(arbitrary_record()).max_size(4)),
+            signature: None,
+            edns: None,
+        }
+    }
+
+    /// Property: a structurally valid Message encodes and decodes back to itself.
+    ///
+    /// Evidence: `test_emit_and_read_*` above check this for fixed messages, and the
+    /// repository's `fuzz/fuzz_targets/message.rs` asserts the same round-trip
+    /// starting from arbitrary decodable bytes.
+    #[hegel::test]
+    fn hegel_message_roundtrip(tc: hegel::TestCase) {
+        let message = tc.draw(arbitrary_message());
+        let bytes = message.to_vec().expect("valid message should encode");
+        let decoded = Message::from_vec(&bytes).expect("encoded message should decode");
+        assert_eq!(decoded, message);
+    }
+
+    /// Property: `Message::from_vec` never panics — neither on arbitrary bytes nor on
+    /// corruptions/truncations of a valid encoded message.
+    ///
+    /// Evidence: both fuzz targets in `fuzz/fuzz_targets/` feed arbitrary bytes to
+    /// message decoding; `rdata_zero_roundtrip` and `nsec_deserialization` above are
+    /// fixed regression cases for hostile inputs.
+    #[hegel::test]
+    fn hegel_message_from_vec_never_panics(tc: hegel::TestCase) {
+        let mut bytes = if tc.draw(generators::booleans()) {
+            tc.draw(generators::binary())
+        } else {
+            // corrupt a valid message: decoders often only crash on inputs that are
+            // mostly well-formed
+            tc.draw(arbitrary_message()).to_vec().unwrap_or_default()
+        };
+        if !bytes.is_empty() {
+            let corruptions = tc.draw(generators::integers::<usize>().max_value(4));
+            for _ in 0..corruptions {
+                let idx = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+                bytes[idx] = tc.draw(generators::integers::<u8>());
+            }
+            if tc.draw(generators::booleans()) {
+                let new_len = tc.draw(generators::integers::<usize>().max_value(bytes.len()));
+                bytes.truncate(new_len);
+            }
+        }
+        let _ = Message::from_vec(&bytes); // must return Ok or Err, never panic
+    }
 }
