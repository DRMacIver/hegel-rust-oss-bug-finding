+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+/// Generates a single OID arc, boosting the base-128 continuation boundaries
+/// (127/128, 16383/16384, ...) alongside uniform draws.
+#[hegel::composite]
+fn oid_arcs(tc: hegel::TestCase) -> u64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u64>().max_value(300),
+        generators::integers::<u64>(),
+        generators::sampled_from(vec![
+            127u64,
+            128,
+            16383,
+            16384,
+            2097151,
+            2097152,
+            u64::from(u32::MAX),
+            u64::MAX,
+        ]),
+    ))
+}
+
+/// Generates a valid dotted OID string: first arc in {0,1,2}, second arc
+/// < 40 unless the first arc is 2 (covering the 40*X+Y first-octet packing
+/// boundary), then up to 4 arbitrary arcs. Sizes are kept within the
+/// crate's 63-byte DER buffer.
+#[hegel::composite]
+fn oid_strings(tc: hegel::TestCase) -> String {
+    let first = tc.draw(generators::integers::<u64>().max_value(2));
+    let second = if first < 2 {
+        tc.draw(generators::integers::<u64>().max_value(39))
+    } else {
+        tc.draw(oid_arcs())
+    };
+    let num_rest = tc.draw(generators::integers::<usize>().max_value(4));
+    let mut s = format!("{first}.{second}");
+    for _ in 0..num_rest {
+        s.push('.');
+        s.push_str(&tc.draw(oid_arcs()).to_string());
+    }
+    s
+}
+
+/// Property: `from_string` → `to_string` is the identity for any valid
+/// dotted OID string.
+#[hegel::test]
+fn test_oid_string_roundtrip_property(tc: hegel::TestCase) {
+    let s = tc.draw(oid_strings());
+    let oid = asn1::ObjectIdentifier::from_string(&s).unwrap();
+    assert_eq!(oid.to_string(), s);
+}
+
+/// Property: DER write→parse is the identity for any valid OID.
+#[hegel::test]
+fn test_oid_der_roundtrip_property(tc: hegel::TestCase) {
+    let s = tc.draw(oid_strings());
+    let oid = asn1::ObjectIdentifier::from_string(&s).unwrap();
+    let der = asn1::write_single(&oid).unwrap();
+    let parsed = asn1::parse_single::<asn1::ObjectIdentifier>(&der).unwrap();
+    assert_eq!(parsed, oid);
+    // from_der on the raw contents must agree as well.
+    assert_eq!(asn1::ObjectIdentifier::from_der(oid.as_der()).unwrap(), oid);
+}
+
