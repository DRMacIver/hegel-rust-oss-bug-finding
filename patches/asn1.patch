+/// Generates an arbitrary valid `DateTime` with the year in
+/// `[min_year, max_year]`.
+#[hegel::composite]
+fn datetimes(tc: hegel::TestCase, min_year: u16, max_year: u16) -> asn1::DateTime {
+    let year = tc.draw(
+        generators::integers::<u16>()
+            .min_value(min_year)
+            .max_value(max_year),
+    );
+    let month = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+    let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+    let max_day = match month {
+        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+        4 | 6 | 9 | 11 => 30,
+        _ => {
+            if leap {
+                29
+            } else {
+                28
+            }
+        }
+    };
+    let day = tc.draw(generators::integers::<u8>().min_value(1).max_value(max_day));
+    let hour = tc.draw(generators::integers::<u8>().max_value(23));
+    let minute = tc.draw(generators::integers::<u8>().max_value(59));
+    let second = tc.draw(generators::integers::<u8>().max_value(59));
+    asn1::DateTime::new(year, month, day, hour, minute, second).unwrap()
+}
