+/// Property (oracle): `BigInt::bit_length` and `BigInt::is_negative` agree
+/// with values computed directly from an `i128` (bit length of the
+/// magnitude; 0 for 0), for the full `i128` range including MIN/MAX and
+/// powers of two.
+#[hegel::test]
+fn test_bigint_bit_length_oracle(tc: hegel::TestCase) {
+    // Mix uniform draws with exact powers of two (and neighbors): the
+    // negative power-of-two correction in `bigint_bit_length` is only
+    // exercised by such values.
+    let v: i128 = tc.draw(hegel::one_of!(
+        generators::integers::<i128>(),
+        hegel::compose!(|tc| {
+            let shift = tc.draw(generators::integers::<u32>().max_value(126));
+            let base = 1i128 << shift;
+            let offset = tc.draw(generators::integers::<i128>().min_value(-1).max_value(1));
+            let negate = tc.draw(generators::booleans());
+            let v = base.wrapping_add(offset);
+            if negate {
+                v.wrapping_neg()
+            } else {
+                v
+            }
+        }),
+    ));
+    let data = minimal_signed_be(v);
+    let expected_bits = (128 - v.unsigned_abs().leading_zeros()) as usize;
+
+    let bi = asn1::OwnedBigInt::new(data).unwrap();
+    assert_eq!(bi.bit_length(), expected_bits, "value: {v}");
+    assert_eq!(bi.is_negative(), v < 0, "value: {v}");
+}
