+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+/// Property: write→parse is the identity for `i64` over the full range.
+#[hegel::test]
+fn test_i64_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i64>());
+    assert_roundtrips::<i64>(v);
+}
+
+/// Property: write→parse is the identity for `u64` over the full range
+/// (covers the 0x00 pad byte for values with the high bit set).
+#[hegel::test]
+fn test_u64_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<u64>());
+    assert_roundtrips::<u64>(v);
+}
+
+/// Independently computes the DER header (tag + length octets) for a
+/// primitive TLV, per X.690: short form for lengths < 128, otherwise
+/// 0x80|n followed by the minimal big-endian length bytes.
+fn expected_der_header(tag: u8, len: usize) -> Vec<u8> {
+    let mut header = vec![tag];
+    if len < 128 {
+        header.push(len as u8);
+    } else {
+        let be = len.to_be_bytes();
+        let start = be.iter().position(|&b| b != 0).unwrap();
+        header.push(0x80 | (be.len() - start) as u8);
+        header.extend_from_slice(&be[start..]);
+    }
+    header
+}
+
+/// Property: OCTET STRING write→parse is the identity for content lengths
+/// across the length-encoding boundaries (127/128/255/256/65535/65536/...),
+/// and the writer emits the spec-mandated minimal length encoding.
+#[hegel::test]
+fn test_octet_string_length_boundaries(tc: hegel::TestCase) {
+    let n: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().max_value(300),
+        generators::sampled_from(vec![
+            126usize, 127, 128, 129, 255, 256, 257, 65534, 65535, 65536, 65537, 16777215, 16777216,
+        ]),
+    ));
+    let byte = tc.draw(generators::integers::<u8>());
+    let data = vec![byte; n];
+
+    let encoded = asn1::write_single(&data.as_slice()).unwrap();
+
+    let header = expected_der_header(0x04, n);
+    assert_eq!(&encoded[..header.len()], &header);
+    assert_eq!(&encoded[header.len()..], &data);
+
+    let parsed = asn1::parse_single::<&[u8]>(&encoded).unwrap();
+    assert_eq!(parsed, &data);
+}
