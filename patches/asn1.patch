+/// Property (validation/rejection): an INTEGER whose contents are padded
+/// with a redundant leading 0x00/0xff byte is not minimally encoded and
+/// must be rejected by the parser.
+#[hegel::test]
+fn test_padded_integer_rejected(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i64>());
+    let encoded = asn1::write_single(&v).unwrap();
+    // i64 contents are at most 8 bytes, so the length is always short form.
+    let contents = &encoded[2..];
+    let pad: u8 = if contents[0] & 0x80 == 0x80 { 0xff } else { 0x00 };
+
+    let mut bad = vec![0x02, (contents.len() + 1) as u8, pad];
+    bad.extend_from_slice(contents);
+
+    let err = asn1::parse_single::<i64>(&bad).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+    // The same non-minimal contents must also be rejected by the bignum types.
+    let err = asn1::parse_single::<asn1::BigInt<'_>>(&bad).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+}
