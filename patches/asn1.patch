+/// Property: `SetOfWriter` write→`SetOf` parse yields the same multiset of
+/// values, and the parsed iteration order is sorted by DER encoding
+/// (the SET OF canonical order).
+#[hegel::test]
+fn test_set_of_roundtrip_property(tc: hegel::TestCase) {
+    let vals: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(50));
+    let encoded = asn1::write_single(&asn1::SetOfWriter::new(vals.as_slice())).unwrap();
+    let parsed: Vec<i64> = asn1::parse_single::<asn1::SetOf<'_, i64>>(&encoded)
+        .unwrap()
+        .collect();
+
+    let mut expected = vals.clone();
+    expected.sort_unstable();
+    let mut actual = parsed.clone();
+    actual.sort_unstable();
+    assert_eq!(actual, expected);
+
+    for pair in parsed.windows(2) {
+        let e0 = asn1::write_single(&pair[0]).unwrap();
+        let e1 = asn1::write_single(&pair[1]).unwrap();
+        assert!(e0 <= e1, "SET OF elements not in DER order: {pair:?}");
+    }
+}
