+/// Independently computes the minimal DER INTEGER contents encoding of a
+/// signed value.
+fn minimal_signed_be(v: i128) -> Vec<u8> {
+    let mut out = v.to_be_bytes().to_vec();
+    while out.len() > 1
+        && ((out[0] == 0x00 && out[1] & 0x80 == 0) || (out[0] == 0xff && out[1] & 0x80 == 0x80))
+    {
+        out.remove(0);
+    }
+    out
+}
+
+/// Independently computes the minimal DER INTEGER contents encoding of an
+/// unsigned value (with the 0x00 disambiguation byte when needed).
+fn minimal_unsigned_be(v: u128) -> Vec<u8> {
+    let mut out = v.to_be_bytes().to_vec();
+    while out.len() > 1 && out[0] == 0x00 {
+        out.remove(0);
+    }
+    if out[0] & 0x80 == 0x80 {
+        out.insert(0, 0x00);
+    }
+    out
+}
