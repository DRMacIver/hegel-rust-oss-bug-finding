+// Hegel property-based tests.
+//
+// glam selects a SIMD backend (NEON/SSE2/WASM) or a scalar backend per type:
+// `Vec3` always uses scalar `f32` storage while `Vec3A` uses the SIMD backend
+// when available, so comparing them on identical inputs is a direct
+// SIMD-vs-scalar differential within a single build. `DVec3` (always scalar
+// f64) additionally serves as a higher-precision oracle for the f32 math.
+#[cfg(not(target_family = "wasm"))]
+mod hegel_props {
+    use glam::{Vec3, Vec3A};
+    use hegel::generators;
+
+    /// Finite f32 with |x| <= 1e18 so that squares and pairwise products stay
+    /// well below f32::MAX. This bound protects the tolerance analysis of the
+    /// differential properties (no intermediate overflow on either side), not
+    /// a library contract; `hegel_vec3_normalize_family_contract` below covers
+    /// the full range including huge, subnormal and non-finite values.
+    fn bounded_component(tc: &hegel::TestCase) -> f32 {
+        tc.draw(generators::floats::<f32>().min_value(-1e18).max_value(1e18))
+    }
+
+    fn bounded_triple(tc: &hegel::TestCase) -> [f32; 3] {
+        [
+            bounded_component(tc),
+            bounded_component(tc),
+            bounded_component(tc),
+        ]
+    }
+
+    // Property: for lane-wise operations with no reassociation freedom
+    // (IEEE-defined per-lane results), the SIMD-backed Vec3A must agree
+    // exactly with the scalar Vec3.
+    #[hegel::test]
+    fn hegel_vec3_vec3a_lanewise_ops_agree_exactly(tc: hegel::TestCase) {
+        let a = bounded_triple(&tc);
+        let b = bounded_triple(&tc);
+        let (v, w) = (Vec3::from_array(a), Vec3::from_array(b));
+        let (va, wa) = (Vec3A::from_array(a), Vec3A::from_array(b));
+
+        assert_eq!((v + w).to_array(), (va + wa).to_array());
+        assert_eq!((v - w).to_array(), (va - wa).to_array());
+        assert_eq!((v * w).to_array(), (va * wa).to_array());
+        assert_eq!(v.min(w).to_array(), va.min(wa).to_array());
+        assert_eq!(v.max(w).to_array(), va.max(wa).to_array());
+        assert_eq!(v.abs().to_array(), va.abs().to_array());
+        assert_eq!((-v).to_array(), (-va).to_array());
+    }
+
+    // Property: dot, cross and length of both the scalar Vec3 and the
+    // SIMD Vec3A agree with a higher-precision f64 oracle (DVec3) within a
+    // tolerance calibrated to the magnitude of the intermediate products.
+    #[hegel::test]
+    fn hegel_vec3_and_vec3a_match_f64_oracle(tc: hegel::TestCase) {
+        let a = bounded_triple(&tc);
+        let b = bounded_triple(&tc);
+        let (v, w) = (Vec3::from_array(a), Vec3::from_array(b));
+        let (va, wa) = (Vec3A::from_array(a), Vec3A::from_array(b));
+        let (dv, dw) = (v.as_dvec3(), w.as_dvec3());
+
+        // dot: |err| <= K * eps * sum(|a_i * b_i|)
+        let dot64 = dv.dot(dw);
+        let dot_scale: f64 = dv
+            .to_array()
+            .iter()
+            .zip(dw.to_array().iter())
+            .map(|(x, y)| (x * y).abs())
+            .sum();
+        let dot_tol = 8.0 * f32::EPSILON as f64 * dot_scale + f32::MIN_POSITIVE as f64;
+        assert!(
+            (v.dot(w) as f64 - dot64).abs() <= dot_tol,
+            "Vec3 dot {} vs f64 oracle {} (tol {})",
+            v.dot(w),
+            dot64,
+            dot_tol
+        );
+        assert!(
+            (va.dot(wa) as f64 - dot64).abs() <= dot_tol,
+            "Vec3A dot {} vs f64 oracle {} (tol {})",
+            va.dot(wa),
+            dot64,
+            dot_tol
+        );
+
+        // cross: per component |err| <= K * eps * (|a_j*b_k| + |a_k*b_j|)
+        let cross64 = dv.cross(dw).to_array();
+        let cross32 = v.cross(w).to_array();
+        let cross32a = va.cross(wa).to_array();
+        let idx = [(1usize, 2usize), (2, 0), (0, 1)];
+        let a64 = dv.to_array();
+        let b64 = dw.to_array();
+        for c in 0..3 {
+            let (j, k) = idx[c];
+            let scale = (a64[j] * b64[k]).abs() + (a64[k] * b64[j]).abs();
+            let tol = 8.0 * f32::EPSILON as f64 * scale + f32::MIN_POSITIVE as f64;
+            assert!(
+                (cross32[c] as f64 - cross64[c]).abs() <= tol,
+                "Vec3 cross[{}] = {} vs f64 oracle {} (tol {})",
+                c,
+                cross32[c],
+                cross64[c],
+                tol
+            );
+            assert!(
+                (cross32a[c] as f64 - cross64[c]).abs() <= tol,
+                "Vec3A cross[{}] = {} vs f64 oracle {} (tol {})",
+                c,
+                cross32a[c],
+                cross64[c],
+                tol
+            );
+        }
+
+        // length: |err| <= K * eps * length, plus an absolute term for the
+        // subnormal regime: when length_squared lands in the f32 subnormal
+        // range its quantization error is amplified by the square root, with
+        // absolute error bounded by ~sqrt(min_subnormal) = sqrt(1.4e-45).
+        let len64 = dv.length();
+        let len_tol = 8.0 * f32::EPSILON as f64 * len64 + 4e-23;
+        assert!(
+            (v.length() as f64 - len64).abs() <= len_tol,
+            "Vec3 length {} vs f64 oracle {} (tol {})",
+            v.length(),
+            len64,
+            len_tol
+        );
+        assert!(
+            (va.length() as f64 - len64).abs() <= len_tol,
+            "Vec3A length {} vs f64 oracle {} (tol {})",
+            va.length(),
+            len64,
+            len_tol
+        );
+    }
+
+    /// A whole vector drawn from one magnitude class, so that the boundary
+    /// classes (length_squared underflowing to a subnormal/zero, or
+    /// overflowing to +inf) are actually reached — independent per-component
+    /// draws almost never put all three components in the same extreme class.
+    /// Classes: any float (incl. NaN/inf), tiny, and huge magnitudes.
+    fn extreme_triple(tc: &hegel::TestCase) -> [f32; 3] {
+        let class: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+        let draw = || match class {
+            0 => tc.draw(generators::floats::<f32>()),
+            1 => tc.draw(generators::floats::<f32>().min_value(-1e-18).max_value(1e-18)),
+            _ => tc.draw(hegel::one_of!(
+                generators::floats::<f32>().min_value(1e18).max_value(f32::MAX),
+                generators::floats::<f32>().min_value(f32::MIN).max_value(-1e18),
+            )),
+        };
+        [draw(), draw(), draw()]
+    }
+
+    // KNOWN FAILURE: pins a real contract violation found by
+    // hegel_vec3_normalize_family_contract below.
+    //
+    // Vec3::try_normalize documents: "Returns `self` normalized to length 1.0
+    // if possible, else returns `None`. In particular, if the input is zero
+    // (or very close to zero), or non-finite, the result of this operation
+    // will be `None`."
+    //
+    // For vectors whose length_squared lands in the subnormal range,
+    // `length_recip()` is finite and positive, so try_normalize returns
+    // `Some(..)`, but the subnormal rounding of length_squared makes the
+    // result far from unit length: try_normalize(vec3(4e-23, 0.0, 0.0))
+    // returns Some(v) with v.length() ≈ 1.0685 (is_normalized() threshold is
+    // ~1e-4). Deterministic input, fails on every run.
+    #[test]
+    fn hegel_pin_vec3_try_normalize_subnormal_length_not_unit() {
+        let v = Vec3::new(4e-23, 0.0, 0.0);
+        match v.try_normalize() {
+            None => {} // also acceptable per the documentation
+            Some(n) => assert!(
+                n.is_normalized(),
+                "Vec3::try_normalize({:?}) returned Some({:?}) with length {}, \
+                 which is neither None nor unit length",
+                v,
+                n,
+                n.length()
+            ),
+        }
+    }
+
+    // Property (documented contract of try_normalize / normalize_or_zero):
+    // for *any* input, try_normalize returns None or a unit-length vector,
+    // and normalize_or_zero returns zero or a unit-length vector.
+    // "Unit-length" uses glam's own documented `is_normalized` threshold.
+    #[hegel::test]
+    fn hegel_vec3_normalize_family_contract(tc: hegel::TestCase) {
+        let a = extreme_triple(&tc);
+        let v = Vec3::from_array(a);
+        let va = Vec3A::from_array(a);
+
+        // Exclude the known-buggy region pinned by
+        // hegel_pin_vec3_try_normalize_subnormal_length_not_unit: when
+        // length_squared falls near/below the f32 subnormal range the result
+        // of try_normalize is Some(..) but not unit length. Everything else
+        // (zero, huge, non-finite, ordinary vectors) is still checked here.
+        let ls64: f64 = a.iter().map(|&x| (x as f64) * (x as f64)).sum();
+        tc.assume(!(ls64 > 0.0 && ls64 < 1e-37));
+
+        if let Some(n) = v.try_normalize() {
+            assert!(
+                n.is_normalized(),
+                "Vec3::try_normalize({:?}) returned Some({:?}) with length {}",
+                v,
+                n,
+                n.length()
+            );
+        }
+        if let Some(n) = va.try_normalize() {
+            assert!(
+                n.is_normalized(),
+                "Vec3A::try_normalize({:?}) returned Some({:?}) with length {}",
+                va,
+                n,
+                n.length()
+            );
+        }
+
+        let nz = v.normalize_or_zero();
+        assert!(
+            nz == Vec3::ZERO || nz.is_normalized(),
+            "Vec3::normalize_or_zero({:?}) returned {:?} with length {}",
+            v,
+            nz,
+            nz.length()
+        );
+    }
+}
diff --git a/tests/vec4.rs b/tests/vec4.rs
index ac16aef..a9f0098 100644
--- a/tests/vec4.rs
+++ b/tests/vec4.rs
@@ -2959,3 +2959,99 @@ mod usizevec4 {
     impl_vec4_scalar_bit_op_tests!(USizeVec4, 0, 2);
     impl_vec4_bit_op_tests!(USizeVec4, 0, 2);
 }
+
+// Hegel property-based tests.
+//
+// `Vec4` is backed by the SIMD backend (NEON/SSE2/WASM) when available. There
+// is no scalar twin type in the same build, so the oracle here is a
+// hand-written scalar reference computed from the components (the
+// fast-path-vs-generic pattern), plus `DVec4` as a higher-precision oracle.
+#[cfg(not(target_family = "wasm"))]
+mod hegel_props {
+    use glam::Vec4;
+    use hegel::generators;
+
+    /// Finite f32 with |x| <= 1e18 so squares and pairwise products cannot
+    /// overflow. This bound protects the tolerance analysis of the property
+    /// (no intermediate overflow in oracle or subject), not a library
+    /// contract.
+    fn bounded_component(tc: &hegel::TestCase) -> f32 {
+        tc.draw(generators::floats::<f32>().min_value(-1e18).max_value(1e18))
+    }
+
+    fn bounded_quad(tc: &hegel::TestCase) -> [f32; 4] {
+        [
+            bounded_component(tc),
+            bounded_component(tc),
+            bounded_component(tc),
+            bounded_component(tc),
+        ]
+    }
+
+    // Property: SIMD-backed Vec4 lane-wise ops agree exactly with a
+    // hand-written scalar reference on the components (IEEE per-lane ops
+    // have no reassociation freedom).
+    #[hegel::test]
+    fn hegel_vec4_lanewise_ops_match_scalar_reference(tc: hegel::TestCase) {
+        let a = bounded_quad(&tc);
+        let b = bounded_quad(&tc);
+        let (v, w) = (Vec4::from_array(a), Vec4::from_array(b));
+
+        let zip = |f: fn(f32, f32) -> f32| {
+            [f(a[0], b[0]), f(a[1], b[1]), f(a[2], b[2]), f(a[3], b[3])]
+        };
+        assert_eq!((v + w).to_array(), zip(|x, y| x + y));
+        assert_eq!((v - w).to_array(), zip(|x, y| x - y));
+        assert_eq!((v * w).to_array(), zip(|x, y| x * y));
+        assert_eq!(v.min(w).to_array(), zip(f32::min));
+        assert_eq!(v.max(w).to_array(), zip(f32::max));
+        assert_eq!(v.abs().to_array(), a.map(f32::abs));
+    }
+
+    // Property: Vec4 dot and length agree with the f64 oracle (DVec4) within
+    // a tolerance calibrated to the magnitude of the intermediate products.
+    // This catches SIMD reduction-order divergence beyond a few ULP.
+    #[hegel::test]
+    fn hegel_vec4_dot_length_match_f64_oracle(tc: hegel::TestCase) {
+        let a = bounded_quad(&tc);
+        let b = bounded_quad(&tc);
+        let (v, w) = (Vec4::from_array(a), Vec4::from_array(b));
+        let (dv, dw) = (v.as_dvec4(), w.as_dvec4());
+
+        let dot64 = dv.dot(dw);
+        let dot_scale: f64 = dv
+            .to_array()
+            .iter()
+            .zip(dw.to_array().iter())
+            .map(|(x, y)| (x * y).abs())
+            .sum();
+        let dot_tol = 8.0 * f32::EPSILON as f64 * dot_scale + f32::MIN_POSITIVE as f64;
+        assert!(
+            (v.dot(w) as f64 - dot64).abs() <= dot_tol,
+            "Vec4 dot {} vs f64 oracle {} (tol {})",
+            v.dot(w),
+            dot64,
+            dot_tol
+        );
+
+        // Absolute term 4e-23 covers the subnormal regime: when
+        // length_squared lands in the f32 subnormal range its quantization
+        // error is amplified by the square root, with absolute error bounded
+        // by ~sqrt(min_subnormal) = sqrt(1.4e-45).
+        let len64 = dv.length();
+        let len_tol = 8.0 * f32::EPSILON as f64 * len64 + 4e-23;
+        assert!(
+            (v.length() as f64 - len64).abs() <= len_tol,
+            "Vec4 length {} vs f64 oracle {} (tol {})",
+            v.length(),
+            len64,
+            len_tol
+        );
+        assert!(
+            v.length_squared() == v.dot(v),
+            "Vec4 length_squared {} != dot(self, self) {}",
+            v.length_squared(),
+            v.dot(v)
+        );
+    }
+}
