+/// Hegel property-based tests for `Epoch`.
+///
+/// The existing kani harnesses (src/epoch/kani_verif.rs) are no-panic checks
+/// with structural postconditions (e.g. the resulting time scale matches);
+/// the properties below target the value-level semantics: time scale
+/// conversion round-trips (evidence: test_timescale_recip,
+/// formal_epoch_reciprocity_tdb, sofa_val_tcg, tcl_tl_round_trip), Gregorian
+/// round-trips (evidence: extreme_gregorian_print_roundtrip), string parsing
+/// robustness and Display round-trips (evidence: the serde impls and
+/// test_from_str).
+mod hegel_props {
+    use core::str::FromStr;
+    use hegel::generators::{self, Generator};
+    use hifitime::{Duration, Epoch, TimeScale, Unit, NANOSECONDS_PER_CENTURY};
+
+    fn all_scales() -> Vec<TimeScale> {
+        vec![
+            TimeScale::TAI,
+            TimeScale::TT,
+            TimeScale::ET,
+            TimeScale::TDB,
+            TimeScale::UTC,
+            TimeScale::GPST,
+            TimeScale::GST,
+            TimeScale::BDT,
+            TimeScale::QZSST,
+            TimeScale::TCG,
+            TimeScale::TCB,
+            TimeScale::TL,
+            TimeScale::TCL,
+        ]
+    }
+
+    /// IERS leap second boundaries in TAI seconds past the 1900 reference
+    /// epoch, copied from src/epoch/leap_seconds.rs (announced_by_iers only,
+    /// which is what to_time_scale uses).
+    const IERS_LEAP_TAI_S: [i64; 28] = [
+        2_272_060_800,
+        2_287_785_600,
+        2_303_683_200,
+        2_335_219_200,
+        2_366_755_200,
+        2_398_291_200,
+        2_429_913_600,
+        2_461_449_600,
+        2_492_985_600,
+        2_524_521_600,
+        2_571_782_400,
+        2_603_318_400,
+        2_634_854_400,
+        2_698_012_800,
+        2_776_982_400,
+        2_840_140_800,
+        2_871_676_800,
+        2_918_937_600,
+        2_950_473_600,
+        2_982_009_600,
+        3_029_443_200,
+        3_076_704_000,
+        3_124_137_600,
+        3_345_062_400,
+        3_439_756_800,
+        3_550_089_600,
+        3_644_697_600,
+        3_692_217_600,
+    ];
+
+    /// Draws a nanosecond count (i64 spans ±292 years around the reference
+    /// epoch, which avoids Duration saturation at the representable bounds —
+    /// conversions saturate there by design so round-trips cannot hold), with
+    /// a branch boosted to within ±2 minutes of an IERS leap second boundary.
+    #[hegel::composite]
+    fn ns_with_leap_boost(tc: hegel::TestCase) -> i64 {
+        if tc.draw(generators::booleans()) {
+            let boundary_s = tc.draw(generators::sampled_from(IERS_LEAP_TAI_S.to_vec()));
+            let delta_ns = tc.draw(
+                generators::integers::<i64>()
+                    .min_value(-120_000_000_000)
+                    .max_value(120_000_000_000),
+            );
+            boundary_s * 1_000_000_000 + delta_ns
+        } else {
+            tc.draw(generators::integers::<i64>())
+        }
+    }
+
+    /// Converting an epoch to another time scale and back returns the
+    /// original epoch: exactly for the fixed-offset scales (TAI, TT, GNSS),
+    /// within the documented tolerances for the scales that apply a
+    /// relativistic rate (TCG/TL/TCL, ~1 ns per sofa_val_tcg and
+    /// tcl_tl_round_trip) or an iterated correction (ET/TDB/TCB).
+    /// UTC is excluded here: it is covered by the two UTC-specific properties
+    /// below because of the leap-second boundary behavior.
+    #[hegel::test]
+    fn prop_epoch_timescale_roundtrip_non_utc(tc: hegel::TestCase) {
+        let scales: Vec<TimeScale> = all_scales()
+            .into_iter()
+            .filter(|ts| *ts != TimeScale::UTC)
+            .collect();
+        let from = tc.draw(generators::sampled_from(scales.clone()));
+        let to = tc.draw(generators::sampled_from(scales));
+        let ns = tc.draw(generators::integers::<i64>());
+        let e = Epoch::from_duration(Duration::from_total_nanoseconds(i128::from(ns)), from);
+        let rt = e.to_time_scale(to).to_time_scale(from);
+        let err = (rt.duration - e.duration).abs();
+        let tol_of = |ts: TimeScale| -> Duration {
+            match ts {
+                TimeScale::ET | TimeScale::TDB | TimeScale::TCB => 100 * Unit::Nanosecond,
+                TimeScale::TCG | TimeScale::TL | TimeScale::TCL => 2 * Unit::Nanosecond,
+                _ => Duration::ZERO,
+            }
+        };
+        let tol = tol_of(from).max(tol_of(to));
+        assert!(
+            err <= tol,
+            "{from:?}->{to:?}->{from:?} error {err} (tol {tol}) for epoch {e:?} ({ns} ns)"
+        );
+    }
+
+    /// Round-trip through UTC from a fixed-offset scale, boosted near leap
+    /// second boundaries.
+    ///
+    /// KNOWN FAILURE (suspected bug): TAI->UTC->TAI is off by 1 s for every
+    /// TAI epoch within [L, L + delta_at_new) of each IERS leap boundary L —
+    /// a window 10..37 s wide, much wider than the genuinely ambiguous
+    /// 23:59:60 leap second itself. Cause: the leap second table timestamps
+    /// (src/epoch/leap_seconds.rs) are "UTC seconds counted as TAI"
+    /// (2_272_060_800 is 26_297 days, i.e. the UTC calendar count of
+    /// 1972-01-01), and `to_time_scale` keys the UTC->TAI lookup with that
+    /// same convention ("Assume this is TAI"), but keys the TAI->UTC lookup
+    /// with the *true* TAI value — the two directions disagree wherever the
+    /// lookups straddle a boundary. Pinned counterexample (`just` branch
+    /// below): TAI 2_272_060_800 s (1972-01-01T00:00:00 TAI) -> UTC
+    /// 1971-12-31T23:59:50 -> TAI 1971-12-31T23:59:50 (10 s error, the full
+    /// first IERS delta_at).
+    #[hegel::test(test_cases = 200)]
+    fn prop_epoch_utc_roundtrip(tc: hegel::TestCase) {
+        let other = tc.draw(generators::sampled_from(vec![
+            TimeScale::TAI,
+            TimeScale::TT,
+            TimeScale::GPST,
+            TimeScale::GST,
+            TimeScale::BDT,
+            TimeScale::QZSST,
+        ]));
+        let ns = tc.draw(hegel::one_of!(
+            ns_with_leap_boost(),
+            // Deterministic pin of the known counterexample.
+            generators::just(2_272_060_800_000_000_000_i64),
+        ));
+        // Start from a TAI epoch so the leap boost lands near the boundaries
+        // regardless of the scale's own reference epoch; the conversion to
+        // `other` is an exact fixed offset.
+        let e = Epoch::from_duration(Duration::from_total_nanoseconds(i128::from(ns)), TimeScale::TAI)
+            .to_time_scale(other);
+        let rt = e.to_time_scale(TimeScale::UTC).to_time_scale(other);
+        let err = (rt.duration - e.duration).abs();
+        assert!(
+            err <= Duration::ZERO,
+            "{other:?}->UTC->{other:?} error {err} for epoch {e:?} ({ns} ns TAI)"
+        );
+    }
+
+    /// Sibling of prop_epoch_utc_roundtrip (KNOWN FAILURE): UTC round-trips,
+    /// in both directions, restricted to epochs more than 60 s away from
+    /// every IERS leap second boundary, i.e. excluding the known buggy
+    /// windows, so the conversion logic everywhere else keeps being tested
+    /// exactly.
+    #[hegel::test]
+    fn prop_epoch_utc_roundtrip_away_from_leap_boundaries(tc: hegel::TestCase) {
+        let other = tc.draw(generators::sampled_from(vec![
+            TimeScale::TAI,
+            TimeScale::TT,
+            TimeScale::GPST,
+            TimeScale::GST,
+            TimeScale::BDT,
+            TimeScale::QZSST,
+        ]));
+        let start_in_utc = tc.draw(generators::booleans());
+        let ns = tc.draw(ns_with_leap_boost());
+        // Exclusion of the known-buggy windows (see prop_epoch_utc_roundtrip):
+        // keep only epochs > 60 s away from every leap boundary.
+        tc.assume(
+            IERS_LEAP_TAI_S
+                .iter()
+                .all(|l| (ns - l * 1_000_000_000).abs() > 60_000_000_000),
+        );
+        let tai = Epoch::from_duration(
+            Duration::from_total_nanoseconds(i128::from(ns)),
+            TimeScale::TAI,
+        );
+        let (e, via) = if start_in_utc {
+            (tai.to_time_scale(TimeScale::UTC), other)
+        } else {
+            (tai.to_time_scale(other), TimeScale::UTC)
+        };
+        let rt = e.to_time_scale(via).to_time_scale(e.time_scale);
+        let err = (rt.duration - e.duration).abs();
+        assert!(
+            err <= Duration::ZERO,
+            "{:?}->{via:?}->{:?} error {err} for epoch {e:?} ({ns} ns TAI)",
+            e.time_scale,
+            e.time_scale
+        );
+    }
+
+    /// Gregorian round-trip: to_gregorian in the epoch's own time scale
+    /// followed by maybe_from_gregorian must return the exact same epoch
+    /// (both directions are pure integer calendar math).
+    /// Evidence: extreme_gregorian_print_roundtrip does this for hand-picked
+    /// extreme dates in TAI and UTC.
+    #[hegel::test]
+    fn prop_epoch_gregorian_roundtrip(tc: hegel::TestCase) {
+        let ts = tc.draw(generators::sampled_from(all_scales()));
+        // Stay one century inside the Duration bounds so that adding the time
+        // scale's Gregorian reference offset cannot saturate (that would break
+        // the round-trip by construction, not by a calendar bug).
+        const BOUND: i128 = 32_767 * (NANOSECONDS_PER_CENTURY as i128);
+        let total_ns = tc.draw(hegel::one_of!(
+            generators::integers::<i128>().min_value(-BOUND).max_value(BOUND),
+            generators::integers::<i64>().map(i128::from),
+        ));
+        let e = Epoch::from_duration(Duration::from_total_nanoseconds(total_ns), ts);
+        let (y, m, d, hh, mm, ss, nanos) = e.to_gregorian(ts);
+        let rebuilt = Epoch::maybe_from_gregorian(y, m, d, hh, mm, ss, nanos, ts)
+            .unwrap_or_else(|err| {
+                panic!(
+                    "to_gregorian({ts:?}) of {total_ns} ns produced invalid date \
+                     {y:04}-{m:02}-{d:02}T{hh:02}:{mm:02}:{ss:02}.{nanos:09}: {err:?}"
+                )
+            });
+        assert_eq!(
+            rebuilt.duration.to_parts(),
+            e.duration.to_parts(),
+            "gregorian roundtrip in {ts:?} failed for {total_ns} ns \
+             ({y:04}-{m:02}-{d:02}T{hh:02}:{mm:02}:{ss:02}.{nanos:09})"
+        );
+    }
+
+    /// Epoch::from_str / from_gregorian_str must never panic, whatever the
+    /// input (they return Result).
+    ///
+    /// KNOWN FAILURE (real panic bug): `Epoch::from_str` sniffs the format
+    /// with byte-index slicing (`&s[..2] == "JD"`, `&s[..3] == "MJD"`, ... in
+    /// src/epoch/mod.rs). The length guard only checks `s.len() < 7` in
+    /// *bytes*, so any string of >= 7 bytes whose byte 2 or 3 falls inside a
+    /// multi-byte character makes the slice panic ("byte index 2 is not a
+    /// char boundary"). Pinned counterexample (`just` branch below):
+    /// `"ࠀ𐀀"` (U+0800 U+10000, 7 bytes).
+    #[hegel::test(test_cases = 200)]
+    fn prop_epoch_from_str_never_panics(tc: hegel::TestCase) {
+        if tc.draw(generators::booleans()) {
+            // Deterministic pin of the known counterexample.
+            drop(Epoch::from_str("\u{0800}\u{10000}"));
+            return;
+        }
+        let s = if tc.draw(generators::booleans()) {
+            // Targeted: short strings mixing ASCII and multi-byte characters
+            // (the format sniffing slices the string by byte index).
+            let mut s = String::new();
+            for _ in 0..8 {
+                let cp = tc.draw(hegel::one_of!(
+                    generators::integers::<u32>().max_value(0x7F),
+                    generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+                ));
+                s.push(char::from_u32(cp).unwrap_or('\u{FFFD}'));
+            }
+            s
+        } else {
+            tc.draw(hegel::one_of!(
+                generators::text(),
+                generators::from_regex(
+                    r"(JD|MJD|SEC)? ?-?[0-9]{0,12}\.?[0-9]{0,6} ?(TAI|UTC|TT|TDB|ET|GPST|GST|BDT|QZSST|TCG|TCB|TL|TCL)?"
+                )
+                .fullmatch(true),
+                generators::from_regex(
+                    r"[0-9]{1,5}-[0-9]{1,2}-[0-9]{1,2}[T ][0-9:.]{0,15}Z?"
+                )
+                .fullmatch(true),
+            ))
+        };
+        drop(Epoch::from_str(&s));
+    }
+
+    /// Sibling of prop_epoch_from_str_never_panics (KNOWN FAILURE):
+    /// robustness restricted to ASCII-only inputs, where the byte-slicing
+    /// panic cannot trigger, so the rest of the parser keeps being fuzzed.
+    #[hegel::test]
+    fn prop_epoch_from_str_never_panics_ascii(tc: hegel::TestCase) {
+        let s = tc.draw(hegel::one_of!(
+            generators::from_regex(r"[ -~]{0,40}").fullmatch(true),
+            generators::from_regex(
+                r"(JD|MJD|SEC)? ?-?[0-9]{0,12}\.?[0-9]{0,6} ?(TAI|UTC|TT|TDB|ET|GPST|GST|BDT|QZSST|TCG|TCB|TL|TCL)?"
+            )
+            .fullmatch(true),
+            generators::from_regex(r"[0-9]{1,5}-[0-9]{1,2}-[0-9]{1,2}[T ][0-9:.+\-Z]{0,15}")
+                .fullmatch(true),
+        ));
+        drop(Epoch::from_str(&s));
+    }
+
+    /// Display -> from_str round-trips exactly for representable dates in the
+    /// ISO year range. Evidence: the serde impls for Epoch serialize via
+    /// to_string and deserialize via from_str; tcl_tl_round_trip and
+    /// test_timescale_recip assert the same for specific epochs.
+    #[hegel::test]
+    fn prop_epoch_display_fromstr_roundtrip(tc: hegel::TestCase) {
+        let ts = tc.draw(generators::sampled_from(all_scales()));
+        let year = tc.draw(generators::integers::<i32>().min_value(1).max_value(9999));
+        let month = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+        let day = tc.draw(generators::integers::<u8>().min_value(1).max_value(31));
+        let hour = tc.draw(generators::integers::<u8>().max_value(23));
+        let minute = tc.draw(generators::integers::<u8>().max_value(59));
+        let second = tc.draw(generators::integers::<u8>().max_value(59));
+        let nanos = tc.draw(generators::integers::<u32>().max_value(999_999_999));
+        let e = match Epoch::maybe_from_gregorian(year, month, day, hour, minute, second, nanos, ts)
+        {
+            Ok(e) => e,
+            // Only invalid day-of-month combinations are rejected here.
+            Err(_) => tc.reject(),
+        };
+        let repr = format!("{e}");
+        match Epoch::from_str(&repr) {
+            Ok(parsed) => assert_eq!(parsed, e, "{repr} parsed back as {parsed}"),
+            Err(err) => panic!("failed to parse the display of {e} ({repr}): {err:?}"),
+        }
+    }
+
+    /// to_time_of_week / from_time_of_week round-trip for non-negative epoch
+    /// durations (the week counter is unsigned).
+    #[hegel::test]
+    fn prop_epoch_time_of_week_roundtrip(tc: hegel::TestCase) {
+        let ts = tc.draw(generators::sampled_from(all_scales()));
+        let ns = tc.draw(generators::integers::<i64>().min_value(0));
+        let e = Epoch::from_duration(Duration::from_total_nanoseconds(i128::from(ns)), ts);
+        let (week, tow_ns) = e.to_time_of_week();
+        let rebuilt = Epoch::from_time_of_week(week, tow_ns, ts);
+        assert_eq!(
+            rebuilt.duration.to_parts(),
+            e.duration.to_parts(),
+            "time-of-week roundtrip failed in {ts:?} for {ns} ns (week {week}, tow {tow_ns})"
+        );
+    }
+}
