+// Property-based serde tests written with hegel (https://hegel.dev).
+#[cfg(all(feature = "serde", feature = "std", test))]
+mod hegel_serde_tests {
+    use hegel::TestCase;
+    use hegel::generators;
+    use priority_queue::PriorityQueue;
+
+    /// serde round-trip: deserializing a serialized queue yields an equal
+    /// queue whose heap is valid (drains in non-increasing priority order).
+    #[hegel::test]
+    fn serde_json_roundtrip_preserves_queue(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(200));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len()),
+        );
+
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+        }
+
+        let json = serde_json::to_string(&pq).unwrap();
+        let mut back: PriorityQueue<i32, i64> = serde_json::from_str(&json).unwrap();
+        assert_eq!(pq, back);
+
+        let mut prev: Option<i64> = None;
+        let mut count = 0;
+        while let Some((_, p)) = back.pop() {
+            if let Some(q) = prev {
+                assert!(q >= p, "deserialized heap drained out of order");
+            }
+            prev = Some(p);
+            count += 1;
+        }
+        assert_eq!(count, keys.len());
+    }
