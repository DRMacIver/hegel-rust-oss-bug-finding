+// Property-based tests written with hegel (https://hegel.dev).
+#[cfg(feature = "std")]
+#[cfg(test)]
+mod hegel_pqueue_tests {
+    use hegel::TestCase;
+    use hegel::generators;
+    use priority_queue::PriorityQueue;
+    use std::collections::HashMap;
+
+    /// Keys are drawn mostly from a small range so that operations on
+    /// existing items (priority changes, removals, duplicate pushes)
+    /// happen often, mixed with the full i32 range for breadth.
+    fn draw_key(tc: &TestCase) -> i32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i32>().min_value(0).max_value(15),
+            generators::integers::<i32>(),
+        ))
+    }
+
+    /// Stateful model test: PriorityQueue must agree with a HashMap
+    /// (item -> priority) reference model after every operation.
+    /// Ties on priority are resolved by checking the popped item against
+    /// the model instead of predicting which item wins.
+    struct PqModel {
+        pq: PriorityQueue<i32, i64>,
+        model: HashMap<i32, i64>,
+    }
+
+    #[hegel::state_machine]
+    impl PqModel {
+        #[rule]
+        fn push(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            assert_eq!(self.pq.push(k, p), self.model.insert(k, p));
+        }
+
+        #[rule]
+        fn pop(&mut self, _tc: TestCase) {
+            match self.pq.pop() {
+                None => assert!(self.model.is_empty()),
+                Some((item, prio)) => {
+                    let max = *self.model.values().max().expect("pq popped, model empty");
+                    assert_eq!(prio, max, "popped priority is not the model maximum");
+                    assert_eq!(self.model.remove(&item), Some(prio));
+                }
+            }
+        }
+
+        #[rule]
+        fn change_priority(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            let expected = self.model.get(&k).copied();
+            assert_eq!(self.pq.change_priority(&k, p), expected);
+            if expected.is_some() {
+                self.model.insert(k, p);
+            }
+        }
+
+        #[rule]
+        fn push_increase(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            let old = self.model.get(&k).copied();
+            let ret = self.pq.push_increase(k, p);
+            match old {
+                None => {
+                    assert_eq!(ret, None);
+                    self.model.insert(k, p);
+                }
+                Some(o) if p > o => {
+                    assert_eq!(ret, Some(o));
+                    self.model.insert(k, p);
+                }
+                Some(_) => assert_eq!(ret, Some(p)),
+            }
+        }
+
+        #[rule]
+        fn push_decrease(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            let old = self.model.get(&k).copied();
+            let ret = self.pq.push_decrease(k, p);
+            match old {
+                None => {
+                    assert_eq!(ret, None);
+                    self.model.insert(k, p);
+                }
+                Some(o) if p < o => {
+                    assert_eq!(ret, Some(o));
+                    self.model.insert(k, p);
+                }
+                Some(_) => assert_eq!(ret, Some(p)),
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let expected = self.model.remove(&k).map(|p| (k, p));
+            assert_eq!(self.pq.remove(&k), expected);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            assert_eq!(self.pq.get_priority(&k), self.model.get(&k));
+            assert_eq!(self.pq.get(&k), self.model.get_key_value(&k));
+            assert_eq!(self.pq.contains(&k), self.model.contains_key(&k));
+        }
+
+        #[invariant]
+        fn same_length(&self, _tc: TestCase) {
+            assert_eq!(self.pq.len(), self.model.len());
+            assert_eq!(self.pq.is_empty(), self.model.is_empty());
+        }
+
+        #[invariant]
+        fn peek_is_model_max(&self, _tc: TestCase) {
+            match self.pq.peek() {
+                None => assert!(self.model.is_empty()),
+                Some((item, &prio)) => {
+                    let max = *self.model.values().max().unwrap();
+                    assert_eq!(prio, max, "peeked priority is not the model maximum");
+                    assert_eq!(self.model.get(item), Some(&prio));
+                }
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn pq_agrees_with_hashmap_model(tc: TestCase) {
+        let machine = PqModel {
+            pq: PriorityQueue::new(),
+            model: HashMap::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    /// After an arbitrary mix of pushes and priority changes (which exercise
+    /// bubble_up/up_heapify at deep positions), fully draining the queue with
+    /// `pop` must yield priorities in non-increasing order and return every
+    /// element exactly once. Hundreds of elements force deep heaps.
+    #[hegel::test]
+    fn pop_drains_in_non_increasing_priority_order(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len()),
+        );
+
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+        }
+
+        // Change some priorities of existing items to exercise up_heapify.
+        if !keys.is_empty() {
+            let changes = tc.draw(generators::integers::<usize>().max_value(50));
+            for _ in 0..changes {
+                let idx = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+                let p = tc.draw(generators::integers::<i64>());
+                pq.change_priority(&keys[idx], p);
+            }
+        }
+
+        let mut prev: Option<i64> = None;
+        let mut count = 0;
+        while let Some((_, p)) = pq.pop() {
+            if let Some(q) = prev {
+                assert!(q >= p, "pop yielded increasing priorities: {} then {}", q, p);
+            }
+            prev = Some(p);
+            count += 1;
+        }
+        assert_eq!(count, keys.len());
+    }
+
+    /// `into_sorted_vec` must return every pushed item exactly once, ordered
+    /// from the highest associated priority to the lowest.
+    #[hegel::test]
+    fn into_sorted_vec_sorted_by_priority(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len()),
+        );
+
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        let mut expected: HashMap<i32, i64> = HashMap::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+            expected.insert(k, p);
+        }
+
+        let sorted = pq.into_sorted_vec();
+        assert_eq!(sorted.len(), expected.len());
+        let mut prev: Option<i64> = None;
+        for item in &sorted {
+            let p = *expected.get(item).expect("into_sorted_vec invented an item");
+            if let Some(q) = prev {
+                assert!(q >= p, "into_sorted_vec not sorted: {} before {}", q, p);
+            }
+            prev = Some(p);
+        }
+        let mut sorted_items = sorted.clone();
+        sorted_items.sort_unstable();
+        let mut expected_items: Vec<i32> = expected.keys().copied().collect();
+        expected_items.sort_unstable();
+        assert_eq!(sorted_items, expected_items);
+    }
+
+    /// Documented `push_increase` contract: the resulting priority is the max
+    /// of the old and offered priorities; returns None when absent, Some(old)
+    /// when increased, Some(offered) when not increased.
+    #[hegel::test]
+    fn push_increase_takes_max(tc: TestCase) {
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        let n = tc.draw(generators::integers::<usize>().max_value(50));
+        for _ in 0..n {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            pq.push(k, p);
+        }
+        let k = draw_key(&tc);
+        let p = tc.draw(generators::integers::<i64>());
+        let old = pq.get_priority(&k).copied();
+        let ret = pq.push_increase(k, p);
+        match old {
+            None => {
+                assert_eq!(ret, None);
+                assert_eq!(pq.get_priority(&k), Some(&p));
+            }
+            Some(o) => {
+                assert_eq!(pq.get_priority(&k).copied(), Some(o.max(p)));
+                if p > o {
+                    assert_eq!(ret, Some(o));
+                } else {
+                    assert_eq!(ret, Some(p));
+                }
+            }
+        }
+    }
+
+    /// Documented `push_decrease` contract: the resulting priority is the min
+    /// of the old and offered priorities; returns None when absent, Some(old)
+    /// when decreased, Some(offered) when not decreased.
+    #[hegel::test]
+    fn push_decrease_takes_min(tc: TestCase) {
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        let n = tc.draw(generators::integers::<usize>().max_value(50));
+        for _ in 0..n {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            pq.push(k, p);
+        }
+        let k = draw_key(&tc);
+        let p = tc.draw(generators::integers::<i64>());
+        let old = pq.get_priority(&k).copied();
+        let ret = pq.push_decrease(k, p);
+        match old {
+            None => {
+                assert_eq!(ret, None);
+                assert_eq!(pq.get_priority(&k), Some(&p));
+            }
+            Some(o) => {
+                assert_eq!(pq.get_priority(&k).copied(), Some(o.min(p)));
+                if p < o {
+                    assert_eq!(ret, Some(o));
+                } else {
+                    assert_eq!(ret, Some(p));
+                }
+            }
+        }
+    }
+
+    /// `iter` visits exactly the (item, priority) pairs currently in the
+    /// queue, each once (order is documented as arbitrary).
+    #[hegel::test]
+    fn iter_yields_exact_contents(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len()),
+        );
+
+        let mut pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        let mut expected: HashMap<i32, i64> = HashMap::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+            expected.insert(k, p);
+        }
+
+        let visited: Vec<(i32, i64)> = pq.iter().map(|(&k, &p)| (k, p)).collect();
+        assert_eq!(visited.len(), expected.len(), "iter repeated or skipped items");
+        let visited_map: HashMap<i32, i64> = visited.into_iter().collect();
+        assert_eq!(visited_map, expected);
+        assert_eq!(pq.len(), expected.len());
+    }
+
+    /// Building a queue with `FromIterator` (possibly with repeated items,
+    /// where the docs say the item is updated so the last pair wins) is
+    /// equivalent to pushing every pair in order, and the built queue is a
+    /// valid heap: draining it yields non-increasing priorities.
+    #[hegel::test]
+    fn from_iter_equals_push_loop(tc: TestCase) {
+        let pairs: Vec<(i32, i64)> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(300));
+            let mut v = Vec::with_capacity(n);
+            for _ in 0..n {
+                let k = draw_key(&tc);
+                let p = tc.draw(generators::integers::<i64>());
+                v.push((k, p));
+            }
+            v
+        };
+
+        let mut from_iter_pq: PriorityQueue<i32, i64> = pairs.iter().copied().collect();
+        let mut push_pq: PriorityQueue<i32, i64> = PriorityQueue::new();
+        for &(k, p) in &pairs {
+            push_pq.push(k, p);
+        }
+        assert_eq!(from_iter_pq, push_pq);
+        assert_eq!(from_iter_pq.len(), push_pq.len());
+
+        // The FromIterator-built heap must also drain in sorted order.
+        let expected_len = from_iter_pq.len();
+        let mut prev: Option<i64> = None;
+        let mut count = 0;
+        while let Some((_, p)) = from_iter_pq.pop() {
+            if let Some(q) = prev {
+                assert!(q >= p, "from_iter heap drained out of order: {} then {}", q, p);
+            }
+            prev = Some(p);
+            count += 1;
+        }
+        assert_eq!(count, expected_len);
+    }
+}
