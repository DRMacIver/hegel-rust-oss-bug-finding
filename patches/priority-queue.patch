+// Property-based tests written with hegel (https://hegel.dev).
+#[cfg(feature = "std")]
+#[cfg(test)]
+mod hegel_doublepq_tests {
+    use hegel::TestCase;
+    use hegel::generators;
+    use priority_queue::DoublePriorityQueue;
+    use std::collections::HashMap;
+
+    /// Keys are drawn mostly from a small range so that operations on
+    /// existing items (priority changes, removals, duplicate pushes)
+    /// happen often, mixed with the full i32 range for breadth.
+    fn draw_key(tc: &TestCase) -> i32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i32>().min_value(0).max_value(15),
+            generators::integers::<i32>(),
+        ))
+    }
+
+    /// Stateful model test: DoublePriorityQueue must agree with a HashMap
+    /// (item -> priority) reference model after every operation.
+    /// Ties on priority are resolved by checking the popped item against
+    /// the model instead of predicting which item wins.
+    struct DoublePqModel {
+        pq: DoublePriorityQueue<i32, i64>,
+        model: HashMap<i32, i64>,
+    }
+
+    #[hegel::state_machine]
+    impl DoublePqModel {
+        #[rule]
+        fn push(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            assert_eq!(self.pq.push(k, p), self.model.insert(k, p));
+        }
+
+        #[rule]
+        fn pop_min(&mut self, _tc: TestCase) {
+            match self.pq.pop_min() {
+                None => assert!(self.model.is_empty()),
+                Some((item, prio)) => {
+                    let min = *self.model.values().min().expect("pq popped, model empty");
+                    assert_eq!(prio, min, "pop_min priority is not the model minimum");
+                    assert_eq!(self.model.remove(&item), Some(prio));
+                }
+            }
+        }
+
+        #[rule]
+        fn pop_max(&mut self, _tc: TestCase) {
+            match self.pq.pop_max() {
+                None => assert!(self.model.is_empty()),
+                Some((item, prio)) => {
+                    let max = *self.model.values().max().expect("pq popped, model empty");
+                    assert_eq!(prio, max, "pop_max priority is not the model maximum");
+                    assert_eq!(self.model.remove(&item), Some(prio));
+                }
+            }
+        }
+
+        #[rule]
+        fn change_priority(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let p = tc.draw(generators::integers::<i64>());
+            let expected = self.model.get(&k).copied();
+            assert_eq!(self.pq.change_priority(&k, p), expected);
+            if expected.is_some() {
+                self.model.insert(k, p);
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let expected = self.model.remove(&k).map(|p| (k, p));
+            assert_eq!(self.pq.remove(&k), expected);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            assert_eq!(self.pq.get_priority(&k), self.model.get(&k));
+            assert_eq!(self.pq.get(&k), self.model.get_key_value(&k));
+            assert_eq!(self.pq.contains(&k), self.model.contains_key(&k));
+        }
+
+        #[invariant]
+        fn same_length(&self, _tc: TestCase) {
+            assert_eq!(self.pq.len(), self.model.len());
+            assert_eq!(self.pq.is_empty(), self.model.is_empty());
+        }
+
+        #[invariant]
+        fn peeks_are_model_extremes(&self, _tc: TestCase) {
+            match self.pq.peek_min() {
+                None => assert!(self.model.is_empty()),
+                Some((item, &prio)) => {
+                    let min = *self.model.values().min().unwrap();
+                    assert_eq!(prio, min, "peek_min priority is not the model minimum");
+                    assert_eq!(self.model.get(item), Some(&prio));
+                }
+            }
+            match self.pq.peek_max() {
+                None => assert!(self.model.is_empty()),
+                Some((item, &prio)) => {
+                    let max = *self.model.values().max().unwrap();
+                    assert_eq!(prio, max, "peek_max priority is not the model maximum");
+                    assert_eq!(self.model.get(item), Some(&prio));
+                }
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn double_pq_agrees_with_hashmap_model(tc: TestCase) {
+        let machine = DoublePqModel {
+            pq: DoublePriorityQueue::new(),
+            model: HashMap::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    /// Fully draining a large DoublePriorityQueue by an arbitrary
+    /// interleaving of pop_min/pop_max must always yield the current
+    /// minimum/maximum priority of the remaining elements. Hundreds of
+    /// elements force deep min-max heaps.
+    #[hegel::test]
+    fn interleaved_pop_min_pop_max_agree_with_model(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len()),
+        );
+
+        let mut pq: DoublePriorityQueue<i32, i64> = DoublePriorityQueue::new();
+        let mut model: HashMap<i32, i64> = HashMap::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+            model.insert(k, p);
+        }
+
+        // Change priorities and remove some items while the heap is deep,
+        // to exercise up_heapify/remove far from the root.
+        if !keys.is_empty() {
+            let changes = tc.draw(generators::integers::<usize>().max_value(50));
+            for _ in 0..changes {
+                let idx = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+                let k = keys[idx];
+                if tc.draw(generators::booleans()) {
+                    let p = tc.draw(generators::integers::<i64>());
+                    let expected = model.insert(k, p);
+                    if expected.is_none() {
+                        model.remove(&k);
+                    }
+                    assert_eq!(pq.change_priority(&k, p), expected);
+                } else {
+                    let expected = model.remove(&k).map(|p| (k, p));
+                    assert_eq!(pq.remove(&k), expected);
+                }
+            }
+        }
+
+        while !model.is_empty() {
+            let take_max = tc.draw(generators::booleans());
+            let (item, prio) = if take_max {
+                pq.pop_max().expect("model non-empty but pop_max was None")
+            } else {
+                pq.pop_min().expect("model non-empty but pop_min was None")
+            };
+            let expected = if take_max {
+                *model.values().max().unwrap()
+            } else {
+                *model.values().min().unwrap()
+            };
+            assert_eq!(
+                prio, expected,
+                "{} returned wrong priority",
+                if take_max { "pop_max" } else { "pop_min" }
+            );
+            assert_eq!(model.remove(&item), Some(prio));
+        }
+        assert!(pq.is_empty());
+        assert_eq!(pq.pop_min(), None);
+        assert_eq!(pq.pop_max(), None);
+    }
+
+    /// With all-distinct priorities, `into_ascending_sorted_vec` must equal
+    /// the items sorted by priority, and `into_descending_sorted_vec` must be
+    /// exactly its reverse.
+    #[hegel::test]
+    fn sorted_vecs_agree_with_reference_sort(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>())
+                .min_size(n)
+                .unique(true),
+        );
+        // Distinct priorities make the sorted order unique.
+        let prios: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>())
+                .min_size(keys.len())
+                .max_size(keys.len())
+                .unique(true),
+        );
+
+        let mut pq: DoublePriorityQueue<i32, i64> = DoublePriorityQueue::new();
+        for (&k, &p) in keys.iter().zip(&prios) {
+            pq.push(k, p);
+        }
+
+        let mut by_priority: Vec<(i64, i32)> =
+            prios.iter().zip(&keys).map(|(&p, &k)| (p, k)).collect();
+        by_priority.sort_unstable();
+        let expected_ascending: Vec<i32> = by_priority.iter().map(|&(_, k)| k).collect();
+
+        let ascending = pq.clone().into_ascending_sorted_vec();
+        assert_eq!(ascending, expected_ascending);
+
+        let mut descending = pq.into_descending_sorted_vec();
+        descending.reverse();
+        assert_eq!(descending, expected_ascending);
+    }
+}
