+#[cfg(test)]
+mod hegel_tests {
+    use crate::IpRange;
+    use hegel::generators;
+    use ipnet::{Ipv4Net, Ipv6Net};
+    use std::collections::BTreeSet;
+
+    // ---------------------------------------------------------------------
+    // Generators
+    // ---------------------------------------------------------------------
+
+    /// IPv4 addresses as u32, with the top/bottom of the address space
+    /// boosted (the sibling crate `ipnet` had saturation bugs at
+    /// 0.0.0.0/0 and 255.255.255.255/32, so those boundaries get extra
+    /// weight here).
+    #[hegel::composite]
+    fn v4_addrs(tc: hegel::TestCase) -> u32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u32>(),
+            generators::sampled_from(vec![0u32, 1, u32::MAX, u32::MAX - 1, 1u32 << 31]),
+        ))
+    }
+
+    /// Arbitrary IPv4 networks over the full address space, all prefix
+    /// lengths 0..=32. Deliberately not truncated: `IpRange` documents that
+    /// it only looks at the prefix bits, so host bits should not matter.
+    #[hegel::composite]
+    fn v4_nets(tc: hegel::TestCase) -> Ipv4Net {
+        let addr = tc.draw(v4_addrs());
+        let len = tc.draw(generators::integers::<u8>().max_value(32));
+        Ipv4Net::new(addr.into(), len).unwrap()
+    }
+
+    #[hegel::composite]
+    fn v6_addrs(tc: hegel::TestCase) -> u128 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u128>(),
+            generators::sampled_from(vec![0u128, 1, u128::MAX, u128::MAX - 1, 1u128 << 127]),
+        ))
+    }
+
+    #[hegel::composite]
+    fn v6_nets(tc: hegel::TestCase) -> Ipv6Net {
+        let addr = tc.draw(v6_addrs());
+        let len = tc.draw(generators::integers::<u8>().max_value(128));
+        Ipv6Net::new(addr.into(), len).unwrap()
+    }
+
+    fn draw_v4_net_vec(tc: &hegel::TestCase) -> Vec<Ipv4Net> {
+        tc.draw(generators::vecs(v4_nets()).max_size(16))
+    }
+
+    fn draw_v6_net_vec(tc: &hegel::TestCase) -> Vec<Ipv6Net> {
+        tc.draw(generators::vecs(v6_nets()).max_size(16))
+    }
+
+    /// Membership probes: drawn addresses plus the boundary addresses of
+    /// every involved network (network address, broadcast address, and the
+    /// addresses just outside them), plus the extremes of the space.
+    fn v4_probes(tc: &hegel::TestCase, nets: &[&[Ipv4Net]]) -> Vec<u32> {
+        let mut probes: Vec<u32> =
+            tc.draw(generators::vecs(generators::integers::<u32>()).max_size(8));
+        probes.push(0);
+        probes.push(u32::MAX);
+        for net in nets.iter().copied().flatten() {
+            let lo: u32 = net.network().into();
+            let hi: u32 = net.broadcast().into();
+            probes.extend([lo, hi, lo.wrapping_sub(1), hi.wrapping_add(1)]);
+        }
+        probes
+    }
+
+    fn v6_probes(tc: &hegel::TestCase, nets: &[&[Ipv6Net]]) -> Vec<u128> {
+        let mut probes: Vec<u128> =
+            tc.draw(generators::vecs(generators::integers::<u128>()).max_size(8));
+        probes.push(0);
+        probes.push(u128::MAX);
+        for net in nets.iter().copied().flatten() {
+            let lo: u128 = net.network().into();
+            let hi: u128 = net.broadcast().into();
+            probes.extend([lo, hi, lo.wrapping_sub(1), hi.wrapping_add(1)]);
+        }
+        probes
+    }
+
+    fn collect_v4(nets: &[Ipv4Net]) -> IpRange<Ipv4Net> {
+        nets.iter().cloned().collect()
+    }
+
+    fn collect_v6(nets: &[Ipv6Net]) -> IpRange<Ipv6Net> {
+        nets.iter().cloned().collect()
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: merge is membership-wise union (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn merge_matches_membership_union(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let merged = ra.merge(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                merged.contains(&addr),
+                ra.contains(&addr) || rb.contains(&addr),
+                "merge disagrees with union at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: intersect is membership-wise intersection (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn intersect_matches_membership_intersection(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let intersection = ra.intersect(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                intersection.contains(&addr),
+                ra.contains(&addr) && rb.contains(&addr),
+                "intersect disagrees with intersection at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: intersect commutes (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn intersect_commutes(tc: hegel::TestCase) {
+        let ra = collect_v4(&draw_v4_net_vec(&tc));
+        let rb = collect_v4(&draw_v4_net_vec(&tc));
+        assert_eq!(ra.intersect(&rb), rb.intersect(&ra));
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: exclude is membership-wise set difference (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_matches_membership_difference(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let diff = ra.exclude(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                diff.contains(&addr),
+                ra.contains(&addr) && !rb.contains(&addr),
+                "exclude disagrees with set difference at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: (universe \ B) union B == universe (IPv4 top-of-space)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_then_merge_restores_universe_v4(tc: hegel::TestCase) {
+        let nets_b = draw_v4_net_vec(&tc);
+        let rb = collect_v4(&nets_b);
+        let universe: IpRange<Ipv4Net> =
+            std::iter::once("0.0.0.0/0".parse::<Ipv4Net>().unwrap()).collect();
+        let complement = universe.exclude(&rb);
+        let restored = complement.merge(&rb);
+        assert_eq!(restored, universe);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: merge with self is identity (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn merge_self_is_identity(tc: hegel::TestCase) {
+        let r = collect_v4(&draw_v4_net_vec(&tc));
+        assert_eq!(r.merge(&r), r);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: exclude with self is empty (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_self_is_empty(tc: hegel::TestCase) {
+        let r = collect_v4(&draw_v4_net_vec(&tc));
+        let empty = r.exclude(&r);
+        assert!(empty.is_empty(), "r \\ r is not empty: {:?}", empty);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: simplify preserves membership (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn simplify_preserves_membership(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let mut range: IpRange<Ipv4Net> = IpRange::new();
+        for net in &nets {
+            range.add(*net);
+        }
+        let probes = v4_probes(&tc, &[&nets]);
+        let before: Vec<bool> = probes.iter().map(|a| range.contains(a)).collect();
+        range.simplify();
+        let after: Vec<bool> = probes.iter().map(|a| range.contains(a)).collect();
+        assert_eq!(before, after, "simplify changed membership");
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: simplify is idempotent (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn simplify_is_idempotent(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let mut range: IpRange<Ipv4Net> = IpRange::new();
+        for net in &nets {
+            range.add(*net);
+        }
+        range.simplify();
+        let once = range.clone();
+        range.simplify();
+        assert_eq!(once, range);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: iteration yields a disjoint, minimal, exact cover (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn iter_yields_disjoint_minimal_exact_cover(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let range = collect_v4(&nets);
+        let yielded: Vec<Ipv4Net> = range.iter().collect();
+
+        // Every input network is covered.
+        for net in &nets {
+            assert!(range.contains(net), "input {} not covered", net);
+        }
+        // Every yielded network is contained in the range and is truncated.
+        for net in &yielded {
+            assert!(range.contains(net), "yielded {} not contained", net);
+            assert_eq!(*net, net.trunc(), "yielded {} not truncated", net);
+        }
+        // Yielded networks are pairwise disjoint (for CIDR networks,
+        // overlap implies one contains the other; use ipnet as the oracle).
+        for (i, a) in yielded.iter().enumerate() {
+            for b in yielded.iter().skip(i + 1) {
+                assert!(
+                    !a.contains(b) && !b.contains(a),
+                    "yielded networks overlap: {} and {}",
+                    a,
+                    b
+                );
+            }
+        }
+        // Minimality: the sibling of a yielded network must not be fully
+        // contained, otherwise simplify should have merged the pair.
+        for net in &yielded {
+            let len = net.prefix_len();
+            if len >= 1 {
+                let sibling_addr = u32::from(net.network()) ^ (1u32 << (32 - len));
+                let sibling = Ipv4Net::new(sibling_addr.into(), len).unwrap();
+                assert!(
+                    !range.contains(&sibling),
+                    "yielded {} but sibling {} also contained: not minimal",
+                    net,
+                    sibling
+                );
+            }
+        }
+        // Round-trip: collecting the yielded networks gives back the range.
+        let recollected: IpRange<Ipv4Net> = yielded.into_iter().collect();
+        assert_eq!(recollected, range);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: supernet agrees with ipnet's containment oracle (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn supernet_agrees_with_ipnet_contains(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let range = collect_v4(&nets);
+        let query = tc.draw(v4_nets()).trunc();
+        let members: Vec<Ipv4Net> = range.iter().collect();
+        match range.supernet(&query) {
+            Some(s) => {
+                assert!(
+                    s.contains(&query),
+                    "supernet {} does not contain query {}",
+                    s,
+                    query
+                );
+                assert!(
+                    members.contains(&s),
+                    "supernet {} is not a member network of {:?}",
+                    s,
+                    members
+                );
+            }
+            None => {
+                for m in &members {
+                    assert!(
+                        !m.contains(&query),
+                        "supernet returned None but member {} contains query {}",
+                        m,
+                        query
+                    );
+                }
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: stateful model — IpRange agrees with an exact membership
+    // set over a 256-address window (192.168.5.0/24), with boundary octets
+    // 0 and 255 reachable and supernet-removal exercised.
+    // ---------------------------------------------------------------------
+
+    const WINDOW_BASE: u32 = 0xC0A8_0500; // 192.168.5.0
+
+    struct WindowMachine {
+        range: IpRange<Ipv4Net>,
+        model: BTreeSet<u8>,
+    }
+
+    /// Draw a subnet of 192.168.5.0/24 and the inclusive last-octet span
+    /// it covers.
+    fn draw_window_net(tc: &hegel::TestCase) -> (Ipv4Net, u8, u8) {
+        let len = tc.draw(generators::integers::<u8>().min_value(24).max_value(32));
+        let octet = tc.draw(generators::integers::<u8>()) as u32;
+        let host_bits = 32 - len as u32;
+        let lo = octet & (0xFFu32 << host_bits) & 0xFF;
+        let hi = lo + (1u32 << host_bits) - 1;
+        let net = Ipv4Net::new((WINDOW_BASE | lo).into(), len).unwrap();
+        (net, lo as u8, hi as u8)
+    }
+
+    #[hegel::state_machine]
+    impl WindowMachine {
+        #[rule]
+        fn add(&mut self, tc: hegel::TestCase) {
+            let (net, lo, hi) = draw_window_net(&tc);
+            self.range.add(net);
+            self.model.extend(lo..=hi);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let (net, lo, hi) = draw_window_net(&tc);
+            self.range.remove(net);
+            for octet in lo..=hi {
+                self.model.remove(&octet);
+            }
+        }
+
+        #[rule]
+        fn remove_supernet(&mut self, tc: hegel::TestCase) {
+            // Remove a strict supernet of the window (including 0.0.0.0/0):
+            // this must clear the whole window.
+            let len = tc.draw(generators::integers::<u8>().max_value(23));
+            let net = Ipv4Net::new(WINDOW_BASE.into(), len).unwrap();
+            self.range.remove(net);
+            self.model.clear();
+        }
+
+        #[rule]
+        fn simplify(&mut self, _tc: hegel::TestCase) {
+            self.range.simplify();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: hegel::TestCase) {
+            // contains() agrees with the model for every window address.
+            for octet in 0u32..=255 {
+                assert_eq!(
+                    self.range.contains(&(WINDOW_BASE | octet)),
+                    self.model.contains(&(octet as u8)),
+                    "contains disagrees with model at octet {}",
+                    octet
+                );
+            }
+            // is_empty agrees (the range only ever holds window subnets).
+            assert_eq!(self.range.is_empty(), self.model.is_empty());
+            // The iterator yields only window subnets, and expanding them
+            // reproduces the model exactly.
+            let mut expanded = BTreeSet::new();
+            for net in &self.range {
+                let lo: u32 = net.network().into();
+                let hi: u32 = net.broadcast().into();
+                assert!(
+                    net.prefix_len() >= 24 && lo >= WINDOW_BASE && hi <= WINDOW_BASE + 255,
+                    "iterated network {} escaped the window",
+                    net
+                );
+                expanded.extend((lo - WINDOW_BASE..=hi - WINDOW_BASE).map(|o| o as u8));
+            }
+            assert_eq!(expanded, self.model, "iterated networks != model");
+        }
+    }
+
+    #[hegel::test]
+    fn window_model_agrees(tc: hegel::TestCase) {
+        let machine = WindowMachine {
+            range: IpRange::new(),
+            model: BTreeSet::new(),
+        };
+        hegel::stateful::run(machine, tc);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: merge is membership-wise union (IPv6)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn ipv6_merge_matches_membership_union(tc: hegel::TestCase) {
+        let nets_a = draw_v6_net_vec(&tc);
+        let nets_b = draw_v6_net_vec(&tc);
+        let ra = collect_v6(&nets_a);
+        let rb = collect_v6(&nets_b);
+        let merged = ra.merge(&rb);
+        for addr in v6_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                merged.contains(&addr),
+                ra.contains(&addr) || rb.contains(&addr),
+                "merge disagrees with union at {}",
+                std::net::Ipv6Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: exclude is membership-wise set difference (IPv6)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn ipv6_exclude_matches_membership_difference(tc: hegel::TestCase) {
+        let nets_a = draw_v6_net_vec(&tc);
+        let nets_b = draw_v6_net_vec(&tc);
+        let ra = collect_v6(&nets_a);
+        let rb = collect_v6(&nets_b);
+        let diff = ra.exclude(&rb);
+        for addr in v6_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                diff.contains(&addr),
+                ra.contains(&addr) && !rb.contains(&addr),
+                "exclude disagrees with set difference at {}",
+                std::net::Ipv6Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: (universe \ B) union B == universe (IPv6 top-of-space)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_then_merge_restores_universe_v6(tc: hegel::TestCase) {
+        let nets_b = draw_v6_net_vec(&tc);
+        let rb = collect_v6(&nets_b);
+        let universe: IpRange<Ipv6Net> =
+            std::iter::once("::/0".parse::<Ipv6Net>().unwrap()).collect();
+        let complement = universe.exclude(&rb);
+        let restored = complement.merge(&rb);
+        assert_eq!(restored, universe);
+    }
