         check(Point2::new(1.5, -1.0), Point2::new(2.0, -1.0), false);
     }
+
+    // === Hegel property based tests ===
+
+    use crate::test_utilities::position_key;
+    use hegel::generators::{self as gens};
+    use std::collections::HashSet as StdHashSet;
+    use std::{format, string::ToString};
+
+    /// Draws one common power-of-two scale factor per test case for the shape-query tests.
+    ///
+    /// All coordinates of a test case are exact small-integer multiples of this scale. This
+    /// sweeps the entire documented coordinate magnitude range (2^-142 ..= 2^201) across test
+    /// cases while keeping each individual test case's coordinates on a single scale:
+    /// coordinate sets whose magnitudes span many orders of magnitude trigger the pinned
+    /// precision-loss bugs in the shape iterators - see the KNOWN FAILURE tests
+    /// `hegel_rectangle_query_includes_vertex_left_of_extreme_rectangle` and
+    /// `known_bug_circle_query_misses_boundary_vertex`. Those inputs are excluded here
+    /// (constructively, not by filtering) so these tests keep checking everything else.
+    fn draw_grid_scale(tc: &hegel::TestCase) -> f64 {
+        // 128 * 2^193 = 2^200 <= MAX_ALLOWED_VALUE = 2^201 and 2^-134 >= MIN_ALLOWED_VALUE
+        // = 2^-142, so every drawn grid coordinate is a valid spade coordinate.
+        let exponent = tc.draw(gens::integers::<i32>().min_value(-134).max_value(193));
+        2f64.powi(exponent)
+    }
+
+    /// Draws a coordinate that is an exact small-integer multiple of `scale`.
+    fn draw_grid_coordinate(tc: &hegel::TestCase, scale: f64) -> f64 {
+        // i8 -> f64 and the multiplication by a power of two are both exact.
+        f64::from(tc.draw(gens::integers::<i8>())) * scale
+    }
+
+    /// Draws up to `max_len` points on the integer grid scaled by `scale`.
+    fn draw_grid_points(tc: &hegel::TestCase, scale: f64, max_len: usize) -> Vec<Point2<f64>> {
+        let len = tc.draw(gens::integers::<usize>().max_value(max_len));
+        (0..len)
+            .map(|_| {
+                Point2::new(
+                    draw_grid_coordinate(tc, scale),
+                    draw_grid_coordinate(tc, scale),
+                )
+            })
+            .collect()
+    }
+
+    /// Draws a shape coordinate: either a grid coordinate or an exact coordinate of one of
+    /// the given points, so that vertices frequently lie exactly on the shape's boundary
+    /// (which the documentation promises are returned as well).
+    fn draw_shape_coordinate(
+        tc: &hegel::TestCase,
+        scale: f64,
+        points: &[Point2<f64>],
+        pick_x: bool,
+    ) -> f64 {
+        if !points.is_empty() && tc.draw(gens::integers::<u8>().max_value(2)) == 0 {
+            let point = points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))];
+            if pick_x {
+                point.x
+            } else {
+                point.y
+            }
+        } else {
+            draw_grid_coordinate(tc, scale)
+        }
+    }
+
+    /// Returns `true` if a shape query on `triangulation` with `metric` could run into the
+    /// known hull-walk hang (see `known_bug_hull_walk_hangs_on_distant_shapes`):
+    /// `FloodFillIterator::get_start_edges` walks the convex hull and only stops when the
+    /// distance to the shape *strictly* increases or an edge overlaps the shape. If every hull
+    /// vertex has the exact same rounded distance (which happens for shapes so far away that
+    /// the f64 squared distances quantize to a single value) and no hull edge overlaps the
+    /// shape, the walk cycles the hull forever.
+    ///
+    /// Used to exclude those inputs from the live property tests below - this protects the
