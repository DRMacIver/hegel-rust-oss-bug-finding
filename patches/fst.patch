+            };
+        let max: Option<(Vec<u8>, bool)> =
+            if tc.draw(generators::booleans()) {
+                Some((draw_probe(&tc, &keys), tc.draw(generators::booleans())))
+            } else {
+                None
+            };
+
+        let mut builder = map.range();
+        if let Some((ref b, inclusive)) = min {
+            builder =
+                if inclusive { builder.ge(b) } else { builder.gt(b) };
+        }
+        if let Some((ref b, inclusive)) = max {
+            builder =
+                if inclusive { builder.le(b) } else { builder.lt(b) };
+        }
+        let got = builder.into_stream().into_byte_vec();
+
+        let expected: Vec<(Vec<u8>, u64)> = model
+            .iter()
+            .filter(|(k, _)| {
+                let lo_ok = match min {
+                    None => true,
+                    Some((ref b, true)) => *k >= b,
+                    Some((ref b, false)) => *k > b,
+                };
+                let hi_ok = match max {
+                    None => true,
+                    Some((ref b, true)) => *k <= b,
+                    Some((ref b, false)) => *k < b,
+                };
+                lo_ok && hi_ok
+            })
+            .map(|(k, &v)| (k.clone(), v))
+            .collect();
+        assert_eq!(got, expected);
+    }
+
+    fn stream_op_keys(mut stream: impl for<'a> Streamer<'a, Item = &'a [u8]>) -> Vec<Vec<u8>> {
+        let mut keys = vec![];
+        while let Some(key) = stream.next() {
+            keys.push(key.to_vec());
+        }
+        keys
+    }
+
+    /// Property: streaming union of several sets equals the BTreeSet union.
+    #[hegel::test]
+    fn prop_set_union_agrees_with_oracle(tc: hegel::TestCase) {
+        let models = tc.draw(arbitrary_key_sets());
+        let sets: Vec<Set<Vec<u8>>> = models.iter().map(build_set).collect();
+        let mut op = OpBuilder::new();
+        for set in &sets {
+            op.push(set);
+        }
+        let got = stream_op_keys(op.union());
+
+        let expected: Vec<Vec<u8>> = models
+            .iter()
+            .flat_map(|m| m.iter().cloned())
+            .collect::<BTreeSet<Vec<u8>>>()
+            .into_iter()
+            .collect();
+        assert_eq!(got, expected);
+    }
+
+    /// Property: streaming intersection of several sets equals the BTreeSet
+    /// intersection.
+    #[hegel::test]
+    fn prop_set_intersection_agrees_with_oracle(tc: hegel::TestCase) {
+        let models = tc.draw(arbitrary_key_sets());
+        let sets: Vec<Set<Vec<u8>>> = models.iter().map(build_set).collect();
+        let mut op = OpBuilder::new();
+        for set in &sets {
+            op.push(set);
+        }
+        let got = stream_op_keys(op.intersection());
+
+        let expected: Vec<Vec<u8>> = models[0]
+            .iter()
+            .filter(|k| models[1..].iter().all(|m| m.contains(*k)))
+            .cloned()
+            .collect();
+        assert_eq!(got, expected);
+    }
+
+    /// Property: streaming difference is "keys in the first set that are in
+    /// no other set" (per the OpBuilder::difference docs).
+    #[hegel::test]
+    fn prop_set_difference_agrees_with_oracle(tc: hegel::TestCase) {
+        let models = tc.draw(arbitrary_key_sets());
+        let sets: Vec<Set<Vec<u8>>> = models.iter().map(build_set).collect();
+        let mut op = OpBuilder::new();
+        for set in &sets {
+            op.push(set);
+        }
+        let got = stream_op_keys(op.difference());
+
+        let expected: Vec<Vec<u8>> = models[0]
+            .iter()
+            .filter(|k| !models[1..].iter().any(|m| m.contains(*k)))
