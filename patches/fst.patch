+
+    /// Property: streaming symmetric difference yields keys that occur in an
+    /// odd number of the input sets (per the OpBuilder docs).
+    #[hegel::test]
+    fn prop_set_symmetric_difference_agrees_with_oracle(tc: hegel::TestCase) {
+        let models = tc.draw(arbitrary_key_sets());
+        let sets: Vec<Set<Vec<u8>>> = models.iter().map(build_set).collect();
+        let mut op = OpBuilder::new();
+        for set in &sets {
+            op.push(set);
+        }
+        let got = stream_op_keys(op.symmetric_difference());
+
+        let all_keys: BTreeSet<Vec<u8>> =
+            models.iter().flat_map(|m| m.iter().cloned()).collect();
+        let expected: Vec<Vec<u8>> = all_keys
+            .into_iter()
+            .filter(|k| {
+                models.iter().filter(|m| m.contains(k)).count() % 2 == 1
+            })
+            .collect();
+        assert_eq!(got, expected);
+    }
+
+    /// Property: searching with Str(query).starts_with() returns exactly the
+    /// keys with `query` as a byte prefix, in lexicographic order.
+    #[hegel::test]
+    fn prop_prefix_search_agrees_with_filter(tc: hegel::TestCase) {
+        let keys = tc.draw(arbitrary_keys());
+        let set = build_set(&keys);
+
+        // Bias the query towards prefixes of keys actually in the set. The
+        // query must be a &str, so lossy-decode; the oracle uses the query's
+        // final bytes, so the property stays exact either way.
+        let candidate = draw_probe(&tc, &keys);
+        let cut = tc.draw(
+            generators::integers::<usize>().max_value(candidate.len()),
+        );
+        let query = String::from_utf8_lossy(&candidate[..cut]).into_owned();
+
+        let got = set
+            .search(Str::new(&query).starts_with())
+            .into_stream()
+            .into_bytes();
+        let expected: Vec<Vec<u8>> = keys
+            .iter()
+            .filter(|k| k.starts_with(query.as_bytes()))
+            .cloned()
+            .collect();
+        assert_eq!(got, expected, "query: {:?}", query);
+    }
+
+    fn is_subsequence(needle: &[u8], hay: &[u8]) -> bool {
+        let mut hay = hay.iter();
+        needle.iter().all(|b| hay.any(|h| h == b))
+    }
+
+    /// Property: searching with a Subsequence automaton returns exactly the
+    /// keys containing the query as a byte subsequence.
+    #[hegel::test]
+    fn prop_subsequence_search_agrees_with_filter(tc: hegel::TestCase) {
+        let keys = tc.draw(arbitrary_keys());
+        let set = build_set(&keys);
+
+        // Bias the query towards actual subsequences of member keys.
+        let candidate = draw_probe(&tc, &keys);
+        let mut sub = Vec::with_capacity(candidate.len());
+        for &b in &candidate {
+            if tc.draw(generators::booleans()) {
+                sub.push(b);
+            }
+        }
+        let query = String::from_utf8_lossy(&sub).into_owned();
+
+        let got = set
+            .search(Subsequence::new(&query))
+            .into_stream()
+            .into_bytes();
+        let expected: Vec<Vec<u8>> = keys
+            .iter()
+            .filter(|k| is_subsequence(query.as_bytes(), k))
+            .cloned()
+            .collect();
+        assert_eq!(got, expected, "query: {:?}", query);
+    }
+
+    /// Character-level Levenshtein distance (dynamic programming oracle).
+    #[cfg(feature = "levenshtein")]
+    fn lev_distance(a: &str, b: &str) -> usize {
+        let a: Vec<char> = a.chars().collect();
+        let b: Vec<char> = b.chars().collect();
+        let mut prev: Vec<usize> = (0..=b.len()).collect();
+        for (i, ca) in a.iter().enumerate() {
+            let mut cur = vec![i + 1];
+            for (j, cb) in b.iter().enumerate() {
+                let cost = if ca == cb { 0 } else { 1 };
+                cur.push(
+                    (prev[j] + cost)
+                        .min(prev[j + 1] + 1)
+                        .min(cur[j] + 1),
+                );
+            }
+            prev = cur;
+        }
+        prev[b.len()]
+    }
+
+    /// A short string over a small alphabet (including multi-byte characters,
+    /// which exercise the UTF-8 range handling in the Levenshtein automaton).
+    #[cfg(feature = "levenshtein")]
+    fn draw_lev_string(tc: &hegel::TestCase, max_len: usize) -> String {
+        let len =
+            tc.draw(generators::integers::<usize>().max_value(max_len));
+        let mut s = String::new();
+        for _ in 0..len {
+            s.push(tc.draw(generators::sampled_from(vec![
+                'a', 'b', 'c', 'é', '☃',
+            ])));
+        }
+        s
+    }
+
+    /// Property: Levenshtein automaton search returns exactly the keys whose
+    /// character-level edit distance from the query is <= the given distance,
+    /// per a naive DP oracle.
+    #[cfg(feature = "levenshtein")]
+    #[hegel::test]
+    fn prop_levenshtein_search_agrees_with_naive(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(50));
+        let mut keys = BTreeSet::new();
+        for _ in 0..n {
+            keys.insert(draw_lev_string(&tc, 8));
+        }
+        let set = Set::from_iter(keys.iter()).unwrap();
+
+        let query = draw_lev_string(&tc, 6);
+        let distance = tc.draw(generators::integers::<u32>().max_value(2));
+        let lev = Levenshtein::new(&query, distance).unwrap();
+
+        let got = set.search(&lev).into_stream().into_strs().unwrap();
+        let expected: Vec<String> = keys
+            .iter()
+            .filter(|k| lev_distance(k, &query) <= distance as usize)
+            .cloned()
+            .collect();
+        assert_eq!(got, expected, "query: {:?}, distance: {}", query, distance);
+    }
+}
