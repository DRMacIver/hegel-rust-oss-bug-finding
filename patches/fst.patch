+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+mod hegel_props {
+    use std::collections::BTreeMap;
+
+    use hegel::generators::{self, Generator};
+
+    use crate::error::Error;
+    use crate::raw::{self, Builder, Fst, Output};
+    use crate::raw::tests::fst_inputs_outputs;
+
+    /// A single FST key: a mix of a tiny alphabet (deep shared prefixes) and
+    /// arbitrary binary.
+    #[hegel::composite]
+    fn arbitrary_key(tc: hegel::TestCase) -> Vec<u8> {
+        tc.draw(hegel::one_of!(
+            generators::vecs(generators::integers::<u8>().max_value(2))
+                .max_size(12)
+                .boxed(),
+            generators::binary().boxed(),
+        ))
+    }
+
+    /// A model map with sorted unique keys and arbitrary u64 values. Size is
+    /// drawn separately so large (multi-level) automata are exercised.
+    #[hegel::composite]
+    fn arbitrary_model_map(tc: hegel::TestCase) -> BTreeMap<Vec<u8>, u64> {
+        let n = tc.draw(generators::integers::<usize>().max_value(200));
+        let keys: Vec<Vec<u8>> =
+            tc.draw(generators::vecs(arbitrary_key()).min_size(n));
+        let mut model = BTreeMap::new();
+        for key in keys {
+            let value = tc.draw(generators::integers::<u64>());
+            model.insert(key, value);
+        }
+        model
+    }
+
+    /// Property: writing an FST to bytes (Builder::into_inner) and reading it
+    /// back (Fst::new) is lossless — the read FST has the same length,
+    /// contents (in order), and per-key outputs, and its checksum verifies.
+    #[hegel::test]
+    fn prop_fst_bytes_roundtrip(tc: hegel::TestCase) {
+        let model = tc.draw(arbitrary_model_map());
+        let mut builder = Builder::memory();
+        for (key, &value) in &model {
+            builder.insert(key, value).unwrap();
+        }
+        let bytes = builder.into_inner().unwrap();
+        let fst = Fst::new(bytes).unwrap();
+
+        assert!(fst.verify().is_ok());
+        assert_eq!(fst.len(), model.len());
+        let expected: Vec<(Vec<u8>, u64)> =
+            model.iter().map(|(k, &v)| (k.clone(), v)).collect();
+        assert_eq!(fst_inputs_outputs(&fst), expected);
+        for (key, &value) in &model {
+            assert_eq!(fst.get(key), Some(Output::new(value)));
+        }
+    }
+
+    /// Property: building an FST is deterministic — two Builders fed the
+    /// same sorted unique (key, value) pairs produce byte-identical FSTs.
+    /// Evidence: construction is a pure function of the input sequence (the
+    /// node registry hashes node contents, with no randomized seeds), and the
+    /// CRC32C checksum footer (verify()) only makes sense for a deterministic
+    /// serialization.
+    #[hegel::test]
+    fn prop_fst_build_deterministic(tc: hegel::TestCase) {
+        let model = tc.draw(arbitrary_model_map());
+        let build = |model: &BTreeMap<Vec<u8>, u64>| -> Vec<u8> {
+            let mut builder = Builder::memory();
+            for (key, &value) in model {
+                builder.insert(key, value).unwrap();
+            }
+            builder.into_inner().unwrap()
+        };
+        assert_eq!(build(&model), build(&model));
+    }
+
+    /// Property: Builder::insert enforces its documented contract — keys must
+    /// be inserted in strictly increasing lexicographic order. Inserting a
+    /// key smaller than the previous one fails with OutOfOrder, a duplicate
+    /// fails with DuplicateKey, and a larger key succeeds.
+    #[hegel::test]
+    fn prop_builder_insert_order_contract(tc: hegel::TestCase) {
+        let model = tc.draw(arbitrary_model_map());
+        tc.assume(!model.is_empty());
+        let mut builder = Builder::memory();
+        for (key, &value) in &model {
+            builder.insert(key, value).unwrap();
+        }
+        let last = model.keys().next_back().unwrap().clone();
+
+        let probe = tc.draw(arbitrary_key());
+        let result = builder.insert(&probe, 0);
+        match probe.cmp(&last) {
+            std::cmp::Ordering::Less => match result {
+                Err(Error::Fst(raw::Error::OutOfOrder { .. })) => {}
+                other => panic!(
+                    "expected OutOfOrder for probe {:?} after {:?}, got {:?}",
+                    probe, last, other
+                ),
+            },
+            std::cmp::Ordering::Equal => match result {
+                Err(Error::Fst(raw::Error::DuplicateKey { .. })) => {}
+                other => panic!(
+                    "expected DuplicateKey for probe {:?}, got {:?}",
+                    probe, other
+                ),
+            },
+            std::cmp::Ordering::Greater => {
+                result.unwrap();
+            }
+        }
+    }
+}
